          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- All tuning numbers in one place. Names live in Names.luau; Robux IDs in Monetization.luau.
local Config = {}

Config.VERSION = "v1.0 vertical slice"
Config.AUTOSAVE_SECONDS = 90

-- ===== Match size: exactly 48 contenders (24 Reaches x 2) =====
Config.MATCH_SIZE = 48
Config.REACH_COUNT = 24
Config.PER_REACH = 2
Config.MAX_SERVER_PLAYERS = 50 -- set Game Settings > Places > Max Players to 50

-- ===== Matchmaking =====
Config.Matchmaking = {
	-- v1 runs everything in one server. Set crossServer = true once the lobby/arena place
	-- split is published (see README "Cross-server queue").
	crossServer = false,
	fillAfter = 90, -- seconds: launch with bots if at least minHumans are queued
	minHumans = 16,
	lateFillAfter = 150, -- seconds: launch with at least lateMinHumans
	lateMinHumans = 8,
	-- single-server rules (one Roblox server can only ever hold 50 people)
	singleServerFillAfter = 25,
	singleServerMinHumans = 1,
	nextMatchSeconds = 10, -- "Next match in 10s" after the podium
}

-- ===== Map (studs). Arena centered at the origin, ground top at y = 0 =====
Config.Map = {
	ARENA_SIZE = 2400,
	HUB_RADIUS = 44,
	PLATE_RADIUS = 100,
	LOBBY_CENTER = { 0, 0, 3400 },
	GALLERY_CENTER = { 0, 420, 0 },
	MEADOW = { x = 640, z = -620, r = 340 },
	LAKE = { x = 700, z = 480, r = 250 },
	WOOD = { x = -720, z = 0, r = 470 },
	RIDGE = { x = 0, z = -900, r = 330 },
	RUINS = { x = -420, z = 760, r = 260 },
}

-- ===== Pregame ceremony (seconds; played locally, synced by the server) =====
Config.Pregame = {
	reaping = 14,
	reapingShort = 3,
	parade = 8,
	interview = 8,
	training = 8,
	launch = 10,
}
function Config.pregameTotal(): number
	local p = Config.Pregame
	return p.reaping + p.parade + p.interview + p.training
end

-- ===== Arena timeline =====
Config.ARENA_CAP = 12 * 60
Config.HARD_CAP = 12 * 60 + 30 -- if more than one is still in at 12:30, highest Pep wins
Config.PODIUM_SECONDS = 12
-- Veil phases: at time `at` the radius shrinks from `from` to `to` over `dur` seconds.
Config.VeilPhases = {
	{ at = 180, from = 1200, to = 850, dur = 60 },
	{ at = 300, from = 850, to = 550, dur = 60 },
	{ at = 420, from = 550, to = 325, dur = 60 },
	{ at = 510, from = 325, to = 175, dur = 50 },
	{ at = 600, from = 175, to = 60, dur = 60 },
	{ at = 690, from = 60, to = 0, dur = 30 },
}
Config.VEIL_WARNING = 10
Config.VEIL_DAMAGE = { 4, 5, 6, 8, 10, 12, 15 } -- Pep per second outside, by phase (index 1 = before phase 1)

-- ===== Contenders =====
Config.PEP_MAX = 100
Config.WALK_SPEED = 16
Config.SPRINT_SPEED = 24
Config.STAMINA_MAX = 100
Config.STAMINA_DRAIN = 22 -- per second while sprinting
Config.STAMINA_REGEN = 14 -- per second
Config.BACKPACK_SLOTS = 3
Config.BACKPACK_SLOTS_BIG = 6
Config.ALLIES_UNTIL = 4 -- Reach partners can't hurt each other until 4 remain

-- ===== Weapons and items =====
export type Weapon = { id: string, name: string, kind: string, damage: number, range: number, cooldown: number, arc: number?, ammo: number? }
Config.Weapons = {
	bow = { id = "bow", name = "Bow", kind = "ranged", damage = 22, range = 170, cooldown = 0.9, ammo = 8 },
	spear = { id = "spear", name = "Spear", kind = "melee", damage = 24, range = 10, cooldown = 0.8, arc = 70 },
	knife = { id = "knife", name = "Knife", kind = "melee", damage = 14, range = 7, cooldown = 0.4, arc = 70 },
	shove = { id = "shove", name = "Shove", kind = "melee", damage = 5, range = 6, cooldown = 0.6, arc = 70 },
} :: { [string]: Weapon }

export type Item = { id: string, name: string, kind: string, heal: number?, stamina: number?, weapon: string?, ammo: number? }
Config.Items = {
	bow = { id = "bow", name = "Bow", kind = "weapon", weapon = "bow" },
	spear = { id = "spear", name = "Spear", kind = "weapon", weapon = "spear" },
	knife = { id = "knife", name = "Knife", kind = "weapon", weapon = "knife" },
	arrows = { id = "arrows", name = "Arrows x6", kind = "ammo", ammo = 6 },
	backpack = { id = "backpack", name = "Backpack", kind = "backpack" },
	trailmix = { id = "trailmix", name = "Trail Mix", kind = "snack", heal = 20 },
	apple = { id = "apple", name = "Apple", kind = "snack", heal = 15, stamina = 20 },
	canteen = { id = "canteen", name = "Canteen", kind = "snack", heal = 10, stamina = 60 },
	bandage = { id = "bandage", name = "Bandage", kind = "snack", heal = 35 },
	sweettea = { id = "sweettea", name = "Rusty's Sweet Tea", kind = "snack", heal = 100, stamina = 100 },
} :: { [string]: Item }

-- Crate loot tables (weights). Hub crates are richer. Rates are shown in the Help panel.
Config.LootHub = { bow = 22, spear = 20, knife = 14, backpack = 14, arrows = 12, bandage = 10, trailmix = 8 }
Config.LootField = { knife = 16, spear = 10, bow = 8, arrows = 16, apple = 16, trailmix = 14, canteen = 10, bandage = 6, backpack = 4 }
Config.LootMeadow = { bandage = 30, bow = 20, backpack = 20, arrows = 15, canteen = 15 }
Config.HUB_CRATES = 36
Config.FIELD_CRATES = 110
Config.MEADOW_CRATES = 12
Config.TOKENS_PER_MATCH = 4

-- ===== Hazards =====
Config.Hazards = {
	finches = { warn = 5, duration = 14, radius = 24, dps = 6, speed = 15, birds = 12 },
	bloom = { warn = 5, duration = 25, dps = 4, slow = 0.6 },
	supply = { crates = 3 },
	scheduled = { { at = 240, id = "finches" }, { at = 360, id = "bloom" } },
	voteEvery = 90,
	voteFirstAt = 150,
	voteLength = 20,
}

-- ===== Viewing Gallery =====
Config.Gallery = {
	favorEvery = 5, -- seconds per +1 Favor while watching a live match
	favorStart = 10,
	giftCooldown = 45, -- per contender
	maxInAir = 6,
	partnerDiscount = 0.75,
}
export type Gift = { id: string, name: string, item: string, cost: number }
Config.Gifts = {
	{ id = "water", name = "Canteen", item = "canteen", cost = 8 },
	{ id = "snack", name = "Trail Mix", item = "trailmix", cost = 10 },
	{ id = "arrows", name = "Arrows", item = "arrows", cost = 10 },
	{ id = "bandage", name = "Bandage", item = "bandage", cost = 16 },
	{ id = "tea", name = "Rusty's Sweet Tea", item = "sweettea", cost = 40 },
} :: { Gift }

-- Spectator vote-back ("Encore"): once a match the Gallery can vote one contender back in.
Config.Encore = { at = 330, length = 20, minAlive = 6, pep = 50, candidates = 3 }

-- Rusty's in-match gift: one sweet tea to the human contender with the lowest Pep when 8 remain.
Config.RUSTY_GIFT_AT = 8

-- ===== Progression =====
Config.LEVEL_CAP = 50
Config.PRESTIGE_CAP = 4
Config.XP = {
	match = 40,
	perPlaceAbove = 2, -- (49 - place) * 2
	knock = 15,
	crate = 2,
	gift = 5,
	vote = 2,
	win = 150,
	token = 25,
	top10 = 30,
	encore = 20,
}
Config.PLAY_STREAK_WINDOW = 240 -- seconds between matches to keep a play streak
Config.PLAY_STREAK_STEP = 0.1
Config.PLAY_STREAK_MAX = 0.5
Config.STARS = { match = 1, top10 = 2, win = 5 }
Config.STARS_PER_TIER = 8
Config.DAILY_STREAK_XP = 60

-- ===== Fair play =====
Config.FairPlay = {
	boostMult = 0.5, -- Renown Boost: +50% XP for 30 min (never affects combat)
	showerMult = 0.25, -- everyone else in the server: +25% XP for 5 min
	showerMinutes = 5,
	satchelInRanked = false, -- Starter Satchel only in casual modes
	bootsRegen = 0.05, -- Trail Boots: +5% stamina regen, casual only
}
Config.RANKED = false -- v1 ships casual Jubilee only

-- ===== Bots =====
Config.Bots = {
	tick = 0.25,
	aimSpread = 0.12, -- radians-ish error for bot bows
	damageMult = 0.8,
	reaction = { 0.35, 0.9 },
	hubBrave = 0.4, -- share of bots that rush the Sundial
	sight = 70,
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Content</string>
          <string name="Source"><![CDATA[--!strict
-- Game content tables: tokens, hazard cards, interview quips, Stand-In names, cosmetics.
-- Player-facing proper nouns come from Names.luau.
local Content = {}

-- 24 collectible Jubilee Tokens. Each match hides Config.TOKENS_PER_MATCH of them in the arena.
Content.TOKENS = {
	{ id = "t_sundial", name = "Sundial Token", zone = "hub" },
	{ id = "t_gnomon", name = "Gnomon Shard", zone = "hub" },
	{ id = "t_bloom", name = "Bloom Token", zone = "meadow" },
	{ id = "t_pollen", name = "Pollen Coin", zone = "meadow" },
	{ id = "t_petal", name = "Gilded Petal", zone = "meadow" },
	{ id = "t_finch", name = "Finch Feather", zone = "meadow" },
	{ id = "t_mirror", name = "Mirror Pebble", zone = "lake" },
	{ id = "t_reed", name = "Reed Whistle", zone = "lake" },
	{ id = "t_shell", name = "Lake Shell", zone = "lake" },
	{ id = "t_ripple", name = "Ripple Glass", zone = "lake" },
	{ id = "t_acorn", name = "Whisper Acorn", zone = "wood" },
	{ id = "t_owl", name = "Owl Button", zone = "wood" },
	{ id = "t_moss", name = "Moss Locket", zone = "wood" },
	{ id = "t_lantern", name = "Lost Lantern", zone = "wood" },
	{ id = "t_ash", name = "Ash Stone", zone = "ridge" },
	{ id = "t_ember", name = "Ember Chip", zone = "ridge" },
	{ id = "t_cairn", name = "Cairn Marker", zone = "ridge" },
	{ id = "t_echo", name = "Echo Horn", zone = "ridge" },
	{ id = "t_pane", name = "Glassford Pane", zone = "ruins" },
	{ id = "t_key", name = "Greenhouse Key", zone = "ruins" },
	{ id = "t_seed", name = "Old Seed Packet", zone = "ruins" },
	{ id = "t_bell", name = "Ruin Bell", zone = "ruins" },
	{ id = "t_thermos", name = "Rusty's Old Thermos Lid", zone = "field" },
	{ id = "t_ribbon", name = "Parade Ribbon", zone = "field" },
} :: { { id: string, name: string, zone: string } }

-- Gallery hazard vote cards. One card is always friendly so voting isn't only about hurting.
Content.HAZARD_CARDS = {
	{ id = "finches", name = "Candyfinch Flock", text = "A sugary flock chases the biggest group." },
	{ id = "bloom", name = "Meadow Bloom", text = "Gilded pollen fills the meadow for 25 s." },
	{ id = "supply", name = "Supply Drop", text = "Three parachute crates land near the Sundial." },
} :: { { id: string, name: string, text: string } }

-- Interview quips (preset, no free text = no moderation risk). Players pick one in the lobby.
Content.QUIPS = {
	"I'm here to make my Reach proud.",
	"I packed snacks. Lots of snacks.",
	"Rusty says keep your head down. I say keep it up!",
	"I'm faster than I look.",
	"See you at the Sundial.",
	"I just want to see the sunrise.",
} :: { string }

-- Rusty's lines. Short, warm, a bit rough around the edges. Never mean.
Content.RUSTY = {
	reaping = "Easy, kid. Breathe. I've done this walk before.",
	launch = "Don't run for the gold first. Run for the trees.",
	gift = "Thought you looked thirsty. Sweet tea, my recipe.",
	win = "Ha! Told the whole Spire you'd make it.",
	lose = "Good run. Shake it off. We go again.",
} :: { [string]: string }

-- Stand-In bot first names (generic, original).
Content.BOT_NAMES = {
	"Ash", "Briar", "Cove", "Dell", "Ember", "Fern", "Gale", "Hollis", "Ivy", "Jory", "Kit", "Lark",
	"Moss", "Nell", "Oren", "Pip", "Quill", "Rook", "Sage", "Tamsin", "Umber", "Vale", "Wren", "Yarrow",
	"Zinnia", "Bram", "Clove", "Dune", "Esk", "Flint", "Hazel", "Juniper", "Linnet", "Marlow", "Nico", "Orla",
	"Perrin", "Reed", "Sorrel", "Thistle", "Ulla", "Vesper", "Willow", "Alder", "Birch", "Cedar", "Rowan", "Tansy",
} :: { string }

-- Cosmetic knockout fades (how a knocked-out contender dissolves into light).
Content.FADES = {
	fade_gold = { name = "Gold Light", color = "#FFD36B" },
	fade_ember = { name = "Ember Light", color = "#FF8A4C" },
	fade_veil = { name = "Veil Shimmer", color = "#7FF3FF" },
	fade_bloom = { name = "Bloom Petals", color = "#FF4FB8" },
} :: { [string]: { name: string, color: string } }

return Content
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">DefaultData</string>
          <string name="Source"><![CDATA[--!strict
-- The save file for a new contender. Reconcile fills any missing keys on load, so adding a field
-- here is always safe. Bump VERSION only for migrations.
local DefaultData = {}

DefaultData.VERSION = 1

function DefaultData.new(): any
	return {
		version = DefaultData.VERSION,
		level = 1,
		xp = 0,
		prestige = 0,
		stats = { matches = 0, wins = 0, knocks = 0, top10 = 0, top5 = 0, bestPlace = 0, gifts = 0, encores = 0 },
		streak = { lastDay = -1, count = 0, best = 0, freeMissWeek = -1 },
		play = { count = 0, lastEnd = 0 },
		daily = { key = -1, list = {} },
		weekly = { key = -1, list = {} },
		season = { season = 0, stars = 0, claimedFree = {}, claimedPremium = {} },
		tokens = {}, -- token id -> true (collection book)
		owned = {}, -- cosmetic id -> true
		equipped = { fade = "fade_gold", banner = "", title = "" },
		reach = "",
		reachWeek = -1,
		reachPlayedWeek = -1,
		banners = {}, -- "week:reach" -> true
		seenReaping = false,
		boost = { untilT = 0, mult = 0 },
		receipts = {},
		settings = { autoQueue = true, sfx = true, shortReaping = false },
		quip = 1,
	}
end

return DefaultData
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="11">
        <Properties>
          <string name="Name">Logic</string>
        </Properties>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Challenges</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Daily (3) and weekly (3) challenges. Every server picks the same set from the day/week number,
	so friends share the same goals. Each challenge tracks one stat. Rewards are Renown and Stars.
	Daily challenges are sized for about 3 matches; weeklies for a few sessions. They never expire
	mid-progress without warning: the panel shows "new in 5h 12m".
]]
-- Same hash as TimeUtil.hash (kept local so this module has no requires and runs in Lune tests).
local function hash(n: number): number
	return math.floor((n * 2654435761) % 4294967296)
end

local Challenges = {}

export type Def = { id: string, stat: string, goal: number, text: string, xp: number, stars: number }
export type Entry = { id: string, progress: number, done: boolean, claimed: boolean }
export type State = { key: number, list: { Entry } }

Challenges.DAILY = {
	{ id = "d_play3", stat = "matches", goal = 3, text = "Play 3 matches", xp = 120, stars = 2 },
	{ id = "d_top10", stat = "top10", goal = 1, text = "Finish in the top 10", xp = 150, stars = 2 },
	{ id = "d_knock2", stat = "knocks", goal = 2, text = "Knock out 2 contenders", xp = 140, stars = 2 },
	{ id = "d_crates8", stat = "crates", goal = 8, text = "Open 8 crates", xp = 100, stars = 1 },
	{ id = "d_gift2", stat = "gifts", goal = 2, text = "Send 2 parachute gifts from the Gallery", xp = 100, stars = 1 },
	{ id = "d_vote3", stat = "votes", goal = 3, text = "Vote on 3 hazards from the Gallery", xp = 90, stars = 1 },
	{ id = "d_token1", stat = "tokens", goal = 1, text = "Find a Jubilee Token", xp = 120, stars = 2 },
	{ id = "d_survive5", stat = "survive5", goal = 2, text = "Survive past 5:00 twice", xp = 130, stars = 2 },
	{ id = "d_hub1", stat = "hubloot", goal = 3, text = "Grab 3 items at the Sundial", xp = 110, stars = 1 },
	{ id = "d_meadow", stat = "meadow", goal = 1, text = "Loot a Gilded Meadow crate", xp = 110, stars = 1 },
	{ id = "d_snack4", stat = "snacks", goal = 4, text = "Eat 4 snacks", xp = 90, stars = 1 },
	{ id = "d_bowknock", stat = "bowknocks", goal = 1, text = "Knock someone out with a bow", xp = 140, stars = 2 },
} :: { Def }

Challenges.WEEKLY = {
	{ id = "w_play20", stat = "matches", goal = 20, text = "Play 20 matches", xp = 600, stars = 6 },
	{ id = "w_win1", stat = "wins", goal = 1, text = "Win a Jubilee", xp = 800, stars = 8 },
	{ id = "w_knock15", stat = "knocks", goal = 15, text = "Knock out 15 contenders", xp = 600, stars = 6 },
	{ id = "w_top5x3", stat = "top5", goal = 3, text = "Finish top 5 three times", xp = 700, stars = 7 },
	{ id = "w_tokens6", stat = "tokens", goal = 6, text = "Find 6 Jubilee Tokens", xp = 650, stars = 6 },
	{ id = "w_gifts10", stat = "gifts", goal = 10, text = "Send 10 gifts from the Gallery", xp = 500, stars = 5 },
	{ id = "w_partner5", stat = "partnermatches", goal = 5, text = "Play 5 matches with a partner", xp = 550, stars = 5 },
	{ id = "w_encore", stat = "encore", goal = 1, text = "Get voted back in by the Gallery", xp = 500, stars = 5 },
} :: { Def }

local byId: { [string]: Def } = {}
for _, d in ipairs(Challenges.DAILY) do
	byId[d.id] = d
end
for _, d in ipairs(Challenges.WEEKLY) do
	byId[d.id] = d
end

function Challenges.def(id: string): Def?
	return byId[id]
end

-- Pick `n` distinct challenges from a pool using a deterministic seed.
function Challenges.pick(pool: { Def }, seed: number, n: number): { Def }
	local idx = {}
	for i = 1, #pool do
		idx[i] = i
	end
	local h = hash(seed + 7)
	for i = #idx, 2, -1 do
		h = hash(h % 1000003 + i)
		local j = ((h // 4096) % i) + 1
		idx[i], idx[j] = idx[j], idx[i]
	end
	local out = {}
	for i = 1, math.min(n, #idx) do
		table.insert(out, pool[idx[i]])
	end
	return out
end

-- Make sure the state matches the current day/week key; resets when it changes.
function Challenges.ensure(s: State, pool: { Def }, key: number, n: number): boolean
	if s.key == key and #s.list == n then
		return false
	end
	s.key = key
	s.list = {}
	for _, d in ipairs(Challenges.pick(pool, key, n)) do
		table.insert(s.list, { id = d.id, progress = 0, done = false, claimed = false })
	end
	return true
end

-- Add progress for a stat. Returns the defs that just completed.
function Challenges.bump(s: State, stat: string, amount: number): { Def }
	local done = {}
	for _, e in ipairs(s.list) do
		local d = byId[e.id]
		if d and d.stat == stat and not e.done then
			e.progress = math.min(d.goal, e.progress + amount)
			if e.progress >= d.goal then
				e.done = true
				table.insert(done, d)
			end
		end
	end
	return done
end

-- Claim a completed challenge's reward (auto-claimed by the server at match end).
function Challenges.claim(s: State, id: string): Def?
	for _, e in ipairs(s.list) do
		if e.id == id and e.done and not e.claimed then
			e.claimed = true
			return byId[id]
		end
	end
	return nil
end

return Challenges
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Combat</string>
            <string name="Source"><![CDATA[--!strict
-- Pure combat helpers the server uses to validate every hit. The client only sends intent.
local Combat = {}

export type V3 = { x: number, y: number, z: number }

function Combat.dist(a: V3, b: V3): number
	local dx, dy, dz = a.x - b.x, a.y - b.y, a.z - b.z
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end

-- Is `target` inside a melee arc of `arcDeg` in front of `from` facing `look` (flat, XZ)?
function Combat.inArc(from: V3, look: V3, target: V3, arcDeg: number): boolean
	local dx, dz = target.x - from.x, target.z - from.z
	local d = math.sqrt(dx * dx + dz * dz)
	if d < 0.5 then
		return true
	end
	local ll = math.sqrt(look.x * look.x + look.z * look.z)
	if ll < 1e-6 then
		return false
	end
	local cos = (dx * look.x + dz * look.z) / (d * ll)
	return cos >= math.cos(math.rad(arcDeg / 2))
end

-- Partners from the same Reach cannot hurt each other until `alliesUntil` remain.
function Combat.canHurt(aReach: string, bReach: string, alive: number, alliesUntil: number): boolean
	if aReach == bReach and alive > alliesUntil then
		return false
	end
	return true
end

-- Bow damage falls off a little past half range so close shots matter.
function Combat.bowDamage(base: number, distance: number, range: number): number
	if distance > range then
		return 0
	end
	if distance <= range / 2 then
		return base
	end
	local a = (distance - range / 2) / (range / 2)
	return math.floor(base * (1 - 0.3 * a) + 0.5)
end

-- Apply damage to Pep. Returns new pep and whether this hit knocked them out.
function Combat.hit(pep: number, damage: number): (number, boolean)
	local n = math.max(0, pep - damage)
	return n, n <= 0 and pep > 0
end

-- Placement: if N are alive and one is knocked, they finish in place N.
function Combat.placeOnKnock(aliveBefore: number): number
	return aliveBefore
end

-- Can the client's claimed cooldown be honoured? (server keeps its own clock)
function Combat.ready(lastUse: number?, now: number, cooldown: number): boolean
	return lastUse == nil or now - lastUse >= cooldown * 0.9
end

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Gifts</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Viewing Gallery gifts. Spectators earn Favor just by watching (never bought with Robux).
	Gifts get pricier as the field shrinks so the final few aren't flooded; your Reach partner
	gets a discount. Each contender can receive one gift every `cooldown` seconds.
]]
local Gifts = {}

function Gifts.cost(base: number, alive: number, isPartner: boolean, discount: number, weekMult: number): number
	local scale = 1
	if alive <= 4 then
		scale = 2
	elseif alive <= 10 then
		scale = 1.5
	elseif alive <= 24 then
		scale = 1.2
	end
	local c = base * scale * weekMult
	if isPartner then
		c *= discount
	end
	return math.max(1, math.floor(c + 0.5))
end

-- lastGift: target id -> time of their last received gift
function Gifts.canSend(lastGift: { [string]: number }, target: string, now: number, cooldown: number): (boolean, number)
	local t = lastGift[target]
	if t and now - t < cooldown then
		return false, cooldown - (now - t)
	end
	return true, 0
end

return Gifts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Leveling</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Contender level (1-50) and prestige (Reaped -> Contender -> Favorite -> Champion -> Legend).
	Level only unlocks cosmetics and titles. It never changes combat.
]]
local Leveling = {}

export type State = { level: number, xp: number, prestige: number }

function Leveling.xpToNext(level: number): number
	return 100 + 25 * (math.max(1, level) - 1)
end

-- Adds Renown. Returns how many levels were gained. XP stops at the cap until you prestige.
function Leveling.add(s: State, amount: number, cap: number): number
	local gained = 0
	s.xp += math.max(0, math.floor(amount))
	while s.level < cap and s.xp >= Leveling.xpToNext(s.level) do
		s.xp -= Leveling.xpToNext(s.level)
		s.level += 1
		gained += 1
	end
	if s.level >= cap then
		s.xp = math.min(s.xp, Leveling.xpToNext(cap))
	end
	return gained
end

function Leveling.canPrestige(s: State, cap: number, prestigeCap: number): boolean
	return s.level >= cap and s.prestige < prestigeCap
end

-- Prestige resets level to 1 and grants the next rank's frame and title (cosmetic only).
function Leveling.prestige(s: State, cap: number, prestigeCap: number): boolean
	if not Leveling.canPrestige(s, cap, prestigeCap) then
		return false
	end
	s.prestige += 1
	s.level = 1
	s.xp = 0
	return true
end

-- Total Renown needed to reach a level from level 1.
function Leveling.totalTo(level: number): number
	local t = 0
	for l = 1, level - 1 do
		t += Leveling.xpToNext(l)
	end
	return t
end

-- Play streak: back-to-back matches within `window` seconds add +step XP each, up to max.
export type Play = { count: number, lastEnd: number }
function Leveling.playStreak(p: Play, now: number, window: number): number
	if p.lastEnd > 0 and now - p.lastEnd <= window then
		p.count += 1
	else
		p.count = 1
	end
	p.lastEnd = now
	return p.count
end

function Leveling.playMult(count: number, step: number, maxBonus: number): number
	return 1 + math.min(maxBonus, step * math.max(0, count - 1))
end

return Leveling
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Loot</string>
            <string name="Source"><![CDATA[--!strict
-- Crate rolls from a weight table. Crates are free and found in the arena; odds are shown in Help.
-- Nothing here is ever sold.
local Loot = {}

local function keys(weights: { [string]: number }): { string }
	local k = {}
	for id in pairs(weights) do
		table.insert(k, id)
	end
	table.sort(k)
	return k
end

-- u in [0,1)
function Loot.pick(weights: { [string]: number }, u: number): string
	local total = 0
	local ks = keys(weights)
	for _, id in ipairs(ks) do
		total += weights[id]
	end
	local x = u * total
	for _, id in ipairs(ks) do
		x -= weights[id]
		if x < 0 then
			return id
		end
	end
	return ks[#ks]
end

function Loot.odds(weights: { [string]: number }): { [string]: number }
	local total = 0
	for _, w in pairs(weights) do
		total += w
	end
	local out = {}
	for id, w in pairs(weights) do
		out[id] = w / total
	end
	return out
end

return Loot
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">NearMiss</string>
            <string name="Source"><![CDATA[--!strict
--[[
	The end-of-match card. Shows how close you got and one honest, specific next goal.
	Never shames, never says "buy". Copy is short and readable at a glance.
]]
local NearMiss = {}

export type Result = {
	place: number,
	size: number,
	knocks: number,
	survived: number, -- seconds
	bestPlace: number, -- previous best (0 = none)
	nextKnockGoal: number?, -- knocks needed for the next daily/weekly step
	winnerPepLeft: number?,
	tapperName: string?,
}

local function ordinal(n: number): string
	local suf = "th"
	local m100 = n % 100
	if m100 < 11 or m100 > 13 then
		local m = n % 10
		if m == 1 then
			suf = "st"
		elseif m == 2 then
			suf = "nd"
		elseif m == 3 then
			suf = "rd"
		end
	end
	return tostring(n) .. suf
end
NearMiss.ordinal = ordinal

function NearMiss.headline(r: Result): string
	if r.place == 1 then
		return "Champion at daybreak!"
	end
	return string.format("%s of %d!", ordinal(r.place), r.size)
end

-- Up to three short lines, most motivating first.
function NearMiss.lines(r: Result): { string }
	local out = {}
	if r.place == 2 and r.winnerPepLeft then
		table.insert(out, string.format("So close! The champion had only %d Pep left.", math.max(1, math.floor(r.winnerPepLeft))))
	elseif r.place == 2 then
		table.insert(out, "So close! One more knock and it was yours.")
	elseif r.place <= 5 then
		table.insert(out, string.format("Top 5! Just %d more to outlast.", r.place - 1))
	elseif r.place <= 10 then
		table.insert(out, string.format("Top 10! %d spots from the podium.", r.place - 3))
	end
	if r.bestPlace > 0 and r.place < r.bestPlace then
		table.insert(out, "New personal best! (was " .. ordinal(r.bestPlace) .. ")")
	elseif r.bestPlace > 0 and r.place > 1 and r.place - r.bestPlace <= 3 and r.place ~= r.bestPlace then
		table.insert(out, string.format("%d places off your best (%s).", r.place - r.bestPlace, ordinal(r.bestPlace)))
	end
	if r.nextKnockGoal and r.nextKnockGoal > 0 and r.nextKnockGoal <= 2 then
		table.insert(out, string.format("%d more knock%s finishes a challenge.", r.nextKnockGoal, r.nextKnockGoal == 1 and "" or "s"))
	end
	local mins = math.floor(r.survived / 60)
	if #out < 3 and mins >= 1 then
		table.insert(out, string.format("You lasted %d:%02d.", mins, math.floor(r.survived) % 60))
	end
	while #out > 3 do
		table.remove(out)
	end
	return out
end

return NearMiss
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Queue</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Lobby fill rules for a 48-contender match.
	  * Launch at once when 48 humans are queued.
	  * Otherwise, after `fillAfter` s with at least `minHumans`, or after `lateFillAfter` s with
	    at least `lateMinHumans`, launch and fill the rest with labeled Stand-In bots.
	  * A single server (v1) can only ever hold 50 people, so it uses the single-server rule.
]]
local Queue = {}

export type Rules = {
	fillAfter: number,
	minHumans: number,
	lateFillAfter: number,
	lateMinHumans: number,
	singleServerFillAfter: number,
	singleServerMinHumans: number,
}

function Queue.shouldLaunch(humans: number, waited: number, size: number, rules: Rules, singleServer: boolean): (boolean, string)
	if humans <= 0 then
		return false, "empty"
	end
	if humans >= size then
		return true, "full"
	end
	if singleServer then
		if waited >= rules.singleServerFillAfter and humans >= rules.singleServerMinHumans then
			return true, "single-server-fill"
		end
		return false, "waiting"
	end
	if waited >= rules.fillAfter and humans >= rules.minHumans then
		return true, "timer-fill"
	end
	if waited >= rules.lateFillAfter and humans >= rules.lateMinHumans then
		return true, "late-fill"
	end
	return false, "waiting"
end

-- Seconds left on the visible lobby timer (nil = waiting for more players).
function Queue.secondsLeft(humans: number, waited: number, size: number, rules: Rules, singleServer: boolean): number?
	if humans <= 0 then
		return nil
	end
	if humans >= size then
		return 0
	end
	if singleServer then
		return math.max(0, rules.singleServerFillAfter - waited)
	end
	if humans >= rules.minHumans then
		return math.max(0, rules.fillAfter - waited)
	end
	if humans >= rules.lateMinHumans then
		return math.max(0, rules.lateFillAfter - waited)
	end
	return nil
end

export type Entry = { id: string, reach: string?, partner: string? }
export type Slot = { id: string, reach: string, partner: string? }

--[[
	Assigns every entry a Reach with at most `per` contenders per Reach, keeping partners
	together. Entries are humans first (in queue order); `botIds` fill the rest.
	Returns slots in plate order: partners on neighbouring plates.
]]
function Queue.assign(entries: { Entry }, botIds: { string }, reaches: { string }, per: number): { Slot }
	local count: { [string]: number } = {}
	local byReach: { [string]: { string } } = {}
	local assigned: { [string]: string } = {}
	local function free(r: string): boolean
		return (count[r] or 0) < per
	end
	local function put(id: string, r: string)
		count[r] = (count[r] or 0) + 1
		byReach[r] = byReach[r] or {}
		table.insert(byReach[r], id)
		assigned[id] = r
	end
	local function firstFree(need: number): string?
		for _, r in ipairs(reaches) do
			if per - (count[r] or 0) >= need then
				return r
			end
		end
		return nil
	end
	local byId: { [string]: Entry } = {}
	for _, e in ipairs(entries) do
		byId[e.id] = e
	end
	-- partners first (both must agree)
	for _, e in ipairs(entries) do
		local p = e.partner
		if not assigned[e.id] and p and byId[p] and byId[p].partner == e.id and not assigned[p] then
			local want = e.reach
			local r = (want and per - (count[want] or 0) >= 2) and want or firstFree(2)
			if r then
				put(e.id, r)
				put(p, r)
			end
		end
	end
	for _, e in ipairs(entries) do
		if not assigned[e.id] then
			local want = e.reach
			local r = (want and free(want)) and want or firstFree(1)
			if r then
				put(e.id, r)
			end
		end
	end
	for _, b in ipairs(botIds) do
		local r = firstFree(1)
		if not r then
			break
		end
		put(b, r)
	end
	local slots: { Slot } = {}
	for _, r in ipairs(reaches) do
		local list = byReach[r]
		if list then
			for i, id in ipairs(list) do
				local other = list[3 - i]
				table.insert(slots, { id = id, reach = r, partner = other })
			end
		end
	end
	return slots
end

return Queue
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
-- Token bucket per key. `now` is passed in (server uses os.clock()) so it's testable.
local RateLimiter = {}
RateLimiter.__index = RateLimiter

export type Limiter = typeof(setmetatable({} :: { capacity: number, refill: number, buckets: { [any]: { tokens: number, t: number } } }, RateLimiter))

function RateLimiter.new(capacity: number, refillPerSecond: number): Limiter
	return setmetatable({ capacity = capacity, refill = refillPerSecond, buckets = {} }, RateLimiter)
end

function RateLimiter.allow(self: Limiter, key: any, now: number, cost: number?): boolean
	local c = cost or 1
	local b = self.buckets[key]
	if not b then
		b = { tokens = self.capacity, t = now }
		self.buckets[key] = b
	end
	b.tokens = math.min(self.capacity, b.tokens + (now - b.t) * self.refill)
	b.t = now
	if b.tokens >= c then
		b.tokens -= c
		return true
	end
	return false
end

function RateLimiter.forget(self: Limiter, key: any)
	self.buckets[key] = nil
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">ReachStandings</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Reach loyalty. Pick a home Reach once (change it once a week). Every win and top-5 finish by
	anyone repping that Reach adds points to the weekly server-wide table. The top 3 Reaches each
	week earn a cosmetic banner for everyone who played a match for them that week.
]]
local ReachStandings = {}

ReachStandings.POINTS = { win = 10, top5 = 3, knock = 1 }

export type Row = { reach: string, points: number }

function ReachStandings.add(tbl: { [string]: number }, reach: string, points: number)
	tbl[reach] = (tbl[reach] or 0) + points
end

function ReachStandings.sorted(tbl: { [string]: number }): { Row }
	local rows: { Row } = {}
	for r, p in pairs(tbl) do
		table.insert(rows, { reach = r, points = p })
	end
	table.sort(rows, function(a: Row, b: Row): boolean
		if a.points == b.points then
			return a.reach < b.reach
		end
		return a.points > b.points
	end)
	return rows
end

function ReachStandings.pointsFor(place: number, knocks: number): number
	local p = knocks * ReachStandings.POINTS.knock
	if place == 1 then
		p += ReachStandings.POINTS.win
	elseif place <= 5 then
		p += ReachStandings.POINTS.top5
	end
	return p
end

-- Banner for a finished week: top 3 Reaches by points (ties broken by name).
function ReachStandings.banners(tbl: { [string]: number }): { string }
	local out = {}
	for i, row in ipairs(ReachStandings.sorted(tbl)) do
		if i > 3 or row.points <= 0 then
			break
		end
		table.insert(out, row.reach)
	end
	return out
end

-- Players can change their home Reach once per week.
function ReachStandings.canChange(lastChangeWeek: number, week: number): boolean
	return lastChangeWeek < week
end

return ReachStandings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">ReceiptLedger</string>
            <string name="Source"><![CDATA[--!strict
-- Remembers recent PurchaseIds inside the player's saved data so ProcessReceipt is idempotent:
-- if Roblox calls us again for the same purchase, we don't grant twice.
local ReceiptLedger = {}

function ReceiptLedger.has(list: { string }, purchaseId: string): boolean
	for _, id in ipairs(list) do
		if id == purchaseId then
			return true
		end
	end
	return false
end

function ReceiptLedger.add(list: { string }, purchaseId: string, max: number)
	if ReceiptLedger.has(list, purchaseId) then
		return
	end
	table.insert(list, purchaseId)
	while #list > max do
		table.remove(list, 1)
	end
end

return ReceiptLedger
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Reconcile</string>
            <string name="Source"><![CDATA[--!strict
-- Deep-fills missing keys from a template so old saves gain new fields after an update.
local Reconcile = {}

local function deepCopy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, x in pairs(v) do
		out[k] = deepCopy(x)
	end
	return out
end
Reconcile.deepCopy = deepCopy

function Reconcile.fill(target: any, template: any): any
	if type(target) ~= "table" then
		return deepCopy(template)
	end
	for k, v in pairs(template) do
		if target[k] == nil then
			target[k] = deepCopy(v)
		elseif type(v) == "table" and type(target[k]) == "table" and next(v) ~= nil then
			Reconcile.fill(target[k], v)
		end
	end
	return target
end

return Reconcile
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">SeasonTrack</string>
            <string name="Source"><![CDATA[--!strict
--[[
	The Season Track: 30 tiers per season, earned by playing (Daybreak Stars).
	  * Free lane: every player gets every free reward by playing. Nothing random.
	  * Premium lane (optional game pass): extra cosmetics on the same tiers. It never
	    sells power, never sells tiers, and never expires mid-season.
	  * Every reward is shown before you earn it.
]]
local SeasonTrack = {}

export type Reward = { kind: string, id: string, name: string, amount: number? }
export type Tier = { free: Reward, premium: Reward }

SeasonTrack.SEASON = 1
SeasonTrack.SEASON_NAME = "Season 1: First Light"
SeasonTrack.TIERS = 30

local FREE_COSMETICS = {
	"Reach Pin", "Dawn Scarf", "Lantern Trail", "Wheat Crown", "Slate Cloak",
	"Copper Bracer", "Glow Arrows", "Meadow Charm", "Gallery Wave", "Sundial Frame",
}
local PREMIUM_COSMETICS = {
	"Gilded Sash", "Ember Cloak", "Daybreak Halo", "Candyfinch Pet", "Veil Shimmer Fade",
	"Spire Parade Coat", "Mirror Bow Skin", "Ashen Spear Skin", "Marigold Banner", "Sunrise Wings",
	"Regent Gold Fade", "Whisperwood Hood", "Star Lantern Pack", "Champion Plume", "Legend Aura",
}

local function id(s: string): string
	return (s:lower():gsub("%s+", "_"))
end

local tiers: { Tier } = {}
for t = 1, SeasonTrack.TIERS do
	local free: Reward
	if t % 3 == 0 then
		local name = FREE_COSMETICS[t // 3]
		free = { kind = "cosmetic", id = id(name), name = name }
	elseif t % 3 == 1 then
		free = { kind = "renown", id = "renown", name = "+150 Renown", amount = 150 }
	else
		free = { kind = "emote", id = "emote_" .. t, name = "Emote: " .. ({ "Bow", "Salute", "Wave", "Cheer", "Shrug", "Dance", "Twirl", "Clap", "Point", "Flex" })[(t // 3) % 10 + 1] }
	end
	local pname = PREMIUM_COSMETICS[math.min(#PREMIUM_COSMETICS, (t + 1) // 2)]
	local premium: Reward = { kind = "cosmetic", id = id(pname) .. "_" .. t, name = pname }
	tiers[t] = { free = free, premium = premium }
end
SeasonTrack.tiers = tiers

export type State = { season: number, stars: number, claimedFree: { [string]: boolean }, claimedPremium: { [string]: boolean } }

function SeasonTrack.new(season: number): State
	return { season = season, stars = 0, claimedFree = {}, claimedPremium = {} }
end

-- If a new season started, reset the track (owned cosmetics stay forever).
function SeasonTrack.ensure(s: State, season: number): boolean
	if s.season ~= season then
		s.season = season
		s.stars = 0
		s.claimedFree = {}
		s.claimedPremium = {}
		return true
	end
	return false
end

function SeasonTrack.tierFor(stars: number, perTier: number): number
	return math.clamp(stars // perTier, 0, SeasonTrack.TIERS)
end

function SeasonTrack.addStars(s: State, n: number, perTier: number): number
	local before = SeasonTrack.tierFor(s.stars, perTier)
	s.stars += math.max(0, math.floor(n))
	return SeasonTrack.tierFor(s.stars, perTier) - before
end

-- Claim one tier's reward. lane = "free" or "premium". Returns the reward or nil + reason.
function SeasonTrack.claim(s: State, tier: number, lane: string, hasPremium: boolean, perTier: number): (Reward?, string?)
	if tier < 1 or tier > SeasonTrack.TIERS then
		return nil, "No such tier."
	end
	if SeasonTrack.tierFor(s.stars, perTier) < tier then
		return nil, "Keep playing to reach this tier."
	end
	local key = tostring(tier)
	if lane == "free" then
		if s.claimedFree[key] then
			return nil, "Already claimed."
		end
		s.claimedFree[key] = true
		return tiers[tier].free, nil
	elseif lane == "premium" then
		if not hasPremium then
			return nil, "Premium lane is optional and not owned."
		end
		if s.claimedPremium[key] then
			return nil, "Already claimed."
		end
		s.claimedPremium[key] = true
		return tiers[tier].premium, nil
	end
	return nil, "Unknown lane."
end

-- Number of reached tiers whose rewards are waiting to be claimed.
function SeasonTrack.unclaimed(s: State, hasPremium: boolean, perTier: number): number
	local n = 0
	for t = 1, SeasonTrack.tierFor(s.stars, perTier) do
		if not s.claimedFree[tostring(t)] then
			n += 1
		end
		if hasPremium and not s.claimedPremium[tostring(t)] then
			n += 1
		end
	end
	return n
end

return SeasonTrack
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">SessionLock</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Session locking for DataStore records shaped { lock = {jobId, time}?, data = {...} }.
	A server may only write a record it holds the lock for. Locks are refreshed on every autosave;
	a lock older than `staleAfter` seconds is treated as abandoned (crashed server) and can be taken.
	These are the pure transform helpers used inside DataStore:UpdateAsync.
]]
local SessionLock = {}

export type Record = { lock: { jobId: string, time: number }?, data: any? }

-- Returns (newRecord or nil to cancel, status)
function SessionLock.acquire(old: Record?, jobId: string, now: number, staleAfter: number): (Record?, string)
	local rec: Record = old or { data = nil }
	local lock = rec.lock
	if lock and lock.jobId ~= jobId and (now - lock.time) < staleAfter then
		return nil, "locked"
	end
	local stolen = lock ~= nil and lock.jobId ~= jobId
	rec.lock = { jobId = jobId, time = now }
	return rec, stolen and "stale-taken" or "acquired"
end

function SessionLock.canWrite(old: Record?, jobId: string): boolean
	if old == nil then
		return true
	end
	local lock = (old :: Record).lock
	return lock == nil or lock.jobId == jobId
end

-- Transform for saves. `release` clears the lock (player left / server closing).
function SessionLock.save(old: Record?, jobId: string, now: number, data: any, release: boolean): (Record?, string)
	if not SessionLock.canWrite(old, jobId) then
		return nil, "lost-lock"
	end
	local rec: Record = { data = data, lock = nil }
	if not release then
		rec.lock = { jobId = jobId, time = now }
	end
	return rec, "saved"
end

return SessionLock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Streak</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Forgiving daily streak.
	  * Counts once per UTC day you finish at least one match.
	  * Miss exactly one day? Your one free miss for the week covers it automatically.
	  * Miss more? You drop back to the first day of your current 7-day week, never to zero.
]]
local Streak = {}

export type State = { lastDay: number, count: number, best: number, freeMissWeek: number }

local function weekOf(day: number): number
	return math.floor((day + 3) / 7)
end

function Streak.new(): State
	return { lastDay = -1, count = 0, best = 0, freeMissWeek = -1 }
end

function Streak.canClaim(s: State, today: number): boolean
	return s.lastDay ~= today
end

export type Result = { ok: boolean, count: number, cycleDay: number, week: number, usedFreeMiss: boolean, softReset: boolean }

function Streak.claim(s: State, today: number): Result
	if s.lastDay == today then
		return { ok = false, count = s.count, cycleDay = ((s.count - 1) % 7) + 1, week = math.ceil(s.count / 7), usedFreeMiss = false, softReset = false }
	end
	local usedFreeMiss, softReset = false, false
	local gap = today - s.lastDay
	if s.lastDay < 0 or s.count <= 0 then
		s.count = 1
	elseif gap == 1 then
		s.count += 1
	elseif gap == 2 and s.freeMissWeek ~= weekOf(today) then
		s.count += 1
		s.freeMissWeek = weekOf(today)
		usedFreeMiss = true
	elseif gap <= 0 then
		-- clock went backwards; treat as same streak, no reward abuse
		s.lastDay = today
		return { ok = false, count = s.count, cycleDay = ((s.count - 1) % 7) + 1, week = math.ceil(s.count / 7), usedFreeMiss = false, softReset = false }
	else
		-- soft reset to the start of the current week of the streak
		s.count = s.count - ((s.count - 1) % 7)
		softReset = true
	end
	s.lastDay = today
	s.best = math.max(s.best, s.count)
	return { ok = true, count = s.count, cycleDay = ((s.count - 1) % 7) + 1, week = math.ceil(s.count / 7), usedFreeMiss = usedFreeMiss, softReset = softReset }
end

-- Renown scales gently with how many weeks you've kept it going (caps at week 4).
function Streak.rewardScale(count: number): number
	local tier = math.clamp(math.ceil(math.max(1, count) / 7), 1, 4)
	return 1 + 0.5 * (tier - 1)
end

return Streak
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">TimeUtil</string>
            <string name="Source"><![CDATA[--!strict
-- Day and week numbers (UTC) used by streaks, challenges, weekly rules and Reach standings.
local TimeUtil = {}

function TimeUtil.day(t: number): number
	return math.floor(t / 86400)
end

-- Weeks start on Monday (1970-01-01 was a Thursday, hence the +3).
function TimeUtil.week(t: number): number
	return math.floor((TimeUtil.day(t) + 3) / 7)
end

function TimeUtil.clock(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", s // 60, s % 60)
end

-- Small deterministic hash so every server picks the same daily challenges and twists.
function TimeUtil.hash(n: number): number
	local x = (n * 2654435761) % 4294967296
	return math.floor(x)
end

return TimeUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Twists</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Arena twists. Every match rolls one small twist from the week's pool, and every week has a
	Jubilee Rule that applies to all matches (shown in the lobby and on the Season board).
	Twists change the arena, never the shop; all are free and all are announced before launch.
]]
-- Same hash as TimeUtil.hash (kept local so this module has no requires and runs in Lune tests).
local function hash(n: number): number
	return math.floor((n * 2654435761) % 4294967296)
end

local Twists = {}

export type Twist = { id: string, name: string, text: string, mods: { [string]: number } }

Twists.MATCH = {
	{ id = "longbows", name = "Long Bows", text = "Bows reach 25% farther.", mods = { bowRange = 1.25 } },
	{ id = "feast", name = "Feast Crates", text = "Twice as many snacks in crates.", mods = { snacks = 2 } },
	{ id = "quickveil", name = "Quick Veil", text = "The Veil moves 15% sooner.", mods = { veil = 0.85 } },
	{ id = "twilight", name = "Twilight Arena", text = "The arena starts at dusk. Lanterns glow.", mods = { clock = 18.6 } },
	{ id = "featherfall", name = "Featherfall", text = "Lower gravity. Big jumps!", mods = { gravity = 0.6 } },
	{ id = "finchday", name = "Finch Day", text = "Candyfinches come twice.", mods = { finches = 2 } },
	{ id = "richhub", name = "Golden Sundial", text = "Extra crates at the Sundial.", mods = { hubCrates = 1.5 } },
	{ id = "fog", name = "Morning Fog", text = "Thick fog until the first Veil shrink.", mods = { fog = 1 } },
} :: { Twist }

Twists.WEEKLY = {
	{ id = "w_gallery", name = "Gallery Week", text = "Gifts cost 25% less Favor.", mods = { giftCost = 0.75 } },
	{ id = "w_tokens", name = "Token Hunt", text = "6 Jubilee Tokens per arena instead of 4.", mods = { tokens = 6 } },
	{ id = "w_encore", name = "Double Encore", text = "The Gallery votes two contenders back in.", mods = { encores = 2 } },
	{ id = "w_stars", name = "Starfall", text = "+1 Daybreak Star for every match.", mods = { bonusStars = 1 } },
} :: { Twist }

function Twists.weekly(week: number): Twist
	return Twists.WEEKLY[(week % #Twists.WEEKLY) + 1]
end

-- Match twist from a match counter + week (different every match, same across servers by seed).
function Twists.forMatch(matchNo: number, week: number): Twist
	local h = hash(week * 97 + matchNo)
	return Twists.MATCH[((h // 4096) % #Twists.MATCH) + 1]
end

function Twists.mod(list: { Twist }, key: string, default: number): number
	local v = default
	for _, t in ipairs(list) do
		local m = t.mods[key]
		if m ~= nil then
			if key == "tokens" or key == "encores" or key == "clock" or key == "fog" or key == "bonusStars" then
				v = m
			else
				v *= m
			end
		end
	end
	return v
end

return Twists
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Veil</string>
            <string name="Source"><![CDATA[--!strict
-- The Veil (force field) timeline: radius over time, warnings and damage.
local Veil = {}

export type Phase = { at: number, from: number, to: number, dur: number }

function Veil.radiusAt(t: number, phases: { Phase }, startRadius: number): number
	local r = startRadius
	for _, p in ipairs(phases) do
		if t < p.at then
			return r
		elseif t < p.at + p.dur then
			local a = (t - p.at) / p.dur
			return p.from + (p.to - p.from) * a
		else
			r = p.to
		end
	end
	return r
end

-- 0 before the first shrink starts, 1 during/after phase 1, and so on.
function Veil.phaseIndex(t: number, phases: { Phase }): number
	local idx = 0
	for i, p in ipairs(phases) do
		if t >= p.at then
			idx = i
		end
	end
	return idx
end

-- Seconds until the next shrink starts (nil when no more shrinks), and that phase's target radius.
function Veil.nextShrink(t: number, phases: { Phase }): (number?, number?)
	for _, p in ipairs(phases) do
		if t < p.at then
			return p.at - t, p.to
		end
	end
	return nil, nil
end

function Veil.isShrinking(t: number, phases: { Phase }): boolean
	for _, p in ipairs(phases) do
		if t >= p.at and t < p.at + p.dur then
			return true
		end
	end
	return false
end

function Veil.damage(t: number, phases: { Phase }, table_: { number }): number
	local i = Veil.phaseIndex(t, phases) + 1
	return table_[math.min(i, #table_)]
end

-- A twist can speed the whole timeline up (e.g. Quick Veil = 0.85).
function Veil.scaled(phases: { Phase }, k: number): { Phase }
	local out = {}
	for _, p in ipairs(phases) do
		table.insert(out, { at = math.floor(p.at * k), from = p.from, to = p.to, dur = math.max(10, math.floor(p.dur * k)) })
	end
	return out
end

function Veil.outside(dx: number, dz: number, radius: number): boolean
	return dx * dx + dz * dz > radius * radius
end

return Veil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Vote</string>
            <string name="Source"><![CDATA[--!strict
-- Gallery votes (hazard cards and Encore vote-backs). One vote per spectator; ties go to the
-- option listed first so results are deterministic and explainable.
local Vote = {}

export type Ballot = { options: { string }, votes: { [string]: string } }

function Vote.new(options: { string }): Ballot
	return { options = options, votes = {} }
end

function Vote.cast(b: Ballot, voter: string, option: string): boolean
	if not table.find(b.options, option) then
		return false
	end
	b.votes[voter] = option
	return true
end

function Vote.counts(b: Ballot): { [string]: number }
	local c: { [string]: number } = {}
	for _, o in ipairs(b.options) do
		c[o] = 0
	end
	for _, o in pairs(b.votes) do
		c[o] = (c[o] or 0) + 1
	end
	return c
end

function Vote.winner(b: Ballot): (string, number)
	local c = Vote.counts(b)
	local best, n = b.options[1], -1
	for _, o in ipairs(b.options) do
		if c[o] > n then
			best, n = o, c[o]
		end
	end
	return best, n
end

return Vote
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--!nocheck
--[[
	MapBuilder — builds the whole world out of plain Parts (no uploaded assets needed):
	  * the 2400-stud arena: the golden Sundial hub (no horn of plenty), 48 lift plates, the
	    Gilded Meadow, Mirror Lake, Whisperwood, Ashen Ridge, Old Glassford ruins, scattered crates,
	    24 token spots and the Veil dome;
	  * the Viewing Gallery lounge floating above the hub;
	  * the lobby: the Reach square with the Harvesting stage, glass globe, jumbotron, Herald,
	    Rusty, camera marks for the reaping cutscene, the Draw Gate queue, boards and a range.
	It only uses Instance.new + datatypes passed in through `env`, so it runs both in Roblox (the
	server builds the map at startup if Workspace.Map is missing) and in Lune (scripts/bake-map
	bakes it into DaybreakOnTheHarvesting.rbxlx so it shows in Studio edit mode and in renders).
]]
local MapBuilder = {}

local E -- env (Roblox globals)

function MapBuilder.setEnv(env)
	E = env
end

local function hex(h)
	return E.Color3.fromHex(h)
end

local function part(parent, name, size, cf, color, material, props)
	local p = E.Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = hex(color)
	p.Material = material or E.Enum.Material.SmoothPlastic
	p.TopSurface = E.Enum.SurfaceType.Smooth
	p.BottomSurface = E.Enum.SurfaceType.Smooth
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end
MapBuilder.part = part

local function model(parent, name)
	local m = E.Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function folder(parent, name)
	local f = E.Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function V(x, y, z)
	return E.Vector3.new(x, y, z)
end

local function lookAt(a, b)
	if E.CFrame.lookAt then
		return E.CFrame.lookAt(a, b)
	end
	return E.CFrame.new(a, b)
end

local function cyl(parent, name, length, diameter, cf, color, material, props)
	-- Roblox cylinders run along X. `cf` is the center.
	local p = part(parent, name, V(length, diameter, diameter), cf, color, material, props)
	p.Shape = E.Enum.PartType.Cylinder
	return p
end

local function _ball(parent, name, d, cf, color, material, props)
	local p = part(parent, name, V(d, d, d), cf, color, material, props)
	p.Shape = E.Enum.PartType.Ball
	return p
end

local function prompt(parent, kind, action, object, hold, dist, extra)
	local pp = E.Instance.new("ProximityPrompt")
	pp.Name = "Prompt"
	pp.ActionText = action
	pp.ObjectText = object or ""
	pp.HoldDuration = hold or 0
	pp.MaxActivationDistance = dist or 10
	pp.RequiresLineOfSight = false
	pp:SetAttribute("Kind", kind)
	if extra then
		for k, v in pairs(extra) do
			pp[k] = v
		end
	end
	pp.Parent = parent
	return pp
end
MapBuilder.prompt = prompt

local function surfaceText(p, face, text, textColor, bg, font)
	local sg = E.Instance.new("SurfaceGui")
	sg.Name = "SignGui"
	sg.Face = face or E.Enum.NormalId.Front
	sg.SizingMode = E.Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.Parent = p
	local tl = E.Instance.new("TextLabel")
	tl.Name = "Text"
	tl.Size = E.UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = bg and 0 or 1
	if bg then
		tl.BackgroundColor3 = hex(bg)
	end
	tl.TextColor3 = hex(textColor or "#FFFFFF")
	tl.Font = font or E.Enum.Font.FredokaOne
	tl.TextScaled = true
	tl.Text = text
	tl.Parent = sg
	return tl
end
MapBuilder.surfaceText = surfaceText

-- `studs` (optional {w, h}) sizes the label in world studs instead of pixels, so labels on
-- closely spaced things (smoker row, grill spots, customer tables) shrink with distance
-- instead of piling on top of each other.
local function billboard(adornee, name, text, offsetY, maxDist, color, w, h, studs: { number }?)
	local b = E.Instance.new("BillboardGui")
	b.Name = name
	if studs then
		b.Size = E.UDim2.new(studs[1], 0, studs[2], 0)
	else
		b.Size = E.UDim2.new(0, w or 160, 0, h or 40)
	end
	b.StudsOffset = V(0, offsetY or 3, 0)
	b.AlwaysOnTop = false
	b.MaxDistance = maxDist or 80
	b.LightInfluence = 0
	b.Parent = adornee
	local tl = E.Instance.new("TextLabel")
	tl.Name = "Text"
	tl.Size = E.UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.TextColor3 = hex(color or "#FFFFFF")
	tl.TextStrokeTransparency = 0.3
	tl.Font = E.Enum.Font.FredokaOne
	tl.TextScaled = true
	tl.Text = text
	tl.Parent = b
	return b
end
MapBuilder.billboard = billboard

-- Decorative parts: no collision, query or touch (shadow is opt-in).
local function deco(parent, name, size, cf, color, material, shadow)
	return part(parent, name, size, cf, color, material, { CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = shadow == true })
end
local function dball(parent, name, d, cf, color, material, shadow)
	local p = deco(parent, name, V(d, d, d), cf, color, material, shadow)
	p.Shape = E.Enum.PartType.Ball
	return p
end
local function _dcyl(parent, name, length, diameter, cf, color, material, shadow)
	local p = deco(parent, name, V(length, diameter, diameter), cf, color, material, shadow)
	p.Shape = E.Enum.PartType.Cylinder
	return p
end

local function _upright()
	return E.CFrame.Angles(0, 0, math.pi / 2) -- turns an X-axis cylinder upright
end

-- Ellipsoid part (a Part with a Sphere SpecialMesh) for soft, round shapes.
local function sph(parent, name, size, cf, color, material, props)
	local p = part(parent, name, size, cf, color, material, props)
	local mesh = E.Instance.new("SpecialMesh")
	mesh.MeshType = E.Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

-- A round, chibi-proportioned NPC: a big head, a soft pear-shaped body, mitten hands, and
-- shiny eyes with rosy cheeks. Feet at `cf`, facing -Z. Part names Head and Torso are what
-- the game looks up (prompts and name tags hang off them).
-- Options: skin, shirt, pants, shoes, hair, hat ("cowboy" | "cap" | "bun"), hatColor, apron,
-- apronText, glasses, mustache, beard, belly, brows, label, labelColor, scale.
function MapBuilder.npc(parent, name, cf, o)
	o = o or {}
	local m = model(parent, name)
	local skin = o.skin or "#E0AC69"
	local shirt = o.shirt or "#4A6FA5"
	local pants = o.pants or "#3B3B3B"
	local shoes = o.shoes or "#3A2A1E"
	local dark = "#2A1E1A"
	local s = o.scale or 1
	local function at(x, y, z, rx, ry, rz)
		return cf * E.CFrame.new(x * s, y * s, z * s) * E.CFrame.Angles(math.rad(rx or 0), math.rad(ry or 0), math.rad(rz or 0))
	end
	local function e(n, sx, sy, sz, c, x, y, z, rx, ry, rz, mat)
		return sph(m, n, V(sx * s, sy * s, sz * s), at(x, y, z, rx, ry, rz), c, mat)
	end
	-- legs and shoes
	local legL = cyl(m, "LeftLeg", 1.3 * s, 0.8 * s, at(-0.45, 1.0, 0) * E.CFrame.Angles(0, 0, math.pi / 2), pants)
	local legR = cyl(m, "RightLeg", 1.3 * s, 0.8 * s, at(0.45, 1.0, 0) * E.CFrame.Angles(0, 0, math.pi / 2), pants)
	if o.sandals then
		-- socks with sandals: white socks on a brown sole with a strap
		for _, side in { -1, 1 } do
			e("Sock", 0.85, 0.75, 1.2, "#F7F7F2", side * 0.47, 0.42, -0.12)
			e("Sole", 1.0, 0.22, 1.45, "#7A4A2A", side * 0.47, 0.1, -0.15)
			deco(m, "Strap", V(0.9 * s, 0.16 * s, 0.25 * s), at(side * 0.47, 0.55, -0.55), "#7A4A2A", E.Enum.Material.SmoothPlastic, false)
		end
	else
		e("ShoeL", 0.95, 0.6, 1.35, shoes, -0.47, 0.3, -0.15)
		e("ShoeR", 0.95, 0.6, 1.35, shoes, 0.47, 0.3, -0.15)
	end
	-- body: hips + a soft torso (rounder for a belly)
	e("Hips", 2.0, 1.1, 1.6, pants, 0, 1.75, 0)
	if o.buckle then
		e("Belt", 2.05, 0.3, 1.65, "#3A2414", 0, 2.05, 0)
		e("Buckle", 0.6, 0.42, 0.2, o.buckle, 0, 2.05, -0.82, 0, 0, 0, E.Enum.Material.Foil)
	end
	local bw, bd = o.belly and 2.6 or 2.2, o.belly and 2.3 or 1.75
	local torso = sph(m, "Torso", V(bw * s, 2.5 * s, bd * s), at(0, 2.75, 0), shirt)
	if o.apron then
		-- a soft bib that hugs the front of the torso, with a flat name patch on it
		e("ApronBib", bw * 0.78, 2.3, bd * 1.0, o.apron, 0, 2.6, -bd * 0.12, 0, 0, 0)
		local ap = part(m, "Apron", V(1.25 * s, 0.6 * s, 0.05 * s), at(0, 2.55, -bd * 0.62 - 0.01), o.apron, E.Enum.Material.Fabric)
		ap.CanCollide = false
		if o.apronText then
			surfaceText(ap, E.Enum.NormalId.Front, o.apronText, "#FFFFFF", nil)
		end
	end
	-- arms: sleeves angled out a little, mitten hands
	for _, side in { -1, 1 } do
		local ax = side * (bw / 2 + 0.2)
		e(side < 0 and "LeftArm" or "RightArm", 0.75, 1.7, 0.75, shirt, ax, 2.85, 0, 0, 0, side * 16)
		e(side < 0 and "HandL" or "HandR", 0.7, 0.7, 0.7, skin, ax + side * 0.25, 1.95, -0.05)
	end
	-- head: a big round face
	local head = sph(m, "Head", V(2.5 * s, 2.4 * s, 2.35 * s), at(0, 4.85, 0), skin)
	e("EarL", 0.38, 0.6, 0.35, skin, -1.24, 4.85, 0.05)
	e("EarR", 0.38, 0.6, 0.35, skin, 1.24, 4.85, 0.05)
	for _, side in { -1, 1 } do
		e(side < 0 and "EyeL" or "EyeR", 0.34, 0.5, 0.2, dark, side * 0.45, 5.0, -1.08)
		e(side < 0 and "ShineL" or "ShineR", 0.13, 0.13, 0.08, "#FFFFFF", side * 0.45 - 0.07, 5.12, -1.18, 0, 0, 0, E.Enum.Material.Neon)
		e(side < 0 and "CheekL" or "CheekR", 0.5, 0.3, 0.12, "#F28B82", side * 0.78, 4.6, -0.98)
		if o.brows ~= false then
			deco(m, "Brow", V(0.5 * s, 0.12 * s, 0.1 * s), at(side * 0.45, 5.42, -1.06, 0, 0, side * -8), o.hair or dark, E.Enum.Material.SmoothPlastic, false)
		end
	end
	e("Nose", 0.4, 0.34, 0.3, skin, 0, 4.68, -1.18)
	if o.mustache then
		e("Mustache", 1.25, 0.36, 0.4, o.mustache, 0, 4.42, -1.12)
		e("Smile", 0.5, 0.16, 0.12, "#7A2E2E", 0, 4.18, -1.13)
	else
		e("Smile", 0.66, 0.2, 0.12, "#7A2E2E", 0, 4.32, -1.14)
	end
	if o.beard then
		e("Beard", 1.7, 0.9, 1.0, o.beard, 0, 3.9, -0.75)
	end
	if o.glasses then
		for _, side in { -1, 1 } do
			local lens = cyl(m, "Glasses", 0.08 * s, 0.75 * s, at(side * 0.45, 5.0, -1.2) * E.CFrame.Angles(0, math.pi / 2, 0), "#BFE3FF", E.Enum.Material.Glass, { Transparency = 0.55 })
			lens.CanCollide = false
			deco(m, "GlassesRim", V(0.8 * s, 0.08 * s, 0.06 * s), at(side * 0.45, 5.38, -1.2), "#3A2A1E", E.Enum.Material.SmoothPlastic, false)
		end
		deco(m, "GlassesBridge", V(0.2 * s, 0.07 * s, 0.06 * s), at(0, 5.1, -1.22), "#3A2A1E", E.Enum.Material.SmoothPlastic, false)
	end
	-- hair and hats
	if o.hair and o.hat ~= "cowboy" then
		e("Hair", 2.6, 1.35, 2.5, o.hair, 0, 5.55, 0.12)
	end
	if o.hat == "cowboy" then
		local hc = o.hatColor or "#3B2A1A"
		cyl(m, "HatBrim", 0.18 * s, 4.3 * s, at(0, 5.75, 0) * E.CFrame.Angles(0, 0, math.pi / 2), hc)
		e("HatBrimCurlL", 0.9, 0.5, 3.6, hc, -1.85, 5.95, 0)
		e("HatBrimCurlR", 0.9, 0.5, 3.6, hc, 1.85, 5.95, 0)
		e("HatCrown", 2.3, 1.6, 2.1, hc, 0, 6.4, 0)
		cyl(m, "HatBand", 0.3 * s, 2.32 * s, at(0, 6.0, 0) * E.CFrame.Angles(0, 0, math.pi / 2), o.hatBand or "#8B5A2B")
	elseif o.hat == "cap" then
		local hc = o.hatColor or "#B22222"
		e("Cap", 2.6, 1.5, 2.5, hc, 0, 5.6, 0.05)
		e("Bill", 1.8, 0.2, 1.3, hc, 0, 5.4, -1.2)
		e("CapButton", 0.3, 0.2, 0.3, "#FFFFFF", 0, 6.33, 0.05)
	elseif o.hat == "bun" then
		e("Hair", 2.6, 1.35, 2.5, o.hatColor or "#DDDDDD", 0, 5.55, 0.12)
		e("Bun", 1.15, 1.05, 1.15, o.hatColor or "#DDDDDD", 0, 6.25, 0.45)
		if o.pearls then
			for k = -2, 2 do
				dball(m, "Pearl", 0.22 * s, at(k * 0.32, 3.95 - math.abs(k) * 0.05, -0.82 + math.abs(k) * 0.08), "#FFF8E7", E.Enum.Material.SmoothPlastic, false)
			end
		end
	end
	for _, c in ipairs(m:GetDescendants()) do
		if c:IsA("BasePart") then
			c.CanCollide = c == torso or c == legL or c == legR
		end
	end
	m.PrimaryPart = torso
	if o.label then
		billboard(head, "NameTag", o.label, 2.8, 60, o.labelColor or "#FFE9A8", 200, 36)
	end
	return m, head, torso
end

-- ===================== palette (from the plan's "Color & Look") =====================
local PAL = {
	marble = "#E9E4DA",
	gold = "#D4A72C",
	goldHi = "#F2CF63",
	slate = "#4A505C",
	soot = "#2B2D33",
	haze = "#F7B27A",
	meadow = "#3FBF5A",
	meadowDeep = "#2F9447",
	bloom = "#FF4FB8",
	finch = "#FF8AD8",
	lake = "#49C6E5",
	wood = "#2E5A3A",
	woodDark = "#244A2F",
	veil = "#7FF3FF",
	field = { "#5F8A45", "#6A9450", "#58803F" },
	fieldDusk = "#4F7440",
	ridge = { "#5A5C63", "#4A505C", "#666870" },
	sand = "#C9B88E",
	trunk = "#4A3426",
	brick = { "#5A4A44", "#4E4A52", "#625750" },
	window = "#FFC870",
	rustyHair = "#B89A5E",
	rustyRoots = "#7E6740",
	rustyShirt = "#C9A13B",
	rustyPlaid = "#2F7F86",
	rustyPants = "#5C5A52",
	thermos = "#3E8E5E",
}
MapBuilder.PALETTE = PAL

local seed = 20261102
local function rnd()
	seed = (seed * 1103515245 + 12345) % 2147483648
	return seed / 2147483648
end
local function rr(a, b)
	return a + (b - a) * rnd()
end
local function pick(t)
	return t[1 + math.floor(rnd() * #t) % #t]
end
local function at(pos)
	return E.CFrame.new(pos)
end
local function yaw(r)
	return E.CFrame.Angles(0, r, 0)
end
local function disc(parent, name, d, thick, pos, color, material, props)
	-- upright cylinder (a flat disc) centered at pos
	return cyl(parent, name, thick, d, at(pos) * E.CFrame.Angles(0, 0, math.pi / 2), color, material, props)
end
local function mark(parent, name, cf)
	return part(parent, name, V(1, 1, 1), cf, "#FFFFFF", E.Enum.Material.SmoothPlastic, { Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false })
end
local function inCircle(x, z, c)
	local dx, dz = x - c.x, z - c.z
	return dx * dx + dz * dz < c.r * c.r
end

-- Which biome is at (x, z)? Used for ground color, scatter and token zones.
function MapBuilder.biomeAt(x, z, cfg)
	local M = cfg.Map
	if math.sqrt(x * x + z * z) < 140 then
		return "hub"
	elseif inCircle(x, z, M.LAKE) then
		return "lake"
	elseif inCircle(x, z, M.MEADOW) then
		return "meadow"
	elseif z < -720 then
		return "ridge"
	elseif inCircle(x, z, M.RUINS) then
		return "ruins"
	elseif x < -300 then
		return "wood"
	end
	return "field"
end

-- ===================== props =====================
local function pine(parent, pos, s)
	local m = model(parent, "Pine")
	deco(m, "Trunk", V(1.6 * s, 10 * s, 1.6 * s), at(pos + V(0, 5 * s, 0)), PAL.trunk, E.Enum.Material.Wood, false)
	local c = pick({ PAL.wood, PAL.woodDark, "#35663F" })
	sph(m, "Needles1", V(11 * s, 9 * s, 11 * s), at(pos + V(0, 10 * s, 0)), c, E.Enum.Material.Grass, { CanCollide = false, CanQuery = false, CastShadow = true })
	sph(m, "Needles2", V(8 * s, 8 * s, 8 * s), at(pos + V(0, 16 * s, 0)), c, E.Enum.Material.Grass, { CanCollide = false, CanQuery = false, CastShadow = true })
	sph(m, "Needles3", V(4.5 * s, 6 * s, 4.5 * s), at(pos + V(0, 21 * s, 0)), c, E.Enum.Material.Grass, { CanCollide = false, CanQuery = false, CastShadow = false })
	part(m, "Hitbox", V(2 * s, 12 * s, 2 * s), at(pos + V(0, 6 * s, 0)), PAL.trunk, E.Enum.Material.Wood, { Transparency = 1, CastShadow = false })
	return m
end

local function broadleaf(parent, pos, s)
	local m = model(parent, "Tree")
	deco(m, "Trunk", V(2 * s, 9 * s, 2 * s), at(pos + V(0, 4.5 * s, 0)), PAL.trunk, E.Enum.Material.Wood, false)
	local c = pick({ "#4F7D3C", "#5E8A44", "#6E8F3A", "#8A8A3A" })
	dball(m, "Canopy", 12 * s, at(pos + V(0, 11 * s, 0)), c, E.Enum.Material.Grass, true)
	dball(m, "Canopy2", 8 * s, at(pos + V(4 * s, 9.5 * s, 2 * s)), c, E.Enum.Material.Grass, false)
	part(m, "Hitbox", V(2.2 * s, 9 * s, 2.2 * s), at(pos + V(0, 4.5 * s, 0)), PAL.trunk, E.Enum.Material.Wood, { Transparency = 1, CastShadow = false })
	return m
end

local function rock(parent, pos, s, color)
	local p = sph(parent, "Rock", V(rr(6, 10) * s, rr(4, 7) * s, rr(6, 10) * s), at(pos + V(0, 1.5 * s, 0)) * yaw(rr(0, 6.28)), color or pick(PAL.ridge), E.Enum.Material.Slate)
	return p
end

local function crate(parent, name, pos, loot, rot)
	local c = part(parent, name, V(4, 3, 3), at(pos + V(0, 1.5, 0)) * yaw(rot or 0), loot == "hub" and "#8A6A3A" or "#6E5236", E.Enum.Material.Wood)
	c:SetAttribute("Loot", loot)
	c:SetAttribute("Crate", true)
	deco(c, "Band", V(4.1, 0.5, 3.1), c.CFrame, loot == "meadow" and PAL.bloom or PAL.gold, E.Enum.Material.Metal, false)
	deco(c, "Band2", V(0.5, 3.1, 3.1), c.CFrame, loot == "meadow" and PAL.bloom or PAL.gold, E.Enum.Material.Metal, false)
	local band = c:FindFirstChild("Band")
	if band then
		band.Parent = parent
		band.Name = name .. "_Band"
	end
	local band2 = c:FindFirstChild("Band2")
	if band2 then
		band2.Parent = parent
		band2.Name = name .. "_Band2"
	end
	prompt(c, "crate", "Open", "Crate", 0.6, 9)
	return c
end

local function townsperson(parent, cf, colors)
	-- a simple low-detail figure for the lobby crowd
	local m = model(parent, "Townsperson")
	local s = rr(0.9, 1.08)
	local function a(x, y, z)
		return cf * E.CFrame.new(x * s, y * s, z * s)
	end
	sph(m, "Legs", V(1.6 * s, 2.2 * s, 1.2 * s), a(0, 1.1, 0), colors[2], E.Enum.Material.Fabric, { CanCollide = false })
	sph(m, "Body", V(2.2 * s, 2.6 * s, 1.6 * s), a(0, 3.0, 0), colors[1], E.Enum.Material.Fabric, { CanCollide = false })
	sph(m, "Head", V(1.7 * s, 1.8 * s, 1.7 * s), a(0, 4.9, 0), colors[3], E.Enum.Material.SmoothPlastic, { CanCollide = false })
	sph(m, "Hair", V(1.8 * s, 0.9 * s, 1.8 * s), a(0, 5.5, 0.1), colors[4], E.Enum.Material.SmoothPlastic, { CanCollide = false })
	return m
end

-- Rusty Dunmore: the scruffy, kind mentor. Built on the shared NPC body with his own details.
function MapBuilder.rusty(env, parent, cf, label)
	if env then
		E = env
	end
	local m, head, torso = MapBuilder.npc(parent, "Rusty", cf, {
		skin = "#D9A877",
		shirt = PAL.rustyShirt,
		pants = PAL.rustyPants,
		shoes = "#3A2E26",
		hair = PAL.rustyHair,
		beard = PAL.rustyRoots,
		brows = true,
		label = label,
		labelColor = "#F2CF63",
	})
	local function a(x, y, z)
		return cf * E.CFrame.new(x, y, z)
	end
	-- messy hair tufts with darker roots
	for i = 1, 5 do
		local ang = (i - 3) * 0.45
		sph(m, "Tuft", V(1.1, 0.9, 1.0), a(math.sin(ang) * 1.1, 6.05 + (i % 2) * 0.2, 0.2 + math.cos(ang) * 0.3) * E.CFrame.Angles(0, 0, ang), i % 2 == 0 and PAL.rustyRoots or PAL.rustyHair, E.Enum.Material.SmoothPlastic, { CanCollide = false })
	end
	-- open plaid overshirt panels
	for _, side in { -1, 1 } do
		sph(m, "Plaid", V(0.9, 2.4, 1.85), a(side * 0.85, 2.75, -0.05), PAL.rustyPlaid, E.Enum.Material.Fabric, { CanCollide = false })
	end
	-- the green thermos in his right hand
	local th = cyl(m, "Thermos", 1.3, 0.6, a(1.6, 2.1, -0.3) * E.CFrame.Angles(0, 0, math.pi / 2), PAL.thermos, E.Enum.Material.Metal, { CanCollide = false })
	cyl(m, "ThermosCap", 0.3, 0.64, a(1.6, 2.85, -0.3) * E.CFrame.Angles(0, 0, math.pi / 2), "#2A2A2A", E.Enum.Material.Metal, { CanCollide = false })
	return m, head, torso, th
end

-- ===================== arena =====================
local function buildGround(root, cfg)
	local g = folder(root, "Ground")
	local half = cfg.Map.ARENA_SIZE / 2
	local tile = 300
	for i = 0, cfg.Map.ARENA_SIZE / tile - 1 do
		for j = 0, cfg.Map.ARENA_SIZE / tile - 1 do
			local x = -half + tile * (i + 0.5)
			local z = -half + tile * (j + 0.5)
			local b = MapBuilder.biomeAt(x, z, cfg)
			local color = pick(PAL.field)
			local mat = E.Enum.Material.Grass
			if b == "ridge" then
				color, mat = "#5E5F58", E.Enum.Material.Ground
			elseif b == "wood" then
				color = "#3F6436"
			elseif b == "ruins" then
				color, mat = "#7A7562", E.Enum.Material.Ground
			end
			part(g, "Tile", V(tile, 16, tile), at(V(x, -8, z)), color, mat)
		end
	end
	-- outer skirt (outside the Veil) and distant hills to frame the sky
	for i = -3, 2 do
		for j = -3, 2 do
			local x, z = 600 * (i + 0.5), 600 * (j + 0.5)
			if math.abs(x) > half or math.abs(z) > half then
				part(g, "Skirt", V(600, 16, 600), at(V(x, -8.5, z)), PAL.fieldDusk, E.Enum.Material.Grass)
			end
		end
	end
	for k = 1, 28 do
		local a = k / 28 * math.pi * 2 + rr(-0.05, 0.05)
		local r = rr(1550, 1750)
		local s = rr(260, 520)
		local color = a > math.pi * 1.1 and a < math.pi * 1.9 and "#575960" or pick({ "#3E5E3A", "#4A6A3E", "#3A5236" })
		sph(g, "Hill", V(s * 1.6, s * 0.7, s), at(V(math.cos(a) * r, -s * 0.12, math.sin(a) * r)) * yaw(-a), color, E.Enum.Material.Grass, { CanCollide = false, CastShadow = false })
	end
end

local function buildHub(root, cfg, names)
	local h = folder(root, "Sundial")
	local R = cfg.Map.HUB_RADIUS
	disc(h, "Apron", R * 2 + 40, 1, V(0, 0.5, 0), "#BFB8A8", E.Enum.Material.Pavement)
	disc(h, "Base", R * 2, 2, V(0, 1.5, 0), PAL.marble, E.Enum.Material.Marble)
	disc(h, "GoldRing", R * 2 - 6, 2.4, V(0, 1.7, 0), PAL.gold, E.Enum.Material.Foil)
	disc(h, "Face", R * 2 - 10, 2.6, V(0, 1.8, 0), PAL.marble, E.Enum.Material.Marble)
	disc(h, "Inlay", 30, 2.8, V(0, 1.9, 0), PAL.goldHi, E.Enum.Material.Foil)
	-- 12 hour marks
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		local r = R - 9
		part(h, "HourMark", V(2, 0.6, 7), at(V(math.cos(a) * r, 3.2, math.sin(a) * r)) * yaw(-a + math.pi / 2), PAL.gold, E.Enum.Material.Foil, { CanCollide = false })
	end
	-- the gnomon: a tall golden blade casting the hub's shadow
	local gnomon = part(h, "Gnomon", V(3, 46, 26), at(V(0, 20, 6)) * E.CFrame.Angles(math.rad(-28), 0, 0), PAL.gold, E.Enum.Material.Foil)
	local light = E.Instance.new("PointLight")
	light.Color = E.Color3.fromHex("#FFD36B")
	light.Brightness = 3
	light.Range = 60
	light.Parent = gnomon
	part(h, "GnomonCap", V(4, 3, 4), at(V(0, 41, -4)), PAL.goldHi, E.Enum.Material.Neon, { CanCollide = false })
	billboard(gnomon, "Label", names.HUB:gsub("^the ", "The "), 30, 900, "#FFE9A8", 220, 40)
	-- crate rings around the dial
	local crates = folder(root, "HubCrates")
	for i = 1, cfg.HUB_CRATES do
		local ring = (i % 3)
		local r = 16 + ring * 9 + (ring == 2 and 4 or 0)
		local a = i / cfg.HUB_CRATES * math.pi * 2 + ring * 0.2
		crate(crates, "HubCrate" .. i, V(math.cos(a) * r, 3.1, math.sin(a) * r), "hub", -a)
	end
	-- 48 lift plates
	local plates = folder(root, "LiftPlates")
	for i = 1, cfg.MATCH_SIZE do
		local a = (i - 1) / cfg.MATCH_SIZE * math.pi * 2
		local pos = V(math.cos(a) * cfg.Map.PLATE_RADIUS, 0, math.sin(a) * cfg.Map.PLATE_RADIUS)
		local p = disc(plates, string.format("Plate%02d", i), 8, 1.2, pos + V(0, 0.6, 0), "#8E949E", E.Enum.Material.DiamondPlate)
		p:SetAttribute("Index", i)
		disc(plates, string.format("Plate%02d_Ring", i), 9, 0.9, pos + V(0, 0.5, 0), PAL.veil, E.Enum.Material.Neon, { CanCollide = false, CanQuery = false })
	end
end

local function buildMeadow(root, cfg)
	local m = folder(root, "GildedMeadow")
	local M = cfg.Map.MEADOW
	disc(m, "Meadow", M.r * 2, 0.4, V(M.x, 0.2, M.z), PAL.meadow, E.Enum.Material.Grass, { CanCollide = false })
	disc(m, "MeadowInner", M.r * 1.3, 0.5, V(M.x, 0.25, M.z), "#4ACB63", E.Enum.Material.Grass, { CanCollide = false })
	local zone = disc(m, "MeadowZone", M.r * 2, 60, V(M.x, 30, M.z), PAL.bloom, E.Enum.Material.SmoothPlastic, { Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false })
	zone:SetAttribute("Zone", "meadow")
	local flowers = model(m, "Flowers")
	for _ = 1, 360 do
		local a, d = rr(0, math.pi * 2), math.sqrt(rnd()) * (M.r - 8)
		local x, z = M.x + math.cos(a) * d, M.z + math.sin(a) * d
		local h = rr(1.2, 2.6)
		deco(flowers, "Stem", V(0.25, h, 0.25), at(V(x, h / 2, z)), "#2F8A3E", E.Enum.Material.Grass, false)
		local c = rnd() < 0.55 and PAL.goldHi or (rnd() < 0.6 and PAL.bloom or "#FFFFFF")
		dball(flowers, "Bloom", rr(0.9, 1.6), at(V(x, h + 0.3, z)), c, rnd() < 0.3 and E.Enum.Material.Neon or E.Enum.Material.SmoothPlastic, false)
	end
	-- golden pollen emitters (off until a Meadow Bloom)
	for k = 1, 7 do
		local a = k / 7 * math.pi * 2
		local p = mark(m, "PollenEmitter", at(V(M.x + math.cos(a) * M.r * 0.55, 4, M.z + math.sin(a) * M.r * 0.55)))
		p.Size = V(M.r * 0.7, 2, M.r * 0.7)
		local pe = E.Instance.new("ParticleEmitter")
		pe.Name = "Pollen"
		pe.Enabled = false
		pe.Rate = 60
		pe.Lifetime = E.NumberRange.new(4, 7)
		pe.Speed = E.NumberRange.new(1, 3)
		pe.SpreadAngle = E.Vector2.new(180, 180)
		pe.LightEmission = 0.8
		pe.Color = E.ColorSequence.new(E.Color3.fromHex("#FFD36B"), E.Color3.fromHex("#FF4FB8"))
		pe.Size = E.NumberSequence.new(0.6)
		pe.Parent = p
	end
	local crates = folder(root, "MeadowCrates")
	for i = 1, cfg.MEADOW_CRATES do
		local a = i / cfg.MEADOW_CRATES * math.pi * 2
		local d = M.r * (i % 2 == 0 and 0.35 or 0.7)
		crate(crates, "MeadowCrate" .. i, V(M.x + math.cos(a) * d, 0.4, M.z + math.sin(a) * d), "meadow", a)
	end
end

local function buildLake(root, cfg)
	local l = folder(root, "MirrorLake")
	local L = cfg.Map.LAKE
	disc(l, "Shore", L.r * 2 + 40, 0.6, V(L.x, 0.3, L.z), PAL.sand, E.Enum.Material.Sand, { CanCollide = false })
	disc(l, "Bed", L.r * 2, 0.7, V(L.x, 0.35, L.z), "#2D6F7E", E.Enum.Material.Slate, { CanCollide = false })
	local w = disc(l, "Water", L.r * 2 - 4, 1.2, V(L.x, 0.6, L.z), PAL.lake, E.Enum.Material.Glass, { Transparency = 0.18, Reflectance = 0.35, CanCollide = false })
	w:SetAttribute("Zone", "lake")
	-- a small island with a reed bed and a token spot
	disc(l, "Island", 46, 2.2, V(L.x + 40, 1.1, L.z - 30), PAL.sand, E.Enum.Material.Sand)
	broadleaf(l, V(L.x + 40, 2.2, L.z - 30), 1.2)
	for _ = 1, 50 do
		local a = rr(0, math.pi * 2)
		local d = L.r + rr(-6, 14)
		deco(l, "Reed", V(0.4, rr(3, 6), 0.4), at(V(L.x + math.cos(a) * d, 2, L.z + math.sin(a) * d)) * E.CFrame.Angles(rr(-0.2, 0.2), 0, rr(-0.2, 0.2)), "#6E8A3A", E.Enum.Material.Grass, false)
	end
end

local function buildWood(root, cfg)
	local w = folder(root, "Whisperwood")
	local n = 0
	local tries = 0
	while n < 300 and tries < 3000 do
		tries += 1
		local x, z = rr(-1180, -320), rr(-700, 1180)
		if MapBuilder.biomeAt(x, z, cfg) == "wood" then
			pine(w, V(x, 0, z), rr(1.3, 2.3))
			n += 1
		end
	end
	for _ = 1, 40 do
		rock(w, V(rr(-1150, -350), 0, rr(-680, 1150)), rr(0.6, 1.2), "#4E5650")
	end
end

local function buildRidge(root, _cfg)
	local r = folder(root, "AshenRidge")
	for _ = 1, 46 do
		local x = rr(-1150, 1150)
		local z = rr(-1180, -760)
		local h = rr(30, 150) * (1 + math.max(0, (-z - 900) / 400))
		local w = rr(60, 150)
		local p = part(r, "Cliff", V(w, h, rr(50, 120)), at(V(x, h / 2 - 4, z)) * yaw(rr(0, 6.28)) * E.CFrame.Angles(rr(-0.08, 0.08), 0, rr(-0.08, 0.08)), pick(PAL.ridge), E.Enum.Material.Slate)
		if rnd() < 0.4 then
			part(r, "Ledge", V(w * 0.6, 6, 30), p.CFrame * E.CFrame.new(0, -h / 4, 40), "#5A5C63", E.Enum.Material.Slate)
		end
	end
	for _ = 1, 40 do
		rock(r, V(rr(-1150, 1150), 0, rr(-760, -640)), rr(0.8, 1.8))
	end
end

local function buildRuins(root, cfg)
	local f = folder(root, "OldGlassford")
	local R = cfg.Map.RUINS
	for b = 1, 7 do
		local a = b / 7 * math.pi * 2
		local cx, cz = R.x + math.cos(a) * R.r * 0.55, R.z + math.sin(a) * R.r * 0.55
		local L, W, H = rr(50, 80), rr(26, 36), rr(16, 24)
		local cf = at(V(cx, 0, cz)) * yaw(rr(0, 3.14))
		local m = model(f, "Greenhouse")
		part(m, "Floor", V(L, 1, W), cf * E.CFrame.new(0, 0.5, 0), "#8F8778", E.Enum.Material.Cobblestone)
		local posts = math.floor(L / 10)
		for i = 0, posts do
			for _, side in { -1, 1 } do
				local broken = rnd() < 0.25
				local hh = broken and H * rr(0.3, 0.7) or H
				part(m, "Post", V(1, hh, 1), cf * E.CFrame.new(-L / 2 + i * L / posts, hh / 2, side * W / 2), "#3A3F44", E.Enum.Material.Metal)
				if not broken and i < posts and rnd() < 0.6 then
					part(m, "Pane", V(L / posts - 1, H - 2, 0.3), cf * E.CFrame.new(-L / 2 + (i + 0.5) * L / posts, H / 2, side * W / 2), "#9FD8C8", E.Enum.Material.Glass, { Transparency = 0.55 })
				end
			end
		end
		if rnd() < 0.6 then
			part(m, "Roof", V(L, 0.6, W), cf * E.CFrame.new(0, H, 0), "#3A3F44", E.Enum.Material.Metal, { Transparency = 0 })
		end
		for _ = 1, 4 do
			deco(m, "Planter", V(rr(4, 8), 2, 3), cf * E.CFrame.new(rr(-L / 3, L / 3), 2, rr(-W / 3, W / 3)), "#6B4A33", E.Enum.Material.Wood, false)
		end
	end
end

local function buildScatter(root, cfg)
	local f = folder(root, "Field")
	for _ = 1, 170 do
		local x, z = rr(-1150, 1150), rr(-700, 1150)
		local b = MapBuilder.biomeAt(x, z, cfg)
		if b == "field" or b == "ruins" then
			if rnd() < 0.7 then
				broadleaf(f, V(x, 0, z), rr(1, 1.8))
			else
				rock(f, V(x, 0, z), rr(0.6, 1.4))
			end
		end
	end
	-- field crates (avoid the lake)
	local crates = folder(root, "FieldCrates")
	local n, tries = 0, 0
	while n < cfg.FIELD_CRATES and tries < 2000 do
		tries += 1
		local x, z = rr(-1120, 1120), rr(-1120, 1120)
		local b = MapBuilder.biomeAt(x, z, cfg)
		if b ~= "lake" and b ~= "hub" and b ~= "meadow" and math.sqrt(x * x + z * z) > 160 then
			n += 1
			crate(crates, "FieldCrate" .. n, V(x, 0, z), "field", rr(0, 6.28))
		end
	end
end

local function buildTokens(root, cfg, content)
	local f = folder(root, "TokenSpots")
	local M = cfg.Map
	local centers = {
		hub = { x = 0, z = 0, r = 30 },
		meadow = M.MEADOW,
		lake = { x = M.LAKE.x, z = M.LAKE.z, r = M.LAKE.r + 20 },
		wood = M.WOOD,
		ridge = { x = M.RIDGE.x, z = M.RIDGE.z, r = 300 },
		ruins = M.RUINS,
		field = { x = 300, z = 300, r = 300 },
	}
	for i, t in ipairs(content.TOKENS) do
		local c = centers[t.zone]
		local a = i * 2.39996
		local d = c.r * (t.zone == "lake" and 1 or rr(0.25, 0.8))
		local p = mark(f, "TokenSpot" .. i, at(V(c.x + math.cos(a) * d, 3, c.z + math.sin(a) * d)))
		p:SetAttribute("TokenIndex", i)
	end
end

local function buildVeil(root, cfg)
	local f = folder(root, "Veil")
	local n = 72
	local r = cfg.Map.ARENA_SIZE / 2
	local w = 2 * math.pi * r / n * 1.04
	for i = 1, n do
		local a = (i - 0.5) / n * math.pi * 2
		local pos = V(math.cos(a) * r, 300, math.sin(a) * r)
		local p = part(f, "Panel" .. i, V(w, 640, 1), lookAt(pos, V(0, 300, 0)), PAL.veil, E.Enum.Material.ForceField, { CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Transparency = 0.1 })
		p:SetAttribute("Angle", a)
	end
end

local function buildGallery(root, cfg, names)
	local g = folder(root, "ViewingGallery")
	local c = V(cfg.Map.GALLERY_CENTER[1], cfg.Map.GALLERY_CENTER[2], cfg.Map.GALLERY_CENTER[3])
	disc(g, "Deck", 150, 2, c, PAL.soot, E.Enum.Material.Marble)
	disc(g, "Rim", 156, 1.6, c + V(0, 0.4, 0), PAL.gold, E.Enum.Material.Foil, { CanCollide = false })
	disc(g, "Window", 70, 2.2, c + V(0, 0.1, 0), "#BFEFFF", E.Enum.Material.Glass, { Transparency = 0.6 })
	disc(g, "WindowRing", 74, 2.1, c + V(0, 0.05, 0), PAL.goldHi, E.Enum.Material.Neon, { CanCollide = false })
	local n = 36
	for i = 1, n do
		local a = i / n * math.pi * 2
		local rp = V(math.cos(a) * 74, 0, math.sin(a) * 74)
		part(g, "Rail", V(13, 5, 0.4), lookAt(c + rp + V(0, 3.5, 0), c + V(0, 3.5, 0)), "#D8F6FF", E.Enum.Material.Glass, { Transparency = 0.5 })
		if i % 2 == 0 then
			local sp = V(math.cos(a) * 52, 0, math.sin(a) * 52)
			local seatCf = lookAt(c + sp + V(0, 2, 0), c + V(0, 2, 0))
			local seatColor = i % 6 == 0 and PAL.gold or "#7A2E3A"
			part(g, "Seat", V(4, 1.2, 4), seatCf, seatColor, E.Enum.Material.Fabric)
			part(g, "Back", V(4, 4, 0.8), seatCf * E.CFrame.new(0, 2, 2), seatColor, E.Enum.Material.Fabric)
		end
	end
	-- halo roof
	for i = 1, 24 do
		local a = i / 24 * math.pi * 2
		local p = V(math.cos(a) * 70, 22, math.sin(a) * 70)
		part(g, "Halo", V(19, 1.5, 3), lookAt(c + p, c + V(0, 22, 0)), PAL.goldHi, E.Enum.Material.Neon, { CanCollide = false })
		if i % 4 == 0 then
			part(g, "Pillar", V(1.5, 22, 1.5), at(c + V(math.cos(a) * 72, 11, math.sin(a) * 72)), PAL.marble, E.Enum.Material.Marble)
		end
	end
	local board = part(g, "GiftBoard", V(30, 12, 1), lookAt(c + V(0, 14, -60), c + V(0, 14, 0)), PAL.soot, E.Enum.Material.SmoothPlastic)
	surfaceText(board, E.Enum.NormalId.Front, names.GALLERY:gsub("^the ", "The ") .. "\nSend gifts · Vote hazards · Encore", "#F4EFE6", "#23283A")
	local sp = E.Instance.new("SpawnLocation")
	sp.Name = "GallerySpawn"
	sp.Anchored = true
	sp.Enabled = false
	sp.Size = V(8, 1, 8)
	sp.CFrame = at(c + V(0, 1.6, 50))
	sp.Transparency = 1
	sp.CanCollide = false
	sp.Neutral = true
	sp.Parent = g
end

-- ===================== lobby: the Reach square and the Harvesting stage =====================
local function buildLobby(root, cfg, names, _content)
	local L = V(cfg.Map.LOBBY_CENTER[1], cfg.Map.LOBBY_CENTER[2], cfg.Map.LOBBY_CENTER[3])
	local lb = folder(root, "Lobby")
	local function P(x, y, z)
		return L + V(x, y, z)
	end
	part(lb, "Plaza", V(360, 4, 360), at(P(0, -2, 0)), "#5B5A5C", E.Enum.Material.Cobblestone)
	part(lb, "Aisle", V(10, 4.05, 120), at(P(0, -2, -10)), "#7A7066", E.Enum.Material.Brick)
	-- Reach buildings around the square (soot and slate, warm windows)
	for side = 1, 4 do
		for k = -3, 3 do
			local w, h = rr(30, 44), rr(34, 70)
			local off = k * 46
			local pos, rot
			if side == 1 then
				pos, rot = P(off, h / 2, -200), 0
			elseif side == 2 then
				pos, rot = P(off, h / 2, 200), math.pi
			elseif side == 3 then
				pos, rot = P(-200, h / 2, off), math.pi / 2
			else
				pos, rot = P(200, h / 2, off), -math.pi / 2
			end
			if not (side == 2 and math.abs(k) <= 1) then
				local cf = at(pos) * yaw(rot)
				local b = part(lb, "Building", V(w, h, 30), cf, pick(PAL.brick), E.Enum.Material.Brick)
				part(lb, "Roof", V(w + 2, 3, 32), cf * E.CFrame.new(0, h / 2 + 1.5, 0), PAL.soot, E.Enum.Material.Slate)
				for wy = 1, math.floor(h / 12) do
					for wx = -1, 1 do
						if rnd() < 0.75 then
							deco(lb, "Window", V(4, 5, 0.4), b.CFrame * E.CFrame.new(wx * w / 3.2, -h / 2 + wy * 11, 15.1), rnd() < 0.6 and PAL.window or "#3A3F4A", rnd() < 0.6 and E.Enum.Material.Neon or E.Enum.Material.Glass, false)
						end
					end
				end
				if rnd() < 0.5 then
					deco(lb, "Banner", V(8, 18, 0.4), b.CFrame * E.CFrame.new(0, h / 2 - 12, 15.4), PAL.gold, E.Enum.Material.Fabric, false)
				end
			end
		end
	end
	-- the stage (faces +Z toward the crowd)
	local st = folder(lb, "Stage")
	part(st, "Platform", V(76, 6, 30), at(P(0, 3, -88)), PAL.marble, E.Enum.Material.Marble)
	part(st, "Trim", V(77, 1.2, 30.5), at(P(0, 5.6, -88)), PAL.gold, E.Enum.Material.Foil)
	for i = 1, 3 do
		part(st, "Step" .. i, V(14, 2 * i, 4), at(P(0, i, -73 + -(i - 1) * 4 + 8)), PAL.marble, E.Enum.Material.Marble)
	end
	local _back = part(st, "Backdrop", V(100, 44, 4), at(P(0, 22, -106)), PAL.marble, E.Enum.Material.Marble)
	for i = -2, 2 do
		part(st, "Pillar", V(5, 46, 5), at(P(i * 24, 23, -102)), "#D9D2C4", E.Enum.Material.Marble)
	end
	-- the Halcyon sun emblem (original): a gold disc and twelve rays
	disc(st, "Sun", 16, 1, P(0, 30, -103.6), PAL.gold, E.Enum.Material.Foil, { CanCollide = false }).CFrame = at(P(0, 30, -103.6)) * E.CFrame.Angles(0, math.pi / 2, 0)
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		part(st, "Ray", V(1.4, 8, 0.6), at(P(math.cos(a) * 12, 30 + math.sin(a) * 12, -103.6)) * E.CFrame.Angles(0, 0, a - math.pi / 2), PAL.goldHi, E.Enum.Material.Neon, { CanCollide = false })
	end
	local jumbo = part(st, "Jumbotron", V(46, 24, 2), at(P(0, 62, -104)), "#14161C", E.Enum.Material.SmoothPlastic)
	surfaceText(jumbo, E.Enum.NormalId.Back, names.TITLE:upper() .. "\n" .. names.EVENT:gsub("^the ", "The ") .. " · Jubilee Year", "#FFE9A8", "#14161C")
	part(st, "JumboFrame", V(48, 26, 1.6), at(P(0, 62, -104.6)), PAL.gold, E.Enum.Material.Foil)
	local flash = part(st, "Flashback", V(18, 11, 1), at(P(42, 40, -103.4)), "#23283A", E.Enum.Material.SmoothPlastic)
	surfaceText(flash, E.Enum.NormalId.Back, "25 years ago...\n" .. names.MENTOR_SHORT .. ", age 16", "#F4EFE6", "#23283A")
	-- glass globe of names
	cyl(st, "GlobeStand", 6, 3, at(P(-14, 9, -88)) * E.CFrame.Angles(0, 0, math.pi / 2), PAL.gold, E.Enum.Material.Foil)
	local globe = part(st, "Globe", V(8, 8, 8), at(P(-14, 16, -88)), "#DDF4FF", E.Enum.Material.Glass, { Transparency = 0.55, Shape = E.Enum.PartType.Ball })
	for _ = 1, 26 do
		deco(st, "Slip", V(0.9, 0.08, 0.5), at(P(-14 + rr(-2.2, 2.2), 14 + rr(-1.5, 2.2), -88 + rr(-2.2, 2.2))) * E.CFrame.Angles(rr(0, 3), rr(0, 3), rr(0, 3)), "#FFF8E7", E.Enum.Material.SmoothPlastic, false)
	end
	globe:SetAttribute("Globe", true)
	-- mic stand
	cyl(st, "Mic", 6, 0.3, at(P(4, 9, -80)) * E.CFrame.Angles(0, 0, math.pi / 2), "#2A2A2A", E.Enum.Material.Metal)
	dball(st, "MicHead", 0.7, at(P(4, 12.2, -80)), "#2A2A2A", E.Enum.Material.Metal, false)
	-- the Herald (faces the crowd)
	local herald = MapBuilder.npc(st, "Herald", at(P(8, 6, -84)) * yaw(math.pi), {
		skin = "#F1C9A5",
		shirt = "#F2CF63",
		pants = "#E9E4DA",
		shoes = "#D4A72C",
		hair = "#FF8A3D",
		hat = "bun",
		hatColor = "#FF8A3D",
		pearls = true,
		label = names.HERALD,
		labelColor = "#FFE9A8",
	})
	herald:SetAttribute("Role", "Herald")
	-- Rusty waits beside the crowd, then walks up to the stage during the reaping
	local rusty = MapBuilder.rusty(nil, lb, at(P(-44, 0, -30)) * yaw(-math.pi / 2), names.MENTOR)
	rusty:SetAttribute("Role", "Mentor")
	-- crowd pens and townsfolk
	local crowd = folder(lb, "Crowd")
	for row = 0, 5 do
		for _, side in { -1, 1 } do
			part(crowd, "Rope", V(40, 0.4, 0.4), at(P(side * 26, 3, -50 + row * 14)), "#B3262E", E.Enum.Material.Fabric, { CanCollide = false })
			for _, px in { 6, 46 } do
				cyl(crowd, "Post", 3.5, 0.6, at(P(side * px, 1.75, -50 + row * 14)) * E.CFrame.Angles(0, 0, math.pi / 2), PAL.gold, E.Enum.Material.Metal)
			end
		end
	end
	local outfits = { { PAL.slate, "#3A3A40", "#E0AC69", "#3B2A1A" }, { "#5C5A52", "#2B2D33", "#C68642", "#1E1A18" }, { "#6B5B4B", "#3A3A40", "#F1C9A5", "#8A6A3A" }, { "#4A505C", "#5C5A52", "#8D5524", "#111111" }, { "#7A6A55", "#2B2D33", "#F1C9A5", "#B89A5E" } }
	for row = 0, 5 do
		for _, side in { -1, 1 } do
			for k = 0, 6 do
				local x = side * (10 + k * 5.4 + rr(-0.8, 0.8))
				townsperson(crowd, at(P(x, 0, -45 + row * 14 + rr(-2, 2))) * yaw(math.pi + rr(-0.3, 0.3)), pick(outfits))
			end
		end
	end
	-- cutscene marks (invisible). Each Cam* part's CFrame is a camera pose.
	local marks = folder(lb, "CutsceneMarks")
	local function cam(name, pos, look)
		mark(marks, name, lookAt(P(pos[1], pos[2], pos[3]), P(look[1], look[2], look[3])))
	end
	cam("CamWide", { 0, 46, 70 }, { 0, 18, -80 })
	cam("CamGlobe", { -6, 18, -70 }, { -14, 16, -88 })
	cam("CamHerald", { 14, 14, -66 }, { 8, 11, -84 })
	cam("CamCrowd", { 0, 9, -62 }, { 0, 5, 0 })
	cam("CamPlayer", { 6, 7, -18 }, { 0, 5, -8 })
	cam("CamRusty", { -30, 9, -44 }, { -44, 5, -30 })
	cam("CamStage", { 0, 16, -46 }, { -2, 9, -84 })
	cam("CamPull", { 0, 70, 120 }, { 0, 20, -80 })
	mark(marks, "CrowdMark", at(P(0, 3, -6)))
	mark(marks, "AisleMark", at(P(0, 3, -62)))
	mark(marks, "StageMark", at(P(-2, 9, -82)))
	mark(marks, "RustyStart", at(P(-44, 3, -30)))
	mark(marks, "RustyMark", at(P(-8, 9, -84)))
	mark(marks, "PartnerMark", at(P(3, 9, -82)))
	-- queue: the Draw Gate (walk in or press Play in the menu)
	local q = folder(lb, "DrawGate")
	part(q, "PillarL", V(5, 34, 5), at(P(-18, 17, 120)), PAL.marble, E.Enum.Material.Marble)
	part(q, "PillarR", V(5, 34, 5), at(P(18, 17, 120)), PAL.marble, E.Enum.Material.Marble)
	local lintel = part(q, "Lintel", V(44, 6, 6), at(P(0, 36, 120)), PAL.gold, E.Enum.Material.Foil)
	surfaceText(lintel, E.Enum.NormalId.Back, "THE DRAW GATE", "#1C1F2B", nil)
	local pad = disc(q, "QueuePad", 30, 0.8, P(0, 0.4, 120), PAL.veil, E.Enum.Material.Neon)
	prompt(pad, "queue", "Join the Draw", names.EVENT_SHORT, 0, 18)
	-- boards
	local function board(name, pos, rot, text)
		local b = part(lb, name, V(30, 18, 1.5), at(P(pos[1], pos[2], pos[3])) * yaw(rot), "#23283A", E.Enum.Material.SmoothPlastic)
		part(lb, name .. "Frame", V(31.5, 19.5, 1.2), b.CFrame * E.CFrame.new(0, 0, 0.3), PAL.gold, E.Enum.Material.Foil)
		surfaceText(b, E.Enum.NormalId.Back, text, "#F4EFE6", "#23283A")
		prompt(b, name:lower(), "Open", name, 0, 16)
		return b
	end
	board("SeasonBoard", { 70, 12, 110 }, 0, names.TRACK .. "\nSeason 1: First Light")
	board("ChallengeBoard", { -70, 12, 110 }, 0, "Daily & Weekly\nChallenges")
	board("ReachBoard", { 140, 12, 30 }, math.pi / 2, names.REGION .. " Standings\nThis week")
	-- training range (pregame score is cosmetic)
	local tr = folder(lb, "TrainingRange")
	for k = 1, 5 do
		local t = disc(tr, "Target" .. k, 5, 0.6, P(-150, 6, -40 + k * 14), "#F4EFE6", E.Enum.Material.SmoothPlastic)
		t.CFrame = at(P(-150, 6, -40 + k * 14)) * E.CFrame.Angles(0, 0, 0)
		disc(tr, "Bull" .. k, 2, 0.7, P(-149.9, 6, -40 + k * 14), "#B3262E", E.Enum.Material.SmoothPlastic, { CanCollide = false }).CFrame = at(P(-149.6, 6, -40 + k * 14))
		part(tr, "TargetPost" .. k, V(0.6, 4, 0.6), at(P(-150, 2, -40 + k * 14)), "#4A3426", E.Enum.Material.Wood)
	end
	local trPad = disc(tr, "RangePad", 16, 0.6, P(-110, 0.3, 0), PAL.gold, E.Enum.Material.Foil)
	prompt(trPad, "training", "Train", "Target Range", 0, 12)
	-- lamps
	for k = 1, 12 do
		local a = k / 12 * math.pi * 2
		local pos = P(math.cos(a) * 150, 0, math.sin(a) * 150)
		part(lb, "LampPost", V(1, 16, 1), at(pos + V(0, 8, 0)), PAL.soot, E.Enum.Material.Metal)
		local bulb = part(lb, "Lamp", V(2.4, 2.4, 2.4), at(pos + V(0, 17, 0)), PAL.window, E.Enum.Material.Neon, { CanCollide = false })
		local pl = E.Instance.new("PointLight")
		pl.Color = E.Color3.fromHex("#FFC870")
		pl.Range = 30
		pl.Brightness = 1.4
		pl.Parent = bulb
	end
	local spawn = E.Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = V(16, 1, 16)
	spawn.CFrame = at(P(0, 0.5, 80))
	spawn.Color = E.Color3.fromHex(PAL.gold)
	spawn.Material = E.Enum.Material.Foil
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = lb
	return lb
end

-- ===================== templates the server clones =====================
local function buildTemplates(root)
	local t = folder(root, "Templates")
	-- Candyfinch: a round, sugary pink bird
	local f = model(t, "Candyfinch")
	local body = sph(f, "Body", V(1.6, 1.3, 2), at(V(0, 0, 0)), PAL.finch, E.Enum.Material.SmoothPlastic, { CanCollide = false, Anchored = true })
	sph(f, "Head", V(1.1, 1.1, 1.1), at(V(0, 0.5, -0.9)), "#FFB3E6", E.Enum.Material.SmoothPlastic, { CanCollide = false })
	part(f, "Beak", V(0.3, 0.3, 0.5), at(V(0, 0.45, -1.5)), PAL.goldHi, E.Enum.Material.SmoothPlastic, { CanCollide = false })
	for _, s in { -1, 1 } do
		sph(f, "Wing", V(1.6, 0.25, 1.2), at(V(s * 1, 0.2, 0)) * E.CFrame.Angles(0, 0, s * 0.3), "#FF5CC8", E.Enum.Material.SmoothPlastic, { CanCollide = false })
		dball(f, "Eye", 0.2, at(V(s * 0.3, 0.65, -1.35)), "#1C1F2B", E.Enum.Material.SmoothPlastic, false)
	end
	f.PrimaryPart = body
	-- Parachute gift
	local pc = model(t, "Parachute")
	local box = part(pc, "Box", V(3, 3, 3), at(V(0, 0, 0)), "#8A6A3A", E.Enum.Material.Wood, { CanCollide = false })
	sph(pc, "Canopy", V(12, 5, 12), at(V(0, 9, 0)), "#F4EFE6", E.Enum.Material.Fabric, { CanCollide = false })
	sph(pc, "Stripe", V(12.1, 2, 12.1), at(V(0, 9.2, 0)), PAL.gold, E.Enum.Material.Fabric, { CanCollide = false })
	for _, o in { { -4, -4 }, { 4, -4 }, { -4, 4 }, { 4, 4 } } do
		part(pc, "String", V(0.1, 8, 0.1), lookAt(V(o[1] / 2, 4.5, o[2] / 2), V(o[1], 9, o[2])) * E.CFrame.Angles(math.pi / 2, 0, 0), "#FFFFFF", E.Enum.Material.SmoothPlastic, { CanCollide = false })
	end
	pc.PrimaryPart = box
	-- Jubilee token
	local tk = model(t, "Token")
	local coin = cyl(tk, "Coin", 0.4, 2.6, at(V(0, 0, 0)), PAL.goldHi, E.Enum.Material.Neon, { CanCollide = false })
	tk.PrimaryPart = coin
	return t
end

-- Build everything under workspace.Map and return it.
function MapBuilder.build(env, ws, cfg, names, content)
	E = env
	MapBuilder.setEnv(env)
	seed = 20261102
	local map = model(ws, "Map")
	local arena = folder(map, "Arena")
	buildGround(arena, cfg)
	buildHub(arena, cfg, names)
	buildMeadow(arena, cfg)
	buildLake(arena, cfg)
	buildWood(arena, cfg)
	buildRidge(arena, cfg)
	buildRuins(arena, cfg)
	buildScatter(arena, cfg)
	buildTokens(arena, cfg, content)
	buildVeil(arena, cfg)
	buildGallery(map, cfg, names)
	buildLobby(map, cfg, names, content)
	buildTemplates(map)
	return map
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">Monetization</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Monetization.luau — THE ONE PLACE FOR ROBUX IDS. Every ID ships as 0.

	HOW TO FILL THIS IN (see PUBLISHING.md for click-by-click steps):
	  1. Publish the game once (File > Publish to Roblox).
	  2. https://create.roblox.com/dashboard/creations > the game > Monetization > Passes:
	     "Create a Pass" for every entry in `Passes`. Paste its ID over the 0.
	  3. Monetization > Developer Products: create every entry in `Products`, paste IDs.
	  4. Save, rebuild, publish again.

	Anything left at 0 is hidden in the live game. In Studio play-testing, 0-ID items show a
	"Studio test" button that grants them free so you can try everything.

	Fair-play rules (Roblox monetization policy + "promoting to younger audiences" guidance):
	  * No paid random items. Nothing sold has a chance roll. Crates in the arena are free.
	  * Calm shop copy: "See item", "Buy for R$ X". No countdowns, no "LAST CHANCE", no FOMO.
	  * No paid combat power. Starter Satchel and Trail Boots only work in casual Jubilees and
	    can be earned free from the Season Track; ranked (future) ignores them.
	  * The Premium lane of the Season Track never sells tiers or Stars; you earn tiers by playing.
	  * Robux never buys Favor; spectator gifts are earned by watching.
	  * Renown Boost gives everyone else in the server a free 5-minute Renown Shower.
]]

export type Pass = { id: number, name: string, price: number, desc: string, icon: string }
export type Product = {
	id: number,
	name: string,
	price: number,
	desc: string,
	icon: string,
	kind: string, -- "boost" | "cosmetic"
	category: string,
	minutes: number?,
	grants: { string }?,
}

local Monetization = {}

Monetization.Passes = {
	PremiumLane = { id = 0, name = "Season Track Premium Lane", price = 399, icon = "🌅", desc = "Unlocks the premium cosmetic lane for this season. Every reward is shown before you buy. No tiers or Stars for sale." },
	GalleryBox = { id = 0, name = "Gallery Box Seat", price = 149, icon = "🎟️", desc = "A cushioned box seat in the Viewing Gallery and a gold name in the gift feed. Cosmetic." },
	BigSponsor = { id = 0, name = "Big Sponsor", price = 249, icon = "🪂", desc = "Earn Favor twice as fast while spectating. Favor is never sold." },
	StarterSatchel = { id = 0, name = "Starter Satchel", price = 199, icon = "🎒", desc = "Start casual Jubilees with an apple and a canteen. Also free at Season Track tier 12." },
	TrailBoots = { id = 0, name = "Trail Boots", price = 299, icon = "🥾", desc = "+5% stamina regen in casual Jubilees and a dusty footprint trail. Free at tier 24." },
	TrainingRetry = { id = 0, name = "Extra Training Try", price = 99, icon = "🎯", desc = "One extra try at the pregame target range score each match. Cosmetic score only." },
} :: { [string]: Pass }

Monetization.Products = {
	RenownBoost = { id = 0, name = "Renown Boost", price = 49, icon = "✨", kind = "boost", category = "Boosts", minutes = 30, desc = "+50% Renown for 30 minutes. Everyone else in the server gets a free 5-minute Renown Shower." },
	FadeEmber = { id = 0, name = "Ember Knockout Fade", price = 75, icon = "🔥", kind = "cosmetic", category = "Fades", grants = { "fade_ember" }, desc = "Your knockouts dissolve into warm ember light. Cosmetic." },
	FadeVeil = { id = 0, name = "Veil Shimmer Fade", price = 75, icon = "💠", kind = "cosmetic", category = "Fades", grants = { "fade_veil" }, desc = "Your knockouts dissolve into cyan shimmer. Cosmetic." },
	ParadeSunrise = { id = 0, name = "Sunrise Parade Coat", price = 120, icon = "🧥", kind = "cosmetic", category = "Parade", grants = { "parade_sunrise" }, desc = "A glowing coat for the Spire parade. Cosmetic." },
	ParadeEmber = { id = 0, name = "Ember Parade Cape", price = 120, icon = "🧣", kind = "cosmetic", category = "Parade", grants = { "parade_ember" }, desc = "A cape that trails sparks on the parade chariot. Cosmetic." },
	BowGilded = { id = 0, name = "Gilded Bow Skin", price = 90, icon = "🏹", kind = "cosmetic", category = "Skins", grants = { "skin_bow_gilded" }, desc = "Same stats, new look. Cosmetic." },
	SpearAshen = { id = 0, name = "Ashen Spear Skin", price = 90, icon = "🔱", kind = "cosmetic", category = "Skins", grants = { "skin_spear_ashen" }, desc = "Same stats, new look. Cosmetic." },
	PackLantern = { id = 0, name = "Lantern Backpack Skin", price = 80, icon = "🏮", kind = "cosmetic", category = "Skins", grants = { "skin_pack_lantern" }, desc = "Same slots, new look. Cosmetic." },
} :: { [string]: Product }

-- True when nothing in this module is a random/gacha item (checked by tests).
function Monetization.noRandomItems(): boolean
	for _, p in pairs(Monetization.Products) do
		if p.kind ~= "boost" and p.kind ~= "cosmetic" then
			return false
		end
	end
	return true
end

return Monetization
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">Names</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Names.luau — THE NAME-SWAP KIT.

	Every player-facing proper noun in the game comes from this one module: the title, the
	nation, the regions, the hub, the force field, every NPC, the currencies and the badge
	names. To rename the game (for example after a trademark complaint), change the strings
	here, rebuild, and republish. No other file needs to change. The tests check that no other
	source file hard-codes the title.

	Rules for anything you put here (see README "IP guardrails"):
	  * No book or film names, places, characters, symbols or quotes from any franchise.
	  * Keep the game's own world: Halcyon, the Spire, the Reaches, the Sundial, the Veil.
]]
local Names = {}

Names.TITLE = "Daybreak on the Harvesting"
Names.SHORT_TITLE = "Daybreak"
Names.TAGLINE = "48 contenders. 24 Reaches. One champion at daybreak."

-- World
Names.NATION = "Halcyon"
Names.CAPITAL = "the Spire"
Names.REGION = "Reach"
Names.REGIONS = "Reaches"
Names.EVENT = "the Jubilee Trials"
Names.EVENT_SHORT = "Jubilee"
Names.DRAW = "the Harvesting"
Names.CONTENDER = "Contender"
Names.CONTENDERS = "Contenders"
Names.CHAMPION = "Champion"
Names.HUB = "the Sundial"
Names.VEIL = "the Veil"
Names.GALLERY = "the Viewing Gallery"
Names.SHOWRUNNERS = "the Showrunners"

-- People (all original characters)
Names.MENTOR = "Rusty Dunmore"
Names.MENTOR_SHORT = "Rusty"
Names.HERALD = "Herald Marigold Vane"
Names.HOST = "Monty Gleam"
Names.PUP = "Bubbles"
Names.BOT_TAG = "Stand-In"

-- Currencies and progression
Names.XP = "Renown"
Names.FAVOR = "Favor"
Names.STARS = "Daybreak Stars"
Names.TRACK = "Season Track"
Names.TOKENS = "Jubilee Tokens"

-- Hazards and places in the arena
Names.FINCHES = "Candyfinches"
Names.MEADOW = "the Gilded Meadow"
Names.BLOOM = "Meadow Bloom"
Names.LAKE = "Mirror Lake"
Names.WOOD = "Whisperwood"
Names.RIDGE = "Ashen Ridge"
Names.RUINS = "Old Glassford"

-- The 24 Reaches. Each sends two contenders in a Jubilee year (24 x 2 = 48).
Names.REACH_LIST = {
	"Cinderhollow", "Saltmere", "Timberwick", "Glassford", "Orchard Vale", "Loomstead",
	"Ironbend", "Windmere", "Quarrytop", "Reedmarsh", "Copperfield", "Hearthstone",
	"Millbrook", "Lanternfall", "Stonecross", "Wheatlow", "Brinecliff", "Ashgrove",
	"Kilnside", "Tidewater", "Foxhollow", "Silverrun", "Thistledown", "Bellhaven",
} :: { string }

-- Prestige ranks (index 0 = no prestige yet)
Names.RANKS = { [0] = "Reaped", [1] = "Contender", [2] = "Favorite", [3] = "Champion", [4] = "Legend" } :: { [number]: string }

function Names.rank(prestige: number): string
	local p = math.clamp(math.floor(prestige), 0, 4)
	return Names.RANKS[p]
end

function Names.reachIndex(name: string): number?
	for i, n in ipairs(Names.REACH_LIST) do
		if n == name then
			return i
		end
	end
	return nil
end

return Names
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">SfxIds</string>
          <string name="Source"><![CDATA[--!strict
-- Sound effects. Every id is a sound from Roblox's own licensed library (ProSoundEffects or the
-- Roblox account), so the game needs no uploaded audio. Swap a sound by changing one number.
-- `stop` cuts long files short (seconds). `volume` is relative to the SFX group.
return {
	click = { id = 15675059323, volume = 0.35 }, -- Roblox_UI_Bright_Click (buttons)
	pop = { id = 15675055424, volume = 0.5 }, -- Roblox_UI_Cute_Pop (pickups)
	popAiry = { id = 9117841338, volume = 0.5 }, -- Pop Airy 1 (parachute lands)
	register = { id = 9113728756, volume = 0.45 }, -- Cash Register 5 (purchase thanks)
	coins = { id = 9113849492, volume = 0.5 }, -- Coins Or Keys Jingle 6 (token found)
	ding = { id = 9126073001, volume = 0.45 }, -- Synth Sparkle Tone Ding (challenge done)
	bell = { id = 9113584163, volume = 0.6, stop = 2.6 }, -- Brass Hand Bell 1 (knockout / Harvesting)
	fanfare = { id = 9114898444, volume = 0.55 }, -- Kazoo Fanfare 3 (win)
	crunch = { id = 9113959343, volume = 0.7 }, -- Crack Egg Crunchy 11 (snack)
	swat = { id = 9120907511, volume = 0.6 }, -- Wood Impact 5 (melee hit)
	whoosh = { id = 9125594711, volume = 0.4 }, -- Metal Spatula Impact (bow release stand-in)
	hiss = { id = 9119165436, volume = 0.45 }, -- Sizzle Sear (Veil touch)
} :: { [string]: { id: number, volume: number?, stop: number?, loop: boolean? } }
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="34">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="35">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="36">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Server entry point: builds the map (if it wasn't baked), remotes, wires services, starts them.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Names = require(Shared.Names)
local Content = require(Shared.Content)
local MapBuilder = require(Shared.MapBuilder) :: any
local RateLimiter = require(Shared.Logic.RateLimiter)

local Services = script.Parent:WaitForChild("Services")

if not workspace:FindFirstChild("Map") then
	MapBuilder.build({
		Instance = Instance,
		Vector3 = Vector3,
		CFrame = CFrame,
		Color3 = Color3,
		Enum = Enum,
		UDim2 = UDim2,
		NumberSequence = NumberSequence,
		NumberRange = NumberRange,
		ColorSequence = ColorSequence,
		Vector2 = Vector2,
	}, workspace, Config, Names, Content)
end

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local action = Instance.new("RemoteFunction")
action.Name = "Action"
action.Parent = remotes
local push = Instance.new("RemoteEvent")
push.Name = "Push"
push.Parent = remotes
remotes.Parent = ReplicatedStorage

Players.CharacterAutoLoads = true

local ctx: any = {
	Data = require(Services.DataService),
	Progress = require(Services.ProgressService),
	Match = require(Services.MatchService),
	Bots = require(Services.BotService),
	Gallery = require(Services.GalleryService),
	Purchase = require(Services.PurchaseService),
	Remotes = { Action = action, Push = push },
}

function ctx.push(player: Player, kind: string, payload: any)
	push:FireClient(player, kind, payload)
end
function ctx.pushAll(kind: string, payload: any)
	push:FireAllClients(kind, payload)
end
function ctx.toast(player: Player, text: string, kind: string?)
	push:FireClient(player, "toast", { text = text, kind = kind or "info" })
end

-- One RemoteFunction for every intent, rate-limited per player and per action.
local globalLimiter = RateLimiter.new(30, 15)
local actionLimiter = RateLimiter.new(8, 5)
local handlers: { [string]: (Player, any, any, any) -> (boolean, string?) } = {}
function ctx.handle(name: string, fn: (Player, any, any, any) -> (boolean, string?))
	handlers[name] = fn
end

for _, name in ipairs({ "Progress", "Bots", "Match", "Gallery", "Purchase" }) do
	local svc = ctx[name]
	if svc.init then
		svc.init(ctx)
	end
end

action.OnServerInvoke = function(player: Player, name: any, a: any, b: any, c: any)
	if type(name) ~= "string" then
		return { ok = false }
	end
	local now = os.clock()
	if not RateLimiter.allow(globalLimiter, player, now) or not RateLimiter.allow(actionLimiter, tostring(player.UserId) .. name, now) then
		return { ok = false, msg = "Slow down a little!" }
	end
	local fn = handlers[name]
	if not fn then
		return { ok = false }
	end
	local ok, res, msg = pcall(fn, player, a, b, c)
	if not ok then
		warn("[Action " .. name .. "] " .. tostring(res))
		return { ok = false, msg = "Something went wrong." }
	end
	return { ok = res == true, msg = msg }
end

Players.PlayerRemoving:Connect(function(p)
	RateLimiter.forget(globalLimiter, p)
end)

ctx.Data.start()
for _, name in ipairs({ "Progress", "Bots", "Gallery", "Purchase", "Match" }) do
	local svc = ctx[name]
	if svc.start then
		svc.start()
	end
end
print("[" .. Names.TITLE .. "] server ready · " .. Config.VERSION)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="37">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">BotService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	BotService — Stand-In contenders that fill empty plates so a match always has 48.
	Every bot is labeled "Stand-In · Name (Reach)" so nobody mistakes it for a person.
	A simple 4 Hz brain: grab a crate, eat when low, fight what's close, flee the Veil.
	Bots deal 80% damage and aim with some spread so new players can win.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Veil = require(Shared.Logic.Veil)

local BotService = {}
local ctx: any = nil
local rng = Random.new()
local brains: { [string]: any } = {}
local running = false

local SKIN = { "#F1C9A5", "#E0AC69", "#C68642", "#8D5524", "#5C3A21", "#FFDBAC" }
local SHIRT = { "#4A505C", "#5C5A52", "#6B5B4B", "#2F7F86", "#7A2E3A", "#3E8E5E", "#B8793A", "#2B2D33" }
local PANTS = { "#2B2D33", "#3A3A40", "#5C5A52", "#4A3426" }

local function color(h: string): Color3
	return Color3.fromHex(h)
end

local function simpleRig(name: string): Model
	-- fallback when avatar rigs can't be created (e.g. offline Studio tests)
	local m = Instance.new("Model")
	m.Name = name
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Transparency = 1
	root.Parent = m
	local torso = Instance.new("Part")
	torso.Name = "Torso"
	torso.Size = Vector3.new(2, 2, 1)
	torso.Color = color(SHIRT[rng:NextInteger(1, #SHIRT)])
	torso.CFrame = root.CFrame
	torso.Parent = m
	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1.2, 1.2, 1.2)
	head.Shape = Enum.PartType.Ball
	head.Color = color(SKIN[rng:NextInteger(1, #SKIN)])
	head.CFrame = root.CFrame * CFrame.new(0, 1.6, 0)
	head.Parent = m
	local legs = Instance.new("Part")
	legs.Name = "Legs"
	legs.Size = Vector3.new(1.8, 2, 1)
	legs.Color = color(PANTS[rng:NextInteger(1, #PANTS)])
	legs.CFrame = root.CFrame * CFrame.new(0, -2, 0)
	legs.Parent = m
	for _, p in ipairs({ torso, head, legs }) do
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = p
		w.Parent = p
	end
	local hum = Instance.new("Humanoid")
	hum.HipHeight = 2
	hum.Parent = m
	m.PrimaryPart = root
	return m
end

local function makeRig(name: string): Model
	local ok, model = pcall(function()
		local d = Instance.new("HumanoidDescription")
		local skin = color(SKIN[rng:NextInteger(1, #SKIN)])
		d.HeadColor = skin
		d.LeftArmColor = skin
		d.RightArmColor = skin
		d.TorsoColor = color(SHIRT[rng:NextInteger(1, #SHIRT)])
		local legs = color(PANTS[rng:NextInteger(1, #PANTS)])
		d.LeftLegColor = legs
		d.RightLegColor = legs
		return Players:CreateHumanoidModelFromDescription(d, Enum.HumanoidRigType.R15)
	end)
	if ok and model then
		model.Name = name
		return model
	end
	return simpleRig(name)
end

function BotService.spawn(c: any, cf: CFrame): Model?
	local m = makeRig(c.name)
	local hum = m:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayName = string.format("%s (%s)", c.name, c.reach)
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
		hum.NameDisplayDistance = 60
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		hum.BreakJointsOnDeath = false
		hum.WalkSpeed = 14
		hum.MaxHealth = 1e6
		hum.Health = 1e6
	end
	m:SetAttribute("StandIn", true)
	m:PivotTo(cf)
	local folder = workspace:FindFirstChild("StandIns")
	if not folder then
		local f = Instance.new("Folder")
		f.Name = "StandIns"
		f.Parent = workspace
		folder = f
	end
	m.Parent = folder
	local root = m:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		root.Anchored = true
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	brains[c.id] = {
		next = 0,
		goal = nil,
		crate = nil,
		target = nil,
		react = rng:NextNumber(Config.Bots.reaction[1], Config.Bots.reaction[2]),
		brave = rng:NextNumber() < Config.Bots.hubBrave,
	}
	return m
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function safePoint(radius: number): Vector3
	local a = rng:NextNumber(0, math.pi * 2)
	local r = rng:NextNumber(0, math.max(10, radius * 0.7))
	return Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
end

local function nearestCrate(pos: Vector3, maxD: number): BasePart?
	local best: BasePart? = nil
	local bestD = maxD
	for _, crate in ipairs(ctx.Match.allCrates()) do
		if not crate:GetAttribute("Opened") then
			local d = (crate.Position - pos).Magnitude
			if d < bestD then
				best, bestD = crate, d
			end
		end
	end
	return best
end

local function think(c: any, b: any, _t: number)
	local M = ctx.Match
	local root = M.rootOf(c)
	local hum = c.model and c.model:FindFirstChildOfClass("Humanoid")
	if not root or not hum then
		return
	end
	local pos = root.Position
	hum.WalkSpeed = 14 * ((c.model:GetAttribute("SpeedMult") or 1) :: number)
	-- 1) flee the Veil
	local _, target = Veil.nextShrink(M.t, Config.VeilPhases)
	local safeR = math.min(M.radius, target or M.radius)
	if Veil.outside(pos.X, pos.Z, safeR * 0.92) then
		local inward = -flat(pos)
		if inward.Magnitude > 1 then
			hum:MoveTo(pos + inward.Unit * 60)
		end
		return
	end
	-- 2) eat when low
	if c.pep < 55 then
		for i, item in ipairs(c.inv) do
			local d = Config.Items[item]
			if d and d.kind == "snack" then
				M.eat(c, i)
				return
			end
		end
	end
	-- pick best weapon
	local bestSlot, bestDmg = 0, 0
	for i, item in ipairs(c.inv) do
		local d = Config.Items[item]
		local w = d and d.weapon and Config.Weapons[d.weapon]
		if w and (w.kind ~= "ranged" or c.ammo > 0) and w.damage > bestDmg then
			bestSlot, bestDmg = i, w.damage
		end
	end
	if bestSlot > 0 then
		c.equipped = bestSlot
	end
	-- 3) fight what's close
	local enemy: any = nil
	local enemyD = Config.Bots.sight
	for _, o in pairs(M.contenders) do
		if o ~= c and o.alive and (o.reach ~= c.reach or M.aliveCount() <= Config.ALLIES_UNTIL) then
			local orr = M.rootOf(o)
			if orr then
				local d = (orr.Position - pos).Magnitude
				if d < enemyD then
					enemy, enemyD = o, d
				end
			end
		end
	end
	if enemy and (bestSlot > 0 or enemyD < 10) then
		local er = M.rootOf(enemy)
		if er then
			local item = c.inv[c.equipped]
			local d = item and Config.Items[item]
			local w = d and d.weapon and Config.Weapons[d.weapon] or Config.Weapons.shove
			if w.kind == "ranged" then
				if enemyD > w.range * 0.7 then
					hum:MoveTo(er.Position)
				else
					hum:MoveTo(pos + (pos - er.Position).Unit:Cross(Vector3.yAxis) * 8)
				end
				local spread = Config.Bots.aimSpread * enemyD
				local aim = er.Position + Vector3.new(rng:NextNumber(-spread, spread), rng:NextNumber(-1, 1), rng:NextNumber(-spread, spread))
				root.CFrame = CFrame.lookAt(pos, Vector3.new(er.Position.X, pos.Y, er.Position.Z))
				M.attack(c, w.id, aim)
			else
				hum:MoveTo(er.Position)
				if enemyD <= w.range + 1 then
					M.attack(c, w.id, er.Position)
				end
			end
			return
		end
	end
	-- 4) loot
	if #c.inv < c.slots then
		local crate = b.crate
		if not crate or crate:GetAttribute("Opened") then
			crate = nearestCrate(pos, b.brave and 400 or 220)
			b.crate = crate
		end
		if crate then
			if (crate.Position - pos).Magnitude < 9 then
				M.openCrate(c, crate)
				b.crate = nil
			else
				hum:MoveTo(crate.Position)
			end
			return
		end
	end
	-- 5) wander inside the safe zone
	if not b.goal or (flat(b.goal) - flat(pos)).Magnitude < 12 or Veil.outside(b.goal.X, b.goal.Z, safeR * 0.85) then
		b.goal = safePoint(safeR)
	end
	hum:MoveTo(b.goal)
end

function BotService.onArenaStart()
	running = true
	for id, c in pairs(ctx.Match.contenders) do
		if c.kind == "bot" and c.model then
			local root = c.model:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				root.Anchored = false
				pcall(function()
					root:SetNetworkOwner(nil)
				end)
			end
			local b = brains[id]
			if b then
				b.next = workspace:GetServerTimeNow() + b.react
			end
		end
	end
end

function BotService.onArenaEnd()
	running = false
	brains = {}
end

function BotService.init(c: any)
	ctx = c
end

function BotService.start()
	task.spawn(function()
		while true do
			task.wait(Config.Bots.tick)
			if running then
				local t = workspace:GetServerTimeNow()
				for id, c in pairs(ctx.Match.contenders) do
					local b = brains[id]
					if c.kind == "bot" and c.alive and b and t >= b.next then
						b.next = t + Config.Bots.tick
						local ok, err = pcall(function(): any
							think(c, b, t)
							return nil
						end)
						if not ok then
							warn("[BotService] " .. tostring(err))
						end
					end
				end
			end
		end
	end)
end

return BotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DataService — DataStore persistence with session locking, retries and safe shutdown.

	Record format in the DataStore: { lock = { jobId, time }?, data = <player data> }
	  * Load: UpdateAsync acquires the lock. If another live server holds it (player hopped
	    servers and the old one is still saving), we wait and retry; a lock older than
	    STALE_LOCK seconds is treated as abandoned.
	  * Autosave every Config.AUTOSAVE_SECONDS refreshes the lock.
	  * Leave / shutdown: final save releases the lock.
	  * If we ever lose the lock, we stop saving for that player (never overwrite newer data).
	  * In Studio without "Enable Studio Access to API Services", we run in memory-only mode.
]]
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local DefaultData = require(Shared.DefaultData)
local SessionLock = require(Shared.Logic.SessionLock)
local Reconcile = require(Shared.Logic.Reconcile)

local STORE_NAME = "DaybreakHarvesting_Players_v1"
local STALE_LOCK = 300 -- seconds
local LOAD_ATTEMPTS = 8
local SAVE_ATTEMPTS = 4

export type Profile = {
	player: Player,
	key: string,
	data: any,
	memoryOnly: boolean,
	lostLock: boolean,
	saving: boolean,
	released: boolean,
	loadedAt: number,
}

local DataService = {}
DataService.profiles = {} :: { [Player]: Profile }
DataService.onLoaded = Instance.new("BindableEvent")

local jobId = game.JobId ~= "" and game.JobId or ("studio-" .. HttpService:GenerateGUID(false))
local store: DataStore? = nil
local _storeError: string? = nil

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		local why = tostring(result)
		_storeError = why
		warn("[DataService] DataStore unavailable: " .. why)
	end
end

local function keyFor(userId: number): string
	return "u_" .. tostring(userId)
end

local function waitForBudget(requestType: Enum.DataStoreRequestType)
	local tries = 0
	while DataStoreService:GetRequestBudgetForRequestType(requestType) < 1 and tries < 20 do
		tries += 1
		task.wait(0.5)
	end
end

local function isApiAccessError(err: string): boolean
	return string.find(err, "403", 1, true) ~= nil
		or string.find(string.lower(err), "studio", 1, true) ~= nil
		or string.find(string.lower(err), "api services", 1, true) ~= nil
end

local function freshData(): any
	return DefaultData.new()
end

function DataService.get(player: Player): Profile?
	return DataService.profiles[player]
end

function DataService.waitFor(player: Player, timeout: number): Profile?
	local t0 = os.clock()
	while player.Parent and os.clock() - t0 < timeout do
		local p = DataService.profiles[player]
		if p then
			return p
		end
		task.wait(0.2)
	end
	return DataService.profiles[player]
end

function DataService.load(player: Player): Profile?
	local key = keyFor(player.UserId)
	local memoryOnly = false
	local data = nil

	if store == nil then
		memoryOnly = true
	else
		local s = store :: DataStore
		for attempt = 1, LOAD_ATTEMPTS do
			if not player.Parent then
				return nil
			end
			waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
			local status = "error"
			local loaded = nil
			local ok, err = pcall(function()
				s:UpdateAsync(key, function(old)
					local rec, st = SessionLock.acquire(old, jobId, os.time(), STALE_LOCK)
					status = st
					if rec then
						loaded = rec.data
					end
					return rec
				end)
			end)
			if ok and (status == "acquired" or status == "stale-taken") then
				data = loaded
				break
			elseif ok and status == "locked" then
				-- Another server is still finishing this player's save. Wait for it.
				task.wait(math.min(2 * attempt, 8))
			else
				local msg = tostring(err)
				warn(string.format("[DataService] load attempt %d failed for %s: %s", attempt, player.Name, msg))
				if RunService:IsStudio() and isApiAccessError(msg) then
					memoryOnly = true
					break
				end
				task.wait(math.min(2 ^ attempt, 16))
			end
			if attempt == LOAD_ATTEMPTS then
				player:Kick("We couldn't load your save safely (Roblox servers are busy). Please rejoin in a minute. Your progress is safe.")
				return nil
			end
		end
	end

	if not player.Parent then
		-- Left while loading: release the lock we just took.
		if not memoryOnly and store then
			pcall(function()
				(store :: DataStore):UpdateAsync(key, function(old)
					if old and old.lock and old.lock.jobId == jobId then
						old.lock = nil
						return old
					end
					return nil
				end)
			end)
		end
		return nil
	end

	local isNew = data == nil
	data = Reconcile.fill(data or freshData(), DefaultData.new())
	local profile: Profile = {
		player = player,
		key = key,
		data = data,
		memoryOnly = memoryOnly,
		lostLock = false,
		saving = false,
		released = false,
		loadedAt = os.time(),
	}
	DataService.profiles[player] = profile
	DataService.onLoaded:Fire(player, profile, isNew)
	return profile
end

-- Returns true if the data is safely in the DataStore.
function DataService.save(profile: Profile, release: boolean): boolean
	if profile.memoryOnly then
		return true
	end
	if profile.lostLock or store == nil then
		return false
	end
	-- Don't run two saves for the same player at once.
	local waited = 0
	while profile.saving and waited < 30 do
		task.wait(0.25)
		waited += 0.25
	end
	profile.saving = true
	profile.data.lastSeen = os.time()
	local s = store :: DataStore
	local saved = false
	for attempt = 1, SAVE_ATTEMPTS do
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local status = "error"
		local ok, err = pcall(function()
			s:UpdateAsync(profile.key, function(old)
				local rec, st = SessionLock.save(old, jobId, os.time(), profile.data, release)
				status = st
				return rec
			end)
		end)
		if ok and status == "saved" then
			saved = true
			break
		elseif ok and status == "lost-lock" then
			warn("[DataService] lost session lock for " .. profile.key .. "; not overwriting newer data")
			profile.lostLock = true
			break
		else
			warn(string.format("[DataService] save attempt %d failed for %s: %s", attempt, profile.key, tostring(err)))
			task.wait(math.min(2 ^ attempt, 8))
		end
	end
	profile.saving = false
	if release and saved then
		profile.released = true
	end
	return saved
end

function DataService.release(player: Player)
	local profile = DataService.profiles[player]
	if not profile then
		return
	end
	DataService.save(profile, true)
	DataService.profiles[player] = nil
end

function DataService.isStudioMemoryMode(player: Player): boolean
	local p = DataService.profiles[player]
	return p ~= nil and p.memoryOnly
end

function DataService.start()
	-- Autosave loop (also refreshes our session locks).
	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_SECONDS)
			for _, profile in pairs(DataService.profiles) do
				task.spawn(DataService.save, profile, false)
				task.wait(0.5) -- spread requests out
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and store == nil then
			return
		end
		local pending = 0
		for player, _ in pairs(DataService.profiles) do
			pending += 1
			task.spawn(function()
				DataService.release(player)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.2)
		end
	end)
end

-- NOTE: ProgressService handles PlayerRemoving and then calls DataService.release.

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">GalleryService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	GalleryService — the Viewing Gallery. Knocked-out players (and anyone who taps "Watch") keep
	playing from a glass lounge above the arena:
	  * Favor: +1 every 5 s while watching (Big Sponsor pass doubles the rate). Never sold.
	  * Parachute gifts to any contender (pricier late in the match; partner discount).
	  * Hazard votes every 90 s: 3 cards, one always friendly (Supply Drop).
	  * Encore: once a match, the Gallery votes one knocked-out contender back in.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Names = require(Shared.Names)
local Content = require(Shared.Content)
local Gifts = require(Shared.Logic.Gifts)
local Vote = require(Shared.Logic.Vote)
local Twists = require(Shared.Logic.Twists)

local GalleryService = {}
local ctx: any = nil
local rng = Random.new()

local spectators: { [Player]: { favor: number, gifts: number, votes: number } } = {}
local lastGift: { [string]: number } = {}
local inAir = 0
local hazardBallot: Vote.Ballot? = nil
local hazardEnds = 0
local nextHazardVote = 0
local encoreBallot: Vote.Ballot? = nil
local encoreEnds = 0
local encoresLeft = 0
local live = false

local function now(): number
	return workspace:GetServerTimeNow()
end

function GalleryService.isSpectator(p: Player): boolean
	return spectators[p] ~= nil
end

function GalleryService.addSpectator(p: Player)
	if not spectators[p] then
		spectators[p] = { favor = Config.Gallery.favorStart, gifts = 0, votes = 0 }
	end
	ctx.push(p, "gallery", GalleryService.view(p))
end

function GalleryService.removeSpectator(p: Player)
	if spectators[p] then
		spectators[p] = nil
		ctx.push(p, "galleryClose", {})
	end
end

local function tmpl(name: string): Instance?
	local t = ServerStorage:FindFirstChild("Templates")
	return t and t:FindFirstChild(name)
end

-- Parachute down onto a position; calls onLand when it touches down.
local function parachute(pos: Vector3, label: string?, onLand: () -> ())
	local t = tmpl("Parachute")
	if not t then
		onLand()
		return
	end
	inAir += 1
	local m = (t :: Model):Clone()
	local start = pos + Vector3.new(0, 140, 0)
	m:PivotTo(CFrame.new(start))
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	if label then
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.new(0, 200, 0, 30)
		bb.StudsOffset = Vector3.new(0, 14, 0)
		bb.AlwaysOnTop = true
		bb.MaxDistance = 250
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(1, 1)
		tl.BackgroundTransparency = 1
		tl.TextScaled = true
		tl.Font = Enum.Font.FredokaOne
		tl.TextColor3 = Color3.fromHex("#FFE9A8")
		tl.TextStrokeTransparency = 0.3
		tl.Text = label
		tl.Parent = bb
		bb.Parent = m.PrimaryPart
	end
	m.Parent = workspace
	local v = Instance.new("CFrameValue")
	v.Value = CFrame.new(start)
	v.Changed:Connect(function(cf: CFrame)
		if m.Parent then
			m:PivotTo(cf)
		end
	end)
	local tw = TweenService:Create(v, TweenInfo.new(6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Value = CFrame.new(pos + Vector3.new(0, 1.5, 0)) })
	tw.Completed:Connect(function()
		inAir -= 1
		onLand()
		task.delay(1.5, function()
			m:Destroy()
			v:Destroy()
		end)
	end)
	tw:Play()
end

-- A gift lands on a contender (from a spectator, or from Rusty).
function GalleryService.dropGift(c: any, item: string, fromName: string, note: string?)
	local root = ctx.Match.rootOf(c)
	if not root then
		return
	end
	local def = Config.Items[item]
	parachute(root.Position, def and def.name or item, function()
		if not c.alive then
			return
		end
		if not ctx.Match.give(c, item) and def and def.heal then
			c.pep = math.min(Config.PEP_MAX, c.pep + def.heal)
			if c.player then
				ctx.push(c.player, "pep", { pep = c.pep, from = "gift" })
			end
		end
		if c.player then
			ctx.push(c.player, "gift", { from = fromName, item = def and def.name or item, note = note })
		end
	end)
	ctx.pushAll("giftFeed", { from = fromName, to = c.name, item = def and def.name or item })
end

-- A free supply crate on a parachute (the friendly hazard card).
function GalleryService.dropCrate(pos: Vector3)
	parachute(pos, "Supply Crate", function()
		local p = Instance.new("Part")
		p.Name = "SupplyCrate"
		p.Anchored = true
		p.Size = Vector3.new(4, 3, 3)
		p.Color = Color3.fromHex("#D4A72C")
		p.Material = Enum.Material.Wood
		p.CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0))
		p:SetAttribute("Loot", "hub")
		p:SetAttribute("Crate", true)
		local pp = Instance.new("ProximityPrompt")
		pp.ActionText = "Open"
		pp.ObjectText = "Supply Crate"
		pp.HoldDuration = 0.6
		pp.MaxActivationDistance = 9
		pp.RequiresLineOfSight = false
		pp.Parent = p
		local folder = workspace:WaitForChild("Map").Arena:FindFirstChild("FieldCrates")
		p.Parent = folder or workspace
		pp.Triggered:Connect(function(player: Player)
			local c = ctx.Match.contenderOf(player)
			if c and ctx.Match.openCrate(c, p) then
				task.delay(1, function()
					p:Destroy()
				end)
			end
		end)
		task.delay(240, function()
			if p.Parent then
				p:Destroy()
			end
		end)
	end)
end

function GalleryService.view(p: Player): any
	local s = spectators[p]
	local mine = ctx.Match.contenderOf(p)
	local alive = {}
	local weekMult = Twists.mod({ ctx.Match.weekly }, "giftCost", 1)
	local count = ctx.Match.aliveCount()
	for _, id in ipairs(ctx.Match.order) do
		local c = ctx.Match.contenders[id]
		if c and c.alive then
			local isPartner = mine ~= nil and mine.partner == c.id
			table.insert(alive, { id = c.id, name = c.name, reach = c.reach, pep = c.pep, partner = isPartner, bot = c.kind == "bot" })
		end
	end
	local gifts = {}
	for _, g in ipairs(Config.Gifts) do
		table.insert(gifts, { id = g.id, name = g.name, cost = Gifts.cost(g.cost, count, false, Config.Gallery.partnerDiscount, weekMult), partnerCost = Gifts.cost(g.cost, count, true, Config.Gallery.partnerDiscount, weekMult) })
	end
	local hb = hazardBallot
	local eb = encoreBallot
	local encoreNames = {}
	if eb then
		for _, id in ipairs(eb.options) do
			local c = ctx.Match.contenders[id]
			table.insert(encoreNames, { id = id, name = c and c.name or id })
		end
	end
	return {
		favor = s and s.favor or 0,
		alive = alive,
		gifts = gifts,
		hazard = hb and { options = hb.options, counts = Vote.counts(hb), ends = hazardEnds, mine = hb.votes[tostring(p.UserId)] } or nil,
		hazardCards = Content.HAZARD_CARDS,
		encore = eb and { options = encoreNames, counts = Vote.counts(eb), ends = encoreEnds, mine = eb.votes[tostring(p.UserId)] } or nil,
		t = ctx.Match.t,
	}
end

local function pushViews()
	for p in pairs(spectators) do
		if p.Parent then
			ctx.push(p, "gallery", GalleryService.view(p))
		else
			spectators[p] = nil
		end
	end
end

-- ===== intents =====
local function gift(player: Player, targetId: any, giftId: any): (boolean, string?)
	local s = spectators[player]
	if not s then
		return false, "Gifts are sent from " .. Names.GALLERY .. "."
	end
	if type(targetId) ~= "string" or type(giftId) ~= "string" then
		return false, nil
	end
	local c = ctx.Match.contenders[targetId]
	if not c or not c.alive then
		return false, "They're out already."
	end
	local g = nil
	for _, x in ipairs(Config.Gifts) do
		if x.id == giftId then
			g = x
		end
	end
	if not g then
		return false, nil
	end
	local ok, wait = Gifts.canSend(lastGift, targetId, now(), Config.Gallery.giftCooldown)
	if not ok then
		return false, string.format("%s just got a gift. Try again in %ds.", c.name, math.ceil(wait))
	end
	if inAir >= Config.Gallery.maxInAir then
		return false, "The sky is full of parachutes! Wait a moment."
	end
	local mine = ctx.Match.contenderOf(player)
	local isPartner = mine ~= nil and mine.partner == c.id
	local cost = Gifts.cost(g.cost, ctx.Match.aliveCount(), isPartner, Config.Gallery.partnerDiscount, Twists.mod({ ctx.Match.weekly }, "giftCost", 1))
	if s.favor < cost then
		return false, string.format("Needs %d %s. You earn it by watching.", cost, Names.FAVOR)
	end
	s.favor -= cost
	s.gifts += 1
	lastGift[targetId] = now()
	GalleryService.dropGift(c, g.item, player.DisplayName, nil)
	ctx.Progress.bump(player, "gifts", 1)
	pushViews()
	return true, "Gift away! 🪂"
end

local function vote(player: Player, kind: any, option: any): (boolean, string?)
	if not spectators[player] or type(option) ~= "string" then
		return false, nil
	end
	local b = (kind == "encore") and encoreBallot or hazardBallot
	if not b then
		return false, "No vote open right now."
	end
	local first = b.votes[tostring(player.UserId)] == nil
	if not Vote.cast(b, tostring(player.UserId), option) then
		return false, nil
	end
	if first then
		spectators[player].votes += 1
		ctx.Progress.bump(player, "votes", 1)
	end
	pushViews()
	return true, nil
end

function GalleryService.onArenaStart()
	live = true
	lastGift = {}
	inAir = 0
	hazardBallot = nil
	encoreBallot = nil
	nextHazardVote = Config.Hazards.voteFirstAt
	encoresLeft = math.floor(Twists.mod({ ctx.Match.weekly }, "encores", 1))
end

function GalleryService.onArenaEnd()
	live = false
	hazardBallot = nil
	encoreBallot = nil
	pushViews()
end

local function tick()
	local M = ctx.Match
	local t = M.t
	-- Favor
	for p, s in pairs(spectators) do
		local rate = ctx.Progress.hasPass(p, "BigSponsor") and 2 or 1
		s.favor += rate
	end
	-- hazard votes
	if hazardBallot and now() >= hazardEnds then
		local winner = Vote.winner(hazardBallot)
		hazardBallot = nil
		M.startHazard(winner)
	elseif not hazardBallot and t >= nextHazardVote and next(spectators) ~= nil then
		nextHazardVote = t + Config.Hazards.voteEvery
		local opts = {}
		for _, card in ipairs(Content.HAZARD_CARDS) do
			table.insert(opts, card.id)
		end
		hazardBallot = Vote.new(opts)
		hazardEnds = now() + Config.Hazards.voteLength
		ctx.pushAll("vote", { kind = "hazard", seconds = Config.Hazards.voteLength })
	end
	-- Encore
	local E = Config.Encore
	if encoreBallot and now() >= encoreEnds then
		local winner = Vote.winner(encoreBallot)
		encoreBallot = nil
		local c = M.contenders[winner]
		if c then
			M.revive(c)
		end
	elseif not encoreBallot and encoresLeft > 0 and t >= E.at + (1 - encoresLeft) * 120 and M.aliveCount() >= E.minAlive then
		local out = {}
		for _, c in pairs(M.contenders) do
			if not c.alive and c.place and not c.encore then
				table.insert(out, c)
			end
		end
		table.sort(out, function(a: any, b: any): boolean
			local ah = a.player and 1 or 0
			local bh = b.player and 1 or 0
			if ah ~= bh then
				return ah > bh
			end
			return a.knocks > b.knocks
		end)
		if #out > 0 then
			encoresLeft -= 1
			local opts = {}
			for i = 1, math.min(E.candidates, #out) do
				table.insert(opts, out[i].id)
			end
			encoreBallot = Vote.new(opts)
			encoreEnds = now() + E.length
			ctx.pushAll("vote", { kind = "encore", seconds = E.length })
		end
	end
	pushViews()
end

function GalleryService.init(c: any)
	ctx = c
	ctx.handle("gift", gift)
	ctx.handle("vote", vote)
	ctx.handle("leaveGallery", function(player: Player): (boolean, string?)
		local mine = ctx.Match.contenderOf(player)
		if mine and mine.alive then
			return false, nil
		end
		GalleryService.removeSpectator(player)
		task.spawn(function()
			player:LoadCharacterAsync()
		end)
		return true, nil
	end)
end

function GalleryService.start()
	Players.PlayerRemoving:Connect(function(p)
		spectators[p] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(Config.Gallery.favorEvery)
			if live then
				local ok, err = pcall(function(): any
					tick()
					return nil
				end)
				if not ok then
					warn("[GalleryService] " .. tostring(err))
				end
			end
		end
	end)
	local _ = rng
end

return GalleryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">MatchService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MatchService — the Jubilee loop, all in one server for v1:
	  Lobby/Queue -> Pregame (reaping cutscene, parade, interview, training; played on clients)
	  -> Launch (10 s frozen on lift plates around the Sundial) -> Arena (12:00 cap)
	  -> Podium -> "Next match in 10s" (auto-queue keeps your play streak going).
	Humans fill first; labeled Stand-In bots fill the rest of the 48 plates.
	Every hit is validated here (range, arc/line of sight, cooldown, ammo, partner immunity).
	Knockouts are stylized: the contender lights up gold and dissolves into light. No gore.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local ServerStorage = game:GetService("ServerStorage")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Names = require(Shared.Names)
local Content = require(Shared.Content)
local Veil = require(Shared.Logic.Veil)
local Queue = require(Shared.Logic.Queue)
local Combat = require(Shared.Logic.Combat)
local Loot = require(Shared.Logic.Loot)
local Twists = require(Shared.Logic.Twists)
local NearMiss = require(Shared.Logic.NearMiss)
local TimeUtil = require(Shared.Logic.TimeUtil)

local MatchService = {}
local ctx: any = nil
local rng = Random.new()

export type Contender = {
	id: string,
	kind: string, -- "human" | "bot"
	player: Player?,
	name: string,
	reach: string,
	partner: string?,
	model: Model?,
	pep: number,
	alive: boolean,
	place: number?,
	knocks: number,
	crates: number,
	tokens: number,
	inv: { string },
	slots: number,
	ammo: number,
	equipped: number,
	lastUse: { [string]: number },
	lastHitBy: string?,
	lastHitWeapon: string?,
	lastHitDist: number?,
	encore: boolean,
	slowUntil: number,
	knockedAt: number?,
	awarded: boolean,
}

MatchService.state = "Lobby"
MatchService.contenders = {} :: { [string]: Contender }
MatchService.order = {} :: { string }
MatchService.radius = Config.Map.ARENA_SIZE / 2
MatchService.t = 0
MatchService.twist = nil :: any
MatchService.weekly = nil :: any
MatchService.hazard = nil :: string?
MatchService.matchNo = 0

local queue: { Player } = {}
local queueSince = 0
local forceLaunchAt: number? = nil
local partnerOf: { [Player]: Player } = {}
local invites: { [Player]: Player } = {} -- invitee -> inviter
local byModel: { [Model]: string } = {}
local arenaStart = 0
local phases: { Veil.Phase } = Config.VeilPhases
local veilPanels: { BasePart } = {}
local tokenFolder: Folder? = nil
local hazardState: any = {}
local rustyGiftGiven = false
local stateEndsAt = 0

local function now(): number
	return workspace:GetServerTimeNow()
end

local function map(): any
	return workspace:WaitForChild("Map")
end

function MatchService.rootOf(c: Contender): BasePart?
	local m = c.model
	if not m then
		return nil
	end
	return (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart) :: BasePart?
end

function MatchService.contenderOf(player: Player): Contender?
	return MatchService.contenders["u" .. player.UserId]
end

function MatchService.aliveCount(): number
	local n = 0
	for _, c in pairs(MatchService.contenders) do
		if c.alive then
			n += 1
		end
	end
	return n
end

local function matchHumans(): { Player }
	local out = {}
	for _, c in pairs(MatchService.contenders) do
		if c.player and c.player.Parent then
			table.insert(out, c.player)
		end
	end
	return out
end

local function pushMatch(kind: string, payload: any)
	-- everyone in the server sees the live match (lobby screens + Gallery)
	ctx.pushAll(kind, payload)
end

local function inQueue(p: Player): boolean
	return table.find(queue, p) ~= nil
end

-- ===================== inventory + held item visuals =====================
local function setHeld(c: Contender)
	local m = c.model
	if not m then
		return
	end
	local old = m:FindFirstChild("Held")
	if old then
		old:Destroy()
	end
	local item = c.inv[c.equipped]
	if not item then
		return
	end
	local hand = (m:FindFirstChild("RightHand") or m:FindFirstChild("Right Arm") or MatchService.rootOf(c)) :: BasePart?
	if not hand then
		return
	end
	local p = Instance.new("Part")
	p.Name = "Held"
	p.CanCollide = false
	p.CanQuery = false
	p.Massless = true
	p.Material = Enum.Material.Wood
	if item == "bow" then
		p.Size = Vector3.new(0.3, 4.2, 0.6)
		p.Color = Color3.fromHex("#7A4E2A")
	elseif item == "spear" then
		p.Size = Vector3.new(0.3, 7, 0.3)
		p.Color = Color3.fromHex("#8A6A3A")
	elseif item == "knife" then
		p.Size = Vector3.new(0.2, 1.4, 0.4)
		p.Color = Color3.fromHex("#BFC6CF")
		p.Material = Enum.Material.Metal
	else
		p.Size = Vector3.new(0.8, 0.8, 0.8)
		p.Color = Color3.fromHex("#D4A72C")
		p.Shape = Enum.PartType.Ball
	end
	p.CFrame = hand.CFrame * CFrame.new(0, -0.6, -0.3)
	local w = Instance.new("WeldConstraint")
	w.Part0 = hand
	w.Part1 = p
	w.Parent = p
	p.Parent = m
end

local function pushInv(c: Contender)
	if c.player then
		ctx.push(c.player, "inv", { inv = c.inv, slots = c.slots, ammo = c.ammo, equipped = c.equipped, pep = c.pep })
	end
end

-- Adds an item. Returns false when the backpack is full.
function MatchService.give(c: Contender, item: string): boolean
	local def = Config.Items[item]
	if not def then
		return false
	end
	if def.kind == "ammo" then
		c.ammo += def.ammo or 6
	elseif def.kind == "backpack" then
		c.slots = math.max(c.slots, Config.BACKPACK_SLOTS_BIG)
	else
		if #c.inv >= c.slots then
			return false
		end
		table.insert(c.inv, item)
		if def.kind == "weapon" and item == "bow" then
			c.ammo += 4
		end
		if #c.inv == 1 or (def.kind == "weapon" and not Config.Items[c.inv[c.equipped] or ""]) then
			c.equipped = #c.inv
		end
	end
	setHeld(c)
	pushInv(c)
	return true
end

local function itemName(item: string): string
	local d = Config.Items[item]
	return d and d.name or item
end

-- ===================== damage + knockouts =====================
local function fadeColor(c: Contender): Color3
	local fade = "fade_gold"
	if c.player then
		local data = ctx.Progress.dataOf(c.player)
		if data and data.equipped and Content.FADES[data.equipped.fade] then
			fade = data.equipped.fade
		end
	end
	return Color3.fromHex(Content.FADES[fade].color)
end

-- The knockout effect: glow, float a little, dissolve into a column of light.
local function dissolve(c: Contender)
	local m = c.model
	if not m then
		return
	end
	local color = fadeColor(c)
	local h = Instance.new("Highlight")
	h.FillColor = color
	h.OutlineColor = Color3.new(1, 1, 1)
	h.FillTransparency = 0.15
	h.Parent = m
	local root = MatchService.rootOf(c)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			TweenService:Create(d, TweenInfo.new(1.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }):Play()
		elseif d:IsA("Decal") then
			TweenService:Create(d, TweenInfo.new(1.8), { Transparency = 1 }):Play()
		end
	end
	if root then
		local beam = Instance.new("Part")
		beam.Name = "LightColumn"
		beam.Anchored = true
		beam.CanCollide = false
		beam.CanQuery = false
		beam.Material = Enum.Material.Neon
		beam.Color = color
		beam.Shape = Enum.PartType.Cylinder
		beam.Size = Vector3.new(2, 3, 3)
		beam.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, 0, math.pi / 2)
		beam.Transparency = 0.2
		beam.Parent = workspace
		TweenService:Create(beam, TweenInfo.new(2.2), { Size = Vector3.new(120, 1, 1), CFrame = CFrame.new(root.Position + Vector3.new(0, 60, 0)) * CFrame.Angles(0, 0, math.pi / 2), Transparency = 1 }):Play()
		task.delay(2.4, function()
			beam:Destroy()
		end)
	end
end

local function toGallery(player: Player)
	task.spawn(function()
		player:LoadCharacterAsync()
		local char = player.Character or player.CharacterAdded:Wait()
		local spawn = map():FindFirstChild("ViewingGallery") and map().ViewingGallery:FindFirstChild("GallerySpawn")
		if spawn then
			char:PivotTo((spawn :: BasePart).CFrame * CFrame.new(rng:NextNumber(-20, 20), 4, rng:NextNumber(-10, 10)))
		end
		ctx.Gallery.addSpectator(player)
	end)
end

local endIfDone: () -> () -- assigned below

function MatchService.knockout(c: Contender, cause: string)
	if not c.alive then
		return
	end
	local place = MatchService.aliveCount()
	c.alive = false
	c.place = place
	c.knockedAt = now()
	local attacker = c.lastHitBy and MatchService.contenders[c.lastHitBy] or nil
	if attacker and attacker ~= c then
		attacker.knocks += 1
		if attacker.player then
			ctx.Progress.bump(attacker.player, "knocks", 1)
			if c.lastHitWeapon == "bow" then
				ctx.Progress.bump(attacker.player, "bowknocks", 1)
			end
			ctx.push(attacker.player, "knocked", { name = c.name, reach = c.reach, left = place - 1 })
		end
	end
	dissolve(c)
	pushMatch("feed", {
		victim = c.name,
		by = attacker and attacker.name or nil,
		cause = cause,
		weapon = c.lastHitWeapon,
		left = place - 1,
	})
	local root = MatchService.rootOf(c)
	if c.player then
		local player = c.player
		-- "How you got tapped": a kill-cam replay of the last hit + the near-miss card
		local aroot = attacker and MatchService.rootOf(attacker) or nil
		local leader: Contender? = nil
		for _, o in pairs(MatchService.contenders) do
			if o.alive and (leader == nil or o.pep > leader.pep) then
				leader = o
			end
		end
		local result = ctx.Progress.award(player, {
			place = place,
			size = Config.MATCH_SIZE,
			knocks = c.knocks,
			crates = c.crates,
			tokens = c.tokens,
			gifts = 0,
			votes = 0,
			encore = false,
			survived = MatchService.t,
			partner = c.partner ~= nil and string.sub(c.partner, 1, 1) == "u",
			bonusStars = Twists.mod({ MatchService.weekly }, "bonusStars", 0),
		})
		c.awarded = true
		local data = ctx.Progress.dataOf(player)
		local nm = {
			place = place,
			size = Config.MATCH_SIZE,
			knocks = c.knocks,
			survived = MatchService.t,
			bestPlace = result.prevBest or 0,
			nextKnockGoal = ctx.Progress.nextGoal(player, "knocks"),
			winnerPepLeft = place == 2 and leader and leader.pep or nil,
		}
		ctx.push(player, "eliminated", {
			headline = NearMiss.headline(nm),
			lines = NearMiss.lines(nm),
			cause = cause,
			by = attacker and attacker.name or nil,
			byReach = attacker and attacker.reach or nil,
			byPep = attacker and attacker.pep or nil,
			weapon = c.lastHitWeapon and itemName(c.lastHitWeapon) or nil,
			dist = c.lastHitDist,
			from = aroot and aroot.Position or nil,
			at = root and root.Position or nil,
			byModel = attacker and attacker.model or nil,
			place = place,
			result = result,
			autoQueue = data and data.settings.autoQueue or false,
		})
		task.delay(3.2, function()
			if player.Parent then
				toGallery(player)
			end
		end)
	else
		local m = c.model
		task.delay(2.5, function()
			if m then
				byModel[m] = nil
				m:Destroy()
			end
		end)
		c.model = nil
	end
	endIfDone()
end

function MatchService.damage(target: Contender, amount: number, attacker: Contender?, weapon: string, dist: number?)
	if not target.alive or MatchService.state ~= "Arena" then
		return
	end
	if attacker and attacker ~= target then
		if not attacker.alive then
			return
		end
		if not Combat.canHurt(attacker.reach, target.reach, MatchService.aliveCount(), Config.ALLIES_UNTIL) then
			return
		end
		target.lastHitBy = attacker.id
		target.lastHitWeapon = weapon
		target.lastHitDist = dist
		if attacker.player then
			ctx.push(attacker.player, "hitmark", { amount = amount, name = target.name })
		end
	elseif weapon == "veil" or weapon == "finches" or weapon == "bloom" then
		target.lastHitWeapon = weapon
	end
	local pep, ko = Combat.hit(target.pep, amount)
	target.pep = pep
	if target.player then
		ctx.push(target.player, "pep", { pep = pep, from = weapon })
	end
	if ko then
		local cause = weapon
		if weapon == "veil" then
			cause = "touched " .. Names.VEIL
		elseif weapon == "finches" then
			cause = "chased by " .. Names.FINCHES
		elseif weapon == "bloom" then
			cause = "caught in the " .. Names.BLOOM
		end
		MatchService.knockout(target, cause)
	end
end

-- ===================== attacks (humans via the "use" action, bots via BotService) =====================
function MatchService.attack(c: Contender, wid: string, aim: Vector3?): boolean
	local w = Config.Weapons[wid]
	if not w or not c.alive or MatchService.state ~= "Arena" then
		return false
	end
	local t = now()
	if not Combat.ready(c.lastUse[wid], t, w.cooldown) then
		return false
	end
	local root = MatchService.rootOf(c)
	if not root then
		return false
	end
	c.lastUse[wid] = t
	local mult = c.kind == "bot" and Config.Bots.damageMult or 1
	if w.kind == "ranged" then
		if c.ammo <= 0 then
			if c.player then
				ctx.toast(c.player, "Out of arrows! Find a crate or ask the Gallery.", "info")
			end
			return false
		end
		c.ammo -= 1
		local range = w.range * Twists.mod({ MatchService.twist }, "bowRange", 1)
		local origin = root.Position + Vector3.new(0, 1.6, 0)
		local target = aim or (origin + root.CFrame.LookVector * range)
		local dir = target - origin
		if dir.Magnitude < 0.1 then
			dir = root.CFrame.LookVector
		end
		dir = dir.Unit * range
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { c.model :: any, map().Arena.Veil }
		local hit = workspace:Raycast(origin, dir, params)
		local to = hit and hit.Position or (origin + dir)
		pushMatch("tracer", { from = origin, to = to })
		if hit then
			local m = hit.Instance:FindFirstAncestorOfClass("Model")
			while m and not byModel[m] do
				m = m:FindFirstAncestorOfClass("Model")
			end
			local id = m and byModel[m]
			local victim = id and MatchService.contenders[id]
			if victim and victim ~= c then
				local d = (to - origin).Magnitude
				MatchService.damage(victim, math.floor(Combat.bowDamage(w.damage, d, range) * mult + 0.5), c, wid, math.floor(d))
			end
		end
		pushInv(c)
		return true
	end
	-- melee: nearest valid target in the arc in front
	local look = root.CFrame.LookVector
	if aim then
		local d = aim - root.Position
		if Vector3.new(d.X, 0, d.Z).Magnitude > 0.5 then
			look = d.Unit
		end
	end
	local best: Contender? = nil
	local bestD = math.huge
	for _, o in pairs(MatchService.contenders) do
		if o ~= c and o.alive then
			local orr = MatchService.rootOf(o)
			if orr then
				local d = (orr.Position - root.Position).Magnitude
				if d <= w.range + 2 and d < bestD then
					local a = root.Position
					local b = orr.Position
					if Combat.inArc({ x = a.X, y = a.Y, z = a.Z }, { x = look.X, y = 0, z = look.Z }, { x = b.X, y = b.Y, z = b.Z }, w.arc or 70) then
						best, bestD = o, d
					end
				end
			end
		end
	end
	pushMatch("swing", { id = c.id, weapon = wid })
	if best then
		MatchService.damage(best, math.floor(w.damage * mult + 0.5), c, wid, math.floor(bestD))
	end
	return true
end

function MatchService.eat(c: Contender, slot: number): boolean
	local item = c.inv[slot]
	local def = item and Config.Items[item]
	if not def or def.kind ~= "snack" then
		return false
	end
	table.remove(c.inv, slot)
	c.equipped = math.clamp(c.equipped, 1, math.max(1, #c.inv))
	c.pep = math.min(Config.PEP_MAX, c.pep + (def.heal or 0))
	if c.player then
		ctx.Progress.bump(c.player, "snacks", 1)
		ctx.push(c.player, "pep", { pep = c.pep, from = "snack" })
	end
	setHeld(c)
	pushInv(c)
	return true
end

-- Use the equipped slot: weapon -> attack, snack -> eat, nothing -> shove.
function MatchService.use(c: Contender, aim: Vector3?): boolean
	local item = c.inv[c.equipped]
	local def = item and Config.Items[item]
	if def and def.kind == "weapon" and def.weapon then
		return MatchService.attack(c, def.weapon, aim)
	elseif def and def.kind == "snack" then
		return MatchService.eat(c, c.equipped)
	end
	return MatchService.attack(c, "shove", aim)
end

-- ===================== crates + tokens =====================
local function lootTable(kind: string): { [string]: number }
	local t: { [string]: number } = Config.LootField
	if kind == "hub" then
		t = Config.LootHub
	elseif kind == "meadow" then
		t = Config.LootMeadow
	end
	local snacks = Twists.mod({ MatchService.twist }, "snacks", 1)
	if snacks == 1 then
		return t
	end
	local out: { [string]: number } = {}
	for k, v in pairs(t) do
		local d = Config.Items[k]
		out[k] = (d and d.kind == "snack") and v * snacks or v
	end
	return out
end

function MatchService.openCrate(c: Contender, crate: BasePart): boolean
	if MatchService.state ~= "Arena" or not c.alive or crate:GetAttribute("Opened") then
		return false
	end
	local root = MatchService.rootOf(c)
	if not root or (root.Position - crate.Position).Magnitude > 14 then
		return false
	end
	local kind = tostring(crate:GetAttribute("Loot") or "field")
	local item = Loot.pick(lootTable(kind), rng:NextNumber())
	if not MatchService.give(c, item) then
		if c.player then
			ctx.toast(c.player, "Backpack full! Drop or eat something first.", "info")
		end
		return false
	end
	crate:SetAttribute("Opened", true)
	crate.Transparency = 0.7
	local pp = crate:FindFirstChildOfClass("ProximityPrompt")
	if pp then
		pp.Enabled = false
	end
	c.crates += 1
	if c.player then
		ctx.Progress.bump(c.player, "crates", 1)
		if kind == "hub" then
			ctx.Progress.bump(c.player, "hubloot", 1)
		elseif kind == "meadow" then
			ctx.Progress.bump(c.player, "meadow", 1)
		end
		ctx.push(c.player, "loot", { item = item, name = itemName(item) })
	end
	return true
end

local function allCrates(): { BasePart }
	local out = {}
	for _, f in ipairs({ "HubCrates", "FieldCrates", "MeadowCrates" }) do
		local folder = map().Arena:FindFirstChild(f)
		if folder then
			for _, p in ipairs(folder:GetChildren()) do
				if p:IsA("BasePart") and p:GetAttribute("Crate") then
					table.insert(out, p)
				end
			end
		end
	end
	return out
end
MatchService.allCrates = allCrates

local function resetCrates()
	for _, p in ipairs(allCrates()) do
		p:SetAttribute("Opened", nil)
		p.Transparency = 0
		local pp = p:FindFirstChildOfClass("ProximityPrompt")
		if pp then
			pp.Enabled = true
		end
	end
end

local function spawnTokens()
	if tokenFolder then
		tokenFolder:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = "Tokens"
	f.Parent = map().Arena
	tokenFolder = f
	local spots = map().Arena.TokenSpots:GetChildren()
	local n = math.floor(Twists.mod({ MatchService.weekly }, "tokens", Config.TOKENS_PER_MATCH))
	local template = (ServerStorage:FindFirstChild("Templates") :: any).Token
	for _ = 1, math.min(n, #spots) do
		local i = rng:NextInteger(1, #spots)
		local spot = table.remove(spots, i) :: BasePart
		local idx = spot:GetAttribute("TokenIndex") :: number
		local def = Content.TOKENS[idx]
		local tk = template:Clone()
		tk:PivotTo(spot.CFrame * CFrame.Angles(0, 0, math.pi / 2))
		local coin = tk.PrimaryPart :: BasePart
		coin.Anchored = true
		coin.CanTouch = true
		coin.Size = Vector3.new(0.6, 3.2, 3.2)
		local light = Instance.new("PointLight")
		light.Color = Color3.fromHex("#FFD36B")
		light.Range = 14
		light.Parent = coin
		tk:SetAttribute("TokenId", def.id)
		tk.Parent = f
		local taken = false
		coin.Touched:Connect(function(hit: BasePart)
			if taken then
				return
			end
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			local c = player and MatchService.contenderOf(player)
			if not player or not c or not c.alive then
				return
			end
			taken = true
			tk:Destroy()
			c.tokens += 1
			local data = ctx.Progress.dataOf(player)
			local isNew = data and not data.tokens[def.id]
			if data then
				data.tokens[def.id] = true
			end
			ctx.Progress.bump(player, "tokens", 1)
			ctx.push(player, "token", { name = def.name, new = isNew })
		end)
	end
end

-- ===================== Veil + hazards =====================
local function setVeil(radius: number)
	MatchService.radius = radius
	local n = #veilPanels
	if n == 0 then
		return
	end
	local r = math.max(radius, 2)
	local w = 2 * math.pi * r / n * 1.06
	for i, p in ipairs(veilPanels) do
		local a = (i - 0.5) / n * math.pi * 2
		local pos = Vector3.new(math.cos(a) * r, 300, math.sin(a) * r)
		p.Size = Vector3.new(math.max(w, 0.5), 640, 1)
		p.CFrame = CFrame.lookAt(pos, Vector3.new(0, 300, 0))
		p.Transparency = radius <= 1 and 1 or 0.1
	end
end

function MatchService.startHazard(id: string)
	if MatchService.state ~= "Arena" then
		return
	end
	local H = Config.Hazards
	if id == "supply" then
		for _ = 1, H.supply.crates do
			local a = rng:NextNumber(0, math.pi * 2)
			local r = rng:NextNumber(20, math.min(200, MatchService.radius * 0.6))
			ctx.Gallery.dropCrate(Vector3.new(math.cos(a) * r, 0, math.sin(a) * r))
		end
		pushMatch("hazard", { id = id, name = "Supply Drop", text = "Three parachute crates are falling near " .. Names.HUB .. "!" })
		return
	end
	if hazardState[id] then
		return
	end
	if id == "finches" then
		-- target the biggest group of alive contenders
		local best: Contender? = nil
		local bestN = -1
		for _, c in pairs(MatchService.contenders) do
			local r = if c.alive then MatchService.rootOf(c) else nil
			if r then
				local n = 0
				for _, o in pairs(MatchService.contenders) do
					local orr = if o.alive then MatchService.rootOf(o) else nil
					if orr and (orr.Position - r.Position).Magnitude < 80 then
						n += 1
					end
				end
				if n > bestN then
					best, bestN = c, n
				end
			end
		end
		local target = best and MatchService.rootOf(best)
		if not target then
			return
		end
		local center = target.Position + Vector3.new(rng:NextNumber(-60, 60), 0, rng:NextNumber(-60, 60))
		local folder = Instance.new("Folder")
		folder.Name = "Candyfinches"
		folder.Parent = workspace
		local template = (ServerStorage:FindFirstChild("Templates") :: any).Candyfinch
		local birds = {}
		for i = 1, H.finches.birds do
			local b = template:Clone()
			b:SetAttribute("Phase", i / H.finches.birds * math.pi * 2)
			b.Parent = folder
			table.insert(birds, b)
		end
		hazardState.finches = { center = center, target = best and best.id, untilT = now() + H.finches.warn + H.finches.duration, startT = now() + H.finches.warn, folder = folder, birds = birds }
		pushMatch("hazard", { id = id, name = Names.FINCHES, text = "A sugary flock is coming! Spread out.", warn = H.finches.warn, at = center })
	elseif id == "bloom" then
		hazardState.bloom = { untilT = now() + H.bloom.warn + H.bloom.duration, startT = now() + H.bloom.warn }
		for _, e in ipairs(map().Arena.GildedMeadow:GetChildren()) do
			local pe = e:FindFirstChild("Pollen")
			if pe then
				(pe :: ParticleEmitter).Enabled = true
			end
		end
		pushMatch("hazard", { id = id, name = Names.BLOOM, text = "Gilded pollen is rising in " .. Names.MEADOW .. ". Get out!", warn = H.bloom.warn })
	end
end

local function stopHazards()
	local f = hazardState.finches
	if f and f.folder then
		f.folder:Destroy()
	end
	hazardState = {}
	local ok, meadow = pcall(function()
		return map().Arena.GildedMeadow
	end)
	if ok and meadow then
		for _, e in ipairs(meadow:GetChildren()) do
			local pe = e:FindFirstChild("Pollen")
			if pe then
				(pe :: ParticleEmitter).Enabled = false
			end
		end
	end
end

local lastSecond = 0
local function tickHazards(dt: number, wholeSecond: boolean)
	local t = now()
	local H = Config.Hazards
	local f = hazardState.finches
	if f then
		if t > f.untilT then
			f.folder:Destroy()
			hazardState.finches = nil
		else
			local tgt = f.target and MatchService.contenders[f.target]
			local tr = tgt and if tgt.alive then MatchService.rootOf(tgt) else nil
			if t >= f.startT and tr then
				local d = tr.Position - f.center
				local step = math.min(d.Magnitude, H.finches.speed * dt)
				if d.Magnitude > 0.1 then
					f.center += d.Unit * step
				end
			end
			for i, b in ipairs(f.birds) do
				local ph = (b:GetAttribute("Phase") or i) + t * 3
				local r = H.finches.radius * 0.6
				local pos = f.center + Vector3.new(math.cos(ph) * r, 8 + math.sin(ph * 2) * 3, math.sin(ph) * r)
				b:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(-math.sin(ph), 0, math.cos(ph))))
			end
			if wholeSecond and t >= f.startT then
				for _, c in pairs(MatchService.contenders) do
					local r = if c.alive then MatchService.rootOf(c) else nil
					if r and (Vector3.new(r.Position.X, 0, r.Position.Z) - Vector3.new(f.center.X, 0, f.center.Z)).Magnitude < H.finches.radius then
						MatchService.damage(c, H.finches.dps, nil, "finches", nil)
					end
				end
			end
		end
	end
	local b = hazardState.bloom
	if b then
		if t > b.untilT then
			stopHazards()
		elseif t >= b.startT then
			local M = Config.Map.MEADOW
			for _, c in pairs(MatchService.contenders) do
				local r = if c.alive then MatchService.rootOf(c) else nil
				if r then
					local dx, dz = r.Position.X - M.x, r.Position.Z - M.z
					if dx * dx + dz * dz < M.r * M.r then
						c.slowUntil = t + 1.2
						if wholeSecond then
							MatchService.damage(c, H.bloom.dps, nil, "bloom", nil)
						end
					end
				end
			end
		end
	end
end

-- ===================== state machine =====================
local function clearArena()
	stopHazards()
	for _, c in pairs(MatchService.contenders) do
		if c.kind == "bot" and c.model then
			c.model:Destroy()
		end
	end
	byModel = {}
	MatchService.contenders = {}
	MatchService.order = {}
	if tokenFolder then
		tokenFolder:Destroy()
		tokenFolder = nil
	end
	resetCrates()
	setVeil(Config.Map.ARENA_SIZE / 2)
	Lighting.ClockTime = 6.4
	workspace.Gravity = 196.2
end

local function lobbyStatus()
	local humans = #queue
	local waited = now() - queueSince
	local secs = Queue.secondsLeft(humans, waited, Config.MATCH_SIZE, Config.Matchmaking, not Config.Matchmaking.crossServer)
	if forceLaunchAt and humans > 0 then
		secs = math.max(0, forceLaunchAt - now())
	end
	for _, p in ipairs(Players:GetPlayers()) do
		local partner = partnerOf[p]
		ctx.push(p, "lobby", {
			state = MatchService.state,
			queued = humans,
			size = Config.MATCH_SIZE,
			seconds = secs,
			inQueue = inQueue(p),
			partner = partner and partner.DisplayName or nil,
			invite = invites[p] and invites[p].DisplayName or nil,
			inviteFrom = invites[p] and invites[p].UserId or nil,
			weekly = MatchService.weekly,
			alive = MatchService.state == "Arena" and MatchService.aliveCount() or nil,
			t = MatchService.t,
		})
	end
end

local function startPregame()
	MatchService.matchNo += 1
	local wk = TimeUtil.week(os.time())
	MatchService.weekly = Twists.weekly(wk)
	MatchService.twist = Twists.forMatch(MatchService.matchNo, wk)
	local humans = {}
	for _, p in ipairs(queue) do
		if p.Parent and #humans < Config.MATCH_SIZE then
			table.insert(humans, p)
		end
	end
	queue = {}
	forceLaunchAt = nil
	local entries = {}
	local byId: { [string]: Player } = {}
	for _, p in ipairs(humans) do
		local data = ctx.Progress.dataOf(p)
		local partner = partnerOf[p]
		local id = "u" .. p.UserId
		byId[id] = p
		table.insert(entries, {
			id = id,
			reach = data and data.reach ~= "" and data.reach or nil,
			partner = partner and table.find(humans, partner) and ("u" .. partner.UserId) or nil,
		})
	end
	local botIds = {}
	for i = 1, Config.MATCH_SIZE - #humans do
		table.insert(botIds, "b" .. i)
	end
	local slots = Queue.assign(entries, botIds, Names.REACH_LIST, Config.PER_REACH)
	local names = table.clone(Content.BOT_NAMES)
	MatchService.contenders = {}
	MatchService.order = {}
	for _, s in ipairs(slots) do
		local p = byId[s.id]
		local nm: string
		if p then
			nm = p.DisplayName
		else
			nm = table.remove(names, rng:NextInteger(1, #names)) or "Rowan"
		end
		MatchService.contenders[s.id] = {
			id = s.id,
			kind = p and "human" or "bot",
			player = p,
			name = p and nm or (Names.BOT_TAG .. " · " .. nm),
			reach = s.reach,
			partner = s.partner,
			model = nil,
			pep = Config.PEP_MAX,
			alive = true,
			place = nil,
			knocks = 0,
			crates = 0,
			tokens = 0,
			inv = {},
			slots = Config.BACKPACK_SLOTS,
			ammo = 0,
			equipped = 1,
			lastUse = {},
			encore = false,
			slowUntil = 0,
			awarded = false,
		}
		table.insert(MatchService.order, s.id)
	end
	-- pregame length: full reaping if anyone hasn't seen it yet
	local anyNew = false
	for _, p in ipairs(humans) do
		local data = ctx.Progress.dataOf(p)
		if data and not data.seenReaping and not data.settings.shortReaping then
			anyNew = true
		end
	end
	local P = Config.Pregame
	local total = Config.pregameTotal() - (anyNew and 0 or (P.reaping - P.reapingShort))
	MatchService.state = "Pregame"
	stateEndsAt = now() + total
	local roster = {}
	for _, id in ipairs(MatchService.order) do
		local c = MatchService.contenders[id]
		table.insert(roster, { name = c.name, reach = c.reach, bot = c.kind == "bot" })
	end
	for _, p in ipairs(humans) do
		local c = MatchService.contenders["u" .. p.UserId]
		local data = ctx.Progress.dataOf(p)
		local partner = c and c.partner and MatchService.contenders[c.partner]
		ctx.push(p, "pregame", {
			seconds = total,
			reach = c and c.reach,
			partnerName = partner and partner.name or nil,
			short = data and (data.seenReaping or data.settings.shortReaping) or false,
			roster = roster,
			twist = MatchService.twist,
			weekly = MatchService.weekly,
			quip = data and Content.QUIPS[data.quip] or Content.QUIPS[1],
			humans = #humans,
		})
	end
	pushMatch("matchStart", { humans = #humans, bots = #botIds, twist = MatchService.twist })
end

local function startLaunch()
	MatchService.state = "Launch"
	stateEndsAt = now() + Config.Pregame.launch
	-- twist effects
	local tw = MatchService.twist
	if tw then
		if tw.mods.clock then
			Lighting.ClockTime = tw.mods.clock
		end
		if tw.mods.gravity then
			workspace.Gravity = 196.2 * tw.mods.gravity
		end
		phases = Veil.scaled(Config.VeilPhases, tw.mods.veil or 1)
	else
		phases = Config.VeilPhases
	end
	setVeil(Config.Map.ARENA_SIZE / 2)
	local plates = map().Arena.LiftPlates
	for i, id in ipairs(MatchService.order) do
		local c = MatchService.contenders[id]
		local plate = plates:FindFirstChild(string.format("Plate%02d", i)) :: BasePart?
		local cf = plate and (CFrame.lookAt(plate.Position + Vector3.new(0, 4, 0), Vector3.new(0, plate.Position.Y + 4, 0))) or CFrame.new(0, 10, 0)
		if c.player then
			local char = c.player.Character
			if not char or not char.Parent then
				c.player:LoadCharacterAsync()
				char = c.player.Character
			end
			if char then
				char:PivotTo(cf)
				c.model = char
				byModel[char] = c.id
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hum then
					hum.BreakJointsOnDeath = false
					hum.Died:Connect(function()
						if c.alive and MatchService.state == "Arena" then
							MatchService.knockout(c, "a long fall")
						end
					end)
				end
				local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
				if hrp then
					hrp.Anchored = true
				end
				char:SetAttribute("SpeedMult", 1)
			end
			if ctx.Progress.hasPass(c.player, "StarterSatchel") and not Config.RANKED then
				MatchService.give(c, "apple")
				MatchService.give(c, "canteen")
			end
			pushInv(c)
		else
			local m = ctx.Bots.spawn(c, cf)
			c.model = m
			if m then
				byModel[m] = c.id
			end
		end
	end
	resetCrates()
	spawnTokens()
	rustyGiftGiven = false
	pushMatch("launch", { seconds = Config.Pregame.launch, twist = MatchService.twist })
end

local function startArena()
	MatchService.state = "Arena"
	arenaStart = now()
	MatchService.t = 0
	stateEndsAt = arenaStart + Config.HARD_CAP
	for _, c in pairs(MatchService.contenders) do
		if c.player and c.model then
			local hrp = c.model:FindFirstChild("HumanoidRootPart") :: BasePart?
			if hrp then
				hrp.Anchored = false
			end
		end
	end
	ctx.Gallery.onArenaStart()
	ctx.Bots.onArenaStart()
	pushMatch("arena", { size = Config.MATCH_SIZE })
end

local function startPodium()
	MatchService.state = "Podium"
	stateEndsAt = now() + Config.PODIUM_SECONDS
	-- the winner is the last one standing (or the highest Pep at the hard cap)
	local winner: Contender? = nil
	for _, c in pairs(MatchService.contenders) do
		if c.alive and (winner == nil or c.pep > winner.pep) then
			winner = c
		end
	end
	local alive = {}
	for _, c in pairs(MatchService.contenders) do
		if c.alive and c ~= winner then
			table.insert(alive, c)
		end
	end
	table.sort(alive, function(a: Contender, b: Contender): boolean
		return a.pep > b.pep
	end)
	for i, c in ipairs(alive) do
		c.place = i + 1
		c.alive = false
	end
	local podium = {}
	if winner then
		winner.place = 1
		winner.alive = false
	end
	local all = {}
	for _, c in pairs(MatchService.contenders) do
		table.insert(all, c)
	end
	table.sort(all, function(a: Contender, b: Contender): boolean
		return (a.place or 99) < (b.place or 99)
	end)
	for i = 1, math.min(3, #all) do
		table.insert(podium, { name = all[i].name, reach = all[i].reach, place = all[i].place, knocks = all[i].knocks })
	end
	for _, c in ipairs(all) do
		if c.player and c.player.Parent and not c.awarded then
			c.awarded = true
			local data = ctx.Progress.dataOf(c.player)
			local prevBest = data and data.stats.bestPlace or 0
			local result = ctx.Progress.award(c.player, {
				place = c.place or 2,
				size = Config.MATCH_SIZE,
				knocks = c.knocks,
				crates = c.crates,
				tokens = c.tokens,
				gifts = 0,
				votes = 0,
				encore = c.encore,
				survived = MatchService.t,
				partner = c.partner ~= nil and string.sub(c.partner, 1, 1) == "u",
				bonusStars = Twists.mod({ MatchService.weekly }, "bonusStars", 0),
			})
			local nm = { place = c.place or 2, size = Config.MATCH_SIZE, knocks = c.knocks, survived = MatchService.t, bestPlace = prevBest, nextKnockGoal = ctx.Progress.nextGoal(c.player, "knocks"), winnerPepLeft = winner and winner.pep }
			ctx.push(c.player, "finished", { headline = NearMiss.headline(nm), lines = NearMiss.lines(nm), place = c.place, result = result })
		end
	end
	pushMatch("podium", { podium = podium, winner = winner and winner.name or "", reach = winner and winner.reach or "", next = Config.PODIUM_SECONDS + Config.Matchmaking.nextMatchSeconds })
	ctx.Gallery.onArenaEnd()
	ctx.Bots.onArenaEnd()
end

local function backToLobby()
	local players = matchHumans()
	clearArena()
	MatchService.state = "Lobby"
	MatchService.t = 0
	for _, p in ipairs(Players:GetPlayers()) do
		ctx.Gallery.removeSpectator(p)
	end
	for _, p in ipairs(players) do
		task.spawn(function()
			p:LoadCharacterAsync()
		end)
	end
	-- auto-queue: everyone with auto-queue on goes straight back in; the next match starts in 10s
	for _, p in ipairs(Players:GetPlayers()) do
		local data = ctx.Progress.dataOf(p)
		local was = table.find(players, p) ~= nil
		if data and data.settings.autoQueue and (was or inQueue(p)) and not inQueue(p) then
			table.insert(queue, p)
		end
	end
	queueSince = now()
	if #queue > 0 then
		forceLaunchAt = now() + Config.Matchmaking.nextMatchSeconds
	end
	pushMatch("requeue", { seconds = Config.Matchmaking.nextMatchSeconds, queued = #queue })
end

endIfDone = function()
	if MatchService.state ~= "Arena" then
		return
	end
	local alive = MatchService.aliveCount()
	if alive <= 1 then
		task.defer(startPodium)
	end
end

-- Encore: bring a knocked-out contender back with some Pep (GalleryService picks who).
function MatchService.revive(c: Contender): boolean
	if MatchService.state ~= "Arena" or c.alive then
		return false
	end
	local a = rng:NextNumber(0, math.pi * 2)
	local r = math.min(MatchService.radius * 0.5, 300)
	local pos = Vector3.new(math.cos(a) * r, 6, math.sin(a) * r)
	c.alive = true
	c.place = nil
	c.pep = Config.Encore.pep
	c.encore = true
	c.inv = {}
	c.slots = Config.BACKPACK_SLOTS
	c.equipped = 1
	MatchService.give(c, "knife")
	if c.player then
		local player = c.player
		ctx.Gallery.removeSpectator(player)
		local char = player.Character
		if char then
			char:PivotTo(CFrame.new(pos))
			c.model = char
			byModel[char] = c.id
		end
		ctx.Progress.bump(player, "encore", 1)
		ctx.push(player, "encore", { pep = c.pep })
		pushInv(c)
	else
		local m = ctx.Bots.spawn(c, CFrame.new(pos))
		c.model = m
		if m then
			byModel[m] = c.id
		end
	end
	pushMatch("feed", { victim = c.name, cause = "voted back in by " .. Names.GALLERY, encore = true, left = MatchService.aliveCount() })
	return true
end

-- ===================== intents =====================
local function joinQueue(player: Player): (boolean, string?)
	if MatchService.contenderOf(player) and MatchService.state ~= "Lobby" then
		return false, "You're in a match right now."
	end
	if inQueue(player) then
		return true, nil
	end
	table.insert(queue, player)
	if #queue == 1 then
		queueSince = now()
	end
	lobbyStatus()
	if MatchService.state ~= "Lobby" then
		return true, "Queued! You'll go in the next " .. Names.EVENT_SHORT .. "."
	end
	return true, "Queued for " .. Names.DRAW .. "!"
end

local function leaveQueue(player: Player): (boolean, string?)
	local i = table.find(queue, player)
	if i then
		table.remove(queue, i)
	end
	lobbyStatus()
	return true, "Left the queue."
end

local function invite(player: Player, userId: any): (boolean, string?)
	if type(userId) ~= "number" then
		return false, nil
	end
	local other = Players:GetPlayerByUserId(userId)
	if not other or other == player then
		return false, "They're not in this server."
	end
	if invites[player] == other then
		-- they already invited us: accept
		partnerOf[player] = other
		partnerOf[other] = player
		invites[player] = nil
		ctx.toast(other, player.DisplayName .. " is your partner! Same " .. Names.REGION .. ", side by side.", "good")
		lobbyStatus()
		return true, "Partnered with " .. other.DisplayName .. "!"
	end
	invites[other] = player
	ctx.toast(other, player.DisplayName .. " wants to partner up. Open Partner to accept.", "info")
	lobbyStatus()
	return true, "Invite sent."
end

local function unpartner(player: Player): (boolean, string?)
	local o = partnerOf[player]
	partnerOf[player] = nil
	if o then
		partnerOf[o] = nil
		ctx.toast(o, player.DisplayName .. " left your partnership.", "info")
	end
	lobbyStatus()
	return true, nil
end

local function use(player: Player, aim: any): (boolean, string?)
	local c = MatchService.contenderOf(player)
	if not c or not c.alive or MatchService.state ~= "Arena" then
		return false, nil
	end
	local a = typeof(aim) == "Vector3" and aim or nil
	return MatchService.use(c, a), nil
end

local function equipSlot(player: Player, i: any): (boolean, string?)
	local c = MatchService.contenderOf(player)
	if not c or type(i) ~= "number" or not c.inv[i] then
		return false, nil
	end
	c.equipped = math.floor(i)
	setHeld(c)
	pushInv(c)
	return true, nil
end

local function drop(player: Player, i: any): (boolean, string?)
	local c = MatchService.contenderOf(player)
	if not c or type(i) ~= "number" or not c.inv[i] then
		return false, nil
	end
	table.remove(c.inv, i)
	c.equipped = math.clamp(c.equipped, 1, math.max(1, #c.inv))
	setHeld(c)
	pushInv(c)
	return true, nil
end

local function watch(player: Player): (boolean, string?)
	if MatchService.state ~= "Arena" then
		return false, "No live " .. Names.EVENT_SHORT .. " to watch right now."
	end
	local c = MatchService.contenderOf(player)
	if c and c.alive then
		return false, nil
	end
	toGallery(player)
	return true, "Welcome to " .. Names.GALLERY .. "!"
end

local function training(_player: Player, score: any): (boolean, string?)
	if type(score) ~= "number" then
		return false, nil
	end
	local s = math.clamp(math.floor(score), 0, 12)
	return true, string.format("%s rates your training a %d out of 12.", Names.MENTOR_SHORT, s)
end

function MatchService.onLeave(player: Player)
	local i = table.find(queue, player)
	if i then
		table.remove(queue, i)
	end
	local o = partnerOf[player]
	if o then
		partnerOf[o] = nil
	end
	partnerOf[player] = nil
	invites[player] = nil
	local c = MatchService.contenderOf(player)
	if c and c.alive and MatchService.state == "Arena" then
		MatchService.knockout(c, "left the arena")
	end
	if c then
		c.player = nil
	end
end

function MatchService.init(c: any)
	ctx = c
	ctx.handle("queue", joinQueue)
	ctx.handle("leave", leaveQueue)
	ctx.handle("invite", invite)
	ctx.handle("unpartner", unpartner)
	ctx.handle("use", use)
	ctx.handle("equipSlot", equipSlot)
	ctx.handle("drop", drop)
	ctx.handle("watch", watch)
	ctx.handle("training", training)
end

function MatchService.start()
	-- templates move out of Workspace so they aren't visible
	local tpl = map():FindFirstChild("Templates")
	if tpl then
		tpl.Parent = ServerStorage
	end
	for _, p in ipairs(map().Arena.Veil:GetChildren()) do
		if p:IsA("BasePart") then
			table.insert(veilPanels, p)
		end
	end
	table.sort(veilPanels, function(a: BasePart, b: BasePart): boolean
		return ((a:GetAttribute("Angle") or 0) :: number) < ((b:GetAttribute("Angle") or 0) :: number)
	end)
	-- crate prompts
	for _, crate in ipairs(allCrates()) do
		local pp = crate:FindFirstChildOfClass("ProximityPrompt")
		if pp then
			pp.Triggered:Connect(function(player: Player)
				local c = MatchService.contenderOf(player)
				if c then
					MatchService.openCrate(c, crate)
				end
			end)
		end
	end
	-- lobby prompts
	local lobby = map().Lobby
	for _, d in ipairs(lobby:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			d.Triggered:Connect(function(player: Player)
				local kind = d:GetAttribute("Kind")
				if kind == "queue" then
					local ok, msg = joinQueue(player)
					if msg then
						ctx.toast(player, msg, ok and "good" or "info")
					end
				else
					ctx.push(player, "openPanel", { kind = kind })
				end
			end)
		end
	end
	-- main loop
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.25)
			local t0 = os.clock()
			local dt = t0 - last
			last = t0
			local ok, err = pcall(function()
				local t = now()
				local wholeSecond = math.floor(t) ~= lastSecond
				lastSecond = math.floor(t)
				if MatchService.state == "Lobby" then
					-- drop players who left
					for i = #queue, 1, -1 do
						if not queue[i].Parent then
							table.remove(queue, i)
						end
					end
					local go = false
					if forceLaunchAt and #queue > 0 then
						go = t >= forceLaunchAt
					else
						go = Queue.shouldLaunch(#queue, t - queueSince, Config.MATCH_SIZE, Config.Matchmaking, not Config.Matchmaking.crossServer)
					end
					if go then
						startPregame()
					elseif wholeSecond then
						lobbyStatus()
					end
				elseif MatchService.state == "Pregame" then
					if t >= stateEndsAt then
						startLaunch()
					end
				elseif MatchService.state == "Launch" then
					if t >= stateEndsAt then
						startArena()
					end
				elseif MatchService.state == "Arena" then
					MatchService.t = t - arenaStart
					local r = Veil.radiusAt(MatchService.t, phases, Config.Map.ARENA_SIZE / 2)
					if math.abs(r - MatchService.radius) > 0.05 then
						setVeil(r)
					end
					tickHazards(dt, wholeSecond)
					if wholeSecond then
						local dmg = Veil.damage(MatchService.t, phases, Config.VEIL_DAMAGE)
						for _, c in pairs(MatchService.contenders) do
							local root = if c.alive then MatchService.rootOf(c) else nil
							if root then
								if Veil.outside(root.Position.X, root.Position.Z, MatchService.radius) then
									MatchService.damage(c, dmg, nil, "veil", nil)
								end
								if c.model then
									c.model:SetAttribute("SpeedMult", c.slowUntil > t and Config.Hazards.bloom.slow or 1)
								end
							end
						end
						-- scheduled hazards (Finch Day doubles the flock)
						for _, h in ipairs(Config.Hazards.scheduled) do
							if math.floor(MatchService.t) == h.at then
								MatchService.startHazard(h.id)
							end
						end
						if MatchService.twist and MatchService.twist.mods.finches and math.floor(MatchService.t) == 450 then
							MatchService.startHazard("finches")
						end
						-- Rusty's gift at the final 8
						if not rustyGiftGiven and MatchService.aliveCount() <= Config.RUSTY_GIFT_AT then
							local low: Contender? = nil
							for _, c in pairs(MatchService.contenders) do
								if c.alive and c.player and (low == nil or c.pep < low.pep) then
									low = c
								end
							end
							if low then
								rustyGiftGiven = true
								ctx.Gallery.dropGift(low, "sweettea", Names.MENTOR_SHORT, Content.RUSTY.gift)
							end
						end
						local nextIn, target = Veil.nextShrink(MatchService.t, phases)
						pushMatch("match", {
							t = MatchService.t,
							alive = MatchService.aliveCount(),
							radius = MatchService.radius,
							nextIn = nextIn,
							target = target,
							shrinking = Veil.isShrinking(MatchService.t, phases),
							twist = MatchService.twist and MatchService.twist.name,
						})
						if t >= stateEndsAt then
							startPodium()
						end
					end
				elseif MatchService.state == "Podium" then
					if t >= stateEndsAt then
						backToLobby()
					end
				end
			end)
			if not ok then
				warn("[MatchService] " .. tostring(err))
			end
		end
	end)
end

return MatchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">ProgressService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ProgressService — everything that keeps players coming back, all cosmetic or Renown:
	  * Contender level 1-50 and prestige ranks (Leveling)
	  * Play streak: back-to-back matches add +10% Renown each (max +50%), resets after 4 min idle
	  * Forgiving daily streak (one free miss a week, soft reset)
	  * 3 daily + 3 weekly challenges (same for everyone on a given day/week)
	  * The Season Track (free lane for all; optional premium cosmetic lane)
	  * Jubilee Token collection book
	  * Reach loyalty: weekly Reach standings and cosmetic banners for the top 3 Reaches
	It also builds the "state" snapshot each client renders.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Names = require(Shared.Names)
local Content = require(Shared.Content)
local Monetization = require(Shared.Monetization)
local Leveling = require(Shared.Logic.Leveling)
local Streak = require(Shared.Logic.Streak)
local Challenges = require(Shared.Logic.Challenges)
local SeasonTrack = require(Shared.Logic.SeasonTrack)
local ReachStandings = require(Shared.Logic.ReachStandings)
local Twists = require(Shared.Logic.Twists)
local TimeUtil = require(Shared.Logic.TimeUtil)

local ProgressService = {}
local ctx: any = nil

export type Runtime = { passes: { [string]: boolean }, dirty: boolean }
ProgressService.runtime = {} :: { [Player]: Runtime }
ProgressService.reachTable = {} :: { [string]: number } -- this server's view of this week's points
local reachStore: OrderedDataStore? = nil

local function week(): number
	return TimeUtil.week(os.time())
end
local function today(): number
	return TimeUtil.day(os.time())
end

function ProgressService.dataOf(player: Player): any?
	local p = ctx.Data.get(player)
	return p and p.data or nil
end

function ProgressService.hasPass(player: Player, key: string): boolean
	local r = ProgressService.runtime[player]
	return r ~= nil and r.passes[key] == true
end

local function ensurePeriodic(data: any)
	Challenges.ensure(data.daily, Challenges.DAILY, today(), 3)
	Challenges.ensure(data.weekly, Challenges.WEEKLY, week(), 3)
	SeasonTrack.ensure(data.season, SeasonTrack.SEASON)
end

local function challengeView(list: { any }): { any }
	local out = {}
	for _, e in ipairs(list) do
		local d = Challenges.def(e.id)
		if d then
			table.insert(out, { id = e.id, text = d.text, goal = d.goal, progress = e.progress, done = e.done, xp = d.xp, stars = d.stars })
		end
	end
	return out
end

local tiersView: { any }? = nil
local function tiers(): { any }
	if tiersView then
		return tiersView
	end
	local t = {}
	for i, tier in ipairs(SeasonTrack.tiers) do
		t[i] = { free = tier.free.name, premium = tier.premium.name }
	end
	tiersView = t
	return t
end

function ProgressService.snapshot(player: Player): any?
	local data = ProgressService.dataOf(player)
	if not data then
		return nil
	end
	ensurePeriodic(data)
	local hasPremium = ProgressService.hasPass(player, "PremiumLane")
	local tokens = 0
	for _ in pairs(data.tokens) do
		tokens += 1
	end
	local now = os.time()
	return {
		title = Names.TITLE,
		level = data.level,
		xp = data.xp,
		xpNext = Leveling.xpToNext(data.level),
		prestige = data.prestige,
		rank = Names.rank(data.prestige),
		canPrestige = Leveling.canPrestige(data, Config.LEVEL_CAP, Config.PRESTIGE_CAP),
		stats = data.stats,
		streak = data.streak.count,
		bestStreak = data.streak.best,
		play = data.play.count,
		playMult = Leveling.playMult(data.play.count, Config.PLAY_STREAK_STEP, Config.PLAY_STREAK_MAX),
		daily = challengeView(data.daily.list),
		weekly = challengeView(data.weekly.list),
		dailyResetIn = 86400 - (now % 86400),
		season = {
			name = SeasonTrack.SEASON_NAME,
			stars = data.season.stars,
			perTier = Config.STARS_PER_TIER,
			tier = SeasonTrack.tierFor(data.season.stars, Config.STARS_PER_TIER),
			claimedFree = data.season.claimedFree,
			claimedPremium = data.season.claimedPremium,
			premium = hasPremium,
			unclaimed = SeasonTrack.unclaimed(data.season, hasPremium, Config.STARS_PER_TIER),
			tiers = tiers(),
		},
		tokens = tokens,
		tokenTotal = #Content.TOKENS,
		tokenBook = data.tokens,
		owned = data.owned,
		equipped = data.equipped,
		reach = data.reach,
		canChangeReach = ReachStandings.canChange(data.reachWeek, week()),
		reachTop = ReachStandings.sorted(ProgressService.reachTable),
		weeklyRule = Twists.weekly(week()),
		settings = data.settings,
		quip = data.quip,
		passes = ProgressService.runtime[player] and ProgressService.runtime[player].passes or {},
		shop = ctx.Purchase.availability(),
		seenReaping = data.seenReaping,
	}
end

function ProgressService.sendState(player: Player)
	local snap = ProgressService.snapshot(player)
	if snap then
		ctx.push(player, "state", snap)
	end
end

function ProgressService.markDirty(player: Player)
	local r = ProgressService.runtime[player]
	if r then
		r.dirty = true
	end
end

local function giveXp(player: Player, data: any, amount: number): number
	local gained = Leveling.add(data, amount, Config.LEVEL_CAP)
	if gained > 0 then
		ctx.push(player, "levelup", { level = data.level, rank = Names.rank(data.prestige) })
	end
	return gained
end

local function finishChallenges(player: Player, data: any, done: { any })
	for _, d in ipairs(done) do
		local list = data.daily.list
		local claimed = Challenges.claim(data.daily, d.id) or Challenges.claim(data.weekly, d.id)
		if claimed then
			giveXp(player, data, claimed.xp)
			SeasonTrack.addStars(data.season, claimed.stars, Config.STARS_PER_TIER)
			ctx.push(player, "challenge", { text = claimed.text, xp = claimed.xp, stars = claimed.stars })
		end
		local _ = list
	end
end

-- In-match stat ticks (crates, knocks, gifts, votes, tokens...). Shows challenge pops right away.
function ProgressService.bump(player: Player, stat: string, amount: number?)
	local data = ProgressService.dataOf(player)
	if not data then
		return
	end
	ensurePeriodic(data)
	local n = amount or 1
	local done = Challenges.bump(data.daily, stat, n)
	for _, d in ipairs(Challenges.bump(data.weekly, stat, n)) do
		table.insert(done, d)
	end
	finishChallenges(player, data, done)
	ProgressService.markDirty(player)
end

-- How many more of `stat` finish the closest open challenge (nil if none).
function ProgressService.nextGoal(player: Player, stat: string): number?
	local data = ProgressService.dataOf(player)
	if not data then
		return nil
	end
	local best: number? = nil
	for _, s in ipairs({ data.daily, data.weekly }) do
		for _, e in ipairs(s.list) do
			local d = Challenges.def(e.id)
			if d and d.stat == stat and not e.done then
				local left = d.goal - e.progress
				if best == nil or left < best then
					best = left
				end
			end
		end
	end
	return best
end

function ProgressService.boostMult(_player: Player, data: any): number
	if data.boost and data.boost.untilT > os.time() then
		return 1 + data.boost.mult
	end
	return 1
end

function ProgressService.addBoost(data: any, minutes: number, mult: number)
	local now = os.time()
	local base = math.max(now, data.boost.untilT)
	data.boost.untilT = base + minutes * 60
	data.boost.mult = math.max(data.boost.mult or 0, mult)
end

export type MatchResult = {
	place: number,
	size: number,
	knocks: number,
	crates: number,
	tokens: number,
	gifts: number,
	votes: number,
	encore: boolean,
	survived: number,
	partner: boolean,
	bonusStars: number,
}

-- Called once per contender when their match ends (knocked out or at the podium).
function ProgressService.award(player: Player, r: MatchResult): any
	local data = ProgressService.dataOf(player)
	if not data then
		return {}
	end
	ensurePeriodic(data)
	local prevBest = data.stats.bestPlace
	local playCount = Leveling.playStreak(data.play, os.time(), Config.PLAY_STREAK_WINDOW)
	local playMult = Leveling.playMult(playCount, Config.PLAY_STREAK_STEP, Config.PLAY_STREAK_MAX)
	local X = Config.XP
	local base = X.match + (r.size + 1 - r.place) * X.perPlaceAbove + r.knocks * X.knock + r.crates * X.crate
	if r.place == 1 then
		base += X.win
	end
	if r.place <= 10 then
		base += X.top10
	end
	if r.encore then
		base += X.encore
	end
	local mult = playMult * ProgressService.boostMult(player, data)
	local xp = math.floor(base * mult)
	local levels = giveXp(player, data, xp)
	-- Season stars
	local stars = Config.STARS.match + r.bonusStars
	if r.place == 1 then
		stars += Config.STARS.win
	elseif r.place <= 10 then
		stars += Config.STARS.top10
	end
	local tiersUp = SeasonTrack.addStars(data.season, stars, Config.STARS_PER_TIER)
	-- Daily streak counts on the first finished match of the day
	local streakMsg: string? = nil
	if Streak.canClaim(data.streak, today()) then
		local res = Streak.claim(data.streak, today())
		if res.ok then
			local bonus = math.floor(Config.DAILY_STREAK_XP * Streak.rewardScale(res.count))
			giveXp(player, data, bonus)
			streakMsg = string.format("Day %d streak! +%d %s", res.count, bonus, Names.XP)
			if res.usedFreeMiss then
				streakMsg = tostring(streakMsg) .. " (free miss used)"
			end
		end
	end
	-- Stats + challenges
	local st = data.stats
	st.matches += 1
	st.knocks += r.knocks
	if r.place == 1 then
		st.wins += 1
	end
	if r.place <= 10 then
		st.top10 += 1
	end
	if r.place <= 5 then
		st.top5 += 1
	end
	if st.bestPlace == 0 or r.place < st.bestPlace then
		st.bestPlace = r.place
	end
	local done = {}
	local function add(stat: string, n: number)
		if n > 0 then
			for _, d in ipairs(Challenges.bump(data.daily, stat, n)) do
				table.insert(done, d)
			end
			for _, d in ipairs(Challenges.bump(data.weekly, stat, n)) do
				table.insert(done, d)
			end
		end
	end
	add("matches", 1)
	add("top10", r.place <= 10 and 1 or 0)
	add("top5", r.place <= 5 and 1 or 0)
	add("wins", r.place == 1 and 1 or 0)
	add("survive5", r.survived >= 300 and 1 or 0)
	add("partnermatches", r.partner and 1 or 0)
	add("encore", r.encore and 1 or 0)
	finishChallenges(player, data, done)
	-- Reach loyalty
	if data.reach ~= "" then
		local pts = ReachStandings.pointsFor(r.place, r.knocks)
		data.reachPlayedWeek = week()
		ProgressService.addReachPoints(data.reach, pts)
	end
	ProgressService.markDirty(player)
	task.defer(ProgressService.sendState, player)
	return {
		xp = xp,
		playStreak = playCount,
		playMult = playMult,
		levels = levels,
		level = data.level,
		stars = stars,
		tiersUp = tiersUp,
		streakMsg = streakMsg,
		prevBest = prevBest,
	}
end

function ProgressService.addReachPoints(reach: string, pts: number)
	if pts <= 0 or not Names.reachIndex(reach) then
		return
	end
	ReachStandings.add(ProgressService.reachTable, reach, pts)
	local store = reachStore
	if store then
		task.spawn(function()
			pcall(function()
				store:IncrementAsync(reach, pts)
			end)
		end)
	end
end

local function refreshReachTable()
	local store = reachStore
	if not store then
		return
	end
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, 24)
	end)
	if ok and pages then
		local page = pages:GetCurrentPage()
		local tbl = {}
		for _, row in ipairs(page) do
			tbl[row.key] = row.value
		end
		ProgressService.reachTable = tbl
	end
end

-- Last week's top 3 Reaches give a banner to everyone who repped them that week.
local function grantBanners(player: Player, data: any)
	local last = week() - 1
	if data.reachPlayedWeek ~= last or data.reach == "" then
		return
	end
	local ok, pages = pcall(function()
		return DataStoreService:GetOrderedDataStore("ReachWeek_" .. last):GetSortedAsync(false, 3)
	end)
	if not ok or not pages then
		return
	end
	local tbl = {}
	for _, row in ipairs(pages:GetCurrentPage()) do
		tbl[row.key] = row.value
	end
	for i, reach in ipairs(ReachStandings.banners(tbl)) do
		if reach == data.reach then
			local id = string.format("banner_w%d_%s", last, (reach:lower():gsub("%s+", "_")))
			if not data.owned[id] then
				data.owned[id] = true
				ctx.toast(player, string.format("%s placed #%d last week! You earned its banner.", reach, i), "good")
				ProgressService.markDirty(player)
			end
		end
	end
end

-- ===== client intents =====
local function claimTier(player: Player, tier: any, lane: any): (boolean, string?)
	local data = ProgressService.dataOf(player)
	if not data or type(tier) ~= "number" or type(lane) ~= "string" then
		return false, nil
	end
	local reward, why = SeasonTrack.claim(data.season, math.floor(tier), lane, ProgressService.hasPass(player, "PremiumLane"), Config.STARS_PER_TIER)
	if not reward then
		return false, why
	end
	if reward.kind == "renown" then
		giveXp(player, data, reward.amount or 0)
	else
		data.owned[reward.id] = true
	end
	ProgressService.markDirty(player)
	ProgressService.sendState(player)
	return true, "Claimed: " .. reward.name
end

local function prestige(player: Player): (boolean, string?)
	local data = ProgressService.dataOf(player)
	if not data then
		return false, nil
	end
	if not Leveling.prestige(data, Config.LEVEL_CAP, Config.PRESTIGE_CAP) then
		return false, "Reach level " .. Config.LEVEL_CAP .. " to prestige."
	end
	data.owned["frame_rank" .. data.prestige] = true
	ProgressService.markDirty(player)
	ProgressService.sendState(player)
	return true, "You are now " .. Names.rank(data.prestige) .. "! New frame unlocked."
end

local function setReach(player: Player, reach: any): (boolean, string?)
	local data = ProgressService.dataOf(player)
	if not data or type(reach) ~= "string" or not Names.reachIndex(reach) then
		return false, nil
	end
	if data.reach == reach then
		return true, nil
	end
	if data.reach ~= "" and not ReachStandings.canChange(data.reachWeek, week()) then
		return false, "You can change your home " .. Names.REGION .. " once a week."
	end
	data.reach = reach
	data.reachWeek = week()
	ProgressService.markDirty(player)
	ProgressService.sendState(player)
	return true, "Home " .. Names.REGION .. ": " .. reach
end

local function setting(player: Player, key: any, value: any): (boolean, string?)
	local data = ProgressService.dataOf(player)
	if not data or type(key) ~= "string" or type(value) ~= "boolean" then
		return false, nil
	end
	if key ~= "autoQueue" and key ~= "sfx" and key ~= "shortReaping" then
		return false, nil
	end
	data.settings[key] = value
	ProgressService.markDirty(player)
	ProgressService.sendState(player)
	return true, nil
end

local function setQuip(player: Player, i: any): (boolean, string?)
	local data = ProgressService.dataOf(player)
	if not data or type(i) ~= "number" or not Content.QUIPS[i] then
		return false, nil
	end
	data.quip = math.floor(i)
	ProgressService.markDirty(player)
	ProgressService.sendState(player)
	return true, nil
end

local function equip(player: Player, slot: any, id: any): (boolean, string?)
	local data = ProgressService.dataOf(player)
	if not data or type(slot) ~= "string" or type(id) ~= "string" then
		return false, nil
	end
	if slot ~= "fade" and slot ~= "banner" and slot ~= "title" then
		return false, nil
	end
	if id ~= "" and id ~= "fade_gold" and not data.owned[id] then
		return false, "Not owned yet."
	end
	data.equipped[slot] = id
	ProgressService.markDirty(player)
	ProgressService.sendState(player)
	return true, nil
end

local function seenReaping(player: Player): (boolean, string?)
	local data = ProgressService.dataOf(player)
	if data and not data.seenReaping then
		data.seenReaping = true
		ProgressService.markDirty(player)
	end
	return true, nil
end

local function onLoaded(player: Player, profile: any, isNew: boolean)
	local data = profile.data
	ensurePeriodic(data)
	ProgressService.runtime[player] = { passes = ctx.Purchase.loadPasses(player), dirty = false }
	ProgressService.sendState(player)
	if isNew then
		ctx.toast(player, "Welcome to " .. Names.CAPITAL:gsub("^the ", "the ") .. ". Pick your home " .. Names.REGION .. " on the board!", "good")
	end
	task.spawn(grantBanners, player, data)
end

function ProgressService.init(c: any)
	ctx = c
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore("ReachWeek_" .. week())
	end)
	if ok then
		reachStore = store
	end
	ctx.handle("claimTier", claimTier)
	ctx.handle("prestige", prestige)
	ctx.handle("setReach", setReach)
	ctx.handle("setting", setting)
	ctx.handle("quip", setQuip)
	ctx.handle("equip", equip)
	ctx.handle("seenReaping", seenReaping)
	ctx.handle("refresh", function(player: Player): (boolean, string?)
		ProgressService.sendState(player)
		return true, nil
	end)
end

function ProgressService.start()
	ctx.Data.onLoaded.Event:Connect(onLoaded)
	Players.PlayerAdded:Connect(function(player)
		ctx.Data.load(player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(ctx.Data.load, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		ctx.Match.onLeave(player)
		ctx.Data.release(player)
		ProgressService.runtime[player] = nil
	end)
	task.spawn(function()
		while true do
			refreshReachTable()
			task.wait(60)
		end
	end)
end

local _ = Monetization
return ProgressService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">PurchaseService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PurchaseService — Game Passes and Developer Products.
	  * ProcessReceipt is idempotent: each PurchaseId is recorded in the player's save
	    (ReceiptLedger) and the save must succeed before we tell Roblox "PurchaseGranted".
	  * IDs live in ReplicatedStorage.Shared.Monetization. Items with id 0 are hidden in the
	    live game; in Studio they get a free "Studio test" grant so you can try everything.
	  * Nothing sold here is random. Robux never buys Favor, Stars or tiers.
]]
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Monetization = require(Shared.Monetization)
local ReceiptLedger = require(Shared.Logic.ReceiptLedger)

local PurchaseService = {}
local ctx: any = nil
local RECEIPT_MEMORY = 50
local IS_STUDIO = RunService:IsStudio()

local productById: { [number]: string } = {}
local passById: { [number]: string } = {}
for key, p in pairs(Monetization.Products) do
	if p.id ~= 0 then
		productById[p.id] = key
	end
end
for key, p in pairs(Monetization.Passes) do
	if p.id ~= 0 then
		passById[p.id] = key
	end
end

function PurchaseService.availability(): any
	local out = { products = {}, passes = {}, studio = IS_STUDIO, catalog = { passes = {}, products = {} } }
	for key, p in pairs(Monetization.Products) do
		out.products[key] = p.id ~= 0 or IS_STUDIO
		out.catalog.products[key] = { name = p.name, price = p.price, desc = p.desc, icon = p.icon, category = p.category }
	end
	for key, p in pairs(Monetization.Passes) do
		out.passes[key] = p.id ~= 0 or IS_STUDIO
		out.catalog.passes[key] = { name = p.name, price = p.price, desc = p.desc, icon = p.icon }
	end
	return out
end

function PurchaseService.loadPasses(player: Player): { [string]: boolean }
	local owned = {}
	for key, p in pairs(Monetization.Passes) do
		if p.id ~= 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, p.id)
			end)
			if ok and has then
				owned[key] = true
			end
		end
	end
	local data = ctx.Progress.dataOf(player)
	if IS_STUDIO and data then
		for key in pairs(Monetization.Passes) do
			if data.owned["pass:" .. key] then
				owned[key] = true
			end
		end
	end
	return owned
end

local function grantProduct(player: Player, data: any, key: string): string
	local p = Monetization.Products[key]
	if p.kind == "boost" then
		ctx.Progress.addBoost(data, p.minutes or 30, Config.FairPlay.boostMult)
		-- Fair Play: everyone else in the server gets a free Renown Shower.
		for _, other in ipairs(Players:GetPlayers()) do
			local od = other ~= player and ctx.Progress.dataOf(other) or nil
			if od and od.boost.untilT <= os.time() then
				ctx.Progress.addBoost(od, Config.FairPlay.showerMinutes, Config.FairPlay.showerMult)
				ctx.toast(other, string.format("✨ Renown Shower from %s! +%d%% Renown for %d min.", player.DisplayName, math.floor(Config.FairPlay.showerMult * 100), Config.FairPlay.showerMinutes), "good")
			end
		end
	else
		for _, id in ipairs(p.grants or {}) do
			data.owned[id] = true
		end
	end
	ctx.Progress.markDirty(player)
	ctx.Progress.sendState(player)
	return "Thanks! " .. p.icon .. " " .. p.name .. " is yours."
end

local function grantPass(player: Player, key: string)
	local r = ctx.Progress.runtime[player]
	if not r then
		return
	end
	r.passes[key] = true
	ctx.toast(player, "Thanks! " .. Monetization.Passes[key].icon .. " " .. Monetization.Passes[key].name .. " is active.", "good")
	ctx.Progress.sendState(player)
end

local function prompt(player: Player, kind: any, key: any): (boolean, string?)
	local data = ctx.Progress.dataOf(player)
	if not data or type(kind) ~= "string" or type(key) ~= "string" then
		return false, nil
	end
	if kind == "pass" then
		local p = Monetization.Passes[key]
		if not p then
			return false, "Not found."
		end
		if ctx.Progress.hasPass(player, key) then
			return false, "You already have this."
		end
		if p.id == 0 then
			if IS_STUDIO then
				data.owned["pass:" .. key] = true
				grantPass(player, key)
				return true, "Studio test: pass granted for free (only in Studio)."
			end
			return false, "Not on sale yet."
		end
		MarketplaceService:PromptGamePassPurchase(player, p.id)
		return true, nil
	end
	local p = Monetization.Products[key]
	if not p then
		return false, "Not found."
	end
	if p.kind == "cosmetic" and p.grants then
		local all = true
		for _, id in ipairs(p.grants) do
			if not data.owned[id] then
				all = false
			end
		end
		if all then
			return false, "You already own this."
		end
	end
	if p.id == 0 then
		if IS_STUDIO then
			return true, "Studio test (free): " .. grantProduct(player, data, key)
		end
		return false, "Not on sale yet."
	end
	MarketplaceService:PromptProductPurchase(player, p.id)
	return true, nil
end

local function processReceipt(info: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = ctx.Data.waitFor(player, 10)
	if not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = profile.data
	local purchaseId = tostring(info.PurchaseId)
	if ReceiptLedger.has(data.receipts, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local key = productById[info.ProductId]
	if not key then
		warn("[PurchaseService] unknown product id " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, msg = pcall(grantProduct, player, data, key)
	if not ok then
		warn("[PurchaseService] grant failed: " .. tostring(msg))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	ReceiptLedger.add(data.receipts, purchaseId, RECEIPT_MEMORY)
	if not ctx.Data.save(profile, false) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	ctx.toast(player, msg, "good")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function PurchaseService.init(c: any)
	ctx = c
	ctx.handle("buy", prompt)
end

function PurchaseService.start()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
		local key = passById[passId]
		if purchased and key then
			grantPass(player, key)
		end
	end)
end

return PurchaseService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="44">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="45">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="46">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterJumpPower">50</float>
      <float name="CharacterWalkSpeed">16</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="47">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="48">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Cutscene</string>
            <string name="Source"><![CDATA[--!strict
--[[
	The pregame show, played locally for each contender:
	  1. The Harvesting (full on your first match, short after that or with the setting):
	     wide shot of the plaza, the Herald at the glass globe, a slip is drawn, your own avatar
	     (a local clone) walks up the aisle, and Rusty Dunmore walks over to meet you on stage.
	  2. Parade, interview and training: v1 stubs (a camera flyby + title cards + your chosen
	     interview line + a cosmetic training score).
	Skippable at any time; skipping just jumps to the launch countdown.
]]
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local Net = require(script.Parent.Net)
local Fx = require(script.Parent.Fx)
local Sfx = require(script.Parent.Sfx)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Names = require(Shared.Names)
local Content = require(Shared.Content)
local T = UI.Theme

local Cutscene = {}
local player = Players.LocalPlayer
local layer: Frame = nil :: any
local caption: TextLabel = nil :: any
local sub: TextLabel = nil :: any
local bars: { Frame } = {}
local seq = 0
local cleanup: { () -> () } = {}
Cutscene.playing = false

local function marks(): Instance?
	local map = workspace:FindFirstChild("Map")
	local lobby = map and map:FindFirstChild("Lobby")
	return lobby and lobby:FindFirstChild("CutsceneMarks")
end

local function markCF(name: string): CFrame?
	local m = marks()
	local p = m and m:FindFirstChild(name)
	return p and (p :: BasePart).CFrame or nil
end

local function camTo(name: string, time: number)
	local cf = markCF(name)
	local cam = workspace.CurrentCamera
	if not cf or not cam then
		return
	end
	if time <= 0 then
		cam.CFrame = cf
	else
		TweenService:Create(cam, TweenInfo.new(time, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { CFrame = cf }):Play()
	end
end

local function say(text: string, small: string?)
	caption.Text = text
	sub.Text = small or ""
end

local function alive(id: number): boolean
	return seq == id and Cutscene.playing
end

local function wait(id: number, s: number): boolean
	task.wait(s)
	return alive(id)
end

local function tweenModel(m: Model, to: CFrame, time: number)
	local v = Instance.new("CFrameValue")
	v.Value = m:GetPivot()
	v.Changed:Connect(function(cf: CFrame)
		if m.Parent then
			m:PivotTo(cf)
		end
	end)
	local tw = TweenService:Create(v, TweenInfo.new(time, Enum.EasingStyle.Linear), { Value = to })
	tw.Completed:Connect(function()
		v:Destroy()
	end)
	tw:Play()
end

-- A local, anchored copy of your avatar for the walk to the stage.
local function cloneMe(at: CFrame): Model?
	local char = player.Character
	if not char then
		return nil
	end
	char.Archivable = true
	local ok, copy = pcall(function()
		return char:Clone()
	end)
	if not ok or not copy then
		return nil
	end
	for _, d in ipairs(copy:GetDescendants()) do
		if d:IsA("BaseScript") or d:IsA("ForceField") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end
	local hum = copy:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	copy.Name = "ReapingDouble"
	copy:PivotTo(at)
	copy.Parent = workspace
	table.insert(cleanup, function()
		copy:Destroy()
	end)
	return copy
end

local function stop()
	Cutscene.playing = false
	seq += 1
	for _, fn in ipairs(cleanup) do
		pcall(fn)
	end
	cleanup = {}
	layer.Visible = false
	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if h then
			cam.CameraSubject = h
		end
	end
end

local function reaping(id: number, d: any, short: boolean)
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	camTo("CamWide", 0)
	say(Names.DRAW, string.format("%s · %s", Names.EVENT, d.reach or ""))
	Sfx.play("bell", 0.8)
	if short then
		camTo("CamStage", 1.2)
		if not wait(id, 1.4) then
			return
		end
		say("Contender for " .. tostring(d.reach) .. ": " .. player.DisplayName, d.partnerName and ("with " .. d.partnerName) or nil)
		wait(id, 1.6)
		return
	end
	if not wait(id, 1.6) then
		return
	end
	camTo("CamGlobe", 1.6)
	say(Names.HERALD .. " reaches into the globe…")
	if not wait(id, 2.0) then
		return
	end
	camTo("CamHerald", 0.8)
	say("“From " .. tostring(d.reach) .. "… " .. player.DisplayName .. "!”")
	Sfx.play("ding")
	if not wait(id, 1.6) then
		return
	end
	-- you walk up the aisle
	local aisle, stage = markCF("AisleMark"), markCF("StageMark")
	local crowd = markCF("CrowdMark")
	local double = crowd and cloneMe(crowd * CFrame.Angles(0, math.pi, 0))
	camTo("CamCrowd", 0.6)
	say("The crowd steps aside.")
	if double and aisle and stage then
		tweenModel(double, CFrame.lookAt(aisle.Position, stage.Position), 1.6)
		task.delay(1.6, function()
			if double.Parent then
				tweenModel(double, CFrame.lookAt(stage.Position, stage.Position + Vector3.new(0, 0, 10)), 1.2)
			end
		end)
	end
	if not wait(id, 1.4) then
		return
	end
	camTo("CamPlayer", 1.2)
	if not wait(id, 1.6) then
		return
	end
	-- Rusty walks over to meet you
	local lobby = workspace:FindFirstChild("Map") and (workspace :: any).Map:FindFirstChild("Lobby")
	local rusty = lobby and lobby:FindFirstChild("Rusty") :: Model?
	local rStart, rMark = markCF("RustyStart"), markCF("RustyMark")
	if rusty and rStart and rMark then
		local home = rusty:GetPivot()
		table.insert(cleanup, function()
			rusty:PivotTo(home)
		end)
		tweenModel(rusty, CFrame.lookAt(rMark.Position, rMark.Position + Vector3.new(1, 0, 0)), 2.2)
	end
	camTo("CamRusty", 1.0)
	say(Names.MENTOR .. " climbs the steps.", "“" .. Content.RUSTY.reaping .. "”")
	if not wait(id, 2.6) then
		return
	end
	camTo("CamPull", 1.6)
	say(Names.CONTENDERS .. " of " .. tostring(d.reach), d.partnerName and ("You and " .. d.partnerName .. ". Stick together.") or "Twenty-four Reaches. Forty-eight contenders. One sunrise.")
	wait(id, 1.8)
end

local function stubs(id: number, d: any)
	-- v1 stubs: parade flyby, interview card, training score
	camTo("CamWide", 1.0)
	say("The " .. Names.CAPITAL .. " Parade", "Coming soon: chariots, coats and capes. (v1 stub)")
	if not wait(id, 1.8) then
		return
	end
	say("Interview with " .. Names.HOST, "“" .. tostring(d.quip) .. "”")
	if not wait(id, 1.8) then
		return
	end
	local score = math.random(6, 11)
	say("Training score: " .. score .. " / 12", Names.MENTOR_SHORT .. " nods. (cosmetic only)")
	Net.act("training", score)
	if not wait(id, 1.4) then
		return
	end
	if d.twist then
		say("Today's twist: " .. d.twist.name, d.twist.text)
		wait(id, 1.8)
	end
end

function Cutscene.play(d: any)
	stop()
	seq += 1
	local id = seq
	Cutscene.playing = true
	layer.Visible = true
	task.spawn(function()
		local short = d.short == true
		reaping(id, d, short)
		if not alive(id) then
			return
		end
		Net.act("seenReaping")
		stubs(id, d)
		if alive(id) then
			stop()
		end
	end)
end

function Cutscene.skip()
	if Cutscene.playing then
		Net.act("seenReaping")
		stop()
		Fx.toast("Skipped. Get ready to launch!", "info")
	end
end

function Cutscene.mount(parent: Frame)
	layer = UI.frame({ Name = "Cutscene", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 30, Parent = parent })
	for i, y in ipairs({ 0, 1 }) do
		bars[i] = UI.frame({ BackgroundColor3 = Color3.new(0, 0, 0), AnchorPoint = Vector2.new(0, y), Position = UDim2.fromScale(0, y), Size = UDim2.new(1, 0, 0.11, 0), ZIndex = 30, Parent = layer })
	end
	caption = UI.label("", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0.86, 0), Size = UDim2.new(0.8, 0, 0, 44), TextSize = 34, TextColor3 = T.gold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, ZIndex = 31, Parent = layer })
	sub = UI.label("", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0.885, 4), Size = UDim2.new(0.8, 0, 0, 26), TextSize = 19, Font = T.body, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.4, ZIndex = 31, Parent = layer })
	UI.button("Skip ▸▸", T.card, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0.11, 10), Size = UDim2.new(0, 110, 0, 38), TextColor3 = T.text, ZIndex = 32, Parent = layer }, Cutscene.skip)
	Net.on("pregame", Cutscene.play)
	Net.on("launch", function(d)
		stop()
		Fx.announce("Stand on your plate!", T.gold, 2)
		Fx.toast(string.format("Launch in %ds. Don't step off early. %s", d.seconds, Content.RUSTY.launch), "info")
	end)
	local _ = Config
end

return Cutscene
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[--!strict
-- Screen effects: toasts, big announcements, pops, arrow tracers, hit flashes, the cannon bell.
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local UI = require(script.Parent.UI)
local Sfx = require(script.Parent.Sfx)
local T = UI.Theme

local Fx = {}
local root: Frame = nil :: any
local toasts: Frame = nil :: any
local banner: TextLabel = nil :: any
local flash: Frame = nil :: any

function Fx.mount(parent: Frame)
	root = parent
	toasts = UI.frame({ Name = "Toasts", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 74), Size = UDim2.new(0, 520, 0, 220), Parent = root })
	UI.list(toasts, nil, 6, Enum.HorizontalAlignment.Center)
	banner = UI.label("", {
		Name = "Announce",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.32),
		Size = UDim2.new(0.9, 0, 0, 70),
		TextSize = 46,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.4,
		TextTransparency = 1,
		TextStrokeColor3 = T.bg,
		ZIndex = 20,
		Parent = root,
	})
	flash = UI.frame({ Name = "HitFlash", BackgroundColor3 = T.red, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 1, Active = false, Parent = root })
end

local KIND_COLOR: { [string]: Color3 } = {
	good = Color3.fromHex("#2E7D4F"),
	bad = Color3.fromHex("#B3262E"),
	info = Color3.fromHex("#2E3449"),
}

function Fx.toast(text: string, kind: string?)
	if not toasts then
		return
	end
	local f = UI.frame({ BackgroundColor3 = KIND_COLOR[kind or "info"] or KIND_COLOR.info, Size = UDim2.new(0, 500, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = toasts })
	UI.corner(f, 10)
	UI.pad(f, 10)
	UI.label(text, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 18, Font = T.body, TextXAlignment = Enum.TextXAlignment.Center, Parent = f })
	Debris:AddItem(f, 4)
	if #toasts:GetChildren() > 5 then
		for _, c in ipairs(toasts:GetChildren()) do
			if c:IsA("Frame") then
				c:Destroy()
				break
			end
		end
	end
end

function Fx.announce(text: string, color: Color3?, hold: number?)
	if not banner then
		return
	end
	banner.Text = text
	banner.TextColor3 = color or T.gold
	banner.TextTransparency = 0
	banner.TextStrokeTransparency = 0.4
	local id = {}
	;(banner :: any):SetAttribute("Seq", tostring(id))
	task.delay(hold or 2.4, function()
		if (banner :: any):GetAttribute("Seq") == tostring(id) then
			TweenService:Create(banner, TweenInfo.new(0.5), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end

function Fx.pop(text: string, color: Color3?, size: number?)
	local l = UI.label(text, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5 + (math.random() - 0.5) * 0.1, 0.45),
		Size = UDim2.new(0, 500, 0, 60),
		TextSize = size or 30,
		TextColor3 = color or T.gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.3,
		ZIndex = 15,
		Parent = root,
	})
	TweenService:Create(l, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = l.Position - UDim2.fromOffset(0, 70), TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(l, 1.2)
end

function Fx.hit()
	flash.BackgroundTransparency = 0.75
	TweenService:Create(flash, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
end

-- A glowing arrow streak from bow to target.
function Fx.tracer(from: Vector3, to: Vector3)
	local d = (to - from).Magnitude
	if d < 1 then
		return
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromHex("#FFE9A8")
	p.Size = Vector3.new(0.15, 0.15, d)
	p.CFrame = CFrame.lookAt(from:Lerp(to, 0.5), to)
	p.Parent = workspace
	TweenService:Create(p, TweenInfo.new(0.3), { Transparency = 1 }):Play()
	Debris:AddItem(p, 0.35)
end

-- The knockout bell: one soft ring per knockout so everyone hears the count drop.
function Fx.bell()
	Sfx.play("bell", 0.9, 0.2)
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">GalleryPanel</string>
            <string name="Source"><![CDATA[--!strict
-- The Viewing Gallery panel: Favor, gift any contender, vote on hazards and on the Encore.
local Players = game:GetService("Players")

local UI = require(script.Parent.UI)
local Net = require(script.Parent.Net)
local Fx = require(script.Parent.Fx)
local Sfx = require(script.Parent.Sfx)
local Hud = require(script.Parent.Hud)
local T = UI.Theme
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Names = require(ReplicatedStorage:WaitForChild("Shared").Names)

local GalleryPanel = {}
local win: Frame = nil :: any
local favor: TextLabel = nil :: any
local list: ScrollingFrame = nil :: any
local gifts: Frame = nil :: any
local voteBox: Frame = nil :: any
local selected: string? = nil
local view: any = nil
local lastBuild = 0

local function rebuild()
	if not view then
		return
	end
	favor.Text = string.format("🪙 %d %s  ·  earn +1 every 5 s while you watch", view.favor, Names.FAVOR)
	UI.clear(list)
	for i, c in ipairs(view.alive) do
		local b = UI.button(string.format("%s%s  (%s)  Pep %d", c.partner and "👥 " or "", c.name, c.reach, math.floor(c.pep)), selected == c.id and T.gold or T.card, { LayoutOrder = i, Size = UDim2.new(1, -8, 0, 34), TextSize = 14, TextColor3 = selected == c.id and T.dark or T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = list }, function()
			selected = c.id
			rebuild()
		end)
		UI.pad(b, 8)
	end
	UI.clear(gifts)
	for i, g in ipairs(view.gifts) do
		local target = nil
		for _, c in ipairs(view.alive) do
			if c.id == selected then
				target = c
			end
		end
		local cost = target and target.partner and g.partnerCost or g.cost
		UI.button(string.format("🪂 %s · %d", g.name, cost), (target and view.favor >= cost) and T.blue or T.card, { LayoutOrder = i, Size = UDim2.new(0, 150, 0, 40), TextSize = 14, TextColor3 = T.text, Parent = gifts }, function()
			if not selected then
				Fx.toast("Pick a contender first.", "info")
				return
			end
			if Net.act("gift", selected, g.id) then
				Sfx.play("whoosh")
			end
		end)
	end
	UI.clear(voteBox)
	local function ballot(kind: string, b: any, labels: { [string]: string })
		local secs = math.max(0, math.ceil(b.ends - workspace:GetServerTimeNow()))
		UI.label((kind == "encore" and "Encore vote: bring one back!" or "Hazard vote") .. string.format(" · %ds", secs), { Size = UDim2.new(1, 0, 0, 22), TextSize = 17, TextColor3 = T.gold, LayoutOrder = 0, Parent = voteBox })
		for i, opt in ipairs(b.options) do
			local id = type(opt) == "table" and opt.id or opt
			local label = labels[id] or (type(opt) == "table" and opt.name) or id
			local n = b.counts[id] or 0
			UI.button(string.format("%s%s  (%d)", b.mine == id and "✔ " or "", label, n), b.mine == id and T.gold or T.card, { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 34), TextSize = 14, TextColor3 = b.mine == id and T.dark or T.text, Parent = voteBox }, function()
				Net.act("vote", kind, id)
			end)
		end
	end
	if view.encore then
		ballot("encore", view.encore, {})
	elseif view.hazard then
		local labels = {}
		for _, card in ipairs(view.hazardCards) do
			labels[card.id] = card.name .. ": " .. card.text
		end
		ballot("hazard", view.hazard, labels)
	else
		UI.label("Next vote soon. Votes pick hazards and bring one contender back.", { Size = UDim2.new(1, 0, 0, 40), TextSize = 14, Font = T.body, TextColor3 = T.dim, Parent = voteBox })
	end
end

function GalleryPanel.mount(parent: Frame)
	win = UI.frame({ Name = "Gallery", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 20), Size = UDim2.new(0, 360, 0, 560), Visible = false, BackgroundTransparency = 0.05, Parent = parent })
	UI.corner(win, 14)
	UI.stroke(win, T.blue, 2)
	UI.pad(win, 10)
	UI.label("🎟️ " .. Names.GALLERY, { Size = UDim2.new(1, 0, 0, 28), TextSize = 22, TextColor3 = T.gold, Parent = win })
	favor = UI.label("", { Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, 0, 0, 20), TextSize = 14, Font = T.body, TextColor3 = T.dim, Parent = win })
	list = UI.new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 52), Size = UDim2.new(1, 0, 0, 180), AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 5, Parent = win })
	UI.list(list, nil, 4)
	gifts = UI.frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 238), Size = UDim2.new(1, 0, 0, 134), Parent = win })
	UI.new("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 40), CellPadding = UDim2.new(0, 6, 0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = gifts })
	voteBox = UI.frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 378), Size = UDim2.new(1, 0, 0, 130), Parent = win })
	UI.list(voteBox, nil, 4)
	UI.button("Back to the lobby", T.card, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(1, 0, 0, 36), TextColor3 = T.text, Parent = win }, function()
		Net.act("leaveGallery")
	end)
	Net.on("gallery", function(v)
		view = v
		win.Visible = true
		Hud.mode = "gallery"
		local now = os.clock()
		if now - lastBuild > 0.4 then
			lastBuild = now
			rebuild()
		end
	end)
	Net.on("galleryClose", function()
		win.Visible = false
		view = nil
		Hud.mode = "lobby"
	end)
	Net.on("vote", function(d)
		Sfx.play("ding")
		Fx.toast(d.kind == "encore" and "Encore vote is open in " .. Names.GALLERY .. "!" or "Hazard vote is open in " .. Names.GALLERY .. "!", "info")
	end)
	Net.on("giftFeed", function(d)
		if win.Visible then
			Fx.toast(string.format("🪂 %s sent %s to %s", d.from, d.item, d.to), "info")
		end
	end)
	local _ = Players
end

return GalleryPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- The always-on HUD: progress bar, lobby queue card, arena vitals, hotbar and menu buttons.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local Net = require(script.Parent.Net)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Names = require(Shared.Names)
local T = UI.Theme

local Hud = {}
local panels: any = nil
local refs: { [string]: any } = {}
Hud.lobby = nil :: any
Hud.match = nil :: any
Hud.inv = nil :: any
Hud.pep = Config.PEP_MAX
Hud.mode = "lobby" -- "lobby" | "pregame" | "arena" | "gallery"

local function secs(n: number?): string
	n = math.max(0, math.floor(n or 0))
	return string.format("%d:%02d", (n :: number) // 60, (n :: number) % 60)
end

local function topBar(parent: Frame)
	local bar = UI.frame({ Name = "TopBar", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.new(0, 560, 0, 56), BackgroundTransparency = 0.1, Parent = parent })
	UI.corner(bar, 14)
	UI.stroke(bar, T.gold, 1.5)
	UI.pad(bar, 8)
	refs.level = UI.label("Lv 1", { Size = UDim2.new(0, 120, 0, 22), TextSize = 20, TextColor3 = T.gold, Parent = bar })
	refs.rank = UI.label("Reaped", { Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(0, 120, 0, 18), TextSize = 14, TextColor3 = T.dim, Font = T.body, Parent = bar })
	local back, fill = UI.bar(bar, T.gold, { Position = UDim2.new(0, 124, 0, 6), Size = UDim2.new(1, -300, 0, 12) })
	refs.xpFill = fill
	refs.xp = UI.label("", { Position = UDim2.new(0, 124, 0, 20), Size = UDim2.new(1, -300, 0, 18), TextSize = 14, Font = T.body, TextColor3 = T.dim, Parent = bar })
	local _ = back
	refs.streak = UI.label("🔥 0", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 170, 0, 22), TextSize = 18, TextXAlignment = Enum.TextXAlignment.Right, Parent = bar })
	refs.play = UI.label("", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 22), Size = UDim2.new(0, 170, 0, 18), TextSize = 14, Font = T.body, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Right, Parent = bar })
end

local MENU = {
	{ id = "season", text = "🌅 " .. Names.TRACK },
	{ id = "challenges", text = "📜 Challenges" },
	{ id = "reach", text = "🏳️ My Reach" },
	{ id = "tokens", text = "🪙 " .. Names.TOKENS },
	{ id = "shop", text = "🛍️ Shop" },
	{ id = "profile", text = "👤 Profile" },
	{ id = "settings", text = "⚙️ Settings" },
}

local function menu(parent: Frame)
	local col = UI.frame({ Name = "Menu", BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0.5, -170), Size = UDim2.new(0, 190, 0, 340), Parent = parent })
	UI.list(col, nil, 6)
	refs.badges = {}
	for i, m in ipairs(MENU) do
		local b = UI.button(m.text, T.card, { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 40), TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = col }, function()
			panels.open(m.id)
		end)
		UI.pad(b, 10)
		local badge = UI.label("", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 4, 0.5, 0), Size = UDim2.new(0, 26, 0, 26), BackgroundColor3 = T.red, BackgroundTransparency = 0, TextXAlignment = Enum.TextXAlignment.Center, TextSize = 14, Visible = false, Parent = b })
		UI.corner(badge, 13)
		refs.badges[m.id] = badge
	end
	refs.menu = col
end

local function lobbyCard(parent: Frame)
	local card = UI.frame({ Name = "LobbyCard", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.new(0, 520, 0, 150), BackgroundTransparency = 0.05, Parent = parent })
	UI.corner(card, 16)
	UI.stroke(card, T.gold, 1.5)
	UI.pad(card, 12)
	refs.lobbyTitle = UI.label(Names.EVENT, { Size = UDim2.new(1, 0, 0, 26), TextSize = 22, TextColor3 = T.gold, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	refs.lobbyStatus = UI.label("", { Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, 0, 0, 22), TextSize = 17, Font = T.body, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	refs.lobbyRule = UI.label("", { Position = UDim2.new(0, 0, 0, 50), Size = UDim2.new(1, 0, 0, 20), TextSize = 14, Font = T.body, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	local row = UI.frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -48), Size = UDim2.new(1, 0, 0, 46), Parent = card })
	UI.list(row, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
	refs.queueBtn = UI.button("Enter the " .. Names.DRAW, T.gold, { LayoutOrder = 1, Size = UDim2.new(0, 230, 0, 44), TextSize = 20, Parent = row }, function()
		if Hud.lobby and Hud.lobby.inQueue then
			Net.act("leave")
		else
			Net.act("queue")
		end
	end)
	refs.partnerBtn = UI.button("👥 Partner", T.blue, { LayoutOrder = 2, Size = UDim2.new(0, 120, 0, 44), Parent = row }, function()
		panels.open("partner")
	end)
	refs.autoBtn = UI.button("Auto: ON", T.card, { LayoutOrder = 3, Size = UDim2.new(0, 110, 0, 44), TextColor3 = T.text, Parent = row }, function()
		local s = Net.state and Net.state.settings
		Net.act("setting", "autoQueue", not (s and s.autoQueue))
	end)
	refs.lobbyCard = card
end

local function arenaHud(parent: Frame)
	local box = UI.frame({ Name = "Vitals", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, -14), Size = UDim2.new(0, 300, 0, 74), BackgroundTransparency = 0.1, Parent = parent })
	UI.corner(box, 12)
	UI.pad(box, 10)
	refs.pepLabel = UI.label("Pep 100", { Size = UDim2.new(1, 0, 0, 20), TextSize = 17, Parent = box })
	local _, pepFill = UI.bar(box, Color3.fromHex("#E0B44A"), { Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, 0, 0, 14) })
	refs.pepFill = pepFill
	refs.ammo = UI.label("", { Position = UDim2.new(0, 0, 0, 40), Size = UDim2.new(1, 0, 0, 18), TextSize = 14, Font = T.body, TextColor3 = T.dim, Parent = box })
	refs.vitals = box

	local info = UI.frame({ Name = "MatchInfo", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 74), Size = UDim2.new(0, 250, 0, 106), BackgroundTransparency = 0.1, Parent = parent })
	UI.corner(info, 12)
	UI.pad(info, 10)
	refs.alive = UI.label("48 left", { Size = UDim2.new(1, 0, 0, 30), TextSize = 28, TextColor3 = T.gold, Parent = info })
	refs.veil = UI.label("", { Position = UDim2.new(0, 0, 0, 34), Size = UDim2.new(1, 0, 0, 20), TextSize = 15, Font = T.body, TextColor3 = T.veil, Parent = info })
	refs.twist = UI.label("", { Position = UDim2.new(0, 0, 0, 56), Size = UDim2.new(1, 0, 0, 30), TextSize = 13, Font = T.body, TextColor3 = T.dim, Parent = info })
	refs.info = info

	local bar = UI.frame({ Name = "Hotbar", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.new(0, 6 * 70, 0, 66), BackgroundTransparency = 1, Parent = parent })
	UI.list(bar, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center)
	refs.slots = {}
	for i = 1, 6 do
		local s = UI.button("", T.card, { LayoutOrder = i, Size = UDim2.new(0, 64, 0, 64), TextSize = 13, TextColor3 = T.text, TextWrapped = true, Parent = bar }, function()
			Net.act("equipSlot", i)
		end)
		UI.label(tostring(i), { Position = UDim2.new(0, 4, 0, 2), Size = UDim2.new(0, 14, 0, 14), TextSize = 12, TextColor3 = T.dim, Parent = s })
		refs.slots[i] = s
	end
	refs.hotbar = bar

	-- Veil compass: tells you which way is safe when you're near the edge.
	refs.edge = UI.label("", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 72), Size = UDim2.new(0, 520, 0, 26), TextSize = 20, TextColor3 = T.veil, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.4, Parent = parent })
end

function Hud.mount(parent: Frame, p: any)
	panels = p
	topBar(parent)
	menu(parent)
	lobbyCard(parent)
	arenaHud(parent)
	Net.on("lobby", function(d)
		Hud.lobby = d
	end)
	Net.on("match", function(d)
		Hud.match = d
	end)
	Net.on("inv", function(d)
		Hud.inv = d
		Hud.pep = d.pep
	end)
	Net.on("pep", function(d)
		Hud.pep = d.pep
	end)
	Net.on("arena", function()
		Hud.mode = "arena"
	end)
end

local ITEM_ICON: { [string]: string } = { bow = "🏹", spear = "🔱", knife = "🔪", arrows = "➶", backpack = "🎒", trailmix = "🥜", apple = "🍎", canteen = "🧴", bandage = "🩹", sweettea = "🍵" }

function Hud.update()
	local s = Net.state
	if s then
		refs.level.Text = string.format("Lv %d", s.level)
		refs.rank.Text = s.prestige > 0 and string.format("%s ★%d", s.rank, s.prestige) or s.rank
		refs.xpFill.Size = UDim2.new(math.clamp(s.xp / math.max(1, s.xpNext), 0, 1), 0, 1, 0)
		refs.xp.Text = string.format("%d / %d %s", s.xp, s.xpNext, Names.XP)
		refs.streak.Text = string.format("🔥 %d-day streak", s.streak)
		refs.play.Text = s.play > 0 and string.format("Match streak ×%.1f %s", s.playMult, Names.XP) or "Play again soon for a streak bonus"
		refs.autoBtn.Text = (s.settings and s.settings.autoQueue) and "Auto: ON" or "Auto: OFF"
		local openChallenges = 0
		for _, c in ipairs(s.daily) do
			if not c.done then
				openChallenges += 1
			end
		end
		local seasonBadge = s.season and s.season.unclaimed or 0
		refs.badges.season.Visible = seasonBadge > 0
		refs.badges.season.Text = tostring(seasonBadge)
		refs.badges.challenges.Visible = openChallenges > 0
		refs.badges.challenges.Text = tostring(openChallenges)
	end
	local inArena = Hud.mode == "arena"
	refs.vitals.Visible = inArena
	refs.hotbar.Visible = inArena
	refs.info.Visible = inArena or Hud.mode == "gallery"
	refs.menu.Visible = Hud.mode == "lobby"
	refs.lobbyCard.Visible = Hud.mode == "lobby"
	refs.edge.Visible = inArena
	local l = Hud.lobby
	if l then
		if l.state == "Arena" or l.state == "Pregame" or l.state == "Launch" then
			refs.lobbyStatus.Text = string.format("A %s is live (%s left). %s", Names.EVENT_SHORT, tostring(l.alive or "?"), l.inQueue and "You're in the next one." or "Queue for the next one!")
		elseif l.inQueue then
			refs.lobbyStatus.Text = string.format("In the %s: %d player%s. Stand-Ins fill to %d. Starts in %ds", Names.DRAW, l.queued, l.queued == 1 and "" or "s", l.size, math.ceil(l.seconds or 0))
		else
			refs.lobbyStatus.Text = string.format("%d in the %s. Step on the gold pad or press the button.", l.queued, Names.DRAW)
		end
		refs.queueBtn.Text = l.inQueue and "Leave the " .. Names.DRAW or "Enter the " .. Names.DRAW
		refs.queueBtn.BackgroundColor3 = l.inQueue and T.red or T.gold
		refs.queueBtn.TextColor3 = l.inQueue and Color3.new(1, 1, 1) or T.dark
		refs.partnerBtn.Text = l.partner and ("👥 " .. l.partner) or (l.invite and "👥 Invite!" or "👥 Partner")
		refs.lobbyRule.Text = l.weekly and ("This week: " .. l.weekly.name .. " · " .. l.weekly.text) or ""
	end
	local m = Hud.match
	if m and (inArena or Hud.mode == "gallery") then
		refs.alive.Text = string.format("%d left", m.alive)
		if m.shrinking then
			refs.veil.Text = string.format("%s is closing!", Names.VEIL)
		elseif m.nextIn then
			refs.veil.Text = string.format("%s moves in %s", Names.VEIL, secs(m.nextIn))
		else
			refs.veil.Text = string.format("%s is at its smallest", Names.VEIL)
		end
		refs.twist.Text = m.twist and ("Twist: " .. m.twist) or ""
		local char = game:GetService("Players").LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp and inArena then
			local flat = Vector3.new(hrp.Position.X, 0, hrp.Position.Z)
			local d = flat.Magnitude
			if d > m.radius then
				refs.edge.Text = "⚠ Outside " .. Names.VEIL .. "! Head toward " .. Names.HUB .. "."
			elseif m.radius - d < 60 then
				refs.edge.Text = "Near " .. Names.VEIL .. " edge"
			else
				refs.edge.Text = ""
			end
		end
	end
	if inArena then
		local pep = Hud.pep
		refs.pepLabel.Text = string.format("Pep %d", math.floor(pep))
		refs.pepFill.Size = UDim2.new(math.clamp(pep / Config.PEP_MAX, 0, 1), 0, 1, 0)
		refs.pepFill.BackgroundColor3 = pep < 30 and T.red or Color3.fromHex("#E0B44A")
		local inv = Hud.inv
		for i = 1, 6 do
			local slot = refs.slots[i]
			local item = inv and inv.inv[i]
			local locked = inv == nil or i > inv.slots
			slot.Text = item and ((ITEM_ICON[item] or "•") .. "\n" .. ((Config.Items[item] and Config.Items[item].name) or item)) or (locked and "🔒" or "")
			slot.BackgroundColor3 = (inv and inv.equipped == i) and T.cardHi or T.card
			local stroke = slot:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = (inv and inv.equipped == i) and T.gold or Color3.fromHex("#0E1018")
			end
		end
		refs.ammo.Text = inv and string.format("Arrows %d · Bag %d/%d · Click to use · Shift to sprint", inv.ammo, #inv.inv, inv.slots) or ""
	end
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="53">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Client entry: builds the UI in code, wires server pushes, and handles arena input
-- (click to use the held item, 1–6 to pick a slot, Shift to sprint).
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local Net = require(script.Parent.Net)
local Fx = require(script.Parent.Fx)
local Sfx = require(script.Parent.Sfx)
local Hud = require(script.Parent.Hud)
local Panels = require(script.Parent.Panels)
local Cutscene = require(script.Parent.Cutscene)
local GalleryPanel = require(script.Parent.GalleryPanel)
local Results = require(script.Parent.Results)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Names = require(Shared.Names)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local screen = UI.new("ScreenGui", { Name = "Daybreak", ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = playerGui })
-- Scale everything down on phones; the scaled root is sized 1/scale so edge-anchored pieces stay on the edges.
local root = UI.new("Frame", { Name = "Root", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = screen })
local scale = UI.new("UIScale", { Parent = root })
local function rescale()
	local cam = workspace.CurrentCamera
	local v = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local s = math.clamp(math.min(v.X / 1280, v.Y / 760), 0.55, 1)
	scale.Scale = s
	root.Size = UDim2.fromScale(1 / s, 1 / s)
end
rescale()
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

Sfx.mount()
UI.onClick = function()
	Sfx.play("click", nil, 0.05)
end
Fx.mount(root)
Panels.mount(root)
Hud.mount(root, Panels)
GalleryPanel.mount(root)
Results.mount(root)
Cutscene.mount(root)
Net.notify = Fx.toast

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

Net.on("toast", function(p)
	Fx.toast(p.text, p.kind)
end)
Net.on("arena", function()
	Hud.mode = "arena"
	Fx.announce("GO!", UI.Theme.gold, 1.6)
	Sfx.play("bell", 1.1)
end)
Net.on("matchStart", function(d)
	Fx.toast(string.format("%s begins: %d players + %d %ss.", Names.EVENT_SHORT, d.humans, d.bots, Names.BOT_TAG), "info")
end)
Net.on("hazard", function(d)
	Sfx.play("hiss", nil, 1)
	Fx.announce(d.name, UI.Theme.red, 2.4)
	Fx.toast(d.text, "bad")
end)
Net.on("tracer", function(d)
	Fx.tracer(d.from, d.to)
end)
Net.on("hitmark", function(d)
	Sfx.play("swat", 1.1, 0.05)
	Fx.pop("-" .. tostring(math.floor(d.amount)), UI.Theme.gold, 22)
end)
Net.on("pep", function(d)
	if d.from ~= "snack" and d.from ~= "gift" then
		Fx.hit()
	end
end)
Net.on("loot", function(d)
	Sfx.play("pop", nil, 0.05)
	Fx.toast("Found: " .. d.name, "good")
end)
Net.on("token", function(d)
	Sfx.play("coins")
	Fx.pop((d.new and "New token! " or "Token: ") .. d.name, UI.Theme.gold, 28)
end)
Net.on("gift", function(d)
	Sfx.play("ding")
	Fx.announce("🪂 Gift from " .. d.from .. "!", UI.Theme.blue, 2.4)
	if d.note then
		Fx.toast("“" .. d.note .. "”", "good")
	end
end)

-- ===== arena input =====
local stamina = Config.STAMINA_MAX
local sprinting = false

local function arena(): boolean
	return Hud.mode == "arena" and not Cutscene.playing
end

UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if arena() and not Panels.isOpen() then
			local mouse = player:GetMouse()
			Net.act("use", mouse.Hit.Position)
		end
	elseif input.KeyCode == Enum.KeyCode.LeftShift then
		sprinting = true
	elseif input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
		Panels.close()
		Cutscene.skip()
	else
		local n = input.KeyCode.Value - Enum.KeyCode.One.Value + 1
		if arena() and n >= 1 and n <= 6 then
			Net.act("equipSlot", n)
		end
	end
end)
UserInputService.InputEnded:Connect(function(input: InputObject)
	if input.KeyCode == Enum.KeyCode.LeftShift then
		sprinting = false
	end
end)

RunService.Heartbeat:Connect(function(dt: number)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or not char then
		return
	end
	local mult = (char:GetAttribute("SpeedMult") or 1) :: number
	local moving = hum.MoveDirection.Magnitude > 0.1
	if arena() and sprinting and moving and stamina > 0 then
		stamina = math.max(0, stamina - Config.STAMINA_DRAIN * dt)
		hum.WalkSpeed = Config.SPRINT_SPEED * mult
	else
		stamina = math.min(Config.STAMINA_MAX, stamina + Config.STAMINA_REGEN * dt)
		hum.WalkSpeed = Config.WALK_SPEED * mult
	end
end)

task.spawn(function()
	while true do
		task.wait(0.1)
		local ok, err = pcall(function(): any
			Hud.update()
			if Net.state and Net.state.settings then
				local want = Net.state.settings.sfx ~= false
				if want ~= Sfx.isEnabled() then
					Sfx.setEnabled(want)
				end
			end
			return nil
		end)
		if not ok then
			warn("[Hud] " .. tostring(err))
		end
	end
end)

task.delay(2, function()
	if not Net.state then
		Net.act("refresh")
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--!strict
-- Client networking: one RemoteFunction for requests, one RemoteEvent for server pushes.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Action = Remotes:WaitForChild("Action") :: RemoteFunction
local Push = Remotes:WaitForChild("Push") :: RemoteEvent

local Net = {}
Net.state = nil :: any
Net.changed = Instance.new("BindableEvent")
Net.notify = function(_text: string, _kind: string?) end
local handlers: { [string]: { (any) -> () } } = {}

function Net.on(kind: string, fn: (any) -> ())
	handlers[kind] = handlers[kind] or {}
	table.insert(handlers[kind], fn)
end

-- Ask the server to do something. Shows the server's message as a toast.
function Net.act(action: string, a: any?, b: any?, c: any?): (boolean, string?)
	local ok, res = pcall(function()
		return Action:InvokeServer(action, a, b, c)
	end)
	if not ok or type(res) ~= "table" then
		Net.notify("Connection hiccup. Try again!", "bad")
		return false, nil
	end
	if res.msg then
		Net.notify(res.msg, res.ok and "good" or "info")
	end
	return res.ok == true, res.msg
end

Push.OnClientEvent:Connect(function(kind: string, payload: any)
	if kind == "state" then
		Net.state = payload
		Net.changed:Fire(payload)
	end
	local list = handlers[kind]
	if list then
		for _, fn in ipairs(list) do
			task.spawn(fn, payload)
		end
	end
end)

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Panels</string>
            <string name="Source"><![CDATA[--!strict
-- Lobby menus: Season Track, Challenges, My Reach, Tokens, Shop, Profile, Settings, Partner.
-- One modal window; each tab rebuilds its content from the latest state snapshot.
-- Shop copy stays calm: "Buy for R$ X", no timers, no "last chance".
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local Net = require(script.Parent.Net)
local Hud = require(script.Parent.Hud)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Names = require(Shared.Names)
local Content = require(Shared.Content)
local T = UI.Theme

local Panels = {}
local win: Frame = nil :: any
local title: TextLabel = nil :: any
local body: ScrollingFrame = nil :: any
local current: string? = nil

local function row(h: number?, order: number?): Frame
	local f = UI.frame({ BackgroundColor3 = T.card, Size = UDim2.new(1, -8, 0, h or 54), LayoutOrder = order or 0, Parent = body })
	UI.corner(f, 10)
	UI.pad(f, 8)
	return f
end

local function heading(text: string, order: number)
	UI.label(text, { Size = UDim2.new(1, -8, 0, 26), TextSize = 20, TextColor3 = T.gold, LayoutOrder = order, Parent = body })
end

local function note(text: string, order: number)
	UI.label(text, { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 15, Font = T.body, TextColor3 = T.dim, LayoutOrder = order, Parent = body })
end

local builders: { [string]: (any) -> () } = {}

builders.season = function(s: any)
	local se = s.season
	title.Text = "🌅 " .. Names.TRACK .. " · " .. se.name
	note(string.format("Tier %d of %d. %d %s, %d per tier. Earn %s from every match and every challenge. Tiers are never sold.", se.tier, #se.tiers, se.stars, Names.STARS, se.perTier, Names.STARS), 0)
	for i, tier in ipairs(se.tiers) do
		local f = row(58, i)
		local reached = i <= se.tier
		UI.label(string.format("Tier %d", i), { Size = UDim2.new(0, 70, 1, 0), TextSize = 18, TextColor3 = reached and T.gold or T.dim, Parent = f })
		UI.label("Free: " .. tier.free, { Position = UDim2.new(0, 76, 0, 0), Size = UDim2.new(0.5, -110, 1, 0), TextSize = 15, Font = T.body, Parent = f })
		UI.label("Premium: " .. tier.premium, { Position = UDim2.new(0.5, -30, 0, 0), Size = UDim2.new(0.5, -150, 1, 0), TextSize = 15, Font = T.body, TextColor3 = se.premium and T.text or T.dim, Parent = f })
		local freeDone = se.claimedFree[tostring(i)] or se.claimedFree[i]
		local premDone = se.claimedPremium[tostring(i)] or se.claimedPremium[i]
		if reached and not freeDone then
			UI.button("Claim", T.gold, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -86, 0.5, 0), Size = UDim2.new(0, 76, 0, 34), TextSize = 15, Parent = f }, function()
				Net.act("claimTier", i, "free")
			end)
		end
		if reached and se.premium and not premDone then
			UI.button("Claim ✦", T.blue, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 80, 0, 34), TextSize = 15, Parent = f }, function()
				Net.act("claimTier", i, "premium")
			end)
		end
	end
	if not se.premium then
		note("The Premium lane is an optional cosmetic pass. Find it in the Shop if you want it.", 999)
	end
end

local function challengeList(list: { any }, order: number)
	for i, c in ipairs(list) do
		local f = row(50, order + i)
		UI.label((c.done and "✅ " or "◻️ ") .. c.text, { Size = UDim2.new(1, -170, 1, 0), TextSize = 16, Font = T.body, Parent = f })
		UI.label(string.format("%d/%d · +%d %s · +%d ★", math.min(c.progress, c.goal), c.goal, c.xp, Names.XP, c.stars), { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 170, 1, 0), TextSize = 14, Font = T.body, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Right, Parent = f })
	end
end

builders.challenges = function(s: any)
	title.Text = "📜 Challenges"
	heading("Today", 0)
	challengeList(s.daily, 0)
	note(string.format("New daily challenges in %dh %dm. Rewards are added automatically when you finish.", s.dailyResetIn // 3600, (s.dailyResetIn % 3600) // 60), 50)
	heading("This week", 100)
	challengeList(s.weekly, 100)
	heading("Weekly " .. Names.EVENT_SHORT .. " rule", 200)
	note(s.weeklyRule.name .. ": " .. s.weeklyRule.text, 201)
end

builders.reach = function(s: any)
	title.Text = "🏳️ My " .. Names.REGION
	note(string.format("Pick a home %s. Every match you play earns it points on the weekly board. The top 3 %s each week give all their players a banner. You can switch once a week.", Names.REGION, Names.REGIONS), 0)
	heading("This week's board", 1)
	for i, r in ipairs(s.reachTop) do
		if i > 8 then
			break
		end
		local f = row(36, 1 + i)
		UI.label(string.format("#%d  %s", i, r.reach), { Size = UDim2.new(0.7, 0, 1, 0), TextSize = 16, TextColor3 = r.reach == s.reach and T.gold or T.text, Parent = f })
		UI.label(tostring(r.points), { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0.3, 0, 1, 0), TextSize = 16, TextXAlignment = Enum.TextXAlignment.Right, Parent = f })
	end
	heading(s.canChangeReach and "Choose your " .. Names.REGION or ("Home: " .. (s.reach ~= "" and s.reach or "none")), 50)
	if s.canChangeReach or s.reach == "" then
		local grid = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 51, Parent = body })
		UI.new("UIGridLayout", { CellSize = UDim2.new(0, 150, 0, 36), CellPadding = UDim2.new(0, 6, 0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
		for i, name in ipairs(Names.REACH_LIST) do
			UI.button(name, name == s.reach and T.gold or T.card, { LayoutOrder = i, TextSize = 14, TextColor3 = name == s.reach and T.dark or T.text, Parent = grid }, function()
				Net.act("setReach", name)
			end)
		end
	end
end

builders.tokens = function(s: any)
	title.Text = "🪙 " .. Names.TOKENS
	note(string.format("%d of %d found. Tokens appear in the arena each match. Each one you find stays in your book forever.", s.tokens, s.tokenTotal), 0)
	local grid = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = body })
	UI.new("UIGridLayout", { CellSize = UDim2.new(0, 150, 0, 60), CellPadding = UDim2.new(0, 6, 0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	for i, t in ipairs(Content.TOKENS) do
		local have = s.tokenBook[t.id] ~= nil
		local f = UI.frame({ BackgroundColor3 = have and T.cardHi or T.card, LayoutOrder = i, Parent = grid })
		UI.corner(f, 10)
		UI.pad(f, 6)
		UI.label(have and t.name or "???", { Size = UDim2.new(1, 0, 0, 22), TextSize = 15, TextColor3 = have and T.gold or T.dim, Parent = f })
		UI.label("Found in: " .. t.zone, { Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, 0, 0, 18), TextSize = 12, Font = T.body, TextColor3 = T.dim, Parent = f })
	end
end

builders.shop = function(s: any)
	title.Text = "🛍️ Shop"
	note("Everything here is cosmetic or a convenience. Nothing is random, and Robux never buys tiers, Stars, or Favor.", 0)
	local shop = s.shop
	local order = 1
	heading("Passes", order)
	for key, p in pairs(shop.catalog.passes) do
		order += 1
		local f = row(70, order)
		UI.label(p.icon .. " " .. p.name, { Size = UDim2.new(1, -150, 0, 22), TextSize = 17, Parent = f })
		UI.label(p.desc, { Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, -150, 0, 32), TextSize = 13, Font = T.body, TextColor3 = T.dim, Parent = f })
		local owned = s.passes[key]
		local avail = shop.passes[key]
		UI.button(owned and "Owned" or (avail and ("Buy for R$ " .. p.price) or "Not on sale yet"), owned and T.green or (avail and T.gold or T.card), { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 140, 0, 38), TextSize = 15, Parent = f }, function()
			if not owned and avail then
				Net.act("buy", "pass", key)
			end
		end)
	end
	order += 1
	heading("Items", order)
	for key, p in pairs(shop.catalog.products) do
		order += 1
		local f = row(70, order)
		UI.label(p.icon .. " " .. p.name .. "  ·  " .. p.category, { Size = UDim2.new(1, -150, 0, 22), TextSize = 17, Parent = f })
		UI.label(p.desc, { Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, -150, 0, 32), TextSize = 13, Font = T.body, TextColor3 = T.dim, Parent = f })
		local avail = shop.products[key]
		UI.button(avail and ("Buy for R$ " .. p.price) or "Not on sale yet", avail and T.gold or T.card, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 140, 0, 38), TextSize = 15, Parent = f }, function()
			if avail then
				Net.act("buy", "product", key)
			end
		end)
	end
	if shop.studio then
		note("Studio test mode: items with ID 0 are granted free here so you can try them. They're hidden in the live game until real IDs are set.", order + 1)
	end
end

builders.profile = function(s: any)
	title.Text = "👤 " .. Players.LocalPlayer.DisplayName
	local st = s.stats
	note(string.format("Level %d · %s%s · Home %s: %s", s.level, s.rank, s.prestige > 0 and (" ★" .. s.prestige) or "", Names.REGION, s.reach ~= "" and s.reach or "none"), 0)
	local lines = {
		{ "Matches", st.matches },
		{ "Wins", st.wins },
		{ "Top 5 finishes", st.top5 },
		{ "Best place", st.bestPlace > 0 and ("#" .. st.bestPlace) or "-" },
		{ "Knockouts", st.knocks },
		{ "Top 10 finishes", st.top10 },
		{ "Gifts sent", st.gifts },
		{ "Encores", st.encores },
		{ "Best day streak", s.bestStreak },
	}
	for i, l in ipairs(lines) do
		local f = row(34, i)
		UI.label(l[1], { Size = UDim2.new(0.6, 0, 1, 0), TextSize = 16, Font = T.body, Parent = f })
		UI.label(tostring(l[2]), { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0.4, 0, 1, 0), TextSize = 16, TextXAlignment = Enum.TextXAlignment.Right, Parent = f })
	end
	heading("Knockout fade", 20)
	local grid = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 44), LayoutOrder = 21, Parent = body })
	UI.list(grid, Enum.FillDirection.Horizontal, 6)
	for id, f in pairs(Content.FADES) do
		local owned = id == "fade_gold" or s.owned[id]
		UI.button(f.name, s.equipped.fade == id and T.gold or T.card, { Size = UDim2.new(0, 140, 0, 38), TextSize = 14, TextColor3 = s.equipped.fade == id and T.dark or (owned and T.text or T.dim), Parent = grid }, function()
			Net.act("equip", "fade", id)
		end)
	end
	heading("Interview line", 30)
	for i, q in ipairs(Content.QUIPS) do
		UI.button((s.quip == i and "● " or "○ ") .. q, s.quip == i and T.cardHi or T.card, { LayoutOrder = 30 + i, Size = UDim2.new(1, -8, 0, 34), TextSize = 14, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = body }, function()
			Net.act("quip", i)
		end)
	end
	if s.canPrestige then
		UI.button("Prestige to " .. Names.rank(s.prestige + 1), T.gold, { LayoutOrder = 60, Size = UDim2.new(0, 260, 0, 42), Parent = body }, function()
			Net.act("prestige")
		end)
	end
end

builders.settings = function(s: any)
	title.Text = "⚙️ Settings"
	local opts = {
		{ key = "autoQueue", text = "Auto-queue the next match" },
		{ key = "shortReaping", text = "Short " .. Names.DRAW .. " cutscene" },
		{ key = "sfx", text = "Sound effects" },
	}
	for i, o in ipairs(opts) do
		local on = s.settings[o.key] ~= false
		if o.key == "shortReaping" then
			on = s.settings.shortReaping == true
		end
		local f = row(48, i)
		UI.label(o.text, { Size = UDim2.new(1, -110, 1, 0), TextSize = 17, Font = T.body, Parent = f })
		UI.button(on and "ON" or "OFF", on and T.green or T.card, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 90, 0, 34), TextColor3 = T.text, Parent = f }, function()
			Net.act("setting", o.key, not on)
		end)
	end
end

builders.partner = function(_s: any)
	title.Text = "👥 Partner"
	note("Queue with a partner: you'll share a " .. Names.REGION .. ", start side by side, and gifts to each other cost less. Invite someone; if they invite you back, you're partners.", 0)
	local l = Hud.lobby
	if l and l.partner then
		local f = row(48, 1)
		UI.label("Partnered with " .. l.partner, { Size = UDim2.new(1, -130, 1, 0), TextSize = 17, Parent = f })
		UI.button("Split up", T.red, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 120, 0, 34), Parent = f }, function()
			Net.act("unpartner")
		end)
	end
	local n = 1
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= Players.LocalPlayer then
			n += 1
			local f = row(48, n)
			local invitedMe = l and l.inviteFrom == p.UserId
			UI.label(p.DisplayName .. (invitedMe and "  · invited you!" or ""), { Size = UDim2.new(1, -130, 1, 0), TextSize = 17, Parent = f })
			UI.button(invitedMe and "Accept" or "Invite", invitedMe and T.green or T.blue, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 120, 0, 34), Parent = f }, function()
				Net.act("invite", p.UserId)
			end)
		end
	end
	if n == 1 then
		note("Nobody else is here yet. Invite a friend to the experience!", 2)
	end
end

local ALIAS: { [string]: string } = { seasonboard = "season", challengeboard = "challenges", reachboard = "reach" }

function Panels.refresh()
	if not current or not Net.state then
		return
	end
	UI.clear(body)
	local ok, err = pcall(function(): any
		builders[current :: string](Net.state)
		return nil
	end)
	if not ok then
		warn("[Panels] " .. tostring(err))
	end
end

function Panels.open(id: string)
	id = ALIAS[id] or id
	if not builders[id] then
		return
	end
	current = id
	win.Visible = true
	body.CanvasPosition = Vector2.zero
	Panels.refresh()
end

function Panels.close()
	current = nil
	win.Visible = false
end

function Panels.isOpen(): boolean
	return current ~= nil
end

function Panels.mount(parent: Frame)
	win = UI.frame({ Name = "Panel", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.new(0, 720, 0, 520), Visible = false, ZIndex = 5, Parent = parent })
	UI.corner(win, 16)
	UI.stroke(win, T.gold, 2)
	UI.pad(win, 14)
	title = UI.label("", { Size = UDim2.new(1, -50, 0, 34), TextSize = 26, TextColor3 = T.gold, Parent = win })
	UI.button("✕", T.red, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 38, 0, 38), Parent = win }, Panels.close)
	body = UI.new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 44), Size = UDim2.new(1, 0, 1, -44), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6, ScrollBarImageColor3 = T.gold, Parent = win })
	UI.list(body, nil, 6)
	Net.changed.Event:Connect(Panels.refresh)
	Net.on("lobby", function()
		if current == "partner" then
			Panels.refresh()
		end
	end)
	Net.on("openPanel", function(d)
		if d.kind == "training" then
			return
		end
		Panels.open(d.kind)
	end)
end

return Panels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Results</string>
            <string name="Source"><![CDATA[--!strict
--[[
	After a knockout or a finish:
	  * Kill-cam "How you got tapped": the camera swings from your spot to whoever got you, with
	    their weapon, distance and Pep left.
	  * Near-miss card: what you almost did ("2 more knockouts for a new best") plus your rewards.
	  * Requeue: "Next match in 10s" with your match streak, plus Watch / Lobby buttons.
	Copy is encouraging and factual. No "you'll lose your streak!" style pressure.
]]
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local Net = require(script.Parent.Net)
local Fx = require(script.Parent.Fx)
local Sfx = require(script.Parent.Sfx)
local Hud = require(script.Parent.Hud)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Names = require(Shared.Names)
local Content = require(Shared.Content)
local T = UI.Theme

local Results = {}
local card: Frame = nil :: any
local head: TextLabel = nil :: any
local sub: TextLabel = nil :: any
local lines: Frame = nil :: any
local reward: TextLabel = nil :: any
local countdown: TextLabel = nil :: any
local requeueAt = 0

local function showCard(place: number?, headline: string, nm: { string }, result: any, extra: string?)
	card.Visible = true
	head.Text = place == 1 and ("🌅 " .. Names.CHAMPION .. "!") or string.format("#%d of 48", place or 0)
	sub.Text = headline
	UI.clear(lines)
	for i, l in ipairs(nm) do
		UI.label("• " .. l, { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 22), TextSize = 16, Font = T.body, Parent = lines })
	end
	if extra then
		UI.label(extra, { LayoutOrder = 10, Size = UDim2.new(1, 0, 0, 22), TextSize = 15, Font = T.body, TextColor3 = T.dim, Parent = lines })
	end
	if result then
		local parts = { string.format("+%d %s", result.xp or 0, Names.XP) }
		if (result.stars or 0) > 0 then
			table.insert(parts, string.format("+%d ★", result.stars))
		end
		if (result.playStreak or 0) > 1 then
			table.insert(parts, string.format("match streak %d (×%.1f)", result.playStreak, result.playMult or 1))
		end
		if (result.tiersUp or 0) > 0 then
			table.insert(parts, string.format("%d new %s tier%s!", result.tiersUp, Names.TRACK, result.tiersUp == 1 and "" or "s"))
		end
		reward.Text = table.concat(parts, "  ·  ")
		if result.streakMsg then
			Fx.toast(result.streakMsg, "good")
		end
	end
end

local function killcam(d: any)
	local cam = workspace.CurrentCamera
	if not cam or not d.at then
		return
	end
	local from: Vector3 = d.from or (d.at + Vector3.new(0, 8, 14))
	cam.CameraType = Enum.CameraType.Scriptable
	local mid = d.at:Lerp(from, 0.5) + Vector3.new(0, 10, 0)
	cam.CFrame = CFrame.lookAt(d.at + Vector3.new(6, 6, 6), d.at)
	TweenService:Create(cam, TweenInfo.new(1.4, Enum.EasingStyle.Sine), { CFrame = CFrame.lookAt(mid + (mid - d.at).Unit:Cross(Vector3.yAxis) * 12, from) }):Play()
	if d.byModel and d.byModel:FindFirstChild("HumanoidRootPart") then
		local hl = Instance.new("Highlight")
		hl.FillColor = T.red
		hl.OutlineColor = T.gold
		hl.Parent = d.byModel
		game:GetService("Debris"):AddItem(hl, 3)
	end
	task.delay(3, function()
		cam.CameraType = Enum.CameraType.Custom
	end)
end

function Results.mount(parent: Frame)
	card = UI.frame({ Name = "Results", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55), Size = UDim2.new(0, 520, 0, 300), Visible = false, ZIndex = 8, Parent = parent })
	UI.corner(card, 16)
	UI.stroke(card, T.gold, 2)
	UI.pad(card, 14)
	head = UI.label("", { Size = UDim2.new(1, 0, 0, 40), TextSize = 36, TextColor3 = T.gold, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	sub = UI.label("", { Position = UDim2.new(0, 0, 0, 42), Size = UDim2.new(1, 0, 0, 24), TextSize = 19, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	lines = UI.frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 72), Size = UDim2.new(1, 0, 0, 100), Parent = card })
	UI.list(lines, nil, 2)
	reward = UI.label("", { Position = UDim2.new(0, 0, 0, 176), Size = UDim2.new(1, 0, 0, 24), TextSize = 17, TextColor3 = T.gold, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	countdown = UI.label("", { Position = UDim2.new(0, 0, 0, 204), Size = UDim2.new(1, 0, 0, 22), TextSize = 16, Font = T.body, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	local row = UI.frame({ BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 42), Parent = card })
	UI.list(row, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
	UI.button("Play again", T.gold, { LayoutOrder = 1, Size = UDim2.new(0, 150, 0, 40), Parent = row }, function()
		Net.act("queue")
	end)
	UI.button("Watch", T.blue, { LayoutOrder = 2, Size = UDim2.new(0, 120, 0, 40), Parent = row }, function()
		card.Visible = false
		Net.act("watch")
	end)
	UI.button("Close", T.card, { LayoutOrder = 3, Size = UDim2.new(0, 110, 0, 40), TextColor3 = T.text, Parent = row }, function()
		card.Visible = false
	end)

	Net.on("eliminated", function(d)
		Sfx.play("bell", 0.85)
		Hud.mode = "gallery"
		local how = d.by and string.format("Tapped by %s (%s) with %s%s. They had %d Pep left.", d.by, d.byReach or "?", d.weapon or "a shove", d.dist and string.format(" from %d studs", math.floor(d.dist)) or "", math.floor(d.byPep or 0)) or ("Knocked out by " .. tostring(d.cause))
		Fx.announce("How you got tapped", T.red, 2.6)
		Fx.toast(how, "info")
		killcam(d)
		task.delay(1.6, function()
			showCard(d.place, d.headline, d.lines, d.result, how)
			countdown.Text = d.autoQueue and "You're watching from " .. Names.GALLERY .. ". You'll be in the next match automatically." or "Watch from " .. Names.GALLERY .. " or play again."
		end)
	end)
	Net.on("finished", function(d)
		if d.place == 1 then
			Sfx.play("fanfare")
			Fx.announce("🌅 " .. Names.CHAMPION .. "!", T.gold, 3.5)
			Fx.toast("“" .. Content.RUSTY.win .. "”", "good")
		end
		showCard(d.place, d.headline, d.lines, d.result, nil)
	end)
	Net.on("podium", function(d)
		Hud.mode = "lobby"
		Fx.announce(string.format("%s of %s wins!", d.winner, d.reach), T.gold, 3)
		requeueAt = workspace:GetServerTimeNow() + d.next
	end)
	Net.on("requeue", function(d)
		requeueAt = workspace:GetServerTimeNow() + d.seconds
		Fx.toast(string.format("Next match in %ds. %d queued.", d.seconds, d.queued), "info")
	end)
	Net.on("knocked", function(d)
		Sfx.play("crunch")
		Fx.pop(string.format("Knocked out %s! %d left", d.name, d.left), T.gold, 30)
	end)
	Net.on("feed", function(d)
		Fx.bell()
		if d.encore then
			Fx.toast(string.format("✨ %s is back! %s", d.victim, d.cause), "good")
		end
	end)
	Net.on("levelup", function(d)
		Sfx.play("fanfare")
		Fx.announce(string.format("Level %d!", d.level), T.gold, 2.5)
	end)
	Net.on("challenge", function(d)
		Sfx.play("coins")
		Fx.toast(string.format("📜 Challenge done: %s  +%d %s  +%d ★", d.text, d.xp, Names.XP, d.stars), "good")
	end)
	Net.on("encore", function()
		card.Visible = false
		Hud.mode = "arena"
		Fx.announce("Encore! You're back in!", T.veil, 3)
	end)
	Net.on("matchStart", function()
		card.Visible = false
	end)
	task.spawn(function()
		while true do
			task.wait(0.25)
			if card.Visible and requeueAt > 0 then
				local left = math.ceil(requeueAt - workspace:GetServerTimeNow())
				if left > 0 then
					countdown.Text = string.format("Next match in %ds", left)
				end
			end
		end
	end)
	local _ = Players
end

return Results
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Sfx</string>
            <string name="Source"><![CDATA[--!strict
-- Sound effects: one SoundGroup of short one-shots. Players can turn them off in Settings.
local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SfxIds = require(Shared.SfxIds) :: { [string]: any }

local Sfx = {}
local group: SoundGroup = nil :: any
local base: { [string]: Sound } = {}
local enabled = true
local lastPlayed: { [string]: number } = {}

function Sfx.mount()
	group = Instance.new("SoundGroup")
	group.Name = "DaybreakSfx"
	group.Volume = 0.8
	group.Parent = SoundService
	local list = {}
	for name, def in pairs(SfxIds) do
		local s = Instance.new("Sound")
		s.Name = name
		s.SoundId = "rbxassetid://" .. tostring(def.id)
		s.Volume = def.volume or 0.5
		s.SoundGroup = group
		s.Parent = group
		base[name] = s
		table.insert(list, s)
	end
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync(list)
		end)
	end)
end

function Sfx.setEnabled(on: boolean)
	enabled = on
	if group then
		group.Volume = on and 0.8 or 0
	end
end

function Sfx.isEnabled(): boolean
	return enabled
end

-- Play a one-shot. `minGap` stops spam from rapid repeats.
function Sfx.play(name: string, pitch: number?, minGap: number?)
	local s = base[name]
	if not enabled or not s then
		return
	end
	local now = os.clock()
	if minGap and lastPlayed[name] and now - lastPlayed[name] < minGap then
		return
	end
	lastPlayed[name] = now
	local c = s:Clone()
	c.PlaybackSpeed = pitch or 1
	c.Parent = group
	c:Play()
	local def = SfxIds[name]
	local life = (def and def.stop) or 6
	task.delay(life, function()
		if c.IsPlaying then
			c:Stop()
		end
		c:Destroy()
	end)
end

return Sfx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--!strict
-- Tiny UI kit: everything is built in code, so no uploaded images are needed.
local UI = {}

UI.Theme = {
	-- "Gilded Dusk" palette (see the plan page's Color & Look section): deep slate panels,
	-- warm parchment text, one gold accent and a muted alarm red. Body text stays above 7:1 on
	-- panels and every button label keeps >= 4.5:1 with its button.
	bg = Color3.fromHex("#161924"),
	panel = Color3.fromHex("#23283A"),
	card = Color3.fromHex("#2E3449"),
	cardHi = Color3.fromHex("#3A4160"),
	accent = Color3.fromHex("#D4A72C"), -- sundial gold (dark label #1C1F2B, 8.1:1)
	gold = Color3.fromHex("#D4A72C"),
	green = Color3.fromHex("#2E7D4F"), -- go / ready (white label 5.2:1)
	red = Color3.fromHex("#B3262E"), -- alert (white label 6.6:1)
	blue = Color3.fromHex("#2F6FB3"), -- info / Gallery (white label 5.2:1)
	veil = Color3.fromHex("#5FD3E0"), -- force-field cyan for HUD hints
	text = Color3.fromHex("#F4EFE6"), -- 12.9:1 on panel
	dim = Color3.fromHex("#B9B3A8"), -- 7.2:1 on panel
	dark = Color3.fromHex("#1C1F2B"), -- label color on gold buttons
	font = Enum.Font.FredokaOne,
	body = Enum.Font.GothamMedium,
	bold = Enum.Font.GothamBold,
}
local T = UI.Theme
-- Set by Main.client to give every button a soft click (Sfx). Kept as a hook so UI has no dependencies.
UI.onClick = nil :: (() -> ())?

type Props = { [string]: any }

function UI.new(className: string, props: Props?, children: { Instance }?): any
	local inst = Instance.new(className)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in ipairs(children) do
			c.Parent = inst
		end
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UI.corner(parent: Instance, r: number?): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, r or 12), Parent = parent })
end

function UI.stroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	return UI.new("UIStroke", { Color = color or Color3.fromHex("#0E1018"), Thickness = thickness or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent })
end

function UI.pad(parent: Instance, px: number)
	return UI.new("UIPadding", { PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px), PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), Parent = parent })
end

function UI.list(parent: Instance, dir: Enum.FillDirection?, gap: number?, align: Enum.HorizontalAlignment?): UIListLayout
	return UI.new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		Parent = parent,
	})
end

function UI.frame(props: Props): Frame
	local f = UI.new("Frame", {
		BackgroundColor3 = T.panel,
		BorderSizePixel = 0,
	})
	for k, v in pairs(props) do
		(f :: any)[k] = v
	end
	return f
end

function UI.label(text: string, props: Props?): TextLabel
	local l = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = T.text,
		Font = T.font,
		TextScaled = false,
		TextSize = 18,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 24),
	})
	if props then
		for k, v in pairs(props) do
			(l :: any)[k] = v
		end
	end
	return l
end

function UI.button(text: string, color: Color3?, props: Props?, onClick: (() -> ())?): TextButton
	local b = UI.new("TextButton", {
		Text = text,
		BackgroundColor3 = color or T.accent,
		TextColor3 = (color == T.gold or color == nil) and T.dark or Color3.new(1, 1, 1),
		Font = T.font,
		TextSize = 18,
		AutoButtonColor = true,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 140, 0, 40),
	})
	if props then
		for k, v in pairs(props) do
			(b :: any)[k] = v
		end
	end
	UI.corner(b, 10)
	UI.stroke(b, Color3.fromHex("#0E1018"), 2)
	UI.new("UITextSizeConstraint", { MaxTextSize = b.TextSize, Parent = b })
	if onClick then
		local busy = false
		b.Activated:Connect(function()
			if UI.onClick then
				(UI.onClick :: any)()
			end
			if busy then
				return
			end
			busy = true
			task.spawn(function()
				local ok, err = pcall(function(): any
					(onClick :: any)()
					return nil
				end)
				if not ok then
					warn(err)
				end
				busy = false
			end)
		end)
	end
	return b
end

function UI.bar(parent: Instance, color: Color3, props: Props?): (Frame, Frame)
	local back = UI.frame({ BackgroundColor3 = Color3.fromHex("#0E1018"), Size = UDim2.new(1, 0, 0, 10), Parent = parent })
	if props then
		for k, v in pairs(props) do
			(back :: any)[k] = v
		end
	end
	UI.corner(back, 5)
	local fill = UI.frame({ BackgroundColor3 = color, Size = UDim2.new(0, 0, 1, 0), Parent = back })
	UI.corner(fill, 5)
	return back, fill
end

function UI.fmt(n: number): string
	n = math.floor(n)
	if n >= 1e9 then
		return string.format("%.2fB", n / 1e9)
	elseif n >= 1e6 then
		return string.format("%.2fM", n / 1e6)
	elseif n >= 1e4 then
		return string.format("%.1fK", n / 1e3)
	end
	local s = tostring(n)
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

function UI.clear(parent: Instance)
	for _, c in ipairs(parent:GetChildren()) do
		if not c:IsA("UIListLayout") and not c:IsA("UIGridLayout") and not c:IsA("UIPadding") and not c:IsA("UICorner") and not c:IsA("UIStroke") then
			c:Destroy()
		end
	end
end

return UI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
