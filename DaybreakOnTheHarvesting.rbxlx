      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">DefaultData</string>
          <string name="Source"><![CDATA[--!strict
-- The save file for a new contender. Reconcile fills any missing keys on load, so adding a field
-- here is always safe. Bump VERSION only for migrations.
local Prefs
if script then
	Prefs = require(script.Parent.Prefs)
else
	Prefs = (require :: any)("./Prefs")
end

local DefaultData = {}

DefaultData.VERSION = 1

function DefaultData.new(): any
	return {
		version = DefaultData.VERSION,
		level = 1,
		xp = 0,
		prestige = 0,
		stats = { matches = 0, wins = 0, knocks = 0, top10 = 0, top5 = 0, bestPlace = 0, gifts = 0, encores = 0 },
		streak = { lastDay = -1, count = 0, best = 0, freeMissWeek = -1 },
		play = { count = 0, lastEnd = 0 },
		daily = { key = -1, list = {} },
		weekly = { key = -1, list = {} },
		season = { season = 0, stars = 0, claimedFree = {}, claimedPremium = {} },
		tokens = {}, -- token id -> true (collection book)
		owned = {}, -- cosmetic id -> true
		equipped = {
			fade = "fade_gold",
			banner = "",
			title = "",
			bow = "",
			spear = "",
			knife = "",
			pose = "",
			emote = "",
			wrap = "",
			nametag = "",
			parade = "",
			rusty = "",
		},
		reach = "",
		reachWeek = -1,
		reachPlayedWeek = -1,
		banners = {}, -- "week:reach" -> true
		seenReaping = false,
		boost = { untilT = 0, mult = 0 },
		receipts = {},
		settings = Prefs.defaultSettings(), -- mode: "" = auto (Modes.preferred). viewFirst stays false.
		quip = 1,
		letters = { lastDay = -1, waiting = 0, claimed = 0 }, -- sponsor letters
		favorBank = 0, -- Favor head start from letters, spent on the next Gallery visit
		-- Item Shop
		vouchers = {}, -- price (string) -> count; from receipts whose saved choice was lost
		shopFlags = {}, -- "bundle:starter" -> true (one-per-account bundles)
		spent = 0, -- lifetime Robux spent in this game (shown in Profile)
		buyLog = {}, -- last 20 purchases { t, name, price, gift }
		patronMonth = -1, -- last month the Patron Club monthly perks were granted
		shopSeenWeek = -1, -- last shop week the player opened the shop (for the "new this week" dot)
		-- v4
		mastery = {}, -- "bow:skin_bow_gilded" -> points (Mastery.luau); free progress
		memberMonth = -1, -- last month the Roblox Plus / Premium member gift was granted
		dailyTen = { day = -1, seconds = 0, claimed = false }, -- Daily Ten play bonus
		referral = { by = 0, rewarded = false, brought = 0 }, -- friend invites
		onboarding = { done = {}, finished = false, skipped = false, reopened = false, rewarded = false }, -- first-match checklist (Onboarding.luau)
		comeback = { lastSeenDay = -1, homecoming = 0, catchUpTier = 0, welcomedDay = -1 }, -- Comeback.luau
		festival = {}, -- yearly festival progress (Events.progressFor)
		shared = 0, -- moments shared with the Roblox share sheet
		shopOpenedOnce = false,
		offers = { firstWinShown = false, previewsSeen = 0 }, -- calm offer bookkeeping
	}
end

return DefaultData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Finishers</string>
          <string name="Source"><![CDATA[--!strict
-- Finishers.luau: the animated knockout effect for each fade style. Runs on the server for real
-- knockouts and on the client for the free "see your knockout with this fade" preview and the
-- Locker try-on, so both always look identical. Cosmetic only, about 2.5 seconds.
local TweenService = game:GetService("TweenService")

local Finishers = {}

local function fxPart(name: string, size: Vector3, cf: CFrame, color: Color3, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = size
	p.CFrame = cf
	if shape then
		p.Shape = shape
	end
	p.Parent = workspace
	return p
end

-- Particle settings per finisher style (all cosmetic, ~2.5 s).
local STYLE_PARTICLES = {
	embers = { rate = 0, burst = 60, speed = { 4, 10 }, life = { 1, 1.8 }, size = 0.35, accel = Vector3.new(0, 6, 0) },
	petals = { rate = 0, burst = 50, speed = { 3, 7 }, life = { 1.5, 2.2 }, size = 0.45, accel = Vector3.new(0, -2, 0), rot = true },
	lanterns = { rate = 0, burst = 14, speed = { 1, 3 }, life = { 2, 2.6 }, size = 0.8, accel = Vector3.new(0, 4, 0) },
	ash = { rate = 0, burst = 70, speed = { 1, 4 }, life = { 1.5, 2.5 }, size = 0.3, accel = Vector3.new(0, 1, 0) },
	stars = { rate = 0, burst = 40, speed = { 6, 14 }, life = { 0.8, 1.4 }, size = 0.5, accel = Vector3.new(0, -8, 0) },
	comet = { rate = 0, burst = 30, speed = { 2, 5 }, life = { 0.8, 1.2 }, size = 0.6, accel = Vector3.new(0, 30, 0) },
	shimmer = { rate = 0, burst = 40, speed = { 0.5, 2 }, life = { 1, 1.6 }, size = 0.25, accel = Vector3.new(0, 2, 0) },
}

-- The animated finishing effect for a fade style at a position.
function Finishers.play(style: string, pos: Vector3, color: Color3)
	local anchor = fxPart("FadeFx", Vector3.new(0.2, 0.2, 0.2), CFrame.new(pos), color)
	anchor.Transparency = 1
	local ps = STYLE_PARTICLES[style]
	if ps then
		local e = Instance.new("ParticleEmitter")
		e.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
		e.LightEmission = 1
		e.Rate = 0
		e.Speed = NumberRange.new(ps.speed[1], ps.speed[2])
		e.Lifetime = NumberRange.new(ps.life[1], ps.life[2])
		e.Size = NumberSequence.new(ps.size, 0)
		e.Acceleration = ps.accel
		e.SpreadAngle = Vector2.new(180, 180)
		if ps.rot then
			e.RotSpeed = NumberRange.new(-180, 180)
		end
		e.Parent = anchor
		e:Emit(ps.burst)
	end
	if style == "column" or style == "comet" or style == "lanterns" then
		local beam = fxPart("LightColumn", Vector3.new(2, 3, 3), CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.PartType.Cylinder)
		beam.Transparency = 0.2
		TweenService:Create(beam, TweenInfo.new(2.2), { Size = Vector3.new(120, 1, 1), CFrame = CFrame.new(pos + Vector3.new(0, 60, 0)) * CFrame.Angles(0, 0, math.pi / 2), Transparency = 1 }):Play()
		task.delay(2.4, function()
			beam:Destroy()
		end)
	elseif style == "burst" then
		for i = 0, 2 do
			task.delay(i * 0.25, function()
				local ring = fxPart("SunRing", Vector3.new(0.3, 2, 2), CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.PartType.Cylinder)
				ring.Transparency = 0.3
				TweenService:Create(ring, TweenInfo.new(1.2, Enum.EasingStyle.Quad), { Size = Vector3.new(0.1, 26, 26), Transparency = 1 }):Play()
				task.delay(1.3, function()
					ring:Destroy()
				end)
			end)
		end
	elseif style == "ribbons" then
		for i = 0, 2 do
			local a = i * math.pi * 2 / 3
			local r = fxPart("AuroraRibbon", Vector3.new(0.3, 6, 1.6), CFrame.new(pos + Vector3.new(math.cos(a) * 2, 0, math.sin(a) * 2)) * CFrame.Angles(0, a, 0), color)
			r.Transparency = 0.25
			TweenService:Create(r, TweenInfo.new(2.2, Enum.EasingStyle.Sine), { CFrame = CFrame.new(pos + Vector3.new(math.cos(a + 3) * 5, 22, math.sin(a + 3) * 5)) * CFrame.Angles(0, a + 3, 0.6), Transparency = 1 }):Play()
			task.delay(2.3, function()
				r:Destroy()
			end)
		end
	end
	task.delay(3, function()
		anchor:Destroy()
	end)
end


return Finishers
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Logic</string>
        </Properties>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Award</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Match rewards as pure math, plus the Encore "top-up".
	A contender knocked out, voted back in by the Gallery and then finishing higher is paid once
	at the knockout and then topped up to the better finish (never paid twice for the match).
]]
local Award = {}

export type Result = { place: number, size: number, knocks: number, crates: number, encore: boolean, pactKept: boolean? }

function Award.baseXp(r: Result, X: any): number
	local base = X.match + (r.size + 1 - r.place) * X.perPlaceAbove + r.knocks * X.knock + r.crates * X.crate
	if r.place == 1 then
		base += X.win
	end
	if r.place <= 10 then
		base += X.top10
	end
	if r.encore then
		base += X.encore
	end
	if r.pactKept then
		base += X.pactKept
	end
	return base
end

function Award.stars(place: number, S: any, bonus: number): number
	local s = S.match + bonus
	if place == 1 then
		s += S.win
	elseif place <= 10 then
		s += S.top10
	end
	return s
end

export type TopUp = { xp: number, stars: number, knocks: number, win: boolean, top10: boolean, top5: boolean, encore: boolean }

-- What's still owed after the first payout, given the final result. Never negative.
function Award.topUp(first: Result, final: Result, X: any, S: any): TopUp
	local place = math.min(first.place, final.place)
	local f = { place = place, size = final.size, knocks = final.knocks, crates = final.crates, encore = final.encore, pactKept = final.pactKept or first.pactKept }
	return {
		xp = math.max(0, Award.baseXp(f, X) - Award.baseXp(first, X)),
		stars = math.max(0, Award.stars(place, S, 0) - Award.stars(first.place, S, 0)),
		knocks = math.max(0, final.knocks - first.knocks),
		win = place == 1 and first.place ~= 1,
		top10 = place <= 10 and first.place > 10,
		top5 = place <= 5 and first.place > 5,
		encore = final.encore and not first.encore,
	}
end

return Award
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Challenges</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Daily (3) and weekly (3) challenges. Every server picks the same set from the day/week number,
	so friends share the same goals. Each challenge tracks one stat. Rewards are Renown and Stars.
	Daily challenges are sized for about 3 matches; weeklies for a few sessions. They never expire
	mid-progress without warning: the panel shows "new in 5h 12m".
]]
-- Same hash as TimeUtil.hash (kept local so this module has no requires and runs in Lune tests).
local function hash(n: number): number
	return math.floor((n * 2654435761) % 4294967296)
end

local Challenges = {}

export type Def = { id: string, stat: string, goal: number, text: string, xp: number, stars: number }
export type Entry = { id: string, progress: number, done: boolean, claimed: boolean }
export type State = { key: number, list: { Entry } }

Challenges.DAILY = {
	{ id = "d_play3", stat = "matches", goal = 3, text = "Play 3 matches", xp = 120, stars = 2 },
	{ id = "d_top10", stat = "top10", goal = 1, text = "Finish in the top 10", xp = 150, stars = 2 },
	{ id = "d_knock2", stat = "knocks", goal = 2, text = "Knock out 2 contenders", xp = 140, stars = 2 },
	{ id = "d_crates8", stat = "crates", goal = 8, text = "Open 8 crates", xp = 100, stars = 1 },
	{ id = "d_gift2", stat = "gifts", goal = 2, text = "Send 2 parachute gifts from the Gallery", xp = 100, stars = 1 },
	{ id = "d_vote3", stat = "votes", goal = 3, text = "Vote on 3 hazards from the Gallery", xp = 90, stars = 1 },
	{ id = "d_token1", stat = "tokens", goal = 1, text = "Find a Jubilee Token", xp = 120, stars = 2 },
	{ id = "d_survive5", stat = "survive5", goal = 2, text = "Survive past 5:00 twice", xp = 130, stars = 2 },
	{ id = "d_hub1", stat = "hubloot", goal = 3, text = "Grab 3 items at the Sundial", xp = 110, stars = 1 },
	{ id = "d_meadow", stat = "meadow", goal = 1, text = "Loot a Gilded Meadow crate", xp = 110, stars = 1 },
	{ id = "d_snack4", stat = "snacks", goal = 4, text = "Eat 4 snacks", xp = 90, stars = 1 },
	{ id = "d_bowknock", stat = "bowknocks", goal = 1, text = "Knock someone out with a bow", xp = 140, stars = 2 },
} :: { Def }

Challenges.WEEKLY = {
	{ id = "w_play20", stat = "matches", goal = 20, text = "Play 20 matches", xp = 600, stars = 6 },
	{ id = "w_win1", stat = "wins", goal = 1, text = "Win a Jubilee", xp = 800, stars = 8 },
	{ id = "w_knock15", stat = "knocks", goal = 15, text = "Knock out 15 contenders", xp = 600, stars = 6 },
	{ id = "w_top5x3", stat = "top5", goal = 3, text = "Finish top 5 three times", xp = 700, stars = 7 },
	{ id = "w_tokens6", stat = "tokens", goal = 6, text = "Find 6 Jubilee Tokens", xp = 650, stars = 6 },
	{ id = "w_gifts10", stat = "gifts", goal = 10, text = "Send 10 gifts from the Gallery", xp = 500, stars = 5 },
	{ id = "w_partner5", stat = "partnermatches", goal = 5, text = "Play 5 matches with a partner", xp = 550, stars = 5 },
	{ id = "w_encore", stat = "encore", goal = 1, text = "Get voted back in by the Gallery", xp = 500, stars = 5 },
} :: { Def }

local byId: { [string]: Def } = {}
for _, d in ipairs(Challenges.DAILY) do
	byId[d.id] = d
end
for _, d in ipairs(Challenges.WEEKLY) do
	byId[d.id] = d
end

function Challenges.def(id: string): Def?
	return byId[id]
end

-- Pick `n` distinct challenges from a pool using a deterministic seed.
function Challenges.pick(pool: { Def }, seed: number, n: number): { Def }
	local idx = {}
	for i = 1, #pool do
		idx[i] = i
	end
	local h = hash(seed + 7)
	for i = #idx, 2, -1 do
		h = hash(h % 1000003 + i)
		local j = ((h // 4096) % i) + 1
		idx[i], idx[j] = idx[j], idx[i]
	end
	local out = {}
	for i = 1, math.min(n, #idx) do
		table.insert(out, pool[idx[i]])
	end
	return out
end

-- Make sure the state matches the current day/week key; resets when it changes.
function Challenges.ensure(s: State, pool: { Def }, key: number, n: number): boolean
	if s.key == key and #s.list == n then
		return false
	end
	s.key = key
	s.list = {}
	for _, d in ipairs(Challenges.pick(pool, key, n)) do
		table.insert(s.list, { id = d.id, progress = 0, done = false, claimed = false })
	end
	return true
end

-- Add progress for a stat. Returns the defs that just completed.
function Challenges.bump(s: State, stat: string, amount: number): { Def }
	local done = {}
	for _, e in ipairs(s.list) do
		local d = byId[e.id]
		if d and d.stat == stat and not e.done then
			e.progress = math.min(d.goal, e.progress + amount)
			if e.progress >= d.goal then
				e.done = true
				table.insert(done, d)
			end
		end
	end
	return done
end

-- Claim a completed challenge's reward (auto-claimed by the server at match end).
function Challenges.claim(s: State, id: string): Def?
	for _, e in ipairs(s.list) do
		if e.id == id and e.done and not e.claimed then
			e.claimed = true
			return byId[id]
		end
	end
	return nil
end

return Challenges
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Combat</string>
            <string name="Source"><![CDATA[--!strict
-- Pure combat helpers the server uses to validate every hit. The client only sends intent.
local Combat = {}

export type V3 = { x: number, y: number, z: number }

function Combat.dist(a: V3, b: V3): number
	local dx, dy, dz = a.x - b.x, a.y - b.y, a.z - b.z
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end

-- Is `target` inside a melee arc of `arcDeg` in front of `from` facing `look` (flat, XZ)?
function Combat.inArc(from: V3, look: V3, target: V3, arcDeg: number): boolean
	local dx, dz = target.x - from.x, target.z - from.z
	local d = math.sqrt(dx * dx + dz * dz)
	if d < 0.5 then
		return true
	end
	local ll = math.sqrt(look.x * look.x + look.z * look.z)
	if ll < 1e-6 then
		return false
	end
	local cos = (dx * look.x + dz * look.z) / (d * ll)
	return cos >= math.cos(math.rad(arcDeg / 2))
end

-- Partners from the same Reach cannot hurt each other until `alliesUntil` remain.
function Combat.canHurt(aReach: string, bReach: string, alive: number, alliesUntil: number): boolean
	if aReach == bReach and alive > alliesUntil then
		return false
	end
	return true
end

-- Bow damage falls off a little past half range so close shots matter.
function Combat.bowDamage(base: number, distance: number, range: number): number
	if distance > range then
		return 0
	end
	if distance <= range / 2 then
		return base
	end
	local a = (distance - range / 2) / (range / 2)
	return math.floor(base * (1 - 0.3 * a) + 0.5)
end

-- Apply damage to Pep. Returns new pep and whether this hit knocked them out.
function Combat.hit(pep: number, damage: number): (number, boolean)
	local n = math.max(0, pep - damage)
	return n, n <= 0 and pep > 0
end

-- Placement: if N are alive and one is knocked, they finish in place N.
function Combat.placeOnKnock(aliveBefore: number): number
	return aliveBefore
end

-- Can the client's claimed cooldown be honoured? (server keeps its own clock)
function Combat.ready(lastUse: number?, now: number, cooldown: number): boolean
	return lastUse == nil or now - lastUse >= cooldown * 0.9
end

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Comeback</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Comeback.luau: a warm welcome for contenders who've been away, never a guilt trip.

	Away 3+ days: Rusty's welcome-back letter, 30 Favor for your next Gallery visit and a
	Homecoming bonus of +50% Renown for your next 3 matches (cosmetic progress only, casual).
	Away 14+ days: the same plus Season catch-up: Daybreak Stars count double until you reach
	the tier a weekly player would be at this week (never past it).
	The streak itself is untouched (Streak.luau already forgives one miss a week).
]]
local Comeback = {}

Comeback.MIN_DAYS = 3
Comeback.LONG_DAYS = 14
Comeback.FAVOR = 30
Comeback.MATCHES = 3
Comeback.RENOWN_MULT = 0.5
Comeback.TIERS_PER_WEEK = 4 -- a weekly player's pace on the Season Track

export type State = { lastSeenDay: number, homecoming: number, catchUpTier: number, welcomedDay: number }

function Comeback.new(): State
	return { lastSeenDay = -1, homecoming = 0, catchUpTier = 0, welcomedDay = -1 }
end

export type Welcome = { days: number, favor: number, matches: number, catchUpTier: number, long: boolean }

-- Call on join. Returns a Welcome when it applies (once per return), and records today.
function Comeback.onJoin(s: State, today: number, seasonWeek: number?, currentTier: number): Welcome?
	local last = s.lastSeenDay
	s.lastSeenDay = today
	if last < 0 or s.welcomedDay == today then
		return nil
	end
	local days = today - last
	if days < Comeback.MIN_DAYS then
		return nil
	end
	s.welcomedDay = today
	s.homecoming = Comeback.MATCHES
	local long = days >= Comeback.LONG_DAYS
	local target = 0
	if long and seasonWeek then
		target = math.max(currentTier, seasonWeek * Comeback.TIERS_PER_WEEK)
		s.catchUpTier = target
	end
	return { days = days, favor = Comeback.FAVOR, matches = Comeback.MATCHES, catchUpTier = target, long = long }
end

-- Extra Renown multiplier for a finished match (and uses one Homecoming match).
function Comeback.useMatch(s: State): number
	if s.homecoming > 0 then
		s.homecoming -= 1
		return Comeback.RENOWN_MULT
	end
	return 0
end

-- Star multiplier while the player is below their catch-up tier.
function Comeback.starMult(s: State, currentTier: number): number
	if s.catchUpTier > 0 and currentTier < s.catchUpTier then
		return 2
	end
	return 1
end

return Comeback
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Events</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Events.luau: yearly festivals on fixed UTC dates (same on every server, no live config).

	Founders' Dawn (18-30 November): the nation's holiday for the first sunrise after the Long Dark,
	timed for launch week. It brings:
	  * Archive Reel matches (every third match): a sepia broadcast of the 25th Trials, the year
	    Rusty was drawn, with a young Rusty among the Stand-Ins.
	  * Three free festival rewards earned by playing (Events.REWARDS).
	  * The Founders' Dawn Set in the shop for the festival, back every November.
	  * Gold-dawn lobby lighting and lantern strings.
]]
local Events = {}

export type Event = { id: string, name: string, month: number, fromDay: number, toDay: number, blurb: string }
Events.LIST = {
	{ id = "founders_dawn", name = "Founders' Dawn", month = 11, fromDay = 18, toDay = 30, blurb = "The whole nation celebrates the first sunrise after the Long Dark. Archive Reel matches, lanterns and free festival rewards." },
} :: { Event }

export type Reward = { id: string, need: string, count: number, label: string }
Events.REWARDS = {
	founders_dawn = {
		{ id = "banner_founders_lantern", need = "matches", count = 3, label = "Play 3 matches during the festival" },
		{ id = "tag_dawn_ribbon", need = "days", count = 3, label = "Play on 3 different festival days" },
		{ id = "fade_archive_reel", need = "archiveTop5", count = 1, label = "Finish top 5 in an Archive Reel match" },
	},
} :: { [string]: { Reward } }
Events.ARCHIVE_EVERY = 3 -- every third match during Founders' Dawn is an Archive Reel

-- Days since 1970-01-01 for a civil date (proleptic Gregorian, UTC).
function Events.daysFromCivil(y: number, m: number, d: number): number
	y -= if m <= 2 then 1 else 0
	local era = (if y >= 0 then y else y - 399) // 400
	local yoe = y - era * 400
	local mp = (m + 9) % 12
	local doy = (153 * mp + 2) // 5 + d - 1
	local doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
	return era * 146097 + doe - 719468
end

-- Year of a unix time (UTC).
function Events.yearOf(t: number): number
	local z = math.floor(t / 86400) + 719468
	local era = (if z >= 0 then z else z - 146096) // 146097
	local doe = z - era * 146097
	local yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
	local doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
	local mp = (5 * doy + 2) // 153
	local m = if mp < 10 then mp + 3 else mp - 9
	return yoe + era * 400 + (if m <= 2 then 1 else 0)
end

-- [start, finish) unix seconds of an event in a given year.
function Events.window(e: Event, year: number): (number, number)
	local a = Events.daysFromCivil(year, e.month, e.fromDay) * 86400
	local b = (Events.daysFromCivil(year, e.month, e.toDay) + 1) * 86400
	return a, b
end

function Events.byId(id: string): Event?
	for _, e in ipairs(Events.LIST) do
		if e.id == id then
			return e
		end
	end
	return nil
end

-- The event running at time t, or nil.
function Events.active(t: number): Event?
	local y = Events.yearOf(t)
	for _, e in ipairs(Events.LIST) do
		local a, b = Events.window(e, y)
		if t >= a and t < b then
			return e
		end
	end
	return nil
end

-- Does a shop week (Monday-based, as Store.week) overlap the event in any year?
function Events.weekOverlaps(id: string, weekStart: number, weekLen: number): boolean
	local e = Events.byId(id)
	if not e then
		return false
	end
	local y = Events.yearOf(weekStart)
	for yy = y - 1, y + 1 do
		local a, b = Events.window(e, yy)
		if weekStart < b and weekStart + weekLen > a then
			return true
		end
	end
	return false
end

-- The next start time of an event at or after t (for "back every November" copy).
function Events.nextStart(id: string, t: number): number?
	local e = Events.byId(id)
	if not e then
		return nil
	end
	local y = Events.yearOf(t)
	for yy = y, y + 1 do
		local a, b = Events.window(e, yy)
		if t < b then
			return math.max(a, t)
		end
	end
	return nil
end

function Events.isArchiveMatch(matchNo: number): boolean
	return matchNo % Events.ARCHIVE_EVERY == 0
end

-- Festival progress bookkeeping on the save: { id, year, matches, days = {[day]=true}, archiveTop5, got = {} }
export type Progress = { id: string, year: number, matches: number, days: { [string]: boolean }, archiveTop5: number, got: { [string]: boolean } }

function Events.progressFor(saved: any, e: Event, year: number): Progress
	if type(saved) ~= "table" or saved.id ~= e.id or saved.year ~= year then
		return { id = e.id, year = year, matches = 0, days = {}, archiveTop5 = 0, got = {} }
	end
	return saved
end

-- Record a finished festival match. Returns reward ids newly earned.
function Events.recordMatch(p: Progress, day: number, archiveTop5: boolean): { string }
	p.matches += 1
	p.days[tostring(day)] = true
	if archiveTop5 then
		p.archiveTop5 += 1
	end
	local nDays = 0
	for _ in pairs(p.days) do
		nDays += 1
	end
	local out = {}
	for _, r in ipairs(Events.REWARDS[p.id] or {}) do
		local have = if r.need == "matches" then p.matches elseif r.need == "days" then nDays else p.archiveTop5
		if have >= r.count and not p.got[r.id] then
			p.got[r.id] = true
			table.insert(out, r.id)
		end
	end
	return out
end

return Events
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Funnel</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Funnel.luau: the step lists the server logs to AnalyticsService so the first-purchase funnel
	and onboarding can be measured after launch (Creator Dashboard > Analytics > Funnels).
	Server-only logging (Roblox ignores client and Studio events). Pure step lookup here.
]]
local Funnel = {}

Funnel.SHOP = "ShopFirstPurchase"
Funnel.SHOP_STEPS = { "shop_open", "item_view", "try_on", "prompt", "purchase" }
Funnel.ONBOARDING_STEPS = { "joined", "first_match", "crate", "weapon", "eat", "veil", "gallery", "second_match", "first_shop_open" }

function Funnel.step(list: { string }, name: string): number?
	return table.find(list, name)
end

-- Session id for a shop visit: one per player per shop open (no GUID needed in tests).
function Funnel.session(userId: number, opens: number): string
	return tostring(userId) .. ":" .. tostring(opens)
end

return Funnel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Gifts</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Viewing Gallery gifts. Spectators earn Favor just by watching (never bought with Robux).
	Gifts get pricier as the field shrinks so the final few aren't flooded; your Reach partner
	gets a discount. Each contender can receive one gift every `cooldown` seconds.
]]
local Gifts = {}

function Gifts.cost(base: number, alive: number, isPartner: boolean, discount: number, weekMult: number): number
	local scale = 1
	if alive <= 4 then
		scale = 2
	elseif alive <= 10 then
		scale = 1.5
	elseif alive <= 24 then
		scale = 1.2
	end
	local c = base * scale * weekMult
	if isPartner then
		c *= discount
	end
	return math.max(1, math.floor(c + 0.5))
end

-- lastGift: target id -> time of their last received gift
function Gifts.canSend(lastGift: { [string]: number }, target: string, now: number, cooldown: number): (boolean, number)
	local t = lastGift[target]
	if t and now - t < cooldown then
		return false, cooldown - (now - t)
	end
	return true, 0
end

return Gifts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Leveling</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Contender level (1-50) and prestige (Reaped -> Contender -> Favorite -> Champion -> Legend).
	Level only unlocks cosmetics and titles. It never changes combat.
]]
local Leveling = {}

export type State = { level: number, xp: number, prestige: number }

function Leveling.xpToNext(level: number): number
	return 100 + 25 * (math.max(1, level) - 1)
end

-- Adds Renown. Returns how many levels were gained. XP stops at the cap until you prestige.
function Leveling.add(s: State, amount: number, cap: number): number
	local gained = 0
	s.xp += math.max(0, math.floor(amount))
	while s.level < cap and s.xp >= Leveling.xpToNext(s.level) do
		s.xp -= Leveling.xpToNext(s.level)
		s.level += 1
		gained += 1
	end
	if s.level >= cap then
		s.xp = math.min(s.xp, Leveling.xpToNext(cap))
	end
	return gained
end

function Leveling.canPrestige(s: State, cap: number, prestigeCap: number): boolean
	return s.level >= cap and s.prestige < prestigeCap
end

-- Prestige resets level to 1 and grants the next rank's frame and title (cosmetic only).
function Leveling.prestige(s: State, cap: number, prestigeCap: number): boolean
	if not Leveling.canPrestige(s, cap, prestigeCap) then
		return false
	end
	s.prestige += 1
	s.level = 1
	s.xp = 0
	return true
end

-- Total Renown needed to reach a level from level 1.
function Leveling.totalTo(level: number): number
	local t = 0
	for l = 1, level - 1 do
		t += Leveling.xpToNext(l)
	end
	return t
end

-- Play streak: back-to-back matches within `window` seconds add +step XP each, up to max.
export type Play = { count: number, lastEnd: number }
function Leveling.playStreak(p: Play, now: number, window: number): number
	if p.lastEnd > 0 and now - p.lastEnd <= window then
		p.count += 1
	else
		p.count = 1
	end
	p.lastEnd = now
	return p.count
end

function Leveling.playMult(count: number, step: number, maxBonus: number): number
	return 1 + math.min(maxBonus, step * math.max(0, count - 1))
end

return Leveling
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Loot</string>
            <string name="Source"><![CDATA[--!strict
-- Crate rolls from a weight table. Crates are free and found in the arena; odds are shown in Help.
-- Nothing here is ever sold.
local Loot = {}

local function keys(weights: { [string]: number }): { string }
	local k = {}
	for id in pairs(weights) do
		table.insert(k, id)
	end
	table.sort(k)
	return k
end

-- u in [0,1)
function Loot.pick(weights: { [string]: number }, u: number): string
	local total = 0
	local ks = keys(weights)
	for _, id in ipairs(ks) do
		total += weights[id]
	end
	local x = u * total
	for _, id in ipairs(ks) do
		x -= weights[id]
		if x < 0 then
			return id
		end
	end
	return ks[#ks]
end

function Loot.odds(weights: { [string]: number }): { [string]: number }
	local total = 0
	for _, w in pairs(weights) do
		total += w
	end
	local out = {}
	for id, w in pairs(weights) do
		out[id] = w / total
	end
	return out
end

return Loot
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Meters</string>
            <string name="Source"><![CDATA[--!strict
-- Food and Water: slow meters that drain over a match. Snacks refill them. Low meters only slow
-- stamina regeneration; they never cost Pep, so they can't knock anyone out on their own.
local Meters = {}

export type Rules = { max: number, start: number, foodDrain: number, waterDrain: number, low: number, lowRegen: number }
export type M = { food: number, water: number }

function Meters.new(r: Rules): M
	return { food = r.start, water = r.start }
end

function Meters.step(m: M, r: Rules, dt: number, drainMult: number): M
	m.food = math.max(0, m.food - r.foodDrain * dt * drainMult)
	m.water = math.max(0, m.water - r.waterDrain * dt * drainMult)
	return m
end

function Meters.eat(m: M, r: Rules, food: number?, water: number?)
	m.food = math.min(r.max, m.food + (food or 0))
	m.water = math.min(r.max, m.water + (water or 0))
end

-- Stamina regen multiplier from the meters.
function Meters.regenMult(m: M, r: Rules): number
	local k = 1
	if m.food < r.low then
		k *= r.lowRegen
	end
	if m.water < r.low then
		k *= r.lowRegen
	end
	return k
end

return Meters
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Modes</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Modes.luau: Jubilee (the full 12-minute show) and Quick Trials (a ~5-minute match).

	Quick Trials keeps all 48 contenders, the map and every rule, and runs the arena clock on a
	shorter schedule: the Veil, hazards, the Encore vote and the time cap all happen sooner, and
	the pregame is the 3-second short reaping plus launch. It's the default for a player's first
	two matches (so the first session has a payoff inside 6 minutes) and anyone can pick it.
	The queue runs whichever mode most queued players picked; a tie goes to Jubilee.
]]
local Modes = {}

export type Phase = { at: number, from: number, to: number, dur: number }
export type Mode = { id: string, name: string, pace: number, ceremony: boolean, blurb: string }

Modes.JUBILEE = "jubilee"
Modes.QUICK = "quick"
Modes.LIST = {
	jubilee = { id = "jubilee", name = "Jubilee", pace = 1, ceremony = true, blurb = "The full show: reaping, parade, interviews, training and a 12-minute arena." },
	quick = { id = "quick", name = "Quick Trials", pace = 0.45, ceremony = false, blurb = "Straight to the plates. Same 48 and same rules, about 5 minutes of arena." },
} :: { [string]: Mode }
Modes.NEW_PLAYER_QUICK_MATCHES = 2 -- first two matches default to Quick Trials

function Modes.get(id: string?): Mode
	return Modes.LIST[id or ""] or Modes.LIST.jubilee
end

-- The mode a player wants: their saved pick, else Quick for brand-new players.
function Modes.preferred(saved: string?, matchesPlayed: number): string
	if saved == Modes.QUICK or saved == Modes.JUBILEE then
		return saved :: string
	end
	return if matchesPlayed < Modes.NEW_PLAYER_QUICK_MATCHES then Modes.QUICK else Modes.JUBILEE
end

-- Majority of the queued humans' picks; ties and an empty queue go to Jubilee.
function Modes.pick(prefs: { string }): string
	local q, j = 0, 0
	for _, p in ipairs(prefs) do
		if p == Modes.QUICK then
			q += 1
		else
			j += 1
		end
	end
	return if q > j then Modes.QUICK else Modes.JUBILEE
end

-- Scale a schedule time (seconds into the arena) to the mode's pace.
function Modes.at(mode: Mode, t: number): number
	return math.floor(t * mode.pace)
end

function Modes.phases(mode: Mode, phases: { Phase }, twistScale: number?): { Phase }
	local k = mode.pace * (twistScale or 1)
	local out = {}
	for _, p in ipairs(phases) do
		table.insert(out, { at = math.floor(p.at * k), from = p.from, to = p.to, dur = math.max(10, math.floor(p.dur * k)) })
	end
	return out
end

-- Arena hard cap for the mode (seconds).
function Modes.cap(mode: Mode, hardCap: number): number
	return math.floor(hardCap * mode.pace)
end

-- Pregame seconds for the mode: the full ceremony, or the short reaping only.
function Modes.pregame(mode: Mode, full: number, shortReaping: number): number
	return if mode.ceremony then full else shortReaping
end

return Modes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Moments</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Moments.luau: which match results are worth a "Share this moment" card, and the small
	payload that goes with a shared screenshot.

	The client takes the screenshot with CaptureService and offers Roblox's own share sheet only
	when PolicyService says content sharing is allowed. Friends who open the shared capture join
	with launch data "ref:<userId>;m:<moment>", so the existing invite reward still works.
]]
local Moments = {}

local Names: any
if typeof(script) == "Instance" then
	Names = require((script :: any).Parent.Parent.Names) :: any
else
	Names = (require :: any)("../Names")
end

export type Result = { place: number, knocks: number, veilBreaker: boolean?, encoreWon: boolean?, archive: boolean?, partyBest: boolean? }
export type Moment = { id: string, title: string, caption: string, rank: number }

Moments.LIST = {
	win = { id = "win", title = "Last one standing", caption = "Last one standing in " .. Names.TITLE .. "!", rank = 1 },
	veil = { id = "veil", title = "Veil Breaker", caption = "Outran the Veil to the very end.", rank = 2 },
	encore = { id = "encore", title = "Encore hero", caption = "Won the Gallery's Encore vote.", rank = 3 },
	top3 = { id = "top3", title = "Top 3", caption = "Made the final three!", rank = 4 },
	knocks = { id = "knocks", title = "Five knockouts", caption = "Five knockouts in one match.", rank = 5 },
	archive = { id = "archive", title = "Archive Reel", caption = "Made the top 5 in an Archive Reel match.", rank = 6 },
	party = { id = "party", title = "Best in the party", caption = "Best finish in our party tonight.", rank = 7 },
} :: { [string]: Moment }
Moments.MAX_LAUNCH_BYTES = 200

-- The single best moment for a result (one card per match, never a nag), or nil.
function Moments.pick(r: Result): Moment?
	local best: Moment? = nil
	local function try(id: string, ok: boolean?)
		if ok then
			local m = Moments.LIST[id]
			if not best or m.rank < best.rank then
				best = m
			end
		end
	end
	try("win", r.place == 1)
	try("veil", r.veilBreaker)
	try("encore", r.encoreWon)
	try("top3", r.place <= 3)
	try("knocks", r.knocks >= 5)
	try("archive", r.archive and r.place <= 5)
	try("party", r.partyBest)
	return best
end

function Moments.launchData(userId: number, momentId: string): string
	local s = "ref:" .. tostring(userId) .. ";m:" .. momentId
	return string.sub(s, 1, Moments.MAX_LAUNCH_BYTES)
end

-- Parses "ref:<id>" or "ref:<id>;m:<moment>". Returns referrer id and moment id.
function Moments.parse(data: string?): (number?, string?)
	if type(data) ~= "string" then
		return nil, nil
	end
	local id = tonumber(string.match(data, "^ref:(%d+)") or "")
	local m = string.match(data, ";m:([%w_]+)")
	return id, m
end

return Moments
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">NearMiss</string>
            <string name="Source"><![CDATA[--!strict
--[[
	The end-of-match card. Shows how close you got and one honest, specific next goal.
	Never shames, never says "buy". Copy is short and readable at a glance.
]]
local NearMiss = {}

export type Result = {
	place: number,
	size: number,
	knocks: number,
	survived: number, -- seconds
	bestPlace: number, -- previous best (0 = none)
	nextKnockGoal: number?, -- knocks needed for the next daily/weekly step
	winnerPepLeft: number?,
	tapperName: string?,
}

local function ordinal(n: number): string
	local suf = "th"
	local m100 = n % 100
	if m100 < 11 or m100 > 13 then
		local m = n % 10
		if m == 1 then
			suf = "st"
		elseif m == 2 then
			suf = "nd"
		elseif m == 3 then
			suf = "rd"
		end
	end
	return tostring(n) .. suf
end
NearMiss.ordinal = ordinal

function NearMiss.headline(r: Result): string
	if r.place == 1 then
		return "Champion at daybreak!"
	end
	return string.format("%s of %d!", ordinal(r.place), r.size)
end

-- Up to three short lines, most motivating first.
function NearMiss.lines(r: Result): { string }
	local out = {}
	if r.place == 2 and r.winnerPepLeft then
		table.insert(out, string.format("So close! The champion had only %d Pep left.", math.max(1, math.floor(r.winnerPepLeft))))
	elseif r.place == 2 then
		table.insert(out, "So close! One more knock and it was yours.")
	elseif r.place <= 5 then
		table.insert(out, string.format("Top 5! Just %d more to outlast.", r.place - 1))
	elseif r.place <= 10 then
		table.insert(out, string.format("Top 10! %d spots from the podium.", r.place - 3))
	end
	if r.bestPlace > 0 and r.place < r.bestPlace then
		table.insert(out, "New personal best! (was " .. ordinal(r.bestPlace) .. ")")
	elseif r.bestPlace > 0 and r.place > 1 and r.place - r.bestPlace <= 3 and r.place ~= r.bestPlace then
		table.insert(out, string.format("%d places off your best (%s).", r.place - r.bestPlace, ordinal(r.bestPlace)))
	end
	if r.nextKnockGoal and r.nextKnockGoal > 0 and r.nextKnockGoal <= 2 then
		table.insert(out, string.format("%d more knock%s finishes a challenge.", r.nextKnockGoal, r.nextKnockGoal == 1 and "" or "s"))
	end
	local mins = math.floor(r.survived / 60)
	if #out < 3 and mins >= 1 then
		table.insert(out, string.format("You lasted %d:%02d.", mins, math.floor(r.survived) % 60))
	end
	while #out > 3 do
		table.remove(out)
	end
	return out
end

return NearMiss
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Onboarding</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Onboarding.luau: the first five minutes. Rusty walks a new contender through five small
	steps in their first matches, one at a time, each with a one-line tip and a small Renown
	reward. Nothing blocks play: the steps complete from things you'd do anyway, and the
	checklist hides itself once done or after 5 matches.

	v6: the checklist is skippable. A Skip button asks once (calm copy, no pressure words) and
	the choice is saved. Skipping keeps your progress; reopen it from Settings any time and you
	can still finish it for the reward. Finishing all five gives the step Renown (120 in total)
	plus Rusty's Pick, a nametag title only checklist finishers get (cosmetic only).

	It also softens the first matches against Stand-In bots (only bots, never real players):
	their damage to a contender in their first 3 matches is scaled down.
]]
local Onboarding = {}

export type Step = { id: string, event: string, title: string, tip: string, xp: number }
Onboarding.STEPS = {
	{ id = "crate", event = "crate", title = "Open a crate", tip = "Crates glow at the Sundial and all over the map. Walk up and hold E.", xp = 20 },
	{ id = "weapon", event = "weapon", title = "Pick up a weapon", tip = "Bows reach far, spears hit hard, knives are quick. Grab one.", xp = 20 },
	{ id = "eat", event = "eat", title = "Eat or drink something", tip = "Food and Water keep your stamina up. Press the item's number.", xp = 20 },
	{ id = "veil", event = "veil", title = "Stay ahead of the Veil", tip = "Watch the ring on your map. Be inside before it shrinks.", xp = 30 },
	{ id = "gallery", event = "gallery", title = "Help from the Gallery", tip = "Out already? Send a gift or vote on the next hazard. It counts.", xp = 30 },
} :: { Step }
Onboarding.HIDE_AFTER_MATCHES = 5
Onboarding.SOFT_MATCHES = 3
Onboarding.SOFT_BOT_DAMAGE = 0.6

-- What finishing all five steps gives (stated plainly on the checklist).
Onboarding.REWARD = { id = "title_rustys_pick", name = "Rusty's Pick", kind = "nametag title" }
Onboarding.COPY = {
	reward = "Finish all 5: %d Renown + the Rusty's Pick title, only for finishers.",
	skipAsk = "Skip Rusty's checklist? You'll miss the finish reward, the Rusty's Pick title. Your progress is kept, and you can reopen the checklist in Settings any time.",
	skipYes = "Skip it",
	skipNo = "Keep it",
	skipped = "Checklist hidden. Reopen it any time in Settings to finish it for Rusty's Pick.",
	reopened = "Rusty's checklist is back. Finish it for the Rusty's Pick title.",
	done = "Checklist done! Title unlocked: Rusty's Pick.",
}

export type State = { done: { [string]: boolean }, finished: boolean, skipped: boolean?, reopened: boolean?, rewarded: boolean? }

function Onboarding.new(): State
	return { done = {}, finished = false, skipped = false, reopened = false, rewarded = false }
end

function Onboarding.totalXp(): number
	local n = 0
	for _, st in ipairs(Onboarding.STEPS) do
		n += st.xp
	end
	return n
end

-- Is the checklist running (shown and counting steps)? Skipped hides it; after 5 matches it
-- hides itself unless the player reopened it from Settings.
function Onboarding.active(s: State, matchesPlayed: number): boolean
	if s.finished or s.skipped then
		return false
	end
	return s.reopened == true or matchesPlayed < Onboarding.HIDE_AFTER_MATCHES
end

-- Can Settings offer "Reopen Rusty's checklist"? (not finished and not showing right now)
function Onboarding.canReopen(s: State, matchesPlayed: number): boolean
	return not s.finished and not Onboarding.active(s, matchesPlayed)
end

function Onboarding.skip(s: State): boolean
	if s.finished or s.skipped then
		return false
	end
	s.skipped = true
	return true
end

function Onboarding.reopen(s: State, matchesPlayed: number): boolean
	if not Onboarding.canReopen(s, matchesPlayed) then
		return false
	end
	s.skipped = false
	s.reopened = true
	return true
end

-- Once, when the checklist is finished: true means grant Onboarding.REWARD now.
function Onboarding.claimReward(s: State): boolean
	if s.finished and not s.rewarded then
		s.rewarded = true
		return true
	end
	return false
end

-- The step to show now (the first not done), or nil when finished / hidden.
function Onboarding.current(s: State, matchesPlayed: number): Step?
	if not Onboarding.active(s, matchesPlayed) then
		return nil
	end
	for _, st in ipairs(Onboarding.STEPS) do
		if not s.done[st.id] then
			return st
		end
	end
	return nil
end

-- Record an event. Any matching step completes (not only the current one, so nothing a new
-- player does is wasted). Returns the steps completed by this event.
function Onboarding.mark(s: State, event: string): { Step }
	local out = {}
	if s.finished or s.skipped then
		return out
	end
	for _, st in ipairs(Onboarding.STEPS) do
		if st.event == event and not s.done[st.id] then
			s.done[st.id] = true
			table.insert(out, st)
		end
	end
	local all = true
	for _, st in ipairs(Onboarding.STEPS) do
		if not s.done[st.id] then
			all = false
		end
	end
	s.finished = all
	return out
end

function Onboarding.progress(s: State): (number, number)
	local n = 0
	for _, st in ipairs(Onboarding.STEPS) do
		if s.done[st.id] then
			n += 1
		end
	end
	return n, #Onboarding.STEPS
end

-- Bot damage multiplier against a contender who has played `matchesPlayed` matches.
function Onboarding.botDamageMult(matchesPlayed: number): number
	return if matchesPlayed < Onboarding.SOFT_MATCHES then Onboarding.SOFT_BOT_DAMAGE else 1
end

return Onboarding
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Pacts</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Pacts: in-match alliances between contenders from different Reaches (Reach partners are
	already allies). Pure state + rules so the server and the tests share one source of truth.

	  offer(from, to)  -> a pending offer (expires after offerSeconds)
	  accept(to, from) -> both join one pact (max `maxSize` members)
	  canHurt(a, b)    -> members of one pact can't hurt each other
	  snap(who)        -> starts a visible wind-up (snapSeconds). While winding up the pact still
	                      protects everyone, and the other members are warned.
	  tick(now)        -> finishes wind-ups: the snapper leaves, gets a short "betrayal window"
	                      (first hit on an ex-ally deals bonus damage), and the ex-allies get a
	                      brief guard so a betrayal is a moment, not a free knockout.
	  endAll()         -> every pact dissolves at the final few (Config.Pacts.endAt).
	No chat, no free text: everything is a button press the server validates.
]]
local Pacts = {}

export type Rules = {
	maxSize: number,
	offerSeconds: number,
	snapSeconds: number,
	betrayWindow: number,
	betrayBonus: number,
	guardSeconds: number,
	guardMult: number,
	endAt: number,
	cooldown: number,
}

export type Pact = { id: number, members: { string }, formedAt: number }
export type Offer = { from: string, at: number }
export type Snap = { who: string, pact: number, at: number, doneAt: number }
export type Betrayal = { who: string, victims: { string }, untilT: number, used: boolean }

export type State = {
	nextId: number,
	pacts: { [number]: Pact },
	memberOf: { [string]: number },
	offers: { [string]: Offer }, -- to -> offer
	snaps: { [string]: Snap }, -- who -> snap
	betrayals: { [string]: Betrayal }, -- snapper -> window
	guardUntil: { [string]: number }, -- victim -> time
	lastPactAt: { [string]: number }, -- after a snap you can't re-pact right away
	ended: boolean,
}

export type Event = { kind: string, who: string?, with: { string }?, pact: number? }

function Pacts.new(): State
	return {
		nextId = 1,
		pacts = {},
		memberOf = {},
		offers = {},
		snaps = {},
		betrayals = {},
		guardUntil = {},
		lastPactAt = {},
		ended = false,
	}
end

function Pacts.pactOf(s: State, id: string): Pact?
	local p = s.memberOf[id]
	return p and s.pacts[p] or nil
end

function Pacts.allies(s: State, id: string): { string }
	local out = {}
	local p = Pacts.pactOf(s, id)
	if p then
		for _, m in ipairs(p.members) do
			if m ~= id then
				table.insert(out, m)
			end
		end
	end
	return out
end

function Pacts.same(s: State, a: string, b: string): boolean
	local pa = s.memberOf[a]
	return pa ~= nil and pa == s.memberOf[b]
end

local function size(s: State, id: string): number
	local p = Pacts.pactOf(s, id)
	return p and #p.members or 1
end

-- Can `from` offer a pact to `to` right now? Returns ok + a player-facing reason.
function Pacts.canOffer(s: State, r: Rules, from: string, to: string, alive: number, now: number): (boolean, string?)
	if s.ended or alive <= r.endAt then
		return false, "Pacts are over. It's every contender for themselves."
	end
	if from == to then
		return false, nil
	end
	if Pacts.same(s, from, to) then
		return false, "You're already in a pact together."
	end
	if s.snaps[from] then
		return false, "You're snapping your pact."
	end
	if (s.lastPactAt[from] or -math.huge) + r.cooldown > now then
		return false, "Wait a moment before making a new pact."
	end
	if s.memberOf[to] and s.memberOf[from] then
		return false, "You're both in different pacts."
	end
	if size(s, from) + size(s, to) > r.maxSize then
		return false, string.format("A pact can have at most %d contenders.", r.maxSize)
	end
	return true, nil
end

function Pacts.offer(s: State, r: Rules, from: string, to: string, alive: number, now: number): (boolean, string?)
	local ok, why = Pacts.canOffer(s, r, from, to, alive, now)
	if not ok then
		return false, why
	end
	s.offers[to] = { from = from, at = now }
	return true, nil
end

-- `to` accepts the pending offer. Returns the pact on success.
function Pacts.accept(s: State, r: Rules, to: string, alive: number, now: number): (Pact?, string?)
	local o = s.offers[to]
	if not o or now - o.at > r.offerSeconds then
		s.offers[to] = nil
		return nil, "That offer has expired."
	end
	s.offers[to] = nil
	local ok, why = Pacts.canOffer(s, r, o.from, to, alive, now)
	if not ok then
		return nil, why
	end
	local pid = s.memberOf[o.from] or s.memberOf[to]
	local p: Pact
	if pid then
		p = s.pacts[pid]
	else
		p = { id = s.nextId, members = {}, formedAt = now }
		s.pacts[p.id] = p
		s.nextId += 1
	end
	for _, m in ipairs({ o.from, to }) do
		if s.memberOf[m] == nil then
			table.insert(p.members, m)
			s.memberOf[m] = p.id
		end
	end
	return p, nil
end

function Pacts.decline(s: State, to: string)
	s.offers[to] = nil
end

local function leave(s: State, id: string)
	local pid = s.memberOf[id]
	if not pid then
		return
	end
	s.memberOf[id] = nil
	local p = s.pacts[pid]
	if p then
		local i = table.find(p.members, id)
		if i then
			table.remove(p.members, i)
		end
		if #p.members <= 1 then
			for _, m in ipairs(p.members) do
				s.memberOf[m] = nil
			end
			s.pacts[pid] = nil
		end
	end
end

-- Start the betrayal wind-up. The pact keeps protecting everyone until it completes.
function Pacts.snap(s: State, r: Rules, who: string, now: number): (Snap?, string?)
	local pid = s.memberOf[who]
	if not pid then
		return nil, "You're not in a pact."
	end
	if s.snaps[who] then
		return nil, nil
	end
	local sn = { who = who, pact = pid, at = now, doneAt = now + r.snapSeconds }
	s.snaps[who] = sn
	return sn, nil
end

-- Advance wind-ups. Returns "snapped" events (who + the ex-allies they betrayed).
function Pacts.tick(s: State, r: Rules, now: number): { Event }
	local events: { Event } = {}
	local done = {}
	for who, sn in pairs(s.snaps) do
		if now >= sn.doneAt then
			table.insert(done, who)
		end
	end
	table.sort(done)
	for _, who in ipairs(done) do
		local sn = s.snaps[who]
		s.snaps[who] = nil
		if s.memberOf[who] == sn.pact then
			local victims = Pacts.allies(s, who)
			leave(s, who)
			s.lastPactAt[who] = now
			s.betrayals[who] = { who = who, victims = victims, untilT = now + r.betrayWindow, used = false }
			for _, v in ipairs(victims) do
				s.guardUntil[v] = now + r.guardSeconds
			end
			table.insert(events, { kind = "snapped", who = who, with = victims, pact = sn.pact })
		end
	end
	return events
end

function Pacts.canHurt(s: State, a: string, b: string): boolean
	return not Pacts.same(s, a, b)
end

-- Damage multiplier for a hit from `a` on `b`: the snapper's first hit on an ex-ally inside the
-- betrayal window deals bonus damage ("Pact Snap!"); a freshly betrayed contender takes less
-- from everyone else for a moment. Returns mult and whether this hit is the betrayal strike.
function Pacts.hitMult(s: State, r: Rules, a: string, b: string, now: number): (number, boolean)
	local m = 1
	local strike = false
	local bt = s.betrayals[a]
	if bt and not bt.used and now <= bt.untilT and table.find(bt.victims, b) then
		bt.used = true
		m *= r.betrayBonus
		strike = true
	end
	if not strike and (s.guardUntil[b] or -math.huge) > now then
		m *= r.guardMult
	end
	return m, strike
end

-- A contender is out of the match: leave their pact and cancel anything pending.
function Pacts.remove(s: State, id: string)
	leave(s, id)
	s.offers[id] = nil
	s.snaps[id] = nil
	for to, o in pairs(s.offers) do
		if o.from == id then
			s.offers[to] = nil
		end
	end
end

-- Final few: every pact ends at once. Returns the pacts that were dissolved.
function Pacts.endAll(s: State): { Pact }
	local out = {}
	for _, p in pairs(s.pacts) do
		table.insert(out, p)
	end
	s.pacts = {}
	s.memberOf = {}
	s.offers = {}
	s.snaps = {}
	s.ended = true
	return out
end

return Pacts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Party</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Party.luau: friend and family groups of up to 10 who queue together.

	  * Anyone can start a party by inviting someone in the server; the inviter leads.
	  * A party is never split by the queue: either everyone in it gets a seat or it waits for
	    the next match (fill() below), and party members share one lobby banner and a party
	    results card after every match.
	  * In public matches party members can still knock each other out (fair to solo players;
	    Reach partners and pacts work as usual). In private servers the owner can turn on
	    Family Rules: the whole party is allied until 4 are left, like Reach partners.
]]
local Party = {}

Party.MAX = 10

export type State = { nextId: number, of: { [number]: number }, members: { [number]: { number } }, leader: { [number]: number }, invites: { [number]: number } }

function Party.new(): State
	return { nextId = 1, of = {}, members = {}, leader = {}, invites = {} }
end

function Party.partyOf(s: State, user: number): number?
	return s.of[user]
end

function Party.membersOf(s: State, user: number): { number }
	local pid = s.of[user]
	return if pid then s.members[pid] else { user }
end

function Party.size(s: State, pid: number): number
	return #(s.members[pid] or {})
end

-- `from` invites `to`. Returns ok, message.
function Party.invite(s: State, from: number, to: number): (boolean, string?)
	if from == to then
		return false, "You can't invite yourself."
	end
	local pid = s.of[from]
	if pid and #s.members[pid] >= Party.MAX then
		return false, "Your party is full (" .. Party.MAX .. ")."
	end
	if pid and s.of[to] == pid then
		return false, "Already in your party."
	end
	s.invites[to] = from
	return true, nil
end

-- `user` accepts the invite waiting for them. Joins (or creates) the inviter's party.
function Party.accept(s: State, user: number): (boolean, string?)
	local from = s.invites[user]
	if not from then
		return false, "No invite waiting."
	end
	s.invites[user] = nil
	local pid: number = s.of[from] or 0
	if pid == 0 then
		pid = s.nextId
		s.nextId += 1
		s.members[pid] = { from }
		s.leader[pid] = from
		s.of[from] = pid
	end
	if #s.members[pid] >= Party.MAX then
		return false, "That party is full."
	end
	Party.leave(s, user)
	table.insert(s.members[pid], user)
	s.of[user] = pid
	return true, nil
end

-- Leaves the party. A party of one disbands; the next member leads if the leader leaves.
function Party.leave(s: State, user: number)
	local pid = s.of[user]
	if not pid then
		return
	end
	s.of[user] = nil
	local list = s.members[pid]
	local i = table.find(list, user)
	if i then
		table.remove(list, i)
	end
	if #list <= 1 then
		for _, u in ipairs(list) do
			s.of[u] = nil
		end
		s.members[pid] = nil
		s.leader[pid] = nil
	elseif s.leader[pid] == user then
		s.leader[pid] = list[1]
	end
end

-- Pick who goes into a match from a queue (user ids in queue order) without splitting a party:
-- a party only takes seats if every queued member fits.
function Party.fill(s: State, queue: { number }, cap: number): { number }
	local out: { number } = {}
	local taken: { [number]: boolean } = {}
	for _, u in ipairs(queue) do
		if not taken[u] then
			local group = {}
			local pid = s.of[u]
			if pid then
				for _, m in ipairs(queue) do
					if s.of[m] == pid and not taken[m] then
						table.insert(group, m)
					end
				end
			else
				group = { u }
			end
			if #out + #group <= cap then
				for _, m in ipairs(group) do
					table.insert(out, m)
					taken[m] = true
				end
			else
				for _, m in ipairs(group) do
					taken[m] = true -- skip the whole group this round
				end
			end
		end
	end
	return out
end

-- Family Rules (private servers only): party members can't hurt each other until `untilLeft`.
function Party.canHurt(s: State, a: number, b: number, alive: number, untilLeft: number, familyRules: boolean): boolean
	if not familyRules then
		return true
	end
	local pa, pb = s.of[a], s.of[b]
	if pa and pa == pb and alive > untilLeft then
		return false
	end
	return true
end

-- The party results card: members sorted by place, the best finish and the total knockouts.
export type Line = { name: string, place: number, knocks: number }
function Party.summary(lines: { Line }): { best: Line?, knocks: number, lines: { Line } }
	local sorted = table.clone(lines)
	table.sort(sorted, function(x: Line, y: Line): boolean
		return x.place < y.place
	end)
	local k = 0
	for _, l in ipairs(sorted) do
		k += l.knocks
	end
	return { best = sorted[1], knocks = k, lines = sorted }
end

return Party
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Policy</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Store rules from PolicyService:GetPolicyInfoForPlayerAsync, as a pure helper.
	Fail closed: until the policy loads (or if it never does), the shop stays hidden.
	This game sells no random items and nothing tradable, so in practice only the "not loaded"
	case hides things; the flags still gate any future item that sets `random` or `tradable`.
]]
local Policy = {}

export type Info = {
	loaded: boolean,
	paidRandomRestricted: boolean,
	tradingAllowed: boolean,
	adsAllowed: boolean,
	subscriptionAllowed: boolean,
	links: { string },
}
export type Sellable = { random: boolean?, tradable: boolean?, ad: boolean?, subscription: boolean? }

function Policy.unknown(): Info
	return { loaded = false, paidRandomRestricted = true, tradingAllowed = false, adsAllowed = false, subscriptionAllowed = false, links = {} }
end

-- Map the raw PolicyService table (keys can be missing) to our flags.
function Policy.fromRaw(raw: any): Info
	if type(raw) ~= "table" then
		return Policy.unknown()
	end
	local links = {}
	if type(raw.AllowedExternalLinkReferences) == "table" then
		for _, v in ipairs(raw.AllowedExternalLinkReferences) do
			if type(v) == "string" then
				table.insert(links, v)
			end
		end
	end
	return {
		loaded = true,
		-- missing = assume restricted
		paidRandomRestricted = raw.ArePaidRandomItemsRestricted ~= false,
		tradingAllowed = raw.IsPaidItemTradingAllowed == true,
		adsAllowed = raw.AreAdsAllowed == true,
		-- missing = not eligible (fail closed)
		subscriptionAllowed = raw.IsEligibleToPurchaseSubscription == true,
		links = links,
	}
end

function Policy.shopVisible(p: Info): boolean
	return p.loaded
end

function Policy.canSell(p: Info, item: Sellable): boolean
	if not p.loaded then
		return false
	end
	if item.random and p.paidRandomRestricted then
		return false
	end
	if item.tradable and not p.tradingAllowed then
		return false
	end
	if item.ad and not p.adsAllowed then
		return false
	end
	if item.subscription and not p.subscriptionAllowed then
		return false
	end
	return true
end

return Policy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Queue</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Lobby fill rules for a 48-contender match.
	  * Launch at once when 48 humans are queued.
	  * Otherwise, after `fillAfter` s with at least `minHumans`, or after `lateFillAfter` s with
	    at least `lateMinHumans`, launch and fill the rest with labeled Stand-In bots.
	  * A single server (v1) can only ever hold 50 people, so it uses the single-server rule.
]]
local Queue = {}

export type Rules = {
	fillAfter: number,
	minHumans: number,
	lateFillAfter: number,
	lateMinHumans: number,
	singleServerFillAfter: number,
	singleServerMinHumans: number,
}

function Queue.shouldLaunch(humans: number, waited: number, size: number, rules: Rules, singleServer: boolean): (boolean, string)
	if humans <= 0 then
		return false, "empty"
	end
	if humans >= size then
		return true, "full"
	end
	if singleServer then
		if waited >= rules.singleServerFillAfter and humans >= rules.singleServerMinHumans then
			return true, "single-server-fill"
		end
		return false, "waiting"
	end
	if waited >= rules.fillAfter and humans >= rules.minHumans then
		return true, "timer-fill"
	end
	if waited >= rules.lateFillAfter and humans >= rules.lateMinHumans then
		return true, "late-fill"
	end
	return false, "waiting"
end

-- Seconds left on the visible lobby timer (nil = waiting for more players).
function Queue.secondsLeft(humans: number, waited: number, size: number, rules: Rules, singleServer: boolean): number?
	if humans <= 0 then
		return nil
	end
	if humans >= size then
		return 0
	end
	if singleServer then
		return math.max(0, rules.singleServerFillAfter - waited)
	end
	if humans >= rules.minHumans then
		return math.max(0, rules.fillAfter - waited)
	end
	if humans >= rules.lateMinHumans then
		return math.max(0, rules.lateFillAfter - waited)
	end
	return nil
end

export type Entry = { id: string, reach: string?, partner: string? }
export type Slot = { id: string, reach: string, partner: string? }

--[[
	Assigns every entry a Reach with at most `per` contenders per Reach, keeping partners
	together. Entries are humans first (in queue order); `botIds` fill the rest.
	Returns slots in plate order: partners on neighbouring plates.
]]
function Queue.assign(entries: { Entry }, botIds: { string }, reaches: { string }, per: number): { Slot }
	local count: { [string]: number } = {}
	local byReach: { [string]: { string } } = {}
	local assigned: { [string]: string } = {}
	local function free(r: string): boolean
		return (count[r] or 0) < per
	end
	local function put(id: string, r: string)
		count[r] = (count[r] or 0) + 1
		byReach[r] = byReach[r] or {}
		table.insert(byReach[r], id)
		assigned[id] = r
	end
	local function firstFree(need: number): string?
		for _, r in ipairs(reaches) do
			if per - (count[r] or 0) >= need then
				return r
			end
		end
		return nil
	end
	local byId: { [string]: Entry } = {}
	for _, e in ipairs(entries) do
		byId[e.id] = e
	end
	-- partners first (both must agree)
	for _, e in ipairs(entries) do
		local p = e.partner
		if not assigned[e.id] and p and byId[p] and byId[p].partner == e.id and not assigned[p] then
			local want = e.reach
			local r = (want and per - (count[want] or 0) >= 2) and want or firstFree(2)
			if r then
				put(e.id, r)
				put(p, r)
			end
		end
	end
	for _, e in ipairs(entries) do
		if not assigned[e.id] then
			local want = e.reach
			local r = (want and free(want)) and want or firstFree(1)
			if r then
				put(e.id, r)
			end
		end
	end
	for _, b in ipairs(botIds) do
		local r = firstFree(1)
		if not r then
			break
		end
		put(b, r)
	end
	local slots: { Slot } = {}
	for _, r in ipairs(reaches) do
		local list = byReach[r]
		if list then
			for i, id in ipairs(list) do
				local other = list[3 - i]
				table.insert(slots, { id = id, reach = r, partner = other })
			end
		end
	end
	return slots
end

return Queue
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
-- Token bucket per key. `now` is passed in (server uses os.clock()) so it's testable.
local RateLimiter = {}
RateLimiter.__index = RateLimiter

export type Limiter = typeof(setmetatable({} :: { capacity: number, refill: number, buckets: { [any]: { tokens: number, t: number } } }, RateLimiter))

function RateLimiter.new(capacity: number, refillPerSecond: number): Limiter
	return setmetatable({ capacity = capacity, refill = refillPerSecond, buckets = {} }, RateLimiter)
end

function RateLimiter.allow(self: Limiter, key: any, now: number, cost: number?): boolean
	local c = cost or 1
	local b = self.buckets[key]
	if not b then
		b = { tokens = self.capacity, t = now }
		self.buckets[key] = b
	end
	b.tokens = math.min(self.capacity, b.tokens + (now - b.t) * self.refill)
	b.t = now
	if b.tokens >= c then
		b.tokens -= c
		return true
	end
	return false
end

function RateLimiter.forget(self: Limiter, key: any)
	self.buckets[key] = nil
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">ReachStandings</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Reach loyalty. Pick a home Reach once (change it once a week). Every win and top-5 finish by
	anyone repping that Reach adds points to the weekly server-wide table. The top 3 Reaches each
	week earn a cosmetic banner for everyone who played a match for them that week.
]]
local ReachStandings = {}

ReachStandings.POINTS = { win = 10, top5 = 3, knock = 1 }

export type Row = { reach: string, points: number }

function ReachStandings.add(tbl: { [string]: number }, reach: string, points: number)
	tbl[reach] = (tbl[reach] or 0) + points
end

function ReachStandings.sorted(tbl: { [string]: number }): { Row }
	local rows: { Row } = {}
	for r, p in pairs(tbl) do
		table.insert(rows, { reach = r, points = p })
	end
	table.sort(rows, function(a: Row, b: Row): boolean
		if a.points == b.points then
			return a.reach < b.reach
		end
		return a.points > b.points
	end)
	return rows
end

function ReachStandings.pointsFor(place: number, knocks: number): number
	local p = knocks * ReachStandings.POINTS.knock
	if place == 1 then
		p += ReachStandings.POINTS.win
	elseif place <= 5 then
		p += ReachStandings.POINTS.top5
	end
	return p
end

-- Banner for a finished week: top 3 Reaches by points (ties broken by name).
function ReachStandings.banners(tbl: { [string]: number }): { string }
	local out = {}
	for i, row in ipairs(ReachStandings.sorted(tbl)) do
		if i > 3 or row.points <= 0 then
			break
		end
		table.insert(out, row.reach)
	end
	return out
end

-- Players can change their home Reach once per week.
function ReachStandings.canChange(lastChangeWeek: number, week: number): boolean
	return lastChangeWeek < week
end

return ReachStandings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">ReceiptLedger</string>
            <string name="Source"><![CDATA[--!strict
-- Remembers recent PurchaseIds inside the player's saved data so ProcessReceipt is idempotent:
-- if Roblox calls us again for the same purchase, we don't grant twice.
local ReceiptLedger = {}

function ReceiptLedger.has(list: { string }, purchaseId: string): boolean
	for _, id in ipairs(list) do
		if id == purchaseId then
			return true
		end
	end
	return false
end

function ReceiptLedger.add(list: { string }, purchaseId: string, max: number)
	if ReceiptLedger.has(list, purchaseId) then
		return
	end
	table.insert(list, purchaseId)
	while #list > max do
		table.remove(list, 1)
	end
end

return ReceiptLedger
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Reconcile</string>
            <string name="Source"><![CDATA[--!strict
-- Deep-fills missing keys from a template so old saves gain new fields after an update.
local Reconcile = {}

local function deepCopy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, x in pairs(v) do
		out[k] = deepCopy(x)
	end
	return out
end
Reconcile.deepCopy = deepCopy

function Reconcile.fill(target: any, template: any): any
	if type(target) ~= "table" then
		return deepCopy(template)
	end
	for k, v in pairs(template) do
		if target[k] == nil then
			target[k] = deepCopy(v)
		elseif type(v) == "table" and type(target[k]) == "table" and next(v) ~= nil then
			Reconcile.fill(target[k], v)
		end
	end
	return target
end

return Reconcile
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">SeasonTrack</string>
            <string name="Source"><![CDATA[--!strict
--[[
	The Season Track: 30 tiers per season, earned by playing (Daybreak Stars).
	  * Free lane: every player gets every free reward by playing. Nothing random.
	  * Premium lane (optional game pass): extra cosmetics on the same tiers. It never
	    sells power, sells only Tier Skips (cosmetic rewards), and never expires mid-season.
	  * Every reward is shown before you earn it.
]]
local SeasonTrack = {}

export type Reward = { kind: string, id: string, name: string, amount: number? }
export type Tier = { free: Reward, premium: Reward }

SeasonTrack.SEASON = 1
SeasonTrack.SEASON_NAME = "Season 1: First Light"
SeasonTrack.TIERS = 30

local FREE_COSMETICS = {
	"Reach Pin", "Dawn Scarf", "Lantern Trail", "Wheat Crown", "Slate Cloak",
	"Copper Bracer", "Glow Arrows", "Meadow Charm", "Gallery Wave", "Sundial Frame",
}
local PREMIUM_COSMETICS = {
	"Gilded Sash", "Ember Cloak", "Daybreak Halo", "Candyfinch Pet", "Veil Shimmer Fade",
	"Spire Parade Coat", "Mirror Bow Skin", "Ashen Spear Skin", "Marigold Banner", "Sunrise Wings",
	"Regent Gold Fade", "Whisperwood Hood", "Star Lantern Pack", "Champion Plume", "Legend Aura",
}

local function id(s: string): string
	return (s:lower():gsub("%s+", "_"))
end

local tiers: { Tier } = {}
for t = 1, SeasonTrack.TIERS do
	local free: Reward
	if t % 3 == 0 then
		local name = FREE_COSMETICS[t // 3]
		free = { kind = "cosmetic", id = id(name), name = name }
	elseif t % 3 == 1 then
		free = { kind = "renown", id = "renown", name = "+150 Renown", amount = 150 }
	else
		free = { kind = "emote", id = "emote_" .. t, name = "Emote: " .. ({ "Bow", "Nod", "Wave", "Cheer", "Shrug", "Dance", "Twirl", "Clap", "Point", "Flex" })[(t // 3) % 10 + 1] }
	end
	local pname = PREMIUM_COSMETICS[math.min(#PREMIUM_COSMETICS, (t + 1) // 2)]
	local premium: Reward = { kind = "cosmetic", id = id(pname) .. "_" .. t, name = pname }
	tiers[t] = { free = free, premium = premium }
end
SeasonTrack.tiers = tiers

export type State = { season: number, stars: number, claimedFree: { [string]: boolean }, claimedPremium: { [string]: boolean } }

function SeasonTrack.new(season: number): State
	return { season = season, stars = 0, claimedFree = {}, claimedPremium = {} }
end

-- If a new season started, reset the track (owned cosmetics stay forever).
function SeasonTrack.ensure(s: State, season: number): boolean
	if s.season ~= season then
		s.season = season
		s.stars = 0
		s.claimedFree = {}
		s.claimedPremium = {}
		return true
	end
	return false
end

function SeasonTrack.tierFor(stars: number, perTier: number): number
	return math.clamp(stars // perTier, 0, SeasonTrack.TIERS)
end

function SeasonTrack.addStars(s: State, n: number, perTier: number): number
	local before = SeasonTrack.tierFor(s.stars, perTier)
	s.stars += math.max(0, math.floor(n))
	return SeasonTrack.tierFor(s.stars, perTier) - before
end

-- Claim one tier's reward. lane = "free" or "premium". Returns the reward or nil + reason.
function SeasonTrack.claim(s: State, tier: number, lane: string, hasPremium: boolean, perTier: number): (Reward?, string?)
	if tier < 1 or tier > SeasonTrack.TIERS then
		return nil, "No such tier."
	end
	if SeasonTrack.tierFor(s.stars, perTier) < tier then
		return nil, "Keep playing to reach this tier."
	end
	local key = tostring(tier)
	if lane == "free" then
		if s.claimedFree[key] then
			return nil, "Already claimed."
		end
		s.claimedFree[key] = true
		return tiers[tier].free, nil
	elseif lane == "premium" then
		if not hasPremium then
			return nil, "Premium lane is optional and not owned."
		end
		if s.claimedPremium[key] then
			return nil, "Already claimed."
		end
		s.claimedPremium[key] = true
		return tiers[tier].premium, nil
	end
	return nil, "Unknown lane."
end

-- Number of reached tiers whose rewards are waiting to be claimed.
function SeasonTrack.unclaimed(s: State, hasPremium: boolean, perTier: number): number
	local n = 0
	for t = 1, SeasonTrack.tierFor(s.stars, perTier) do
		if not s.claimedFree[tostring(t)] then
			n += 1
		end
		if hasPremium and not s.claimedPremium[tostring(t)] then
			n += 1
		end
	end
	return n
end

return SeasonTrack
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">SessionLock</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Session locking for DataStore records shaped { lock = {jobId, time}?, data = {...} }.
	A server may only write a record it holds the lock for. Locks are refreshed on every autosave;
	a lock older than `staleAfter` seconds is treated as abandoned (crashed server) and can be taken.
	These are the pure transform helpers used inside DataStore:UpdateAsync.
]]
local SessionLock = {}

export type Record = { lock: { jobId: string, time: number }?, data: any? }

-- Returns (newRecord or nil to cancel, status)
function SessionLock.acquire(old: Record?, jobId: string, now: number, staleAfter: number): (Record?, string)
	local rec: Record = old or { data = nil }
	local lock = rec.lock
	if lock and lock.jobId ~= jobId and (now - lock.time) < staleAfter then
		return nil, "locked"
	end
	local stolen = lock ~= nil and lock.jobId ~= jobId
	rec.lock = { jobId = jobId, time = now }
	return rec, stolen and "stale-taken" or "acquired"
end

function SessionLock.canWrite(old: Record?, jobId: string): boolean
	if old == nil then
		return true
	end
	local lock = (old :: Record).lock
	return lock == nil or lock.jobId == jobId
end

-- Transform for saves. `release` clears the lock (player left / server closing).
function SessionLock.save(old: Record?, jobId: string, now: number, data: any, release: boolean): (Record?, string)
	if not SessionLock.canWrite(old, jobId) then
		return nil, "lost-lock"
	end
	local rec: Record = { data = data, lock = nil }
	if not release then
		rec.lock = { jobId = jobId, time = now }
	end
	return rec, "saved"
end

return SessionLock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Sponsors</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Sponsor letters: a small daily package from the patrons you've won over.
	  * Patrons sign on when you hit a milestone (first top 10, first win, 10 knockouts, ...).
	    "Your home Reach" always writes, so every player gets a letter.
	  * One letter a day (UTC), whether you play or not. Unclaimed letters stack up to `maxStack`
	    so a weekend away still has something waiting, but missing days never takes anything.
	  * A letter holds Renown XP + a Favor head start for the next Viewing Gallery visit. Every
	    `cosmeticEvery`-th letter also carries a cosmetic from a fixed list, in order.
	  * Nothing here is random and nothing is sold.
]]
local Sponsors = {}

export type Patron = { id: string, name: string, stat: string, need: number, renown: number, favor: number }
export type Letters = { lastDay: number, waiting: number, claimed: number }
export type Package = { letters: number, renown: number, favor: number, cosmetics: { string }, from: { string } }

-- Which patrons have signed on, given lifetime stats.
function Sponsors.earned(patrons: { Patron }, stats: { [string]: number }): { Patron }
	local out = {}
	for _, p in ipairs(patrons) do
		if p.need <= 0 or (stats[p.stat] or 0) >= p.need then
			table.insert(out, p)
		end
	end
	return out
end

-- The next patron you could win over (for the "next sponsor" hint), or nil.
function Sponsors.nextPatron(patrons: { Patron }, stats: { [string]: number }): Patron?
	for _, p in ipairs(patrons) do
		if p.need > 0 and (stats[p.stat] or 0) < p.need then
			return p
		end
	end
	return nil
end

-- Deliver letters for the days since the last delivery. Returns how many arrived.
function Sponsors.accrue(l: Letters, today: number, maxStack: number): number
	if l.lastDay >= today then
		return 0
	end
	local days = if l.lastDay < 0 then 1 else today - l.lastDay
	local before = l.waiting
	l.waiting = math.min(maxStack, l.waiting + days)
	l.lastDay = today
	return l.waiting - before
end

-- Open every waiting letter. Cosmetics already owned are skipped (you get the next one).
function Sponsors.claim(l: Letters, signed: { Patron }, cosmeticList: { string }, cosmeticEvery: number, owned: { [string]: boolean }): Package
	local pkg: Package = { letters = 0, renown = 0, favor = 0, cosmetics = {}, from = {} }
	for _, p in ipairs(signed) do
		table.insert(pkg.from, p.name)
	end
	while l.waiting > 0 do
		l.waiting -= 1
		l.claimed += 1
		pkg.letters += 1
		for _, p in ipairs(signed) do
			pkg.renown += p.renown
			pkg.favor += p.favor
		end
		if cosmeticEvery > 0 and l.claimed % cosmeticEvery == 0 then
			for _, id in ipairs(cosmeticList) do
				if not owned[id] and not table.find(pkg.cosmetics, id) then
					table.insert(pkg.cosmetics, id)
					break
				end
			end
		end
	end
	return pkg
end

return Sponsors
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Stamina</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Server-owned stamina and a simple movement sanity check.
	The client only says "I want to sprint"; the server drains/refills stamina, sets WalkSpeed,
	and rubber-bands anyone who moves much faster than their speed allows for a few seconds.
]]
local Stamina = {}

export type Rules = { max: number, drain: number, regen: number, resume: number }
export type S = { value: number, wants: boolean, sprinting: boolean, tired: boolean }

function Stamina.new(r: Rules): S
	return { value = r.max, wants = false, sprinting = false, tired = false }
end

-- One step. `moving` = actually moving; `regenMult` = 1 + bonuses (Trail Boots in casual).
function Stamina.step(s: S, r: Rules, dt: number, moving: boolean, regenMult: number): S
	if s.tired and s.value >= r.resume then
		s.tired = false
	end
	if s.wants and moving and not s.tired and s.value > 0 then
		s.sprinting = true
		s.value = math.max(0, s.value - r.drain * dt)
		if s.value <= 0 then
			s.tired = true
			s.sprinting = false
		end
	else
		s.sprinting = false
		s.value = math.min(r.max, s.value + r.regen * regenMult * dt)
	end
	return s
end

function Stamina.add(s: S, r: Rules, amount: number)
	s.value = math.clamp(s.value + amount, 0, r.max)
end

-- Horizontal distance moved in `dt` seconds vs. the fastest legal speed.
function Stamina.tooFast(dist: number, dt: number, maxSpeed: number, slack: number, grace: number): boolean
	return dist > maxSpeed * dt * slack + grace
end

return Stamina
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Streak</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Forgiving daily streak.
	  * Counts once per UTC day you finish at least one match.
	  * Miss exactly one day? Your one free miss for the week covers it automatically.
	  * Miss more? You drop back to the first day of your current 7-day week, never to zero.
]]
local Streak = {}

export type State = { lastDay: number, count: number, best: number, freeMissWeek: number }

local function weekOf(day: number): number
	return math.floor((day + 3) / 7)
end

function Streak.new(): State
	return { lastDay = -1, count = 0, best = 0, freeMissWeek = -1 }
end

function Streak.canClaim(s: State, today: number): boolean
	return s.lastDay ~= today
end

export type Result = { ok: boolean, count: number, cycleDay: number, week: number, usedFreeMiss: boolean, softReset: boolean }

function Streak.claim(s: State, today: number): Result
	if s.lastDay == today then
		return { ok = false, count = s.count, cycleDay = ((s.count - 1) % 7) + 1, week = math.ceil(s.count / 7), usedFreeMiss = false, softReset = false }
	end
	local usedFreeMiss, softReset = false, false
	local gap = today - s.lastDay
	if s.lastDay < 0 or s.count <= 0 then
		s.count = 1
	elseif gap == 1 then
		s.count += 1
	elseif gap == 2 and s.freeMissWeek ~= weekOf(today) then
		s.count += 1
		s.freeMissWeek = weekOf(today)
		usedFreeMiss = true
	elseif gap <= 0 then
		-- clock went backwards; treat as same streak, no reward abuse
		s.lastDay = today
		return { ok = false, count = s.count, cycleDay = ((s.count - 1) % 7) + 1, week = math.ceil(s.count / 7), usedFreeMiss = false, softReset = false }
	else
		-- soft reset to the start of the current week of the streak
		s.count = s.count - ((s.count - 1) % 7)
		softReset = true
	end
	s.lastDay = today
	s.best = math.max(s.best, s.count)
	return { ok = true, count = s.count, cycleDay = ((s.count - 1) % 7) + 1, week = math.ceil(s.count / 7), usedFreeMiss = usedFreeMiss, softReset = softReset }
end

-- Renown scales gently with how many weeks you've kept it going (caps at week 4).
function Streak.rewardScale(count: number): number
	local tier = math.clamp(math.ceil(math.max(1, count) / 7), 1, 4)
	return 1 + 0.5 * (tier - 1)
end

return Streak
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Throw</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Spear throw path, as pure 2D-in-XZ math, plus the Veil bounce used by the Veil Breaker finale.
	The server walks the path in short segments: if a segment leaves the Veil circle, the spear
	reflects off the wall (once per `bounces`) and continues with whatever range is left.
]]
local Throw = {}

export type V = { x: number, z: number }
export type Leg = { from: V, to: V, bounced: boolean }

local function len(v: V): number
	return math.sqrt(v.x * v.x + v.z * v.z)
end

-- Where does the ray from `p` along unit `d` cross the circle of radius `r` (center origin)?
-- Assumes p is inside. Returns distance along the ray.
function Throw.exitDistance(p: V, d: V, r: number): number
	local b = p.x * d.x + p.z * d.z
	local c = p.x * p.x + p.z * p.z - r * r
	local disc = b * b - c
	if disc < 0 then
		return 0
	end
	return -b + math.sqrt(disc)
end

-- Split a throw into legs, bouncing off the Veil up to `bounces` times.
function Throw.legs(from: V, dir: V, range: number, radius: number, bounces: number): { Leg }
	local out: { Leg } = {}
	local l = len(dir)
	if l < 1e-6 or range <= 0 then
		return out
	end
	local d = { x = dir.x / l, z = dir.z / l }
	local p = { x = from.x, z = from.z }
	local left = range
	local bounced = false
	local n = 0
	while left > 0.01 do
		local inside = len(p) < radius
		local hitAt = if inside then Throw.exitDistance(p, d, radius) else math.huge
		if inside and hitAt < left and n < bounces then
			local q = { x = p.x + d.x * hitAt, z = p.z + d.z * hitAt }
			table.insert(out, { from = p, to = q, bounced = bounced })
			-- reflect around the wall normal (pointing outward)
			local nl = len(q)
			local nx, nz = q.x / nl, q.z / nl
			local dot = d.x * nx + d.z * nz
			d = { x = d.x - 2 * dot * nx, z = d.z - 2 * dot * nz }
			p = { x = q.x - nx * 0.5, z = q.z - nz * 0.5 }
			left -= hitAt
			bounced = true
			n += 1
		else
			local q = { x = p.x + d.x * left, z = p.z + d.z * left }
			table.insert(out, { from = p, to = q, bounced = bounced })
			left = 0
		end
	end
	return out
end

-- Distance from point c to segment ab (XZ).
function Throw.segDist(a: V, b: V, c: V): number
	local abx, abz = b.x - a.x, b.z - a.z
	local L = abx * abx + abz * abz
	local t = 0
	if L > 0 then
		t = math.clamp(((c.x - a.x) * abx + (c.z - a.z) * abz) / L, 0, 1)
	end
	local px, pz = a.x + abx * t - c.x, a.z + abz * t - c.z
	return math.sqrt(px * px + pz * pz)
end

return Throw
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">TimeUtil</string>
            <string name="Source"><![CDATA[--!strict
-- Day and week numbers (UTC) used by streaks, challenges, weekly rules and Reach standings.
local TimeUtil = {}

function TimeUtil.day(t: number): number
	return math.floor(t / 86400)
end

-- Weeks start on Monday (1970-01-01 was a Thursday, hence the +3).
function TimeUtil.week(t: number): number
	return math.floor((TimeUtil.day(t) + 3) / 7)
end

function TimeUtil.clock(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", s // 60, s % 60)
end

-- Small deterministic hash so every server picks the same daily challenges and twists.
function TimeUtil.hash(n: number): number
	local x = (n * 2654435761) % 4294967296
	return math.floor(x)
end

return TimeUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Training</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Pregame training: a 6-second target round, then a score from 1 to 10 shown to everyone.
	Targets are seeded by the server (same seed on every client), clicks are checked against the
	target windows, and the score is cosmetic plus one small catch-up rule: a low score makes
	Gallery gifts to you a bit cheaper, so there's no reason to fake a high one.
]]
local Training = {}

export type Target = { i: number, x: number, y: number, at: number, life: number }
export type Click = { i: number, t: number }

local function lcg(s: number): number
	return (s * 1103515245 + 12345) % 2147483648
end

function Training.targets(seed: number, n: number, duration: number): { Target }
	local out = {}
	local s = math.floor(seed) % 2147483648
	local gap = duration / (n + 1)
	for i = 1, n do
		s = lcg(s)
		local x = 0.15 + (s % 7000) / 10000
		s = lcg(s)
		local y = 0.25 + (s % 5000) / 10000
		table.insert(out, { i = i, x = x, y = y, at = gap * (i - 1) + 0.4, life = 1.6 })
	end
	return out
end

-- Score: 2 per hit (5 targets -> 10), +1 if your average reaction is under 0.6 s, from 1 to `max`.
function Training.score(targets: { Target }, clicks: { Click }, max: number): (number, number)
	local hit: { [number]: number } = {}
	local hits, react = 0, 0
	for _, c in ipairs(clicks) do
		local tg = targets[c.i]
		if tg and not hit[c.i] and type(c.t) == "number" and c.t >= tg.at and c.t <= tg.at + tg.life then
			hit[c.i] = c.t
			hits += 1
			react += c.t - tg.at
		end
	end
	local score = hits * 2
	if hits > 0 and react / hits < 0.6 then
		score += 1
	end
	return math.clamp(score, 1, max), hits
end

-- Stand-Ins get a steady, deterministic score (3..8) so the board isn't all bots at the top.
function Training.botScore(seed: number, id: string): number
	local h = seed
	for k = 1, #id do
		h = lcg(h + string.byte(id, k))
	end
	return 3 + h % 6
end

-- Underdog rule for Gallery gift prices.
function Training.giftMult(score: number?, underdogAt: number, mult: number): number
	if score and score <= underdogAt then
		return mult
	end
	return 1
end

return Training
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Twists</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Arena twists. Every match rolls one small twist from the week's pool, and every week has a
	Jubilee Rule that applies to all matches (shown in the lobby and on the Season board).
	Twists change the arena, never the shop; all are free and all are announced before launch.
]]
-- Same hash as TimeUtil.hash (kept local so this module has no requires and runs in Lune tests).
local function hash(n: number): number
	return math.floor((n * 2654435761) % 4294967296)
end

local Twists = {}

export type Twist = { id: string, name: string, text: string, mods: { [string]: number } }

Twists.MATCH = {
	{ id = "longbows", name = "Long Bows", text = "Bows reach 25% farther.", mods = { bowRange = 1.25 } },
	{ id = "feast", name = "Feast Crates", text = "Twice as many snacks in crates.", mods = { snacks = 2 } },
	{ id = "quickveil", name = "Quick Veil", text = "The Veil moves 15% sooner.", mods = { veil = 0.85 } },
	{ id = "twilight", name = "Twilight Arena", text = "The arena starts at dusk. Lanterns glow.", mods = { clock = 18.6 } },
	{ id = "featherfall", name = "Featherfall", text = "Lower gravity. Big jumps!", mods = { gravity = 0.6 } },
	{ id = "finchday", name = "Finch Day", text = "Candyfinches come twice.", mods = { finches = 2 } },
	{ id = "richhub", name = "Golden Sundial", text = "Extra crates at the Sundial.", mods = { hubCrates = 1.5 } },
	{ id = "fog", name = "Morning Fog", text = "Thick fog until the first Veil shrink.", mods = { fog = 1 } },
} :: { Twist }

Twists.WEEKLY = {
	{ id = "w_gallery", name = "Gallery Week", text = "Gifts cost 25% less Favor.", mods = { giftCost = 0.75 } },
	{ id = "w_tokens", name = "Token Hunt", text = "6 Jubilee Tokens per arena instead of 4.", mods = { tokens = 6 } },
	{ id = "w_encore", name = "Double Encore", text = "The Gallery votes two contenders back in.", mods = { encores = 2 } },
	{ id = "w_stars", name = "Starfall", text = "+1 Daybreak Star for every match.", mods = { bonusStars = 1 } },
} :: { Twist }

function Twists.weekly(week: number): Twist
	return Twists.WEEKLY[(week % #Twists.WEEKLY) + 1]
end

-- Match twist from a match counter + week (different every match, same across servers by seed).
function Twists.forMatch(matchNo: number, week: number): Twist
	local h = hash(week * 97 + matchNo)
	return Twists.MATCH[((h // 4096) % #Twists.MATCH) + 1]
end

function Twists.mod(list: { Twist }, key: string, default: number): number
	local v = default
	for _, t in ipairs(list) do
		local m = t.mods[key]
		if m ~= nil then
			if key == "tokens" or key == "encores" or key == "clock" or key == "fog" or key == "bonusStars" then
				v = m
			else
				v *= m
			end
		end
	end
	return v
end

return Twists
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Veil</string>
            <string name="Source"><![CDATA[--!strict
-- The Veil (force field) timeline: radius over time, warnings and damage.
local Veil = {}

export type Phase = { at: number, from: number, to: number, dur: number }

function Veil.radiusAt(t: number, phases: { Phase }, startRadius: number): number
	local r = startRadius
	for _, p in ipairs(phases) do
		if t < p.at then
			return r
		elseif t < p.at + p.dur then
			local a = (t - p.at) / p.dur
			return p.from + (p.to - p.from) * a
		else
			r = p.to
		end
	end
	return r
end

-- 0 before the first shrink starts, 1 during/after phase 1, and so on.
function Veil.phaseIndex(t: number, phases: { Phase }): number
	local idx = 0
	for i, p in ipairs(phases) do
		if t >= p.at then
			idx = i
		end
	end
	return idx
end

-- Seconds until the next shrink starts (nil when no more shrinks), and that phase's target radius.
function Veil.nextShrink(t: number, phases: { Phase }): (number?, number?)
	for _, p in ipairs(phases) do
		if t < p.at then
			return p.at - t, p.to
		end
	end
	return nil, nil
end

function Veil.isShrinking(t: number, phases: { Phase }): boolean
	for _, p in ipairs(phases) do
		if t >= p.at and t < p.at + p.dur then
			return true
		end
	end
	return false
end

function Veil.damage(t: number, phases: { Phase }, table_: { number }): number
	local i = Veil.phaseIndex(t, phases) + 1
	return table_[math.min(i, #table_)]
end

-- A twist can speed the whole timeline up (e.g. Quick Veil = 0.85).
function Veil.scaled(phases: { Phase }, k: number): { Phase }
	local out = {}
	for _, p in ipairs(phases) do
		table.insert(out, { at = math.floor(p.at * k), from = p.from, to = p.to, dur = math.max(10, math.floor(p.dur * k)) })
	end
	return out
end

function Veil.outside(dx: number, dz: number, radius: number): boolean
	return dx * dx + dz * dz > radius * radius
end

return Veil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Vote</string>
            <string name="Source"><![CDATA[--!strict
-- Gallery votes (hazard cards and Encore vote-backs). One vote per spectator; ties go to the
-- option listed first so results are deterministic and explainable.
local Vote = {}

export type Ballot = { options: { string }, votes: { [string]: string } }

function Vote.new(options: { string }): Ballot
	return { options = options, votes = {} }
end

function Vote.cast(b: Ballot, voter: string, option: string): boolean
	if not table.find(b.options, option) then
		return false
	end
	b.votes[voter] = option
	return true
end

function Vote.counts(b: Ballot): { [string]: number }
	local c: { [string]: number } = {}
	for _, o in ipairs(b.options) do
		c[o] = 0
	end
	for _, o in pairs(b.votes) do
		c[o] = (c[o] or 0) + 1
	end
	return c
end

function Vote.winner(b: Ballot): (string, number)
	local c = Vote.counts(b)
	local best, n = b.options[1], -1
	for _, o in ipairs(b.options) do
		if c[o] > n then
			best, n = o, c[o]
		end
	end
	return best, n
end

return Vote
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">Look</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Look — the realism asset spec, in code. Every ID here is 0 until Mike drops real assets in
	from Studio / the Creator Store (we can't upload meshes from the build box). PUBLISHING.md
	has the same table with what to search for and where each one goes.

	What happens at runtime (LookService):
	  * NPCs (Rusty, Herald Marigold Vane, Monty Gleam): if `body` IDs are set, the part-built
	    stand-in is swapped for a real R15 rig made from a HumanoidDescription: realistic body
	    bundle parts, a Dynamic Head (FACS expressions via FaceControls) and layered clothing.
	    With IDs still 0 they keep the realistic part-built body from MapBuilder.npc.
	  * Stand-Ins (bots): always a real R15 rig (so they walk and animate). With no body IDs the
	    rig is hidden and the realistic part-built body is welded onto it limb by limb, so they
	    never look like default blocky mannequins.
	  * MaterialVariants: created and set as base-material overrides when a colorMap is set.
	  * Ground: converted to Terrain grass (animated grass blades) when `terrainGrass` is on.
	  * Player avatars: scales nudged toward realistic proportions (`playerScales`).
]]
local Look = {}

-- Turn the realism runtime features on/off.
Look.terrainGrass = true -- swap the arena's ground tiles for Terrain grass with decoration
Look.nudgeAvatars = true -- clamp player avatar scales toward realistic proportions

-- Player avatar scale clamps (Roblox ranges: Height 0.9–1.05, Width 0.7–1, Head 0.95–1,
-- BodyType 0–1 (1 = Rthro / realistic), Proportion 0–1 (0 = classic, 1 = slender)).
Look.playerScales = {
	bodyTypeMin = 0.6,
	headMax = 1.0,
	headMin = 0.95,
	widthMin = 0.85,
	proportionMax = 0.5,
}

export type Expression = { [string]: number } -- FaceControls property -> 0..1
export type NpcSpec = {
	-- body parts from a realistic body bundle (e.g. a Rthro / "realistic" bundle): asset IDs
	body: { head: number, torso: number, leftArm: number, rightArm: number, leftLeg: number, rightLeg: number },
	dynamicHead: number, -- a Dynamic Head asset (has FaceControls for FACS expressions)
	hair: { number }, -- hair accessories (layered or rigid)
	layered: { { id: number, kind: string, order: number } }, -- layered clothing: Shirt, Jacket, Pants, Shoes...
	accessories: { number }, -- rigid accessories (hat, glasses, thermos handle...)
	idle: number, -- idle animation asset (0 = default)
	skin: string,
	scales: { height: number, width: number, head: number, bodyType: number, proportion: number },
	expression: Expression,
}

local function blankBody()
	return { head = 0, torso = 0, leftArm = 0, rightArm = 0, leftLeg = 0, rightLeg = 0 }
end

Look.NPCS = {
	-- Rusty Dunmore: scruffy mentor, 40s. Search: "realistic man body", "stubble beard",
	-- "messy grown-out hair", "open plaid flannel jacket (layered)", "faded tee (layered)",
	-- "work boots (layered)", "worn jeans (layered)".
	Rusty = {
		body = blankBody(),
		dynamicHead = 0,
		hair = { 0 },
		layered = { { id = 0, kind = "TShirt", order = 1 }, { id = 0, kind = "Jacket", order = 3 }, { id = 0, kind = "Pants", order = 2 }, { id = 0, kind = "Shoes", order = 1 } },
		accessories = { 0 },
		idle = 0,
		skin = "#C49272",
		scales = { height = 1.03, width = 0.97, head = 0.95, bodyType = 1, proportion = 0.2 },
		expression = { LeftLipCornerPuller = 0.35, RightLipCornerPuller = 0.1, LeftBrowLowerer = 0.15, RightOuterBrowRaiser = 0.2 },
	},
	-- Herald Marigold Vane: Capital escort. Search: "realistic woman body", "copper hair bun",
	-- "tailored long coat (layered)", "pearl necklace", "heeled boots (layered)".
	Herald = {
		body = blankBody(),
		dynamicHead = 0,
		hair = { 0 },
		layered = { { id = 0, kind = "Shirt", order = 1 }, { id = 0, kind = "Jacket", order = 3 }, { id = 0, kind = "Pants", order = 2 }, { id = 0, kind = "Shoes", order = 1 } },
		accessories = { 0 },
		idle = 0,
		skin = "#E2B99A",
		scales = { height = 0.98, width = 0.88, head = 0.95, bodyType = 1, proportion = 0.6 },
		expression = { LeftLipCornerPuller = 0.6, RightLipCornerPuller = 0.6, LeftCheekRaiser = 0.2, RightCheekRaiser = 0.2 },
	},
	-- Monty Gleam: TV host, 50s. Search: "realistic man body", "slicked-back grey hair",
	-- "suit jacket (layered)", "dress shirt and tie (layered)", "suit trousers", "oxford shoes".
	Monty = {
		body = blankBody(),
		dynamicHead = 0,
		hair = { 0 },
		layered = { { id = 0, kind = "Shirt", order = 1 }, { id = 0, kind = "Jacket", order = 3 }, { id = 0, kind = "Pants", order = 2 }, { id = 0, kind = "Shoes", order = 1 } },
		accessories = { 0 },
		idle = 0,
		skin = "#B98466",
		scales = { height = 1.04, width = 0.92, head = 0.95, bodyType = 1, proportion = 0.4 },
		expression = { LeftLipCornerPuller = 0.8, RightLipCornerPuller = 0.8, LeftCheekRaiser = 0.4, RightCheekRaiser = 0.4, JawDrop = 0.1 },
	},
} :: { [string]: NpcSpec }

-- Stand-In bots: pools mixed per bot. Add several of each so the field looks varied.
Look.STAND_IN = {
	bodies = {} :: { { head: number, torso: number, leftArm: number, rightArm: number, leftLeg: number, rightLeg: number } },
	dynamicHeads = {} :: { number },
	hair = {} :: { number },
	tops = {} :: { number }, -- layered jackets / shirts
	bottoms = {} :: { number }, -- layered pants
	shoes = {} :: { number }, -- layered shoes / boots
	scales = { height = { 0.96, 1.05 }, width = { 0.85, 1 }, head = 0.95, bodyType = 1, proportion = { 0.1, 0.5 } },
}

-- PBR MaterialVariants (texture IDs from the Creator Store "PBR" packs or your own scans).
export type Variant = { base: string, colorMap: string, normalMap: string, roughnessMap: string, metalnessMap: string, studsPerTile: number }
Look.MATERIALS = {
	WeatheredWood = { base = "WoodPlanks", colorMap = "", normalMap = "", roughnessMap = "", metalnessMap = "", studsPerTile = 8 },
	RustedMetal = { base = "CorrodedMetal", colorMap = "", normalMap = "", roughnessMap = "", metalnessMap = "", studsPerTile = 6 },
	WornStone = { base = "Limestone", colorMap = "", normalMap = "", roughnessMap = "", metalnessMap = "", studsPerTile = 10 },
	OldCobbles = { base = "Cobblestone", colorMap = "", normalMap = "", roughnessMap = "", metalnessMap = "", studsPerTile = 10 },
	MeadowGrass = { base = "LeafyGrass", colorMap = "", normalMap = "", roughnessMap = "", metalnessMap = "", studsPerTile = 12 },
	TrailDirt = { base = "Mud", colorMap = "", normalMap = "", roughnessMap = "", metalnessMap = "", studsPerTile = 12 },
} :: { [string]: Variant }

-- Terrain colors once the ground is converted (desaturated, filmic).
Look.TERRAIN = {
	Grass = "#6B7247",
	Ground = "#5E5A50",
	Mud = "#5A5246",
	LeafyGrass = "#6E7448",
}

-- Optional vegetation meshes (MeshPart asset IDs) to replace the part-built tufts/bushes/trees.
Look.VEGETATION = { grassClump = 0, fern = 0, bush = 0, pine = 0, oak = 0, reeds = 0 }

-- Does a spec have real assets yet?
function Look.hasBody(b: { head: number, torso: number, leftArm: number, rightArm: number, leftLeg: number, rightLeg: number }?): boolean
	return b ~= nil and b.torso ~= 0 and b.leftLeg ~= 0 and b.rightLeg ~= 0
end

-- Clamp avatar scales toward realistic proportions. Returns the new values and whether any changed.
function Look.clampScales(height: number, width: number, head: number, bodyType: number, proportion: number): (number, number, number, number, number, boolean)
	local P = Look.playerScales
	local nh = height
	local nw = math.max(width, P.widthMin)
	local nhead = math.clamp(head, P.headMin, P.headMax)
	local nb = math.max(bodyType, P.bodyTypeMin)
	local np = math.min(proportion, P.proportionMax)
	local changed = nw ~= width or nhead ~= head or nb ~= bodyType or np ~= proportion
	return nh, nw, nhead, nb, np, changed
end

-- Which R15 limb a part of the part-built body should follow (for welding onto a rig).
-- `x`, `y` are in body space (feet at y = 0, body ~6 units tall, -x = left).
function Look.limbFor(name: string, x: number, y: number): string
	for _, limb in ipairs({ "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot", "UpperTorso", "LowerTorso", "Head" }) do
		if string.sub(name, 1, #limb) == limb then
			return limb
		end
	end
	if y >= 5.0 then
		return "Head"
	elseif y >= 3.5 then
		return "UpperTorso"
	elseif y >= 2.75 or math.abs(x) < 0.12 then
		return "LowerTorso"
	end
	local side = x < 0 and "Left" or "Right"
	if y >= 1.6 then
		return side .. "UpperLeg"
	elseif y >= 0.36 then
		return side .. "LowerLeg"
	end
	return side .. "Foot"
end

return Look
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--!nocheck
--[[
	MapBuilder — builds the whole world out of plain Parts (no uploaded assets needed):
	  * the 2400-stud arena: the golden Sundial hub (no horn of plenty), 48 lift plates, the
	    Gilded Meadow, Mirror Lake, Whisperwood, Ashen Ridge, Old Glassford ruins, scattered crates,
	    24 token spots and the Veil dome;
	  * the Viewing Gallery lounge floating above the hub;
	  * the lobby: the Reach square with the Harvesting stage, glass globe, jumbotron, Herald,
	    Rusty, camera marks for the reaping cutscene, the Draw Gate queue, boards and a range.
	It only uses Instance.new + datatypes passed in through `env`, so it runs both in Roblox (the
	server builds the map at startup if Workspace.Map is missing) and in Lune (scripts/bake-map
	bakes it into DaybreakOnTheHarvesting.rbxlx so it shows in Studio edit mode and in renders).
]]
local MapBuilder = {}

local E -- env (Roblox globals)

function MapBuilder.setEnv(env)
	E = env
end

local function hex(h)
	return E.Color3.fromHex(h)
end

local function part(parent, name, size, cf, color, material, props)
	local p = E.Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = hex(color)
	p.Material = material or E.Enum.Material.SmoothPlastic
	p.TopSurface = E.Enum.SurfaceType.Smooth
	p.BottomSurface = E.Enum.SurfaceType.Smooth
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end
MapBuilder.part = part

local function model(parent, name)
	local m = E.Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function folder(parent, name)
	local f = E.Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function V(x, y, z)
	return E.Vector3.new(x, y, z)
end

local function lookAt(a, b)
	if E.CFrame.lookAt then
		return E.CFrame.lookAt(a, b)
	end
	return E.CFrame.new(a, b)
end

local function cyl(parent, name, length, diameter, cf, color, material, props)
	-- Roblox cylinders run along X. `cf` is the center.
	local p = part(parent, name, V(length, diameter, diameter), cf, color, material, props)
	p.Shape = E.Enum.PartType.Cylinder
	return p
end

local function _ball(parent, name, d, cf, color, material, props)
	local p = part(parent, name, V(d, d, d), cf, color, material, props)
	p.Shape = E.Enum.PartType.Ball
	return p
end

local function prompt(parent, kind, action, object, hold, dist, extra)
	local pp = E.Instance.new("ProximityPrompt")
	pp.Name = "Prompt"
	pp.ActionText = action
	pp.ObjectText = object or ""
	pp.HoldDuration = hold or 0
	pp.MaxActivationDistance = dist or 10
	pp.RequiresLineOfSight = false
	pp:SetAttribute("Kind", kind)
	if extra then
		for k, v in pairs(extra) do
			pp[k] = v
		end
	end
	pp.Parent = parent
	return pp
end
MapBuilder.prompt = prompt

local function surfaceText(p, face, text, textColor, bg, font)
	local sg = E.Instance.new("SurfaceGui")
	sg.Name = "SignGui"
	sg.Face = face or E.Enum.NormalId.Front
	sg.SizingMode = E.Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.Parent = p
	local tl = E.Instance.new("TextLabel")
	tl.Name = "Text"
	tl.Size = E.UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = bg and 0 or 1
	if bg then
		tl.BackgroundColor3 = hex(bg)
	end
	tl.TextColor3 = hex(textColor or "#FFFFFF")
	tl.Font = font or E.Enum.Font.FredokaOne
	tl.TextScaled = true
	tl.Text = text
	tl.Parent = sg
	return tl
end
MapBuilder.surfaceText = surfaceText

-- `studs` (optional {w, h}) sizes the label in world studs instead of pixels, so labels on
-- closely spaced things (smoker row, grill spots, customer tables) shrink with distance
-- instead of piling on top of each other.
local function billboard(adornee, name, text, offsetY, maxDist, color, w, h, studs: { number }?)
	local b = E.Instance.new("BillboardGui")
	b.Name = name
	if studs then
		b.Size = E.UDim2.new(studs[1], 0, studs[2], 0)
	else
		b.Size = E.UDim2.new(0, w or 160, 0, h or 40)
	end
	b.StudsOffset = V(0, offsetY or 3, 0)
	b.AlwaysOnTop = false
	b.MaxDistance = maxDist or 80
	b.LightInfluence = 0
	b.Parent = adornee
	local tl = E.Instance.new("TextLabel")
	tl.Name = "Text"
	tl.Size = E.UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.TextColor3 = hex(color or "#FFFFFF")
	tl.TextStrokeTransparency = 0.3
	tl.Font = E.Enum.Font.FredokaOne
	tl.TextScaled = true
	tl.Text = text
	tl.Parent = b
	return b
end
MapBuilder.billboard = billboard

-- Decorative parts: no collision, query or touch (shadow is opt-in).
local function deco(parent, name, size, cf, color, material, shadow)
	return part(parent, name, size, cf, color, material, { CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = shadow == true })
end
local function dball(parent, name, d, cf, color, material, shadow)
	local p = deco(parent, name, V(d, d, d), cf, color, material, shadow)
	p.Shape = E.Enum.PartType.Ball
	return p
end
local function _dcyl(parent, name, length, diameter, cf, color, material, shadow)
	local p = deco(parent, name, V(length, diameter, diameter), cf, color, material, shadow)
	p.Shape = E.Enum.PartType.Cylinder
	return p
end

local function _upright()
	return E.CFrame.Angles(0, 0, math.pi / 2) -- turns an X-axis cylinder upright
end

-- Ellipsoid part (a Part with a Sphere SpecialMesh) for soft, round shapes.
local function sph(parent, name, size, cf, color, material, props)
	local p = part(parent, name, size, cf, color, material, props)
	local mesh = E.Instance.new("SpecialMesh")
	mesh.MeshType = E.Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

-- A realistically proportioned human (about 7.5 heads tall, R15 part names) built from parts,
-- so the world reads as people, not toys, even before real meshes are swapped in.
-- This is a stand-in: LookService replaces it at runtime with a real R15 rig (Dynamic Head with
-- FACS expressions + layered clothing) for every NPC whose asset IDs are filled in Look.luau.
-- Feet at `cf`, facing -Z. Returns model, Head, UpperTorso.
-- Options: skin, shirt, pants, shoes, hair, hairStyle ("short" | "messy" | "bun" | "slick" |
-- "long" | "bald"), coat, coatLong, vest, scarf, tie, beard, stubble, mustache, brows, glasses,
-- hat ("cowboy" | "cap" | "flat"), hatColor, expr ("neutral" | "smile" | "wry" | "stern"),
-- build ("lean" | "average" | "broad"), height (multiplier), label, labelColor, scale, age.
function MapBuilder.npc(parent, name, cf, o)
	o = o or {}
	local m = model(parent, name)
	local skin = o.skin or "#C99A74"
	local shirt = o.shirt or "#5A5F66"
	local pants = o.pants or "#3A3A3C"
	local shoes = o.shoes or "#2E2621"
	local s = (o.scale or 1) * (o.height or 1)
	local w = o.build == "broad" and 1.12 or (o.build == "lean" and 0.92 or 1)
	local skinMat = E.Enum.Material.SmoothPlastic
	local cloth = E.Enum.Material.Fabric
	local function at(x, y, z, rx, ry, rz)
		return cf * E.CFrame.new(x * s, y * s, z * s) * E.CFrame.Angles(math.rad(rx or 0), math.rad(ry or 0), math.rad(rz or 0))
	end
	local function e(n, sx, sy, sz, c, x, y, z, rx, ry, rz, mat)
		return sph(m, n, V(sx * s, sy * s, sz * s), at(x, y, z, rx, ry, rz), c, mat or cloth, { CanCollide = false })
	end
	-- a limb segment between two points (local coords), as a rounded cylinder
	local function limb(n, a, b, d, c, mat)
		local pa = cf * E.CFrame.new(a[1] * s, a[2] * s, a[3] * s)
		local pb = cf * E.CFrame.new(b[1] * s, b[2] * s, b[3] * s)
		local mid = (pa.Position + pb.Position) / 2
		local len = (pb.Position - pa.Position).Magnitude
		local x = (pb.Position - pa.Position).Unit
		local ref = math.abs(x.Y) > 0.9 and V(0, 0, 1) or V(0, 1, 0)
		local y = ref:Cross(x).Unit
		local look = E.CFrame.fromMatrix(mid, x, y)
		local p = cyl(m, n, len, d * s, look, c, mat or cloth, { CanCollide = false })
		sph(m, n .. "Joint", V(d * s, d * s, d * s), E.CFrame.new(pb.Position), c, mat or cloth, { CanCollide = false })
		return p
	end
	-- legs: thigh 1.55, shin 1.45, ankle at 0.22 (hips at 3.05)
	local legL = limb("LeftUpperLeg", { -0.36 * w, 3.0, 0 }, { -0.38 * w, 1.6, -0.04 }, 0.62 * w, pants)
	local legR = limb("RightUpperLeg", { 0.36 * w, 3.0, 0 }, { 0.38 * w, 1.6, -0.04 }, 0.62 * w, pants)
	limb("LeftLowerLeg", { -0.38 * w, 1.6, -0.04 }, { -0.4 * w, 0.28, 0.02 }, 0.48, pants)
	limb("RightLowerLeg", { 0.38 * w, 1.6, -0.04 }, { 0.4 * w, 0.28, 0.02 }, 0.48, pants)
	for _, side in { -1, 1 } do
		local fx = side * 0.4 * w
		e(side < 0 and "LeftFoot" or "RightFoot", 0.46, 0.32, 1.02, shoes, fx, 0.17, -0.2, 0, 0, 0, E.Enum.Material.Leather)
		e("Sole", 0.48, 0.1, 1.04, "#1E1A17", fx, 0.05, -0.2, 0, 0, 0, E.Enum.Material.Rubber)
		if o.boots then
			limb("BootShaft", { fx, 0.3, 0.02 }, { fx, 1.15, 0 }, 0.52, shoes, E.Enum.Material.Leather)
		end
	end
	-- torso: pelvis, waist, ribcage (V-taper), shoulders
	e("LowerTorso", 1.32 * w, 0.78, 0.82, pants, 0, 3.12, 0)
	if o.belt ~= false then
		e("Belt", 1.3 * w, 0.18, 0.84, "#2A221C", 0, 3.42, 0, 0, 0, 0, E.Enum.Material.Leather)
	end
	e("Waist", 1.18 * w, 0.95, 0.74, shirt, 0, 3.72, 0)
	local torso = sph(m, "UpperTorso", V(1.62 * w * s, 1.35 * s, 0.86 * s), at(0, 4.3, 0), shirt, cloth)
	e("Shoulders", 1.86 * w, 0.42, 0.78, shirt, 0, 4.72, 0.02)
	if o.vest then
		e("Vest", 1.66 * w, 1.3, 0.9, o.vest, 0, 4.2, -0.01)
	end
	if o.coat then
		-- layered outer coat that hugs the body: a shell over the ribcage and shoulders, a skirt
		-- over the hips (long for coatLong), an open front showing the shirt, flat lapels
		local len = o.coatLong and 2.7 or 1.6
		e("CoatTorso", 1.72 * w, 1.42, 0.94, o.coat, 0, 4.28, 0.01)
		e("CoatShoulders", 1.98 * w, 0.46, 0.88, o.coat, 0, 4.72, 0.03)
		e("CoatSkirt", 1.44 * w, len, 0.92, o.coat, 0, 3.95 - len / 2 + 0.35, 0.02)
		e("CoatCollar", 0.9, 0.3, 0.8, o.coatTrim or o.coat, 0, 4.95, 0.06)
		e("ShirtFront", 0.36, 1.25, 0.16, shirt, 0, 4.2, -0.43)
		if not o.tie then
			e("ShirtFrontLow", 0.3, 0.7, 0.16, shirt, 0, 3.55, -0.4)
		end
		for _, side in { -1, 1 } do
			e("Lapel", 0.2, 0.72, 0.07, o.coatTrim or o.coat, side * 0.23, 4.48, -0.455, 0, 0, side * -14)
		end
	end
	if o.tie then
		e("Tie", 0.2, 1.15, 0.12, o.tie, 0, 4.15, -0.43)
	end
	if o.scarf then
		e("Scarf", 0.95, 0.38, 0.85, o.scarf, 0, 4.98, -0.02)
		e("ScarfTail", 0.3, 1.0, 0.14, o.scarf, 0.22, 4.4, -0.44, 0, 0, 8)
	end
	-- arms (sleeves) hang naturally, hands at mid-thigh
	local sleeve = o.coat or shirt
	for _, side in { -1, 1 } do
		local sx = side * 0.98 * w
		limb(side < 0 and "LeftUpperArm" or "RightUpperArm", { sx, 4.72, 0.02 }, { sx + side * 0.12, 3.55, 0.06 }, 0.38, sleeve)
		limb(side < 0 and "LeftLowerArm" or "RightLowerArm", { sx + side * 0.12, 3.55, 0.06 }, { sx + side * 0.14, 2.62, -0.06 }, 0.32, sleeve)
		e(side < 0 and "LeftHand" or "RightHand", 0.24, 0.5, 0.36, skin, sx + side * 0.15, 2.36, -0.07, 0, 0, 0, skinMat)
	end
	-- neck + head (head 0.82 tall: chin 5.08, crown 5.9)
	limb("Neck", { 0, 4.86, 0.02 }, { 0, 5.18, 0.0 }, 0.36, skin, skinMat)
	local head = sph(m, "Head", V(0.68 * s, 0.84 * s, 0.76 * s), at(0, 5.48, 0), skin, skinMat, { CanCollide = false })
	e("Jaw", 0.56, 0.36, 0.6, skin, 0, 5.24, -0.06, 0, 0, 0, skinMat)
	e("EarL", 0.08, 0.22, 0.14, skin, -0.34, 5.48, 0.02, 0, 0, 0, skinMat)
	e("EarR", 0.08, 0.22, 0.14, skin, 0.34, 5.48, 0.02, 0, 0, 0, skinMat)
	-- face: small, set-in eyes, a real nose and a closed mouth (expression via brow/mouth angle)
	local expr = o.expr or "neutral"
	local browTilt = expr == "stern" and 10 or (expr == "wry" and -6 or 0)
	local mouthCurve = expr == "smile" and 5 or (expr == "wry" and 8 or (expr == "stern" and -3 or 0))
	for _, side in { -1, 1 } do
		e("EyeWhite", 0.13, 0.065, 0.05, "#E8E2D8", side * 0.13, 5.53, -0.355, 0, 0, 0, skinMat)
		e("Iris", 0.06, 0.06, 0.03, o.eyes or "#3A2C22", side * 0.13, 5.53, -0.375, 0, 0, 0, skinMat)
		e("Lid", 0.15, 0.04, 0.06, skin, side * 0.13, 5.565, -0.35, 0, 0, 0, skinMat)
		if o.brows ~= false then
			deco(m, "Brow", V(0.17 * s, 0.035 * s, 0.04 * s), at(side * 0.135, 5.63, -0.355, 0, 0, side * browTilt), o.browColor or o.hair or "#2A1E1A", cloth, false)
		end
		if o.age and o.age > 40 then
			deco(m, "Crease", V(0.06 * s, 0.012 * s, 0.02 * s), at(side * 0.23, 5.52, -0.335, 0, 0, side * 20), "#8A6A55", skinMat, false)
		end
	end
	e("Nose", 0.09, 0.2, 0.12, skin, 0, 5.44, -0.385, -12, 0, 0, skinMat)
	e("NoseTip", 0.1, 0.07, 0.08, skin, 0, 5.36, -0.41, 0, 0, 0, skinMat)
	deco(m, "Mouth", V(0.2 * s, 0.025 * s, 0.03 * s), at(0, 5.26, -0.355, 0, 0, expr == "wry" and 8 or 0), o.lips or "#8C5A4E", skinMat, false)
	if mouthCurve ~= 0 then
		for _, side in { -1, 1 } do
			deco(m, "MouthCorner", V(0.05 * s, 0.022 * s, 0.03 * s), at(side * 0.115, 5.265 + (mouthCurve > 0 and 0.012 or -0.012) * (side == 1 and expr == "wry" and 2 or 1), -0.35, 0, 0, side * mouthCurve * 3), o.lips or "#8C5A4E", skinMat, false)
		end
	end
	if o.stubble then
		e("Stubble", 0.6, 0.34, 0.6, o.stubble, 0, 5.22, -0.075, 0, 0, 0, cloth).Transparency = 0.35
	end
	if o.beard then
		e("Beard", 0.62, 0.42, 0.62, o.beard, 0, 5.18, -0.08, 0, 0, 0, cloth)
	end
	if o.mustache then
		e("Mustache", 0.26, 0.06, 0.08, o.mustache, 0, 5.31, -0.37, 0, 0, 0, cloth)
	end
	if o.glasses then
		for _, side in { -1, 1 } do
			local lens = cyl(m, "Glasses", 0.02 * s, 0.17 * s, at(side * 0.13, 5.53, -0.4) * E.CFrame.Angles(0, math.pi / 2, 0), "#BFD3DA", E.Enum.Material.Glass, { Transparency = 0.6, CanCollide = false })
			lens.CanQuery = false
		end
		deco(m, "GlassesBridge", V(0.08 * s, 0.02 * s, 0.02 * s), at(0, 5.55, -0.41), "#2A2420", E.Enum.Material.Metal, false)
	end
	-- hair
	local hair = o.hair or "#3A2A1E"
	local style = o.hairStyle or "short"
	if style ~= "bald" and o.hat ~= "cowboy" then
		e("Hair", 0.74, 0.5, 0.8, hair, 0, 5.74, 0.03, -8, 0, 0, cloth)
		if style == "messy" then
			for k = 2, 5 do
				local a = (k - 3.5) * 0.5
				e("Tuft", 0.24, 0.1, 0.28, hair, math.sin(a) * 0.28, 5.92 + (k % 2) * 0.02, -0.12 + math.cos(a) * 0.1, -20 + (k % 3) * 8, k * 30, (k % 2) * 14, cloth)
			end
		elseif style == "slick" then
			e("HairBack", 0.72, 0.5, 0.5, hair, 0, 5.6, 0.2, 0, 0, 0, E.Enum.Material.SmoothPlastic)
		elseif style == "bun" then
			e("HairBack", 0.72, 0.6, 0.5, hair, 0, 5.56, 0.18, 0, 0, 0, cloth)
			e("Bun", 0.36, 0.32, 0.32, hair, 0, 5.82, 0.42, 0, 0, 0, cloth)
		elseif style == "long" then
			e("HairBack", 0.78, 1.15, 0.5, hair, 0, 5.15, 0.22, 0, 0, 0, cloth)
		else
			e("HairBack", 0.7, 0.4, 0.45, hair, 0, 5.56, 0.2, 0, 0, 0, cloth)
		end
	end
	if o.hat == "cowboy" then
		local hc = o.hatColor or "#3B2E22"
		cyl(m, "HatBrim", 0.05 * s, 1.5 * s, at(0, 5.8, 0.02) * E.CFrame.Angles(0, 0, math.pi / 2), hc, E.Enum.Material.Leather, { CanCollide = false })
		e("HatCrown", 0.74, 0.4, 0.8, hc, 0, 5.98, 0.02, 0, 0, 0, E.Enum.Material.Leather)
	elseif o.hat == "cap" or o.hat == "flat" then
		local hc = o.hatColor or "#4A4038"
		e("Cap", 0.76, 0.32, 0.82, hc, 0, 5.86, 0.02, 0, 0, 0, cloth)
		e("Bill", 0.5, 0.05, 0.34, hc, 0, 5.8, -0.4, -8, 0, 0, cloth)
	end
	for _, c in ipairs(m:GetDescendants()) do
		if c:IsA("BasePart") then
			c.CanCollide = c == torso or c == legL or c == legR
			c.CastShadow = c == torso or c == head or c.Name:find("Coat") ~= nil or c.Name:find("Leg") ~= nil
		end
	end
	m.PrimaryPart = torso
	m:SetAttribute("Realistic", true)
	if o.label then
		billboard(head, "NameTag", o.label, 1.4, 60, o.labelColor or "#E9DFC6", 200, 32)
	end
	return m, head, torso
end

-- ===================== palette (from the plan's "Color & Look") =====================
local PAL = {
	-- Realism pass: a desaturated, filmic palette. Aged brass instead of bright gold, weathered
	-- stone, olive grass and a muted rose for the meadow blooms.
	marble = "#CFC8BC",
	gold = "#9C8048",
	goldHi = "#B89A5C",
	slate = "#474B52",
	soot = "#2A2B2F",
	haze = "#D9A57E",
	meadow = "#7A844C",
	meadowDeep = "#646E3E",
	bloom = "#A85A78",
	finch = "#C98AA8",
	lake = "#4A737A",
	wood = "#2F4430",
	woodDark = "#263828",
	veil = "#9ADCE4",
	field = { "#68704A", "#707850", "#5F6844" },
	fieldDusk = "#555C3F",
	ridge = { "#5A5B5E", "#4A4D52", "#636468" },
	sand = "#A89C80",
	trunk = "#3E3128",
	brick = { "#54463F", "#4A464C", "#5A5049" },
	window = "#E2B26C",
	rustyHair = "#A68C5C",
	rustyRoots = "#5E4C34",
	rustyShirt = "#A68A44",
	rustyPlaid = "#3E5E60",
	rustyPants = "#4E4C46",
	thermos = "#3E6A4E",
	grass = { "#6E7748", "#7A8250", "#626B40", "#858A56" },
}
MapBuilder.PALETTE = PAL

local seed = 20261102
local function rnd()
	seed = (seed * 1103515245 + 12345) % 2147483648
	return seed / 2147483648
end
local function rr(a, b)
	return a + (b - a) * rnd()
end
local function pick(t)
	return t[1 + math.floor(rnd() * #t) % #t]
end
local function at(pos)
	return E.CFrame.new(pos)
end
local function yaw(r)
	return E.CFrame.Angles(0, r, 0)
end
local function disc(parent, name, d, thick, pos, color, material, props)
	-- upright cylinder (a flat disc) centered at pos
	return cyl(parent, name, thick, d, at(pos) * E.CFrame.Angles(0, 0, math.pi / 2), color, material, props)
end
local function mark(parent, name, cf)
	return part(parent, name, V(1, 1, 1), cf, "#FFFFFF", E.Enum.Material.SmoothPlastic, { Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false })
end
local function inCircle(x, z, c)
	local dx, dz = x - c.x, z - c.z
	return dx * dx + dz * dz < c.r * c.r
end

-- Which biome is at (x, z)? Used for ground color, scatter and token zones.
function MapBuilder.biomeAt(x, z, cfg)
	local M = cfg.Map
	if math.sqrt(x * x + z * z) < 140 then
		return "hub"
	elseif inCircle(x, z, M.LAKE) then
		return "lake"
	elseif inCircle(x, z, M.MEADOW) then
		return "meadow"
	elseif z < -720 then
		return "ridge"
	elseif inCircle(x, z, M.RUINS) then
		return "ruins"
	elseif x < -300 then
		return "wood"
	end
	return "field"
end

-- ===================== props =====================
local function pine(parent, pos, s)
	local m = model(parent, "Pine")
	deco(m, "Trunk", V(1.6 * s, 10 * s, 1.6 * s), at(pos + V(0, 5 * s, 0)), PAL.trunk, E.Enum.Material.Wood, false)
	local c = pick({ PAL.wood, PAL.woodDark, "#344A36" })
	sph(m, "Needles1", V(11 * s, 9 * s, 11 * s), at(pos + V(0, 10 * s, 0)), c, E.Enum.Material.LeafyGrass, { CanCollide = false, CanQuery = false, CastShadow = true })
	sph(m, "Needles2", V(8 * s, 8 * s, 8 * s), at(pos + V(0, 16 * s, 0)), c, E.Enum.Material.LeafyGrass, { CanCollide = false, CanQuery = false, CastShadow = true })
	sph(m, "Needles3", V(4.5 * s, 6 * s, 4.5 * s), at(pos + V(0, 21 * s, 0)), c, E.Enum.Material.LeafyGrass, { CanCollide = false, CanQuery = false, CastShadow = false })
	part(m, "Hitbox", V(2 * s, 12 * s, 2 * s), at(pos + V(0, 6 * s, 0)), PAL.trunk, E.Enum.Material.Wood, { Transparency = 1, CastShadow = false })
	return m
end

local function broadleaf(parent, pos, s)
	local m = model(parent, "Tree")
	deco(m, "Trunk", V(2 * s, 9 * s, 2 * s), at(pos + V(0, 4.5 * s, 0)), PAL.trunk, E.Enum.Material.Wood, false)
	local c = pick({ "#4E6038", "#58683E", "#646C40", "#6E6C44" })
	dball(m, "Canopy", 12 * s, at(pos + V(0, 11 * s, 0)), c, E.Enum.Material.LeafyGrass, true)
	dball(m, "Canopy2", 8 * s, at(pos + V(4 * s, 9.5 * s, 2 * s)), c, E.Enum.Material.LeafyGrass, false)
	part(m, "Hitbox", V(2.2 * s, 9 * s, 2.2 * s), at(pos + V(0, 4.5 * s, 0)), PAL.trunk, E.Enum.Material.Wood, { Transparency = 1, CastShadow = false })
	return m
end

local function rock(parent, pos, s, color)
	local p = sph(parent, "Rock", V(rr(6, 10) * s, rr(4, 7) * s, rr(6, 10) * s), at(pos + V(0, 1.5 * s, 0)) * yaw(rr(0, 6.28)), color or pick(PAL.ridge), E.Enum.Material.Rock)
	return p
end

local function crate(parent, name, pos, loot, rot)
	local c = part(parent, name, V(4, 3, 3), at(pos + V(0, 1.5, 0)) * yaw(rot or 0), loot == "hub" and "#6E5A40" or "#5A4834", E.Enum.Material.WoodPlanks)
	c:SetAttribute("Loot", loot)
	c:SetAttribute("Crate", true)
	deco(c, "Band", V(4.1, 0.5, 3.1), c.CFrame, loot == "meadow" and "#6E3E4E" or "#5A4A3A", E.Enum.Material.CorrodedMetal, false)
	deco(c, "Band2", V(0.5, 3.1, 3.1), c.CFrame, loot == "meadow" and "#6E3E4E" or "#5A4A3A", E.Enum.Material.CorrodedMetal, false)
	local band = c:FindFirstChild("Band")
	if band then
		band.Parent = parent
		band.Name = name .. "_Band"
	end
	local band2 = c:FindFirstChild("Band2")
	if band2 then
		band2.Parent = parent
		band2.Name = name .. "_Band2"
	end
	prompt(c, "crate", "Open", "Crate", 0.6, 9)
	return c
end

local function townsperson(parent, cf, colors)
	-- realistic, low-detail townsfolk for the lobby crowd (worn, muted work clothes)
	local m = MapBuilder.npc(parent, "Townsperson", cf, {
		shirt = colors[1],
		pants = colors[2],
		skin = colors[3],
		hair = colors[4],
		coat = rnd() < 0.4 and pick({ "#4A443C", "#3E4248", "#55483A" }) or nil,
		hairStyle = pick({ "short", "short", "messy", "long", "bun", "bald" }),
		hat = rnd() < 0.2 and "flat" or nil,
		stubble = rnd() < 0.3 and colors[4] or nil,
		expr = pick({ "neutral", "neutral", "stern", "wry" }),
		build = pick({ "lean", "average", "broad" }),
		height = rr(0.93, 1.06),
		brows = true,
	})
	return m
end

-- Rusty Dunmore: the scruffy, kind mentor in his forties. Worn plaid overshirt over a faded
-- mustard tee, work boots, two-tone hair grown out, a week of stubble, and his green thermos.
function MapBuilder.rusty(env, parent, cf, label)
	if env then
		E = env
	end
	local m, head, torso = MapBuilder.npc(parent, "Rusty", cf, {
		skin = "#C49272",
		shirt = PAL.rustyShirt,
		pants = PAL.rustyPants,
		shoes = "#3A2C22",
		boots = true,
		coat = PAL.rustyPlaid,
		coatTrim = "#2C4446",
		hair = PAL.rustyHair,
		browColor = PAL.rustyRoots,
		hairStyle = "messy",
		stubble = PAL.rustyRoots,
		mustache = PAL.rustyRoots,
		expr = "wry",
		age = 44,
		build = "average",
		height = 1.02,
		label = label,
		labelColor = "#E3C987",
	})
	local s = 1.02
	local function a(x, y, z)
		return cf * E.CFrame.new(x * s, y * s, z * s)
	end
	-- darker roots under the grown-out hair (real plaid comes from the layered shirt in Studio)
	sph(m, "Roots", V(0.66 * s, 0.22 * s, 0.7 * s), a(0, 5.74, 0.08), PAL.rustyRoots, E.Enum.Material.Fabric, { CanCollide = false })
	-- the dented green thermos in his right hand
	local th = cyl(m, "Thermos", 0.95, 0.34, a(1.14, 2.3, -0.3) * E.CFrame.Angles(0, 0, math.pi / 2), PAL.thermos, E.Enum.Material.CorrodedMetal, { CanCollide = false })
	cyl(m, "ThermosCap", 0.18, 0.37, a(1.14, 2.82, -0.3) * E.CFrame.Angles(0, 0, math.pi / 2), "#2A2A2A", E.Enum.Material.Metal, { CanCollide = false })
	m:SetAttribute("LookId", "Rusty")
	return m, head, torso, th
end

-- Monty Gleam: the Capital's interview host. Silver-streaked slick hair, midnight suit, a
-- practiced TV smile.
function MapBuilder.monty(parent, cf, label)
	local m, head = MapBuilder.npc(parent, "Monty", cf, {
		skin = "#B98466",
		shirt = "#D8D2C6",
		pants = "#1F2430",
		shoes = "#151515",
		coat = "#232A3A",
		coatTrim = "#1A1F2B",
		tie = "#6B2430",
		hair = "#4A4440",
		hairStyle = "slick",
		expr = "smile",
		age = 52,
		build = "lean",
		height = 1.03,
		label = label,
		labelColor = "#E3C987",
	})
	deco(m, "PocketSquare", V(0.14, 0.08, 0.04), cf * E.CFrame.new(-0.42, 4.55, -0.47), "#C9A24A", E.Enum.Material.Fabric, false)
	m:SetAttribute("LookId", "Monty")
	return m, head
end

-- Herald Marigold Vane: the Capital escort. Tailored ochre long coat with a cream collar,
-- copper hair in a tight bun, pearls, a bright smile that never quite reaches her eyes.
function MapBuilder.herald(parent, cf, label)
	local m, head = MapBuilder.npc(parent, "Herald", cf, {
		skin = "#E2B99A",
		shirt = "#E8DFCF",
		pants = "#5A4632",
		shoes = "#3A2A1E",
		coat = "#9C7A3C",
		coatLong = true,
		coatTrim = "#E8DFCF",
		hair = "#A2512A",
		hairStyle = "bun",
		lips = "#9A4A48",
		expr = "smile",
		build = "lean",
		height = 0.97,
		label = label,
		labelColor = "#E3C987",
	})
	for k = -2, 2 do
		dball(m, "Pearl", 0.07, cf * E.CFrame.new(k * 0.08, 4.86 - math.abs(k) * 0.02, -0.36 + math.abs(k) * 0.03), "#EFE8DA", E.Enum.Material.SmoothPlastic, false)
	end
	m:SetAttribute("LookId", "Herald")
	return m, head
end

-- ===================== arena =====================
local function buildGround(root, cfg)
	local g = folder(root, "Ground")
	local half = cfg.Map.ARENA_SIZE / 2
	local tile = 300
	for i = 0, cfg.Map.ARENA_SIZE / tile - 1 do
		for j = 0, cfg.Map.ARENA_SIZE / tile - 1 do
			local x = -half + tile * (i + 0.5)
			local z = -half + tile * (j + 0.5)
			local b = MapBuilder.biomeAt(x, z, cfg)
			local color = pick(PAL.field)
			local mat = E.Enum.Material.LeafyGrass
			if b == "ridge" then
				color, mat = "#5E5C55", E.Enum.Material.Ground
			elseif b == "wood" then
				color = "#4A5638"
			elseif b == "ruins" then
				color, mat = "#6E685A", E.Enum.Material.Mud
			end
			part(g, "Tile", V(tile, 16, tile), at(V(x, -8, z)), color, mat)
		end
	end
	-- outer skirt (outside the Veil) and distant hills to frame the sky
	for i = -3, 2 do
		for j = -3, 2 do
			local x, z = 600 * (i + 0.5), 600 * (j + 0.5)
			if math.abs(x) > half or math.abs(z) > half then
				part(g, "Skirt", V(600, 16, 600), at(V(x, -8.5, z)), PAL.fieldDusk, E.Enum.Material.Grass)
			end
		end
	end
	for k = 1, 28 do
		local a = k / 28 * math.pi * 2 + rr(-0.05, 0.05)
		local r = rr(1550, 1750)
		local s = rr(260, 520)
		local color = a > math.pi * 1.1 and a < math.pi * 1.9 and "#55565A" or pick({ "#465440", "#4E5A44", "#424C3C" })
		sph(g, "Hill", V(s * 1.6, s * 0.7, s), at(V(math.cos(a) * r, -s * 0.12, math.sin(a) * r)) * yaw(-a), color, E.Enum.Material.Grass, { CanCollide = false, CastShadow = false })
	end
end

local function buildHub(root, cfg, names)
	local h = folder(root, "Sundial")
	local R = cfg.Map.HUB_RADIUS
	disc(h, "Apron", R * 2 + 40, 1, V(0, 0.5, 0), "#9C968A", E.Enum.Material.Cobblestone)
	disc(h, "Base", R * 2, 2, V(0, 1.5, 0), PAL.marble, E.Enum.Material.Limestone)
	disc(h, "GoldRing", R * 2 - 6, 2.4, V(0, 1.7, 0), PAL.gold, E.Enum.Material.Metal)
	disc(h, "Face", R * 2 - 10, 2.6, V(0, 1.8, 0), PAL.marble, E.Enum.Material.Limestone)
	disc(h, "Inlay", 30, 2.8, V(0, 1.9, 0), PAL.goldHi, E.Enum.Material.Metal)
	-- 12 hour marks
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		local r = R - 9
		part(h, "HourMark", V(2, 0.6, 7), at(V(math.cos(a) * r, 3.2, math.sin(a) * r)) * yaw(-a + math.pi / 2), PAL.gold, E.Enum.Material.Metal, { CanCollide = false })
	end
	-- the gnomon: a tall golden blade casting the hub's shadow
	local gnomon = part(h, "Gnomon", V(3, 46, 26), at(V(0, 20, 6)) * E.CFrame.Angles(math.rad(-28), 0, 0), PAL.gold, E.Enum.Material.Metal)
	local light = E.Instance.new("PointLight")
	light.Color = E.Color3.fromHex("#FFD36B")
	light.Brightness = 3
	light.Range = 60
	light.Parent = gnomon
	part(h, "GnomonCap", V(4, 3, 4), at(V(0, 41, -4)), PAL.goldHi, E.Enum.Material.Metal, { CanCollide = false })
	billboard(gnomon, "Label", names.HUB:gsub("^the ", "The "), 30, 900, "#FFE9A8", 220, 40)
	-- crate rings around the dial
	local crates = folder(root, "HubCrates")
	for i = 1, cfg.HUB_CRATES do
		local ring = (i % 3)
		local r = 16 + ring * 9 + (ring == 2 and 4 or 0)
		local a = i / cfg.HUB_CRATES * math.pi * 2 + ring * 0.2
		crate(crates, "HubCrate" .. i, V(math.cos(a) * r, 3.1, math.sin(a) * r), "hub", -a)
	end
	-- 48 lift plates
	local plates = folder(root, "LiftPlates")
	for i = 1, cfg.MATCH_SIZE do
		local a = (i - 1) / cfg.MATCH_SIZE * math.pi * 2
		local pos = V(math.cos(a) * cfg.Map.PLATE_RADIUS, 0, math.sin(a) * cfg.Map.PLATE_RADIUS)
		local p = disc(plates, string.format("Plate%02d", i), 8, 1.2, pos + V(0, 0.6, 0), "#6E6A64", E.Enum.Material.DiamondPlate)
		p:SetAttribute("Index", i)
		disc(plates, string.format("Plate%02d_Ring", i), 9, 0.9, pos + V(0, 0.5, 0), PAL.veil, E.Enum.Material.Neon, { CanCollide = false, CanQuery = false })
	end
end

local function buildMeadow(root, cfg)
	local m = folder(root, "GildedMeadow")
	local M = cfg.Map.MEADOW
	disc(m, "Meadow", M.r * 2, 0.4, V(M.x, 0.2, M.z), PAL.meadow, E.Enum.Material.LeafyGrass, { CanCollide = false })
	disc(m, "MeadowInner", M.r * 1.3, 0.5, V(M.x, 0.25, M.z), "#808A4E", E.Enum.Material.LeafyGrass, { CanCollide = false })
	local zone = disc(m, "MeadowZone", M.r * 2, 60, V(M.x, 30, M.z), PAL.bloom, E.Enum.Material.SmoothPlastic, { Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false })
	zone:SetAttribute("Zone", "meadow")
	local flowers = model(m, "Flowers")
	for _ = 1, 420 do
		local a, d = rr(0, math.pi * 2), math.sqrt(rnd()) * (M.r - 8)
		local x, z = M.x + math.cos(a) * d, M.z + math.sin(a) * d
		local h = rr(1.4, 2.8)
		deco(flowers, "Stem", V(0.12, h, 0.12), at(V(x, h / 2, z)) * E.CFrame.Angles(rr(-0.15, 0.15), 0, rr(-0.15, 0.15)), "#4E5A34", E.Enum.Material.LeafyGrass, false)
		local c = rnd() < 0.5 and "#C2A050" or (rnd() < 0.6 and PAL.bloom or "#DCD5C4")
		dball(flowers, "Bloom", rr(0.45, 0.85), at(V(x, h + 0.1, z)), c, E.Enum.Material.Fabric, false)
	end
	-- golden pollen emitters (off until a Meadow Bloom)
	for k = 1, 7 do
		local a = k / 7 * math.pi * 2
		local p = mark(m, "PollenEmitter", at(V(M.x + math.cos(a) * M.r * 0.55, 4, M.z + math.sin(a) * M.r * 0.55)))
		p.Size = V(M.r * 0.7, 2, M.r * 0.7)
		local pe = E.Instance.new("ParticleEmitter")
		pe.Name = "Pollen"
		pe.Enabled = false
		pe.Rate = 60
		pe.Lifetime = E.NumberRange.new(4, 7)
		pe.Speed = E.NumberRange.new(1, 3)
		pe.SpreadAngle = E.Vector2.new(180, 180)
		pe.LightEmission = 0.35
		pe.Color = E.ColorSequence.new(E.Color3.fromHex("#E8C878"), E.Color3.fromHex("#C98AA8"))
		pe.Size = E.NumberSequence.new(0.6)
		pe.Parent = p
	end
	local crates = folder(root, "MeadowCrates")
	for i = 1, cfg.MEADOW_CRATES do
		local a = i / cfg.MEADOW_CRATES * math.pi * 2
		local d = M.r * (i % 2 == 0 and 0.35 or 0.7)
		crate(crates, "MeadowCrate" .. i, V(M.x + math.cos(a) * d, 0.4, M.z + math.sin(a) * d), "meadow", a)
	end
end

local function buildLake(root, cfg)
	local l = folder(root, "MirrorLake")
	local L = cfg.Map.LAKE
	disc(l, "Shore", L.r * 2 + 40, 0.6, V(L.x, 0.3, L.z), PAL.sand, E.Enum.Material.Sand, { CanCollide = false })
	disc(l, "Bed", L.r * 2, 0.7, V(L.x, 0.35, L.z), "#33494C", E.Enum.Material.Mud, { CanCollide = false })
	local w = disc(l, "Water", L.r * 2 - 4, 1.2, V(L.x, 0.6, L.z), PAL.lake, E.Enum.Material.Glass, { Transparency = 0.25, Reflectance = 0.3, CanCollide = false })
	w:SetAttribute("Zone", "lake")
	-- a small island with a reed bed and a token spot
	disc(l, "Island", 46, 2.2, V(L.x + 40, 1.1, L.z - 30), PAL.sand, E.Enum.Material.Sand)
	broadleaf(l, V(L.x + 40, 2.2, L.z - 30), 1.2)
	for _ = 1, 50 do
		local a = rr(0, math.pi * 2)
		local d = L.r + rr(-6, 14)
		deco(l, "Reed", V(0.4, rr(3, 6), 0.4), at(V(L.x + math.cos(a) * d, 2, L.z + math.sin(a) * d)) * E.CFrame.Angles(rr(-0.2, 0.2), 0, rr(-0.2, 0.2)), "#6E7044", E.Enum.Material.LeafyGrass, false)
	end
end

local function buildWood(root, cfg)
	local w = folder(root, "Whisperwood")
	local n = 0
	local tries = 0
	while n < 300 and tries < 3000 do
		tries += 1
		local x, z = rr(-1180, -320), rr(-700, 1180)
		if MapBuilder.biomeAt(x, z, cfg) == "wood" then
			pine(w, V(x, 0, z), rr(1.3, 2.3))
			n += 1
		end
	end
	for _ = 1, 40 do
		rock(w, V(rr(-1150, -350), 0, rr(-680, 1150)), rr(0.6, 1.2), "#4E5650")
	end
end

local function buildRidge(root, _cfg)
	local r = folder(root, "AshenRidge")
	for _ = 1, 46 do
		local x = rr(-1150, 1150)
		local z = rr(-1180, -760)
		local h = rr(30, 150) * (1 + math.max(0, (-z - 900) / 400))
		local w = rr(60, 150)
		local p = part(r, "Cliff", V(w, h, rr(50, 120)), at(V(x, h / 2 - 4, z)) * yaw(rr(0, 6.28)) * E.CFrame.Angles(rr(-0.08, 0.08), 0, rr(-0.08, 0.08)), pick(PAL.ridge), E.Enum.Material.Slate)
		if rnd() < 0.4 then
			part(r, "Ledge", V(w * 0.6, 6, 30), p.CFrame * E.CFrame.new(0, -h / 4, 40), "#5A5C63", E.Enum.Material.Slate)
		end
	end
	for _ = 1, 40 do
		rock(r, V(rr(-1150, 1150), 0, rr(-760, -640)), rr(0.8, 1.8))
	end
end

local function buildRuins(root, cfg)
	local f = folder(root, "OldGlassford")
	local R = cfg.Map.RUINS
	for b = 1, 7 do
		local a = b / 7 * math.pi * 2
		local cx, cz = R.x + math.cos(a) * R.r * 0.55, R.z + math.sin(a) * R.r * 0.55
		local L, W, H = rr(50, 80), rr(26, 36), rr(16, 24)
		local cf = at(V(cx, 0, cz)) * yaw(rr(0, 3.14))
		local m = model(f, "Greenhouse")
		part(m, "Floor", V(L, 1, W), cf * E.CFrame.new(0, 0.5, 0), "#7A7468", E.Enum.Material.Cobblestone)
		local posts = math.floor(L / 10)
		for i = 0, posts do
			for _, side in { -1, 1 } do
				local broken = rnd() < 0.25
				local hh = broken and H * rr(0.3, 0.7) or H
				part(m, "Post", V(1, hh, 1), cf * E.CFrame.new(-L / 2 + i * L / posts, hh / 2, side * W / 2), "#4A3E36", E.Enum.Material.CorrodedMetal)
				if not broken and i < posts and rnd() < 0.6 then
					part(m, "Pane", V(L / posts - 1, H - 2, 0.3), cf * E.CFrame.new(-L / 2 + (i + 0.5) * L / posts, H / 2, side * W / 2), "#8FAAA2", E.Enum.Material.Glass, { Transparency = 0.5 })
				end
			end
		end
		if rnd() < 0.6 then
			part(m, "Roof", V(L, 0.6, W), cf * E.CFrame.new(0, H, 0), "#4A3E36", E.Enum.Material.CorrodedMetal, { Transparency = 0 })
		end
		for _ = 1, 4 do
			deco(m, "Planter", V(rr(4, 8), 2, 3), cf * E.CFrame.new(rr(-L / 3, L / 3), 2, rr(-W / 3, W / 3)), "#5A4433", E.Enum.Material.WoodPlanks, false)
		end
	end
end

local function buildScatter(root, cfg)
	local f = folder(root, "Field")
	for _ = 1, 170 do
		local x, z = rr(-1150, 1150), rr(-700, 1150)
		local b = MapBuilder.biomeAt(x, z, cfg)
		if b == "field" or b == "ruins" then
			if rnd() < 0.7 then
				broadleaf(f, V(x, 0, z), rr(1, 1.8))
			else
				rock(f, V(x, 0, z), rr(0.6, 1.4))
			end
		end
	end
	-- field crates (avoid the lake)
	local crates = folder(root, "FieldCrates")
	local n, tries = 0, 0
	while n < cfg.FIELD_CRATES and tries < 2000 do
		tries += 1
		local x, z = rr(-1120, 1120), rr(-1120, 1120)
		local b = MapBuilder.biomeAt(x, z, cfg)
		if b ~= "lake" and b ~= "hub" and b ~= "meadow" and math.sqrt(x * x + z * z) > 160 then
			n += 1
			crate(crates, "FieldCrate" .. n, V(x, 0, z), "field", rr(0, 6.28))
		end
	end
end

local function buildTokens(root, cfg, content)
	local f = folder(root, "TokenSpots")
	local M = cfg.Map
	local centers = {
		hub = { x = 0, z = 0, r = 30 },
		meadow = M.MEADOW,
		lake = { x = M.LAKE.x, z = M.LAKE.z, r = M.LAKE.r + 20 },
		wood = M.WOOD,
		ridge = { x = M.RIDGE.x, z = M.RIDGE.z, r = 300 },
		ruins = M.RUINS,
		field = { x = 300, z = 300, r = 300 },
	}
	for i, t in ipairs(content.TOKENS) do
		local c = centers[t.zone]
		local a = i * 2.39996
		local d = c.r * (t.zone == "lake" and 1 or rr(0.25, 0.8))
		local p = mark(f, "TokenSpot" .. i, at(V(c.x + math.cos(a) * d, 3, c.z + math.sin(a) * d)))
		p:SetAttribute("TokenIndex", i)
	end
end

local function buildVeil(root, cfg)
	local f = folder(root, "Veil")
	local n = 72
	local r = cfg.Map.ARENA_SIZE / 2
	local w = 2 * math.pi * r / n * 1.04
	for i = 1, n do
		local a = (i - 0.5) / n * math.pi * 2
		local pos = V(math.cos(a) * r, 300, math.sin(a) * r)
		local p = part(f, "Panel" .. i, V(w, 640, 1), lookAt(pos, V(0, 300, 0)), PAL.veil, E.Enum.Material.ForceField, { CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Transparency = 0.1 })
		p:SetAttribute("Angle", a)
	end
end

local function buildGallery(root, cfg, names)
	local g = folder(root, "ViewingGallery")
	local c = V(cfg.Map.GALLERY_CENTER[1], cfg.Map.GALLERY_CENTER[2], cfg.Map.GALLERY_CENTER[3])
	disc(g, "Deck", 150, 2, c, PAL.soot, E.Enum.Material.Marble)
	disc(g, "Rim", 156, 1.6, c + V(0, 0.4, 0), PAL.gold, E.Enum.Material.Metal, { CanCollide = false })
	disc(g, "Window", 70, 2.2, c + V(0, 0.1, 0), "#BFEFFF", E.Enum.Material.Glass, { Transparency = 0.6 })
	disc(g, "WindowRing", 74, 2.1, c + V(0, 0.05, 0), PAL.goldHi, E.Enum.Material.Neon, { CanCollide = false })
	local n = 36
	for i = 1, n do
		local a = i / n * math.pi * 2
		local rp = V(math.cos(a) * 74, 0, math.sin(a) * 74)
		part(g, "Rail", V(13, 5, 0.4), lookAt(c + rp + V(0, 3.5, 0), c + V(0, 3.5, 0)), "#D8F6FF", E.Enum.Material.Glass, { Transparency = 0.5 })
		if i % 2 == 0 then
			local sp = V(math.cos(a) * 52, 0, math.sin(a) * 52)
			local seatCf = lookAt(c + sp + V(0, 2, 0), c + V(0, 2, 0))
			local seatColor = i % 6 == 0 and PAL.gold or "#7A2E3A"
			part(g, "Seat", V(4, 1.2, 4), seatCf, seatColor, E.Enum.Material.Fabric)
			part(g, "Back", V(4, 4, 0.8), seatCf * E.CFrame.new(0, 2, 2), seatColor, E.Enum.Material.Fabric)
		end
	end
	-- halo roof
	for i = 1, 24 do
		local a = i / 24 * math.pi * 2
		local p = V(math.cos(a) * 70, 22, math.sin(a) * 70)
		part(g, "Halo", V(19, 1.5, 3), lookAt(c + p, c + V(0, 22, 0)), PAL.goldHi, E.Enum.Material.Neon, { CanCollide = false })
		if i % 4 == 0 then
			part(g, "Pillar", V(1.5, 22, 1.5), at(c + V(math.cos(a) * 72, 11, math.sin(a) * 72)), PAL.marble, E.Enum.Material.Marble)
		end
	end
	local board = part(g, "GiftBoard", V(30, 12, 1), lookAt(c + V(0, 14, -60), c + V(0, 14, 0)), PAL.soot, E.Enum.Material.SmoothPlastic)
	surfaceText(board, E.Enum.NormalId.Front, names.GALLERY:gsub("^the ", "The ") .. "\nSend gifts · Vote hazards · Encore", "#F4EFE6", "#23283A")
	local sp = E.Instance.new("SpawnLocation")
	sp.Name = "GallerySpawn"
	sp.Anchored = true
	sp.Enabled = false
	sp.Size = V(8, 1, 8)
	sp.CFrame = at(c + V(0, 1.6, 50))
	sp.Transparency = 1
	sp.CanCollide = false
	sp.Neutral = true
	sp.Parent = g
end

-- ===================== lobby: the Reach square and the Harvesting stage =====================
local function buildLobby(root, cfg, names, _content)
	local L = V(cfg.Map.LOBBY_CENTER[1], cfg.Map.LOBBY_CENTER[2], cfg.Map.LOBBY_CENTER[3])
	local lb = folder(root, "Lobby")
	local function P(x, y, z)
		return L + V(x, y, z)
	end
	part(lb, "Plaza", V(360, 4, 360), at(P(0, -2, 0)), "#56534F", E.Enum.Material.Cobblestone)
	part(lb, "Aisle", V(10, 4.05, 120), at(P(0, -2, -10)), "#7A7066", E.Enum.Material.Brick)
	-- Reach buildings around the square (soot and slate, warm windows)
	for side = 1, 4 do
		for k = -3, 3 do
			local w, h = rr(30, 44), rr(34, 70)
			local off = k * 46
			local pos, rot
			if side == 1 then
				pos, rot = P(off, h / 2, -200), 0
			elseif side == 2 then
				pos, rot = P(off, h / 2, 200), math.pi
			elseif side == 3 then
				pos, rot = P(-200, h / 2, off), math.pi / 2
			else
				pos, rot = P(200, h / 2, off), -math.pi / 2
			end
			if not (side == 2 and math.abs(k) <= 1) then
				local cf = at(pos) * yaw(rot)
				local b = part(lb, "Building", V(w, h, 30), cf, pick(PAL.brick), E.Enum.Material.Brick)
				part(lb, "Roof", V(w + 2, 3, 32), cf * E.CFrame.new(0, h / 2 + 1.5, 0), PAL.soot, E.Enum.Material.Slate)
				for wy = 1, math.floor(h / 12) do
					for wx = -1, 1 do
						if rnd() < 0.75 then
							deco(lb, "Window", V(4, 5, 0.4), b.CFrame * E.CFrame.new(wx * w / 3.2, -h / 2 + wy * 11, 15.1), rnd() < 0.6 and PAL.window or "#3A3F4A", rnd() < 0.35 and E.Enum.Material.Neon or E.Enum.Material.Glass, false)
						end
					end
				end
				if rnd() < 0.5 then
					deco(lb, "Banner", V(8, 18, 0.4), b.CFrame * E.CFrame.new(0, h / 2 - 12, 15.4), PAL.gold, E.Enum.Material.Fabric, false)
				end
			end
		end
	end
	-- the stage (faces +Z toward the crowd)
	local st = folder(lb, "Stage")
	part(st, "Platform", V(76, 6, 30), at(P(0, 3, -88)), PAL.marble, E.Enum.Material.Marble)
	part(st, "Trim", V(77, 1.2, 30.5), at(P(0, 5.6, -88)), PAL.gold, E.Enum.Material.Metal)
	for i = 1, 3 do
		part(st, "Step" .. i, V(14, 2 * i, 4), at(P(0, i, -73 + -(i - 1) * 4 + 8)), PAL.marble, E.Enum.Material.Marble)
	end
	local _back = part(st, "Backdrop", V(100, 44, 4), at(P(0, 22, -106)), PAL.marble, E.Enum.Material.Marble)
	for i = -2, 2 do
		part(st, "Pillar", V(5, 46, 5), at(P(i * 24, 23, -102)), "#D9D2C4", E.Enum.Material.Marble)
	end
	-- the Halcyon sun emblem (original): a gold disc and twelve rays
	disc(st, "Sun", 16, 1, P(0, 30, -103.6), PAL.gold, E.Enum.Material.Metal, { CanCollide = false }).CFrame = at(P(0, 30, -103.6)) * E.CFrame.Angles(0, math.pi / 2, 0)
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		part(st, "Ray", V(1.4, 8, 0.6), at(P(math.cos(a) * 12, 30 + math.sin(a) * 12, -103.6)) * E.CFrame.Angles(0, 0, a - math.pi / 2), PAL.goldHi, E.Enum.Material.Metal, { CanCollide = false })
	end
	local jumbo = part(st, "Jumbotron", V(46, 24, 2), at(P(0, 62, -104)), "#14161C", E.Enum.Material.SmoothPlastic)
	surfaceText(jumbo, E.Enum.NormalId.Back, names.TITLE:upper() .. "\n" .. names.EVENT:gsub("^the ", "The ") .. " · Jubilee Year", "#FFE9A8", "#14161C")
	part(st, "JumboFrame", V(48, 26, 1.6), at(P(0, 62, -104.6)), PAL.gold, E.Enum.Material.Metal)
	local flash = part(st, "Flashback", V(18, 11, 1), at(P(42, 40, -103.4)), "#23283A", E.Enum.Material.SmoothPlastic)
	surfaceText(flash, E.Enum.NormalId.Back, "25 years ago...\n" .. names.MENTOR_SHORT .. ", age 16", "#F4EFE6", "#23283A")
	-- glass globe of names
	cyl(st, "GlobeStand", 6, 3, at(P(-14, 9, -88)) * E.CFrame.Angles(0, 0, math.pi / 2), PAL.gold, E.Enum.Material.Metal)
	local globe = part(st, "Globe", V(8, 8, 8), at(P(-14, 16, -88)), "#DDF4FF", E.Enum.Material.Glass, { Transparency = 0.55, Shape = E.Enum.PartType.Ball })
	for _ = 1, 26 do
		deco(st, "Slip", V(0.9, 0.08, 0.5), at(P(-14 + rr(-2.2, 2.2), 14 + rr(-1.5, 2.2), -88 + rr(-2.2, 2.2))) * E.CFrame.Angles(rr(0, 3), rr(0, 3), rr(0, 3)), "#FFF8E7", E.Enum.Material.SmoothPlastic, false)
	end
	globe:SetAttribute("Globe", true)
	-- mic stand
	cyl(st, "Mic", 6, 0.3, at(P(4, 9, -80)) * E.CFrame.Angles(0, 0, math.pi / 2), "#2A2A2A", E.Enum.Material.Metal)
	dball(st, "MicHead", 0.7, at(P(4, 12.2, -80)), "#2A2A2A", E.Enum.Material.Metal, false)
	-- the Herald (faces the crowd)
	local herald = MapBuilder.herald(st, at(P(8, 6, -84)) * yaw(math.pi), names.HERALD)
	herald:SetAttribute("Role", "Herald")
	-- Rusty waits beside the crowd, then walks up to the stage during the reaping
	local rusty = MapBuilder.rusty(nil, lb, at(P(-44, 0, -30)) * yaw(-math.pi / 2), names.MENTOR)
	rusty:SetAttribute("Role", "Mentor")
	-- the interview set: Monty Gleam's couch corner beside the stage
	local iv = folder(lb, "InterviewSet")
	part(iv, "Riser", V(30, 2, 20), at(P(100, 1, -74)), "#3A2E28", E.Enum.Material.WoodPlanks)
	part(iv, "Rug", V(16, 0.1, 10), at(P(100, 2.05, -74)), "#5A2E2E", E.Enum.Material.Fabric, { CanCollide = false })
	for _, xc in { 95.5, 104.5 } do
		part(iv, "Chair", V(3.2, 1.6, 3), at(P(xc, 2.8, -74)), "#4A3A30", E.Enum.Material.Leather)
		part(iv, "ChairBack", V(3.2, 3.2, 0.6), at(P(xc, 4.4, -72.7)), "#4A3A30", E.Enum.Material.Leather)
	end
	part(iv, "SideTable", V(2, 2.2, 2), at(P(100, 3.1, -73)), "#2E2622", E.Enum.Material.Wood)
	local ivBack = part(iv, "Backdrop", V(32, 16, 1), at(P(100, 9, -84.5)), "#22252C", E.Enum.Material.Fabric)
	surfaceText(ivBack, E.Enum.NormalId.Back, "TONIGHT WITH " .. names.HOST:upper(), "#D9C38C", "#22252C")
	for _, xc in { 88, 112 } do
		part(iv, "LightStand", V(0.3, 10, 0.3), at(P(xc, 6, -62)), "#2A2A2A", E.Enum.Material.Metal)
		local lamp = part(iv, "StudioLamp", V(2, 1.4, 1.4), at(P(xc, 11, -62)), "#D8CFB8", E.Enum.Material.Neon, { CanCollide = false })
		local sl = E.Instance.new("SpotLight")
		sl.Face = E.Enum.NormalId.Back
		sl.Range = 28
		sl.Angle = 60
		sl.Brightness = 2
		sl.Color = E.Color3.fromHex("#FFE2B8")
		sl.Parent = lamp
	end
	local monty = MapBuilder.monty(iv, at(P(95.5, 2, -74)) * yaw(math.pi * 1.15), names.HOST)
	monty:SetAttribute("Role", "Host")
	-- crowd pens and townsfolk
	local crowd = folder(lb, "Crowd")
	for row = 0, 5 do
		for _, side in { -1, 1 } do
			part(crowd, "Rope", V(40, 0.4, 0.4), at(P(side * 26, 3, -50 + row * 14)), "#B3262E", E.Enum.Material.Fabric, { CanCollide = false })
			for _, px in { 6, 46 } do
				cyl(crowd, "Post", 3.5, 0.6, at(P(side * px, 1.75, -50 + row * 14)) * E.CFrame.Angles(0, 0, math.pi / 2), PAL.gold, E.Enum.Material.Metal)
			end
		end
	end
	local outfits = { { PAL.slate, "#3A3A40", "#E0AC69", "#3B2A1A" }, { "#5C5A52", "#2B2D33", "#C68642", "#1E1A18" }, { "#6B5B4B", "#3A3A40", "#F1C9A5", "#8A6A3A" }, { "#4A505C", "#5C5A52", "#8D5524", "#111111" }, { "#7A6A55", "#2B2D33", "#F1C9A5", "#B89A5E" } }
	for row = 0, 5 do
		for _, side in { -1, 1 } do
			for k = 0, 6 do
				local x = side * (10 + k * 5.4 + rr(-0.8, 0.8))
				townsperson(crowd, at(P(x, 0, -45 + row * 14 + rr(-2, 2))) * yaw(math.pi + rr(-0.3, 0.3)), pick(outfits))
			end
		end
	end
	-- cutscene marks (invisible). Each Cam* part's CFrame is a camera pose.
	local marks = folder(lb, "CutsceneMarks")
	local function cam(name, pos, look)
		mark(marks, name, lookAt(P(pos[1], pos[2], pos[3]), P(look[1], look[2], look[3])))
	end
	cam("CamWide", { 0, 46, 70 }, { 0, 18, -80 })
	cam("CamGlobe", { -6, 18, -70 }, { -14, 16, -88 })
	cam("CamHerald", { 14, 14, -66 }, { 8, 11, -84 })
	cam("CamCrowd", { 0, 9, -62 }, { 0, 5, 0 })
	cam("CamPlayer", { 6, 7, -18 }, { 0, 5, -8 })
	cam("CamRusty", { -30, 9, -44 }, { -44, 5, -30 })
	cam("CamStage", { 0, 16, -46 }, { -2, 9, -84 })
	cam("CamPull", { 0, 70, 120 }, { 0, 20, -80 })
	cam("CamInterview", { 103, 8.6, -58 }, { 100, 6.4, -73 })
	cam("CamRange", { -118, 9, 4 }, { -150, 6, -4 })
	mark(marks, "InterviewSeat", at(P(104.5, 2.2, -73)) * yaw(math.pi * 0.85))
	mark(marks, "CrowdMark", at(P(0, 3, -6)))
	mark(marks, "AisleMark", at(P(0, 3, -62)))
	mark(marks, "StageMark", at(P(-2, 9, -82)))
	mark(marks, "RustyStart", at(P(-44, 3, -30)))
	mark(marks, "RustyMark", at(P(-8, 9, -84)))
	mark(marks, "PartnerMark", at(P(3, 9, -82)))
	-- queue: the Draw Gate (walk in or press Play in the menu)
	local q = folder(lb, "DrawGate")
	part(q, "PillarL", V(5, 34, 5), at(P(-18, 17, 120)), PAL.marble, E.Enum.Material.Marble)
	part(q, "PillarR", V(5, 34, 5), at(P(18, 17, 120)), PAL.marble, E.Enum.Material.Marble)
	local lintel = part(q, "Lintel", V(44, 6, 6), at(P(0, 36, 120)), PAL.gold, E.Enum.Material.Metal)
	surfaceText(lintel, E.Enum.NormalId.Back, "THE DRAW GATE", "#1C1F2B", nil)
	local pad = disc(q, "QueuePad", 30, 0.8, P(0, 0.4, 120), PAL.veil, E.Enum.Material.Neon)
	prompt(pad, "queue", "Join the Draw", names.EVENT_SHORT, 0, 18)
	-- boards
	local function board(name, pos, rot, text)
		local b = part(lb, name, V(30, 18, 1.5), at(P(pos[1], pos[2], pos[3])) * yaw(rot), "#23283A", E.Enum.Material.SmoothPlastic)
		part(lb, name .. "Frame", V(31.5, 19.5, 1.2), b.CFrame * E.CFrame.new(0, 0, 0.3), PAL.gold, E.Enum.Material.Metal)
		surfaceText(b, E.Enum.NormalId.Back, text, "#F4EFE6", "#23283A")
		prompt(b, name:lower(), "Open", name, 0, 16)
		return b
	end
	board("SeasonBoard", { 70, 12, 110 }, 0, names.TRACK .. "\nSeason 1: First Light")
	board("ChallengeBoard", { -70, 12, 110 }, 0, "Daily & Weekly\nChallenges")
	board("ReachBoard", { 140, 12, 30 }, math.pi / 2, names.REGION .. " Standings\nThis week")
	-- training range (pregame score is cosmetic)
	local tr = folder(lb, "TrainingRange")
	for k = 1, 5 do
		local t = disc(tr, "Target" .. k, 5, 0.6, P(-150, 6, -40 + k * 14), "#F4EFE6", E.Enum.Material.SmoothPlastic)
		t.CFrame = at(P(-150, 6, -40 + k * 14)) * E.CFrame.Angles(0, 0, 0)
		disc(tr, "Bull" .. k, 2, 0.7, P(-149.9, 6, -40 + k * 14), "#B3262E", E.Enum.Material.SmoothPlastic, { CanCollide = false }).CFrame = at(P(-149.6, 6, -40 + k * 14))
		part(tr, "TargetPost" .. k, V(0.6, 4, 0.6), at(P(-150, 2, -40 + k * 14)), "#4A3426", E.Enum.Material.Wood)
	end
	local trPad = disc(tr, "RangePad", 16, 0.6, P(-110, 0.3, 0), PAL.gold, E.Enum.Material.Metal)
	prompt(trPad, "training", "Train", "Target Range", 0, 12)
	-- lamps
	for k = 1, 12 do
		local a = k / 12 * math.pi * 2
		local pos = P(math.cos(a) * 150, 0, math.sin(a) * 150)
		part(lb, "LampPost", V(1, 16, 1), at(pos + V(0, 8, 0)), PAL.soot, E.Enum.Material.Metal)
		local bulb = part(lb, "Lamp", V(2.4, 2.4, 2.4), at(pos + V(0, 17, 0)), PAL.window, E.Enum.Material.Neon, { CanCollide = false })
		local pl = E.Instance.new("PointLight")
		pl.Color = E.Color3.fromHex("#FFC870")
		pl.Range = 30
		pl.Brightness = 1.4
		pl.Parent = bulb
	end
	-- v4: the Victory Podium (last match's top 3 as posed statues, everyone's camera visits it)
	-- and the Hall of Champions (this week's top winners in their equipped cosmetics).
	local function sign(parent, name, cf, text)
		local b = part(parent, name, V(16, 5, 0.8), cf, "#23283A", E.Enum.Material.SmoothPlastic)
		part(parent, name .. "Frame", V(17, 6, 0.6), cf * E.CFrame.new(0, 0, 0.2), PAL.gold, E.Enum.Material.Metal)
		surfaceText(b, E.Enum.NormalId.Front, text, "#FFE9A8", "#23283A")
		return b
	end
	local vp = folder(lb, "VictoryPodium")
	local vpBase = at(P(-95, 0, 70)) * yaw(-math.pi / 2) -- faces +X, toward the plaza
	vp:SetAttribute("Focus", true)
	local heights = { 5, 3.6, 2.4 }
	local offs = { 0, -7, 7 }
	for place = 1, 3 do
		local h = heights[place]
		local cf = vpBase * E.CFrame.new(offs[place], h / 2, 0)
		part(vp, "Tier" .. place, V(6, h, 6), cf, place == 1 and PAL.gold or PAL.marble, place == 1 and E.Enum.Material.Metal or E.Enum.Material.Marble)
		local spot = part(vp, "Spot" .. place, V(1, 0.2, 1), vpBase * E.CFrame.new(offs[place], h + 0.1, 0), PAL.gold, E.Enum.Material.Metal, { Transparency = 1, CanCollide = false, CanQuery = false })
		spot:SetAttribute("Place", place)
	end
	sign(vp, "PodiumSign", vpBase * E.CFrame.new(0, 13, 4), "VICTORY PODIUM\nLast match's top three")
	local camMark = part(vp, "CameraMark", V(1, 1, 1), lookAt(vpBase * V(0, 9, -26), vpBase * V(0, 6, 0)), PAL.gold, E.Enum.Material.Metal, { Transparency = 1, CanCollide = false, CanQuery = false })
	camMark:SetAttribute("Camera", true)

	local hall = folder(lb, "HallOfChampions")
	local hallBase = at(P(100, 0, 70)) * yaw(math.pi / 2) -- faces -X, toward the plaza
	part(hall, "HallFloor", V(46, 0.6, 18), hallBase * E.CFrame.new(0, 0.3, 2), PAL.marble, E.Enum.Material.Marble)
	part(hall, "HallBack", V(48, 22, 2), hallBase * E.CFrame.new(0, 11, 11), "#2B2D33", E.Enum.Material.Slate)
	part(hall, "HallTrim", V(48.5, 1.2, 2.4), hallBase * E.CFrame.new(0, 22, 11), PAL.gold, E.Enum.Material.Metal)
	for k = 1, 5 do
		local x = (k - 3) * 9
		local z = math.abs(k - 3) * 1.5
		local cf = hallBase * E.CFrame.new(x, 2, z)
		part(hall, "Plinth" .. k, V(5, 3.4, 5), cf, k == 3 and PAL.gold or PAL.marble, k == 3 and E.Enum.Material.Metal or E.Enum.Material.Marble)
		local spot = part(hall, "HallSpot" .. k, V(1, 0.2, 1), hallBase * E.CFrame.new(x, 3.8, z), PAL.gold, E.Enum.Material.Metal, { Transparency = 1, CanCollide = false, CanQuery = false })
		spot:SetAttribute("Rank", k == 3 and 1 or (k == 2 and 2 or (k == 4 and 3 or (k == 1 and 4 or 5))))
	end
	sign(hall, "HallSign", hallBase * E.CFrame.new(0, 17, 9.8), "HALL OF CHAMPIONS\nMost wins this week")

	local spawn = E.Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = V(16, 1, 16)
	spawn.CFrame = at(P(0, 0.5, 80))
	spawn.Color = E.Color3.fromHex(PAL.gold)
	spawn.Material = E.Enum.Material.Metal
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = lb
	return lb
end

-- ===================== realism: vegetation + ambient particles =====================
-- A clump of four narrow, splayed blades per tuft (reads as grass, not slabs); muted olive
-- greens; no collision so they never snag movement. Terrain grass decoration replaces most of
-- this at runtime when Look.terrainGrass is on.
local function tuft(parent, pos, scale)
	local m = model(parent, "Tuft")
	local c = pick(PAL.grass)
	local r = rr(0, 6.28)
	for k = 0, 3 do
		local h = rr(0.9, 2.1) * scale
		local a = r + k * 1.57 + rr(-0.3, 0.3)
		local tilt = rr(0.18, 0.42)
		local off = V(math.cos(a), 0, math.sin(a)) * (math.sin(tilt) * h / 2)
		deco(m, "Blade", V(0.05, h, rr(0.14, 0.24) * scale), at(pos + off + V(0, h / 2 * math.cos(tilt), 0)) * yaw(-a) * E.CFrame.Angles(0, 0, -tilt), c, E.Enum.Material.LeafyGrass, false)
	end
	return m
end

local function bush(parent, pos, s)
	local m = model(parent, "Bush")
	local c = pick({ "#4A5634", "#56603A", "#3F4A30", "#5E6340" })
	for k = 1, 3 do
		local o = V(rr(-1.2, 1.2) * s, 0, rr(-1.2, 1.2) * s)
		local d = rr(2.4, 4) * s
		sph(m, "Leaves", V(d * 1.2, d * 0.8, d), at(pos + o + V(0, d * 0.32, 0)) * yaw(rr(0, 3)), c, E.Enum.Material.LeafyGrass, { CanCollide = false, CanQuery = false, CastShadow = k == 1 })
	end
	return m
end

local function buildVegetation(root, cfg)
	local f = folder(root, "Vegetation")
	local M, L = cfg.Map.MEADOW, cfg.Map.LAKE
	-- the open field around the Sundial (where most fights start)
	local n, tries = 0, 0
	while n < 1100 and tries < 6000 do
		tries += 1
		local a, d = rr(0, math.pi * 2), rr(150, 700)
		local x, z = math.cos(a) * d, math.sin(a) * d
		local b = MapBuilder.biomeAt(x, z, cfg)
		if b == "field" or b == "wood" or b == "ruins" then
			tuft(f, V(x, 0, z), 1)
			n += 1
		end
	end
	-- denser, taller grass through the Gilded Meadow
	for _ = 1, 650 do
		local a, d = rr(0, math.pi * 2), math.sqrt(rnd()) * (M.r - 6)
		tuft(f, V(M.x + math.cos(a) * d, 0.4, M.z + math.sin(a) * d), 1.25)
	end
	-- reeds and grass on the lake shore
	for _ = 1, 220 do
		local a = rr(0, math.pi * 2)
		local d = L.r + rr(4, 34)
		tuft(f, V(L.x + math.cos(a) * d, 0.5, L.z + math.sin(a) * d), 1.1)
	end
	-- bushes
	local b, bt = 0, 0
	while b < 240 and bt < 3000 do
		bt += 1
		local x, z = rr(-1100, 1100), rr(-700, 1100)
		local bi = MapBuilder.biomeAt(x, z, cfg)
		if (bi == "field" or bi == "wood" or bi == "meadow") and math.sqrt(x * x + z * z) > 170 then
			bush(f, V(x, bi == "meadow" and 0.4 or 0, z), rr(0.8, 1.5))
			b += 1
		end
	end
end

local function emitter(parent, name, size, pos, o)
	local p = mark(parent, name, at(pos))
	p.Size = size
	local pe = E.Instance.new("ParticleEmitter")
	pe.Name = name
	pe.Shape = E.Enum.ParticleEmitterShape.Box
	pe.ShapeStyle = E.Enum.ParticleEmitterShapeStyle.Volume
	pe.Rate = o.rate
	pe.Lifetime = E.NumberRange.new(o.life[1], o.life[2])
	pe.Speed = E.NumberRange.new(o.speed[1], o.speed[2])
	pe.SpreadAngle = E.Vector2.new(180, 180)
	pe.Size = E.NumberSequence.new(o.size)
	pe.Transparency = E.NumberSequence.new(o.transparency)
	pe.LightEmission = o.light or 0
	pe.LightInfluence = 1
	pe.Color = E.ColorSequence.new(E.Color3.fromHex(o.color))
	pe.Rotation = E.NumberRange.new(0, 360)
	pe.RotSpeed = E.NumberRange.new(-8, 8)
	pe.Drag = o.drag or 0
	pe.Acceleration = o.accel or V(0, 0, 0)
	if o.texture then
		pe.Texture = o.texture
	end
	pe.Parent = p
	return p, pe
end

-- Dust motes drifting in the low sun (lobby, Sundial, ruins) and mist rolling on Mirror Lake.
local function buildAmbience(map, cfg)
	local f = folder(map, "Ambience")
	local Lc = cfg.Map.LOBBY_CENTER
	local LB = V(Lc[1], Lc[2], Lc[3])
	local dust = { rate = 14, life = { 8, 14 }, speed = { 0.1, 0.5 }, size = 0.09, transparency = 0.35, light = 0.5, color = "#F2DDB8", drag = 1, accel = V(0.15, 0.02, 0) }
	emitter(f, "DustMotes", V(220, 26, 220), LB + V(0, 13, -20), dust)
	emitter(f, "DustMotes", V(200, 30, 200), V(0, 15, 0), dust)
	local R = cfg.Map.RUINS
	emitter(f, "DustMotes", V(R.r * 1.4, 24, R.r * 1.4), V(R.x, 12, R.z), dust)
	local L = cfg.Map.LAKE
	local mist = { rate = 4, life = { 12, 18 }, speed = { 0.4, 1.2 }, size = 26, transparency = 0.88, light = 0.1, color = "#D8DEDE", drag = 0.3, accel = V(0.6, 0.05, 0.2), texture = "rbxasset://textures/particles/smoke_main.dds" }
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		emitter(f, "LakeMist", V(L.r * 0.9, 4, L.r * 0.9), V(L.x + math.cos(a) * L.r * 0.4, 4, L.z + math.sin(a) * L.r * 0.4), mist)
	end
	local M = cfg.Map.MEADOW
	emitter(f, "MeadowHaze", V(M.r * 1.6, 6, M.r * 1.6), V(M.x, 4, M.z), { rate = 2, life = { 14, 20 }, speed = { 0.2, 0.6 }, size = 30, transparency = 0.92, color = "#E6D6B8", texture = "rbxasset://textures/particles/smoke_main.dds" })
end

-- ===================== templates the server clones =====================
local function buildTemplates(root)
	local t = folder(root, "Templates")
	-- Candyfinch: a round, sugary pink bird
	local f = model(t, "Candyfinch")
	local body = sph(f, "Body", V(1.6, 1.3, 2), at(V(0, 0, 0)), PAL.finch, E.Enum.Material.SmoothPlastic, { CanCollide = false, Anchored = true })
	sph(f, "Head", V(1.1, 1.1, 1.1), at(V(0, 0.5, -0.9)), "#FFB3E6", E.Enum.Material.SmoothPlastic, { CanCollide = false })
	part(f, "Beak", V(0.3, 0.3, 0.5), at(V(0, 0.45, -1.5)), PAL.goldHi, E.Enum.Material.SmoothPlastic, { CanCollide = false })
	for _, s in { -1, 1 } do
		sph(f, "Wing", V(1.6, 0.25, 1.2), at(V(s * 1, 0.2, 0)) * E.CFrame.Angles(0, 0, s * 0.3), "#FF5CC8", E.Enum.Material.SmoothPlastic, { CanCollide = false })
		dball(f, "Eye", 0.2, at(V(s * 0.3, 0.65, -1.35)), "#1C1F2B", E.Enum.Material.SmoothPlastic, false)
	end
	f.PrimaryPart = body
	-- Parachute gift
	local pc = model(t, "Parachute")
	local box = part(pc, "Box", V(3, 3, 3), at(V(0, 0, 0)), "#8A6A3A", E.Enum.Material.Wood, { CanCollide = false })
	sph(pc, "Canopy", V(12, 5, 12), at(V(0, 9, 0)), "#F4EFE6", E.Enum.Material.Fabric, { CanCollide = false })
	sph(pc, "Stripe", V(12.1, 2, 12.1), at(V(0, 9.2, 0)), PAL.gold, E.Enum.Material.Fabric, { CanCollide = false })
	for _, o in { { -4, -4 }, { 4, -4 }, { -4, 4 }, { 4, 4 } } do
		part(pc, "String", V(0.1, 8, 0.1), lookAt(V(o[1] / 2, 4.5, o[2] / 2), V(o[1], 9, o[2])) * E.CFrame.Angles(math.pi / 2, 0, 0), "#FFFFFF", E.Enum.Material.SmoothPlastic, { CanCollide = false })
	end
	pc.PrimaryPart = box
	-- Jubilee token
	local tk = model(t, "Token")
	local coin = cyl(tk, "Coin", 0.4, 2.6, at(V(0, 0, 0)), PAL.goldHi, E.Enum.Material.Neon, { CanCollide = false })
	tk.PrimaryPart = coin
	return t
end

-- Build everything under workspace.Map and return it.
function MapBuilder.build(env, ws, cfg, names, content)
	E = env
	MapBuilder.setEnv(env)
	seed = 20261102
	local map = model(ws, "Map")
	local arena = folder(map, "Arena")
	buildGround(arena, cfg)
	buildHub(arena, cfg, names)
	buildMeadow(arena, cfg)
	buildLake(arena, cfg)
	buildWood(arena, cfg)
	buildRidge(arena, cfg)
	buildRuins(arena, cfg)
	buildScatter(arena, cfg)
	buildVegetation(arena, cfg)
	buildTokens(arena, cfg, content)
	buildVeil(arena, cfg)
	buildGallery(map, cfg, names)
	buildLobby(map, cfg, names, content)
	buildAmbience(map, cfg)
	buildTemplates(map)
	return map
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">Mastery</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Mastery.luau: free cosmetic progress for the weapon you actually use.

	Every bow, spear and knife look (the free default included) earns Mastery points:
	+1 for each match you finish with it equipped, +3 for each knockout with it.
	Patron Club members earn 1.5x (cosmetic only). Nothing here is sold or skippable with
	Robux, so buying a skin starts a track you fill by playing.

	Levels show to everyone: L1 a star in the kill feed, L2 a brighter tracer, L3 a gold trim
	band on the held model, L4 a sparkle, L5 "Mastered" gilded edges and a nametag star.
]]
local Mastery = {}

Mastery.THRESHOLDS = { 5, 15, 35, 70, 120 } -- points needed for levels 1..5
Mastery.MAX = #Mastery.THRESHOLDS
Mastery.PER_MATCH = 1
Mastery.PER_KNOCK = 3
Mastery.PATRON_MULT = 1.5
Mastery.SLOTS = { "bow", "spear", "knife" }

Mastery.PERKS = {
	"★ in the kill feed",
	"Brighter arrow and spear streak",
	"Gold trim band on the weapon",
	"Sparkle on the weapon",
	"Mastered: gilded edges and a ✦ nametag star",
}

-- Save key for a slot + skin ("" = the free default look).
function Mastery.key(slot: string, skinId: string?): string
	return slot .. ":" .. ((skinId and skinId ~= "") and skinId or "default")
end

function Mastery.level(points: number): number
	local lv = 0
	for i, need in ipairs(Mastery.THRESHOLDS) do
		if points >= need then
			lv = i
		end
	end
	return lv
end

-- Points to the next level (nil at max).
function Mastery.toNext(points: number): number?
	local lv = Mastery.level(points)
	if lv >= Mastery.MAX then
		return nil
	end
	return Mastery.THRESHOLDS[lv + 1] - points
end

-- Adds points. Returns new points and whether a level was gained.
function Mastery.add(book: { [string]: number }, key: string, base: number, patron: boolean?): (number, boolean)
	local before = book[key] or 0
	local gain = base
	if patron then
		gain = math.floor(base * Mastery.PATRON_MULT + 0.5)
	end
	local after = before + gain
	book[key] = after
	return after, Mastery.level(after) > Mastery.level(before)
end

function Mastery.stars(points: number): string
	local lv = Mastery.level(points)
	if lv >= Mastery.MAX then
		return "✦"
	end
	return string.rep("★", lv)
end

return Mastery
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">Monetization</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Monetization.luau: THE ONE PLACE FOR ROBUX IDS. Every ID ships as 0 (subscription as "").

	HOW TO FILL THIS IN (PUBLISHING.md §11 lists every product with its suggested price):
	  1. Publish the game once (File > Publish to Roblox).
	  2. Creator Hub > the game > Monetization > Passes: create each entry in `Passes`, paste the ID.
	  3. Monetization > Developer Products: create each entry in `Products` at the listed price.
	     The 11 "Shop" products are price points; the in-game card names the exact item.
	  4. Monetization > Subscriptions: create "Patron Club" (Robux, 299/month), paste its EXP- id.
	  5. Places > Permissions/Settings: allow Private Servers and set the price (suggested R$ 99/month).
	  6. Save, rebuild, publish again.

	Anything left at 0 is hidden in the live game. In Studio play-testing, 0-ID items show a
	"Studio test" button that grants them free so you can try everything.

	Fair-play rules (Roblox monetization guidelines, checked by tests):
	  * No paid random items. Nothing sold has a chance roll. Crates in the arena are free.
	  * Calm copy: "See item", "Buy for R$ X". No ticking timers, no "LAST CHANCE", no fake sales.
	    The weekly shop rotation is real and every rotating item comes back on a fixed cycle.
	  * No paid combat power. Starter Satchel and Trail Boots work only in casual Jubilees, switch
	    off when 10 are left, can be earned free on the Season Track, and ranked ignores them.
	  * Robux never buys Favor. Spectator gifts that help a contender are paid with Favor earned by
	    watching. Patron Picks adds cosmetic-only gift choices.
	  * Tier Skips move you along the cosmetic Season Track only.
	  * PolicyService gates every sale; subscriptions also need IsEligibleToPurchaseSubscription.
]]

export type Pass = { id: number, name: string, price: number, desc: string, icon: string }
export type Product = {
	id: number,
	name: string,
	price: number,
	desc: string,
	icon: string,
	kind: string, -- "boost" | "cosmetic" | "skip" | "shop"
	category: string,
	minutes: number?,
	tiers: number?,
}
export type Subscription = { id: string, name: string, price: number, desc: string, icon: string, perks: { string } }

local Monetization = {}

Monetization.Passes = {
	PremiumLane = { id = 0, name = "Season Track Premium Lane", price = 399, icon = "🌅", desc = "Unlocks the premium cosmetic lane for this season. Every reward is shown before you buy." },
	VIP = { id = 0, name = "Spire VIP", price = 499, icon = "💛", desc = "Gold nametag, +10% Renown in casual matches, and twist + No Betrayals controls in private servers you own. No combat power." },
	GalleryBox = { id = 0, name = "Gallery Box Seat", price = 149, icon = "🎟️", desc = "A cushioned box seat in the Viewing Gallery and a gold name in the gift feed. Cosmetic." },
	BigSponsor = { id = 0, name = "Big Sponsor", price = 249, icon = "🪂", desc = "Earn Favor twice as fast while spectating. Favor itself is never sold." },
	PatronPicks = { id = 0, name = "Patron Picks", price = 199, icon = "🎆", desc = "Two extra Gallery gift choices: a firework flare and a cheering banner over a contender. Cosmetic, paid with earned Favor." },
	StarterSatchel = { id = 0, name = "Starter Satchel", price = 199, icon = "🎒", desc = "Start casual Jubilees with an apple and a canteen. Also free at Season Track tier 12." },
	TrailBoots = { id = 0, name = "Trail Boots", price = 299, icon = "🥾", desc = "+5% stamina regen in casual Jubilees until 10 are left, and a dusty footprint trail. Free at tier 24." },
	TrainingRetry = { id = 0, name = "Extra Training Try", price = 99, icon = "🎯", desc = "One extra try at the pregame target range each match. The score is cosmetic." },
} :: { [string]: Pass }

Monetization.Products = {
	RenownBoost = { id = 0, name = "Renown Boost", price = 49, icon = "✨", kind = "boost", category = "Boosts", minutes = 30, desc = "+50% Renown for 30 minutes. Everyone else in the server gets a free 5-minute Renown Shower." },
	TierSkip = { id = 0, name = "Season Tier Skip", price = 75, icon = "⏩", kind = "skip", category = "Season", tiers = 1, desc = "Move one tier along the Season Track. Cosmetic rewards only." },
	TierSkip10 = { id = 0, name = "Season Tier Skip x10", price = 599, icon = "⏭️", kind = "skip", category = "Season", tiers = 10, desc = "Move ten tiers along the Season Track. Cosmetic rewards only." },
} :: { [string]: Product }

-- One developer product per shop price point (see Store.luau). Created from Store.TIERS.
local SHOP_TIERS = { 25, 49, 99, 149, 199, 299, 399, 499, 799, 1299, 1999, 4999 }
for _, p in ipairs(SHOP_TIERS) do
	Monetization.Products["Shop" .. p] = {
		id = 0,
		name = "Daybreak Shop item (R$ " .. p .. ")",
		price = p,
		icon = "🛍️",
		kind = "shop",
		category = "Shop",
		desc = "Pays for the item or bundle you picked in the shop card. The card shows exactly what you get.",
	}
end

Monetization.Subscriptions = {
	PatronClub = {
		id = "",
		name = "Patron Club",
		price = 299,
		icon = "📜",
		desc = "A monthly club for regulars. Cancel any time in Roblox settings; everything you got stays yours.",
		perks = {
			"A Patron cosmetic each month, kept forever",
			"2 Season Tier Skips each month",
			"+15% Renown in casual matches",
			"A wax-seal Patron stamp on your sponsor letters",
		},
	},
} :: { [string]: Subscription }

-- Private servers are priced in Creator Hub, not here. Suggested: R$ 99 per month.
Monetization.PRIVATE_SERVER_PRICE = 99

-- True when nothing in this module is a random/gacha item (checked by tests).
function Monetization.noRandomItems(): boolean
	for _, p in pairs(Monetization.Products) do
		if p.kind ~= "boost" and p.kind ~= "cosmetic" and p.kind ~= "skip" and p.kind ~= "shop" then
			return false
		end
	end
	return true
end

-- Every Robux price a player can pay, sorted (used for the price-ladder test and the Page).
function Monetization.ladder(extra: { number }?): { number }
	local seen, out = {}, {}
	local function add(p: number)
		if not seen[p] then
			seen[p] = true
			table.insert(out, p)
		end
	end
	for _, p in pairs(Monetization.Passes) do
		add(p.price)
	end
	for _, p in pairs(Monetization.Products) do
		add(p.price)
	end
	for _, s in pairs(Monetization.Subscriptions) do
		add(s.price)
	end
	add(Monetization.PRIVATE_SERVER_PRICE)
	for _, p in ipairs(extra or {}) do
		add(p)
	end
	table.sort(out)
	return out
end

return Monetization
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">Names</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Names.luau — THE NAME-SWAP KIT.

	Every player-facing proper noun in the game comes from this one module: the title, the
	nation, the regions, the hub, the force field, every NPC, the currencies and the badge
	names. To rename the game (for example after a trademark complaint), change the strings
	here, rebuild, and republish. No other file needs to change. The tests check that no other
	source file hard-codes the title.

	Rules for anything you put here (see README "IP guardrails"):
	  * No book or film names, places, characters, symbols or quotes from any franchise.
	  * Keep the game's own world: Halcyon, the Spire, the Reaches, the Sundial, the Veil.
]]
local Names = {}

Names.TITLE = "Daybreak on the Harvesting"
Names.SHORT_TITLE = "Daybreak"
Names.TAGLINE = "48 contenders. 24 Reaches. One champion at daybreak."

-- World
Names.NATION = "Halcyon"
Names.CAPITAL = "the Spire"
Names.REGION = "Reach"
Names.REGIONS = "Reaches"
Names.EVENT = "the Jubilee Trials"
Names.EVENT_SHORT = "Jubilee"
Names.DRAW = "the Harvesting"
Names.CONTENDER = "Contender"
Names.CONTENDERS = "Contenders"
Names.CHAMPION = "Champion"
Names.HUB = "the Sundial"
Names.VEIL = "the Veil"
Names.GALLERY = "the Viewing Gallery"
Names.SHOWRUNNERS = "the Showrunners"

-- People (all original characters)
Names.MENTOR = "Rusty Dunmore"
Names.MENTOR_SHORT = "Rusty"
Names.HERALD = "Herald Marigold Vane"
Names.HOST = "Monty Gleam"
Names.PUP = "Bubbles"
Names.BOT_TAG = "Stand-In"

-- Currencies and progression
Names.XP = "Renown"
Names.FAVOR = "Favor"
Names.STARS = "Daybreak Stars"
Names.TRACK = "Season Track"
Names.TOKENS = "Jubilee Tokens"

-- Hazards and places in the arena
Names.FINCHES = "Candyfinches"
Names.MEADOW = "the Gilded Meadow"
Names.BLOOM = "Meadow Bloom"
Names.LAKE = "Mirror Lake"
Names.WOOD = "Whisperwood"
Names.RIDGE = "Ashen Ridge"
Names.RUINS = "Old Glassford"

-- The 24 Reaches. Each sends two contenders in a Jubilee year (24 x 2 = 48).
Names.REACH_LIST = {
	"Cinderhollow", "Saltmere", "Timberwick", "Glassford", "Orchard Vale", "Loomstead",
	"Ironbend", "Windmere", "Quarrytop", "Reedmarsh", "Copperfield", "Hearthstone",
	"Millbrook", "Lanternfall", "Stonecross", "Wheatlow", "Brinecliff", "Ashgrove",
	"Kilnside", "Tidewater", "Foxhollow", "Silverrun", "Thistledown", "Bellhaven",
} :: { string }

-- Prestige ranks (index 0 = no prestige yet)
Names.RANKS = { [0] = "Reaped", [1] = "Contender", [2] = "Favorite", [3] = "Champion", [4] = "Legend" } :: { [number]: string }

function Names.rank(prestige: number): string
	local p = math.clamp(math.floor(prestige), 0, 4)
	return Names.RANKS[p]
end

function Names.reachIndex(name: string): number?
	for i, n in ipairs(Names.REACH_LIST) do
		if n == name then
			return i
		end
	end
	return nil
end

return Names
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">Offers</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Offers.luau: the few moments the game shows a cosmetic at a natural point. Every card is
	calm (checked against Store.PRESSURE_WORDS in tests), has a "No thanks" that closes it for
	the rest of the session, and never appears for players whose policy hides paid items.

	1. Fade preview after a match with a knockout: "See your knockout with Comet Tail". It
	   plays a knockout on a local practice double of you with that fade. Trying is free.
	2. First win: a free earned pose (First Light), then one quiet line about the Locker.
	3. Gallery partner moment: when your partner is in the last 10 or low on Pep, a card
	   suggests a free Favor gift and shows which Wrap it falls under.
]]
-- In Roblox, siblings come from script.Parent; under Lune tests (no `script`), by path.
local Store: any, Content: any
if typeof(script) == "Instance" then
	local here = (script :: any).Parent
	Store = require(here.Store) :: any
	Content = require(here.Content) :: any
else
	Store = (require :: any)("./Store")
	Content = (require :: any)("./Content")
end

local Offers = {}

Offers.MAX_PER_SESSION = 2 -- shop-linked cards per session (first-win gift and Gallery card excluded)

export type Card = { kind: string, title: string, body: string, itemId: string?, price: number?, tryLabel: string?, buyLabel: string?, noLabel: string, style: string?, color: string?, target: string?, gift: string? }

-- Choose a fade to preview after a match: the cheapest fade in the shop this week the player
-- doesn't own. Nil if they own them all or have no knockouts.
function Offers.fadePreview(owned: { [string]: any }, week: number, knocks: number): Card?
	if knocks <= 0 then
		return nil
	end
	local best = nil
	for _, it in ipairs(Store.ITEMS) do
		if it.slot == "fade" and not it.earned and not owned[it.id] and Store.inRotation(it.id, week) and Content.FADES[it.id] then
			if not best or it.price < best.price then
				best = it
			end
		end
	end
	if not best then
		return nil
	end
	return {
		kind = "fadePreview",
		title = "See your knockout with " .. best.name,
		body = string.format("Watch a knockout play out on your practice double with the %s fade. Only you see it, and trying is free.", best.name),
		itemId = best.id,
		price = best.price,
		tryLabel = "▶ Watch it",
		buyLabel = "Get it (R$ " .. best.price .. ")",
		noLabel = "No thanks",
	}
end

-- First win: the free gift, and a single gentle pointer to the Locker.
function Offers.firstWin(name: string): Card
	return {
		kind = "firstWin",
		title = "First win, " .. name .. "!",
		body = "The First Light pose is yours, free. It plays on the podium every time you win. You can change it in the Locker.",
		itemId = "pose_firstlight",
		tryLabel = "Equip First Light",
		noLabel = "Close",
	}
end

-- Gallery: when should we show the partner card?
function Offers.partnerMoment(alive: number, partnerPep: number, pepMax: number): boolean
	return alive <= 10 or partnerPep <= pepMax * 0.35
end
function Offers.partnerCard(partner: string, giftName: string, cost: number, favor: number, wrapName: string?): Card
	local canAfford = favor >= cost
	return {
		kind = "partnerGift",
		title = partner .. " could use a hand",
		body = canAfford
				and string.format("Send %s a %s for %d Favor (your partner price). It floats down under your %s.", partner, giftName, cost, wrapName or "Gallery Gold Wrap")
			or string.format("A %s costs %d Favor. You earn Favor by watching; you have %d.", giftName, cost, favor),
		tryLabel = canAfford and ("Send " .. giftName) or nil,
		noLabel = "Not now",
	}
end

-- Copy check used by tests: no pressure words in any card.
function Offers.calm(c: Card): boolean
	local text = (c.title .. " " .. c.body .. " " .. (c.buyLabel or "") .. " " .. (c.tryLabel or "") .. " " .. c.noLabel):lower()
	for _, w in ipairs(Store.PRESSURE_WORDS) do
		if text:find(w, 1, true) then
			return false
		end
	end
	return true
end

return Offers
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">Prefs</string>
          <string name="Source"><![CDATA[--!strict
-- Persisted preferences. New keys fill in on old saves through Reconcile; nothing here is wiped.
local Prefs = {}

local boolKeys: { [string]: boolean } = {
	autoQueue = true,
	sfx = true,
	shortReaping = true,
	viewFirst = true,
	reduceMotion = true,
}
Prefs.BOOL = boolKeys

local numberKeys: { [string]: boolean } = {
	volWeapons = true,
	volHits = true,
	volFootsteps = true,
	volPickups = true,
	volUi = true,
	volAmbient = true,
	volVeil = true,
	volVoice = true,
}
Prefs.NUMBER = numberKeys

function Prefs.defaultSettings(): { [string]: any }
	return {
		autoQueue = true,
		sfx = true,
		shortReaping = false,
		mode = "", -- "" = auto (Modes.preferred). Changed only by setMode.
		viewFirst = false, -- third person stays the default
		reduceMotion = false,
		volWeapons = 0.7,
		volHits = 0.62,
		volFootsteps = 0.38,
		volPickups = 0.55,
		volUi = 0.42,
		volAmbient = 0.22,
		volVeil = 0.36,
		volVoice = 0.48,
	}
end

-- Returns whether the write is allowed, and the value to store. `false` is a valid boolean.
function Prefs.sanitize(key: any, value: any): (boolean, any)
	if type(key) ~= "string" then
		return false, nil
	end
	if key == "mode" then
		return false, nil
	end
	if Prefs.BOOL[key] then
		if type(value) ~= "boolean" then
			return false, nil
		end
		return true, value
	end
	if Prefs.NUMBER[key] then
		if type(value) ~= "number" or value ~= value then
			return false, nil
		end
		return true, math.clamp(value, 0, 1)
	end
	return false, nil
end

return Prefs
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">Presentation</string>
          <string name="Source"><![CDATA[--!strict
--[[
	First-person presentation, as numbers only.

	The first-person camera is a view. It does not feed hit detection. Shots use `shotAim`,
	which starts 12.5 studs behind the head (a normal third-person zoom) and runs along the
	look line through the head. `eyePosition` is only where the picture is drawn, 0.6 studs
	in front of the head on that same line, so sliding the lens forward does not invent a
	tighter ray. The client never passes the camera position into `shotAim`. The server
	still casts from the chest toward the aim point.

	Hands live on the viewmodel, in front of the lens and below the center, so the crosshair
	stays clear. Head, hair and hats are hidden locally. Field of view stays at 70, or 72
	while sprinting when reduced motion is off.
]]
local Presentation = {}

Presentation.FOV = 70
Presentation.FOV_SPRINT = 72
Presentation.FOV_MAX = 74
Presentation.AIM_ZOOM = 12.5
Presentation.AIM_REACH = 500
Presentation.EYE_FORWARD = 0.6
Presentation.PITCH_MIN = -1.396 -- about -80 degrees
Presentation.PITCH_MAX = 1.396
Presentation.MOUSE_SENS = 0.0022
Presentation.STICK_SPEED = 2.1

local hideParts: { [string]: boolean } = { Head = true }
local hideClasses: { [string]: boolean } = { Accessory = true, Accoutrement = true, Hat = true }
Presentation.HIDE_PART_NAMES = hideParts
Presentation.HIDE_CLASSES = hideClasses
-- The local body is hidden while the viewmodel draws the hands, so hair and shoulders cannot fill the lens.
Presentation.HIDE_LOCAL_BODY = true

-- Camera space: -Z is in front of the lens, +Y is up. Hands sit low and off the center dot.
local hands: { [string]: { x: number, y: number, z: number } } = {
	right = { x = 0.58, y = -0.46, z = -1.35 },
	left = { x = -0.22, y = -0.5, z = -1.05 },
}
Presentation.HANDS = hands

local function mag(v: { x: number, y: number, z: number }): number
	return math.sqrt(v.x * v.x + v.y * v.y + v.z * v.z)
end

function Presentation.unit(v: { x: number, y: number, z: number }): { x: number, y: number, z: number }
	local m = mag(v)
	if m < 1e-6 then
		return { x = 0, y = 0, z = -1 }
	end
	return { x = v.x / m, y = v.y / m, z = v.z / m }
end

function Presentation.shoulderOrigin(focus: { x: number, y: number, z: number }, look: { x: number, y: number, z: number }, zoom: number?): { x: number, y: number, z: number }
	local l = Presentation.unit(look)
	local z = zoom or Presentation.AIM_ZOOM
	return { x = focus.x - l.x * z, y = focus.y - l.y * z, z = focus.z - l.z * z }
end

function Presentation.eyePosition(focus: { x: number, y: number, z: number }, look: { x: number, y: number, z: number }, forward: number?): { x: number, y: number, z: number }
	local l = Presentation.unit(look)
	local f = forward or Presentation.EYE_FORWARD
	return { x = focus.x + l.x * f, y = focus.y + l.y * f, z = focus.z + l.z * f }
end

local function along(origin: { x: number, y: number, z: number }, look: { x: number, y: number, z: number }, reach: number): { x: number, y: number, z: number }
	return { x = origin.x + look.x * reach, y = origin.y + look.y * reach, z = origin.z + look.z * reach }
end

-- World point sent to the server. Always the shoulder ray, never the eye.
function Presentation.shotAim(focus: { x: number, y: number, z: number }, look: { x: number, y: number, z: number }): { x: number, y: number, z: number }
	local l = Presentation.unit(look)
	return along(Presentation.shoulderOrigin(focus, l, Presentation.AIM_ZOOM), l, Presentation.AIM_REACH)
end

-- Where an eye-level ray would land. The client does not call this. Tests use it to show the lens is not the aim origin.
function Presentation.eyeAim(focus: { x: number, y: number, z: number }, look: { x: number, y: number, z: number }): { x: number, y: number, z: number }
	local l = Presentation.unit(look)
	return along(Presentation.eyePosition(focus, l, Presentation.EYE_FORWARD), l, Presentation.AIM_REACH)
end

function Presentation.dirFrom(from: { x: number, y: number, z: number }, aim: { x: number, y: number, z: number }): { x: number, y: number, z: number }
	return Presentation.unit({ x = aim.x - from.x, y = aim.y - from.y, z = aim.z - from.z })
end

function Presentation.fov(sprinting: boolean, reduce: boolean): number
	if reduce or not sprinting then
		return Presentation.FOV
	end
	return math.min(Presentation.FOV_SPRINT, Presentation.FOV_MAX)
end

function Presentation.bob(t: number, speed: number, reduce: boolean): { x: number, y: number, z: number }
	if reduce or speed < 0.75 then
		return { x = 0, y = 0, z = 0 }
	end
	local s = math.clamp(speed / 16, 0, 1.35)
	return {
		x = math.sin(t * 8) * 0.018 * s,
		y = math.abs(math.sin(t * 8)) * 0.032 * s,
		z = 0,
	}
end

function Presentation.hidesPart(name: string): boolean
	return Presentation.HIDE_PART_NAMES[name] == true
end

function Presentation.hidesClass(className: string): boolean
	return Presentation.HIDE_CLASSES[className] == true
end

function Presentation.crosshairVisible(first: boolean, arena: boolean, panelOpen: boolean, held: boolean): boolean
	return first and arena and not panelOpen and not held
end

return Presentation
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">Season2</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Season2.luau: the plan for Season 2, "High Harvest". Its 12 shop items are already in
	Store.luau (season = 2, drops 7-10) on a fixed schedule from Season 1 week 10, with the
	R$ 1,999 High Harvest Collection. The track, weekly rules and twists below are still to build.
	Tests check the two lists agree.
]]
local Season2 = {}

Season2.NAME = "High Harvest"
Season2.WEEKS = 10
Season2.STARTS_AFTER_S1_WEEKS = 9 -- Season 2 week 1 = Season 1 week 10 (Store.SEASON2_WEEK)

-- Season Track: 30 tiers, cosmetics only. free = everyone, club = Patron Club.
Season2.TRACK = {
	{ tier = 1, free = "title_highharvest", club = "tag_s2_copper" },
	{ tier = 5, free = "banner_s2_sheaf", club = "wrap_s2_hayloft" },
	{ tier = 10, free = "emote_s2_scythe", club = "fade_s2_windmill" },
	{ tier = 15, free = "tag_s2_copper", club = "parade_s2_scarecrow" },
	{ tier = 20, free = "wrap_s2_hayloft", club = "skin_bow_s2_orchard" },
	{ tier = 25, free = "pose_s2_harvestking", club = "pose_s2_harvestking" },
	{ tier = 30, free = "skin_knife_s2_sickle", club = "skin_spear_s2_pitch" },
}

-- Shop items (planned prices on Store.TIERS, 3 per weekly drop).
Season2.ITEMS = {
	{ id = "skin_bow_s2_orchard", name = "Orchard Bow", slot = "bow", price = 299, drop = 1 },
	{ id = "fade_s2_windmill", name = "Windmill Sails", slot = "fade", price = 199, drop = 1 },
	{ id = "emote_s2_scythe", name = "Scythe Spin", slot = "emote", price = 99, drop = 1 },
	{ id = "skin_spear_s2_pitch", name = "Pitchfork Spear", slot = "spear", price = 399, drop = 2 },
	{ id = "pose_s2_harvestking", name = "Harvest King", slot = "pose", price = 299, drop = 2 },
	{ id = "tag_s2_copper", name = "Copper Sheaf Nametag", slot = "nametag", price = 149, drop = 2 },
	{ id = "skin_knife_s2_sickle", name = "Moon Sickle", slot = "knife", price = 199, drop = 3 },
	{ id = "wrap_s2_hayloft", name = "Hayloft Wrap", slot = "wrap", price = 99, drop = 3 },
	{ id = "parade_s2_scarecrow", name = "Scarecrow Parade Coat", slot = "parade", price = 199, drop = 3 },
	{ id = "rusty_s2_farmer", name = "Rusty: Old Farmer", slot = "rusty", price = 149, drop = 4 },
	{ id = "banner_s2_sheaf", name = "Sheaf Banner", slot = "banner", price = 99, drop = 4 },
	{ id = "fade_s2_fireflies", name = "Firefly Field", slot = "fade", price = 299, drop = 4 },
}
Season2.GRAND_PRICE = 1999 -- the High Harvest Collection (Store bundle high_harvest): 12 items worth R$ 2,488

-- New weekly rules and twists to author (names and one-line intent).
Season2.WEEKLY_RULES = {
	{ id = "hay_bales", name = "Hay Bales", note = "Bales you can hide in; arrows set them smouldering." },
	{ id = "long_dusk", name = "Long Dusk", note = "The Veil closes slower but the arena goes dark sooner." },
	{ id = "scarecrows", name = "Scarecrow Field", note = "Decoy scarecrows that wear your Parade look." },
	{ id = "orchard_feast", name = "Orchard Feast", note = "More food, fewer crates." },
}
Season2.TWISTS = {
	{ id = "harvest_moon", name = "Harvest Moon", note = "Mid-match: the moon rises and every Fade glows twice as bright." },
	{ id = "windmill", name = "The Windmill", note = "A central landmark whose sails sweep the hill every 30 seconds." },
}

Season2.HALL = "Season 1 Champions stay in the Hall in a gold alcove."

return Season2
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">SfxIds</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Sound cues for Daybreak.

	Two layers, on purpose:

	  * Playable now. `engine` is a Roblox engine sound (`rbxasset://sounds/...`, the same
	    short effects the client ships for buttons, hits and footsteps — not music). `libraryId`
	    is one of the twelve Roblox-library ids this project already used. No new marketplace
	    ids are added here.
	  * Original samples. `sample` is a file under `audio/samples/`, synthesized for this game
	    (see `scripts/synth-audio.py`). `uploadId` stays 0 until you upload that file and paste
	    the new id. Playback then prefers the upload. Until then the cue is a stand-in, not the
	    original recording.

	A cue with neither an engine path nor a library id is a placeholder: it stays silent in
	Studio until the sample is uploaded. Those are the looping beds (`ambientArena`,
	`ambientLobby`). Everything else is marked playable.

	Volumes are cue-level. The buses in Settings scale them again. Nothing here is a song.
]]

export type Cue = {
	bus: string,
	volume: number,
	pitch: number,
	minGap: number,
	spatial: boolean,
	rollMin: number,
	rollMax: number,
	stop: number,
	loop: boolean,
	uploadId: number,
	engine: string,
	libraryId: number,
	sample: string,
	note: string,
}

local function c(
	bus: string,
	volume: number,
	pitch: number,
	minGap: number,
	spatial: boolean,
	rollMin: number,
	rollMax: number,
	stop: number,
	loop: boolean,
	engine: string,
	libraryId: number,
	sample: string,
	note: string
): Cue
	return {
		bus = bus,
		volume = volume,
		pitch = pitch,
		minGap = minGap,
		spatial = spatial,
		rollMin = rollMin,
		rollMax = rollMax,
		stop = stop,
		loop = loop,
		uploadId = 0,
		engine = engine,
		libraryId = libraryId,
		sample = sample,
		note = note,
	}
end

local S = true
local F = false

-- Library ids already shipped in this project (Roblox library / Pro Sound Effects). Do not add more.
-- 15675059323 click, 15675055424 pop, 9117841338 popAiry, 9113728756 register,
-- 9113849492 coins, 9126073001 ding, 9113584163 bell, 9114898444 fanfare,
-- 9113959343 crunch, 9120907511 swat, 9125594711 whoosh, 9119165436 hiss.

local cues: { [string]: Cue } = {
	-- Weapons. Each one uses a different engine file so a bow, spear, knife and shove read apart.
	bowDraw = c("weapons", 0.28, 1.12, 0.16, F, 8, 70, 0.32, F, "rbxasset://sounds/unsheath.mp3", 0, "bow-draw.wav", "String tension before a shot"),
	bowRelease = c("weapons", 0.4, 1.04, 0.12, S, 8, 78, 0.28, F, "rbxasset://sounds/Rubber band sling shot.mp3", 0, "bow-release.wav", "Bow string"),
	spearSwing = c("weapons", 0.38, 0.9, 0.12, S, 8, 64, 0.32, F, "rbxasset://sounds/swordlunge.mp3", 0, "spear-swing.wav", "Spear swing"),
	spearThrow = c("weapons", 0.36, 0.86, 0.16, S, 8, 90, 0.3, F, "rbxasset://sounds/swoosh.mp3", 0, "spear-throw.wav", "Thrown spear"),
	knifeSwing = c("weapons", 0.34, 1.22, 0.1, S, 6, 48, 0.22, F, "rbxasset://sounds/swordslash.mp3", 0, "knife-swing.wav", "Knife swing"),
	shove = c("weapons", 0.3, 1.05, 0.16, S, 6, 40, 0.28, F, "rbxasset://sounds/impact_bodyfall.mp3", 0, "shove.wav", "Shove"),
	equip = c("weapons", 0.26, 0.96, 0.18, F, 6, 40, 0.28, F, "rbxasset://sounds/unsheath.mp3", 0, "equip.wav", "Weapon into the hand"),

	-- Hits and knockouts. The shared bell is the count drop; the attacker also gets a short confirm.
	hitLight = c("hits", 0.4, 1.16, 0.08, F, 8, 55, 0.18, F, "rbxasset://sounds/hit.mp3", 0, "hit-light.wav", "Hit confirm"),
	hitHeavy = c("hits", 0.22, 0.9, 0.12, S, 8, 60, 0.24, F, "rbxasset://sounds/bass.mp3", 0, "hit-heavy.wav", "Heavier hit"),
	hurt = c("hits", 0.26, 1.0, 0.22, F, 8, 40, 0.18, F, "rbxasset://sounds/hit.mp3", 0, "hurt.wav", "You were hit"),
	knockout = c("hits", 0.4, 0.92, 0.4, F, 12, 120, 1.5, F, "", 9113584163, "knockout.wav", "One soft bell when someone is tapped out"),
	knockConfirm = c("hits", 0.28, 1.05, 0.2, F, 8, 40, 0.16, F, "rbxasset://sounds/snap.mp3", 0, "knock-confirm.wav", "Your own knockout confirm"),

	-- Footsteps, one family per surface. Quiet, short, and rate-limited in Audio.footInterval.
	footGrass = c("footsteps", 0.28, 1.0, 0.28, S, 4, 32, 0.12, F, "rbxasset://sounds/grass.mp3", 0, "foot-grass.wav", "Grass"),
	footDirt = c("footsteps", 0.26, 0.92, 0.28, S, 4, 32, 0.12, F, "rbxasset://sounds/grassstone.mp3", 0, "foot-dirt.wav", "Dirt and mud"),
	footStone = c("footsteps", 0.3, 1.0, 0.28, S, 4, 36, 0.1, F, "rbxasset://sounds/stone.mp3", 0, "foot-stone.wav", "Stone"),
	footWood = c("footsteps", 0.28, 1.0, 0.28, S, 4, 34, 0.12, F, "rbxasset://sounds/wood.mp3", 0, "foot-wood.wav", "Wood"),
	footMetal = c("footsteps", 0.22, 1.05, 0.28, S, 4, 40, 0.1, F, "rbxasset://sounds/metal.mp3", 0, "foot-metal.wav", "Metal"),
	footWater = c("footsteps", 0.2, 1.0, 0.34, S, 4, 28, 0.22, F, "rbxasset://sounds/impact_water.mp3", 0, "foot-water.wav", "Water"),
	footGlass = c("footsteps", 0.18, 1.15, 0.28, S, 4, 30, 0.1, F, "rbxasset://sounds/ice.mp3", 0, "foot-glass.wav", "Glass and ice"),
	footDefault = c("footsteps", 0.22, 1.0, 0.28, S, 4, 30, 0.12, F, "rbxasset://sounds/action_footsteps_plastic.mp3", 0, "foot-default.wav", "Other surfaces"),
	footLand = c("footsteps", 0.26, 1.0, 0.28, S, 4, 36, 0.16, F, "rbxasset://sounds/action_jump_land.mp3", 0, "foot-land.wav", "Landing"),

	-- Pickups and use.
	pickup = c("pickups", 0.34, 1.12, 0.08, F, 6, 40, 0.16, F, "rbxasset://sounds/snap.mp3", 0, "pickup.wav", "Item found"),
	crate = c("pickups", 0.24, 1.05, 0.2, S, 6, 36, 0.22, F, "rbxasset://sounds/collide.mp3", 0, "crate.wav", "Crate"),
	snack = c("pickups", 0.3, 1.0, 0.25, F, 6, 30, 0.35, F, "", 9113959343, "snack.wav", "Eat or drink"),
	token = c("pickups", 0.34, 1.0, 0.2, F, 6, 40, 0.7, F, "", 9113849492, "token.wav", "Jubilee Token"),
	parachute = c("pickups", 0.28, 1.0, 0.25, F, 8, 50, 0.55, F, "", 9117841338, "parachute.wav", "Parachute gift landing"),

	-- Interface, lobby, cutscene stingers.
	uiClick = c("ui", 0.3, 1.0, 0.04, F, 1, 1, 0.08, F, "rbxasset://sounds/button.mp3", 0, "ui-click.wav", "Buttons"),
	chime = c("ui", 0.32, 1.0, 0.12, F, 1, 1, 0.55, F, "", 9126073001, "chime.wav", "Confirm, pact offer, challenge"),
	win = c("ui", 0.3, 1.0, 0.5, F, 1, 1, 1.6, F, "", 9114898444, "win.wav", "Win stinger"),
	purchase = c("ui", 0.28, 1.0, 0.25, F, 1, 1, 0.7, F, "", 9113728756, "purchase.wav", "Purchase thanks"),
	giftSend = c("ui", 0.26, 1.12, 0.16, F, 1, 1, 0.22, F, "rbxasset://sounds/swoosh.mp3", 0, "gift.wav", "Gallery gift sent"),
	cutscene = c("ui", 0.26, 0.84, 0.3, F, 1, 1, 0.7, F, "", 9113584163, "cutscene.wav", "Draw and ceremony sting"),

	-- Sparse air, playable today. The looping beds below are upload placeholders.
	arenaAir = c("ambient", 0.1, 0.78, 10, F, 1, 1, 0.2, F, "rbxasset://sounds/grass3.mp3", 0, "arena-air.wav", "Occasional arena air, not a loop"),
	lobbyAir = c("ambient", 0.07, 0.72, 12, F, 1, 1, 0.2, F, "rbxasset://sounds/electronicpingshort.mp3", 0, "lobby-air.wav", "Occasional lobby tone"),
	ambientArena = c("ambient", 0.18, 1.0, 0, F, 1, 1, 0, S, "", 0, "ambient-arena.wav", "PLACEHOLDER loop. Silent until audio/samples/ambient-arena.wav is uploaded."),
	ambientLobby = c("ambient", 0.16, 1.0, 0, F, 1, 1, 0, S, "", 0, "ambient-lobby.wav", "PLACEHOLDER loop. Silent until audio/samples/ambient-lobby.wav is uploaded."),

	-- Veil. Touches are rate-limited so standing in the wall does not machine-gun.
	veilTouch = c("veil", 0.26, 0.9, 0.9, F, 1, 1, 0.4, F, "", 9119165436, "veil-touch.wav", "Contact with the Veil"),
	veilWarn = c("veil", 0.2, 0.62, 7, F, 1, 1, 0.35, F, "rbxasset://sounds/electronicpingshort.mp3", 0, "veil-warn.wav", "Near the wall while it closes"),
	veilSoon = c("veil", 0.16, 0.8, 8, F, 1, 1, 0.28, F, "rbxasset://sounds/switch.mp3", 0, "veil-soon.wav", "Shrink is close and you are near the edge"),
	veilCore = c("veil", 0.22, 1.25, 1.2, F, 1, 1, 0.3, F, "rbxasset://sounds/electronicpingshort.mp3", 0, "veil-core.wav", "Veil Core lights"),
	veilBreak = c("veil", 0.2, 1.15, 1.0, F, 1, 1, 0.45, F, "rbxasset://sounds/bass.mp3", 0, "veil-break.wav", "Dome calmed"),
	hazard = c("veil", 0.22, 0.78, 1.4, F, 1, 1, 0.3, F, "rbxasset://sounds/collide.mp3", 0, "hazard.wav", "Hazard called"),
	pactWarn = c("veil", 0.24, 0.55, 0.45, F, 1, 1, 0.28, F, "rbxasset://sounds/button.mp3", 0, "pact-warn.wav", "Pact snap warning"),
}

return cues
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">Store</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Store.luau: the Daybreak Item Shop catalog and its rules, as pure data + helpers (tested).

	How selling works
	  * Every item and bundle has one fixed Robux price from Store.TIERS. Each price has ONE
	    developer product in Monetization.Products ("Shop199" and so on), so Mike creates 11
	    products instead of one per item. Before the Roblox prompt, the game shows a card with the
	    exact item name, picture and price, and saves that choice ("intent") in the player's save.
	  * When the receipt arrives, the saved intent is granted. If it is missing or doesn't match
	    (a server restarted mid-purchase), the buyer gets a Shop Voucher for that price instead,
	    which buys any item at that price or lower. Nobody ever loses Robux.
	  * Nothing is random. No item changes stats. Items are kept forever.

	The weekly rotation is real, not fake urgency
	  * Always-on items never leave. Rotating items are featured for one real week (Monday 00:00
	    UTC to Monday 00:00 UTC), and every one of them comes back on a fixed cycle (the shop shows
	    when). The copy never says "last chance", never shows a ticking timer, never says sold out.
]]
local Store = {}

local Events: any
if typeof(script) == "Instance" then
	Events = require((script :: any).Parent.Logic.Events) :: any
else
	Events = (require :: any)("./Logic/Events")
end

export type Item = {
	id: string,
	name: string,
	cat: string,
	slot: string,
	price: number,
	icon: string,
	color: string,
	desc: string,
	rot: boolean, -- true = weekly rotation, false = always on sale
	anim: number?, -- Studio animation asset id for poses/emotes (0 = built-in fallback effect)
	sound: number?, -- Studio audio id for Rusty voice packs (0 = text lines only)
	shopOnly: boolean?,
	drop: number?, -- weekly drop number (1..6): joins the shop that week of Season 1, then rotates
	earned: boolean?, -- never sold: first win, member monthly, Patron Club, invites
	clip: string?, -- Anim.CLIPS key for poses/emotes when it differs from the id
	season: number?, -- 2 = Season 2 (High Harvest); its drops (7-10) start in season week 10
	event: string?, -- yearly festival id (Events.luau): on sale only during that festival
}
export type Bundle = { id: string, name: string, price: number, icon: string, desc: string, items: { string }, once: boolean?, event: string?, fromWeek: number? }

-- One developer product per price point. Covers R$25 to R$4,999.
Store.TIERS = { 25, 49, 99, 149, 199, 299, 399, 499, 799, 1299, 1999, 4999 }
Store.FEATURED_PER_WEEK = 6
Store.WEEK = 604800
Store.EPOCH_MONDAY = 345600 -- Monday 5 Jan 1970 00:00 UTC

Store.CATS = { "Arms", "Fades", "Poses", "Emotes", "Wraps", "Nametags", "Parade", "Rusty", "Reach" }
Store.SLOTS = { "bow", "spear", "knife", "fade", "pose", "emote", "wrap", "nametag", "parade", "rusty", "banner" }

local items: { Item } = {
	-- Arms: weapon skins. Same stats, new look: the held model built from parts (Arms.luau), the
	-- arrow / spear streak everyone sees, the hotbar tile and the kill-feed icon.
	{ id = "skin_bow_ashen", name = "Ashwood Bow", cat = "Arms", slot = "bow", price = 99, icon = "🏹", color = "#C9B79C", desc = "Pale ash with a dark grip. Same stats, new look.", rot = false },
	{ id = "skin_bow_gilded", name = "Gilded Bow", cat = "Arms", slot = "bow", price = 199, icon = "🏹", color = "#FFD36B", desc = "Gold-leaf limbs and a warm gold arrow streak. Same stats.", rot = false },
	{ id = "skin_bow_mirror", name = "Mirrorwood Bow", cat = "Arms", slot = "bow", price = 149, icon = "🏹", color = "#BFE7FF", desc = "Polished like Mirror Lake. Silver streak. Same stats.", rot = true },
	{ id = "skin_bow_frost", name = "Frostline Bow", cat = "Arms", slot = "bow", price = 299, icon = "🏹", color = "#9FE3FF", desc = "Frosted limbs and an icy streak. Same stats.", rot = true },
	{ id = "skin_bow_regent", name = "Regent's Longbow", cat = "Arms", slot = "bow", price = 499, icon = "🏹", color = "#FFB347", desc = "Carved gold and a wide sunset streak. Same stats.", rot = true },
	{ id = "skin_spear_ashen", name = "Ashen Spear", cat = "Arms", slot = "spear", price = 99, icon = "🗡️", color = "#A8A29A", desc = "Soot-gray shaft. Same stats, new look.", rot = false },
	{ id = "skin_spear_ember", name = "Ember Spear", cat = "Arms", slot = "spear", price = 199, icon = "🗡️", color = "#FF7A3D", desc = "A glowing ember tip and a spark trail when thrown. Same stats.", rot = false },
	{ id = "skin_spear_lake", name = "Lakeglass Spear", cat = "Arms", slot = "spear", price = 299, icon = "🗡️", color = "#6FD3E8", desc = "Blue glass head and a ripple trail. Same stats.", rot = true },
	{ id = "skin_knife_copper", name = "Copper Knife", cat = "Arms", slot = "knife", price = 49, icon = "🔪", color = "#D98A4E", desc = "Warm copper blade. Same stats.", rot = false },
	{ id = "skin_knife_night", name = "Nightglass Knife", cat = "Arms", slot = "knife", price = 149, icon = "🔪", color = "#8E7CFF", desc = "Dark glass with a violet edge. Same stats.", rot = true },
	-- Fades: how your knockouts dissolve into light (seen by everyone nearby).
	{ id = "fade_ember", name = "Ember Light", cat = "Fades", slot = "fade", price = 99, icon = "🔥", color = "#FF8A4C", desc = "Knockouts dissolve into warm ember light.", rot = false },
	{ id = "fade_veil", name = "Veil Shimmer", cat = "Fades", slot = "fade", price = 99, icon = "💠", color = "#7FF3FF", desc = "Knockouts dissolve into cyan shimmer.", rot = false },
