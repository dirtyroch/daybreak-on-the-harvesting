          <string name="Name">Anim</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Anim.luau: podium poses and emotes as keyframes generated in code.

	Each clip is a list of keyframes over R15 joints (Motor6D names), in degrees. The client's
	AnimPlayer samples a clip every frame and writes Motor6D.Transform, so every pose and emote
	really moves the character with no uploaded animation. When Mike uploads a polished
	animation and puts its id on the Store item (`anim`), that plays instead.

	Rotations: X+ swings a limb forward/up, Z+ lifts the right arm out to the side (Z- for the
	left arm), Waist X- bends forward, Root Y spins the whole body.
]]
local Anim = {}

export type Rot = { number } -- { x, y, z } degrees
export type Key = { t: number, pose: { [string]: Rot } }
export type Clip = { length: number, loop: boolean, hold: boolean?, keys: { Key }, prop: string?, propJoint: string? }

Anim.JOINTS = {
	"Root", "Waist", "Neck",
	"RightShoulder", "RightElbow", "RightWrist",
	"LeftShoulder", "LeftElbow", "LeftWrist",
	"RightHip", "RightKnee", "LeftHip", "LeftKnee",
}
local JOINT_SET: { [string]: boolean } = {}
for _, j in ipairs(Anim.JOINTS) do
	JOINT_SET[j] = true
end
Anim.JOINT_SET = JOINT_SET

local function K(t: number, pose: { [string]: Rot }): Key
	return { t = t, pose = pose }
end

-- Poses play once and hold the last frame (podium, Hall of Champions statues).
-- Emotes play once (or loop a few times) and return to rest.
Anim.CLIPS = {
	pose_heart = { length = 1.0, loop = false, hold = true, keys = {
		K(0, {}),
		K(0.5, { RightShoulder = { 55, 0, 35 }, RightElbow = { 105, 0, 0 }, Neck = { 8, 0, 0 } }),
		K(1.0, { RightShoulder = { 60, 0, 40 }, RightElbow = { 115, 0, 0 }, Neck = { -6, 0, 0 }, Waist = { 4, 0, 0 } }),
	} },
	pose_bow = { length = 1.4, loop = false, hold = true, keys = {
		K(0, {}),
		K(0.6, { Waist = { -38, 0, 0 }, Neck = { -15, 0, 0 }, RightShoulder = { 40, 0, -20 }, RightElbow = { 90, 0, 0 }, LeftShoulder = { 20, 0, -50 } }),
		K(1.4, { Waist = { -42, 0, 0 }, Neck = { -18, 0, 0 }, RightShoulder = { 42, 0, -22 }, RightElbow = { 95, 0, 0 }, LeftShoulder = { 25, 0, -60 } }),
	} },
	pose_lantern = { length = 1.2, loop = false, hold = true, prop = "lantern", propJoint = "RightHand", keys = {
		K(0, {}),
		K(0.7, { RightShoulder = { 175, 0, 10 }, RightElbow = { 10, 0, 0 }, Neck = { 20, 0, 0 }, LeftShoulder = { 0, 0, -25 }, LeftElbow = { 60, 0, 0 } }),
		K(1.2, { RightShoulder = { 178, 0, 8 }, RightElbow = { 5, 0, 0 }, Neck = { 25, 0, 0 }, LeftShoulder = { 0, 0, -30 }, LeftElbow = { 70, 0, 0 } }),
	} },
	pose_crown = { length = 2.0, loop = false, hold = true, prop = "crown", propJoint = "Head", keys = {
		K(0, {}),
		K(0.5, { RightShoulder = { 170, 0, 15 }, LeftShoulder = { 170, 0, -15 }, Neck = { 25, 0, 0 } }),
		K(1.0, { RightShoulder = { 120, 0, 25 }, LeftShoulder = { 120, 0, -25 }, RightElbow = { 40, 0, 0 }, LeftElbow = { 40, 0, 0 }, Neck = { 30, 0, 0 } }),
		K(1.6, { RightShoulder = { 30, 0, 50 }, LeftShoulder = { 30, 0, -50 }, Neck = { 0, 0, 0 }, Waist = { 6, 0, 0 } }),
		K(2.0, { RightShoulder = { 20, 0, 55 }, LeftShoulder = { 20, 0, -55 }, Waist = { 8, 0, 0 } }),
	} },
	pose_regent = { length = 1.5, loop = false, hold = true, keys = {
		K(0, {}),
		K(0.8, { RightShoulder = { 30, 0, 70 }, LeftShoulder = { 30, 0, -70 }, Neck = { 18, 0, 0 }, Waist = { 8, 0, 0 }, RightHip = { 0, 0, 8 }, LeftHip = { 0, 0, -8 } }),
		K(1.5, { RightShoulder = { 35, 0, 75 }, LeftShoulder = { 35, 0, -75 }, Neck = { 22, 0, 0 }, Waist = { 10, 0, 0 }, RightHip = { 0, 0, 10 }, LeftHip = { 0, 0, -10 } }),
	} },
	pose_firstlight = { length = 1.3, loop = false, hold = true, keys = {
		K(0, {}),
		K(0.6, { RightShoulder = { 160, 0, 30 }, RightElbow = { 0, 0, 0 }, LeftShoulder = { 0, 0, -20 }, Neck = { 15, 0, 0 } }),
		K(1.3, { RightShoulder = { 165, 0, 28 }, LeftShoulder = { 10, 0, -25 }, Neck = { 20, 0, 0 }, Waist = { 6, 0, 0 } }),
	} },
	pose_reaper = { length = 1.2, loop = false, hold = true, keys = {
		K(0, {}),
		K(0.6, { RightHip = { 50, 0, 0 }, RightKnee = { -80, 0, 0 }, LeftHip = { -10, 0, 0 }, Waist = { -10, 0, 0 }, RightShoulder = { 60, 0, 20 }, RightElbow = { 80, 0, 0 } }),
		K(1.2, { RightHip = { 55, 0, 0 }, RightKnee = { -85, 0, 0 }, LeftHip = { -12, 0, 0 }, Waist = { -12, 0, 0 }, RightShoulder = { 62, 0, 22 }, RightElbow = { 85, 0, 0 }, Neck = { 10, 0, 0 } }),
	} },
	pose_moon = { length = 1.4, loop = false, hold = true, prop = "lantern", propJoint = "LeftHand", keys = {
		K(0, {}),
		K(0.7, { LeftShoulder = { 140, 0, -20 }, RightShoulder = { 0, 0, 30 }, Neck = { 25, 0, 0 }, Waist = { 0, 15, 0 } }),
		K(1.4, { LeftShoulder = { 145, 0, -22 }, RightShoulder = { 0, 0, 35 }, Neck = { 28, 0, 0 }, Waist = { 0, 18, 0 } }),
	} },
	emote_tip = { length = 1.4, loop = false, keys = {
		K(0, {}),
		K(0.4, { RightShoulder = { 150, 0, 30 }, RightElbow = { 110, 0, 0 } }),
		K(0.7, { RightShoulder = { 150, 0, 30 }, RightElbow = { 110, 0, 0 }, Neck = { -20, 0, 0 }, Waist = { -10, 0, 0 } }),
		K(1.0, { RightShoulder = { 120, 0, 40 }, RightElbow = { 60, 0, 0 } }),
		K(1.4, {}),
	} },
	emote_toast = { length = 2.0, loop = false, prop = "thermos", propJoint = "RightHand", keys = {
		K(0, {}),
		K(0.5, { RightShoulder = { 100, 0, 10 }, RightElbow = { 40, 0, 0 } }),
		K(0.9, { RightShoulder = { 160, 0, 10 }, RightElbow = { 10, 0, 0 }, Neck = { 15, 0, 0 } }),
		K(1.4, { RightShoulder = { 120, 0, 10 }, RightElbow = { 120, 0, 0 }, Neck = { 25, 0, 0 } }),
		K(2.0, {}),
	} },
	emote_twirl = { length = 1.6, loop = false, prop = "ribbon", propJoint = "RightHand", keys = {
		K(0, {}),
		K(0.4, { Root = { 0, 120, 0 }, RightShoulder = { 0, 0, 80 }, LeftShoulder = { 0, 0, -80 } }),
		K(0.8, { Root = { 0, 240, 0 }, RightShoulder = { 0, 0, 90 }, LeftShoulder = { 0, 0, -90 } }),
		K(1.2, { Root = { 0, 360, 0 }, RightShoulder = { 0, 0, 80 }, LeftShoulder = { 0, 0, -80 } }),
		K(1.6, { Root = { 0, 360, 0 } }),
	} },
	emote_lantern = { length = 2.4, loop = false, prop = "lantern", propJoint = "RightHand", keys = {
		K(0, {}),
		K(0.4, { RightShoulder = { 170, 0, 20 } }),
		K(0.8, { RightShoulder = { 170, 0, -10 }, Waist = { 0, 0, -6 } }),
		K(1.2, { RightShoulder = { 170, 0, 40 }, Waist = { 0, 0, 6 } }),
		K(1.6, { RightShoulder = { 170, 0, -10 }, Waist = { 0, 0, -6 } }),
		K(2.0, { RightShoulder = { 170, 0, 30 } }),
		K(2.4, {}),
	} },
	emote_clap = { length = 1.6, loop = false, keys = {
		K(0, {}),
		K(0.3, { RightShoulder = { 80, 0, -20 }, LeftShoulder = { 80, 0, 20 }, RightElbow = { 30, 0, 0 }, LeftElbow = { 30, 0, 0 } }),
		K(0.5, { RightShoulder = { 80, 0, 5 }, LeftShoulder = { 80, 0, -5 }, RightElbow = { 30, 0, 0 }, LeftElbow = { 30, 0, 0 } }),
		K(0.7, { RightShoulder = { 80, 0, -20 }, LeftShoulder = { 80, 0, 20 }, RightElbow = { 30, 0, 0 }, LeftElbow = { 30, 0, 0 } }),
		K(0.9, { RightShoulder = { 80, 0, 5 }, LeftShoulder = { 80, 0, -5 }, RightElbow = { 30, 0, 0 }, LeftElbow = { 30, 0, 0 } }),
		K(1.1, { RightShoulder = { 80, 0, -20 }, LeftShoulder = { 80, 0, 20 }, RightElbow = { 30, 0, 0 }, LeftElbow = { 30, 0, 0 } }),
		K(1.6, {}),
	} },
	emote_harvest = { length = 2.2, loop = false, keys = {
		K(0, {}),
		K(0.5, { Waist = { -30, 0, 0 }, RightShoulder = { 60, 0, 0 }, LeftShoulder = { 60, 0, 0 }, RightKnee = { -30, 0, 0 }, LeftKnee = { -30, 0, 0 }, RightHip = { 25, 0, 0 }, LeftHip = { 25, 0, 0 } }),
		K(1.2, { Waist = { 5, 0, 0 }, RightShoulder = { 170, 0, 20 }, LeftShoulder = { 170, 0, -20 }, Neck = { 20, 0, 0 } }),
		K(1.7, { Waist = { 5, 0, 0 }, RightShoulder = { 170, 0, 30 }, LeftShoulder = { 170, 0, -30 }, Neck = { 25, 0, 0 } }),
		K(2.2, {}),
	} },
	emote_patron = { length = 1.8, loop = false, keys = {
		K(0, {}),
		K(0.6, { RightShoulder = { 90, -30, 0 }, RightElbow = { 90, 0, 0 }, Waist = { -15, 0, 0 }, Neck = { -10, 0, 0 } }),
		K(1.2, { RightShoulder = { 60, 0, 60 }, RightElbow = { 10, 0, 0 }, Waist = { -20, 0, 0 } }),
		K(1.8, {}),
	} },
} :: { [string]: Clip }

-- Free poses everyone can use (so the podium always animates).
Anim.DEFAULT_POSE = "pose_firstlight"

local function ease(a: number): number
	return 0.5 - math.cos(a * math.pi) * 0.5
end

local function rotOf(k: Key, j: string): Rot
	return k.pose[j] or { 0, 0, 0 }
end

-- Sample a clip at time t. Returns joint -> { x, y, z } degrees for every joint the clip uses.
function Anim.sample(clip: Clip, t: number): { [string]: Rot }
	local keys = clip.keys
	if clip.loop then
		t = t % clip.length
	else
		t = math.clamp(t, 0, clip.length)
	end
	local a, b = keys[1], keys[#keys]
	for i = 1, #keys - 1 do
		if t >= keys[i].t and t <= keys[i + 1].t then
			a, b = keys[i], keys[i + 1]
			break
		end
	end
	local span = b.t - a.t
	local f = span > 0 and ease((t - a.t) / span) or 1
	local used: { [string]: boolean } = {}
	for _, k in ipairs(keys) do
		for j in pairs(k.pose) do
			used[j] = true
		end
	end
	local out = {}
	for j in pairs(used) do
		local ra, rb = rotOf(a, j), rotOf(b, j)
		out[j] = { ra[1] + (rb[1] - ra[1]) * f, ra[2] + (rb[2] - ra[2]) * f, ra[3] + (rb[3] - ra[3]) * f }
	end
	return out
end

function Anim.validate(): { string }
	local errs = {}
	for id, c in pairs(Anim.CLIPS) do
		if #c.keys < 2 then
			table.insert(errs, id .. " needs 2+ keys")
		end
		local last = -1
		for _, k in ipairs(c.keys) do
			if k.t <= last then
				table.insert(errs, id .. " keys out of order")
			end
			last = k.t
			for j, r in pairs(k.pose) do
				if not JOINT_SET[j] then
					table.insert(errs, id .. " bad joint " .. j)
				end
				for _, v in ipairs(r) do
					if v ~= v or math.abs(v) > 400 then
						table.insert(errs, id .. " bad angle on " .. j)
					end
				end
			end
		end
		if math.abs(c.keys[#c.keys].t - c.length) > 1e-6 then
			table.insert(errs, id .. " last key must be at length")
		end
		if not c.hold and not c.loop then
			for j, r in pairs(c.keys[#c.keys].pose) do
				for _, v in ipairs(r) do
					if v % 360 ~= 0 then
						table.insert(errs, id .. " emote must end at rest (" .. j .. ")")
					end
				end
			end
		end
	end
	return errs
end

-- Small props held during some clips, as Arms-style part specs (grip at the hand).
Anim.PROPS = {
	lantern = {
		{ name = "Handle", shape = "Block", size = { 0.08, 0.6, 0.08 }, pos = { 0, -0.3, 0 }, color = "#3A2A22", mat = "Metal" },
		{ name = "Lantern", shape = "Block", size = { 0.55, 0.7, 0.55 }, pos = { 0, -0.9, 0 }, color = "#FFC86B", mat = "Neon", trans = 0.2, glow = true },
		{ name = "Cap", shape = "Block", size = { 0.65, 0.1, 0.65 }, pos = { 0, -0.52, 0 }, color = "#7A2E1E", mat = "Metal" },
	},
	thermos = {
		{ name = "Thermos", shape = "Cylinder", size = { 0.8, 0.36, 0.36 }, pos = { 0, -0.2, 0 }, rot = { 0, 0, 90 }, color = "#C9A04E", mat = "Foil" },
		{ name = "Lid", shape = "Cylinder", size = { 0.16, 0.4, 0.4 }, pos = { 0, 0.25, 0 }, rot = { 0, 0, 90 }, color = "#5A3A1E", mat = "Metal" },
	},
	crown = {
		{ name = "Crown", shape = "Cylinder", size = { 0.25, 1.3, 1.3 }, pos = { 0, 0.7, 0 }, rot = { 0, 0, 90 }, color = "#F2D27A", mat = "Fabric" },
	},
	ribbon = {
		{ name = "Stick", shape = "Block", size = { 0.06, 0.8, 0.06 }, pos = { 0, -0.4, 0 }, color = "#8C5A2B", mat = "Wood" },
		{ name = "Ribbon", shape = "Block", size = { 0.04, 1.8, 0.25 }, pos = { 0, -1.6, 0.2 }, rot = { 25, 0, 0 }, color = "#FF9EC7", mat = "Fabric" },
	},
}

return Anim
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Arms</string>
          <string name="Source"><![CDATA[--!nocheck
--[[
	Arms.luau: held weapon models built from plain Parts in code (no uploaded meshes needed).

	Every weapon skin is a list of part specs (shape, size, offset, rotation, color, material),
	so a Gilded Bow, an Ember Spear and a plain bow look clearly different in your hand, on the
	podium, on Hall of Champions statues and in the shop's try-on. Same stats for every skin.

	Local frame: the grip is at the origin and the weapon runs along +Y. Arms.build() returns a
	Model whose PrimaryPart "Grip" sits at the hand; Arms.attach() welds it to a character.
	Mastery (Mastery.luau) adds visible upgrades on top: a gold trim band, then a sparkle,
	then gilded edges. It only works through `env`, so Lune tests can build every skin too.
]]
local Arms = {}

export type PartSpec = {
	name: string,
	shape: string, -- "Block" | "Ball" | "Cylinder" | "Wedge"
	size: { number },
	pos: { number },
	rot: { number }?, -- degrees, applied X then Y then Z
	color: string,
	mat: string, -- Enum.Material name
	trans: number?,
	glow: boolean?, -- adds a PointLight
}
export type Spec = { id: string, slot: string, name: string, parts: { PartSpec }, fx: { sparkle: string?, light: string?, fire: string? } }

local function P(name, shape, size, pos, rot, color, mat, extra)
	local p = { name = name, shape = shape, size = size, pos = pos, rot = rot, color = color, mat = mat }
	if extra then
		for k, v in pairs(extra) do
			p[k] = v
		end
	end
	return p
end

-- ===== bows =====
-- o: wood, mat, grip, string, tip ("ball" | "leaf" | "crystal" | "sun"), accent, accentMat, width
local function bow(o)
	local w = o.width or 1
	local parts = {
		P("Grip", "Block", { 0.34, 0.75, 0.42 }, { 0, 0, 0 }, nil, o.grip, o.gripMat or "Fabric"),
		P("LimbUpA", "Block", { 0.24 * w, 1.15, 0.3 * w }, { 0, 0.92, 0.1 }, { -12, 0, 0 }, o.wood, o.mat),
		P("LimbUpB", "Block", { 0.2 * w, 1.05, 0.26 * w }, { 0, 1.88, 0.36 }, { -26, 0, 0 }, o.wood, o.mat),
		P("LimbDnA", "Block", { 0.24 * w, 1.15, 0.3 * w }, { 0, -0.92, 0.1 }, { 12, 0, 0 }, o.wood, o.mat),
		P("LimbDnB", "Block", { 0.2 * w, 1.05, 0.26 * w }, { 0, -1.88, 0.36 }, { 26, 0, 0 }, o.wood, o.mat),
		P("String", "Block", { 0.05, 4.7, 0.05 }, { 0, 0, 0.62 }, nil, o.string or "#EDE6D6", "SmoothPlastic"),
	}
	local tip = o.tip or "ball"
	for _, s in ipairs({ 1, -1 }) do
		local y = 2.36 * s
		if tip == "ball" then
			table.insert(parts, P("Tip", "Ball", { 0.24, 0.24, 0.24 }, { 0, y, 0.62 }, nil, o.accent or o.wood, o.accentMat or o.mat))
		elseif tip == "leaf" then
			table.insert(parts, P("Leaf", "Wedge", { 0.08, 0.55, 0.32 }, { 0, y + 0.12 * s, 0.6 }, { s > 0 and 0 or 180, 0, 0 }, o.accent, o.accentMat or "Foil"))
			table.insert(parts, P("LeafB", "Wedge", { 0.08, 0.4, 0.26 }, { 0, y - 0.25 * s, 0.48 }, { s > 0 and 180 or 0, 0, 0 }, o.accent, o.accentMat or "Foil"))
		elseif tip == "crystal" then
			table.insert(parts, P("Crystal", "Block", { 0.22, 0.6, 0.22 }, { 0, y + 0.15 * s, 0.6 }, { 0, 45, 18 * s }, o.accent, "Ice", { trans = 0.15 }))
			table.insert(parts, P("CrystalB", "Block", { 0.16, 0.42, 0.16 }, { 0.12, y - 0.1 * s, 0.5 }, { 0, 45, -30 * s }, o.accent, "Ice", { trans = 0.15 }))
		elseif tip == "sun" then
			table.insert(parts, P("Crest", "Cylinder", { 0.1, 0.5, 0.5 }, { 0, y + 0.1 * s, 0.6 }, { 0, 90, 0 }, o.accent, "Foil"))
			table.insert(parts, P("CrestGem", "Ball", { 0.2, 0.2, 0.2 }, { 0, y + 0.1 * s, 0.68 }, nil, o.glowColor or "#FFB347", "Neon"))
		end
	end
	if o.bands then
		for i = 1, o.bands do
			local y = 0.55 + (i - 1) * 0.55
			table.insert(parts, P("Band", "Block", { 0.3 * w, 0.08, 0.36 * w }, { 0, y, 0.14 + (i - 1) * 0.08 }, { -14 - i * 4, 0, 0 }, o.accent, o.accentMat or "Foil"))
			table.insert(parts, P("Band", "Block", { 0.3 * w, 0.08, 0.36 * w }, { 0, -y, 0.14 + (i - 1) * 0.08 }, { 14 + i * 4, 0, 0 }, o.accent, o.accentMat or "Foil"))
		end
	end
	if o.inlay then
		table.insert(parts, P("Inlay", "Block", { 0.06, 3.2, 0.06 }, { 0, 0, -0.12 }, nil, o.inlay, "Neon"))
	end
	if o.disk then
		table.insert(parts, P("SunDisk", "Cylinder", { 0.12, 0.95, 0.95 }, { 0, 0, -0.24 }, { 0, 90, 0 }, o.accent, "Foil"))
		table.insert(parts, P("SunCore", "Cylinder", { 0.14, 0.5, 0.5 }, { 0, 0, -0.27 }, { 0, 90, 0 }, o.glowColor or "#FFB347", "Neon", { glow = true }))
	end
	return parts
end

-- ===== spears =====
-- o: shaft, shaftMat, head ("leaf" | "ember" | "glass" | "stone" | "wheat"), headColor, headMat, accent
local function spear(o)
	local parts = {
		P("Shaft", "Cylinder", { 6.6, 0.22, 0.22 }, { 0, 1.2, 0 }, { 0, 0, 90 }, o.shaft, o.shaftMat or "Wood"),
		P("Wrap", "Cylinder", { 0.7, 0.27, 0.27 }, { 0, 0, 0 }, { 0, 0, 90 }, o.wrap or "#4A3424", "Fabric"),
		P("Butt", "Ball", { 0.3, 0.3, 0.3 }, { 0, -2.15, 0 }, nil, o.accent or "#6B6B6B", o.accentMat or "Metal"),
		P("Collar", "Cylinder", { 0.22, 0.3, 0.3 }, { 0, 4.5, 0 }, { 0, 0, 90 }, o.accent or "#6B6B6B", o.accentMat or "Metal"),
	}
	local h = o.head or "leaf"
	local hc, hm = o.headColor or "#9AA3AD", o.headMat or "Metal"
	if h == "leaf" or h == "stone" then
		table.insert(parts, P("HeadA", "Wedge", { 0.08, 0.9, 0.36 }, { 0, 5.05, 0 }, nil, hc, hm))
		table.insert(parts, P("HeadB", "Wedge", { 0.08, 0.5, 0.36 }, { 0, 4.35, 0 }, { 180, 0, 0 }, hc, hm))
	elseif h == "ember" then
		table.insert(parts, P("HeadA", "Wedge", { 0.12, 1.1, 0.42 }, { 0, 5.15, 0 }, nil, "#2B2522", "Slate"))
		table.insert(parts, P("HeadB", "Wedge", { 0.12, 0.5, 0.42 }, { 0, 4.35, 0 }, { 180, 0, 0 }, "#2B2522", "Slate"))
		table.insert(parts, P("EmberCore", "Wedge", { 0.14, 0.75, 0.22 }, { 0, 5.02, 0 }, nil, hc, "Neon", { glow = true }))
		table.insert(parts, P("EmberRing", "Cylinder", { 0.1, 0.36, 0.36 }, { 0, 4.72, 0 }, { 0, 0, 90 }, hc, "Neon"))
	elseif h == "glass" then
		table.insert(parts, P("HeadA", "Wedge", { 0.14, 1.0, 0.4 }, { 0, 5.1, 0 }, nil, hc, "Glass", { trans = 0.25 }))
		table.insert(parts, P("HeadB", "Wedge", { 0.14, 0.45, 0.4 }, { 0, 4.38, 0 }, { 180, 0, 0 }, hc, "Glass", { trans = 0.25 }))
		table.insert(parts, P("Drop", "Ball", { 0.26, 0.26, 0.26 }, { 0, 4.6, 0 }, nil, "#DFF7FF", "Glass", { trans = 0.1 }))
	elseif h == "wheat" then
		table.insert(parts, P("HeadA", "Wedge", { 0.08, 0.9, 0.34 }, { 0, 5.05, 0 }, nil, hc, hm))
		table.insert(parts, P("HeadB", "Wedge", { 0.08, 0.45, 0.34 }, { 0, 4.38, 0 }, { 180, 0, 0 }, hc, hm))
		for i, a in ipairs({ -35, 35, -55, 55 }) do
			table.insert(parts, P("Ear", "Block", { 0.1, 0.42, 0.14 }, { (a > 0 and 0.16 or -0.16) * (i > 2 and 1.4 or 1), 4.25 - (i > 2 and 0.3 or 0), 0 }, { 0, 0, a }, "#E9C46A", "Fabric"))
		end
	end
	if h == "fork" then
		table.insert(parts, P("ForkBar", "Block", { 0.12, 0.12, 0.9 }, { 0, 4.62, 0 }, nil, hc, hm))
		for i, z in ipairs({ -0.38, 0, 0.38 }) do
			table.insert(parts, P("Tine" .. i, "Cylinder", { 0.9, 0.09, 0.09 }, { 0, 5.08, z }, { 0, 0, 90 }, hc, hm))
		end
	end
	if o.ribbon then
		table.insert(parts, P("Ribbon", "Block", { 0.04, 0.9, 0.18 }, { 0.16, 4.05, 0 }, { 0, 0, 12 }, o.ribbon, "Fabric"))
	end
	return parts
end

-- ===== knives =====
local function knife(o)
	return {
		P("Handle", "Block", { 0.22, 0.6, 0.26 }, { 0, 0, 0 }, nil, o.handle or "#3B2A1E", o.handleMat or "Wood"),
		P("Guard", "Block", { 0.5, 0.08, 0.3 }, { 0, 0.33, 0 }, nil, o.accent or "#8A8A8A", o.accentMat or "Metal"),
		P("Blade", "Wedge", { 0.06, 0.95, 0.24 }, { 0, 0.85, 0 }, nil, o.blade, o.bladeMat or "Metal", { trans = o.bladeTrans }),
		P("Pommel", "Ball", { 0.2, 0.2, 0.2 }, { 0, -0.34, 0 }, nil, o.accent or "#8A8A8A", o.accentMat or "Metal"),
		o.edge and P("Edge", "Block", { 0.02, 0.85, 0.03 }, { 0, 0.82, 0.11 }, nil, o.edge, "Neon") or nil,
	}
end

-- Default (free) looks and every skin. Keys are Store item ids; "" = default for the slot.
Arms.SKINS = {
	bow = {
		[""] = function() return bow({ wood = "#7A4E2A", mat = "Wood", grip = "#4A3424" }) end,
		skin_bow_ashen = function() return bow({ wood = "#C9B79C", mat = "WoodPlanks", grip = "#2F2A26", accent = "#5C544C" }) end,
		skin_bow_gilded = function() return bow({ wood = "#E8B84A", mat = "Foil", grip = "#6B3B1E", tip = "leaf", accent = "#FFE08A", bands = 2 }) end,
		skin_bow_mirror = function() return bow({ wood = "#D7E6EE", mat = "Glass", grip = "#5D6B75", accent = "#FFFFFF", accentMat = "Glass", inlay = "#BFE7FF" }) end,
		skin_bow_frost = function() return bow({ wood = "#A8DDF0", mat = "Ice", grip = "#2E4A5A", tip = "crystal", accent = "#E9FBFF", string = "#BFF3FF" }) end,
		skin_bow_regent = function() return bow({ wood = "#C98A2E", mat = "Foil", grip = "#5A1E1E", tip = "sun", accent = "#FFD36B", bands = 3, disk = true, width = 1.25, glowColor = "#FFB347" }) end,
		skin_bow_harvest = function() return bow({ wood = "#8C5A2B", mat = "Wood", grip = "#3E2A18", tip = "leaf", accent = "#E9C46A", accentMat = "Fabric", bands = 1, string = "#F2D27A" }) end,
		skin_bow_comet = function() return bow({ wood = "#2A2F55", mat = "SmoothPlastic", grip = "#14172B", tip = "crystal", accent = "#BFD4FF", inlay = "#9DB4FF" }) end,
		skin_bow_s2_orchard = function() return bow({ wood = "#7A3B2A", mat = "Wood", grip = "#2E1B12", tip = "leaf", accent = "#C8553D", accentMat = "Fabric", bands = 2, string = "#E9C46A" }) end,
		skin_bow_founders = function() return bow({ wood = "#E6D8BE", mat = "Wood", grip = "#7A2E1E", tip = "sun", accent = "#F4C27A", accentMat = "Fabric", bands = 1, glowColor = "#FFB38A" }) end,
	},
	spear = {
		[""] = function() return spear({ shaft = "#8A6A3A", head = "leaf" }) end,
		skin_spear_ashen = function() return spear({ shaft = "#5E5952", shaftMat = "Slate", head = "stone", headColor = "#A8A29A", headMat = "Slate", accent = "#3A3633" }) end,
		skin_spear_ember = function() return spear({ shaft = "#3A2A22", head = "ember", headColor = "#FF7A3D", accent = "#B8572A" }) end,
		skin_spear_lake = function() return spear({ shaft = "#C9D9DE", shaftMat = "Marble", head = "glass", headColor = "#6FD3E8", accent = "#8FB8C6", ribbon = "#6FD3E8" }) end,
		skin_spear_wheat = function() return spear({ shaft = "#C8A05A", head = "wheat", headColor = "#D9B45A", headMat = "Foil", accent = "#8C6A2E", ribbon = "#E9C46A" }) end,
		skin_spear_regent = function() return spear({ shaft = "#5A1E1E", shaftMat = "Fabric", head = "leaf", headColor = "#FFD36B", headMat = "Foil", accent = "#FFD36B", accentMat = "Foil", ribbon = "#FFB347" }) end,
		skin_spear_s2_pitch = function() return spear({ shaft = "#9C6B3E", head = "fork", headColor = "#5E5F63", headMat = "Metal", accent = "#3A3633" }) end,
	},
	knife = {
		[""] = function() return knife({ blade = "#BFC6CF" }) end,
		skin_knife_copper = function() return knife({ blade = "#D98A4E", bladeMat = "Foil", accent = "#8C4B24", handle = "#2B1D14" }) end,
		skin_knife_night = function() return knife({ blade = "#2A2440", bladeMat = "Glass", accent = "#8E7CFF", handle = "#141020", edge = "#8E7CFF" }) end,
		skin_knife_lantern = function() return knife({ blade = "#F2E3C0", bladeMat = "Marble", accent = "#FFC86B", accentMat = "Neon", handle = "#7A2E1E" }) end,
		skin_knife_s2_sickle = function() return knife({ blade = "#CFD8E3", bladeMat = "Metal", accent = "#6B7480", handle = "#4A3424", edge = "#EAF2FF" }) end,
	},
}

-- Mastery overlays (levels from Mastery.luau). Applied on top of any skin, including defaults.
local function masteryParts(slot: string, level: number): { PartSpec }
	local out = {}
	if level >= 3 then
		local y = slot == "spear" and 0.45 or (slot == "knife" and 0.42 or 0.42)
		table.insert(out, P("MasteryTrim", "Cylinder", { 0.1, 0.4, 0.46 }, { 0, y, 0 }, { 0, 0, 90 }, "#FFD36B", "Foil"))
		table.insert(out, P("MasteryTrim", "Cylinder", { 0.1, 0.4, 0.46 }, { 0, -y, 0 }, { 0, 0, 90 }, "#FFD36B", "Foil"))
	end
	if level >= 5 then
		local len = slot == "spear" and 6.4 or (slot == "knife" and 0.9 or 3.4)
		local y = slot == "spear" and 1.3 or (slot == "knife" and 0.6 or 0)
		table.insert(out, P("MasteredEdge", "Block", { 0.04, len, 0.04 }, { 0.15, y, 0 }, nil, "#FFE9A8", "Neon"))
	end
	return out
end

local FX = {
	skin_bow_gilded = { light = "#FFD36B" },
	skin_bow_frost = { sparkle = "#E9FBFF" },
	skin_bow_regent = { light = "#FFB347", sparkle = "#FFD36B" },
	skin_bow_comet = { sparkle = "#BFD4FF" },
	skin_spear_ember = { fire = "#FF7A3D", light = "#FF7A3D" },
	skin_spear_lake = { light = "#6FD3E8" },
	skin_spear_regent = { light = "#FFD36B" },
	skin_knife_night = { light = "#8E7CFF" },
	skin_knife_lantern = { light = "#FFC86B" },
	skin_bow_founders = { light = "#FFB38A" },
	skin_knife_s2_sickle = { light = "#EAF2FF" },
}

function Arms.has(slot: string, skinId: string): boolean
	return Arms.SKINS[slot] ~= nil and Arms.SKINS[slot][skinId] ~= nil
end

-- The full spec for a slot + skin + mastery level. Unknown skins fall back to the default look.
function Arms.spec(slot: string, skinId: string?, mastery: number?): Spec
	local set = Arms.SKINS[slot] or Arms.SKINS.bow
	local key = (skinId and set[skinId]) and skinId or ""
	local parts = set[key]()
	local clean = {}
	for _, p in ipairs(parts) do
		if p then
			table.insert(clean, p)
		end
	end
	for _, p in ipairs(masteryParts(slot, mastery or 0)) do
		table.insert(clean, p)
	end
	local fx = table.clone(FX[key] or {})
	if (mastery or 0) >= 4 then
		fx.sparkle = fx.sparkle or "#FFE9A8"
	end
	return { id = key, slot = slot, name = key == "" and ("Default " .. slot) or key, parts = clean, fx = fx }
end

-- A short fingerprint of a spec, used by tests to prove skins look different.
function Arms.signature(spec: Spec): string
	local bits = {}
	for _, p in ipairs(spec.parts) do
		table.insert(bits, p.shape .. p.color .. p.mat)
	end
	table.sort(bits)
	return table.concat(bits, "|")
end

-- ===== building =====
local function cfOf(E, p)
	local r = p.rot or { 0, 0, 0 }
	return E.CFrame.new(p.pos[1], p.pos[2], p.pos[3]) * E.CFrame.Angles(math.rad(r[1]), math.rad(r[2]), math.rad(r[3]))
end

-- Builds the model at `at` (the grip CFrame). Parts are unanchored, massless, welded to Grip.
function Arms.build(E, spec: Spec, at): any
	local m = E.Instance.new("Model")
	m.Name = "Held"
	m:SetAttribute("Skin", spec.id)
	local grip = E.Instance.new("Part")
	grip.Name = "Grip"
	grip.Size = E.Vector3.new(0.2, 0.2, 0.2)
	grip.Transparency = 1
	grip.CanCollide = false
	grip.CanQuery = false
	grip.CanTouch = false
	grip.Massless = true
	grip.CFrame = at
	grip.Parent = m
	m.PrimaryPart = grip
	for _, s in ipairs(spec.parts) do
		local p
		if s.shape == "Wedge" then
			p = E.Instance.new("WedgePart")
		else
			p = E.Instance.new("Part")
			p.Shape = E.Enum.PartType[s.shape]
		end
		p.Name = s.name
		p.Size = E.Vector3.new(s.size[1], s.size[2], s.size[3])
		p.Color = E.Color3.fromHex(s.color)
		p.Material = E.Enum.Material[s.mat]
		p.Transparency = s.trans or 0
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		p.CFrame = at * cfOf(E, s)
		if s.glow then
			local l = E.Instance.new("PointLight")
			l.Color = p.Color
			l.Range = 6
			l.Brightness = 1.2
			l.Parent = p
		end
		local w = E.Instance.new("WeldConstraint")
		w.Part0 = grip
		w.Part1 = p
		w.Parent = p
		p.Parent = m
	end
	if spec.fx.light then
		local l = E.Instance.new("PointLight")
		l.Color = E.Color3.fromHex(spec.fx.light)
		l.Range = 7
		l.Brightness = 0.9
		l.Parent = grip
	end
	if spec.fx.sparkle then
		local s = E.Instance.new("ParticleEmitter")
		s.Name = "Sparkle"
		s.Color = E.ColorSequence.new(E.Color3.fromHex(spec.fx.sparkle))
		s.LightEmission = 1
		s.Rate = 6
		s.Lifetime = E.NumberRange.new(0.4, 0.8)
		s.Speed = E.NumberRange.new(0.5, 1.2)
		s.Size = E.NumberSequence.new(0.15, 0)
		s.SpreadAngle = E.Vector2.new(180, 180)
		s.Parent = grip
	end
	if spec.fx.fire then
		local f = E.Instance.new("ParticleEmitter")
		f.Name = "Embers"
		f.Color = E.ColorSequence.new(E.Color3.fromHex(spec.fx.fire), E.Color3.fromHex("#FFE08A"))
		f.LightEmission = 1
		f.Rate = 10
		f.Lifetime = E.NumberRange.new(0.3, 0.7)
		f.Speed = E.NumberRange.new(1, 2)
		f.Size = E.NumberSequence.new(0.12, 0)
		f.Parent = m:FindFirstChild("EmberCore") or grip
	end
	return m
end

-- How the grip sits in the right hand for each slot (hand frame: -Y runs down the fingers).
function Arms.gripOffset(E, slot: string)
	if slot == "knife" then
		return E.CFrame.new(0, -0.25, -0.1) * E.CFrame.Angles(math.rad(-90), 0, 0)
	elseif slot == "spear" then
		return E.CFrame.new(0, -0.2, 0) * E.CFrame.Angles(math.rad(-90), 0, 0)
	end
	return E.CFrame.new(0, -0.2, 0) * E.CFrame.Angles(0, math.rad(90), 0)
end

-- Builds and welds a held weapon to a character's right hand. Returns the model.
function Arms.attach(E, character, slot: string, skinId: string?, mastery: number?): any
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if not hand then
		return nil
	end
	local old = character:FindFirstChild("Held")
	if old then
		old:Destroy()
	end
	local spec = Arms.spec(slot, skinId, mastery)
	local m = Arms.build(E, spec, hand.CFrame * Arms.gripOffset(E, slot))
	local w = E.Instance.new("WeldConstraint")
	w.Part0 = hand
	w.Part1 = m.PrimaryPart
	w.Parent = m.PrimaryPart
	m.Parent = character
	return m
end

return Arms
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Audio</string>
          <string name="Source"><![CDATA[--!strict
-- Pure audio rules: which file plays, how loud, how often, and which surface a footstep is.
-- The client (Sfx.luau) performs playback. This module never touches instances.
local Audio = {}

local SfxIds: { [string]: any }
if script then
	SfxIds = require(script.Parent.SfxIds)
else
	SfxIds = (require :: any)("./SfxIds")
end

Audio.CUES = SfxIds

-- Names older call sites still use. They point at the more specific cue.
local alias: { [string]: string } = {
	click = "uiClick",
	pop = "pickup",
	popAiry = "parachute",
	register = "purchase",
	coins = "token",
	ding = "chime",
	bell = "knockout",
	fanfare = "win",
	crunch = "snack",
	swat = "hitLight",
	whoosh = "giftSend",
	hiss = "veilTouch",
}
Audio.ALIAS = alias

-- The only numeric asset ids allowed. These twelve were already in the project.
local library: { [number]: boolean } = {
	[15675059323] = true,
	[15675055424] = true,
	[9117841338] = true,
	[9113728756] = true,
	[9113849492] = true,
	[9126073001] = true,
	[9113584163] = true,
	[9114898444] = true,
	[9113959343] = true,
	[9120907511] = true,
	[9125594711] = true,
	[9119165436] = true,
}
Audio.LIBRARY = library

-- Engine one-shots only. No soundtrack files, no character voices.
local engines: { [string]: boolean } = {
	["rbxasset://sounds/Rubber band sling shot.mp3"] = true,
	["rbxasset://sounds/unsheath.mp3"] = true,
	["rbxasset://sounds/swordlunge.mp3"] = true,
	["rbxasset://sounds/swordslash.mp3"] = true,
	["rbxasset://sounds/swoosh.mp3"] = true,
	["rbxasset://sounds/impact_bodyfall.mp3"] = true,
	["rbxasset://sounds/hit.mp3"] = true,
	["rbxasset://sounds/bass.mp3"] = true,
	["rbxasset://sounds/snap.mp3"] = true,
	["rbxasset://sounds/button.mp3"] = true,
	["rbxasset://sounds/switch.mp3"] = true,
	["rbxasset://sounds/collide.mp3"] = true,
	["rbxasset://sounds/electronicpingshort.mp3"] = true,
	["rbxasset://sounds/grass.mp3"] = true,
	["rbxasset://sounds/grass3.mp3"] = true,
	["rbxasset://sounds/grassstone.mp3"] = true,
	["rbxasset://sounds/stone.mp3"] = true,
	["rbxasset://sounds/wood.mp3"] = true,
	["rbxasset://sounds/metal.mp3"] = true,
	["rbxasset://sounds/ice.mp3"] = true,
	["rbxasset://sounds/impact_water.mp3"] = true,
	["rbxasset://sounds/action_footsteps_plastic.mp3"] = true,
	["rbxasset://sounds/action_jump_land.mp3"] = true,
}
Audio.ENGINES = engines

Audio.BUSES = { "weapons", "hits", "footsteps", "pickups", "ui", "ambient", "veil", "voice" }

local volumeKey: { [string]: string } = {
	weapons = "volWeapons",
	hits = "volHits",
	footsteps = "volFootsteps",
	pickups = "volPickups",
	ui = "volUi",
	ambient = "volAmbient",
	veil = "volVeil",
	voice = "volVoice",
}
Audio.VOLUME_KEY = volumeKey

-- Bus multipliers. Combined with cue volumes these stay under a shout.
local defaultVolume: { [string]: number } = {
	weapons = 0.7,
	hits = 0.62,
	footsteps = 0.38,
	pickups = 0.55,
	ui = 0.42,
	ambient = 0.22,
	veil = 0.36,
	voice = 0.48,
}
Audio.DEFAULT_VOLUME = defaultVolume

local surfaces: { [string]: string } = {
	grass = "footGrass",
	dirt = "footDirt",
	stone = "footStone",
	wood = "footWood",
	metal = "footMetal",
	water = "footWater",
	glass = "footGlass",
	default = "footDefault",
}
Audio.SURFACES = surfaces

local weapons: { [string]: string } = {
	bow = "bowRelease",
	spear = "spearSwing",
	spearThrow = "spearThrow",
	knife = "knifeSwing",
	shove = "shove",
}
Audio.WEAPONS = weapons

function Audio.alias(name: string): string
	return Audio.ALIAS[name] or name
end

function Audio.cue(name: string): any
	return Audio.CUES[Audio.alias(name)]
end

function Audio.clampVolume(n: number): number
	if n ~= n then
		return 0
	end
	return math.clamp(n, 0, 1)
end

-- What to actually play. Original upload wins, then the engine stand-in, then a library id.
-- "placeholder" means silence until someone pastes an uploadId.
function Audio.playback(cue: any): (string, string)
	if type(cue) ~= "table" then
		return "", "placeholder"
	end
	local uploadId = cue.uploadId
	if type(uploadId) == "number" and uploadId > 0 then
		return "rbxassetid://" .. tostring(math.floor(uploadId)), "original"
	end
	if type(cue.engine) == "string" and cue.engine ~= "" then
		return cue.engine, "engine"
	end
	local libraryId = cue.libraryId
	if type(libraryId) == "number" and libraryId > 0 then
		return "rbxassetid://" .. tostring(math.floor(libraryId)), "library"
	end
	return "", "placeholder"
end

function Audio.status(cue: any): string
	local _, kind = Audio.playback(cue)
	if kind == "placeholder" then
		return "placeholder"
	end
	return "playable"
end

function Audio.effective(masterOn: boolean, busVol: number, cueVol: number): number
	if not masterOn then
		return 0
	end
	return Audio.clampVolume(busVol) * math.clamp(cueVol, 0, 1)
end

function Audio.allow(last: number?, now: number, gap: number): boolean
	if gap <= 0 then
		return true
	end
	if last == nil then
		return true
	end
	return now - last >= gap
end

-- Spatial repeats from different people should not share one cooldown.
function Audio.gapKey(name: string, at: { x: number, y: number, z: number }?): string
	if not at then
		return name
	end
	return string.format("%s:%d:%d", name, math.floor(at.x / 12), math.floor(at.z / 12))
end

-- Drop extra footsteps and air when a lot of sounds just started. Hits and weapons stay.
function Audio.admit(started: number, bus: string): boolean
	if started < 4 then
		return true
	end
	if bus == "footsteps" or bus == "ambient" then
		return false
	end
	return started < 7
end

-- Seconds between steps. Nil when nearly still. Never faster than 0.3s.
function Audio.footInterval(speed: number): number?
	if speed < 1.5 then
		return nil
	end
	return math.clamp(7.2 / speed, 0.3, 0.62)
end

function Audio.surfaceFromMaterial(material: string): string
	local m = string.lower(material)
	if m == "water" then
		return "water"
	end
	if m == "grass" or m == "leafygrass" then
		return "grass"
	end
	if m == "mud" or m == "ground" or m == "sand" or m == "snow" or m == "salt" then
		return "dirt"
	end
	if m == "wood" or m == "woodplanks" then
		return "wood"
	end
	if m == "metal" or m == "corrodedmetal" or m == "diamondplate" or m == "foil" then
		return "metal"
	end
	if m == "glass" or m == "ice" or m == "glacier" then
		return "glass"
	end
	if m == "slate" or m == "cobblestone" or m == "concrete" or m == "rock" or m == "limestone" or m == "basalt" or m == "pavement" or m == "asphalt" or m == "brick" or m == "pebble" or m == "sandstone" or m == "granite" or m == "marble" then
		return "stone"
	end
	return "default"
end

function Audio.footCue(material: string): string
	local surface = Audio.surfaceFromMaterial(material)
	return Audio.SURFACES[surface] or Audio.SURFACES.default
end

-- outside: in the wall. margin: studs of safe ground left (negative when outside).
function Audio.veilEvent(outside: boolean, margin: number, shrinking: boolean, nextIn: number?): string?
	if outside then
		return "veilTouch"
	end
	if shrinking and margin < 90 then
		return "veilWarn"
	end
	if nextIn and nextIn > 0 and nextIn <= 10 and margin < 140 then
		return "veilSoon"
	end
	return nil
end

function Audio.weaponCue(kind: string, thrown: boolean?): string?
	if thrown or kind == "spearThrow" then
		return Audio.WEAPONS.spearThrow
	end
	return Audio.WEAPONS[kind]
end

return Audio
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- All tuning numbers in one place. Names live in Names.luau; Robux IDs in Monetization.luau.
local Config = {}

Config.VERSION = "v2.0"
Config.AUTOSAVE_SECONDS = 90

-- ===== Match size: exactly 48 contenders (24 Reaches x 2) =====
Config.MATCH_SIZE = 48
Config.REACH_COUNT = 24
Config.PER_REACH = 2
Config.MAX_SERVER_PLAYERS = 50 -- set Game Settings > Places > Max Players to 50

-- ===== Matchmaking =====
Config.Matchmaking = {
	-- v1 runs everything in one server. Set crossServer = true once the lobby/arena place
	-- split is published (see README "Cross-server queue").
	crossServer = false,
	fillAfter = 90, -- seconds: launch with bots if at least minHumans are queued
	minHumans = 16,
	lateFillAfter = 150, -- seconds: launch with at least lateMinHumans
	lateMinHumans = 8,
	-- single-server rules (one Roblox server can only ever hold 50 people)
	singleServerFillAfter = 25,
	singleServerMinHumans = 1,
	nextMatchSeconds = 10, -- "Next match in 10s" after the podium
}

-- ===== Map (studs). Arena centered at the origin, ground top at y = 0 =====
Config.Map = {
	ARENA_SIZE = 2400,
	HUB_RADIUS = 44,
	PLATE_RADIUS = 100,
	LOBBY_CENTER = { 0, 0, 3400 },
	GALLERY_CENTER = { 0, 420, 0 },
	MEADOW = { x = 640, z = -620, r = 340 },
	LAKE = { x = 700, z = 480, r = 250 },
	WOOD = { x = -720, z = 0, r = 470 },
	RIDGE = { x = 0, z = -900, r = 330 },
	RUINS = { x = -420, z = 760, r = 260 },
}

-- ===== Pregame ceremony (seconds; played locally, synced by the server) =====
Config.Pregame = {
	reaping = 14,
	reapingShort = 3,
	parade = 7,
	interview = 7,
	training = 9, -- 6 s target round + 3 s score board
	launch = 10,
}
Config.Training = { targets = 5, duration = 6, max = 10, underdogAt = 4, underdogGiftMult = 0.8 }
function Config.pregameTotal(): number
	local p = Config.Pregame
	return p.reaping + p.parade + p.interview + p.training
end

-- ===== Arena timeline =====
Config.ARENA_CAP = 12 * 60
Config.HARD_CAP = 12 * 60 + 30 -- if more than one is still in at 12:30, highest Pep wins
Config.PODIUM_SECONDS = 12
-- Veil phases: at time `at` the radius shrinks from `from` to `to` over `dur` seconds.
Config.VeilPhases = {
	{ at = 180, from = 1200, to = 850, dur = 60 },
	{ at = 300, from = 850, to = 550, dur = 60 },
	{ at = 420, from = 550, to = 325, dur = 60 },
	{ at = 510, from = 325, to = 175, dur = 50 },
	{ at = 600, from = 175, to = 60, dur = 60 },
	{ at = 690, from = 60, to = 0, dur = 30 },
}
Config.VEIL_WARNING = 10
Config.VEIL_DAMAGE = { 4, 5, 6, 8, 10, 12, 15 } -- Pep per second outside, by phase (index 1 = before phase 1)

-- ===== Contenders =====
Config.PEP_MAX = 100
Config.WALK_SPEED = 16
Config.SPRINT_SPEED = 24
Config.STAMINA_MAX = 100
Config.STAMINA_DRAIN = 22 -- per second while sprinting
Config.STAMINA_REGEN = 14 -- per second
Config.BACKPACK_SLOTS = 3
Config.BACKPACK_SLOTS_BIG = 6
Config.ALLIES_UNTIL = 4 -- Reach partners can't hurt each other until 4 remain
Config.STAMINA_RESUME = 25 -- after running dry, sprint again once stamina is back to this
Config.SpeedCheck = { slack = 1.35, grace = 6, strikes = 3 } -- server rubber-bands repeat speeders

-- ===== Pacts (in-match alliances across Reaches; see Logic/Pacts.luau) =====
Config.Pacts = {
	maxSize = 4,
	offerSeconds = 10,
	offerRange = 40, -- studs: you can only offer to someone nearby
	snapSeconds = 3, -- visible wind-up before a pact breaks
	betrayWindow = 6, -- seconds the snapper's first hit on an ex-ally is a "Pact Snap" strike
	betrayBonus = 1.5,
	guardSeconds = 4, -- the betrayed take 50% less damage from everyone else for a moment
	guardMult = 0.5,
	endAt = 4, -- every pact ends when 4 remain (same as Reach partners)
	cooldown = 20, -- after snapping, wait before joining a new pact
}

-- ===== Food and water (slow meters; low meters slow stamina, they never knock you out) =====
Config.Meters = {
	max = 100,
	start = 80,
	foodDrain = 100 / 300, -- empty after ~5 min without eating
	waterDrain = 100 / 240, -- empty after ~4 min without drinking
	low = 25, -- under this, stamina refills at lowRegen
	lowRegen = 0.6, -- per low meter (both low = 0.36)
}

-- ===== Weapons and items =====
export type Weapon = { id: string, name: string, kind: string, damage: number, range: number, cooldown: number, arc: number?, ammo: number? }
Config.Weapons = {
	bow = { id = "bow", name = "Bow", kind = "ranged", damage = 22, range = 170, cooldown = 0.9, ammo = 8 },
	spear = { id = "spear", name = "Spear", kind = "melee", damage = 24, range = 10, cooldown = 0.8, arc = 70 },
	spearThrow = { id = "spearThrow", name = "Spear Throw", kind = "thrown", damage = 34, range = 90, cooldown = 1.2 },
	knife = { id = "knife", name = "Knife", kind = "melee", damage = 14, range = 7, cooldown = 0.4, arc = 70 },
	shove = { id = "shove", name = "Shove", kind = "melee", damage = 5, range = 6, cooldown = 0.6, arc = 70 },
} :: { [string]: Weapon }

export type Item = { id: string, name: string, kind: string, heal: number?, stamina: number?, weapon: string?, ammo: number?, food: number?, water: number? }
Config.Items = {
	bow = { id = "bow", name = "Bow", kind = "weapon", weapon = "bow" },
	spear = { id = "spear", name = "Spear", kind = "weapon", weapon = "spear" },
	knife = { id = "knife", name = "Knife", kind = "weapon", weapon = "knife" },
	arrows = { id = "arrows", name = "Arrows x6", kind = "ammo", ammo = 6 },
	backpack = { id = "backpack", name = "Backpack", kind = "backpack" },
	trailmix = { id = "trailmix", name = "Trail Mix", kind = "snack", heal = 20, food = 60 },
	apple = { id = "apple", name = "Apple", kind = "snack", heal = 15, stamina = 20, food = 35, water = 15 },
	canteen = { id = "canteen", name = "Canteen", kind = "snack", heal = 10, stamina = 60, water = 80 },
	bandage = { id = "bandage", name = "Bandage", kind = "snack", heal = 35 },
	sweettea = { id = "sweettea", name = "Rusty's Sweet Tea", kind = "snack", heal = 100, stamina = 100, food = 40, water = 100 },
} :: { [string]: Item }

-- Crate loot tables (weights). Hub crates are richer. Rates are shown in the Help panel.
Config.LootHub = { bow = 22, spear = 20, knife = 14, backpack = 14, arrows = 12, bandage = 10, trailmix = 8 }
Config.LootField = { knife = 16, spear = 10, bow = 8, arrows = 16, apple = 16, trailmix = 14, canteen = 10, bandage = 6, backpack = 4 }
Config.LootMeadow = { bandage = 30, bow = 20, backpack = 20, arrows = 15, canteen = 15 }
Config.HUB_CRATES = 36
Config.FIELD_CRATES = 110
Config.MEADOW_CRATES = 12
Config.TOKENS_PER_MATCH = 4

-- ===== Hazards =====
Config.Hazards = {
	finches = { warn = 5, duration = 14, radius = 24, dps = 6, speed = 15, birds = 12 },
	bloom = { warn = 5, duration = 25, dps = 4, slow = 0.6 },
	supply = { crates = 3 },
	scheduled = { { at = 240, id = "finches" }, { at = 360, id = "bloom" } },
	voteEvery = 90,
	voteFirstAt = 150,
	voteLength = 20,
}

-- ===== Viewing Gallery =====
Config.Gallery = {
	favorEvery = 5, -- seconds per +1 Favor while watching a live match
	favorStart = 10,
	giftCooldown = 45, -- per contender
	maxInAir = 6,
	partnerDiscount = 0.75,
}
export type Gift = { id: string, name: string, item: string, cost: number }
Config.Gifts = {
	{ id = "water", name = "Canteen", item = "canteen", cost = 8 },
	{ id = "snack", name = "Trail Mix", item = "trailmix", cost = 10 },
	{ id = "arrows", name = "Arrows", item = "arrows", cost = 10 },
	{ id = "bandage", name = "Bandage", item = "bandage", cost = 16 },
	{ id = "tea", name = "Rusty's Sweet Tea", item = "sweettea", cost = 40 },
} :: { Gift }
-- Patron Picks pass: cosmetic cheers paid with earned Favor. They never change a fight.
Config.CheerGifts = {
	{ id = "flare", name = "Firework Flare", cost = 12 },
	{ id = "cheer", name = "Cheering Banner", cost = 12 },
}
Config.CheerCooldown = 20

-- Spectator vote-back ("Encore"): once a match the Gallery can vote one contender back in.
Config.Encore = { at = 330, length = 20, minAlive = 6, pep = 50, candidates = 3 }

-- Sponsor letters: one a day from the patrons you've won over (see Logic/Sponsors.luau)
Config.Sponsors = { maxStack = 3, cosmeticEvery = 5, favorCap = 60 }

-- Veil Breaker finale: thrown spears bounce off the Veil. When the final four remain the Veil
-- Core lights up on the wall; a spear that has bounced off the Veil and then hits the Core
-- shatters the dome: the Veil stops closing and stops hurting for `calmSeconds`, and the thrower
-- earns the Veil Breaker title. Once per match.
Config.VeilBreaker = { at = 4, coreSize = 14, calmSeconds = 45, bounces = 1, title = "title_veilbreaker" }

-- Rusty's in-match gift: one sweet tea to the human contender with the lowest Pep when 8 remain.
Config.RUSTY_GIFT_AT = 8

-- ===== Progression =====
Config.LEVEL_CAP = 50
Config.PRESTIGE_CAP = 4
Config.XP = {
	match = 40,
	perPlaceAbove = 2, -- (49 - place) * 2
	knock = 15,
	crate = 2,
	gift = 5,
	vote = 2,
	win = 150,
	token = 25,
	top10 = 30,
	encore = 20,
	pactKept = 20, -- still in a pact when pacts end at the final four
}
Config.PLAY_STREAK_WINDOW = 240 -- seconds between matches to keep a play streak
Config.PLAY_STREAK_STEP = 0.1
Config.PLAY_STREAK_MAX = 0.5
Config.STARS = { match = 1, top10 = 2, win = 5 }
Config.STARS_PER_TIER = 8
Config.DAILY_STREAK_XP = 60

-- ===== Fair play =====
Config.FairPlay = {
	boostMult = 0.5, -- Renown Boost: +50% XP for 30 min (never affects combat)
	showerMult = 0.25, -- everyone else in the server: +25% XP for 5 min
	showerMinutes = 5,
	satchelInRanked = false, -- Starter Satchel only in casual modes
	bootsRegen = 0.05, -- Trail Boots: +5% stamina regen, casual only
	perksOffAtLeft = 10, -- every paid gameplay perk switches off when this many are left
	vipRenown = 0.10, -- Spire VIP: +10% Renown (casual)
	patronRenown = 0.15, -- Patron Club subscription: +15% Renown (casual)
	patronSkips = 2, -- Patron Club: Season Tier Skips per month
}
Config.RANKED = false -- v1 ships casual Jubilee only

-- ===== v4: Daily Ten and invites =====
-- Daily Ten: play 10 minutes in a day for a small XP + Season star bonus. Free, once a day.
-- (Roblox Creator Rewards count Active Spenders who spend 10+ minutes in an experience, so
-- this gives regulars a reason to stay past that line. It never pays Robux or items.)
Config.DailyTen = { seconds = 600, xp = 150, stars = 2 }
-- Invites: a friend who joins from your invite while you're in the server gets the Torchbearer
-- Sash, and so do you (once per friend pair, max 20 a week for the inviter).
Config.Invites = { reward = "sash_torchbearer", weeklyCap = 20 }

-- ===== Bots =====
Config.Bots = {
	tick = 0.25,
	aimSpread = 0.12, -- radians-ish error for bot bows
	damageMult = 0.8,
	reaction = { 0.35, 0.9 },
	hubBrave = 0.4, -- share of bots that rush the Sundial
	sight = 70,
}

return Config
]]></string>
        </Properties>
