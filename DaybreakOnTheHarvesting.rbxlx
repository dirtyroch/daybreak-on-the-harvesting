          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Server entry point: builds the map (if it wasn't baked), remotes, wires services, starts them.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Names = require(Shared.Names)
local Content = require(Shared.Content)
local MapBuilder = require(Shared.MapBuilder) :: any
local RateLimiter = require(Shared.Logic.RateLimiter)

local Services = script.Parent:WaitForChild("Services")

if not workspace:FindFirstChild("Map") then
	MapBuilder.build({
		Instance = Instance,
		Vector3 = Vector3,
		CFrame = CFrame,
		Color3 = Color3,
		Enum = Enum,
		UDim2 = UDim2,
		NumberSequence = NumberSequence,
		NumberRange = NumberRange,
		ColorSequence = ColorSequence,
		Vector2 = Vector2,
	}, workspace, Config, Names, Content)
end

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local action = Instance.new("RemoteFunction")
action.Name = "Action"
action.Parent = remotes
local push = Instance.new("RemoteEvent")
push.Name = "Push"
push.Parent = remotes
remotes.Parent = ReplicatedStorage

Players.CharacterAutoLoads = true

local ctx: any = {
	Data = require(Services.DataService),
	Progress = require(Services.ProgressService),
	Match = require(Services.MatchService),
	Bots = require(Services.BotService),
	Gallery = require(Services.GalleryService),
	Purchase = require(Services.PurchaseService),
	Look = require(Services.LookService),
	Hall = require(Services.HallService),
	Remotes = { Action = action, Push = push },
}

function ctx.push(player: Player, kind: string, payload: any)
	push:FireClient(player, kind, payload)
end
function ctx.pushAll(kind: string, payload: any)
	push:FireAllClients(kind, payload)
end
function ctx.toast(player: Player, text: string, kind: string?)
	push:FireClient(player, "toast", { text = text, kind = kind or "info" })
end

-- One RemoteFunction for every intent, rate-limited per player and per action.
local globalLimiter = RateLimiter.new(30, 15)
local actionLimiter = RateLimiter.new(8, 5)
local handlers: { [string]: (Player, any, any, any) -> (boolean, string?) } = {}
function ctx.handle(name: string, fn: (Player, any, any, any) -> (boolean, string?))
	handlers[name] = fn
end

for _, name in ipairs({ "Progress", "Bots", "Match", "Gallery", "Purchase", "Hall" }) do
	local svc = ctx[name]
	if svc.init then
		svc.init(ctx)
	end
end

action.OnServerInvoke = function(player: Player, name: any, a: any, b: any, c: any)
	if type(name) ~= "string" then
		return { ok = false }
	end
	local now = os.clock()
	if not RateLimiter.allow(globalLimiter, player, now) or not RateLimiter.allow(actionLimiter, tostring(player.UserId) .. name, now) then
		return { ok = false, msg = "Slow down a little!" }
	end
	local fn = handlers[name]
	if not fn then
		return { ok = false }
	end
	local ok, res, msg = pcall(fn, player, a, b, c)
	if not ok then
		warn("[Action " .. name .. "] " .. tostring(res))
		return { ok = false, msg = "Something went wrong." }
	end
	return { ok = res == true, msg = msg }
end

Players.PlayerRemoving:Connect(function(p)
	RateLimiter.forget(globalLimiter, p)
end)

ctx.Data.start()
for _, name in ipairs({ "Look", "Progress", "Bots", "Gallery", "Purchase", "Match", "Hall" }) do
	local svc = ctx[name]
	if svc.start then
		svc.start()
	end
end
print("[" .. Names.TITLE .. "] server ready · " .. Config.VERSION)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="65">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">BotService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	BotService — Stand-In contenders that fill empty plates so a match always has 48.
	Every bot is labeled "Stand-In · Name (Reach)" so nobody mistakes it for a person.
	A simple 4 Hz brain: grab a crate, eat when low, fight what's close, flee the Veil.
	Bots deal 80% damage and aim with some spread so new players can win.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Veil = require(Shared.Logic.Veil)

local BotService = {}
local ctx: any = nil
local rng = Random.new()
local brains: { [string]: any } = {}
local running = false

local SKIN = { "#F1C9A5", "#E0AC69", "#C68642", "#8D5524", "#5C3A21", "#FFDBAC" }
local SHIRT = { "#4A505C", "#5C5A52", "#6B5B4B", "#2F7F86", "#7A2E3A", "#3E8E5E", "#B8793A", "#2B2D33" }
local PANTS = { "#2B2D33", "#3A3A40", "#5C5A52", "#4A3426" }

local function color(h: string): Color3
	return Color3.fromHex(h)
end

local function simpleRig(name: string): Model
	-- fallback when avatar rigs can't be created (e.g. offline Studio tests)
	local m = Instance.new("Model")
	m.Name = name
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Transparency = 1
	root.Parent = m
	local torso = Instance.new("Part")
	torso.Name = "Torso"
	torso.Size = Vector3.new(2, 2, 1)
	torso.Color = color(SHIRT[rng:NextInteger(1, #SHIRT)])
	torso.CFrame = root.CFrame
	torso.Parent = m
	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1.2, 1.2, 1.2)
	head.Shape = Enum.PartType.Ball
	head.Color = color(SKIN[rng:NextInteger(1, #SKIN)])
	head.CFrame = root.CFrame * CFrame.new(0, 1.6, 0)
	head.Parent = m
	local legs = Instance.new("Part")
	legs.Name = "Legs"
	legs.Size = Vector3.new(1.8, 2, 1)
	legs.Color = color(PANTS[rng:NextInteger(1, #PANTS)])
	legs.CFrame = root.CFrame * CFrame.new(0, -2, 0)
	legs.Parent = m
	for _, p in ipairs({ torso, head, legs }) do
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = p
		w.Parent = p
	end
	local hum = Instance.new("Humanoid")
	hum.HipHeight = 2
	hum.Parent = m
	m.PrimaryPart = root
	return m
end

local function makeRig(name: string): Model
	-- realistic R15 Stand-In (see LookService / Shared/Look.luau); blocky fallback only offline
	local rig = ctx and ctx.Look and ctx.Look.standIn(name, rng)
	if rig then
		return rig
	end
	return simpleRig(name)
end

function BotService.spawn(c: any, cf: CFrame): Model?
	local m = makeRig(c.name)
	local hum = m:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayName = string.format("%s (%s)", c.name, c.reach)
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
		hum.NameDisplayDistance = 60
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		hum.BreakJointsOnDeath = false
		hum.WalkSpeed = 14
		hum.MaxHealth = 1e6
		hum.Health = 1e6
	end
	m:SetAttribute("StandIn", true)
	m:PivotTo(cf)
	local folder = workspace:FindFirstChild("StandIns")
	if not folder then
		local f = Instance.new("Folder")
		f.Name = "StandIns"
		f.Parent = workspace
		folder = f
	end
	m.Parent = folder
	local root = m:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		root.Anchored = true
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	brains[c.id] = {
		next = 0,
		goal = nil,
		crate = nil,
		target = nil,
		react = rng:NextNumber(Config.Bots.reaction[1], Config.Bots.reaction[2]),
		brave = rng:NextNumber() < Config.Bots.hubBrave,
	}
	return m
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function safePoint(radius: number): Vector3
	local a = rng:NextNumber(0, math.pi * 2)
	local r = rng:NextNumber(0, math.max(10, radius * 0.7))
	return Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
end

local function nearestCrate(pos: Vector3, maxD: number): BasePart?
	local best: BasePart? = nil
	local bestD = maxD
	for _, crate in ipairs(ctx.Match.allCrates()) do
		if not crate:GetAttribute("Opened") then
			local d = (crate.Position - pos).Magnitude
			if d < bestD then
				best, bestD = crate, d
			end
		end
	end
	return best
end

local function think(c: any, b: any, _t: number)
	local M = ctx.Match
	local root = M.rootOf(c)
	local hum = c.model and c.model:FindFirstChildOfClass("Humanoid")
	if not root or not hum then
		return
	end
	local pos = root.Position
	hum.WalkSpeed = 14 * ((c.model:GetAttribute("SpeedMult") or 1) :: number)
	-- 1) flee the Veil
	local _, target = Veil.nextShrink(M.t, Config.VeilPhases)
	local safeR = math.min(M.radius, target or M.radius)
	if Veil.outside(pos.X, pos.Z, safeR * 0.92) then
		local inward = -flat(pos)
		if inward.Magnitude > 1 then
			hum:MoveTo(pos + inward.Unit * 60)
		end
		return
	end
	-- 2) eat when low
	if c.pep < 55 then
		for i, item in ipairs(c.inv) do
			local d = Config.Items[item]
			if d and d.kind == "snack" then
				M.eat(c, i)
				return
			end
		end
	end
	-- pick best weapon
	local bestSlot, bestDmg = 0, 0
	for i, item in ipairs(c.inv) do
		local d = Config.Items[item]
		local w = d and d.weapon and Config.Weapons[d.weapon]
		if w and (w.kind ~= "ranged" or c.ammo > 0) and w.damage > bestDmg then
			bestSlot, bestDmg = i, w.damage
		end
	end
	if bestSlot > 0 then
		c.equipped = bestSlot
	end
	-- 3) fight what's close
	local enemy: any = nil
	local enemyD = Config.Bots.sight
	for _, o in pairs(M.contenders) do
		if o ~= c and o.alive and M.canHurt(c, o) then
			local orr = M.rootOf(o)
			if orr then
				local d = (orr.Position - pos).Magnitude
				if d < enemyD then
					enemy, enemyD = o, d
				end
			end
		end
	end
	if enemy and (bestSlot > 0 or enemyD < 10) then
		local er = M.rootOf(enemy)
		if er then
			local item = c.inv[c.equipped]
			local d = item and Config.Items[item]
			local w = d and d.weapon and Config.Weapons[d.weapon] or Config.Weapons.shove
			if w.kind == "ranged" then
				if enemyD > w.range * 0.7 then
					hum:MoveTo(er.Position)
				else
					hum:MoveTo(pos + (pos - er.Position).Unit:Cross(Vector3.yAxis) * 8)
				end
				local spread = Config.Bots.aimSpread * enemyD
				local aim = er.Position + Vector3.new(rng:NextNumber(-spread, spread), rng:NextNumber(-1, 1), rng:NextNumber(-spread, spread))
				root.CFrame = CFrame.lookAt(pos, Vector3.new(er.Position.X, pos.Y, er.Position.Z))
				M.attack(c, w.id, aim)
			else
				hum:MoveTo(er.Position)
				if enemyD <= w.range + 1 then
					M.attack(c, w.id, er.Position)
				end
			end
			return
		end
	end
	-- 4) loot
	if #c.inv < c.slots then
		local crate = b.crate
		if not crate or crate:GetAttribute("Opened") then
			crate = nearestCrate(pos, b.brave and 400 or 220)
			b.crate = crate
		end
		if crate then
			if (crate.Position - pos).Magnitude < 9 then
				M.openCrate(c, crate)
				b.crate = nil
			else
				hum:MoveTo(crate.Position)
			end
			return
		end
	end
	-- 5) wander inside the safe zone
	if not b.goal or (flat(b.goal) - flat(pos)).Magnitude < 12 or Veil.outside(b.goal.X, b.goal.Z, safeR * 0.85) then
		b.goal = safePoint(safeR)
	end
	hum:MoveTo(b.goal)
end

function BotService.onArenaStart()
	running = true
	for id, c in pairs(ctx.Match.contenders) do
		if c.kind == "bot" and c.model then
			local root = c.model:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				root.Anchored = false
				pcall(function()
					root:SetNetworkOwner(nil)
				end)
			end
			local b = brains[id]
			if b then
				b.next = workspace:GetServerTimeNow() + b.react
			end
		end
	end
end

function BotService.onArenaEnd()
	running = false
	brains = {}
end

function BotService.init(c: any)
	ctx = c
end

function BotService.start()
	task.spawn(function()
		while true do
			task.wait(Config.Bots.tick)
			if running then
				local t = workspace:GetServerTimeNow()
				for id, c in pairs(ctx.Match.contenders) do
					local b = brains[id]
					if c.kind == "bot" and c.alive and b and t >= b.next then
						b.next = t + Config.Bots.tick
						local ok, err = pcall(function(): any
							think(c, b, t)
							return nil
						end)
						if not ok then
							warn("[BotService] " .. tostring(err))
						end
					end
				end
			end
		end
	end)
end

return BotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DataService — DataStore persistence with session locking, retries and safe shutdown.

	Record format in the DataStore: { lock = { jobId, time }?, data = <player data> }
	  * Load: UpdateAsync acquires the lock. If another live server holds it (player hopped
	    servers and the old one is still saving), we wait and retry; a lock older than
	    STALE_LOCK seconds is treated as abandoned.
	  * Autosave every Config.AUTOSAVE_SECONDS refreshes the lock.
	  * Leave / shutdown: final save releases the lock.
	  * If we ever lose the lock, we stop saving for that player (never overwrite newer data).
	  * In Studio without "Enable Studio Access to API Services", we run in memory-only mode.
]]
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local DefaultData = require(Shared.DefaultData)
local SessionLock = require(Shared.Logic.SessionLock)
local Reconcile = require(Shared.Logic.Reconcile)

local STORE_NAME = "DaybreakHarvesting_Players_v1"
local STALE_LOCK = 300 -- seconds
local LOAD_ATTEMPTS = 8
local SAVE_ATTEMPTS = 4

export type Profile = {
	player: Player,
	key: string,
	data: any,
	memoryOnly: boolean,
	lostLock: boolean,
	saving: boolean,
	released: boolean,
	loadedAt: number,
}

local DataService = {}
DataService.profiles = {} :: { [Player]: Profile }
DataService.onLoaded = Instance.new("BindableEvent")

local jobId = game.JobId ~= "" and game.JobId or ("studio-" .. HttpService:GenerateGUID(false))
local store: DataStore? = nil
local _storeError: string? = nil

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		local why = tostring(result)
		_storeError = why
		warn("[DataService] DataStore unavailable: " .. why)
	end
end

local function keyFor(userId: number): string
	return "u_" .. tostring(userId)
end

local function waitForBudget(requestType: Enum.DataStoreRequestType)
	local tries = 0
	while DataStoreService:GetRequestBudgetForRequestType(requestType) < 1 and tries < 20 do
		tries += 1
		task.wait(0.5)
	end
end

local function isApiAccessError(err: string): boolean
	return string.find(err, "403", 1, true) ~= nil
		or string.find(string.lower(err), "studio", 1, true) ~= nil
		or string.find(string.lower(err), "api services", 1, true) ~= nil
end

local function freshData(): any
	return DefaultData.new()
end

function DataService.get(player: Player): Profile?
	return DataService.profiles[player]
end

function DataService.waitFor(player: Player, timeout: number): Profile?
	local t0 = os.clock()
	while player.Parent and os.clock() - t0 < timeout do
		local p = DataService.profiles[player]
		if p then
			return p
		end
		task.wait(0.2)
	end
	return DataService.profiles[player]
end

function DataService.load(player: Player): Profile?
	local key = keyFor(player.UserId)
	local memoryOnly = false
	local data = nil

	if store == nil then
		memoryOnly = true
	else
		local s = store :: DataStore
		for attempt = 1, LOAD_ATTEMPTS do
			if not player.Parent then
				return nil
			end
			waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
			local status = "error"
			local loaded = nil
			local ok, err = pcall(function()
				s:UpdateAsync(key, function(old)
					local rec, st = SessionLock.acquire(old, jobId, os.time(), STALE_LOCK)
					status = st
					if rec then
						loaded = rec.data
					end
					return rec
				end)
			end)
			if ok and (status == "acquired" or status == "stale-taken") then
				data = loaded
				break
			elseif ok and status == "locked" then
				-- Another server is still finishing this player's save. Wait for it.
				task.wait(math.min(2 * attempt, 8))
			else
				local msg = tostring(err)
				warn(string.format("[DataService] load attempt %d failed for %s: %s", attempt, player.Name, msg))
				if RunService:IsStudio() and isApiAccessError(msg) then
					memoryOnly = true
					break
				end
				task.wait(math.min(2 ^ attempt, 16))
			end
			if attempt == LOAD_ATTEMPTS then
				player:Kick("We couldn't load your save safely (Roblox servers are busy). Please rejoin in a minute. Your progress is safe.")
				return nil
			end
		end
	end

	if not player.Parent then
		-- Left while loading: release the lock we just took.
		if not memoryOnly and store then
			pcall(function()
				(store :: DataStore):UpdateAsync(key, function(old)
					if old and old.lock and old.lock.jobId == jobId then
						old.lock = nil
						return old
					end
					return nil
				end)
			end)
		end
		return nil
	end

	local isNew = data == nil
	data = Reconcile.fill(data or freshData(), DefaultData.new())
	local profile: Profile = {
		player = player,
		key = key,
		data = data,
		memoryOnly = memoryOnly,
		lostLock = false,
		saving = false,
		released = false,
		loadedAt = os.time(),
	}
	DataService.profiles[player] = profile
	DataService.onLoaded:Fire(player, profile, isNew)
	return profile
end

-- Returns true if the data is safely in the DataStore.
function DataService.save(profile: Profile, release: boolean): boolean
	if profile.memoryOnly then
		return true
	end
	if profile.lostLock or store == nil then
		return false
	end
	-- Don't run two saves for the same player at once.
	local waited = 0
	while profile.saving and waited < 30 do
		task.wait(0.25)
		waited += 0.25
	end
	profile.saving = true
	profile.data.lastSeen = os.time()
	local s = store :: DataStore
	local saved = false
	for attempt = 1, SAVE_ATTEMPTS do
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local status = "error"
		local ok, err = pcall(function()
			s:UpdateAsync(profile.key, function(old)
				local rec, st = SessionLock.save(old, jobId, os.time(), profile.data, release)
				status = st
				return rec
			end)
		end)
		if ok and status == "saved" then
			saved = true
			break
		elseif ok and status == "lost-lock" then
			warn("[DataService] lost session lock for " .. profile.key .. "; not overwriting newer data")
			profile.lostLock = true
			break
		else
			warn(string.format("[DataService] save attempt %d failed for %s: %s", attempt, profile.key, tostring(err)))
			task.wait(math.min(2 ^ attempt, 8))
		end
	end
	profile.saving = false
	if release and saved then
		profile.released = true
	end
	return saved
end

function DataService.release(player: Player)
	local profile = DataService.profiles[player]
	if not profile then
		return
	end
	DataService.save(profile, true)
	DataService.profiles[player] = nil
end

function DataService.isStudioMemoryMode(player: Player): boolean
	local p = DataService.profiles[player]
	return p ~= nil and p.memoryOnly
end

function DataService.start()
	-- Autosave loop (also refreshes our session locks).
	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_SECONDS)
			for _, profile in pairs(DataService.profiles) do
				task.spawn(DataService.save, profile, false)
				task.wait(0.5) -- spread requests out
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and store == nil then
			return
		end
		local pending = 0
		for player, _ in pairs(DataService.profiles) do
			pending += 1
			task.spawn(function()
				DataService.release(player)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.2)
		end
	end)
end

-- NOTE: ProgressService handles PlayerRemoving and then calls DataService.release.

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">GalleryService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	GalleryService — the Viewing Gallery. Knocked-out players (and anyone who taps "Watch") keep
	playing from a glass lounge above the arena:
	  * Favor: +1 every 5 s while watching (Big Sponsor pass doubles the rate). Never sold.
	  * Parachute gifts to any contender (pricier late in the match; partner discount).
	  * Hazard votes every 90 s: 3 cards, one always friendly (Supply Drop).
	  * Encore: once a match, the Gallery votes one knocked-out contender back in.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Names = require(Shared.Names)
local Content = require(Shared.Content)
local Gifts = require(Shared.Logic.Gifts)
local Vote = require(Shared.Logic.Vote)
local Twists = require(Shared.Logic.Twists)
local Training = require(Shared.Logic.Training)
local Store = require(Shared.Store)
local Offers = require(Shared.Offers)

local GalleryService = {}
local ctx: any = nil
local rng = Random.new()

local spectators: { [Player]: { favor: number, gifts: number, votes: number } } = {}
local lastGift: { [string]: number } = {}
local inAir = 0
local hazardBallot: Vote.Ballot? = nil
local hazardEnds = 0
local nextHazardVote = 0
local encoreBallot: Vote.Ballot? = nil
local encoreEnds = 0
local encoresLeft = 0
local live = false

local function now(): number
	return workspace:GetServerTimeNow()
end
local partnerMoments: () -> ()
local partnerShown: { [Player]: boolean } = {}

function GalleryService.isSpectator(p: Player): boolean
	return spectators[p] ~= nil
end

function GalleryService.addSpectator(p: Player)
	if not spectators[p] then
		-- sponsor letters bank a Favor head start for the next visit
		local bank = ctx.Progress.takeFavorBank(p)
		spectators[p] = { favor = Config.Gallery.favorStart + bank, gifts = 0, votes = 0 }
		if bank > 0 then
			ctx.toast(p, string.format("Your patrons sent +%d %s for today's gifts.", bank, Names.FAVOR), "good")
		end
	end
	ctx.push(p, "gallery", GalleryService.view(p))
end

function GalleryService.removeSpectator(p: Player)
	if spectators[p] then
		spectators[p] = nil
		ctx.push(p, "galleryClose", {})
	end
end

local function tmpl(name: string): Instance?
	local t = ServerStorage:FindFirstChild("Templates")
	return t and t:FindFirstChild(name)
end

-- Parachute down onto a position; calls onLand when it touches down.
local function parachute(pos: Vector3, label: string?, onLand: () -> (), wrap: string?)
	local t = tmpl("Parachute")
	if not t then
		onLand()
		return
	end
	inAir += 1
	local m = (t :: Model):Clone()
	local start = pos + Vector3.new(0, 140, 0)
	m:PivotTo(CFrame.new(start))
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			-- Gift Wraps (Item Shop) recolor the canopy stripe and the crate
			if wrap and (d.Name == "Stripe" or d.Name == "Box") then
				d.Color = Color3.fromHex(wrap)
			end
		end
	end
	if label then
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.new(0, 200, 0, 30)
		bb.StudsOffset = Vector3.new(0, 14, 0)
		bb.AlwaysOnTop = true
		bb.MaxDistance = 250
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(1, 1)
		tl.BackgroundTransparency = 1
		tl.TextScaled = true
		tl.Font = Enum.Font.FredokaOne
		tl.TextColor3 = Color3.fromHex("#FFE9A8")
		tl.TextStrokeTransparency = 0.3
		tl.Text = label
		tl.Parent = bb
		bb.Parent = m.PrimaryPart
	end
	m.Parent = workspace
	local v = Instance.new("CFrameValue")
	v.Value = CFrame.new(start)
	v.Changed:Connect(function(cf: CFrame)
		if m.Parent then
			m:PivotTo(cf)
		end
	end)
	local tw = TweenService:Create(v, TweenInfo.new(6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Value = CFrame.new(pos + Vector3.new(0, 1.5, 0)) })
	tw.Completed:Connect(function()
		inAir -= 1
		onLand()
		task.delay(1.5, function()
			m:Destroy()
			v:Destroy()
		end)
	end)
	tw:Play()
end

-- A gift lands on a contender (from a spectator, or from Rusty).
function GalleryService.dropGift(c: any, item: string, fromName: string, note: string?, wrap: string?)
	local root = ctx.Match.rootOf(c)
	if not root then
		return
	end
	local def = Config.Items[item]
	parachute(root.Position, def and def.name or item, function()
		if not c.alive then
			return
		end
		if not ctx.Match.give(c, item) and def and def.heal then
			c.pep = math.min(Config.PEP_MAX, c.pep + def.heal)
			if c.player then
				ctx.push(c.player, "pep", { pep = c.pep, from = "gift" })
			end
		end
		if c.player then
			ctx.push(c.player, "gift", { from = fromName, item = def and def.name or item, note = note })
		end
	end, wrap)
	ctx.pushAll("giftFeed", { from = fromName, to = c.name, item = def and def.name or item })
end

-- A free supply crate on a parachute (the friendly hazard card).
function GalleryService.dropCrate(pos: Vector3)
	parachute(pos, "Supply Crate", function()
		local p = Instance.new("Part")
		p.Name = "SupplyCrate"
		p.Anchored = true
		p.Size = Vector3.new(4, 3, 3)
		p.Color = Color3.fromHex("#D4A72C")
		p.Material = Enum.Material.Wood
		p.CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0))
		p:SetAttribute("Loot", "hub")
		p:SetAttribute("Crate", true)
		local pp = Instance.new("ProximityPrompt")
		pp.ActionText = "Open"
		pp.ObjectText = "Supply Crate"
		pp.HoldDuration = 0.6
		pp.MaxActivationDistance = 9
		pp.RequiresLineOfSight = false
		pp.Parent = p
		local folder = workspace:WaitForChild("Map").Arena:FindFirstChild("FieldCrates")
		p.Parent = folder or workspace
		pp.Triggered:Connect(function(player: Player)
			local c = ctx.Match.contenderOf(player)
			if c and ctx.Match.openCrate(c, p) then
				task.delay(1, function()
					p:Destroy()
				end)
			end
		end)
		task.delay(240, function()
			if p.Parent then
				p:Destroy()
			end
		end)
	end)
end

function GalleryService.view(p: Player): any
	local s = spectators[p]
	local mine = ctx.Match.contenderOf(p)
	local alive = {}
	local weekMult = Twists.mod({ ctx.Match.weekly }, "giftCost", 1)
	local count = ctx.Match.aliveCount()
	for _, id in ipairs(ctx.Match.order) do
		local c = ctx.Match.contenders[id]
		if c and c.alive then
			local isPartner = mine ~= nil and mine.partner == c.id
			local under = Training.giftMult(c.training, Config.Training.underdogAt, Config.Training.underdogGiftMult) < 1
			-- v4: spectators see each contender's equipped cosmetics (weapon skin + Mastery, fade)
			local held = c.inv and c.inv[c.equipped] or "bow"
			local slot = (held == "spear" or held == "knife") and held or "bow"
			local skin, lvl = ctx.Match.looksOf(c, slot)
			local sk = Store.byId[skin]
			local fade = c.player and ctx.Match.fadeOf(c, nil) or "fade_gold"
			local look = {
				weapon = sk and sk.name or ("Default " .. slot),
				weaponColor = sk and sk.color or nil,
				stars = lvl >= 5 and "✦" or string.rep("★", lvl),
				fade = Content.FADES[fade] and Content.FADES[fade].name or nil,
				fadeColor = Content.FADES[fade] and Content.FADES[fade].color or nil,
			}
			table.insert(alive, { id = c.id, name = c.name, reach = c.reach, pep = c.pep, partner = isPartner, bot = c.kind == "bot", underdog = under, training = c.training, look = look })
		end
	end
	local gifts = {}
	for _, g in ipairs(Config.Gifts) do
		table.insert(gifts, { id = g.id, name = g.name, cost = Gifts.cost(g.cost, count, false, Config.Gallery.partnerDiscount, weekMult), partnerCost = Gifts.cost(g.cost, count, true, Config.Gallery.partnerDiscount, weekMult), underdogCost = Gifts.cost(g.cost, count, false, Config.Gallery.partnerDiscount, weekMult * Config.Training.underdogGiftMult) })
	end
	local cheers = nil
	if ctx.Progress.hasPass(p, "PatronPicks") then
		cheers = Config.CheerGifts
	end
	local hb = hazardBallot
	local eb = encoreBallot
	local encoreNames = {}
	if eb then
		for _, id in ipairs(eb.options) do
			local c = ctx.Match.contenders[id]
			table.insert(encoreNames, { id = id, name = c and c.name or id })
		end
	end
	return {
		favor = s and s.favor or 0,
		alive = alive,
		gifts = gifts,
		cheers = cheers,
		hazard = hb and { options = hb.options, counts = Vote.counts(hb), ends = hazardEnds, mine = hb.votes[tostring(p.UserId)] } or nil,
		hazardCards = Content.HAZARD_CARDS,
		encore = eb and { options = encoreNames, counts = Vote.counts(eb), ends = encoreEnds, mine = eb.votes[tostring(p.UserId)] } or nil,
		t = ctx.Match.t,
	}
end

local function pushViews()
	for p in pairs(spectators) do
		if p.Parent then
			ctx.push(p, "gallery", GalleryService.view(p))
		else
			spectators[p] = nil
		end
	end
end

-- ===== intents =====
local function wrapOf(player: Player): string?
	local pd = ctx.Progress.dataOf(player)
	local id = pd and pd.equipped and pd.equipped.wrap
	local it = id and Store.byId[id]
	return it and it.color or nil
end

-- Patron Picks: a firework flare or a cheering banner over a contender. Cosmetic only.
local lastCheer: { [string]: number } = {}
local function cheer(player: Player, s: any, c: any, id: string): (boolean, string?)
	local g = nil
	for _, x in ipairs(Config.CheerGifts) do
		if x.id == id then
			g = x
		end
	end
	if not g then
		return false, nil
	end
	if not ctx.Progress.hasPass(player, "PatronPicks") then
		return false, "Cheers come with the Patron Picks pass."
	end
	local key = player.UserId .. ":" .. c.id
	if lastCheer[key] and now() - lastCheer[key] < Config.CheerCooldown then
		return false, "You just cheered for them!"
	end
	if s.favor < g.cost then
		return false, string.format("Needs %d %s.", g.cost, Names.FAVOR)
	end
	s.favor -= g.cost
	lastCheer[key] = now()
	local root = ctx.Match.rootOf(c)
	ctx.pushAll("cheer", { kind = g.id, from = player.DisplayName, to = c.name, at = root and root.Position or nil, color = wrapOf(player) or "#FFD36B" })
	if c.player then
		ctx.push(c.player, "toast", { text = string.format("📣 %s is cheering for you!", player.DisplayName), kind = "good" })
	end
	pushViews()
	return true, g.id == "flare" and "🎆 Flare away!" or "📣 Cheer sent!"
end
local function gift(player: Player, targetId: any, giftId: any): (boolean, string?)
	local s = spectators[player]
	if not s then
		return false, "Gifts are sent from " .. Names.GALLERY .. "."
	end
	if type(targetId) ~= "string" or type(giftId) ~= "string" then
		return false, nil
	end
	local c = ctx.Match.contenders[targetId]
	if not c or not c.alive then
		return false, "They're out already."
	end
	local g = nil
	for _, x in ipairs(Config.Gifts) do
		if x.id == giftId then
			g = x
		end
	end
	if not g then
		return cheer(player, s, c, giftId)
	end
	local ok, wait = Gifts.canSend(lastGift, targetId, now(), Config.Gallery.giftCooldown)
	if not ok then
		return false, string.format("%s just got a gift. Try again in %ds.", c.name, math.ceil(wait))
	end
	if inAir >= Config.Gallery.maxInAir then
		return false, "The sky is full of parachutes! Wait a moment."
	end
	local mine = ctx.Match.contenderOf(player)
	local isPartner = mine ~= nil and mine.partner == c.id
	-- underdog rule: a low training score makes gifts to that contender cheaper
	local under = Training.giftMult(c.training, Config.Training.underdogAt, Config.Training.underdogGiftMult)
	local cost = Gifts.cost(g.cost, ctx.Match.aliveCount(), isPartner, Config.Gallery.partnerDiscount, Twists.mod({ ctx.Match.weekly }, "giftCost", 1) * under)
	if s.favor < cost then
		return false, string.format("Needs %d %s. You earn it by watching.", cost, Names.FAVOR)
	end
	s.favor -= cost
	s.gifts += 1
	lastGift[targetId] = now()
	GalleryService.dropGift(c, g.item, player.DisplayName, nil, wrapOf(player))
	ctx.Progress.bump(player, "gifts", 1)
	ctx.Progress.onboard(player, "gallery")
	local pd = ctx.Progress.dataOf(player)
	if pd then
		pd.stats.gifts += 1
	end
	pushViews()
	return true, "Gift away! 🪂"
end

local function vote(player: Player, kind: any, option: any): (boolean, string?)
	if not spectators[player] or type(option) ~= "string" then
		return false, nil
	end
	local b = (kind == "encore") and encoreBallot or hazardBallot
	if not b then
		return false, "No vote open right now."
	end
	local first = b.votes[tostring(player.UserId)] == nil
	if not Vote.cast(b, tostring(player.UserId), option) then
		return false, nil
	end
	ctx.Progress.onboard(player, "gallery")
	if first then
		spectators[player].votes += 1
		ctx.Progress.bump(player, "votes", 1)
	end
	pushViews()
	return true, nil
end

function GalleryService.onArenaStart()
	table.clear(partnerShown)
	live = true
	lastGift = {}
	inAir = 0
	hazardBallot = nil
	encoreBallot = nil
	nextHazardVote = math.floor(Config.Hazards.voteFirstAt * ctx.Match.mode.pace)
	encoresLeft = math.floor(Twists.mod({ ctx.Match.weekly }, "encores", 1))
end

function GalleryService.onArenaEnd()
	live = false
	hazardBallot = nil
	encoreBallot = nil
	pushViews()
end

-- v4: the Gallery partner moment. Once a match, when your partner reaches the last 10 or runs
-- low on Pep, a calm card offers a Favor gift (earned currency, never Robux).
partnerMoments = function()
	local M = ctx.Match
	local alive = M.aliveCount()
	for p, s in pairs(spectators) do
		if not partnerShown[p] then
			local mine = M.contenderOf(p)
			local partner = mine and mine.partner and M.contenders[mine.partner]
			if partner and partner.alive and Offers.partnerMoment(alive, partner.pep, Config.PEP_MAX) then
				partnerShown[p] = true
				local g = Config.Gifts[1]
				for _, x in ipairs(Config.Gifts) do
					if x.id == (partner.pep <= Config.PEP_MAX * 0.35 and "bandage" or "water") then
						g = x
					end
				end
				local cost = Gifts.cost(g.cost, alive, true, Config.Gallery.partnerDiscount, Twists.mod({ M.weekly }, "giftCost", 1))
				local wid = (ctx.Progress.dataOf(p) or { equipped = {} }).equipped.wrap
				local w = Store.byId[wid or ""]
				local card = Offers.partnerCard(partner.name, g.name, cost, s.favor, w and w.name or nil)
				card.target = partner.id
				card.gift = g.id
				ctx.push(p, "partnerMoment", card)
			end
		end
	end
end

local function tick()
	local M = ctx.Match
	local t = M.t
	-- Favor
	for p, s in pairs(spectators) do
		local rate = ctx.Progress.hasPass(p, "BigSponsor") and 2 or 1
		s.favor += rate
	end
	-- hazard votes
	if hazardBallot and now() >= hazardEnds then
		local winner = Vote.winner(hazardBallot)
		hazardBallot = nil
		M.startHazard(winner)
	elseif not hazardBallot and t >= nextHazardVote and next(spectators) ~= nil then
		nextHazardVote = t + math.max(45, math.floor(Config.Hazards.voteEvery * M.mode.pace))
		local opts = {}
		for _, card in ipairs(Content.HAZARD_CARDS) do
			table.insert(opts, card.id)
		end
		hazardBallot = Vote.new(opts)
		hazardEnds = now() + Config.Hazards.voteLength
		ctx.pushAll("vote", { kind = "hazard", seconds = Config.Hazards.voteLength })
	end
	-- Encore
	local E = Config.Encore
	if encoreBallot and now() >= encoreEnds then
		local winner = Vote.winner(encoreBallot)
		encoreBallot = nil
		local c = M.contenders[winner]
		if c then
			M.revive(c)
		end
	elseif not encoreBallot and encoresLeft > 0 and t >= (E.at + (1 - encoresLeft) * 120) * M.mode.pace and M.aliveCount() >= E.minAlive then
		local out = {}
		for _, c in pairs(M.contenders) do
			if not c.alive and c.place and not c.encore then
				table.insert(out, c)
			end
		end
		table.sort(out, function(a: any, b: any): boolean
			local ah = a.player and 1 or 0
			local bh = b.player and 1 or 0
			if ah ~= bh then
				return ah > bh
			end
			return a.knocks > b.knocks
		end)
		if #out > 0 then
			encoresLeft -= 1
			local opts = {}
			for i = 1, math.min(E.candidates, #out) do
				table.insert(opts, out[i].id)
			end
			encoreBallot = Vote.new(opts)
			encoreEnds = now() + E.length
			ctx.pushAll("vote", { kind = "encore", seconds = E.length })
		end
	end
	partnerMoments()
	pushViews()
end

function GalleryService.init(c: any)
	ctx = c
	ctx.handle("gift", gift)
	ctx.handle("vote", vote)
	ctx.handle("leaveGallery", function(player: Player): (boolean, string?)
		local mine = ctx.Match.contenderOf(player)
		if mine and mine.alive then
			return false, nil
		end
		GalleryService.removeSpectator(player)
		task.spawn(function()
			player:LoadCharacterAsync()
		end)
		return true, nil
	end)
end

function GalleryService.start()
	Players.PlayerRemoving:Connect(function(p)
		spectators[p] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(Config.Gallery.favorEvery)
			if live then
				local ok, err = pcall(function(): any
					tick()
					return nil
				end)
				if not ok then
					warn("[GalleryService] " .. tostring(err))
				end
			end
		end
	end)
	local _ = rng
end

return GalleryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">HallService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	HallService (v4): status you can see.
	  * Victory Podium: after every match the top three stand on the lobby podium as statues in
	    their equipped weapon skin, pose, fade aura and banner. Every player in the server gets
	    a short camera visit ("podiumShow") and the poses play on every client.
	  * Hall of Champions: this week's top five winners (OrderedDataStore, across servers) stand
	    on plinths in the lobby in their saved loadout. Falls back to this server's recent
	    winners if DataStores are unavailable (Studio without API access).
	Statues are plain models: only the HumanoidRootPart is anchored so the Motor6Ds can pose.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Content = require(Shared.Content)
local Store = require(Shared.Store)
local Anim = require(Shared.Anim)
local Mastery = require(Shared.Mastery)
local TimeUtil = require(Shared.Logic.TimeUtil)
local Arms = require(Shared.Arms) :: any

local HallService = {}
local ctx: any = nil

local E = {
	Instance = Instance,
	Vector3 = Vector3,
	CFrame = CFrame,
	Color3 = Color3,
	Enum = Enum,
	UDim2 = UDim2,
	NumberSequence = NumberSequence,
	NumberRange = NumberRange,
	ColorSequence = ColorSequence,
	Vector2 = Vector2,
}

HallService.TAG = "DaybreakPose"
HallService.HALL_SIZE = 5
HallService.REFRESH = 300

export type Loadout = { userId: number, name: string, pose: string, weapon: string, skin: string, mastery: number, fade: string, banner: string, title: string, wins: number? }

local recent: { Loadout } = {} -- this server's winners, newest first (fallback)
local winsStore: OrderedDataStore? = nil
local loadoutStore: DataStore? = nil

local function lobby(): Instance?
	local map = workspace:FindFirstChild("Map")
	return map and map:FindFirstChild("Lobby")
end

-- The loadout a player shows off: equipped pose, their best-mastered weapon skin, fade, banner.
function HallService.loadoutOf(player: Player): Loadout?
	local data = ctx.Progress.dataOf(player)
	if not data then
		return nil
	end
	local eq = data.equipped or {}
	local best, bestPts = "bow", -1
	for _, slot in ipairs(Mastery.SLOTS) do
		local pts = (data.mastery or {})[Mastery.key(slot, eq[slot])] or 0
		if pts > bestPts or (pts == bestPts and (eq[slot] or "") ~= "" and (eq[best] or "") == "") then
			best, bestPts = slot, pts
		end
	end
	return {
		userId = player.UserId,
		name = player.DisplayName,
		pose = (eq.pose ~= nil and eq.pose ~= "") and eq.pose or Anim.DEFAULT_POSE,
		weapon = best,
		skin = eq[best] or "",
		mastery = Mastery.level(math.max(bestPts, 0)),
		fade = eq.fade or "fade_gold",
		banner = eq.banner or "",
		title = eq.title or "",
	}
end

local function rig(userId: number, name: string): Model?
	if userId > 0 then
		local ok, m = pcall(function()
			return Players:CreateHumanoidModelFromUserId(userId)
		end)
		if ok and m then
			return m
		end
	end
	local standIn = ctx.Look and ctx.Look.standIn(name, Random.new(#name * 7919))
	return standIn
end

-- Builds a posed statue standing on `spot`.
function HallService.statue(l: Loadout, spot: BasePart, parent: Instance, label: string?): Model?
	local m = rig(l.userId, l.name)
	if not m then
		return nil
	end
	m.Name = "Statue_" .. l.name
	local hum = m:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.PlatformStand = true
	end
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.Anchored = d.Name == "HumanoidRootPart"
		end
	end
	local hrp = m:FindFirstChild("HumanoidRootPart") :: BasePart?
	local height = hum and (hum.HipHeight + (hrp and hrp.Size.Y / 2 or 1)) or 3
	m:PivotTo(spot.CFrame * CFrame.new(0, height, 0))
	Arms.attach(E, m, l.weapon, l.skin, l.mastery)
	-- fade aura: a soft column of the fade's particles around the plinth
	local f = Content.FADES[l.fade] or Content.FADES.fade_gold
	local aura = Instance.new("ParticleEmitter")
	aura.Name = "FadeAura"
	aura.Color = ColorSequence.new(Color3.fromHex(f.color))
	aura.LightEmission = 1
	aura.Rate = 5
	aura.Lifetime = NumberRange.new(1.5, 2.5)
	aura.Speed = NumberRange.new(1, 2)
	aura.Size = NumberSequence.new(0.3, 0)
	aura.SpreadAngle = Vector2.new(30, 30)
	aura.Acceleration = Vector3.new(0, 2, 0)
	aura.Parent = spot
	-- name card with banner, title and mastery star
	local bb = Instance.new("BillboardGui")
	bb.Name = "Card"
	bb.Size = UDim2.new(0, 220, 0, 54)
	bb.StudsOffset = Vector3.new(0, 4, 0)
	bb.MaxDistance = 140
	bb.AlwaysOnTop = false
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.GothamBold
	t.TextScaled = true
	t.TextColor3 = Color3.fromHex("#FFE9A8")
	t.TextStrokeTransparency = 0.4
	local banner = Store.byId[l.banner]
	local title = Content.TITLES and Content.TITLES[l.title]
	local stars = l.mastery >= Mastery.MAX and " ✦" or ""
	t.Text = (label and (label .. "  ") or "") .. l.name .. stars .. "\n" .. (title or (banner and banner.name) or f.name)
	t.Parent = bb
	bb.Parent = hrp or m
	m:SetAttribute("Clip", Anim.CLIPS[l.pose] and l.pose or Anim.DEFAULT_POSE)
	m:SetAttribute("Repeat", 9) -- statues re-strike their pose every 9 s
	m.Parent = parent
	CollectionService:AddTag(m, HallService.TAG)
	return m
end

local function clearSpots(folder: Instance)
	for _, d in ipairs(folder:GetChildren()) do
		if d:IsA("Model") and d.Name:sub(1, 7) == "Statue_" then
			d:Destroy()
		end
		local aura = d:FindFirstChild("FadeAura")
		if aura then
			aura:Destroy()
		end
	end
end

-- ===== Victory Podium =====
export type PodiumEntry = { place: number, loadout: Loadout }
function HallService.podium(entries: { PodiumEntry })
	local lb = lobby()
	local vp = lb and lb:FindFirstChild("VictoryPodium")
	if not vp then
		return
	end
	task.spawn(function()
		clearSpots(vp)
		local show = {}
		for _, e in ipairs(entries) do
			local spot = vp:FindFirstChild("Spot" .. e.place) :: BasePart?
			if spot then
				local m = HallService.statue(e.loadout, spot, vp, ({ "🥇", "🥈", "🥉" })[e.place])
				if m then
					table.insert(show, { place = e.place, name = e.loadout.name, clip = m:GetAttribute("Clip"), model = m, skin = e.loadout.skin, fade = e.loadout.fade })
				end
			end
		end
		local cam = vp:FindFirstChild("CameraMark") :: BasePart?
		ctx.pushAll("podiumShow", { entries = show, camera = cam and cam.CFrame or nil, seconds = 6 })
	end)
end

-- ===== Hall of Champions =====
local function weekKey(): string
	return tostring(TimeUtil.week(os.time()))
end

function HallService.recordWin(player: Player)
	local l = HallService.loadoutOf(player)
	if not l then
		return
	end
	-- local fallback list
	for i = #recent, 1, -1 do
		if recent[i].userId == l.userId then
			table.remove(recent, i)
		end
	end
	table.insert(recent, 1, l)
	while #recent > HallService.HALL_SIZE do
		table.remove(recent)
	end
	task.spawn(function()
		if winsStore then
			pcall(function()
				(winsStore :: OrderedDataStore):IncrementAsync(tostring(l.userId), 1)
			end)
		end
		if loadoutStore then
			pcall(function()
				(loadoutStore :: DataStore):SetAsync(tostring(l.userId), l)
			end)
		end
	end)
end

-- Top winners this week with their saved loadouts; falls back to this server's winners.
function HallService.top(): { Loadout }
	local out: { Loadout } = {}
	if winsStore and loadoutStore then
		local ok, page = pcall(function()
			return (winsStore :: OrderedDataStore):GetSortedAsync(false, HallService.HALL_SIZE):GetCurrentPage()
		end)
		if ok and page then
			for _, row in ipairs(page) do
				local okL, l = pcall(function()
					return (loadoutStore :: DataStore):GetAsync(row.key)
				end)
				if okL and type(l) == "table" then
					l.wins = row.value
					table.insert(out, l)
				end
			end
		end
	end
	if #out == 0 then
		for _, l in ipairs(recent) do
			table.insert(out, l)
		end
	end
	return out
end

function HallService.refresh()
	local lb = lobby()
	local hall = lb and lb:FindFirstChild("HallOfChampions")
	if not hall then
		return
	end
	local top = HallService.top()
	clearSpots(hall)
	for k = 1, 5 do
		local spot = hall:FindFirstChild("HallSpot" .. k) :: BasePart?
		local rank: number = spot and tonumber(spot:GetAttribute("Rank")) or 0
		local l = top[rank]
		if spot and l then
			HallService.statue(l, spot, hall, l.wins and ("#" .. rank .. " · " .. tostring(l.wins) .. " wins") or ("#" .. rank))
		end
	end
end

function HallService.init(c: any)
	ctx = c
	local ok = pcall(function()
		winsStore = DataStoreService:GetOrderedDataStore("HallWins_" .. weekKey())
		loadoutStore = DataStoreService:GetDataStore("HallLoadout")
	end)
	if not ok then
		winsStore, loadoutStore = nil, nil
	end
end

function HallService.start()
	task.spawn(function()
		while true do
			pcall(HallService.refresh)
			task.wait(HallService.REFRESH)
			-- roll over to the new week's board on Monday
			pcall(function()
				winsStore = DataStoreService:GetOrderedDataStore("HallWins_" .. weekKey())
			end)
		end
	end)
end

return HallService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">LookService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	LookService — the realism pass at runtime.
	  * Swaps NPC stand-ins for real R15 rigs (Dynamic Head + FACS expression + layered clothing)
	    once their asset IDs are filled in Shared/Look.luau.
	  * Builds Stand-In bodies: a real R15 rig for movement/animation with the realistic
	    part-built body welded on, limb by limb, until real bundles are configured.
	  * Applies PBR MaterialVariants as base-material overrides (when texture IDs are set).
	  * Converts the arena ground to Terrain grass with decoration (animated grass blades).
	  * Nudges player avatar scales toward realistic proportions.
	Everything is pcall-guarded: a missing asset never breaks the match.
]]
local Players = game:GetService("Players")
local MaterialService = game:GetService("MaterialService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Look = require(Shared.Look)
local MapBuilder = require(Shared.MapBuilder) :: any

local LookService = {}

local ENV = {
	Instance = Instance,
	Vector3 = Vector3,
	CFrame = CFrame,
	Color3 = Color3,
	Enum = Enum,
	UDim2 = UDim2,
	NumberSequence = NumberSequence,
	NumberRange = NumberRange,
	ColorSequence = ColorSequence,
	Vector2 = Vector2,
}

local function idList(ids: { number }): string
	local out = {}
	for _, id in ipairs(ids) do
		if id ~= 0 then
			table.insert(out, tostring(id))
		end
	end
	return table.concat(out, ",")
end

local LAYER_TYPES: { [string]: Enum.AccessoryType } = {
	TShirt = Enum.AccessoryType.TShirt,
	Shirt = Enum.AccessoryType.Shirt,
	Jacket = Enum.AccessoryType.Jacket,
	Sweater = Enum.AccessoryType.Sweater,
	Pants = Enum.AccessoryType.Pants,
	Shorts = Enum.AccessoryType.Shorts,
	Shoes = Enum.AccessoryType.LeftShoe,
	DressSkirt = Enum.AccessoryType.DressSkirt,
}

-- A HumanoidDescription from an NPC spec (asset IDs from Look.luau).
local function describe(spec: Look.NpcSpec): HumanoidDescription
	local d = Instance.new("HumanoidDescription")
	local b = spec.body
	d.Head = spec.dynamicHead ~= 0 and spec.dynamicHead or b.head
	d.Torso = b.torso
	d.LeftArm = b.leftArm
	d.RightArm = b.rightArm
	d.LeftLeg = b.leftLeg
	d.RightLeg = b.rightLeg
	d.HairAccessory = idList(spec.hair)
	d.HatAccessory = idList(spec.accessories)
	if spec.idle ~= 0 then
		d.IdleAnimation = spec.idle
	end
	local skin = Color3.fromHex(spec.skin)
	d.HeadColor, d.TorsoColor = skin, skin
	d.LeftArmColor, d.RightArmColor, d.LeftLegColor, d.RightLegColor = skin, skin, skin, skin
	d.HeightScale = spec.scales.height
	d.WidthScale = spec.scales.width
	d.DepthScale = spec.scales.width
	d.HeadScale = spec.scales.head
	d.BodyTypeScale = spec.scales.bodyType
	d.ProportionScale = spec.scales.proportion
	local layered: { any } = {}
	for _, l in ipairs(spec.layered) do
		local t = LAYER_TYPES[l.kind]
		if l.id ~= 0 and t then
			table.insert(layered, { Order = l.order, AssetId = l.id, AccessoryType = t, IsLayered = true })
		end
	end
	if #layered > 0 then
		d:SetAccessories(layered, true)
	end
	return d
end

-- FACS expression on a Dynamic Head.
local function express(model: Model, expr: Look.Expression)
	local head = model:FindFirstChild("Head")
	local fc = head and head:FindFirstChildOfClass("FaceControls")
	if fc then
		for k, v in pairs(expr) do
			pcall(function()
				(fc :: any)[k] = v
			end)
		end
	end
end

-- Replace one part-built NPC with a real rig (only when its spec has a body).
local function upgradeNpc(old: Model)
	local id = old:GetAttribute("LookId")
	local spec = type(id) == "string" and Look.NPCS[id] or nil
	if not spec or not Look.hasBody(spec.body) then
		return
	end
	local ok, rig = pcall(function()
		return Players:CreateHumanoidModelFromDescription(describe(spec), Enum.HumanoidRigType.R15, Enum.AssetTypeVerification.Always)
	end)
	if not ok or not rig then
		warn("[Look] couldn't build", id, rig)
		return
	end
	local hum = rig:FindFirstChildOfClass("Humanoid")
	local root = rig:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hum or not root then
		rig:Destroy()
		return
	end
	local base = old.PrimaryPart and old.PrimaryPart.CFrame or old:GetPivot()
	local box, size = old:GetBoundingBox()
	local floorY = box.Position.Y - size.Y / 2
	root.Anchored = true
	rig.Name = old.Name
	for _, a in ipairs({ "Role", "LookId" }) do
		rig:SetAttribute(a, old:GetAttribute(a))
	end
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	-- keep the name tag and props (Rusty's thermos) from the stand-in
	local tag = old:FindFirstChild("NameTag", true)
	local head = rig:FindFirstChild("Head") :: BasePart?
	if tag and head then
		(tag :: BillboardGui).Adornee = head
		tag.Parent = head
	end
	local thermos = old:FindFirstChild("Thermos") :: BasePart?
	local hand = rig:FindFirstChild("RightHand") :: BasePart?
	rig.Parent = old.Parent
	-- stand on the same spot: the old model's lowest point is the floor
	rig:PivotTo(CFrame.new(base.Position.X, floorY + hum.HipHeight + root.Size.Y / 2, base.Position.Z) * (base - base.Position))
	if thermos and hand then
		for _, n in ipairs({ "Thermos", "ThermosCap" }) do
			local p = old:FindFirstChild(n) :: BasePart?
			if p then
				p.Anchored = false
				p.CFrame = hand.CFrame * CFrame.new(0, -0.2 - (n == "ThermosCap" and -0.45 or 0), -0.1) * CFrame.Angles(0, 0, math.pi / 2)
				local w = Instance.new("WeldConstraint")
				w.Part0 = hand
				w.Part1 = p
				w.Parent = p
				p.Parent = rig
			end
		end
	end
	express(rig, spec.expression)
	old:Destroy()
end

-- Bots: a real R15 rig (moves + animates) wearing either real assets or the realistic
-- part-built body welded on limb by limb.
local SKIN = { "#E2B99A", "#C99A74", "#B07A56", "#8C5A3C", "#5E3C28", "#D8AC8A" }
local CLOTH = { "#4A4D52", "#55504A", "#5E5446", "#3E5458", "#5A3A3A", "#3E4A3A", "#6A5A44", "#2E3036", "#4E5A66", "#6A5640" }
local PANTS = { "#2E3036", "#3A3A3C", "#4E4C46", "#3E3128", "#46423A" }
local HAIR = { "#2A1E16", "#4A3424", "#8A6A44", "#1A1A1A", "#6A3A22", "#7A746A" }

function LookService.standIn(name: string, rng: Random): Model?
	local S = Look.STAND_IN
	local function any(list: { number }): number
		return #list > 0 and list[rng:NextInteger(1, #list)] or 0
	end
	local ok, rig = pcall(function()
		local d = Instance.new("HumanoidDescription")
		local body = #S.bodies > 0 and S.bodies[rng:NextInteger(1, #S.bodies)] or nil
		if body then
			d.Torso, d.LeftArm, d.RightArm, d.LeftLeg, d.RightLeg = body.torso, body.leftArm, body.rightArm, body.leftLeg, body.rightLeg
			d.Head = any(S.dynamicHeads) ~= 0 and any(S.dynamicHeads) or body.head
			d.HairAccessory = tostring(any(S.hair))
			local layered: { any } = {}
			local pools: { { number } } = { S.tops, S.bottoms, S.shoes }
			local kinds: { Enum.AccessoryType } = { Enum.AccessoryType.Jacket, Enum.AccessoryType.Pants, Enum.AccessoryType.LeftShoe }
			for k = 1, 3 do
				local id = any(pools[k])
				if id ~= 0 then
					table.insert(layered, { Order = k, AssetId = id, AccessoryType = kinds[k], IsLayered = true })
				end
			end
			if #layered > 0 then
				d:SetAccessories(layered, true)
			end
		end
		local skin = Color3.fromHex(SKIN[rng:NextInteger(1, #SKIN)])
		d.HeadColor, d.TorsoColor, d.LeftArmColor, d.RightArmColor, d.LeftLegColor, d.RightLegColor = skin, skin, skin, skin, skin, skin
		d.HeightScale = rng:NextNumber(S.scales.height[1], S.scales.height[2])
		d.WidthScale = rng:NextNumber(S.scales.width[1], S.scales.width[2])
		d.DepthScale = d.WidthScale
		d.HeadScale = S.scales.head
		d.BodyTypeScale = S.scales.bodyType
		d.ProportionScale = rng:NextNumber(S.scales.proportion[1], S.scales.proportion[2])
		local m = Players:CreateHumanoidModelFromDescription(d, Enum.HumanoidRigType.R15)
		m:SetAttribute("RealAssets", body ~= nil)
		return m
	end)
	if not ok or not rig then
		return nil
	end
	rig.Name = name
	if rig:GetAttribute("RealAssets") then
		return rig
	end
	-- dress the rig in the realistic part-built body
	local hum = rig:FindFirstChildOfClass("Humanoid")
	local root = rig:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hum or not root then
		return rig
	end
	MapBuilder.setEnv(ENV)
	local hip = hum.HipHeight + root.Size.Y / 2
	local s = math.clamp((hum.HipHeight + 0.2) / 3.0, 0.7, 1.05)
	local feet = root.CFrame * CFrame.new(0, -hip, 0)
	local holder = Instance.new("Folder")
	local body = MapBuilder.npc(holder, "Body", feet, {
		skin = SKIN[rng:NextInteger(1, #SKIN)],
		shirt = CLOTH[rng:NextInteger(1, #CLOTH)],
		pants = PANTS[rng:NextInteger(1, #PANTS)],
		coat = rng:NextNumber() < 0.5 and CLOTH[rng:NextInteger(1, #CLOTH)] or nil,
		hair = HAIR[rng:NextInteger(1, #HAIR)],
		hairStyle = ({ "short", "messy", "long", "bun", "slick", "short" })[rng:NextInteger(1, 6)],
		stubble = rng:NextNumber() < 0.3 and "#3A2E24" or nil,
		boots = rng:NextNumber() < 0.6,
		expr = ({ "neutral", "stern", "wry" })[rng:NextInteger(1, 3)],
		build = ({ "lean", "average", "broad" })[rng:NextInteger(1, 3)],
		scale = s,
	})
	local inv = feet:Inverse()
	for _, p in ipairs(body:GetDescendants()) do
		if p:IsA("BasePart") then
			local lp = inv * p.Position
			local target = rig:FindFirstChild(Look.limbFor(p.Name, lp.X / s, lp.Y / s)) :: BasePart?
			p.Anchored = false
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.Massless = true
			if target then
				local w = Instance.new("WeldConstraint")
				w.Part0 = target
				w.Part1 = p
				w.Parent = p
			end
		end
	end
	for _, p in ipairs(rig:GetDescendants()) do
		if (p:IsA("BasePart") and p.Name ~= "HumanoidRootPart") or p:IsA("Decal") then
			(p :: any).Transparency = 1
		end
	end
	body.PrimaryPart = nil
	body.Parent = rig
	return rig
end

local function applyMaterials()
	for name, v in pairs(Look.MATERIALS) do
		if v.colorMap ~= "" then
			pcall(function()
				local mv = Instance.new("MaterialVariant")
				mv.Name = name
				mv.BaseMaterial = (Enum.Material :: any)[v.base]
				mv.ColorMap = v.colorMap
				mv.NormalMap = v.normalMap
				mv.RoughnessMap = v.roughnessMap
				mv.MetalnessMap = v.metalnessMap
				mv.StudsPerTile = v.studsPerTile
				mv.Parent = MaterialService
				MaterialService:SetBaseMaterialOverride(mv.BaseMaterial, name)
			end)
		end
	end
end

-- Arena ground -> Terrain grass (with animated grass decoration).
local function terrainGround()
	local terrain = workspace.Terrain
	pcall(function()
		terrain.Decoration = true
		for mat, hex in pairs(Look.TERRAIN) do
			terrain:SetMaterialColor((Enum.Material :: any)[mat], Color3.fromHex(hex))
		end
	end)
	local map = workspace:FindFirstChild("Map")
	local ground = map and map:FindFirstChild("Arena") and (map :: any).Arena:FindFirstChild("Ground")
	if not ground then
		return
	end
	local n = 0
	for _, tile in ipairs(ground:GetChildren()) do
		if tile:IsA("BasePart") and tile.Name == "Tile" then
			local mat = tile.Material == Enum.Material.LeafyGrass and Enum.Material.Grass or tile.Material
			local ok = pcall(function()
				terrain:FillBlock(tile.CFrame, tile.Size, mat)
			end)
			if ok then
				tile:Destroy()
			end
			n += 1
			if n % 8 == 0 then
				task.wait()
			end
		end
	end
	-- the meadow and its inner disc become grass too (blades show through)
	local meadow = map and (map :: any).Arena:FindFirstChild("GildedMeadow")
	if meadow then
		for _, nm in ipairs({ "Meadow", "MeadowInner" }) do
			local d = meadow:FindFirstChild(nm) :: BasePart?
			if d then
				d.Transparency = 1
			end
		end
	end
end

local function nudge(player: Player)
	player.CharacterAppearanceLoaded:Connect(function(char: Model)
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum or char:GetAttribute("ScaleNudged") then
			return
		end
		char:SetAttribute("ScaleNudged", true)
		pcall(function()
			local d = hum:GetAppliedDescription()
			local h, w, hd, bt, pr, changed = Look.clampScales(d.HeightScale, d.WidthScale, d.HeadScale, d.BodyTypeScale, d.ProportionScale)
			if changed then
				d.HeightScale, d.WidthScale, d.DepthScale, d.HeadScale, d.BodyTypeScale, d.ProportionScale = h, w, math.max(d.DepthScale, w), hd, bt, pr
				hum:ApplyDescriptionAsync(d)
			end
		end)
	end)
end

function LookService.start()
	applyMaterials()
	local map = workspace:FindFirstChild("Map")
	if map then
		for _, m in ipairs(map:GetDescendants()) do
			if m:IsA("Model") and m:GetAttribute("LookId") then
				upgradeNpc(m)
			end
		end
	end
	if Look.terrainGrass then
		task.spawn(terrainGround)
	end
	if Look.nudgeAvatars then
		Players.PlayerAdded:Connect(nudge)
		for _, p in ipairs(Players:GetPlayers()) do
			nudge(p)
		end
	end
end

return LookService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">MatchService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MatchService — the Jubilee loop, all in one server for v1:
	  Lobby/Queue -> Pregame (reaping cutscene, parade, interview, training; played on clients)
	  -> Launch (10 s frozen on lift plates around the Sundial) -> Arena (12:00 cap)
	  -> Podium -> "Next match in 10s" (auto-queue keeps your play streak going).
	Humans fill first; labeled Stand-In bots fill the rest of the 48 plates.
	Every hit is validated here (range, arc/line of sight, cooldown, ammo, partner + pact immunity).
	v2: pacts with a telegraphed Pact Snap, server-owned stamina + speed check, Food/Water meters,
	the spear throw (bounces off the Veil) and the Veil Breaker finale, the real pregame training
	round, and the Encore top-up so a voted-back contender is paid for their best finish once.
	Knockouts are stylized: the contender lights up gold and dissolves into light. No gore.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local ServerStorage = game:GetService("ServerStorage")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Names = require(Shared.Names)
local Content = require(Shared.Content)
local Veil = require(Shared.Logic.Veil)
local Queue = require(Shared.Logic.Queue)
local Combat = require(Shared.Logic.Combat)
local Loot = require(Shared.Logic.Loot)
local Twists = require(Shared.Logic.Twists)
local NearMiss = require(Shared.Logic.NearMiss)
local TimeUtil = require(Shared.Logic.TimeUtil)
local Pacts = require(Shared.Logic.Pacts)
local Training = require(Shared.Logic.Training)
local Stamina = require(Shared.Logic.Stamina)
local Meters = require(Shared.Logic.Meters)
local Throw = require(Shared.Logic.Throw)
local Store = require(Shared.Store)
local Arms = require(Shared.Arms) :: any
local Mastery = require(Shared.Mastery)
local Offers = require(Shared.Offers)
local Finishers = require(Shared.Finishers)
local Modes = require(Shared.Logic.Modes)
local Party = require(Shared.Logic.Party)
local Onboarding = require(Shared.Logic.Onboarding)
local Events = require(Shared.Logic.Events)
local Moments = require(Shared.Logic.Moments)

-- Globals handed to shared builders (Arms) so the same code runs in Lune tests.
local E = {
	Instance = Instance,
	Vector3 = Vector3,
	CFrame = CFrame,
	Color3 = Color3,
	Enum = Enum,
	UDim2 = UDim2,
	NumberSequence = NumberSequence,
	NumberRange = NumberRange,
	ColorSequence = ColorSequence,
	Vector2 = Vector2,
}

local MatchService = {}
local ctx: any = nil
local rng = Random.new()

export type Contender = {
	id: string,
	kind: string, -- "human" | "bot"
	player: Player?,
	name: string,
	reach: string,
	partner: string?,
	model: Model?,
	pep: number,
	alive: boolean,
	place: number?,
	knocks: number,
	crates: number,
	tokens: number,
	inv: { string },
	slots: number,
	ammo: number,
	equipped: number,
	lastUse: { [string]: number },
	lastHitBy: string?,
	lastHitWeapon: string?,
	lastHitDist: number?,
	encore: boolean,
	slowUntil: number,
	knockedAt: number?,
	awarded: boolean,
	-- v2
	training: number?,
	quip: number?,
	stam: Stamina.S?,
	meters: Meters.M?,
	pactKept: boolean,
	firstResult: any?,
	toppedUp: boolean,
	lastGood: Vector3?,
	speedStrikes: number,
	lastHitBetrayal: boolean,
	-- v5
	veilBreaker: boolean?,
}

MatchService.state = "Lobby"
MatchService.contenders = {} :: { [string]: Contender }
MatchService.order = {} :: { string }
MatchService.radius = Config.Map.ARENA_SIZE / 2
MatchService.t = 0
MatchService.twist = nil :: any
MatchService.weekly = nil :: any
MatchService.hazard = nil :: string?
MatchService.matchNo = 0
MatchService.mode = Modes.get(Modes.JUBILEE) -- v5: Jubilee or Quick Trials, picked per match
MatchService.archive = false -- v5: Founders' Dawn Archive Reel match
MatchService.party = Party.new() -- v5: friend/family parties of up to 10

local queue: { Player } = {}
local queueSince = 0
local forceLaunchAt: number? = nil
local partnerOf: { [Player]: Player } = {}
local invites: { [Player]: Player } = {} -- invitee -> inviter
local byModel: { [Model]: string } = {}
local arenaStart = 0
local phases: { Veil.Phase } = Config.VeilPhases
local veilPanels: { BasePart } = {}
local tokenFolder: Folder? = nil
local hazardState: any = {}
local rustyGiftGiven = false
local stateEndsAt = 0
local pacts = Pacts.new()
local pactsEnded = false
local trainingSeed = 1
local boardSent = false
local pregameStart = 0
local pregameShort = false
local veilShift = 0 -- seconds the Veil clock was paused (Veil Breaker calm)
local calmUntil = 0
local veilCore: BasePart? = nil
local coreAngle = 0
local veilBroken = false
local thrownFolder: Folder? = nil
local veilStepDone = false
local familyPartyAt: { [string]: number } = {} -- contender id -> party id (snapshot at match start)
local STAMINA_RULES: Stamina.Rules = { max = Config.STAMINA_MAX, drain = Config.STAMINA_DRAIN, regen = Config.STAMINA_REGEN, resume = Config.STAMINA_RESUME }

local function now(): number
	return workspace:GetServerTimeNow()
end

local function map(): any
	return workspace:WaitForChild("Map")
end

function MatchService.rootOf(c: Contender): BasePart?
	local m = c.model
	if not m then
		return nil
	end
	return (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart) :: BasePart?
end

function MatchService.contenderOf(player: Player): Contender?
	return MatchService.contenders["u" .. player.UserId]
end

function MatchService.aliveCount(): number
	local n = 0
	for _, c in pairs(MatchService.contenders) do
		if c.alive then
			n += 1
		end
	end
	return n
end

-- Reach partners until the final few, plus pacts.
function MatchService.canHurt(a: Contender, b: Contender): boolean
	if not Combat.canHurt(a.reach, b.reach, MatchService.aliveCount(), Config.ALLIES_UNTIL) then
		return false
	end
	-- v5 Family Rules (private servers, on by default): the whole party is allied until 4 are left
	local pa, pb = familyPartyAt[a.id], familyPartyAt[b.id]
	if pa and pa == pb and MatchService.aliveCount() > Config.ALLIES_UNTIL then
		return false
	end
	return Pacts.canHurt(pacts, a.id, b.id)
end

local function matchHumans(): { Player }
	local out = {}
	for _, c in pairs(MatchService.contenders) do
		if c.player and c.player.Parent then
			table.insert(out, c.player)
		end
	end
	return out
end

local function pushMatch(kind: string, payload: any)
	-- everyone in the server sees the live match (lobby screens + Gallery)
	ctx.pushAll(kind, payload)
end

local function inQueue(p: Player): boolean
	return table.find(queue, p) ~= nil
end

-- ===================== inventory + held item visuals =====================
-- The equipped weapon skin and its Mastery level for a contender (bots use the default look).
local function looksOf(c: Contender, slot: string): (string, number)
	if not c.player then
		return "", 0
	end
	local data = ctx.Progress.dataOf(c.player)
	if not data or not data.equipped then
		return "", 0
	end
	local skin = data.equipped[slot] or ""
	local pts = data.mastery and data.mastery[Mastery.key(slot, skin)] or 0
	return skin, Mastery.level(pts)
end
MatchService.looksOf = looksOf

local function setHeld(c: Contender)
	local m = c.model
	if not m then
		return
	end
	local old = m:FindFirstChild("Held")
	if old then
		old:Destroy()
	end
	local item = c.inv[c.equipped]
	if not item then
		return
	end
	-- v4: weapons are full part-built models per skin (Arms.luau), with Mastery trim on top
	if item == "bow" or item == "spear" or item == "knife" then
		local skin, lvl = looksOf(c, item)
		if Arms.attach(E, m, item, skin, lvl) then
			return
		end
	end
	local hand = (m:FindFirstChild("RightHand") or m:FindFirstChild("Right Arm") or MatchService.rootOf(c)) :: BasePart?
	if not hand then
		return
	end
	local p = Instance.new("Part")
	p.Name = "Held"
	p.CanCollide = false
	p.CanQuery = false
	p.Massless = true
	p.Material = Enum.Material.Wood
	p.Size = Vector3.new(0.8, 0.8, 0.8)
	p.Color = Color3.fromHex("#D4A72C")
	p.Shape = Enum.PartType.Ball
	p.CFrame = hand.CFrame * CFrame.new(0, -0.6, -0.3)
	local w = Instance.new("WeldConstraint")
	w.Part0 = hand
	w.Part1 = p
	w.Parent = p
	p.Parent = m
end

-- Rebuild a player's held weapon (after a Mastery level-up or a Locker change).
function MatchService.refreshHeld(player: Player)
	local c = MatchService.contenderOf(player)
	if c and c.alive then
		setHeld(c)
	end
end

local function pushInv(c: Contender)
	if c.player then
		ctx.push(c.player, "inv", { inv = c.inv, slots = c.slots, ammo = c.ammo, equipped = c.equipped, pep = c.pep })
	end
end

local function pushPact(c: Contender)
	if not c.player then
		return
	end
	local names = {}
	for _, id in ipairs(Pacts.allies(pacts, c.id)) do
		local o = MatchService.contenders[id]
		if o then
			table.insert(names, o.name)
		end
	end
	local o = pacts.offers[c.id]
	local from = o and MatchService.contenders[o.from]
	ctx.push(c.player, "pact", {
		allies = names,
		offer = from and { name = from.name, reach = from.reach } or nil,
		snapping = pacts.snaps[c.id] ~= nil,
		ended = pactsEnded,
	})
end

local function pushPactsAll()
	for _, c in pairs(MatchService.contenders) do
		if c.alive and c.player then
			pushPact(c)
		end
	end
end

local vitalsAt: { [string]: number } = {}
local function pushVitals(c: Contender, force: boolean?)
	local st, m = c.stam, c.meters
	local t = os.clock()
	if not force and (vitalsAt[c.id] or 0) + 0.25 > t then
		return
	end
	vitalsAt[c.id] = t
	if c.player and st and m then
		ctx.push(c.player, "vitals", { stamina = st.value, tired = st.tired, sprinting = st.sprinting, food = m.food, water = m.water })
	end
end

-- Adds an item. Returns false when the backpack is full.
function MatchService.give(c: Contender, item: string): boolean
	local def = Config.Items[item]
	if not def then
		return false
	end
	if def.kind == "ammo" then
		c.ammo += def.ammo or 6
	elseif def.kind == "backpack" then
		c.slots = math.max(c.slots, Config.BACKPACK_SLOTS_BIG)
	else
		if #c.inv >= c.slots then
			return false
		end
		table.insert(c.inv, item)
		if def.kind == "weapon" and item == "bow" then
			c.ammo += 4
		end
		if def.kind == "weapon" and c.player and MatchService.state == "Arena" then
			ctx.Progress.onboard(c.player, "weapon")
		end
		if #c.inv == 1 or (def.kind == "weapon" and not Config.Items[c.inv[c.equipped] or ""]) then
			c.equipped = #c.inv
		end
	end
	setHeld(c)
	pushInv(c)
	return true
end

local function itemName(item: string): string
	local d = Config.Items[item]
	return d and d.name or item
end

-- ===================== damage + knockouts =====================
-- Cosmetic weapon skin color (Item Shop "Arms"). Same stats; only the streak color changes.
local function skinColor(c: Contender, slot: string): string?
	if not c.player then
		return nil
	end
	local data = ctx.Progress.dataOf(c.player)
	local id = data and data.equipped and data.equipped[slot]
	local it = id and Store.byId[id]
	return it and it.color or nil
end

-- Private-server rules (owner with Spire VIP). Public servers always use the seeded twist.
MatchService.psRules = { twist = "", noBetrayals = false, family = true }
local function isPrivate(): boolean
	return game.PrivateServerId ~= "" and game.PrivateServerOwnerId ~= 0
end
MatchService.isPrivate = isPrivate

-- v4: the KNOCKER's fade plays (so a fade is seen by the whole lobby every time it's used);
-- with no knocker (Veil, falls) the victim's own fade plays.
local function fadeOf(c: Contender, by: Contender?): string
	for _, who in ipairs({ by, c }) do
		if who and who.player then
			local data = ctx.Progress.dataOf(who.player)
			if data and data.equipped and Content.FADES[data.equipped.fade] then
				return data.equipped.fade
			end
		end
	end
	return "fade_gold"
end
MatchService.fadeOf = fadeOf

-- The knockout effect: glow, float a little, dissolve with the fade's animated finisher.
local function dissolve(c: Contender, by: Contender?)
	local m = c.model
	if not m then
		return
	end
	local fid = fadeOf(c, by)
	local f = Content.FADES[fid]
	local color = Color3.fromHex(f.color)
	local h = Instance.new("Highlight")
	h.FillColor = color
	h.OutlineColor = Color3.new(1, 1, 1)
	h.FillTransparency = 0.15
	h.Parent = m
	if f.style == "shimmer" then
		TweenService:Create(h, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 6, true), { FillTransparency = 0.7 }):Play()
	end
	local root = MatchService.rootOf(c)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			TweenService:Create(d, TweenInfo.new(1.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }):Play()
		elseif d:IsA("Decal") then
			TweenService:Create(d, TweenInfo.new(1.8), { Transparency = 1 }):Play()
		end
	end
	if root then
		Finishers.play(f.style, root.Position, color)
	end
end

local function toGallery(player: Player)
	task.spawn(function()
		player:LoadCharacterAsync()
		local char = player.Character or player.CharacterAdded:Wait()
		local spawn = map():FindFirstChild("ViewingGallery") and map().ViewingGallery:FindFirstChild("GallerySpawn")
		if spawn then
			char:PivotTo((spawn :: BasePart).CFrame * CFrame.new(rng:NextNumber(-20, 20), 4, rng:NextNumber(-10, 10)))
		end
		ctx.Gallery.addSpectator(player)
	end)
end

local endIfDone: () -> () -- assigned below

-- v5: the one share-worthy moment for a finished contender (or nil), with its launch data.
function MatchService.momentFor(c: Contender): any
	if not c.player then
		return nil
	end
	local best = true
	local pid = Party.partyOf(MatchService.party, c.player.UserId)
	if pid then
		for _, uid in ipairs(MatchService.party.members[pid] or {}) do
			local o = MatchService.contenders["u" .. uid]
			if o and o ~= c and (o.alive or (o.place or 99) < (c.place or 99)) then
				best = false
			end
		end
	else
		best = false
	end
	local m = Moments.pick({
		place = c.place or 99,
		knocks = c.knocks,
		veilBreaker = c.veilBreaker,
		encoreWon = c.encore and (c.place or 99) <= 5,
		archive = MatchService.archive,
		partyBest = best and MatchService.state == "Podium",
	})
	if not m then
		return nil
	end
	return { id = m.id, title = m.title, caption = m.caption, launch = Moments.launchData(c.player.UserId, m.id), place = c.place, knocks = c.knocks }
end

-- v5: one results card per party that played: everyone's place and the party's total knockouts.
function MatchService.sendPartyCards()
	local seen: { [number]: boolean } = {}
	for _, c in pairs(MatchService.contenders) do
		local pl = c.player
		local pid = pl and Party.partyOf(MatchService.party, pl.UserId)
		if pid and not seen[pid] then
			seen[pid] = true
			local lines = {}
			local who = {}
			for _, uid in ipairs(MatchService.party.members[pid] or {}) do
				local o = MatchService.contenders["u" .. uid]
				if o and o.player then
					table.insert(lines, { name = o.name, place = o.place or 99, knocks = o.knocks })
					table.insert(who, o.player)
				end
			end
			if #lines >= 2 then
				local sum = Party.summary(lines)
				for _, p in ipairs(who) do
					if p.Parent then
						ctx.push(p, "partyCard", { lines = sum.lines, knocks = sum.knocks, best = sum.best and sum.best.name or "" })
					end
				end
			end
		end
	end
end

function MatchService.knockout(c: Contender, cause: string)
	if not c.alive then
		return
	end
	local place = MatchService.aliveCount()
	c.alive = false
	c.place = place
	c.knockedAt = now()
	local wasAllies = Pacts.allies(pacts, c.id)
	Pacts.remove(pacts, c.id)
	for _, id in ipairs(wasAllies) do
		local a = MatchService.contenders[id]
		if a then
			pushPact(a)
		end
	end
	local attacker = c.lastHitBy and MatchService.contenders[c.lastHitBy] or nil
	if attacker and attacker ~= c then
		attacker.knocks += 1
		if attacker.player then
			ctx.Progress.bump(attacker.player, "knocks", 1)
			if c.lastHitWeapon == "bow" then
				ctx.Progress.bump(attacker.player, "bowknocks", 1)
			end
			local wpn = c.lastHitWeapon
			if wpn == "bow" or wpn == "spear" or wpn == "knife" then
				local skin = select(1, looksOf(attacker, wpn))
				ctx.Progress.addMastery(attacker.player, wpn, skin, Mastery.PER_KNOCK)
			end
			ctx.push(attacker.player, "knocked", { name = c.name, reach = c.reach, left = place - 1 })
		end
	end
	dissolve(c, attacker)
	local byStars = ""
	if attacker and c.lastHitWeapon then
		local _, lvl = looksOf(attacker, c.lastHitWeapon)
		byStars = lvl >= Mastery.MAX and "✦" or string.rep("★", lvl)
	end
	pushMatch("feed", {
		victim = c.name,
		by = attacker and attacker.name or nil,
		byStars = byStars ~= "" and byStars or nil,
		fade = attacker and attacker.player and fadeOf(c, attacker) or nil,
		fadeColor = attacker and attacker.player and Content.FADES[fadeOf(c, attacker)].color or nil,
		cause = cause,
		weapon = c.lastHitWeapon,
		left = place - 1,
	})
	local root = MatchService.rootOf(c)
	if c.player then
		local player = c.player
		-- "How you got tapped": a kill-cam replay of the last hit + the near-miss card
		local aroot = attacker and MatchService.rootOf(attacker) or nil
		local leader: Contender? = nil
		for _, o in pairs(MatchService.contenders) do
			if o.alive and (leader == nil or o.pep > leader.pep) then
				leader = o
			end
		end
		local r = {
			place = place,
			size = Config.MATCH_SIZE,
			knocks = c.knocks,
			crates = c.crates,
			tokens = c.tokens,
			gifts = 0,
			votes = 0,
			encore = c.encore,
			survived = MatchService.t,
			partner = c.partner ~= nil and string.sub(c.partner, 1, 1) == "u",
			bonusStars = Twists.mod({ MatchService.weekly }, "bonusStars", 0),
			pactKept = c.pactKept,
			archive = MatchService.archive,
		}
		local result: any
		if c.awarded and c.firstResult then
			-- knocked out again after an Encore: pay only the difference
			result = ctx.Progress.topUp(player, c.firstResult, r)
			c.toppedUp = true
		else
			result = ctx.Progress.award(player, r)
			c.firstResult = r
		end
		c.awarded = true
		local data = ctx.Progress.dataOf(player)
		local nm = {
			place = place,
			size = Config.MATCH_SIZE,
			knocks = c.knocks,
			survived = MatchService.t,
			bestPlace = result.prevBest or 0,
			nextKnockGoal = ctx.Progress.nextGoal(player, "knocks"),
			winnerPepLeft = place == 2 and leader and leader.pep or nil,
		}
		ctx.push(player, "eliminated", {
			headline = NearMiss.headline(nm),
			lines = NearMiss.lines(nm),
			cause = cause,
			by = attacker and attacker.name or nil,
			byReach = attacker and attacker.reach or nil,
			byPep = attacker and attacker.pep or nil,
			weapon = c.lastHitWeapon and itemName(c.lastHitWeapon) or nil,
			dist = c.lastHitDist,
			from = aroot and aroot.Position or nil,
			at = root and root.Position or nil,
			byModel = attacker and attacker.model or nil,
			betrayed = c.lastHitBetrayal,
			place = place,
			result = result,
			autoQueue = data and data.settings.autoQueue or false,
			preview = ctx.Purchase.previewFor(player, c.knocks),
			moment = MatchService.momentFor(c),
		})
		task.delay(3.2, function()
			if player.Parent then
				toGallery(player)
			end
		end)
	else
		local m = c.model
		task.delay(2.5, function()
			if m then
				byModel[m] = nil
				m:Destroy()
			end
		end)
		c.model = nil
	end
	endIfDone()
end

function MatchService.damage(target: Contender, amount: number, attacker: Contender?, weapon: string, dist: number?)
	if not target.alive or MatchService.state ~= "Arena" then
		return
	end
	if attacker and attacker ~= target then
		if not attacker.alive then
			return
		end
		if not MatchService.canHurt(attacker, target) then
			return
		end
		local mult, strike = Pacts.hitMult(pacts, Config.Pacts, attacker.id, target.id, now())
		-- v5: Stand-In bots go easier on a contender's first 3 matches (never real players)
		if attacker.kind == "bot" and target.player then
			local td = ctx.Progress.dataOf(target.player)
			mult *= Onboarding.botDamageMult(td and td.stats.matches or 0)
		end
		amount = math.max(1, math.floor(amount * mult + 0.5))
		target.lastHitBetrayal = strike
		if strike then
			-- the betrayal moment: everyone sees it, the victim gets a beat to react
			pushMatch("feed", { kind = "betrayal", victim = target.name, by = attacker.name, left = MatchService.aliveCount() })
			if target.player then
				ctx.push(target.player, "betrayed", { by = attacker.name, line = Content.RUSTY.snapped })
			end
		end
		target.lastHitBy = attacker.id
		target.lastHitWeapon = weapon
		target.lastHitDist = dist
		if attacker.player then
			ctx.push(attacker.player, "hitmark", { amount = amount, name = target.name })
		end
	elseif weapon == "veil" or weapon == "finches" or weapon == "bloom" then
		if weapon == "veil" and now() < calmUntil then
			return
		end
		target.lastHitWeapon = weapon
		target.lastHitBetrayal = false
	end
	local pep, ko = Combat.hit(target.pep, amount)
	target.pep = pep
	if target.player then
		ctx.push(target.player, "pep", { pep = pep, from = weapon })
	end
	if ko then
		local cause = weapon
		if weapon == "veil" then
			cause = "touched " .. Names.VEIL
		elseif weapon == "finches" then
			cause = "chased by " .. Names.FINCHES
		elseif weapon == "bloom" then
			cause = "caught in the " .. Names.BLOOM
		end
		MatchService.knockout(target, cause)
	end
end

-- ===================== attacks (humans via the "use" action, bots via BotService) =====================
function MatchService.attack(c: Contender, wid: string, aim: Vector3?): boolean
	local w = Config.Weapons[wid]
	if not w or not c.alive or MatchService.state ~= "Arena" then
		return false
	end
	local t = now()
	if not Combat.ready(c.lastUse[wid], t, w.cooldown) then
		return false
	end
	local root = MatchService.rootOf(c)
	if not root then
		return false
	end
	c.lastUse[wid] = t
	local mult = c.kind == "bot" and Config.Bots.damageMult or 1
	if w.kind == "ranged" then
		if c.ammo <= 0 then
			if c.player then
				ctx.toast(c.player, "Out of arrows! Find a crate or ask the Gallery.", "info")
			end
			return false
		end
		c.ammo -= 1
		local range = w.range * Twists.mod({ MatchService.twist }, "bowRange", 1)
		local origin = root.Position + Vector3.new(0, 1.6, 0)
		local target = aim or (origin + root.CFrame.LookVector * range)
		local dir = target - origin
		if dir.Magnitude < 0.1 then
			dir = root.CFrame.LookVector
		end
		dir = dir.Unit * range
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { c.model :: any, map().Arena.Veil }
		local hit = workspace:Raycast(origin, dir, params)
		local to = hit and hit.Position or (origin + dir)
		pushMatch("tracer", { from = origin, to = to, color = skinColor(c, "bow"), bright = select(2, looksOf(c, "bow")) >= 2 })
		if hit then
			local m = hit.Instance:FindFirstAncestorOfClass("Model")
			while m and not byModel[m] do
				m = m:FindFirstAncestorOfClass("Model")
			end
			local id = m and byModel[m]
			local victim = id and MatchService.contenders[id]
			if victim and victim ~= c then
				local d = (to - origin).Magnitude
				MatchService.damage(victim, math.floor(Combat.bowDamage(w.damage, d, range) * mult + 0.5), c, wid, math.floor(d))
			end
		end
		pushInv(c)
		return true
	end
	-- melee: nearest valid target in the arc in front
	local look = root.CFrame.LookVector
	if aim then
		local d = aim - root.Position
		if Vector3.new(d.X, 0, d.Z).Magnitude > 0.5 then
			look = d.Unit
		end
	end
	local best: Contender? = nil
	local bestD = math.huge
	for _, o in pairs(MatchService.contenders) do
		if o ~= c and o.alive then
			local orr = MatchService.rootOf(o)
			if orr then
				local d = (orr.Position - root.Position).Magnitude
				if d <= w.range + 2 and d < bestD then
					local a = root.Position
					local b = orr.Position
					if Combat.inArc({ x = a.X, y = a.Y, z = a.Z }, { x = look.X, y = 0, z = look.Z }, { x = b.X, y = b.Y, z = b.Z }, w.arc or 70) then
						best, bestD = o, d
					end
				end
			end
		end
	end
	pushMatch("swing", { id = c.id, weapon = wid, at = root.Position })
	if best then
		MatchService.damage(best, math.floor(w.damage * mult + 0.5), c, wid, math.floor(bestD))
	end
	return true
end

function MatchService.eat(c: Contender, slot: number): boolean
	local item = c.inv[slot]
	local def = item and Config.Items[item]
	if not def or def.kind ~= "snack" then
		return false
	end
	table.remove(c.inv, slot)
	c.equipped = math.clamp(c.equipped, 1, math.max(1, #c.inv))
	c.pep = math.min(Config.PEP_MAX, c.pep + (def.heal or 0))
	if c.stam and def.stamina then
		Stamina.add(c.stam, STAMINA_RULES, def.stamina)
	end
	if c.meters then
		Meters.eat(c.meters, Config.Meters, def.food, def.water)
	end
	pushVitals(c)
	if c.player then
		ctx.Progress.onboard(c.player, "eat")
		ctx.Progress.bump(c.player, "snacks", 1)
		ctx.push(c.player, "pep", { pep = c.pep, from = "snack" })
	end
	setHeld(c)
	pushInv(c)
	return true
end

-- Use the equipped slot: weapon -> attack, snack -> eat, nothing -> shove.
function MatchService.use(c: Contender, aim: Vector3?): boolean
	local item = c.inv[c.equipped]
	local def = item and Config.Items[item]
	if def and def.kind == "weapon" and def.weapon then
		return MatchService.attack(c, def.weapon, aim)
	elseif def and def.kind == "snack" then
		return MatchService.eat(c, c.equipped)
	end
	return MatchService.attack(c, "shove", aim)
end

-- ===================== spear throw + Veil Breaker =====================
local function placeCore()
	local core = veilCore
	if not core then
		return
	end
	local r = math.max(MatchService.radius - 1, 4)
	local pos = Vector3.new(math.cos(coreAngle) * r, 14, math.sin(coreAngle) * r)
	core.CFrame = CFrame.lookAt(pos, Vector3.new(0, 14, 0))
end

-- Final four: the Veil Core lights up on the wall.
local function lightCore()
	if veilCore or veilBroken then
		return
	end
	coreAngle = rng:NextNumber(0, math.pi * 2)
	local core = Instance.new("Part")
	core.Name = "VeilCore"
	core.Anchored = true
	core.CanCollide = false
	core.Shape = Enum.PartType.Ball
	core.Material = Enum.Material.Neon
	core.Color = Color3.fromHex("#9FF6FF")
	local sz = Config.VeilBreaker.coreSize
	core.Size = Vector3.new(sz, sz, sz)
	local light = Instance.new("PointLight")
	light.Color = core.Color
	light.Range = 40
	light.Brightness = 3
	light.Parent = core
	core.Parent = workspace
	veilCore = core
	placeCore()
	pushMatch("veilCore", { pos = core.Position })
end

local function breakVeil(by: Contender)
	if veilBroken then
		return
	end
	veilBroken = true
	calmUntil = now() + Config.VeilBreaker.calmSeconds
	stateEndsAt += Config.VeilBreaker.calmSeconds
	if veilCore then
		veilCore:Destroy()
		veilCore = nil
	end
	for _, p in ipairs(veilPanels) do
		p.Transparency = 0.7
	end
	by.veilBreaker = true
	pushMatch("veilBroken", { by = by.name, reach = by.reach, seconds = Config.VeilBreaker.calmSeconds })
	if by.player then
		ctx.Progress.grant(by.player, Config.VeilBreaker.title, "You shattered the dome! Title unlocked: " .. tostring(Content.TITLES[Config.VeilBreaker.title]))
		ctx.Progress.bump(by.player, "veilbreak", 1)
	end
end

-- The thrown spear lands as a pickup anyone can grab.
local function dropSpear(at: Vector3)
	if not thrownFolder then
		local f = Instance.new("Folder")
		f.Name = "ThrownSpears"
		f.Parent = workspace
		thrownFolder = f
	end
	local p = Instance.new("Part")
	p.Name = "ThrownSpear"
	p.Anchored = true
	p.CanCollide = false
	p.Size = Vector3.new(0.3, 7, 0.3)
	p.Color = Color3.fromHex("#8A6A3A")
	p.Material = Enum.Material.Wood
	p.CFrame = CFrame.new(at + Vector3.new(0, 2.5, 0)) * CFrame.Angles(math.rad(25), 0, 0)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = "Pick up"
	pp.ObjectText = "Spear"
	pp.MaxActivationDistance = 10
	pp.Parent = p
	pp.Triggered:Connect(function(player: Player)
		local c = MatchService.contenderOf(player)
		if c and c.alive and p.Parent and MatchService.give(c, "spear") then
			p:Destroy()
		end
	end)
	p.Parent = thrownFolder
end

-- Throw the equipped spear. It flies flat, bounces off the Veil once, and hits the first
-- contender on its path. A bounced spear that crosses the lit Veil Core breaks the dome.
function MatchService.throw(c: Contender, aim: Vector3?): boolean
	local w = Config.Weapons.spearThrow
	if not c.alive or MatchService.state ~= "Arena" or c.inv[c.equipped] ~= "spear" then
		return false
	end
	local t = now()
	if not Combat.ready(c.lastUse.spearThrow, t, w.cooldown) then
		return false
	end
	local root = MatchService.rootOf(c)
	if not root then
		return false
	end
	c.lastUse.spearThrow = t
	table.remove(c.inv, c.equipped)
	c.equipped = math.clamp(c.equipped, 1, math.max(1, #c.inv))
	setHeld(c)
	pushInv(c)
	local origin = root.Position + Vector3.new(0, 1.6, 0)
	local dir = (aim and (aim - origin) or root.CFrame.LookVector)
	local legs = Throw.legs({ x = origin.X, z = origin.Z }, { x = dir.X, z = dir.Z }, w.range, MatchService.radius, Config.VeilBreaker.bounces)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { c.model :: any, map().Arena.Veil }
	local mult = c.kind == "bot" and Config.Bots.damageMult or 1
	local landed = origin
	for _, leg in ipairs(legs) do
		local a = Vector3.new(leg.from.x, origin.Y, leg.from.z)
		local b = Vector3.new(leg.to.x, origin.Y, leg.to.z)
		local hit = workspace:Raycast(a, b - a, params)
		local stop = hit and hit.Position or b
		pushMatch("tracer", { from = a, to = stop, spear = true, color = skinColor(c, "spear"), bright = select(2, looksOf(c, "spear")) >= 2 })
		-- Veil Breaker: only a rebounded spear counts
		local core = veilCore
		if leg.bounced and core and Throw.segDist(leg.from, { x = stop.X, z = stop.Z }, { x = core.Position.X, z = core.Position.Z }) <= Config.VeilBreaker.coreSize * 0.6 then
			breakVeil(c)
		end
		landed = stop
		if hit then
			local m = hit.Instance:FindFirstAncestorOfClass("Model")
			while m and not byModel[m] do
				m = m:FindFirstAncestorOfClass("Model")
			end
			local id = m and byModel[m]
			local victim = id and MatchService.contenders[id]
			if victim and victim ~= c then
				MatchService.damage(victim, math.floor(w.damage * mult + 0.5), c, "spear", math.floor((stop - origin).Magnitude))
			end
			break
		end
	end
	dropSpear(Vector3.new(landed.X, 0, landed.Z))
	return true
end

-- ===================== crates + tokens =====================
local function lootTable(kind: string): { [string]: number }
	local t: { [string]: number } = Config.LootField
	if kind == "hub" then
		t = Config.LootHub
	elseif kind == "meadow" then
		t = Config.LootMeadow
	end
	local snacks = Twists.mod({ MatchService.twist }, "snacks", 1)
	if snacks == 1 then
		return t
	end
	local out: { [string]: number } = {}
	for k, v in pairs(t) do
		local d = Config.Items[k]
		out[k] = (d and d.kind == "snack") and v * snacks or v
	end
	return out
end

function MatchService.openCrate(c: Contender, crate: BasePart): boolean
	if MatchService.state ~= "Arena" or not c.alive or crate:GetAttribute("Opened") then
		return false
	end
	local root = MatchService.rootOf(c)
	if not root or (root.Position - crate.Position).Magnitude > 14 then
		return false
	end
	local kind = tostring(crate:GetAttribute("Loot") or "field")
	local item = Loot.pick(lootTable(kind), rng:NextNumber())
	if not MatchService.give(c, item) then
		if c.player then
			ctx.toast(c.player, "Backpack full! Drop or eat something first.", "info")
		end
		return false
	end
	crate:SetAttribute("Opened", true)
	crate.Transparency = 0.7
	local pp = crate:FindFirstChildOfClass("ProximityPrompt")
	if pp then
		pp.Enabled = false
	end
	c.crates += 1
	if c.player then
		ctx.Progress.onboard(c.player, "crate")
		ctx.Progress.bump(c.player, "crates", 1)
		if kind == "hub" then
			ctx.Progress.bump(c.player, "hubloot", 1)
		elseif kind == "meadow" then
			ctx.Progress.bump(c.player, "meadow", 1)
		end
		ctx.push(c.player, "loot", { item = item, name = itemName(item) })
	end
	return true
end

local function allCrates(): { BasePart }
	local out = {}
	for _, f in ipairs({ "HubCrates", "FieldCrates", "MeadowCrates" }) do
		local folder = map().Arena:FindFirstChild(f)
		if folder then
			for _, p in ipairs(folder:GetChildren()) do
				if p:IsA("BasePart") and p:GetAttribute("Crate") then
					table.insert(out, p)
				end
			end
		end
	end
	return out
end
MatchService.allCrates = allCrates

local function resetCrates()
	for _, p in ipairs(allCrates()) do
		p:SetAttribute("Opened", nil)
		p.Transparency = 0
		local pp = p:FindFirstChildOfClass("ProximityPrompt")
		if pp then
			pp.Enabled = true
		end
	end
end

local function spawnTokens()
	if tokenFolder then
		tokenFolder:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = "Tokens"
	f.Parent = map().Arena
	tokenFolder = f
	local spots = map().Arena.TokenSpots:GetChildren()
	local n = math.floor(Twists.mod({ MatchService.weekly }, "tokens", Config.TOKENS_PER_MATCH))
	local template = (ServerStorage:FindFirstChild("Templates") :: any).Token
	for _ = 1, math.min(n, #spots) do
		local i = rng:NextInteger(1, #spots)
		local spot = table.remove(spots, i) :: BasePart
		local idx = spot:GetAttribute("TokenIndex") :: number
		local def = Content.TOKENS[idx]
		local tk = template:Clone()
		tk:PivotTo(spot.CFrame * CFrame.Angles(0, 0, math.pi / 2))
		local coin = tk.PrimaryPart :: BasePart
		coin.Anchored = true
		coin.CanTouch = true
		coin.Size = Vector3.new(0.6, 3.2, 3.2)
		local light = Instance.new("PointLight")
		light.Color = Color3.fromHex("#FFD36B")
		light.Range = 14
		light.Parent = coin
		tk:SetAttribute("TokenId", def.id)
		tk.Parent = f
		local taken = false
		coin.Touched:Connect(function(hit: BasePart)
			if taken then
				return
			end
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			local c = player and MatchService.contenderOf(player)
			if not player or not c or not c.alive then
				return
			end
			taken = true
			tk:Destroy()
			c.tokens += 1
			local data = ctx.Progress.dataOf(player)
			local isNew = data and not data.tokens[def.id]
			if data then
				data.tokens[def.id] = true
			end
			ctx.Progress.bump(player, "tokens", 1)
			ctx.push(player, "token", { name = def.name, new = isNew })
		end)
	end
end

-- ===================== Veil + hazards =====================
local function setVeil(radius: number)
	MatchService.radius = radius
	local n = #veilPanels
	if n == 0 then
		return
	end
	local r = math.max(radius, 2)
	local w = 2 * math.pi * r / n * 1.06
	for i, p in ipairs(veilPanels) do
		local a = (i - 0.5) / n * math.pi * 2
		local pos = Vector3.new(math.cos(a) * r, 300, math.sin(a) * r)
		p.Size = Vector3.new(math.max(w, 0.5), 640, 1)
		p.CFrame = CFrame.lookAt(pos, Vector3.new(0, 300, 0))
		p.Transparency = radius <= 1 and 1 or (if now() < calmUntil then 0.7 else 0.1)
	end
	placeCore()
end

function MatchService.startHazard(id: string)
	if MatchService.state ~= "Arena" then
		return
	end
	local H = Config.Hazards
	if id == "supply" then
		for _ = 1, H.supply.crates do
			local a = rng:NextNumber(0, math.pi * 2)
			local r = rng:NextNumber(20, math.min(200, MatchService.radius * 0.6))
			ctx.Gallery.dropCrate(Vector3.new(math.cos(a) * r, 0, math.sin(a) * r))
		end
		pushMatch("hazard", { id = id, name = "Supply Drop", text = "Three parachute crates are falling near " .. Names.HUB .. "!" })
		return
	end
	if hazardState[id] then
		return
	end
	if id == "finches" then
		-- target the biggest group of alive contenders
		local best: Contender? = nil
		local bestN = -1
		for _, c in pairs(MatchService.contenders) do
			local r = if c.alive then MatchService.rootOf(c) else nil
			if r then
				local n = 0
				for _, o in pairs(MatchService.contenders) do
					local orr = if o.alive then MatchService.rootOf(o) else nil
					if orr and (orr.Position - r.Position).Magnitude < 80 then
						n += 1
					end
				end
				if n > bestN then
					best, bestN = c, n
				end
			end
		end
		local target = best and MatchService.rootOf(best)
		if not target then
			return
		end
		local center = target.Position + Vector3.new(rng:NextNumber(-60, 60), 0, rng:NextNumber(-60, 60))
		local folder = Instance.new("Folder")
		folder.Name = "Candyfinches"
		folder.Parent = workspace
		local template = (ServerStorage:FindFirstChild("Templates") :: any).Candyfinch
		local birds = {}
		for i = 1, H.finches.birds do
			local b = template:Clone()
			b:SetAttribute("Phase", i / H.finches.birds * math.pi * 2)
			b.Parent = folder
			table.insert(birds, b)
		end
		hazardState.finches = { center = center, target = best and best.id, untilT = now() + H.finches.warn + H.finches.duration, startT = now() + H.finches.warn, folder = folder, birds = birds }
		pushMatch("hazard", { id = id, name = Names.FINCHES, text = "A sugary flock is coming! Spread out.", warn = H.finches.warn, at = center })
	elseif id == "bloom" then
		hazardState.bloom = { untilT = now() + H.bloom.warn + H.bloom.duration, startT = now() + H.bloom.warn }
		for _, e in ipairs(map().Arena.GildedMeadow:GetChildren()) do
			local pe = e:FindFirstChild("Pollen")
			if pe then
				(pe :: ParticleEmitter).Enabled = true
			end
		end
		pushMatch("hazard", { id = id, name = Names.BLOOM, text = "Gilded pollen is rising in " .. Names.MEADOW .. ". Get out!", warn = H.bloom.warn })
	end
end

local function stopHazards()
	local f = hazardState.finches
	if f and f.folder then
		f.folder:Destroy()
	end
	hazardState = {}
	local ok, meadow = pcall(function()
		return map().Arena.GildedMeadow
	end)
	if ok and meadow then
		for _, e in ipairs(meadow:GetChildren()) do
			local pe = e:FindFirstChild("Pollen")
			if pe then
				(pe :: ParticleEmitter).Enabled = false
			end
		end
	end
end

local lastSecond = 0
local function tickHazards(dt: number, wholeSecond: boolean)
	local t = now()
	local H = Config.Hazards
	local f = hazardState.finches
	if f then
		if t > f.untilT then
			f.folder:Destroy()
			hazardState.finches = nil
		else
			local tgt = f.target and MatchService.contenders[f.target]
			local tr = tgt and if tgt.alive then MatchService.rootOf(tgt) else nil
			if t >= f.startT and tr then
				local d = tr.Position - f.center
				local step = math.min(d.Magnitude, H.finches.speed * dt)
				if d.Magnitude > 0.1 then
					f.center += d.Unit * step
				end
			end
			for i, b in ipairs(f.birds) do
				local ph = (b:GetAttribute("Phase") or i) + t * 3
				local r = H.finches.radius * 0.6
				local pos = f.center + Vector3.new(math.cos(ph) * r, 8 + math.sin(ph * 2) * 3, math.sin(ph) * r)
				b:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(-math.sin(ph), 0, math.cos(ph))))
			end
			if wholeSecond and t >= f.startT then
				for _, c in pairs(MatchService.contenders) do
					local r = if c.alive then MatchService.rootOf(c) else nil
					if r and (Vector3.new(r.Position.X, 0, r.Position.Z) - Vector3.new(f.center.X, 0, f.center.Z)).Magnitude < H.finches.radius then
						MatchService.damage(c, H.finches.dps, nil, "finches", nil)
					end
				end
			end
		end
	end
	local b = hazardState.bloom
	if b then
		if t > b.untilT then
			stopHazards()
		elseif t >= b.startT then
			local M = Config.Map.MEADOW
			for _, c in pairs(MatchService.contenders) do
				local r = if c.alive then MatchService.rootOf(c) else nil
				if r then
					local dx, dz = r.Position.X - M.x, r.Position.Z - M.z
					if dx * dx + dz * dz < M.r * M.r then
						c.slowUntil = t + 1.2
						if wholeSecond then
							MatchService.damage(c, H.bloom.dps, nil, "bloom", nil)
						end
					end
				end
			end
		end
	end
end

-- ===================== state machine =====================
local function clearArena()
	stopHazards()
	for _, c in pairs(MatchService.contenders) do
		if c.kind == "bot" and c.model then
			c.model:Destroy()
		end
	end
	byModel = {}
	MatchService.contenders = {}
	MatchService.order = {}
	if tokenFolder then
		tokenFolder:Destroy()
		tokenFolder = nil
	end
	if veilCore then
		veilCore:Destroy()
		veilCore = nil
	end
	if thrownFolder then
		thrownFolder:Destroy()
		thrownFolder = nil
	end
	pacts = Pacts.new()
	pactsEnded = false
	veilBroken = false
	calmUntil = 0
	veilShift = 0
	resetCrates()
	setVeil(Config.Map.ARENA_SIZE / 2)
	Lighting.ClockTime = 6.4
	workspace.Gravity = 196.2
end

local function lobbyStatus()
	local humans = #queue
	local waited = now() - queueSince
	local secs = Queue.secondsLeft(humans, waited, Config.MATCH_SIZE, Config.Matchmaking, not Config.Matchmaking.crossServer)
	if forceLaunchAt and humans > 0 then
		secs = math.max(0, forceLaunchAt - now())
	end
	for _, p in ipairs(Players:GetPlayers()) do
		local partner = partnerOf[p]
		ctx.push(p, "lobby", {
			state = MatchService.state,
			queued = humans,
			size = Config.MATCH_SIZE,
			seconds = secs,
			inQueue = inQueue(p),
			partner = partner and partner.DisplayName or nil,
			invite = invites[p] and invites[p].DisplayName or nil,
			inviteFrom = invites[p] and invites[p].UserId or nil,
			weekly = MatchService.weekly,
			alive = MatchService.state == "Arena" and MatchService.aliveCount() or nil,
			t = MatchService.t,
		})
	end
end

local function startPregame()
	MatchService.matchNo += 1
	local wk = TimeUtil.week(os.time())
	MatchService.weekly = Twists.weekly(wk)
	MatchService.twist = Twists.forMatch(MatchService.matchNo, wk)
	if isPrivate() and MatchService.psRules.twist ~= "" then
		for _, t in ipairs(Twists.MATCH) do
			if t.id == MatchService.psRules.twist then
				MatchService.twist = t
			end
		end
	end
	-- v5: parties are never split: a party goes in whole or waits for the next match
	local ids = {}
	local byUser: { [number]: Player } = {}
	for _, p in ipairs(queue) do
		if p.Parent then
			table.insert(ids, p.UserId)
			byUser[p.UserId] = p
		end
	end
	local humans = {}
	for _, uid in ipairs(Party.fill(MatchService.party, ids, Config.MATCH_SIZE)) do
		table.insert(humans, byUser[uid])
	end
	local left = {}
	for _, p in ipairs(queue) do
		if p.Parent and not table.find(humans, p) then
			table.insert(left, p)
		end
	end
	queue = left
	if #left > 0 then
		queueSince = now()
	end
	forceLaunchAt = nil
	-- v5: Quick Trials or the full Jubilee, by majority of the queued players' picks
	local prefs = {}
	for _, p in ipairs(humans) do
		local d = ctx.Progress.dataOf(p)
		table.insert(prefs, Modes.preferred(d and d.settings.mode or "", d and d.stats.matches or 0))
	end
	MatchService.mode = Modes.get(Modes.pick(prefs))
	local fest = Events.active(os.time())
	MatchService.archive = fest ~= nil and fest.id == "founders_dawn" and Events.isArchiveMatch(MatchService.matchNo)
	familyPartyAt = {}
	if isPrivate() and MatchService.psRules.family then
		for _, p in ipairs(humans) do
			local pid = Party.partyOf(MatchService.party, p.UserId)
			if pid then
				familyPartyAt["u" .. p.UserId] = pid
			end
		end
	end
	local entries = {}
	local byId: { [string]: Player } = {}
	for _, p in ipairs(humans) do
		local data = ctx.Progress.dataOf(p)
		local partner = partnerOf[p]
		local id = "u" .. p.UserId
		byId[id] = p
		table.insert(entries, {
			id = id,
			reach = data and data.reach ~= "" and data.reach or nil,
			partner = partner and table.find(humans, partner) and ("u" .. partner.UserId) or nil,
		})
	end
	local botIds = {}
	for i = 1, Config.MATCH_SIZE - #humans do
		table.insert(botIds, "b" .. i)
	end
	local slots = Queue.assign(entries, botIds, Names.REACH_LIST, Config.PER_REACH)
	local names = table.clone(Content.BOT_NAMES)
	MatchService.contenders = {}
	MatchService.order = {}
	for _, s in ipairs(slots) do
		local p = byId[s.id]
		local nm: string
		if p then
			nm = p.DisplayName
		else
			nm = table.remove(names, rng:NextInteger(1, #names)) or "Rowan"
			if MatchService.archive and s.id == botIds[1] then
				nm = "Young " .. Names.MENTOR_SHORT -- the Archive Reel: Rusty's own Trials, 25 years ago
			end
		end
		MatchService.contenders[s.id] = {
			id = s.id,
			kind = p and "human" or "bot",
			player = p,
			name = p and nm or (Names.BOT_TAG .. " · " .. nm),
			reach = s.reach,
			partner = s.partner,
			model = nil,
			pep = Config.PEP_MAX,
			alive = true,
			place = nil,
			knocks = 0,
			crates = 0,
			tokens = 0,
			inv = {},
			slots = Config.BACKPACK_SLOTS,
			ammo = 0,
			equipped = 1,
			lastUse = {},
			encore = false,
			slowUntil = 0,
			awarded = false,
			pactKept = false,
			toppedUp = false,
			speedStrikes = 0,
			lastHitBetrayal = false,
		}
		table.insert(MatchService.order, s.id)
	end
	-- pregame length: full reaping if anyone hasn't seen it yet
	local anyNew = false
	for _, p in ipairs(humans) do
		local data = ctx.Progress.dataOf(p)
		if data and not data.seenReaping and not data.settings.shortReaping then
			anyNew = true
		end
	end
	local P = Config.Pregame
	local total = Config.pregameTotal() - (anyNew and 0 or (P.reaping - P.reapingShort))
	local quick = not MatchService.mode.ceremony
	if quick then
		total = Modes.pregame(MatchService.mode, total, P.reapingShort)
		anyNew = false
	end
	MatchService.state = "Pregame"
	pacts = Pacts.new()
	pactsEnded = false
	trainingSeed = MatchService.matchNo * 7919 + os.time() % 100000
	boardSent = quick -- Quick Trials skips the training round and its board
	veilStepDone = false
	pregameStart = now()
	pregameShort = not anyNew
	stateEndsAt = now() + total
	for _, id in ipairs(MatchService.order) do
		local c = MatchService.contenders[id]
		if c.kind == "bot" then
			c.training = Training.botScore(trainingSeed, c.id)
			c.quip = (TimeUtil.hash(trainingSeed + #c.id * 31 + string.byte(c.id, -1)) % #Content.QUIPS) + 1
		end
	end
	local roster = {}
	for _, id in ipairs(MatchService.order) do
		local c = MatchService.contenders[id]
		table.insert(roster, { name = c.name, reach = c.reach, bot = c.kind == "bot", quip = c.quip })
	end
	for _, p in ipairs(humans) do
		local c = MatchService.contenders["u" .. p.UserId]
		local data = ctx.Progress.dataOf(p)
		local partner = c and c.partner and MatchService.contenders[c.partner]
		if c then
			c.quip = data and data.quip or 1
		end
		ctx.push(p, "pregame", {
			seconds = total,
			reach = c and c.reach,
			partnerName = partner and partner.name or nil,
			short = data and (data.seenReaping or data.settings.shortReaping) or false,
			roster = roster,
			twist = MatchService.twist,
			weekly = MatchService.weekly,
			quip = data and Content.QUIPS[data.quip] or Content.QUIPS[1],
			quipIndex = data and data.quip or 1,
			question = Content.QUESTIONS[(TimeUtil.hash(trainingSeed + p.UserId % 997) % #Content.QUESTIONS) + 1],
			trainingSeed = trainingSeed,
			humans = #humans,
			quick = quick,
			mode = MatchService.mode.name,
			archive = MatchService.archive,
			party = Party.size(MatchService.party, Party.partyOf(MatchService.party, p.UserId) or 0),
		})
	end
	pushMatch("matchStart", { humans = #humans, bots = #botIds, twist = MatchService.twist, mode = MatchService.mode.name, archive = MatchService.archive })
end

local function startLaunch()
	MatchService.state = "Launch"
	stateEndsAt = now() + Config.Pregame.launch
	-- twist effects
	local tw = MatchService.twist
	if tw then
		if tw.mods.clock then
			Lighting.ClockTime = tw.mods.clock
		end
		if tw.mods.gravity then
			workspace.Gravity = 196.2 * tw.mods.gravity
		end
		phases = Modes.phases(MatchService.mode, Config.VeilPhases, tw.mods.veil or 1)
	else
		phases = Modes.phases(MatchService.mode, Config.VeilPhases)
	end
	-- v5 Archive Reel: the broadcast goes sepia, like footage from 25 years ago
	local cc = Lighting:FindFirstChild("ArchiveReel") :: ColorCorrectionEffect?
	if MatchService.archive and not cc then
		local fx = Instance.new("ColorCorrectionEffect")
		fx.Name = "ArchiveReel"
		fx.Saturation = -0.75
		fx.Contrast = 0.12
		fx.TintColor = Color3.fromRGB(255, 232, 196)
		fx.Parent = Lighting
	elseif not MatchService.archive and cc then
		cc:Destroy()
	end
	setVeil(Config.Map.ARENA_SIZE / 2)
	local plates = map().Arena.LiftPlates
	for i, id in ipairs(MatchService.order) do
		local c = MatchService.contenders[id]
		local plate = plates:FindFirstChild(string.format("Plate%02d", i)) :: BasePart?
		local cf = plate and (CFrame.lookAt(plate.Position + Vector3.new(0, 4, 0), Vector3.new(0, plate.Position.Y + 4, 0))) or CFrame.new(0, 10, 0)
		if c.player then
			local char = c.player.Character
			if not char or not char.Parent then
				c.player:LoadCharacterAsync()
				char = c.player.Character
			end
			if char then
				char:PivotTo(cf)
				c.model = char
				byModel[char] = c.id
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hum then
					hum.BreakJointsOnDeath = false
					hum.Died:Connect(function()
						if c.alive and MatchService.state == "Arena" then
							MatchService.knockout(c, "a long fall")
						end
					end)
				end
				local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
				if hrp then
					hrp.Anchored = true
				end
				char:SetAttribute("SpeedMult", 1)
			end
			c.stam = Stamina.new(STAMINA_RULES)
			c.meters = Meters.new(Config.Meters)
			c.lastGood = nil
			c.training = c.training or 5
			if ctx.Progress.hasPass(c.player, "StarterSatchel") and not Config.RANKED then
				MatchService.give(c, "apple")
				MatchService.give(c, "canteen")
			end
			pushInv(c)
		else
			local m = ctx.Bots.spawn(c, cf)
			c.model = m
			if m then
				byModel[m] = c.id
			end
		end
	end
	resetCrates()
	spawnTokens()
	rustyGiftGiven = false
	pushMatch("launch", { seconds = Config.Pregame.launch, twist = MatchService.twist })
end

local function startArena()
	MatchService.state = "Arena"
	arenaStart = now()
	MatchService.t = 0
	stateEndsAt = arenaStart + Modes.cap(MatchService.mode, Config.HARD_CAP)
	for _, c in pairs(MatchService.contenders) do
		if c.player and c.model then
			local hrp = c.model:FindFirstChild("HumanoidRootPart") :: BasePart?
			if hrp then
				hrp.Anchored = false
			end
			c.lastGood = nil
			c.speedStrikes = 0
			pushVitals(c, true)
		end
	end
	ctx.Gallery.onArenaStart()
	ctx.Bots.onArenaStart()
	pushMatch("arena", { size = Config.MATCH_SIZE, mode = MatchService.mode.name })
end

local function startPodium()
	MatchService.state = "Podium"
	stateEndsAt = now() + Config.PODIUM_SECONDS
	-- the winner is the last one standing (or the highest Pep at the hard cap)
	local winner: Contender? = nil
	for _, c in pairs(MatchService.contenders) do
		if c.alive and (winner == nil or c.pep > winner.pep) then
			winner = c
		end
	end
	local alive = {}
	for _, c in pairs(MatchService.contenders) do
		if c.alive and c ~= winner then
			table.insert(alive, c)
		end
	end
	table.sort(alive, function(a: Contender, b: Contender): boolean
		return a.pep > b.pep
	end)
	for i, c in ipairs(alive) do
		c.place = i + 1
		c.alive = false
	end
	local podium = {}
	if winner then
		winner.place = 1
		winner.alive = false
	end
	local all = {}
	for _, c in pairs(MatchService.contenders) do
		table.insert(all, c)
	end
	table.sort(all, function(a: Contender, b: Contender): boolean
		return (a.place or 99) < (b.place or 99)
	end)
	local statues = {}
	for i = 1, math.min(3, #all) do
		local entry = { name = all[i].name, reach = all[i].reach, place = all[i].place, knocks = all[i].knocks }
		local pl = all[i].player
		local pd = pl and ctx.Progress.dataOf(pl)
		if pd and pd.equipped then
			local pose = Store.byId[pd.equipped.pose or ""]
			local banner = Store.byId[pd.equipped.banner or ""]
			entry.pose = pose and { name = pose.name, icon = pose.icon, color = pose.color } or nil
			entry.banner = banner and banner.name or nil
		end
		table.insert(podium, entry)
		-- v4: statues on the lobby Victory Podium in their real loadout (bots: default looks)
		local l = pl and ctx.Hall.loadoutOf(pl)
			or { userId = 0, name = all[i].name, pose = "pose_firstlight", weapon = "bow", skin = "", mastery = 0, fade = "fade_gold", banner = "", title = "" }
		table.insert(statues, { place = i, loadout = l })
	end
	if winner and winner.player then
		ctx.Hall.recordWin(winner.player)
	end
	ctx.Hall.podium(statues)
	for _, c in ipairs(all) do
		-- Encore fix: someone paid at an earlier knockout and voted back in is topped up to
		-- their final place here, once (v1 skipped them because `awarded` was already set).
		local needsTopUp = c.awarded and c.encore and c.firstResult ~= nil and not c.toppedUp
		if c.player and c.player.Parent and (not c.awarded or needsTopUp) then
			local data = ctx.Progress.dataOf(c.player)
			local prevBest = data and data.stats.bestPlace or 0
			local r = {
				place = c.place or 2,
				size = Config.MATCH_SIZE,
				knocks = c.knocks,
				crates = c.crates,
				tokens = c.tokens,
				gifts = 0,
				votes = 0,
				encore = c.encore,
				survived = MatchService.t,
				partner = c.partner ~= nil and string.sub(c.partner, 1, 1) == "u",
				bonusStars = Twists.mod({ MatchService.weekly }, "bonusStars", 0),
				pactKept = c.pactKept,
				archive = MatchService.archive,
			}
			local result: any
			if needsTopUp then
				result = ctx.Progress.topUp(c.player, c.firstResult, r)
				c.toppedUp = true
			else
				result = ctx.Progress.award(c.player, r)
				c.firstResult = r
			end
			c.awarded = true
			local nm = { place = c.place or 2, size = Config.MATCH_SIZE, knocks = c.knocks, survived = MatchService.t, bestPlace = prevBest, nextKnockGoal = ctx.Progress.nextGoal(c.player, "knocks"), winnerPepLeft = winner and winner.pep }
			local firstWin = c.place == 1 and ctx.Progress.firstWin(c.player)
			ctx.push(c.player, "finished", {
				headline = NearMiss.headline(nm),
				lines = NearMiss.lines(nm),
				place = c.place,
				result = result,
				preview = ctx.Purchase.previewFor(c.player, c.knocks),
				firstWin = firstWin and Offers.firstWin(c.player.DisplayName) or nil,
				moment = MatchService.momentFor(c),
			})
		end
	end
	pushMatch("podium", { podium = podium, winner = winner and winner.name or "", reach = winner and winner.reach or "", next = Config.PODIUM_SECONDS + Config.Matchmaking.nextMatchSeconds })
	MatchService.sendPartyCards()
	ctx.Gallery.onArenaEnd()
	ctx.Bots.onArenaEnd()
end

local function backToLobby()
	local players = matchHumans()
	clearArena()
	local cc = Lighting:FindFirstChild("ArchiveReel")
	if cc then
		cc:Destroy()
	end
	MatchService.state = "Lobby"
	MatchService.t = 0
	for _, p in ipairs(Players:GetPlayers()) do
		ctx.Gallery.removeSpectator(p)
	end
	for _, p in ipairs(players) do
		task.spawn(function()
			p:LoadCharacterAsync()
		end)
	end
	-- auto-queue: everyone with auto-queue on goes straight back in; the next match starts in 10s
	for _, p in ipairs(Players:GetPlayers()) do
		local data = ctx.Progress.dataOf(p)
		local was = table.find(players, p) ~= nil
		if data and data.settings.autoQueue and (was or inQueue(p)) and not inQueue(p) then
			table.insert(queue, p)
		end
	end
	queueSince = now()
	if #queue > 0 then
		forceLaunchAt = now() + Config.Matchmaking.nextMatchSeconds
	end
	pushMatch("requeue", { seconds = Config.Matchmaking.nextMatchSeconds, queued = #queue })
end

endIfDone = function()
	if MatchService.state ~= "Arena" then
		return
	end
	local alive = MatchService.aliveCount()
	if alive <= 1 then
		task.defer(startPodium)
	end
end

-- Encore: bring a knocked-out contender back with some Pep (GalleryService picks who).
function MatchService.revive(c: Contender): boolean
	if MatchService.state ~= "Arena" or c.alive then
		return false
	end
	local a = rng:NextNumber(0, math.pi * 2)
	local r = math.min(MatchService.radius * 0.5, 300)
	local pos = Vector3.new(math.cos(a) * r, 6, math.sin(a) * r)
	c.alive = true
	c.place = nil
	c.pep = Config.Encore.pep
	c.encore = true
	c.inv = {}
	c.slots = Config.BACKPACK_SLOTS
	c.equipped = 1
	c.lastGood = nil
	c.speedStrikes = 0
	if c.player then
		c.stam = Stamina.new(STAMINA_RULES)
		c.meters = Meters.new(Config.Meters)
	end
	MatchService.give(c, "knife")
	if c.player then
		local player = c.player
		ctx.Gallery.removeSpectator(player)
		local char = player.Character
		if char then
			char:PivotTo(CFrame.new(pos))
			c.model = char
			byModel[char] = c.id
		end
		ctx.Progress.bump(player, "encore", 1)
		ctx.push(player, "encore", { pep = c.pep })
		pushInv(c)
	else
		local m = ctx.Bots.spawn(c, CFrame.new(pos))
		c.model = m
		if m then
			byModel[m] = c.id
		end
	end
	pushMatch("feed", { victim = c.name, cause = "voted back in by " .. Names.GALLERY, encore = true, left = MatchService.aliveCount() })
	return true
end

-- ===================== intents =====================
local function joinQueue(player: Player): (boolean, string?)
	if MatchService.contenderOf(player) and MatchService.state ~= "Lobby" then
		return false, "You're in a match right now."
	end
	if inQueue(player) then
		return true, nil
	end
	table.insert(queue, player)
	if #queue == 1 then
		queueSince = now()
	end
	lobbyStatus()
	if MatchService.state ~= "Lobby" then
		return true, "Queued! You'll go in the next " .. Names.EVENT_SHORT .. "."
	end
	return true, "Queued for " .. Names.DRAW .. "!"
end

local function leaveQueue(player: Player): (boolean, string?)
	local i = table.find(queue, player)
	if i then
		table.remove(queue, i)
	end
	lobbyStatus()
	return true, "Left the queue."
end

local function invite(player: Player, userId: any): (boolean, string?)
	if type(userId) ~= "number" then
		return false, nil
	end
	local other = Players:GetPlayerByUserId(userId)
	if not other or other == player then
		return false, "They're not in this server."
	end
	if invites[player] == other then
		-- they already invited us: accept
		partnerOf[player] = other
		partnerOf[other] = player
		invites[player] = nil
		ctx.toast(other, player.DisplayName .. " is your partner! Same " .. Names.REGION .. ", side by side.", "good")
		lobbyStatus()
		return true, "Partnered with " .. other.DisplayName .. "!"
	end
	invites[other] = player
	ctx.toast(other, player.DisplayName .. " wants to partner up. Open Partner to accept.", "info")
	lobbyStatus()
	return true, "Invite sent."
end

-- ===================== v5 parties (up to 10) =====================
local function partyPush()
	for _, p in ipairs(Players:GetPlayers()) do
		local s = MatchService.party
		local pid = Party.partyOf(s, p.UserId)
		local members = {}
		for _, uid in ipairs(Party.membersOf(s, p.UserId)) do
			local m = Players:GetPlayerByUserId(uid)
			table.insert(members, { userId = uid, name = m and m.DisplayName or "?", leader = pid ~= nil and s.leader[pid] == uid, queued = m ~= nil and inQueue(m) })
		end
		local from = s.invites[p.UserId]
		local fp = from and Players:GetPlayerByUserId(from)
		ctx.push(p, "party", { members = pid and members or {}, max = Party.MAX, invite = fp and fp.DisplayName or nil, family = isPrivate() and MatchService.psRules.family })
	end
end
MatchService.partyPush = partyPush

local function partyInvite(player: Player, userId: any): (boolean, string?)
	local other = type(userId) == "number" and Players:GetPlayerByUserId(userId) or nil
	if not other then
		return false, "They're not in this server."
	end
	local ok, msg = Party.invite(MatchService.party, player.UserId, other.UserId)
	if ok then
		ctx.toast(other, player.DisplayName .. " invited you to their party. Open Party to join.", "info")
		partyPush()
		return true, "Party invite sent to " .. other.DisplayName .. "."
	end
	return false, msg
end

local function partyAccept(player: Player): (boolean, string?)
	local ok, msg = Party.accept(MatchService.party, player.UserId)
	partyPush()
	if not ok then
		return false, msg
	end
	-- queue together: if anyone in the party is queued, the newcomer joins the queue too
	for _, uid in ipairs(Party.membersOf(MatchService.party, player.UserId)) do
		local m = Players:GetPlayerByUserId(uid)
		if m and m ~= player and inQueue(m) and not inQueue(player) then
			table.insert(queue, player)
			break
		end
	end
	return true, "You're in the party!"
end

local function partyLeave(player: Player): (boolean, string?)
	Party.leave(MatchService.party, player.UserId)
	partyPush()
	return true, "Left the party."
end

-- The leader queues (or leaves the queue) for the whole party.
local function partyQueue(player: Player, on: any): (boolean, string?)
	local s = MatchService.party
	local pid = Party.partyOf(s, player.UserId)
	if not pid or s.leader[pid] ~= player.UserId then
		return false, "Only the party leader can queue everyone."
	end
	local wasEmpty = #queue == 0
	for _, uid in ipairs(s.members[pid]) do
		local m = Players:GetPlayerByUserId(uid)
		if m then
			local i = table.find(queue, m)
			if on ~= false and not i then
				table.insert(queue, m)
			elseif on == false and i then
				table.remove(queue, i)
			end
		end
	end
	if wasEmpty and #queue > 0 then
		queueSince = now()
	end
	lobbyStatus()
	partyPush()
	return true, on ~= false and "Party queued together." or "Party left the queue."
end

local function unpartner(player: Player): (boolean, string?)
	local o = partnerOf[player]
	partnerOf[player] = nil
	if o then
		partnerOf[o] = nil
		ctx.toast(o, player.DisplayName .. " left your partnership.", "info")
	end
	lobbyStatus()
	return true, nil
end

local function use(player: Player, aim: any): (boolean, string?)
	local c = MatchService.contenderOf(player)
	if not c or not c.alive or MatchService.state ~= "Arena" then
		return false, nil
	end
	local a = typeof(aim) == "Vector3" and aim or nil
	return MatchService.use(c, a), nil
end

local function equipSlot(player: Player, i: any): (boolean, string?)
	local c = MatchService.contenderOf(player)
	if not c or type(i) ~= "number" or not c.inv[i] then
		return false, nil
	end
	c.equipped = math.floor(i)
	setHeld(c)
	pushInv(c)
	return true, nil
end

local function drop(player: Player, i: any): (boolean, string?)
	local c = MatchService.contenderOf(player)
	if not c or type(i) ~= "number" or not c.inv[i] then
		return false, nil
	end
	table.remove(c.inv, i)
	c.equipped = math.clamp(c.equipped, 1, math.max(1, #c.inv))
	setHeld(c)
	pushInv(c)
	return true, nil
end

local function watch(player: Player): (boolean, string?)
	if MatchService.state ~= "Arena" then
		return false, "No live " .. Names.EVENT_SHORT .. " to watch right now."
	end
	local c = MatchService.contenderOf(player)
	if c and c.alive then
		return false, nil
	end
	toGallery(player)
	return true, "Welcome to " .. Names.GALLERY .. "!"
end

-- Training round: the client sends which targets it hit and when (seconds since the round
-- began). The server re-creates the seeded targets and scores the clicks itself.
local function training(player: Player, clicks: any): (boolean, string?)
	local c = MatchService.contenderOf(player)
	if not c or MatchService.state ~= "Pregame" or type(clicks) ~= "table" or c.training then
		return false, nil
	end
	local list = {}
	for k, v in ipairs(clicks) do
		if k > 12 then
			break
		end
		if type(v) == "table" and type(v.i) == "number" and type(v.t) == "number" then
			table.insert(list, { i = math.floor(v.i), t = v.t })
		end
	end
	local targets = Training.targets(trainingSeed, Config.Training.targets, Config.Training.duration)
	local score = Training.score(targets, list, Config.Training.max)
	c.training = score
	return true, nil
end

-- Interview: pick one of the preset answers. Index only, never text.
local function interview(player: Player, i: any): (boolean, string?)
	local c = MatchService.contenderOf(player)
	if not c or MatchService.state ~= "Pregame" or type(i) ~= "number" or not Content.QUIPS[i] then
		return false, nil
	end
	local q = math.floor(i)
	c.quip = q
	for _, p in ipairs(matchHumans()) do
		if p ~= player then
			ctx.push(p, "interviewLine", { name = c.name, reach = c.reach, quip = Content.QUIPS[q] })
		end
	end
	return true, nil
end

-- ===== pacts =====
local function nearestFor(c: Contender, range: number): Contender?
	local root = MatchService.rootOf(c)
	if not root then
		return nil
	end
	local best: Contender? = nil
	local bestD = range
	for _, o in pairs(MatchService.contenders) do
		if o ~= c and o.alive and o.reach ~= c.reach and not Pacts.same(pacts, c.id, o.id) then
			local r = MatchService.rootOf(o)
			if r then
				local d = (r.Position - root.Position).Magnitude
				if d < bestD then
					best, bestD = o, d
				end
			end
		end
	end
	return best
end

local function botAnswer(bot: Contender, from: Contender)
	task.delay(rng:NextNumber(1, 2.5), function()
		if not bot.alive or not from.alive or MatchService.state ~= "Arena" then
			return
		end
		if bot.pep >= 30 and rng:NextNumber() < 0.6 then
			local p = Pacts.accept(pacts, Config.Pacts, bot.id, MatchService.aliveCount(), now())
			if p and from.player then
				ctx.toast(from.player, bot.name .. " accepted your pact.", "good")
				pushMatch("feed", { kind = "pact", victim = bot.name, by = from.name, left = MatchService.aliveCount() })
			end
		else
			Pacts.decline(pacts, bot.id)
			if from.player then
				ctx.toast(from.player, bot.name .. " turned you down.", "info")
			end
		end
		pushPact(from)
	end)
end

function MatchService.offerPact(c: Contender, target: Contender?): (boolean, string?)
	if MatchService.state ~= "Arena" or not c.alive then
		return false, nil
	end
	local o = target or nearestFor(c, Config.Pacts.offerRange)
	if not o then
		return false, "Nobody close enough. Get within " .. Config.Pacts.offerRange .. " studs."
	end
	local ok, why = Pacts.offer(pacts, Config.Pacts, c.id, o.id, MatchService.aliveCount(), now())
	if not ok then
		return false, why
	end
	if o.player then
		pushPact(o)
		ctx.push(o.player, "pactOffer", { name = c.name, reach = c.reach, seconds = Config.Pacts.offerSeconds })
	else
		botAnswer(o, c)
	end
	return true, "Pact offered to " .. o.name .. "."
end

local function pactOffer(player: Player): (boolean, string?)
	local c = MatchService.contenderOf(player)
	if not c then
		return false, nil
	end
	return MatchService.offerPact(c, nil)
end

local function pactAccept(player: Player): (boolean, string?)
	local c = MatchService.contenderOf(player)
	if not c or not c.alive or MatchService.state ~= "Arena" then
		return false, nil
	end
	local p, why = Pacts.accept(pacts, Config.Pacts, c.id, MatchService.aliveCount(), now())
	pushPactsAll()
	if not p then
		return false, why
	end
	local names = {}
	for _, id in ipairs(p.members) do
		local m = MatchService.contenders[id]
		if m then
			table.insert(names, m.name)
			if m.player and m ~= c then
				ctx.toast(m.player, c.name .. " joined your pact.", "good")
			end
		end
	end
	pushMatch("feed", { kind = "pact", victim = table.concat(names, " + "), left = MatchService.aliveCount() })
	return true, "Pact formed. " .. Content.RUSTY.pact
end

local function pactDecline(player: Player): (boolean, string?)
	local c = MatchService.contenderOf(player)
	if c then
		Pacts.decline(pacts, c.id)
		pushPact(c)
	end
	return true, nil
end

function MatchService.snapPact(c: Contender): (boolean, string?)
	if MatchService.state ~= "Arena" or not c.alive then
		return false, nil
	end
	if isPrivate() and MatchService.psRules.noBetrayals then
		return false, "This private server has No Betrayals on."
	end
	local sn, why = Pacts.snap(pacts, Config.Pacts, c.id, now())
	if not sn then
		return false, why
	end
	-- telegraph: the allies are warned and the snapper glows red for the wind-up
	for _, id in ipairs(Pacts.allies(pacts, c.id)) do
		local a = MatchService.contenders[id]
		if a and a.player then
			ctx.push(a.player, "pactWarning", { name = c.name, seconds = Config.Pacts.snapSeconds })
		end
	end
	if c.model then
		local h = Instance.new("Highlight")
		h.Name = "PactSnap"
		h.FillColor = Color3.fromHex("#E2463A")
		h.FillTransparency = 0.55
		h.OutlineColor = Color3.fromHex("#FFB0A8")
		h.Parent = c.model
		task.delay(Config.Pacts.snapSeconds + 0.2, function()
			h:Destroy()
		end)
	end
	pushPact(c)
	return true, string.format("Snapping your pact in %ds…", Config.Pacts.snapSeconds)
end

local function pactSnap(player: Player): (boolean, string?)
	local c = MatchService.contenderOf(player)
	if not c then
		return false, nil
	end
	return MatchService.snapPact(c)
end

local function tickPacts()
	for _, ev in ipairs(Pacts.tick(pacts, Config.Pacts, now())) do
		local who = ev.who and MatchService.contenders[ev.who]
		local names = {}
		for _, id in ipairs(ev.with or {}) do
			local v = MatchService.contenders[id]
			if v then
				table.insert(names, v.name)
				if v.player then
					ctx.push(v.player, "pactSnapped", { name = who and who.name or "?", line = Content.RUSTY.snapped, guard = Config.Pacts.guardSeconds })
				end
			end
		end
		if who then
			if who.player then
				ctx.Progress.grant(who.player, "title_turncoat", "Title unlocked: " .. Content.TITLES.title_turncoat)
				ctx.push(who.player, "pactSnapDone", { names = names, window = Config.Pacts.betrayWindow })
			end
			pushMatch("feed", { kind = "pactSnap", by = who.name, victim = table.concat(names, " + "), left = MatchService.aliveCount() })
		end
		pushPactsAll()
	end
	-- final few: every pact ends; those still in one get the "pact kept" bonus
	if not pactsEnded and MatchService.aliveCount() <= Config.Pacts.endAt then
		pactsEnded = true
		for _, p in ipairs(Pacts.endAll(pacts)) do
			for _, id in ipairs(p.members) do
				local m = MatchService.contenders[id]
				if m and m.alive then
					m.pactKept = true
				end
			end
		end
		pushMatch("pactsEnded", { left = MatchService.aliveCount() })
		pushPactsAll()
	end
end

-- Stand-Ins make the odd offer to nearby players, and sometimes snap late in the match.
local function botPacts()
	local alive = MatchService.aliveCount()
	if pactsEnded then
		return
	end
	for _, b in pairs(MatchService.contenders) do
		if b.kind == "bot" and b.alive then
			if pacts.memberOf[b.id] then
				if alive <= 8 and rng:NextNumber() < 0.04 then
					MatchService.snapPact(b)
				end
			elseif rng:NextNumber() < 0.01 then
				local o = nearestFor(b, Config.Pacts.offerRange)
				if o and o.player and not pacts.offers[o.id] then
					MatchService.offerPact(b, o)
				end
			end
		end
	end
end

-- ===== sprint + throw =====
local function sprint(player: Player, on: any): (boolean, string?)
	local c = MatchService.contenderOf(player)
	if c and c.stam and type(on) == "boolean" then
		c.stam.wants = on
	end
	return true, nil
end

local function throw(player: Player, aim: any): (boolean, string?)
	local c = MatchService.contenderOf(player)
	if not c then
		return false, nil
	end
	if c.inv[c.equipped] ~= "spear" then
		return false, "Equip a spear to throw it."
	end
	return MatchService.throw(c, typeof(aim) == "Vector3" and aim or nil), nil
end

-- Server-owned stamina, Food/Water and WalkSpeed, plus a simple speed check (every tick).
local function tickBodies(dt: number, wholeSecond: boolean)
	local t = now()
	for _, c in pairs(MatchService.contenders) do
		local st, m = c.stam, c.meters
		local root = if c.alive and c.player then MatchService.rootOf(c) else nil
		local hum = c.model and c.model:FindFirstChildOfClass("Humanoid")
		if root and hum and st and m then
			local v = root.AssemblyLinearVelocity
			local moving = Vector3.new(v.X, 0, v.Z).Magnitude > 2
			Meters.step(m, Config.Meters, dt, 1)
			local regen = Meters.regenMult(m, Config.Meters)
			if c.player and ctx.Progress.hasPass(c.player, "TrailBoots") and not Config.RANKED and MatchService.aliveCount() > Config.FairPlay.perksOffAtLeft then
				regen *= 1 + Config.FairPlay.bootsRegen
			end
			Stamina.step(st, STAMINA_RULES, dt, moving, regen)
			local slow = c.slowUntil > t and Config.Hazards.bloom.slow or 1
			hum.WalkSpeed = (st.sprinting and Config.SPRINT_SPEED or Config.WALK_SPEED) * slow
			pushVitals(c)
			if wholeSecond then
				local pos = root.Position
				local last = c.lastGood
				if last then
					local d = Vector3.new(pos.X - last.X, 0, pos.Z - last.Z).Magnitude
					local S = Config.SpeedCheck
					if Stamina.tooFast(d, 1, Config.SPRINT_SPEED, S.slack, S.grace) then
						c.speedStrikes += 1
						if c.speedStrikes >= S.strikes then
							c.speedStrikes = 0
							(c.model :: Model):PivotTo(CFrame.new(last + Vector3.new(0, 3, 0)))
							ctx.toast(c.player, "Whoa, too fast! Moved you back.", "info")
						end
					else
						c.speedStrikes = math.max(0, c.speedStrikes - 1)
						c.lastGood = pos
					end
				else
					c.lastGood = pos
				end
			end
		end
	end
end

function MatchService.onLeave(player: Player)
	local i = table.find(queue, player)
	if i then
		table.remove(queue, i)
	end
	local o = partnerOf[player]
	if o then
		partnerOf[o] = nil
	end
	partnerOf[player] = nil
	invites[player] = nil
	Party.leave(MatchService.party, player.UserId)
	MatchService.party.invites[player.UserId] = nil
	task.defer(partyPush)
	local c = MatchService.contenderOf(player)
	if c and c.alive and MatchService.state == "Arena" then
		MatchService.knockout(c, "left the arena")
	end
	if c then
		c.player = nil
	end
end

function MatchService.init(c: any)
	ctx = c
	ctx.handle("queue", joinQueue)
	ctx.handle("leave", leaveQueue)
	ctx.handle("invite", invite)
	ctx.handle("unpartner", unpartner)
	ctx.handle("use", use)
	ctx.handle("equipSlot", equipSlot)
	ctx.handle("drop", drop)
	ctx.handle("watch", watch)
	ctx.handle("training", training)
	ctx.handle("interview", interview)
	ctx.handle("pactOffer", pactOffer)
	ctx.handle("pactAccept", pactAccept)
	ctx.handle("pactDecline", pactDecline)
	ctx.handle("pactSnap", pactSnap)
	ctx.handle("sprint", sprint)
	ctx.handle("throw", throw)
	ctx.handle("partyInvite", partyInvite)
	ctx.handle("partyAccept", partyAccept)
	ctx.handle("partyLeave", partyLeave)
	ctx.handle("partyQueue", partyQueue)
	ctx.handle("setMode", function(player: Player, mode: any): (boolean, string?)
		if mode ~= "" and mode ~= Modes.QUICK and mode ~= Modes.JUBILEE then
			return false, nil
		end
		local d = ctx.Progress.dataOf(player)
		if not d then
			return false, nil
		end
		d.settings.mode = mode
		ctx.Progress.markDirty(player)
		task.defer(ctx.Progress.sendState, player)
		return true, mode == "" and "Match type: auto." or ("Match type: " .. Modes.get(mode).name .. ".")
	end)
	ctx.handle("psRule", function(player: Player, key: any, value: any): (boolean, string?)
		local owner = isPrivate() and game.PrivateServerOwnerId == player.UserId
		local studio = game:GetService("RunService"):IsStudio()
		-- Family Rules is free for any private-server owner (party allied until 4 are left)
		if key == "family" and type(value) == "boolean" and (owner or studio) then
			MatchService.psRules.family = value
			partyPush()
			return true, value and "Family Rules on: your party is allied until the final 4." or "Family Rules off: everyone for themselves."
		end
		if not (owner or studio) or not ctx.Progress.hasPass(player, "VIP") then
			return false, "Private server rules need Spire VIP and your own private server."
		end
		if key == "twist" and type(value) == "string" then
			MatchService.psRules.twist = value
			return true, value == "" and "Twist: random each match." or ("Next twist set: " .. value)
		elseif key == "noBetrayals" and type(value) == "boolean" then
			MatchService.psRules.noBetrayals = value
			return true, value and "No Betrayals is on." or "Pact Snaps are allowed again."
		end
		return false, nil
	end)
end

function MatchService.start()
	-- templates move out of Workspace so they aren't visible
	local tpl = map():FindFirstChild("Templates")
	if tpl then
		tpl.Parent = ServerStorage
	end
	for _, p in ipairs(map().Arena.Veil:GetChildren()) do
		if p:IsA("BasePart") then
			table.insert(veilPanels, p)
		end
	end
	table.sort(veilPanels, function(a: BasePart, b: BasePart): boolean
		return ((a:GetAttribute("Angle") or 0) :: number) < ((b:GetAttribute("Angle") or 0) :: number)
	end)
	-- crate prompts
	for _, crate in ipairs(allCrates()) do
		local pp = crate:FindFirstChildOfClass("ProximityPrompt")
		if pp then
			pp.Triggered:Connect(function(player: Player)
				local c = MatchService.contenderOf(player)
				if c then
					MatchService.openCrate(c, crate)
				end
			end)
		end
	end
	-- lobby prompts
	local lobby = map().Lobby
	for _, d in ipairs(lobby:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			d.Triggered:Connect(function(player: Player)
				local kind = d:GetAttribute("Kind")
				if kind == "queue" then
					local ok, msg = joinQueue(player)
					if msg then
						ctx.toast(player, msg, ok and "good" or "info")
					end
				else
					ctx.push(player, "openPanel", { kind = kind })
				end
			end)
		end
	end
	-- main loop
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.25)
			local t0 = os.clock()
			local dt = t0 - last
			last = t0
			local ok, err = pcall(function()
				local t = now()
				local wholeSecond = math.floor(t) ~= lastSecond
				lastSecond = math.floor(t)
				if MatchService.state == "Lobby" then
					-- drop players who left
					for i = #queue, 1, -1 do
						if not queue[i].Parent then
							table.remove(queue, i)
						end
					end
					local go = false
					if forceLaunchAt and #queue > 0 then
						go = t >= forceLaunchAt
					else
						go = Queue.shouldLaunch(#queue, t - queueSince, Config.MATCH_SIZE, Config.Matchmaking, not Config.Matchmaking.crossServer)
					end
					if go then
						startPregame()
					elseif wholeSecond then
						lobbyStatus()
					end
				elseif MatchService.state == "Pregame" then
					-- training board: everyone's score, shown as the round ends
					local P = Config.Pregame
					local boardAt = pregameStart + (pregameShort and P.reapingShort or P.reaping) + P.parade + P.interview + Config.Training.duration + 0.5
					if not boardSent and t >= boardAt then
						boardSent = true
						local board = {}
						for _, id in ipairs(MatchService.order) do
							local c = MatchService.contenders[id]
							c.training = c.training or 5
							table.insert(board, { name = c.name, reach = c.reach, score = c.training, me = false })
						end
						table.sort(board, function(a: any, b: any): boolean
							return a.score > b.score
						end)
						for _, p in ipairs(matchHumans()) do
							local mine = MatchService.contenderOf(p)
							ctx.push(p, "trainingBoard", { board = board, mine = mine and mine.training, underdogAt = Config.Training.underdogAt })
						end
					end
					if t >= stateEndsAt then
						startLaunch()
					end
				elseif MatchService.state == "Launch" then
					if t >= stateEndsAt then
						startArena()
					end
				elseif MatchService.state == "Arena" then
					MatchService.t = t - arenaStart
					-- Veil Breaker calm: the Veil clock pauses while the dome is broken
					if t < calmUntil then
						veilShift += dt
					end
					local vt = MatchService.t - veilShift
					local r = Veil.radiusAt(vt, phases, Config.Map.ARENA_SIZE / 2)
					if math.abs(r - MatchService.radius) > 0.05 then
						setVeil(r)
					end
					tickHazards(dt, wholeSecond)
					tickBodies(dt, wholeSecond)
					tickPacts()
					if wholeSecond then
						botPacts()
						if not veilBroken and not veilCore and MatchService.aliveCount() <= Config.VeilBreaker.at and MatchService.aliveCount() > 1 then
							lightCore()
						end
						local dmg = Veil.damage(vt, phases, Config.VEIL_DAMAGE)
						for _, c in pairs(MatchService.contenders) do
							local root = if c.alive then MatchService.rootOf(c) else nil
							if root then
								if Veil.outside(root.Position.X, root.Position.Z, MatchService.radius) then
									MatchService.damage(c, dmg, nil, "veil", nil)
								end
								if c.model then
									c.model:SetAttribute("SpeedMult", c.slowUntil > t and Config.Hazards.bloom.slow or 1)
								end
							end
						end
						-- scheduled hazards (Finch Day doubles the flock)
						for _, h in ipairs(Config.Hazards.scheduled) do
							if math.floor(MatchService.t) == Modes.at(MatchService.mode, h.at) then
								MatchService.startHazard(h.id)
							end
						end
						if MatchService.twist and MatchService.twist.mods.finches and math.floor(MatchService.t) == Modes.at(MatchService.mode, 450) then
							MatchService.startHazard("finches")
						end
						-- Rusty's gift at the final 8
						if not rustyGiftGiven and MatchService.aliveCount() <= Config.RUSTY_GIFT_AT then
							local low: Contender? = nil
							for _, c in pairs(MatchService.contenders) do
								if c.alive and c.player and (low == nil or c.pep < low.pep) then
									low = c
								end
							end
							if low then
								rustyGiftGiven = true
								ctx.Gallery.dropGift(low, "sweettea", Names.MENTOR_SHORT, Content.RUSTY.gift)
							end
						end
						-- v5 onboarding: still standing after the first shrink
						if not veilStepDone and phases[1] and vt >= phases[1].at + phases[1].dur then
							veilStepDone = true
							for _, c in pairs(MatchService.contenders) do
								if c.alive and c.player then
									ctx.Progress.onboard(c.player, "veil")
								end
							end
						end
						local nextIn, target = Veil.nextShrink(vt, phases)
						pushMatch("match", {
							t = MatchService.t,
							alive = MatchService.aliveCount(),
							radius = MatchService.radius,
							nextIn = nextIn,
							target = target,
							shrinking = t >= calmUntil and Veil.isShrinking(vt, phases),
							calm = t < calmUntil and math.ceil(calmUntil - t) or nil,
							core = veilCore ~= nil,
							twist = MatchService.twist and MatchService.twist.name,
						})
						if t >= stateEndsAt then
							startPodium()
						end
					end
				elseif MatchService.state == "Podium" then
					if t >= stateEndsAt then
						backToLobby()
					end
				end
			end)
			if not ok then
				warn("[MatchService] " .. tostring(err))
			end
		end
	end)
end

return MatchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">ProgressService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ProgressService — everything that keeps players coming back, all cosmetic or Renown:
	  * Contender level 1-50 and prestige ranks (Leveling)
	  * Play streak: back-to-back matches add +10% Renown each (max +50%), resets after 4 min idle
	  * Forgiving daily streak (one free miss a week, soft reset)
	  * 3 daily + 3 weekly challenges (same for everyone on a given day/week)
	  * The Season Track (free lane for all; optional premium cosmetic lane)
	  * Jubilee Token collection book
	  * Reach loyalty: weekly Reach standings and cosmetic banners for the top 3 Reaches
	  * Sponsor letters: a daily package from the patrons you've won over (Logic/Sponsors)
	  * Encore top-ups: a contender voted back in is paid for their better finish (Logic/Award)
	It also builds the "state" snapshot each client renders.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Names = require(Shared.Names)
local Content = require(Shared.Content)
local Monetization = require(Shared.Monetization)
local Leveling = require(Shared.Logic.Leveling)
local Streak = require(Shared.Logic.Streak)
local Challenges = require(Shared.Logic.Challenges)
local SeasonTrack = require(Shared.Logic.SeasonTrack)
local ReachStandings = require(Shared.Logic.ReachStandings)
local Twists = require(Shared.Logic.Twists)
local TimeUtil = require(Shared.Logic.TimeUtil)
local Sponsors = require(Shared.Logic.Sponsors)
local Award = require(Shared.Logic.Award)
local Store = require(Shared.Store)
local Mastery = require(Shared.Mastery)
local Anim = require(Shared.Anim)
local Onboarding = require(Shared.Logic.Onboarding)
local Comeback = require(Shared.Logic.Comeback)
local Events = require(Shared.Logic.Events)
local Funnel = require(Shared.Logic.Funnel)
local Moments = require(Shared.Logic.Moments)
local Prefs = require(Shared.Prefs)
local AnalyticsService = game:GetService("AnalyticsService")
Store.addReachPride(Names.REACH_LIST)

local ProgressService = {}
local ctx: any = nil
local letterView: (data: any) -> any -- assigned below (sponsor letters)

export type Runtime = { passes: { [string]: boolean }, dirty: boolean, sub: boolean? }
ProgressService.runtime = {} :: { [Player]: Runtime }
ProgressService.reachTable = {} :: { [string]: number } -- this server's view of this week's points
local reachStore: OrderedDataStore? = nil

local function week(): number
	return TimeUtil.week(os.time())
end
local function today(): number
	return TimeUtil.day(os.time())
end

function ProgressService.dataOf(player: Player): any?
	local p = ctx.Data.get(player)
	return p and p.data or nil
end

function ProgressService.hasPass(player: Player, key: string): boolean
	local r = ProgressService.runtime[player]
	return r ~= nil and r.passes[key] == true
end

local function ensurePeriodic(data: any)
	Challenges.ensure(data.daily, Challenges.DAILY, today(), 3)
	Challenges.ensure(data.weekly, Challenges.WEEKLY, week(), 3)
	SeasonTrack.ensure(data.season, SeasonTrack.SEASON)
end

local function challengeView(list: { any }): { any }
	local out = {}
	for _, e in ipairs(list) do
		local d = Challenges.def(e.id)
		if d then
			table.insert(out, { id = e.id, text = d.text, goal = d.goal, progress = e.progress, done = e.done, xp = d.xp, stars = d.stars })
		end
	end
	return out
end

local tiersView: { any }? = nil
local function tiers(): { any }
	if tiersView then
		return tiersView
	end
	local t = {}
	for i, tier in ipairs(SeasonTrack.tiers) do
		t[i] = { free = tier.free.name, premium = tier.premium.name }
	end
	tiersView = t
	return t
end

function ProgressService.snapshot(player: Player): any?
	local data = ProgressService.dataOf(player)
	if not data then
		return nil
	end
	ensurePeriodic(data)
	local hasPremium = ProgressService.hasPass(player, "PremiumLane")
	local tokens = 0
	for _ in pairs(data.tokens) do
		tokens += 1
	end
	local now = os.time()
	return {
		title = Names.TITLE,
		level = data.level,
		xp = data.xp,
		xpNext = Leveling.xpToNext(data.level),
		prestige = data.prestige,
		rank = Names.rank(data.prestige),
		canPrestige = Leveling.canPrestige(data, Config.LEVEL_CAP, Config.PRESTIGE_CAP),
		stats = data.stats,
		streak = data.streak.count,
		bestStreak = data.streak.best,
		play = data.play.count,
		playMult = Leveling.playMult(data.play.count, Config.PLAY_STREAK_STEP, Config.PLAY_STREAK_MAX),
		daily = challengeView(data.daily.list),
		weekly = challengeView(data.weekly.list),
		dailyResetIn = 86400 - (now % 86400),
		season = {
			name = SeasonTrack.SEASON_NAME,
			stars = data.season.stars,
			perTier = Config.STARS_PER_TIER,
			tier = SeasonTrack.tierFor(data.season.stars, Config.STARS_PER_TIER),
			claimedFree = data.season.claimedFree,
			claimedPremium = data.season.claimedPremium,
			premium = hasPremium,
			unclaimed = SeasonTrack.unclaimed(data.season, hasPremium, Config.STARS_PER_TIER),
			tiers = tiers(),
		},
		tokens = tokens,
		tokenTotal = #Content.TOKENS,
		tokenBook = data.tokens,
		owned = data.owned,
		equipped = data.equipped,
		reach = data.reach,
		canChangeReach = ReachStandings.canChange(data.reachWeek, week()),
		reachTop = ReachStandings.sorted(ProgressService.reachTable),
		weeklyRule = Twists.weekly(week()),
		settings = data.settings,
		quip = data.quip,
		passes = ProgressService.runtime[player] and ProgressService.runtime[player].passes or {},
		shop = ctx.Purchase.availability(player),
		store = ctx.Purchase.shopView(player),
		seenReaping = data.seenReaping,
		letters = letterView(data),
		favorBank = data.favorBank or 0,
		titleName = Content.TITLES[data.equipped.title],
		mastery = data.mastery,
		masteryLevels = Mastery.THRESHOLDS,
		masteryPerks = Mastery.PERKS,
		dailyTen = { seconds = data.dailyTen.seconds, goal = Config.DailyTen.seconds, claimed = data.dailyTen.claimed },
		invites = data.referral.brought,
		-- v5
		onboarding = ProgressService.onboardingView(data),
		checklist = ProgressService.checklistView(data),
		homecoming = data.comeback.homecoming,
		festival = ProgressService.festivalView(data),
		mode = data.settings.mode,
	}
end

function ProgressService.sendState(player: Player)
	local snap = ProgressService.snapshot(player)
	if snap then
		ctx.push(player, "state", snap)
	end
end

function ProgressService.markDirty(player: Player)
	local r = ProgressService.runtime[player]
	if r then
		r.dirty = true
	end
end

local function giveXp(player: Player, data: any, amount: number): number
	local gained = Leveling.add(data, amount, Config.LEVEL_CAP)
	if gained > 0 then
		ctx.push(player, "levelup", { level = data.level, rank = Names.rank(data.prestige) })
	end
	return gained
end

local function finishChallenges(player: Player, data: any, done: { any })
	for _, d in ipairs(done) do
		local list = data.daily.list
		local claimed = Challenges.claim(data.daily, d.id) or Challenges.claim(data.weekly, d.id)
		if claimed then
			giveXp(player, data, claimed.xp)
			SeasonTrack.addStars(data.season, claimed.stars, Config.STARS_PER_TIER)
			ctx.push(player, "challenge", { text = claimed.text, xp = claimed.xp, stars = claimed.stars })
		end
		local _ = list
	end
end

-- In-match stat ticks (crates, knocks, gifts, votes, tokens...). Shows challenge pops right away.
function ProgressService.bump(player: Player, stat: string, amount: number?)
	local data = ProgressService.dataOf(player)
	if not data then
		return
	end
	ensurePeriodic(data)
	local n = amount or 1
	local done = Challenges.bump(data.daily, stat, n)
	for _, d in ipairs(Challenges.bump(data.weekly, stat, n)) do
		table.insert(done, d)
	end
	finishChallenges(player, data, done)
	ProgressService.markDirty(player)
end

-- How many more of `stat` finish the closest open challenge (nil if none).
function ProgressService.nextGoal(player: Player, stat: string): number?
	local data = ProgressService.dataOf(player)
	if not data then
		return nil
	end
	local best: number? = nil
	for _, s in ipairs({ data.daily, data.weekly }) do
		for _, e in ipairs(s.list) do
			local d = Challenges.def(e.id)
			if d and d.stat == stat and not e.done then
				local left = d.goal - e.progress
				if best == nil or left < best then
					best = left
				end
			end
		end
	end
	return best
end

function ProgressService.boostMult(player: Player, data: any): number
	local m = 1
	if data.boost and data.boost.untilT > os.time() then
		m += data.boost.mult
	end
	-- casual-only Renown perks (Renown is cosmetic progress; never combat)
	if not Config.RANKED then
		if ProgressService.hasPass(player, "VIP") then
			m += Config.FairPlay.vipRenown
		end
		local r = ProgressService.runtime[player]
		if r and r.sub then
			m += Config.FairPlay.patronRenown
		end
	end
	return m
end

-- Tier Skips and Patron Club skips: move along the cosmetic Season Track.
function ProgressService.skipTiers(player: Player, n: number): number
	local data = ProgressService.dataOf(player)
	if not data then
		return 0
	end
	local up = SeasonTrack.addStars(data.season, n * Config.STARS_PER_TIER, Config.STARS_PER_TIER)
	ProgressService.markDirty(player)
	ProgressService.sendState(player)
	return up
end

function ProgressService.addBoost(data: any, minutes: number, mult: number)
	local now = os.time()
	local base = math.max(now, data.boost.untilT)
	data.boost.untilT = base + minutes * 60
	data.boost.mult = math.max(data.boost.mult or 0, mult)
end

export type MatchResult = {
	place: number,
	size: number,
	knocks: number,
	crates: number,
	tokens: number,
	gifts: number,
	votes: number,
	encore: boolean,
	survived: number,
	partner: boolean,
	bonusStars: number,
	pactKept: boolean?,
	archive: boolean?, -- v5: an Archive Reel match during Founders' Dawn
}

-- Encore fix: a contender already paid at their knockout, voted back in by the Gallery and then
-- finishing higher, gets the difference (never a second "match played").
function ProgressService.topUp(player: Player, first: MatchResult, final: MatchResult): any
	local data = ProgressService.dataOf(player)
	if not data then
		return {}
	end
	ensurePeriodic(data)
	local t = Award.topUp(first :: any, final :: any, Config.XP, Config.STARS)
	local mult = Leveling.playMult(data.play.count, Config.PLAY_STREAK_STEP, Config.PLAY_STREAK_MAX) * ProgressService.boostMult(player, data)
	local xp = math.floor(t.xp * mult)
	local levels = giveXp(player, data, xp)
	local tiersUp = SeasonTrack.addStars(data.season, t.stars, Config.STARS_PER_TIER)
	local st = data.stats
	local prevBest = st.bestPlace
	local place = math.min(first.place, final.place)
	st.knocks += t.knocks
	if t.win then
		st.wins += 1
	end
	if t.top10 then
		st.top10 += 1
	end
	if t.top5 then
		st.top5 += 1
	end
	if t.encore then
		st.encores += 1
	end
	if st.bestPlace == 0 or place < st.bestPlace then
		st.bestPlace = place
	end
	local done = {}
	local function add(stat: string, on: boolean)
		if on then
			for _, d in ipairs(Challenges.bump(data.daily, stat, 1)) do
				table.insert(done, d)
			end
			for _, d in ipairs(Challenges.bump(data.weekly, stat, 1)) do
				table.insert(done, d)
			end
		end
	end
	add("top10", t.top10)
	add("top5", t.top5)
	add("wins", t.win)
	add("encore", t.encore)
	finishChallenges(player, data, done)
	if data.reach ~= "" then
		local extra = ReachStandings.pointsFor(place, final.knocks) - ReachStandings.pointsFor(first.place, first.knocks)
		if extra > 0 then
			ProgressService.addReachPoints(data.reach, extra)
		end
	end
	ProgressService.markDirty(player)
	task.defer(ProgressService.sendState, player)
	return { xp = xp, levels = levels, level = data.level, stars = t.stars, tiersUp = tiersUp, prevBest = prevBest, topUp = true }
end

function ProgressService.grant(player: Player, id: string, why: string)
	local data = ProgressService.dataOf(player)
	if data and not data.owned[id] then
		data.owned[id] = true
		ctx.toast(player, why, "good")
		ProgressService.markDirty(player)
		task.defer(ProgressService.sendState, player)
	end
end

-- ===== v4: Mastery, first win, Daily Ten, invites =====
function ProgressService.isPatron(player: Player): boolean
	local r = ProgressService.runtime[player]
	return r ~= nil and r.sub == true
end

function ProgressService.addMastery(player: Player, slot: string, skin: string, base: number)
	local data = ProgressService.dataOf(player)
	if not data then
		return
	end
	data.mastery = data.mastery or {}
	local key = Mastery.key(slot, skin)
	local pts, up = Mastery.add(data.mastery, key, base, ProgressService.isPatron(player))
	ProgressService.markDirty(player)
	if up then
		local lv = Mastery.level(pts)
		local it = Store.byId[skin]
		ctx.push(player, "mastery", { slot = slot, name = it and it.name or ("Default " .. slot), level = lv, perk = Mastery.PERKS[lv], stars = Mastery.stars(pts) })
		ctx.Match.refreshHeld(player)
		if lv >= Mastery.MAX then
			ProgressService.applyNametag(player)
		end
	end
end

function ProgressService.mastered(data: any): boolean
	for _, pts in pairs(data.mastery or {}) do
		if Mastery.level(pts) >= Mastery.MAX then
			return true
		end
	end
	return false
end

-- First ever win: grants the free First Light pose once. True the one time it happens.
function ProgressService.firstWin(player: Player): boolean
	local data = ProgressService.dataOf(player)
	if not data or data.offers.firstWinShown or (data.stats.wins or 0) < 1 then
		return false
	end
	data.offers.firstWinShown = true
	data.owned["pose_firstlight"] = true
	if (data.equipped.pose or "") == "" then
		data.equipped.pose = "pose_firstlight"
	end
	ProgressService.markDirty(player)
	task.defer(ProgressService.sendState, player)
	return true
end

-- Daily Ten: called every minute for each player in the server.
local function tickDailyTen(player: Player, data: any, seconds: number)
	local d = data.dailyTen
	if d.day ~= today() then
		d.day, d.seconds, d.claimed = today(), 0, false
	end
	if d.claimed then
		return
	end
	d.seconds += seconds
	if d.seconds >= Config.DailyTen.seconds then
		d.claimed = true
		giveXp(player, data, Config.DailyTen.xp)
		SeasonTrack.addStars(data.season, Config.DailyTen.stars, Config.STARS_PER_TIER)
		ctx.toast(player, string.format("☀️ Daily Ten: +%d XP and %d Season stars. See you tomorrow!", Config.DailyTen.xp, Config.DailyTen.stars), "good")
		ProgressService.sendState(player)
	end
	ProgressService.markDirty(player)
end

-- Invites: the joining player's LaunchData is "ref:<inviter userId>". Both get the sash only
-- if the inviter is in this server right now (stops alt farming), once per invited account.
local function checkReferral(player: Player, data: any)
	local ok, join = pcall(function()
		return player:GetJoinData()
	end)
	local launch = ok and type(join) == "table" and join.LaunchData or nil
	if type(launch) ~= "string" or launch:sub(1, 4) ~= "ref:" then
		return
	end
	local by = Moments.parse(launch)
	if not by or by == player.UserId or data.referral.by ~= 0 then
		return
	end
	local inviter = Players:GetPlayerByUserId(by)
	local idata = inviter and ProgressService.dataOf(inviter)
	if not inviter or not idata then
		return
	end
	if (idata.referral.brought or 0) >= Config.Invites.weeklyCap then
		return
	end
	data.referral.by = by
	data.referral.rewarded = true
	idata.referral.brought = (idata.referral.brought or 0) + 1
	ProgressService.grant(player, Config.Invites.reward, "🔥 " .. inviter.DisplayName .. " brought you in: Torchbearer Sash for you both!")
	ProgressService.grant(inviter, Config.Invites.reward, "🔥 " .. player.DisplayName .. " joined from your invite: Torchbearer Sash for you both!")
	ProgressService.markDirty(player)
	ProgressService.markDirty(inviter)
end

-- ===== Sponsor letters =====
local function letterStats(data: any): { [string]: number }
	return data.stats
end

letterView = function(data: any): any
	local signed = Sponsors.earned(Content.PATRONS :: any, letterStats(data))
	local per = { renown = 0, favor = 0 }
	local from = {}
	for _, p in ipairs(signed) do
		per.renown += p.renown
		per.favor += p.favor
		table.insert(from, p.name)
	end
	local nxt = Sponsors.nextPatron(Content.PATRONS :: any, letterStats(data))
	local every = Config.Sponsors.cosmeticEvery
	local left = 0
	for _, id in ipairs(Content.LETTER_COSMETICS) do
		if not data.owned[id] then
			left += 1
		end
	end
	return {
		waiting = data.letters.waiting,
		from = from,
		perLetter = per,
		next = nxt and { name = nxt.name, stat = nxt.stat, need = nxt.need, have = data.stats[nxt.stat] or 0 } or nil,
		cosmeticIn = left > 0 and (every - data.letters.claimed % every) or nil,
	}
end

local function deliverLetters(player: Player, data: any)
	local n = Sponsors.accrue(data.letters, TimeUtil.day(os.time()), Config.Sponsors.maxStack)
	if n > 0 then
		ProgressService.markDirty(player)
		ctx.toast(player, string.format("✉️ %d sponsor letter%s arrived! Open Letters.", data.letters.waiting, data.letters.waiting == 1 and "" or "s"), "good")
	end
end

local function claimLetters(player: Player): (boolean, string?)
	local data = ProgressService.dataOf(player)
	if not data then
		return false, nil
	end
	if data.letters.waiting <= 0 then
		return false, "No letters waiting. The next one arrives tomorrow."
	end
	local signed = Sponsors.earned(Content.PATRONS :: any, letterStats(data))
	local pkg = Sponsors.claim(data.letters, signed, Content.LETTER_COSMETICS, Config.Sponsors.cosmeticEvery, data.owned)
	giveXp(player, data, pkg.renown)
	data.favorBank = math.min(Config.Sponsors.favorCap, (data.favorBank or 0) + pkg.favor)
	local extra = ""
	for _, id in ipairs(pkg.cosmetics) do
		data.owned[id] = true
		local nm = Content.TITLES[id] or (Content.FADES[id] and Content.FADES[id].name) or id
		extra ..= " + " .. nm
	end
	ctx.push(player, "letters", { letters = pkg.letters, renown = pkg.renown, favor = pkg.favor, cosmetics = pkg.cosmetics, from = pkg.from })
	ProgressService.markDirty(player)
	ProgressService.sendState(player)
	return true, string.format("Opened %d letter%s: +%d %s, +%d %s banked%s", pkg.letters, pkg.letters == 1 and "" or "s", pkg.renown, Names.XP, pkg.favor, Names.FAVOR, extra)
end

-- Gallery asks for the banked head start when a player sits down.
function ProgressService.takeFavorBank(player: Player): number
	local data = ProgressService.dataOf(player)
	if not data or not data.favorBank or data.favorBank <= 0 then
		return 0
	end
	local n = data.favorBank
	data.favorBank = 0
	ProgressService.markDirty(player)
	return n
end

-- ===== v5: onboarding, comeback, festival, funnels =====
-- Onboarding funnel (server-only; Roblox ignores Studio and client events). One-time per user.
function ProgressService.funnel(player: Player, stepName: string)
	local n = Funnel.step(Funnel.ONBOARDING_STEPS, stepName)
	if n then
		pcall(function()
			AnalyticsService:LogOnboardingFunnelStepEvent(player, n, stepName)
		end)
	end
end

function ProgressService.onboardingView(data: any): any
	local cur = Onboarding.current(data.onboarding, data.stats.matches)
	if not cur then
		return nil
	end
	local n, total = Onboarding.progress(data.onboarding)
	return {
		title = cur.title,
		tip = cur.tip,
		done = n,
		total = total,
		reward = string.format(Onboarding.COPY.reward, Onboarding.totalXp()),
		rewardName = Onboarding.REWARD.name,
		skipAsk = Onboarding.COPY.skipAsk,
		skipYes = Onboarding.COPY.skipYes,
		skipNo = Onboarding.COPY.skipNo,
	}
end

-- v6: Settings shows "Reopen" while the checklist is unfinished and hidden (skipped or timed out).
function ProgressService.checklistView(data: any): any
	return {
		canReopen = Onboarding.canReopen(data.onboarding, data.stats.matches),
		finished = data.onboarding.finished,
		skipped = data.onboarding.skipped == true,
		rewardName = Onboarding.REWARD.name,
	}
end

local function onboardSkip(player: Player): (boolean, string?)
	local data = ProgressService.dataOf(player)
	if not data or not Onboarding.skip(data.onboarding) then
		return false, nil
	end
	ProgressService.markDirty(player)
	task.defer(ProgressService.sendState, player)
	return true, Onboarding.COPY.skipped
end

local function onboardReopen(player: Player): (boolean, string?)
	local data = ProgressService.dataOf(player)
	if not data or not Onboarding.reopen(data.onboarding, data.stats.matches) then
		return false, nil
	end
	ProgressService.markDirty(player)
	task.defer(ProgressService.sendState, player)
	return true, Onboarding.COPY.reopened
end
ProgressService.onboardSkip = onboardSkip
ProgressService.onboardReopen = onboardReopen

-- A new contender did one of the checklist things (open a crate, pick up a weapon, ...).
function ProgressService.onboard(player: Player, event: string)
	local data = ProgressService.dataOf(player)
	if not data or not Onboarding.active(data.onboarding, data.stats.matches) then
		return
	end
	local done = Onboarding.mark(data.onboarding, event)
	if #done == 0 then
		return
	end
	for _, st in ipairs(done) do
		giveXp(player, data, st.xp)
		ProgressService.funnel(player, st.event)
		local nextStep = Onboarding.current(data.onboarding, data.stats.matches)
		ctx.push(player, "onboard", {
			done = st.title,
			xp = st.xp,
			nextTitle = nextStep and nextStep.title or nil,
			nextTip = nextStep and nextStep.tip or nil,
			finished = data.onboarding.finished,
			line = data.onboarding.finished and Content.RUSTY.onboardDone or nil,
			reward = data.onboarding.finished and Onboarding.REWARD.name or nil,
		})
	end
	if Onboarding.claimReward(data.onboarding) then
		data.owned[Onboarding.REWARD.id] = true
		ctx.toast(player, Onboarding.COPY.done, "good")
	end
	ProgressService.markDirty(player)
	task.defer(ProgressService.sendState, player)
end

function ProgressService.festivalView(data: any): any
	local e = Events.active(os.time())
	if not e then
		return nil
	end
	local p = Events.progressFor(data.festival, e, Events.yearOf(os.time()))
	local rewards = {}
	for _, r in ipairs(Events.REWARDS[e.id] or {}) do
		local it = Store.byId[r.id]
		table.insert(rewards, { id = r.id, name = it and it.name or r.id, label = r.label, got = p.got[r.id] == true })
	end
	local _, finish = Events.window(e, Events.yearOf(os.time()))
	return { id = e.id, name = e.name, blurb = e.blurb, rewards = rewards, matches = p.matches, endsIn = finish - os.time() }
end

-- On join: Rusty's welcome-back letter, Favor and a Homecoming bonus after 3+ days away.
local function checkComeback(player: Player, data: any)
	local sw = Store.seasonWeek(Store.week(os.time()))
	local tier = SeasonTrack.tierFor(data.season.stars, Config.STARS_PER_TIER)
	local w = Comeback.onJoin(data.comeback, today(), sw, tier)
	if not w then
		return
	end
	data.favorBank = math.min(Config.Sponsors.favorCap, (data.favorBank or 0) + w.favor)
	ctx.push(player, "welcomeBack", {
		days = w.days,
		favor = w.favor,
		matches = w.matches,
		catchUpTier = w.catchUpTier,
		line = Content.RUSTY.welcomeBack,
		festival = (function(): string?
			local e = Events.active(os.time())
			return if e then e.name else nil
		end)(),
	})
	ProgressService.markDirty(player)
end

-- Called once per contender when their match ends (knocked out or at the podium).
function ProgressService.award(player: Player, r: MatchResult): any
	local data = ProgressService.dataOf(player)
	if not data then
		return {}
	end
	ensurePeriodic(data)
	-- v4 Mastery: +1 per finished match for each weapon look you have equipped (free progress)
	for _, slot in ipairs(Mastery.SLOTS) do
		ProgressService.addMastery(player, slot, data.equipped[slot] or "", Mastery.PER_MATCH)
	end
	local prevBest = data.stats.bestPlace
	local playCount = Leveling.playStreak(data.play, os.time(), Config.PLAY_STREAK_WINDOW)
	local playMult = Leveling.playMult(playCount, Config.PLAY_STREAK_STEP, Config.PLAY_STREAK_MAX)
	local base = Award.baseXp(r :: any, Config.XP)
	local homecoming = Comeback.useMatch(data.comeback) -- v5: +50% for 3 matches after time away
	local mult = playMult * ProgressService.boostMult(player, data) + homecoming
	local xp = math.floor(base * mult)
	local levels = giveXp(player, data, xp)
	-- Season stars (v5: doubled while catching up after 14+ days away, never past a weekly pace)
	local stars = Award.stars(r.place, Config.STARS, r.bonusStars)
	stars *= Comeback.starMult(data.comeback, SeasonTrack.tierFor(data.season.stars, Config.STARS_PER_TIER))
	local tiersUp = SeasonTrack.addStars(data.season, stars, Config.STARS_PER_TIER)
	-- Daily streak counts on the first finished match of the day
	local streakMsg: string? = nil
	if Streak.canClaim(data.streak, today()) then
		local res = Streak.claim(data.streak, today())
		if res.ok then
			local bonus = math.floor(Config.DAILY_STREAK_XP * Streak.rewardScale(res.count))
			giveXp(player, data, bonus)
			streakMsg = string.format("Day %d streak! +%d %s", res.count, bonus, Names.XP)
			if res.usedFreeMiss then
				streakMsg = tostring(streakMsg) .. " (free miss used)"
			end
		end
	end
	-- Stats + challenges
	local st = data.stats
	st.matches += 1
	st.knocks += r.knocks
	if r.encore then
		st.encores += 1
	end
	if r.place == 1 then
		st.wins += 1
	end
	if r.place <= 10 then
		st.top10 += 1
	end
	if r.place <= 5 then
		st.top5 += 1
	end
	if st.bestPlace == 0 or r.place < st.bestPlace then
		st.bestPlace = r.place
	end
	local done = {}
	local function add(stat: string, n: number)
		if n > 0 then
			for _, d in ipairs(Challenges.bump(data.daily, stat, n)) do
				table.insert(done, d)
			end
			for _, d in ipairs(Challenges.bump(data.weekly, stat, n)) do
				table.insert(done, d)
			end
		end
	end
	add("matches", 1)
	add("top10", r.place <= 10 and 1 or 0)
	add("top5", r.place <= 5 and 1 or 0)
	add("wins", r.place == 1 and 1 or 0)
	add("survive5", r.survived >= 300 and 1 or 0)
	add("partnermatches", r.partner and 1 or 0)
	add("encore", r.encore and 1 or 0)
	finishChallenges(player, data, done)
	-- v5: first matches, festival rewards
	if st.matches == 1 then
		ProgressService.funnel(player, "first_match")
	elseif st.matches == 2 then
		ProgressService.funnel(player, "second_match")
	end
	if st.matches == Onboarding.HIDE_AFTER_MATCHES then
		ProgressService.grant(player, "sash_homecoming", "Five matches in! Rusty pins a Homecoming Sash on you.")
	end
	local fest = Events.active(os.time())
	if fest then
		local p = Events.progressFor(data.festival, fest, Events.yearOf(os.time()))
		data.festival = p
		for _, id in ipairs(Events.recordMatch(p, today(), r.archive == true and r.place <= 5)) do
			local it = Store.byId[id]
			ProgressService.grant(player, id, fest.name .. " reward: " .. (it and it.name or id) .. "!")
		end
	end
	-- Reach loyalty
	if data.reach ~= "" then
		local pts = ReachStandings.pointsFor(r.place, r.knocks)
		data.reachPlayedWeek = week()
		ProgressService.addReachPoints(data.reach, pts)
	end
	ProgressService.markDirty(player)
	task.defer(ProgressService.sendState, player)
	return {
		xp = xp,
		playStreak = playCount,
		playMult = playMult,
		levels = levels,
		level = data.level,
		stars = stars,
		tiersUp = tiersUp,
		streakMsg = streakMsg,
		prevBest = prevBest,
		homecoming = homecoming > 0 and data.comeback.homecoming or nil,
	}
end

function ProgressService.addReachPoints(reach: string, pts: number)
	if pts <= 0 or not Names.reachIndex(reach) then
		return
	end
	-- private servers don't count toward the public Reach standings (no farming)
	if game.PrivateServerId ~= "" and game.PrivateServerOwnerId ~= 0 then
		return
	end
	ReachStandings.add(ProgressService.reachTable, reach, pts)
	local store = reachStore
	if store then
		task.spawn(function()
			pcall(function()
				store:IncrementAsync(reach, pts)
			end)
		end)
	end
end

local function refreshReachTable()
	local store = reachStore
	if not store then
		return
	end
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, 24)
	end)
	if ok and pages then
		local page = pages:GetCurrentPage()
		local tbl = {}
		for _, row in ipairs(page) do
			tbl[row.key] = row.value
		end
		ProgressService.reachTable = tbl
	end
end

-- Last week's top 3 Reaches give a banner to everyone who repped them that week.
local function grantBanners(player: Player, data: any)
	local last = week() - 1
	if data.reachPlayedWeek ~= last or data.reach == "" then
		return
	end
	local ok, pages = pcall(function()
		return DataStoreService:GetOrderedDataStore("ReachWeek_" .. last):GetSortedAsync(false, 3)
	end)
	if not ok or not pages then
		return
	end
	local tbl = {}
	for _, row in ipairs(pages:GetCurrentPage()) do
		tbl[row.key] = row.value
	end
	for i, reach in ipairs(ReachStandings.banners(tbl)) do
		if reach == data.reach then
			local id = string.format("banner_w%d_%s", last, (reach:lower():gsub("%s+", "_")))
			if not data.owned[id] then
				data.owned[id] = true
				ctx.toast(player, string.format("%s placed #%d last week! You earned its banner.", reach, i), "good")
				ProgressService.markDirty(player)
			end
		end
	end
end

-- ===== client intents =====
local function claimTier(player: Player, tier: any, lane: any): (boolean, string?)
	local data = ProgressService.dataOf(player)
	if not data or type(tier) ~= "number" or type(lane) ~= "string" then
		return false, nil
	end
	local reward, why = SeasonTrack.claim(data.season, math.floor(tier), lane, ProgressService.hasPass(player, "PremiumLane"), Config.STARS_PER_TIER)
	if not reward then
		return false, why
	end
	if reward.kind == "renown" then
		giveXp(player, data, reward.amount or 0)
	else
		data.owned[reward.id] = true
	end
	ProgressService.markDirty(player)
	ProgressService.sendState(player)
	return true, "Claimed: " .. reward.name
end

local function prestige(player: Player): (boolean, string?)
	local data = ProgressService.dataOf(player)
	if not data then
		return false, nil
	end
	if not Leveling.prestige(data, Config.LEVEL_CAP, Config.PRESTIGE_CAP) then
		return false, "Reach level " .. Config.LEVEL_CAP .. " to prestige."
	end
	data.owned["frame_rank" .. data.prestige] = true
	ProgressService.markDirty(player)
	ProgressService.sendState(player)
	return true, "You are now " .. Names.rank(data.prestige) .. "! New frame unlocked."
end

local function setReach(player: Player, reach: any): (boolean, string?)
	local data = ProgressService.dataOf(player)
	if not data or type(reach) ~= "string" or not Names.reachIndex(reach) then
		return false, nil
	end
	if data.reach == reach then
		return true, nil
	end
	if data.reach ~= "" and not ReachStandings.canChange(data.reachWeek, week()) then
		return false, "You can change your home " .. Names.REGION .. " once a week."
	end
	data.reach = reach
	data.reachWeek = week()
	ProgressService.markDirty(player)
	ProgressService.sendState(player)
	return true, "Home " .. Names.REGION .. ": " .. reach
end

local function setting(player: Player, key: any, value: any): (boolean, string?)
	local data = ProgressService.dataOf(player)
	if not data then
		return false, nil
	end
	local ok, clean = Prefs.sanitize(key, value)
	if not ok then
		return false, nil
	end
	data.settings[key] = clean
	ProgressService.markDirty(player)
	ProgressService.sendState(player)
	return true, nil
end

local function setQuip(player: Player, i: any): (boolean, string?)
	local data = ProgressService.dataOf(player)
	if not data or type(i) ~= "number" or not Content.QUIPS[i] then
		return false, nil
	end
	data.quip = math.floor(i)
	ProgressService.markDirty(player)
	ProgressService.sendState(player)
	return true, nil
end

local function equip(player: Player, slot: any, id: any): (boolean, string?)
	local data = ProgressService.dataOf(player)
	if not data or type(slot) ~= "string" or type(id) ~= "string" then
		return false, nil
	end
	if slot ~= "title" and not table.find(Store.SLOTS, slot) then
		return false, nil
	end
	local vipTag = id == "tag_vip" and slot == "nametag" and ProgressService.hasPass(player, "VIP")
	if id ~= "" and id ~= "fade_gold" and not vipTag and not data.owned[id] then
		return false, "Not owned yet."
	end
	local it = Store.byId[id]
	if it and it.slot ~= slot then
		return false, nil
	end
	data.equipped[slot] = id
	ProgressService.markDirty(player)
	ProgressService.sendState(player)
	if slot == "nametag" or slot == "banner" then
		ProgressService.applyNametag(player)
	elseif slot == "bow" or slot == "spear" or slot == "knife" then
		ctx.Match.refreshHeld(player)
	end
	return true, nil
end

-- Custom nametag (Item Shop / Spire VIP) and Reach banner over the head. Short range, not
-- always-on-top, so it never gives away positions in the arena.
function ProgressService.applyNametag(player: Player)
	local data = ProgressService.dataOf(player)
	local char = player.Character
	if not data or not char then
		return
	end
	local head = char:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("DaybreakTag")
	if old then
		old:Destroy()
	end
	local id = data.equipped.nametag or ""
	local color: string? = nil
	if id == "tag_vip" and ProgressService.hasPass(player, "VIP") then
		color = "#FFD36B"
	elseif Store.byId[id] and data.owned[id] then
		color = Store.byId[id].color
	end
	local banner = Store.byId[data.equipped.banner or ""]
	if not color and not banner and not ProgressService.mastered(data) then
		return
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "DaybreakTag"
	bb.Size = UDim2.new(0, 220, 0, 46)
	bb.StudsOffset = Vector3.new(0, 2.4, 0)
	bb.MaxDistance = 45
	bb.AlwaysOnTop = false
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.new(1, 0, 0, 26)
	name.Font = Enum.Font.FredokaOne
	name.TextScaled = true
	name.TextStrokeTransparency = 0.4
	name.TextColor3 = Color3.fromHex(color or "#FFFFFF")
	name.Text = player.DisplayName .. (ProgressService.mastered(data) and " ✦" or "")
	name.Parent = bb
	if banner then
		local b = Instance.new("TextLabel")
		b.BackgroundTransparency = 1
		b.Position = UDim2.new(0, 0, 0, 26)
		b.Size = UDim2.new(1, 0, 0, 18)
		b.Font = Enum.Font.GothamMedium
		b.TextScaled = true
		b.TextStrokeTransparency = 0.5
		b.TextColor3 = Color3.fromHex("#E8D9B5")
		b.Text = banner.icon .. " " .. banner.name
		b.Parent = bb
	end
	bb.Parent = head
end

-- Emotes (B key): lobby, Gallery and podium only, never while you're fighting.
local lastEmote: { [Player]: number } = {}
local function emote(player: Player, id: any): (boolean, string?)
	local data = ProgressService.dataOf(player)
	if not data then
		return false, nil
	end
	if type(id) ~= "string" or id == "" then
		id = data.equipped.emote or ""
	end
	local it = Store.byId[id]
	if not it or it.slot ~= "emote" or not data.owned[id] then
		return false, "Pick an emote in the Locker first."
	end
	local mine = ctx.Match.contenderOf(player)
	if mine and mine.alive and ctx.Match.state == "Arena" then
		return false, "Emotes are for the lobby and the Gallery."
	end
	local t = os.clock()
	if lastEmote[player] and t - lastEmote[player] < 3 then
		return false, nil
	end
	lastEmote[player] = t
	local clip = it.clip or it.id
	ctx.pushAll("emote", { user = player.UserId, icon = it.icon, name = it.name, color = it.color, clip = Anim.CLIPS[clip] and clip or nil, uploaded = it.anim ~= nil and it.anim ~= 0 })
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if animator and it.anim and it.anim ~= 0 then
		local a = Instance.new("Animation")
		a.AnimationId = "rbxassetid://" .. it.anim
		pcall(function()
			animator:LoadAnimation(a):Play()
		end)
	end
	return true, nil
end

local function seenReaping(player: Player): (boolean, string?)
	local data = ProgressService.dataOf(player)
	if data and not data.seenReaping then
		data.seenReaping = true
		ProgressService.markDirty(player)
	end
	return true, nil
end

local function onLoaded(player: Player, profile: any, isNew: boolean)
	local data = profile.data
	ensurePeriodic(data)
	ProgressService.runtime[player] = { passes = ctx.Purchase.loadPasses(player), dirty = false }
	task.spawn(function()
		ctx.Purchase.checkSubscription(player)
		ctx.Purchase.memberPerk(player)
		checkReferral(player, data)
		if player.Parent then
			ProgressService.sendState(player)
		end
	end)
	deliverLetters(player, data)
	checkComeback(player, data)
	if isNew then
		ProgressService.funnel(player, "joined")
	end
	ProgressService.sendState(player)
	player.CharacterAdded:Connect(function()
		task.wait(1)
		ProgressService.applyNametag(player)
	end)
	ProgressService.applyNametag(player)
	if isNew then
		ctx.toast(player, "Welcome to " .. Names.CAPITAL:gsub("^the ", "the ") .. ". Pick your home " .. Names.REGION .. " on the board!", "good")
	end
	task.spawn(grantBanners, player, data)
end

function ProgressService.init(c: any)
	ctx = c
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore("ReachWeek_" .. week())
	end)
	if ok then
		reachStore = store
	end
	ctx.handle("claimTier", claimTier)
	ctx.handle("prestige", prestige)
	ctx.handle("setReach", setReach)
	ctx.handle("setting", setting)
	ctx.handle("onboardSkip", onboardSkip)
	ctx.handle("onboardReopen", onboardReopen)
	ctx.handle("quip", setQuip)
	ctx.handle("equip", equip)
	ctx.handle("emote", emote)
	ctx.handle("seenReaping", seenReaping)
	ctx.handle("claimLetters", claimLetters)
	ctx.handle("shared", function(player: Player): (boolean, string?)
		local data = ProgressService.dataOf(player)
		if data then
			data.shared = (data.shared or 0) + 1
			ProgressService.markDirty(player)
		end
		return true, nil
	end)
	ctx.handle("refresh", function(player: Player): (boolean, string?)
		ProgressService.sendState(player)
		return true, nil
	end)
end

function ProgressService.start()
	ctx.Data.onLoaded.Event:Connect(onLoaded)
	Players.PlayerAdded:Connect(function(player)
		ctx.Data.load(player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(ctx.Data.load, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		ctx.Match.onLeave(player)
		ctx.Data.release(player)
		ProgressService.runtime[player] = nil
		lastEmote[player] = nil
	end)
	task.spawn(function()
		while true do
			refreshReachTable()
			for _, p in ipairs(Players:GetPlayers()) do
				local d = ProgressService.dataOf(p)
				if d then
					deliverLetters(p, d)
					tickDailyTen(p, d, 60)
				end
			end
			task.wait(60)
		end
	end)
end

local _ = Monetization
return ProgressService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">PurchaseService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PurchaseService — Game Passes and Developer Products.
	  * ProcessReceipt is idempotent: each PurchaseId is recorded in the player's save
	    (ReceiptLedger) and the save must succeed before we tell Roblox "PurchaseGranted".
	  * IDs live in ReplicatedStorage.Shared.Monetization. Items with id 0 are hidden in the
	    live game; in Studio they get a free "Studio test" grant so you can try everything.
	  * Nothing sold here is random. Robux never buys Favor, Stars or tiers.
	  * PolicyService: each player's store rules are read with GetPolicyInfoForPlayerAsync
	    (in pcall, with retries). The shop stays hidden until that loads (fail closed), and any
	    item marked random/tradable is withheld where the policy says so (Logic/Policy.luau).
	    The Patron Club subscription also needs IsEligibleToPurchaseSubscription.
	  * v3 Item Shop (Store.luau): one developer product per price point. The player's choice is
	    saved as an "intent" before the prompt; a receipt with no matching intent becomes a Shop
	    Voucher, so a purchase is never lost. Gifts go to a friend in the same server; if they
	    leave first, the buyer gets the voucher.
]]
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local PolicyService = game:GetService("PolicyService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Monetization = require(Shared.Monetization)
local ReceiptLedger = require(Shared.Logic.ReceiptLedger)
local Policy = require(Shared.Logic.Policy)
local Store = require(Shared.Store)
local Names = require(Shared.Names)
local Content = require(Shared.Content)
local Offers = require(Shared.Offers)
local Funnel = require(Shared.Logic.Funnel)
local Events = require(Shared.Logic.Events)
local AnalyticsService = game:GetService("AnalyticsService")

-- v5: first-purchase funnel (shop_open > item_view > try_on > prompt > purchase), one session per
-- shop visit, logged only until the player's first purchase. Server-side only, as Roblox requires.
local shopOpens: { [Player]: number } = {}
local function funnel(player: Player, data: any, step: string)
	if data and (data.spent or 0) > 0 and step ~= "purchase" then
		return
	end
	local n = Funnel.step(Funnel.SHOP_STEPS, step)
	if not n then
		return
	end
	if (step :: string) == "shop_open" then
		shopOpens[player] = (shopOpens[player] or 0) + 1
	end
	local session = Funnel.session(player.UserId, shopOpens[player] or 1)
	pcall(function()
		AnalyticsService:LogFunnelStepEvent(player, Funnel.SHOP, session, n, step)
	end)
end
Store.addReachPride(Names.REACH_LIST)

local PurchaseService = {}
local ctx: any = nil
local RECEIPT_MEMORY = 50
local IS_STUDIO = RunService:IsStudio()

local productById: { [number]: string } = {}
local passById: { [number]: string } = {}
for key, p in pairs(Monetization.Products) do
	if p.id ~= 0 then
		productById[p.id] = key
	end
end
for key, p in pairs(Monetization.Passes) do
	if p.id ~= 0 then
		passById[p.id] = key
	end
end

local policies: { [Player]: Policy.Info } = {}

function PurchaseService.policyOf(player: Player): Policy.Info
	return policies[player] or Policy.unknown()
end

-- Read the player's store rules. Three tries, then stay closed (Studio falls back to open so
-- you can test the shop offline).
function PurchaseService.loadPolicy(player: Player)
	for attempt = 1, 3 do
		local ok, raw = pcall(function()
			return PolicyService:GetPolicyInfoForPlayerAsync(player)
		end)
		if ok and type(raw) == "table" then
			policies[player] = Policy.fromRaw(raw)
			return
		end
		task.wait(2 * attempt)
		if not player.Parent then
			return
		end
	end
	if IS_STUDIO then
		policies[player] = Policy.fromRaw({ ArePaidRandomItemsRestricted = true, IsPaidItemTradingAllowed = false })
	else
		policies[player] = Policy.unknown()
		warn("[PurchaseService] PolicyService unavailable for " .. player.Name .. "; shop stays hidden")
	end
end

function PurchaseService.availability(player: Player?): any
	local pol = if player then PurchaseService.policyOf(player) else Policy.unknown()
	local out = { products = {}, passes = {}, studio = IS_STUDIO, visible = Policy.shopVisible(pol), catalog = { passes = {}, products = {} } }
	for key, p in pairs(Monetization.Products) do
		out.products[key] = (p.id ~= 0 or IS_STUDIO) and Policy.canSell(pol, p :: any)
		out.catalog.products[key] = { name = p.name, price = p.price, desc = p.desc, icon = p.icon, category = p.category }
	end
	for key, p in pairs(Monetization.Passes) do
		out.passes[key] = (p.id ~= 0 or IS_STUDIO) and Policy.canSell(pol, p :: any)
		out.catalog.passes[key] = { name = p.name, price = p.price, desc = p.desc, icon = p.icon }
	end
	local sub = Monetization.Subscriptions.PatronClub
	out.subscription = {
		name = sub.name,
		price = sub.price,
		desc = sub.desc,
		icon = sub.icon,
		perks = sub.perks,
		available = (sub.id ~= "" or IS_STUDIO) and Policy.canSell(pol, { subscription = true }),
		active = player ~= nil and PurchaseService.isPatron(player),
	}
	out.privateServerPrice = Monetization.PRIVATE_SERVER_PRICE
	out.member = player ~= nil and PurchaseService.isMember(player)
	out.memberItem = Store.memberItemFor(tonumber(os.date("!%Y%m")) or 0)
	out.plusAvailable = Policy.shopVisible(pol)
	return out
end

function PurchaseService.isPatron(player: Player): boolean
	local r = ctx.Progress.runtime[player]
	return r ~= nil and r.sub == true
end

-- The Item Shop view for one player: this week's rotation, always-on shelves, bundles.
function PurchaseService.shopView(player: Player): any
	local data = ctx.Progress.dataOf(player)
	local wk = Store.week(os.time())
	local owned = data and data.owned or {}
	local flags = data and data.shopFlags or {}
	local function card(it: any): any
		local ok, why = Store.canReceive(assert(Store.offer("item", it.id)), owned, wk, flags)
		return { id = it.id, name = it.name, cat = it.cat, slot = it.slot, price = it.price, icon = it.icon, color = it.color, desc = it.desc, rot = it.rot, owned = owned[it.id] == true, canBuy = ok, why = why }
	end
	local featured = {}
	for _, it in ipairs(Store.rotation(wk)) do
		table.insert(featured, card(it))
	end
	local shelves = {}
	for _, it in ipairs(Store.ITEMS) do
		if not it.rot and not it.earned and not it.event then
			shelves[it.cat] = shelves[it.cat] or {}
			table.insert(shelves[it.cat], card(it))
		end
	end
	local bundles = {}
	for _, b in ipairs(Store.BUNDLES) do
		local o = assert(Store.offer("bundle", b.id))
		local ok, why = Store.canReceive(o, owned, wk, flags)
		local _, saving = Store.anchor(b, owned)
		table.insert(bundles, { id = b.id, name = b.name, price = b.price, icon = b.icon, desc = b.desc, value = Store.value(b, nil), missing = Store.value(b, owned), saving = saving, canBuy = ok, why = why, once = b.once, count = #b.items, event = b.event })
	end
	-- v5: the festival shelf (only while the festival is on; it comes back every year)
	local fest = nil
	local ev = Events.active(os.time())
	if ev then
		local items = {}
		for _, it in ipairs(Store.ITEMS) do
			if it.event == ev.id and not it.earned then
				table.insert(items, card(it))
			end
		end
		fest = { name = ev.name, blurb = ev.blurb, items = items }
	end
	local nextWeek = Store.weekStart(wk + 1)
	-- v4: what's coming next week (names only, so players can plan; no countdown copy)
	local upcoming = {}
	for _, it in ipairs(Store.rotation(wk + 1)) do
		table.insert(upcoming, { id = it.id, name = it.name, icon = it.icon, color = it.color, new = it.drop ~= nil and not Store.released(it, wk) })
	end
	local dropNow = Store.dropOf(wk)
	local dropNext = Store.dropOf(wk + 1)
	return {
		week = wk,
		upcoming = upcoming,
		festival = fest,
		dropName = dropNow and Store.DROP_NAMES[dropNow] or nil,
		nextDropName = dropNext and Store.DROP_NAMES[dropNext] or nil,
		mastery = data and data.mastery or {},
		changesOn = os.date("!%A %b %d", nextWeek),
		cycle = Store.cycleWeeks(),
		featured = featured,
		shelves = shelves,
		bundles = bundles,
		vouchers = data and data.vouchers or {},
		spent = data and data.spent or 0,
		log = data and data.buyLog or {},
		isNew = data ~= nil and data.shopSeenWeek ~= wk,
		isPrivate = game.PrivateServerId ~= "" and game.PrivateServerOwnerId ~= 0,
		psOwner = game.PrivateServerOwnerId == player.UserId and player.UserId ~= 0,
	}
end

function PurchaseService.loadPasses(player: Player): { [string]: boolean }
	local owned = {}
	for key, p in pairs(Monetization.Passes) do
		if p.id ~= 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, p.id)
			end)
			if ok and has then
				owned[key] = true
			end
		end
	end
	local data = ctx.Progress.dataOf(player)
	if IS_STUDIO and data then
		for key in pairs(Monetization.Passes) do
			if data.owned["pass:" .. key] then
				owned[key] = true
			end
		end
	end
	return owned
end

local function grantProduct(player: Player, data: any, key: string): string
	local p = Monetization.Products[key]
	if p.kind == "boost" then
		ctx.Progress.addBoost(data, p.minutes or 30, Config.FairPlay.boostMult)
		-- Fair Play: everyone else in the server gets a free Renown Shower.
		for _, other in ipairs(Players:GetPlayers()) do
			local od = other ~= player and ctx.Progress.dataOf(other) or nil
			if od and od.boost.untilT <= os.time() then
				ctx.Progress.addBoost(od, Config.FairPlay.showerMinutes, Config.FairPlay.showerMult)
				ctx.toast(other, string.format("✨ Renown Shower from %s! +%d%% Renown for %d min.", player.DisplayName, math.floor(Config.FairPlay.showerMult * 100), Config.FairPlay.showerMinutes), "good")
			end
		end
	elseif p.kind == "skip" then
		ctx.Progress.skipTiers(player, p.tiers or 1)
	end
	ctx.Progress.markDirty(player)
	ctx.Progress.sendState(player)
	return "Thanks! " .. p.icon .. " " .. p.name .. " is yours."
end

local function grantPass(player: Player, key: string)
	local r = ctx.Progress.runtime[player]
	if not r then
		return
	end
	r.passes[key] = true
	ctx.toast(player, "Thanks! " .. Monetization.Passes[key].icon .. " " .. Monetization.Passes[key].name .. " is active.", "good")
	ctx.Progress.sendState(player)
end

local function prompt(player: Player, kind: any, key: any): (boolean, string?)
	local data = ctx.Progress.dataOf(player)
	if not data or type(kind) ~= "string" or type(key) ~= "string" then
		return false, nil
	end
	local pol = PurchaseService.policyOf(player)
	if not Policy.shopVisible(pol) then
		return false, "The shop is still loading."
	end
	if kind == "pass" then
		local p = Monetization.Passes[key]
		if not p then
			return false, "Not found."
		end
		if not Policy.canSell(pol, p :: any) then
			return false, "Not available in your region."
		end
		if ctx.Progress.hasPass(player, key) then
			return false, "You already have this."
		end
		if p.id == 0 then
			if IS_STUDIO then
				data.owned["pass:" .. key] = true
				grantPass(player, key)
				return true, "Studio test: pass granted for free (only in Studio)."
			end
			return false, "Not on sale yet."
		end
		MarketplaceService:PromptGamePassPurchase(player, p.id)
		return true, nil
	end
	local p = Monetization.Products[key]
	if not p then
		return false, "Not found."
	end
	if not Policy.canSell(pol, p :: any) then
		return false, "Not available in your region."
	end
	if p.kind == "shop" then
		return false, "Pick an item in the shop."
	end
	if p.id == 0 then
		if IS_STUDIO then
			return true, "Studio test (free): " .. grantProduct(player, data, key)
		end
		return false, "Not on sale yet."
	end
	MarketplaceService:PromptProductPurchase(player, p.id)
	return true, nil
end

local function logBuy(data: any, name: string, price: number, gift: string?)
	data.spent = (data.spent or 0) + price
	data.buyLog = data.buyLog or {}
	table.insert(data.buyLog, 1, { t = os.time(), name = name, price = price, gift = gift })
	while #data.buyLog > 20 do
		table.remove(data.buyLog)
	end
end

local function friendInServer(player: Player, userId: any): Player?
	if type(userId) ~= "number" or userId == player.UserId then
		return nil
	end
	local other = Players:GetPlayerByUserId(userId)
	if not other then
		return nil
	end
	local ok, friends = pcall(function()
		return player:IsFriendsWithAsync(userId)
	end)
	if ok and friends then
		return other
	end
	return nil
end

-- Grant an offer to `to` (or the buyer). Returns the toast text.
local function deliver(buyer: Player, buyerData: any, o: Store.Offer, toId: number?): string
	if toId then
		local other = Players:GetPlayerByUserId(toId)
		local od = other and ctx.Progress.dataOf(other)
		if other and od and Store.canReceive(o, od.owned, Store.week(os.time()), od.shopFlags) then
			Store.grant(o, od.owned, od.shopFlags)
			ctx.Progress.markDirty(other)
			ctx.Progress.sendState(other)
			ctx.toast(other, string.format("🎁 %s sent you %s %s!", buyer.DisplayName, o.icon, o.name), "good")
			logBuy(buyerData, o.name, o.price, other.DisplayName)
			return string.format("Gift sent! %s now has %s.", other.DisplayName, o.name)
		end
		Store.addVoucher(buyerData.vouchers, o.price)
		logBuy(buyerData, "Shop Voucher (gift couldn't be delivered)", o.price, nil)
		return string.format("Your friend left before the gift arrived, so you got a R$ %d Shop Voucher to use on anything at that price or lower.", o.price)
	end
	Store.grant(o, buyerData.owned, buyerData.shopFlags)
	logBuy(buyerData, o.name, o.price, nil)
	return "Thanks! " .. o.icon .. " " .. o.name .. " is yours. Equip it in the Locker."
end

-- Player picked an item or bundle in the shop. Shows the Roblox prompt for that price point.
local function shopBuy(player: Player, kind: any, id: any, opts: any): (boolean, string?)
	local toId = type(opts) == "table" and opts.to or nil
	local useVoucher = type(opts) == "table" and opts.voucher == true
	local data = ctx.Progress.dataOf(player)
	if not data or type(kind) ~= "string" or type(id) ~= "string" then
		return false, nil
	end
	local pol = PurchaseService.policyOf(player)
	if not Policy.shopVisible(pol) then
		return false, "The shop is still loading."
	end
	local o = Store.offer(kind, id)
	if not o then
		return false, "Not found."
	end
	local wk = Store.week(os.time())
	local target: Player? = nil
	if toId ~= nil then
		target = friendInServer(player, toId)
		if not target then
			return false, "Gifts go to a friend who is in this server."
		end
		if o.once then
			return false, "The Starter Pack can't be gifted."
		end
		local td = ctx.Progress.dataOf(target :: Player)
		if not td then
			return false, "Your friend is still loading."
		end
		local ok, why = Store.canReceive(o, td.owned, wk, td.shopFlags)
		if not ok then
			return false, (target :: Player).DisplayName .. ": " .. tostring(why)
		end
	else
		local ok, why = Store.canReceive(o, data.owned, wk, data.shopFlags)
		if not ok then
			return false, why
		end
	end
	local toUser = target and (target :: Player).UserId or nil
	if useVoucher then
		if not Store.useVoucher(data.vouchers, o.price) then
			return false, "No voucher covers this price."
		end
		local msg = deliver(player, data, o, toUser)
		data.spent -= o.price -- vouchers were already counted when paid
		ctx.Progress.markDirty(player)
		ctx.Progress.sendState(player)
		return true, msg
	end
	local key = Store.tierKey(o.price)
	local product = key and Monetization.Products[key]
	if not product then
		return false, "Not on sale."
	end
	if product.id == 0 then
		if IS_STUDIO then
			local msg = deliver(player, data, o, toUser)
			ctx.Progress.markDirty(player)
			ctx.Progress.sendState(player)
			return true, "Studio test (free): " .. msg
		end
		return false, "Not on sale yet."
	end
	data.intent = { kind = o.kind, id = o.id, price = o.price, to = toUser, t = os.time() }
	ctx.Progress.markDirty(player)
	funnel(player, data, "prompt")
	MarketplaceService:PromptProductPurchase(player, product.id)
	return true, nil
end

local function grantShopReceipt(player: Player, data: any, key: string): string
	local p = Monetization.Products[key]
	local intent = Store.matchIntent(data.intent, p.price, os.time())
	data.intent = nil
	local o = intent and Store.offer(intent.kind, intent.id)
	if not o then
		Store.addVoucher(data.vouchers, p.price)
		logBuy(data, "Shop Voucher", p.price, nil)
		return string.format("You have a R$ %d Shop Voucher. Use it on any item at that price or lower.", p.price)
	end
	local firstBuy = (data.spent or 0) == 0
	local msg = deliver(player, data, o, intent and intent.to)
	if firstBuy then
		funnel(player, data, "purchase")
	end
	return msg
end

local function subscribe(player: Player): (boolean, string?)
	local sub = Monetization.Subscriptions.PatronClub
	if not Policy.canSell(PurchaseService.policyOf(player), { subscription = true }) then
		return false, "Subscriptions aren't available on this account."
	end
	if PurchaseService.isPatron(player) then
		return false, "You're already in the Patron Club."
	end
	if sub.id == "" then
		if IS_STUDIO then
			local r = ctx.Progress.runtime[player]
			if r then
				r.sub = true
			end
			PurchaseService.patronPerks(player)
			return true, "Studio test: Patron Club active for this session."
		end
		return false, "Not on sale yet."
	end
	local ok = pcall(function()
		(MarketplaceService :: any):PromptSubscriptionPurchase(player, sub.id)
	end)
	return ok, nil
end

-- Monthly perks for Patron Club members, granted once per calendar month (UTC).
function PurchaseService.patronPerks(player: Player)
	local data = ctx.Progress.dataOf(player)
	if not data or not PurchaseService.isPatron(player) then
		return
	end
	local month = tonumber(os.date("!%Y%m")) or 0
	if data.patronMonth == month then
		return
	end
	data.patronMonth = month
	data.owned["patron_seal"] = true
	data.owned["patron_cloak_" .. month] = true
	data.owned["emote_patron"] = true
	ctx.Progress.skipTiers(player, Config.FairPlay.patronSkips)
	ctx.toast(player, "📜 Patron Club: this month's cloak and 2 Tier Skips are in your Locker. Thank you!", "good")
end

function PurchaseService.checkSubscription(player: Player)
	local sub = Monetization.Subscriptions.PatronClub
	if sub.id == "" then
		return
	end
	local ok, status = pcall(function()
		return (MarketplaceService :: any):GetUserSubscriptionStatusAsync(player, sub.id)
	end)
	local r = ctx.Progress.runtime[player]
	if r then
		r.sub = ok and type(status) == "table" and status.IsSubscribed == true
	end
	PurchaseService.patronPerks(player)
end

-- ===== v4: member perk, fade preview =====
-- Roblox Plus subscribers (and legacy Premium members) get one fixed free cosmetic a month.
-- Roblox no longer runs Premium Payouts; Plus pays creators per signup and per subscriber
-- engagement instead (see PUBLISHING.md 6h), so this is the thank-you that brings them back.
function PurchaseService.isMember(player: Player): boolean
	local ok, sub = pcall(function()
		return (player :: any).HasRobloxSubscription
	end)
	if ok and sub == true then
		return true
	end
	return player.MembershipType == Enum.MembershipType.Premium
end

function PurchaseService.memberPerk(player: Player)
	local data = ctx.Progress.dataOf(player)
	if not data or not PurchaseService.isMember(player) then
		return
	end
	local month = tonumber(os.date("!%Y%m")) or 0
	if data.memberMonth == month then
		return
	end
	data.memberMonth = month
	local id = Store.memberItemFor(month)
	local it = Store.byId[id]
	data.owned[id] = true
	ctx.Progress.markDirty(player)
	ctx.toast(player, "➕ Thanks for being a Roblox member: " .. (it and it.name or id) .. " is in your Locker.", "good")
end

-- After a match with a knockout: one calm "see your knockout with this fade" card, at most
-- Offers.MAX_PER_SESSION times a session, never for accounts whose policy hides the shop.
local previewsShown: { [Player]: number } = {}
function PurchaseService.previewFor(player: Player, knocks: number): any?
	if not Policy.shopVisible(PurchaseService.policyOf(player)) then
		return nil
	end
	if (previewsShown[player] or 0) >= Offers.MAX_PER_SESSION then
		return nil
	end
	local data = ctx.Progress.dataOf(player)
	if not data then
		return nil
	end
	local card = Offers.fadePreview(data.owned, Store.week(os.time()), knocks)
	if card then
		previewsShown[player] = (previewsShown[player] or 0) + 1
		local f = Content.FADES[card.itemId or ""]
		card.style = f and f.style or "column"
		card.color = f and f.color or "#FFD36B"
	end
	return card
end

-- Roblox Plus: calm card in the shop; Roblox pays the game for each new member it brings in.
local function plus(player: Player): (boolean, string?)
	local ok = pcall(function()
		(MarketplaceService :: any):PromptRobloxSubscriptionPurchase(player)
	end)
	if not ok then
		return false, "Roblox Plus isn't available here."
	end
	return true, nil
end

local function seenShop(player: Player): (boolean, string?)
	local data = ctx.Progress.dataOf(player)
	if data then
		data.shopSeenWeek = Store.week(os.time())
		ctx.Progress.markDirty(player)
	end
	return true, nil
end

-- v5: client-reported shop steps (open, view a buy card, try on). Only names in the list count.
local function shopStep(player: Player, step: any): (boolean, string?)
	if type(step) ~= "string" or step == "prompt" or step == "purchase" then
		return false, nil
	end
	local data = ctx.Progress.dataOf(player)
	funnel(player, data, step)
	if step == "shop_open" and data and not data.shopOpenedOnce then
		data.shopOpenedOnce = true
		ctx.Progress.funnel(player, "first_shop_open")
		ctx.Progress.markDirty(player)
	end
	return true, nil
end

local function processReceipt(info: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = ctx.Data.waitFor(player, 10)
	if not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = profile.data
	local purchaseId = tostring(info.PurchaseId)
	if ReceiptLedger.has(data.receipts, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local key = productById[info.ProductId]
	if not key then
		warn("[PurchaseService] unknown product id " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local grantFn = Monetization.Products[key].kind == "shop" and grantShopReceipt or grantProduct
	local ok, msg = pcall(grantFn, player, data, key)
	if not ok then
		warn("[PurchaseService] grant failed: " .. tostring(msg))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	ReceiptLedger.add(data.receipts, purchaseId, RECEIPT_MEMORY)
	if not ctx.Data.save(profile, false) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	ctx.toast(player, msg, "good")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function PurchaseService.init(c: any)
	ctx = c
	ctx.handle("buy", prompt)
	ctx.handle("shopBuy", shopBuy)
	ctx.handle("subscribe", subscribe)
	ctx.handle("plus", plus)
	ctx.handle("seenShop", seenShop)
	ctx.handle("shopStep", shopStep)
	Players.PlayerRemoving:Connect(function(p)
		shopOpens[p] = nil
	end)
end

function PurchaseService.start()
	local function onJoin(player: Player)
		PurchaseService.loadPolicy(player)
		if player.Parent then
			ctx.Progress.sendState(player)
		end
	end
	Players.PlayerAdded:Connect(onJoin)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onJoin, player)
	end
	Players.PlayerRemoving:Connect(function(player: Player)
		policies[player] = nil
		previewsShown[player] = nil
	end)
	MarketplaceService.ProcessReceipt = processReceipt
	pcall(function()
		(MarketplaceService :: any).UserSubscriptionStatusChanged:Connect(function(player: Player, subId: string)
			if subId == Monetization.Subscriptions.PatronClub.id then
				PurchaseService.checkSubscription(player)
				ctx.Progress.sendState(player)
			end
		end)
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
		local key = passById[passId]
		if purchased and key then
			grantPass(player, key)
		end
	end)
end

return PurchaseService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="74">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="75">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="76">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterJumpPower">50</float>
      <float name="CharacterWalkSpeed">16</float>
      <token name="GameSettingsAvatar">1</token>
      <token name="GameSettingsR15Collision">1</token>
      <bool name="LoadCharacterAppearance">true</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="77">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="78">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">AnimPlayer</string>
            <string name="Source"><![CDATA[--!strict
--[[
	AnimPlayer: plays the code-made keyframe clips in Shared/Anim.luau on any R15 model by
	writing Motor6D.Transform every frame (RunService.Stepped, after the default Animator has
	written its pose, so ours wins for the joints a clip uses). Transform doesn't replicate, so
	every client plays every emote and statue pose itself from the server's pushes and tags.

	Studio check (PUBLISHING.md 6i): if a joint looks frozen on your own character, move the
	write to RunService.PreSimulation; the default Animate script timing varies by version.
]]
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Anim = require(Shared.Anim)
local Arms = require(Shared.Arms) :: any

local AnimPlayer = {}

local E = {
	Instance = Instance,
	Vector3 = Vector3,
	CFrame = CFrame,
	Color3 = Color3,
	Enum = Enum,
	UDim2 = UDim2,
	NumberSequence = NumberSequence,
	NumberRange = NumberRange,
	ColorSequence = ColorSequence,
	Vector2 = Vector2,
}

type Active = { clip: any, t0: number, joints: { [string]: Motor6D }, prop: Model?, repeatEvery: number?, untilT: number? }
local active: { [Model]: Active } = {}

local function jointsOf(m: Model): { [string]: Motor6D }
	local out = {}
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("Motor6D") and Anim.JOINT_SET[d.Name] then
			out[d.Name] = d
		end
	end
	return out
end

local function resetJoints(a: Active)
	for _, j in pairs(a.joints) do
		j.Transform = CFrame.identity
	end
end

function AnimPlayer.stop(m: Model)
	local a = active[m]
	if a then
		resetJoints(a)
		if a.prop then
			a.prop:Destroy()
		end
		active[m] = nil
	end
end

-- Play a clip on a model. opts.repeatEvery restarts it (statues), opts.seconds stops a held pose.
function AnimPlayer.play(m: Model, clipId: string, opts: { repeatEvery: number?, seconds: number? }?): boolean
	local clip = (Anim.CLIPS :: any)[clipId]
	if not clip then
		return false
	end
	AnimPlayer.stop(m)
	local a: Active = { clip = clip, t0 = os.clock(), joints = jointsOf(m), repeatEvery = opts and opts.repeatEvery, untilT = opts and opts.seconds and (os.clock() + opts.seconds) or nil }
	if clip.prop and (Anim.PROPS :: any)[clip.prop] then
		local hand = m:FindFirstChild(clip.propJoint or "RightHand", true) :: BasePart?
		if hand then
			local spec = { id = "prop_" .. clip.prop, slot = "prop", name = clip.prop, parts = (Anim.PROPS :: any)[clip.prop], fx = {} }
			local pm = Arms.build(E, spec, hand.CFrame)
			pm.Name = "AnimProp"
			local w = Instance.new("WeldConstraint")
			w.Part0 = hand
			w.Part1 = pm.PrimaryPart
			w.Parent = pm.PrimaryPart
			pm.Parent = m
			a.prop = pm
		end
	end
	active[m] = a
	return true
end

function AnimPlayer.isPlaying(m: Model): boolean
	return active[m] ~= nil
end

local function step()
	local now = os.clock()
	for m, a in pairs(active) do
		if not m.Parent then
			active[m] = nil
			continue
		end
		local t = now - a.t0
		if a.repeatEvery and t > math.max(a.repeatEvery, a.clip.length) then
			a.t0 = now
			t = 0
		end
		local pose = Anim.sample(a.clip, t)
		for name, r in pairs(pose) do
			local j = a.joints[name]
			if j then
				j.Transform = CFrame.Angles(math.rad(r[1]), math.rad(r[2]), math.rad(r[3]))
			end
		end
		local done = (not a.clip.loop and not a.clip.hold and not a.repeatEvery and t >= a.clip.length) or (a.untilT ~= nil and now >= a.untilT)
		if done then
			AnimPlayer.stop(m)
		end
	end
end

local function onTagged(inst: Instance)
	if inst:IsA("Model") then
		local clip = inst:GetAttribute("Clip")
		local rep = inst:GetAttribute("Repeat")
		if type(clip) == "string" then
			-- let the rig finish streaming in
			task.delay(0.5, function()
				if inst.Parent then
					AnimPlayer.play(inst, clip, { repeatEvery = type(rep) == "number" and rep or nil })
				end
			end)
		end
	end
end

function AnimPlayer.start()
	RunService.Stepped:Connect(step)
	CollectionService:GetInstanceAddedSignal("DaybreakPose"):Connect(onTagged)
	CollectionService:GetInstanceRemovedSignal("DaybreakPose"):Connect(function(inst: Instance)
		if inst:IsA("Model") then
			AnimPlayer.stop(inst)
		end
	end)
	for _, inst in ipairs(CollectionService:GetTagged("DaybreakPose")) do
		onTagged(inst)
	end
end

return AnimPlayer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">Cutscene</string>
            <string name="Source"><![CDATA[--!strict
--[[
	The pregame show, played locally for each contender:
	  1. The Harvesting (full on your first match, short after that or with the setting):
	     wide shot of the plaza, the Herald at the glass globe, a slip is drawn, your own avatar
	     (a local clone) walks up the aisle, and Rusty Dunmore walks over to meet you on stage.
	  2. The Parade (7 s): six Reach floats roll down the avenue; yours carries your avatar and
	     the camera rides alongside.
	  3. The Interview (7 s): Monty Gleam asks one question; you tap one of three preset answers
	     (your lobby pick is the default). No chat, no free text. Other contenders' picks scroll by.
	  4. Training (6 s + board): five targets pop up; click them. The server re-scores your clicks
	     (1 to 10), then everyone's scores appear on the board. A low score makes Gallery gifts to
	     you cheaper, so it never pays to be good at faking.
	Skippable at any time; skipping just jumps to the launch countdown. Depth of field is on while
	a cutscene plays.
]]
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local Net = require(script.Parent.Net)
local Fx = require(script.Parent.Fx)
local Sfx = require(script.Parent.Sfx)
local Rusty = require(script.Parent.Rusty)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Names = require(Shared.Names)
local Content = require(Shared.Content)
local Training = require(Shared.Logic.Training)
local Lighting = game:GetService("Lighting")
local T = UI.Theme

local Cutscene = {}
local player = Players.LocalPlayer
local layer: Frame = nil :: any
local caption: TextLabel = nil :: any
local sub: TextLabel = nil :: any
local bars: { Frame } = {}
local seq = 0
local cleanup: { () -> () } = {}
Cutscene.playing = false

local function marks(): Instance?
	local map = workspace:FindFirstChild("Map")
	local lobby = map and map:FindFirstChild("Lobby")
	return lobby and lobby:FindFirstChild("CutsceneMarks")
end

local function markCF(name: string): CFrame?
	local m = marks()
	local p = m and m:FindFirstChild(name)
	return p and (p :: BasePart).CFrame or nil
end

local function camTo(name: string, time: number)
	local cf = markCF(name)
	local cam = workspace.CurrentCamera
	if not cf or not cam then
		return
	end
	if time <= 0 then
		cam.CFrame = cf
	else
		TweenService:Create(cam, TweenInfo.new(time, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { CFrame = cf }):Play()
	end
end

local function say(text: string, small: string?)
	caption.Text = text
	sub.Text = small or ""
end

local function alive(id: number): boolean
	return seq == id and Cutscene.playing
end

local function wait(id: number, s: number): boolean
	task.wait(s)
	return alive(id)
end

local function tweenModel(m: Model, to: CFrame, time: number)
	local v = Instance.new("CFrameValue")
	v.Value = m:GetPivot()
	v.Changed:Connect(function(cf: CFrame)
		if m.Parent then
			m:PivotTo(cf)
		end
	end)
	local tw = TweenService:Create(v, TweenInfo.new(time, Enum.EasingStyle.Linear), { Value = to })
	tw.Completed:Connect(function()
		v:Destroy()
	end)
	tw:Play()
end

-- A local, anchored copy of your avatar for the walk to the stage.
local function cloneMe(at: CFrame): Model?
	local char = player.Character
	if not char then
		return nil
	end
	char.Archivable = true
	local ok, copy = pcall(function()
		return char:Clone()
	end)
	if not ok or not copy then
		return nil
	end
	for _, d in ipairs(copy:GetDescendants()) do
		if d:IsA("BaseScript") or d:IsA("ForceField") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end
	local hum = copy:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	copy.Name = "ReapingDouble"
	copy:PivotTo(at)
	copy.Parent = workspace
	table.insert(cleanup, function()
		copy:Destroy()
	end)
	return copy
end

local function dof(on: boolean)
	local d = Lighting:FindFirstChild("CutsceneDOF")
	if d and d:IsA("DepthOfFieldEffect") then
		d.Enabled = on
	end
end

local panel: Frame = nil :: any -- interview buttons / training targets / board live here
local function clearPanel()
	if panel then
		for _, ch in ipairs(panel:GetChildren()) do
			ch:Destroy()
		end
		panel.Visible = false
	end
end

local function stop()
	Cutscene.playing = false
	dof(false)
	clearPanel()
	seq += 1
	for _, fn in ipairs(cleanup) do
		pcall(fn)
	end
	cleanup = {}
	layer.Visible = false
	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if h then
			cam.CameraSubject = h
		end
	end
end

local function reaping(id: number, d: any, short: boolean)
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	camTo("CamWide", 0)
	say(Names.DRAW, string.format("%s · %s", Names.EVENT, d.reach or ""))
	Sfx.play("bell", 0.8)
	if short then
		camTo("CamStage", 1.2)
		if not wait(id, 1.4) then
			return
		end
		say("Contender for " .. tostring(d.reach) .. ": " .. player.DisplayName, d.partnerName and ("with " .. d.partnerName) or nil)
		wait(id, 1.6)
		return
	end
	if not wait(id, 1.6) then
		return
	end
	camTo("CamGlobe", 1.6)
	say(Names.HERALD .. " reaches into the globe…")
	if not wait(id, 2.0) then
		return
	end
	camTo("CamHerald", 0.8)
	say("“From " .. tostring(d.reach) .. "… " .. player.DisplayName .. "!”")
	Sfx.play("ding")
	if not wait(id, 1.6) then
		return
	end
	-- you walk up the aisle
	local aisle, stage = markCF("AisleMark"), markCF("StageMark")
	local crowd = markCF("CrowdMark")
	local double = crowd and cloneMe(crowd * CFrame.Angles(0, math.pi, 0))
	camTo("CamCrowd", 0.6)
	say("The crowd steps aside.")
	if double and aisle and stage then
		tweenModel(double, CFrame.lookAt(aisle.Position, stage.Position), 1.6)
		task.delay(1.6, function()
			if double.Parent then
				tweenModel(double, CFrame.lookAt(stage.Position, stage.Position + Vector3.new(0, 0, 10)), 1.2)
			end
		end)
	end
	if not wait(id, 1.4) then
		return
	end
	camTo("CamPlayer", 1.2)
	if not wait(id, 1.6) then
		return
	end
	-- Rusty walks over to meet you
	local lobby = workspace:FindFirstChild("Map") and (workspace :: any).Map:FindFirstChild("Lobby")
	local rusty = lobby and lobby:FindFirstChild("Rusty") :: Model?
	local rStart, rMark = markCF("RustyStart"), markCF("RustyMark")
	if rusty and rStart and rMark then
		local home = rusty:GetPivot()
		table.insert(cleanup, function()
			rusty:PivotTo(home)
		end)
		tweenModel(rusty, CFrame.lookAt(rMark.Position, rMark.Position + Vector3.new(1, 0, 0)), 2.2)
	end
	camTo("CamRusty", 1.0)
	say(Names.MENTOR .. " climbs the steps.", "“" .. Content.RUSTY.reaping .. "”")
	Rusty.voice(Content.RUSTY.reaping, Net.state and Net.state.equipped and Net.state.equipped.rusty)
	if not wait(id, 2.6) then
		return
	end
	camTo("CamPull", 1.6)
	say(Names.CONTENDERS .. " of " .. tostring(d.reach), d.partnerName and ("You and " .. d.partnerName .. ". Stick together.") or "Twenty-four Reaches. Forty-eight contenders. One sunrise.")
	wait(id, 1.8)
end

-- ===== the Parade =====
local function float(parent: Instance, reach: string, color: Color3, at: CFrame): Model
	local m = Instance.new("Model")
	m.Name = "ParadeFloat"
	local function p(name: string, size: Vector3, off: CFrame, c: Color3, mat: Enum.Material, shape: Enum.PartType?): Part
		local x = Instance.new("Part")
		x.Name = name
		x.Anchored = true
		x.CanCollide = false
		x.Size = size
		x.CFrame = at * off
		x.Color = c
		x.Material = mat
		if shape then
			x.Shape = shape
		end
		x.Parent = m
		return x
	end
	local base = p("Deck", Vector3.new(16, 2, 10), CFrame.new(0, 2.6, 0), Color3.fromHex("#4A3A2C"), Enum.Material.WoodPlanks)
	p("Skirt", Vector3.new(16.2, 1.4, 10.2), CFrame.new(0, 1.6, 0), color, Enum.Material.Fabric)
	for _, w in ipairs({ { -5.5, -5.2 }, { 5.5, -5.2 }, { -5.5, 5.2 }, { 5.5, 5.2 } }) do
		p("Wheel", Vector3.new(0.8, 3, 3), CFrame.new(w[1], 1.5, w[2]) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromHex("#2E2A26"), Enum.Material.CorrodedMetal, Enum.PartType.Cylinder)
	end
	local pole = p("BannerPole", Vector3.new(0.3, 9, 0.3), CFrame.new(-6.5, 8, 0), Color3.fromHex("#3B3530"), Enum.Material.CorrodedMetal)
	local banner = p("Banner", Vector3.new(0.1, 3.4, 5.2), CFrame.new(-6.5, 10.6, 2.6), color, Enum.Material.Fabric)
	local g = Instance.new("SurfaceGui")
	g.Face = Enum.NormalId.Right
	g.CanvasSize = Vector2.new(260, 170)
	g.Parent = banner
	local tl = Instance.new("TextLabel")
	tl.BackgroundTransparency = 1
	tl.Size = UDim2.fromScale(1, 1)
	tl.Font = Enum.Font.GothamBold
	tl.TextScaled = true
	tl.TextColor3 = Color3.fromHex("#EDE6D6")
	tl.Text = reach
	tl.Parent = g
	local _ = pole
	m.PrimaryPart = base
	m.Parent = parent
	return m
end

local REACH_TINTS = { "#6E4A3A", "#3F5560", "#5A5A3E", "#4E3E58", "#6A5A40", "#3E5A4A" }

local function parade(id: number, d: any)
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	local L = Config.Map.LOBBY_CENTER
	local origin = Vector3.new(L[1], L[2], L[3])
	local z = 158
	local folder = Instance.new("Folder")
	folder.Name = "Parade"
	folder.Parent = workspace
	table.insert(cleanup, function()
		folder:Destroy()
	end)
	local reaches = { tostring(d.reach) }
	for _, r in ipairs(d.roster or {}) do
		if #reaches >= 6 then
			break
		end
		if r.reach ~= d.reach and not table.find(reaches, r.reach) then
			table.insert(reaches, r.reach)
		end
	end
	local floats: { Model } = {}
	for k, reach in ipairs(reaches) do
		local cf = CFrame.new(origin + Vector3.new(-150 - (k - 1) * 22, 0, z)) * CFrame.Angles(0, -math.pi / 2, 0)
		floats[k] = float(folder, reach, Color3.fromHex(REACH_TINTS[(k - 1) % #REACH_TINTS + 1]), cf)
	end
	local mine = floats[1]
	local double = cloneMe(mine:GetPivot() * CFrame.new(0, 3.6, 0) * CFrame.Angles(0, math.pi / 2, 0))
	say("The " .. Names.CAPITAL .. " Parade", tostring(d.reach) .. " rolls out first. Wave to the crowd!")
	Sfx.play("bell", 1.1)
	local dur = Config.Pregame.parade - 0.4
	local t0 = os.clock()
	local conn
	conn = game:GetService("RunService").RenderStepped:Connect(function()
		if not alive(id) then
			conn:Disconnect()
			return
		end
		local a = math.clamp((os.clock() - t0) / dur, 0, 1)
		local dx = 230 * a
		for k, f in ipairs(floats) do
			f:PivotTo(CFrame.new(origin + Vector3.new(-150 - (k - 1) * 22 + dx, 0, z)) * CFrame.Angles(0, -math.pi / 2, 0))
		end
		if double and double.Parent then
			double:PivotTo(mine:GetPivot() * CFrame.new(0, 3.6 + math.sin(os.clock() * 3) * 0.05, 0) * CFrame.Angles(0, math.pi / 2, 0))
		end
		local fp = mine:GetPivot().Position
		cam.CFrame = CFrame.lookAt(fp + Vector3.new(10 - 6 * a, 9, -26), fp + Vector3.new(0, 5, 0))
	end)
	table.insert(cleanup, function()
		conn:Disconnect()
	end)
	wait(id, dur)
	conn:Disconnect()
end

-- ===== the Interview =====
local function interview(id: number, d: any)
	camTo("CamInterview", 0)
	local default = tonumber(d.quipIndex) or 1
	local seat = markCF("InterviewSeat")
	if seat then
		cloneMe(seat)
	end
	say(Names.HOST .. ": “" .. tostring(d.question or Content.QUESTIONS[1]) .. "”", "Pick an answer. (Default: your lobby line.)")
	Sfx.play("ding")
	panel.Visible = true
	local picks = { default, default % #Content.QUIPS + 1, (default + 2) % #Content.QUIPS + 1 }
	local chosen = false
	local function choose(i: number)
		if chosen or not alive(id) then
			return
		end
		chosen = true
		clearPanel()
		Net.act("interview", i)
		say("You: “" .. Content.QUIPS[i] .. "”", Names.HOST .. " beams. The crowd cheers.")
		Sfx.play("coins", 1.2)
	end
	for k, i in ipairs(picks) do
		UI.button(Content.QUIPS[i], k == 1 and T.gold or T.card, {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0.52 + (k - 1) * 0.075, 0),
			Size = UDim2.new(0, 520, 0, 40),
			TextSize = 17,
			TextColor3 = k == 1 and Color3.fromHex("#1C1F2B") or T.text,
			ZIndex = 33,
			Parent = panel,
		}, function()
			choose(i)
		end)
	end
	if not wait(id, 4.2) then
		return
	end
	choose(default)
	wait(id, Config.Pregame.interview - 4.4)
end

-- ===== Training =====
local pendingBoard: any = nil
local function showBoard(b: any)
	clearPanel()
	panel.Visible = true
	local mine = b.mine or 5
	say("Training score: " .. mine .. " / " .. Config.Training.max, mine <= b.underdogAt and "Underdog! Gallery gifts to you cost 20% less." or Names.MENTOR_SHORT .. " nods. “Not bad, kid.”")
	Sfx.play(mine >= 8 and "fanfare" or "ding")
	local box = UI.frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.new(0, 360, 0, 230), BackgroundTransparency = 0.15, ZIndex = 33, Parent = panel })
	UI.corner(box, 12)
	UI.pad(box, 10)
	UI.list(box, Enum.FillDirection.Vertical, 4)
	UI.label("Training board · top 6", { Size = UDim2.new(1, 0, 0, 24), TextSize = 18, TextColor3 = T.gold, ZIndex = 34, LayoutOrder = 0, Parent = box })
	for k = 1, math.min(6, #b.board) do
		local r = b.board[k]
		UI.label(string.format("%d. %s (%s) · %d", k, r.name, r.reach, r.score), { Size = UDim2.new(1, 0, 0, 22), TextSize = 15, Font = T.body, ZIndex = 34, LayoutOrder = k, Parent = box })
	end
end

local function trainingRound(id: number, d: any)
	camTo("CamRange", 0.8)
	say("Training", "Click the targets. Five of them, quick!")
	clearPanel()
	panel.Visible = true
	local targets = Training.targets(tonumber(d.trainingSeed) or 1, Config.Training.targets, Config.Training.duration)
	local clicks = {}
	local t0 = os.clock()
	local hits = 0
	for _, tg in ipairs(targets) do
		task.delay(tg.at, function()
			if not alive(id) then
				return
			end
			local b = Instance.new("TextButton")
			b.Text = "◎"
			b.TextScaled = true
			b.TextColor3 = Color3.fromHex("#B3262E")
			b.BackgroundColor3 = Color3.fromHex("#EDE6D6")
			b.AnchorPoint = Vector2.new(0.5, 0.5)
			b.Position = UDim2.fromScale(tg.x, tg.y)
			b.Size = UDim2.new(0, 74, 0, 74)
			b.ZIndex = 34
			UI.corner(b, 37)
			b.Parent = panel
			b.Activated:Connect(function()
				table.insert(clicks, { i = tg.i, t = os.clock() - t0 })
				hits += 1
				Sfx.play("pop")
				b:Destroy()
			end)
			task.delay(tg.life, function()
				if b.Parent then
					b:Destroy()
				end
			end)
		end)
	end
	if not wait(id, Config.Training.duration) then
		return
	end
	Net.act("training", clicks)
	clearPanel()
	say(string.format("%d of %d hit", hits, #targets), "Scores coming in…")
	if not wait(id, 0.9) then
		return
	end
	if pendingBoard then
		showBoard(pendingBoard)
		pendingBoard = nil
	end
	if not wait(id, 2.0) then
		return
	end
	if d.twist then
		clearPanel()
		say("Today's twist: " .. d.twist.name, d.twist.text)
		wait(id, 1.4)
	end
end

local function ceremony(id: number, d: any)
	parade(id, d)
	if not alive(id) then
		return
	end
	interview(id, d)
	if not alive(id) then
		return
	end
	trainingRound(id, d)
end

function Cutscene.play(d: any)
	stop()
	seq += 1
	local id = seq
	Cutscene.playing = true
	layer.Visible = true
	pendingBoard = nil
	dof(true)
	task.spawn(function()
		-- v5: Quick Trials always uses the short draw and skips the ceremony
		local short = d.short == true or d.quick == true
		reaping(id, d, short)
		if not alive(id) then
			return
		end
		Net.act("seenReaping")
		if not d.quick then
			ceremony(id, d)
		end
		if alive(id) then
			stop()
		end
	end)
end

function Cutscene.skip()
	if Cutscene.playing then
		Net.act("seenReaping")
		stop()
		Fx.toast("Skipped. Get ready to launch!", "info")
	end
end

function Cutscene.mount(parent: Frame)
	layer = UI.frame({ Name = "Cutscene", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 30, Parent = parent })
	for i, y in ipairs({ 0, 1 }) do
		bars[i] = UI.frame({ BackgroundColor3 = Color3.new(0, 0, 0), AnchorPoint = Vector2.new(0, y), Position = UDim2.fromScale(0, y), Size = UDim2.new(1, 0, 0.11, 0), ZIndex = 30, Parent = layer })
	end
	caption = UI.label("", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0.86, 0), Size = UDim2.new(0.8, 0, 0, 44), TextSize = 34, TextColor3 = T.gold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, ZIndex = 31, Parent = layer })
	sub = UI.label("", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0.885, 4), Size = UDim2.new(0.8, 0, 0, 26), TextSize = 19, Font = T.body, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.4, ZIndex = 31, Parent = layer })
	UI.button("Skip ▸▸", T.card, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0.11, 10), Size = UDim2.new(0, 110, 0, 38), TextColor3 = T.text, ZIndex = 32, Parent = layer }, Cutscene.skip)
	panel = UI.frame({ Name = "CeremonyPanel", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 33, Parent = layer })
	Net.on("pregame", Cutscene.play)
	Net.on("trainingBoard", function(b)
		if Cutscene.playing and #panel:GetChildren() > 0 then
			pendingBoard = b -- still clicking targets; show it when the round ends
		elseif Cutscene.playing then
			showBoard(b)
		else
			Fx.toast(string.format("Training score: %d / %d", b.mine or 5, Config.Training.max), "info")
		end
	end)
	Net.on("interviewLine", function(l)
		if Cutscene.playing then
			Fx.toast(string.format("%s (%s): “%s”", l.name, l.reach, l.quip), "info")
		end
	end)
	Net.on("launch", function(d)
		stop()
		Fx.announce("Stand on your plate!", T.gold, 2)
		Fx.toast(string.format("Launch in %ds. Don't step off early.", d.seconds), "info")
		Rusty.say("launch", "info")
	end)
	local _ = Config
end

return Cutscene
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[--!strict
-- Screen effects: toasts, big announcements, pops, arrow tracers, hit flashes, the cannon bell.
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local UI = require(script.Parent.UI)
local Sfx = require(script.Parent.Sfx)
local T = UI.Theme

local Fx = {}
local root: Frame = nil :: any
local toasts: Frame = nil :: any
local banner: TextLabel = nil :: any
local flash: Frame = nil :: any
local feedBox: Frame = nil :: any

function Fx.mount(parent: Frame)
	root = parent
	toasts = UI.frame({ Name = "Toasts", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 74), Size = UDim2.new(0, 520, 0, 220), Parent = root })
	UI.list(toasts, nil, 6, Enum.HorizontalAlignment.Center)
	banner = UI.label("", {
		Name = "Announce",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.32),
		Size = UDim2.new(0.9, 0, 0, 70),
		TextSize = 46,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.4,
		TextTransparency = 1,
		TextStrokeColor3 = T.bg,
		ZIndex = 20,
		Parent = root,
	})
	feedBox = UI.frame({ Name = "KillFeed", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 120), Size = UDim2.new(0, 300, 0, 140), Parent = root })
	UI.list(feedBox, nil, 4)
	flash = UI.frame({ Name = "HitFlash", BackgroundColor3 = T.red, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 1, Active = false, Parent = root })
end

local KIND_COLOR: { [string]: Color3 } = {
	good = Color3.fromHex("#2E7D4F"),
	bad = Color3.fromHex("#B3262E"),
	info = Color3.fromHex("#2E3449"),
}

function Fx.toast(text: string, kind: string?)
	if not toasts then
		return
	end
	local f = UI.frame({ BackgroundColor3 = KIND_COLOR[kind or "info"] or KIND_COLOR.info, Size = UDim2.new(0, 500, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = toasts })
	UI.corner(f, 10)
	UI.pad(f, 10)
	UI.label(text, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 18, Font = T.body, TextXAlignment = Enum.TextXAlignment.Center, Parent = f })
	Debris:AddItem(f, 4)
	if #toasts:GetChildren() > 5 then
		for _, c in ipairs(toasts:GetChildren()) do
			if c:IsA("Frame") then
				c:Destroy()
				break
			end
		end
	end
end

function Fx.announce(text: string, color: Color3?, hold: number?)
	if not banner then
		return
	end
	banner.Text = text
	banner.TextColor3 = color or T.gold
	banner.TextTransparency = 0
	banner.TextStrokeTransparency = 0.4
	local id = {}
	;(banner :: any):SetAttribute("Seq", tostring(id))
	task.delay(hold or 2.4, function()
		if (banner :: any):GetAttribute("Seq") == tostring(id) then
			TweenService:Create(banner, TweenInfo.new(0.5), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end

function Fx.pop(text: string, color: Color3?, size: number?)
	local l = UI.label(text, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5 + (math.random() - 0.5) * 0.1, 0.45),
		Size = UDim2.new(0, 500, 0, 60),
		TextSize = size or 30,
		TextColor3 = color or T.gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.3,
		ZIndex = 15,
		Parent = root,
	})
	TweenService:Create(l, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = l.Position - UDim2.fromOffset(0, 70), TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(l, 1.2)
end

function Fx.hit()
	flash.BackgroundTransparency = 0.75
	TweenService:Create(flash, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
end

-- One line in the top-right kill feed (max 4, each fades after 5 s).
function Fx.feed(text: string, color: string?)
	if not feedBox then
		return
	end
	local l = UI.label(text, { Size = UDim2.new(1, 0, 0, 22), TextSize = 14, Font = T.body, TextXAlignment = Enum.TextXAlignment.Right, TextStrokeTransparency = 0.5, TextColor3 = color and Color3.fromHex(color) or T.text, Parent = feedBox })
	TweenService:Create(l, TweenInfo.new(1, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(l, 5)
	local lines = {}
	for _, c in ipairs(feedBox:GetChildren()) do
		if c:IsA("TextLabel") then
			table.insert(lines, c)
		end
	end
	if #lines > 4 then
		lines[1]:Destroy()
	end
end

-- A glowing arrow streak from bow to target. Mastered skins (bright) draw a wider, longer streak.
function Fx.tracer(from: Vector3, to: Vector3, color: string?, bright: boolean?)
	local d = (to - from).Magnitude
	if d < 1 then
		return
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromHex(color or "#FFE9A8")
	local w = bright and 0.3 or 0.15
	p.Size = Vector3.new(w, w, d)
	p.CFrame = CFrame.lookAt(from:Lerp(to, 0.5), to)
	p.Parent = workspace
	local life = bright and 0.5 or 0.3
	TweenService:Create(p, TweenInfo.new(life), { Transparency = 1 }):Play()
	Debris:AddItem(p, life + 0.05)
end

-- A floating bubble over someone's head (emotes and Gallery cheers).
function Fx.bubble(adornee: BasePart, text: string, color: string?, seconds: number?)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 220, 0, 50)
	bb.StudsOffset = Vector3.new(0, 4.2, 0)
	bb.MaxDistance = 80
	bb.Adornee = adornee
	local tl = Instance.new("TextLabel")
	tl.BackgroundTransparency = 1
	tl.Size = UDim2.fromScale(1, 1)
	tl.Font = Enum.Font.FredokaOne
	tl.TextScaled = true
	tl.TextStrokeTransparency = 0.3
	tl.TextColor3 = Color3.fromHex(color or "#FFE9A8")
	tl.Text = text
	tl.Parent = bb
	bb.Parent = adornee
	TweenService:Create(bb, TweenInfo.new(seconds or 3), { StudsOffset = Vector3.new(0, 6, 0) }):Play()
	Debris:AddItem(bb, seconds or 3)
end

-- Patron Picks firework flare: a bright spark that rises and pops. Cosmetic only.
function Fx.flare(at: Vector3, color: string?)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Shape = Enum.PartType.Ball
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromHex(color or "#FFD36B")
	p.Size = Vector3.new(1, 1, 1)
	p.CFrame = CFrame.new(at + Vector3.new(0, 4, 0))
	p.Parent = workspace
	local up = TweenService:Create(p, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(at + Vector3.new(0, 40, 0)) })
	up.Completed:Connect(function()
		TweenService:Create(p, TweenInfo.new(0.6), { Size = Vector3.new(14, 14, 14), Transparency = 1 }):Play()
	end)
	up:Play()
	Debris:AddItem(p, 2)
end

-- The knockout bell: one soft ring per knockout so everyone hears the count drop.
function Fx.bell()
	Sfx.play("bell", 0.9, 0.2)
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">GalleryPanel</string>
            <string name="Source"><![CDATA[--!strict
-- The Viewing Gallery panel: Favor, gift any contender, vote on hazards and on the Encore.
local Players = game:GetService("Players")

local UI = require(script.Parent.UI)
local Net = require(script.Parent.Net)
local Fx = require(script.Parent.Fx)
local Sfx = require(script.Parent.Sfx)
local Hud = require(script.Parent.Hud)
local T = UI.Theme
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Names = require(ReplicatedStorage:WaitForChild("Shared").Names)

local GalleryPanel = {}
local win: Frame = nil :: any
local favor: TextLabel = nil :: any
local list: ScrollingFrame = nil :: any
local gifts: Frame = nil :: any
local voteBox: Frame = nil :: any
local selected: string? = nil
local view: any = nil
local lastBuild = 0

local function rebuild()
	if not view then
		return
	end
	favor.Text = string.format("🪙 %d %s  ·  earn +1 every 5 s while you watch", view.favor, Names.FAVOR)
	UI.clear(list)
	for i, c in ipairs(view.alive) do
		local b = UI.button(string.format("%s%s  (%s)  Pep %d%s", c.partner and "👥 " or "", c.name, c.reach, math.floor(c.pep), c.underdog and "  · underdog −20%" or ""), selected == c.id and T.gold or T.card, { LayoutOrder = i, Size = UDim2.new(1, -8, 0, 34), TextSize = 14, TextColor3 = selected == c.id and T.dark or T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = list }, function()
			selected = c.id
			rebuild()
		end)
		UI.pad(b, 8)
		-- v4: show each contender's look (weapon skin + mastery stars, fade) on the right
		local look = c.look
		if look and (look.weapon or look.fade) then
			local txt = (look.weapon or "") .. ((look.stars and look.stars ~= "") and (" " .. look.stars) or "") .. (look.fade and ("  ✦ " .. look.fade) or "")
			UI.label(txt, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0.45, 0, 1, 0), TextSize = 12, Font = T.body, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = look.weaponColor and Color3.fromHex(look.weaponColor) or T.dim, Parent = b })
		end
	end
	UI.clear(gifts)
	for i, g in ipairs(view.gifts) do
		local target = nil
		for _, c in ipairs(view.alive) do
			if c.id == selected then
				target = c
			end
		end
		local cost = target and target.partner and g.partnerCost or g.cost
		if target and target.underdog and not target.partner then
			cost = g.underdogCost
		end
		UI.button(string.format("🪂 %s · %d", g.name, cost), (target and view.favor >= cost) and T.blue or T.card, { LayoutOrder = i, Size = UDim2.new(0, 150, 0, 40), TextSize = 14, TextColor3 = T.text, Parent = gifts }, function()
			if not selected then
				Fx.toast("Pick a contender first.", "info")
				return
			end
			if Net.act("gift", selected, g.id) then
				Sfx.play("whoosh")
			end
		end)
	end
	UI.clear(voteBox)
	local function ballot(kind: string, b: any, labels: { [string]: string })
		local secs = math.max(0, math.ceil(b.ends - workspace:GetServerTimeNow()))
		UI.label((kind == "encore" and "Encore vote: bring one back!" or "Hazard vote") .. string.format(" · %ds", secs), { Size = UDim2.new(1, 0, 0, 22), TextSize = 17, TextColor3 = T.gold, LayoutOrder = 0, Parent = voteBox })
		for i, opt in ipairs(b.options) do
			local id = type(opt) == "table" and opt.id or opt
			local label = labels[id] or (type(opt) == "table" and opt.name) or id
			local n = b.counts[id] or 0
			UI.button(string.format("%s%s  (%d)", b.mine == id and "✔ " or "", label, n), b.mine == id and T.gold or T.card, { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 34), TextSize = 14, TextColor3 = b.mine == id and T.dark or T.text, Parent = voteBox }, function()
				Net.act("vote", kind, id)
			end)
		end
	end
	if view.encore then
		ballot("encore", view.encore, {})
	elseif view.hazard then
		local labels = {}
		for _, card in ipairs(view.hazardCards) do
			labels[card.id] = card.name .. ": " .. card.text
		end
		ballot("hazard", view.hazard, labels)
	else
		UI.label("Next vote soon. Votes pick hazards and bring one contender back.", { Size = UDim2.new(1, 0, 0, 40), TextSize = 14, Font = T.body, TextColor3 = T.dim, Parent = voteBox })
	end
end

function GalleryPanel.mount(parent: Frame)
	win = UI.frame({ Name = "Gallery", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 20), Size = UDim2.new(0, 360, 0, 560), Visible = false, BackgroundTransparency = 0.05, Parent = parent })
	UI.corner(win, 14)
	UI.stroke(win, T.blue, 2)
	UI.pad(win, 10)
	UI.label("🎟️ " .. Names.GALLERY, { Size = UDim2.new(1, 0, 0, 28), TextSize = 22, TextColor3 = T.gold, Parent = win })
	favor = UI.label("", { Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, 0, 0, 20), TextSize = 14, Font = T.body, TextColor3 = T.dim, Parent = win })
	list = UI.new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 52), Size = UDim2.new(1, 0, 0, 180), AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 5, Parent = win })
	UI.list(list, nil, 4)
	gifts = UI.frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 238), Size = UDim2.new(1, 0, 0, 134), Parent = win })
	UI.new("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 40), CellPadding = UDim2.new(0, 6, 0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = gifts })
	voteBox = UI.frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 378), Size = UDim2.new(1, 0, 0, 130), Parent = win })
	UI.list(voteBox, nil, 4)
	UI.button("Back to the lobby", T.card, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(1, 0, 0, 36), TextColor3 = T.text, Parent = win }, function()
		Net.act("leaveGallery")
	end)
	Net.on("gallery", function(v)
		view = v
		win.Visible = true
		Hud.mode = "gallery"
		local now = os.clock()
		if now - lastBuild > 0.4 then
			lastBuild = now
			rebuild()
		end
	end)
	Net.on("galleryClose", function()
		win.Visible = false
		view = nil
		Hud.mode = "lobby"
	end)
	Net.on("vote", function(d)
		Sfx.play("ding")
		Fx.toast(d.kind == "encore" and "Encore vote is open in " .. Names.GALLERY .. "!" or "Hazard vote is open in " .. Names.GALLERY .. "!", "info")
	end)
	Net.on("giftFeed", function(d)
		if win.Visible then
			Fx.toast(string.format("🪂 %s sent %s to %s", d.from, d.item, d.to), "info")
		end
	end)
	local _ = Players
end

return GalleryPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- The always-on HUD: progress bar, lobby queue card, arena vitals, hotbar and menu buttons.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local Net = require(script.Parent.Net)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Names = require(Shared.Names)
local T = UI.Theme

local Hud = {}
local panels: any = nil
local lastTier: number? = nil
local premiumNoted = false
Hud.note = function(_text: string) end -- set by Main (Fx.toast)
function Hud.openPanel(id: string)
	if panels then
		panels.open(id)
	end
end
local refs: { [string]: any } = {}
Hud.lobby = nil :: any
Hud.match = nil :: any
Hud.inv = nil :: any
Hud.pep = Config.PEP_MAX
Hud.vitals = nil :: any -- server-owned stamina + Food/Water
Hud.pact = nil :: any
Hud.mode = "lobby" -- "lobby" | "pregame" | "arena" | "gallery"

local function secs(n: number?): string
	n = math.max(0, math.floor(n or 0))
	return string.format("%d:%02d", (n :: number) // 60, (n :: number) % 60)
end

local function topBar(parent: Frame)
	local bar = UI.frame({ Name = "TopBar", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.new(0, 560, 0, 56), BackgroundTransparency = 0.1, Parent = parent })
	UI.corner(bar, 14)
	UI.stroke(bar, T.gold, 1.5)
	UI.pad(bar, 8)
	refs.level = UI.label("Lv 1", { Size = UDim2.new(0, 120, 0, 22), TextSize = 20, TextColor3 = T.gold, Parent = bar })
	refs.rank = UI.label("Reaped", { Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(0, 120, 0, 18), TextSize = 14, TextColor3 = T.dim, Font = T.body, Parent = bar })
	local back, fill = UI.bar(bar, T.gold, { Position = UDim2.new(0, 124, 0, 6), Size = UDim2.new(1, -300, 0, 12) })
	refs.xpFill = fill
	refs.xp = UI.label("", { Position = UDim2.new(0, 124, 0, 20), Size = UDim2.new(1, -300, 0, 18), TextSize = 14, Font = T.body, TextColor3 = T.dim, Parent = bar })
	local _ = back
	refs.streak = UI.label("🔥 0", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 170, 0, 22), TextSize = 18, TextXAlignment = Enum.TextXAlignment.Right, Parent = bar })
	refs.play = UI.label("", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 22), Size = UDim2.new(0, 170, 0, 18), TextSize = 14, Font = T.body, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Right, Parent = bar })
end

local MENU = {
	{ id = "season", text = "🌅 " .. Names.TRACK },
	{ id = "challenges", text = "📜 Challenges" },
	{ id = "letters", text = "✉️ Letters" },
	{ id = "reach", text = "🏳️ My Reach" },
	{ id = "tokens", text = "🪙 " .. Names.TOKENS },
	{ id = "shop", text = "🛍️ Shop" },
	{ id = "profile", text = "👤 Profile" },
	{ id = "settings", text = "⚙️ Settings" },
}

local function menu(parent: Frame)
	local col = UI.frame({ Name = "Menu", BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0.5, -192), Size = UDim2.new(0, 190, 0, 384), Parent = parent })
	UI.list(col, nil, 6)
	refs.badges = {}
	for i, m in ipairs(MENU) do
		local b = UI.button(m.text, T.card, { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 40), TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = col }, function()
			panels.open(m.id)
		end)
		UI.pad(b, 10)
		local badge = UI.label("", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 4, 0.5, 0), Size = UDim2.new(0, 26, 0, 26), BackgroundColor3 = T.red, BackgroundTransparency = 0, TextXAlignment = Enum.TextXAlignment.Center, TextSize = 14, Visible = false, Parent = b })
		UI.corner(badge, 13)
		refs.badges[m.id] = badge
	end
	refs.menu = col
end

local function lobbyCard(parent: Frame)
	local card = UI.frame({ Name = "LobbyCard", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.new(0, 520, 0, 150), BackgroundTransparency = 0.05, Parent = parent })
	UI.corner(card, 16)
	UI.stroke(card, T.gold, 1.5)
	UI.pad(card, 12)
	refs.lobbyTitle = UI.label(Names.EVENT, { Size = UDim2.new(1, 0, 0, 26), TextSize = 22, TextColor3 = T.gold, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	refs.lobbyStatus = UI.label("", { Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, 0, 0, 22), TextSize = 17, Font = T.body, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	refs.lobbyRule = UI.label("", { Position = UDim2.new(0, 0, 0, 50), Size = UDim2.new(1, 0, 0, 20), TextSize = 14, Font = T.body, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	local row = UI.frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -48), Size = UDim2.new(1, 0, 0, 46), Parent = card })
	UI.list(row, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
	refs.queueBtn = UI.button("Enter the " .. Names.DRAW, T.gold, { LayoutOrder = 1, Size = UDim2.new(0, 230, 0, 44), TextSize = 20, Parent = row }, function()
		if Hud.lobby and Hud.lobby.inQueue then
			Net.act("leave")
		else
			Net.act("queue")
		end
	end)
	refs.partnerBtn = UI.button("👥 Partner", T.blue, { LayoutOrder = 2, Size = UDim2.new(0, 120, 0, 44), Parent = row }, function()
		panels.open("partner")
	end)
	refs.autoBtn = UI.button("Auto: ON", T.card, { LayoutOrder = 3, Size = UDim2.new(0, 110, 0, 44), TextColor3 = T.text, Parent = row }, function()
		local s = Net.state and Net.state.settings
		Net.act("setting", "autoQueue", not (s and s.autoQueue))
	end)
	refs.lobbyCard = card
end

local function arenaHud(parent: Frame)
	local box = UI.frame({ Name = "Vitals", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, -14), Size = UDim2.new(0, 300, 0, 112), BackgroundTransparency = 0.1, Parent = parent })
	UI.corner(box, 12)
	UI.pad(box, 10)
	refs.pepLabel = UI.label("Pep 100", { Size = UDim2.new(1, 0, 0, 20), TextSize = 17, Parent = box })
	local _, pepFill = UI.bar(box, Color3.fromHex("#E0B44A"), { Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, 0, 0, 14) })
	refs.pepFill = pepFill
	local function small(y: number, color: Color3, label: string, x: number, w: number): Frame
		UI.label(label, { Position = UDim2.new(x, 0, 0, y), Size = UDim2.new(w, -4, 0, 14), TextSize = 12, Font = T.body, TextColor3 = T.dim, Parent = box })
		local _, fill = UI.bar(box, color, { Position = UDim2.new(x, 0, 0, y + 15), Size = UDim2.new(w, -6, 0, 8) })
		return fill
	end
	refs.stamFill = small(42, Color3.fromHex("#8FD27A"), "Stamina", 0, 0.34)
	refs.foodFill = small(42, Color3.fromHex("#D9A15B"), "Food", 0.34, 0.33)
	refs.waterFill = small(42, Color3.fromHex("#6FB6E0"), "Water", 0.67, 0.33)
	refs.ammo = UI.label("", { Position = UDim2.new(0, 0, 0, 70), Size = UDim2.new(1, 0, 0, 18), TextSize = 13, Font = T.body, TextColor3 = T.dim, TextWrapped = true, Parent = box })
	refs.vitals = box

	-- Pact box: who you're allied with, offers, and the snap button.
	local pb = UI.frame({ Name = "Pact", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 188), Size = UDim2.new(0, 250, 0, 96), BackgroundTransparency = 0.1, Parent = parent })
	UI.corner(pb, 12)
	UI.pad(pb, 8)
	refs.pactText = UI.label("", { Size = UDim2.new(1, 0, 0, 40), TextSize = 14, Font = T.body, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = pb })
	local prow = UI.frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -36), Size = UDim2.new(1, 0, 0, 34), Parent = pb })
	UI.list(prow, Enum.FillDirection.Horizontal, 6)
	refs.pactA = UI.button("Offer pact (P)", T.blue, { LayoutOrder = 1, Size = UDim2.new(0.5, -3, 1, 0), TextSize = 13, Parent = prow }, function()
		local p = Hud.pact
		if p and p.offer then
			Net.act("pactAccept")
		elseif p and #p.allies > 0 then
			Net.act("pactSnap")
		else
			Net.act("pactOffer")
		end
	end)
	refs.pactB = UI.button("Decline (N)", T.card, { LayoutOrder = 2, Size = UDim2.new(0.5, -3, 1, 0), TextSize = 13, TextColor3 = T.text, Parent = prow }, function()
		Net.act("pactDecline")
	end)
	refs.pact = pb

	local info = UI.frame({ Name = "MatchInfo", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 74), Size = UDim2.new(0, 250, 0, 106), BackgroundTransparency = 0.1, Parent = parent })
	UI.corner(info, 12)
	UI.pad(info, 10)
	refs.alive = UI.label("48 left", { Size = UDim2.new(1, 0, 0, 30), TextSize = 28, TextColor3 = T.gold, Parent = info })
	refs.veil = UI.label("", { Position = UDim2.new(0, 0, 0, 34), Size = UDim2.new(1, 0, 0, 20), TextSize = 15, Font = T.body, TextColor3 = T.veil, Parent = info })
	refs.twist = UI.label("", { Position = UDim2.new(0, 0, 0, 56), Size = UDim2.new(1, 0, 0, 30), TextSize = 13, Font = T.body, TextColor3 = T.dim, Parent = info })
	refs.info = info

	local bar = UI.frame({ Name = "Hotbar", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.new(0, 6 * 70, 0, 66), BackgroundTransparency = 1, Parent = parent })
	UI.list(bar, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center)
	refs.slots = {}
	for i = 1, 6 do
		local s = UI.button("", T.card, { LayoutOrder = i, Size = UDim2.new(0, 64, 0, 64), TextSize = 13, TextColor3 = T.text, TextWrapped = true, Parent = bar }, function()
			Net.act("equipSlot", i)
		end)
		UI.label(tostring(i), { Position = UDim2.new(0, 4, 0, 2), Size = UDim2.new(0, 14, 0, 14), TextSize = 12, TextColor3 = T.dim, Parent = s })
		refs.slots[i] = s
	end
	refs.hotbar = bar

	-- Veil compass: tells you which way is safe when you're near the edge.
	refs.edge = UI.label("", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 72), Size = UDim2.new(0, 520, 0, 26), TextSize = 20, TextColor3 = T.veil, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.4, Parent = parent })

	refs.viewBtn = UI.button("View: 3rd", T.card, {
		Name = "ViewToggle",
		Position = UDim2.new(0, 14, 0, 72),
		Size = UDim2.new(0, 124, 0, 32),
		TextSize = 14,
		TextColor3 = T.text,
		Visible = false,
		Parent = parent,
	}, function()
		local s = Net.state and Net.state.settings
		Net.act("setting", "viewFirst", not (s and s.viewFirst == true))
	end)
end

function Hud.mount(parent: Frame, p: any)
	panels = p
	topBar(parent)
	menu(parent)
	lobbyCard(parent)
	arenaHud(parent)
	Net.on("lobby", function(d)
		Hud.lobby = d
	end)
	Net.on("match", function(d)
		Hud.match = d
	end)
	Net.on("inv", function(d)
		Hud.inv = d
		Hud.pep = d.pep
	end)
	Net.on("pep", function(d)
		Hud.pep = d.pep
	end)
	Net.on("vitals", function(d)
		Hud.vitals = d
	end)
	Net.on("pact", function(d)
		Hud.pact = d
	end)
	Net.on("matchStart", function()
		Hud.pact = nil
		Hud.vitals = nil
	end)
	Net.on("arena", function()
		Hud.mode = "arena"
	end)
end

local ITEM_ICON: { [string]: string } = { bow = "🏹", spear = "🔱", knife = "🔪", arrows = "➶", backpack = "🎒", trailmix = "🥜", apple = "🍎", canteen = "🧴", bandage = "🩹", sweettea = "🍵" }

function Hud.update()
	local s = Net.state
	if s then
		refs.level.Text = string.format("Lv %d", s.level)
		refs.rank.Text = s.prestige > 0 and string.format("%s ★%d", s.rank, s.prestige) or s.rank
		refs.xpFill.Size = UDim2.new(math.clamp(s.xp / math.max(1, s.xpNext), 0, 1), 0, 1, 0)
		refs.xp.Text = string.format("%d / %d %s", s.xp, s.xpNext, Names.XP)
		refs.streak.Text = string.format("🔥 %d-day streak", s.streak)
		refs.play.Text = s.play > 0 and string.format("Match streak ×%.1f %s", s.playMult, Names.XP) or "Play again soon for a streak bonus"
		refs.autoBtn.Text = (s.settings and s.settings.autoQueue) and "Auto: ON" or "Auto: OFF"
		local first = s.settings and s.settings.viewFirst == true
		refs.viewBtn.Text = first and "View: 1st" or "View: 3rd"
		refs.viewBtn.Visible = true
		local openChallenges = 0
		for _, c in ipairs(s.daily) do
			if not c.done then
				openChallenges += 1
			end
		end
		local seasonBadge = s.season and s.season.unclaimed or 0
		-- one calm note per session when a tier is reached without the Premium lane
		if s.season and lastTier and s.season.tier > lastTier and not s.season.premium and not premiumNoted then
			premiumNoted = true
			Hud.note("Tier " .. s.season.tier .. " reached! The Premium lane has a ✦ reward here too. See it in the " .. Names.TRACK .. ".")
		end
		lastTier = s.season and s.season.tier or lastTier
		refs.badges.season.Visible = seasonBadge > 0
		refs.badges.season.Text = tostring(seasonBadge)
		refs.badges.challenges.Visible = openChallenges > 0
		refs.badges.challenges.Text = tostring(openChallenges)
		local letters = s.letters and s.letters.waiting or 0
		refs.badges.letters.Visible = letters > 0
		refs.badges.letters.Text = tostring(letters)
		-- a calm dot when this week's shop picks are new to you (no countdown)
		refs.badges.shop.Visible = s.store ~= nil and s.store.isNew == true
		refs.badges.shop.Text = "•"
	end
	local inArena = Hud.mode == "arena"
	refs.vitals.Visible = inArena
	refs.hotbar.Visible = inArena
	refs.info.Visible = inArena or Hud.mode == "gallery"
	refs.menu.Visible = Hud.mode == "lobby"
	refs.lobbyCard.Visible = Hud.mode == "lobby"
	refs.edge.Visible = inArena
	local pa = Hud.pact
	refs.pact.Visible = inArena and not (pa and pa.ended)
	if inArena then
		if pa and pa.offer then
			refs.pactText.Text = string.format("🤝 %s (%s) offers a pact.", pa.offer.name, pa.offer.reach)
			refs.pactA.Text = "Accept (Y)"
			refs.pactB.Visible = true
		elseif pa and #pa.allies > 0 then
			refs.pactText.Text = (pa.snapping and "Snapping… " or "Pact: ") .. table.concat(pa.allies, ", ")
			refs.pactA.Text = pa.snapping and "Snapping…" or "Snap pact (X)"
			refs.pactA.BackgroundColor3 = T.red
			refs.pactB.Visible = false
		else
			refs.pactText.Text = "No pact. Get close to someone from another " .. Names.REGION .. " and offer one."
			refs.pactA.Text = "Offer pact (P)"
			refs.pactA.BackgroundColor3 = T.blue
			refs.pactB.Visible = false
		end
	end
	local l = Hud.lobby
	if l then
		if l.state == "Arena" or l.state == "Pregame" or l.state == "Launch" then
			refs.lobbyStatus.Text = string.format("A %s is live (%s left). %s", Names.EVENT_SHORT, tostring(l.alive or "?"), l.inQueue and "You're in the next one." or "Queue for the next one!")
		elseif l.inQueue then
			refs.lobbyStatus.Text = string.format("In the %s: %d player%s. Stand-Ins fill to %d. Starts in %ds", Names.DRAW, l.queued, l.queued == 1 and "" or "s", l.size, math.ceil(l.seconds or 0))
		else
			refs.lobbyStatus.Text = string.format("%d in the %s. Step on the gold pad or press the button.", l.queued, Names.DRAW)
		end
		refs.queueBtn.Text = l.inQueue and "Leave the " .. Names.DRAW or "Enter the " .. Names.DRAW
		refs.queueBtn.BackgroundColor3 = l.inQueue and T.red or T.gold
		refs.queueBtn.TextColor3 = l.inQueue and Color3.new(1, 1, 1) or T.dark
		refs.partnerBtn.Text = l.partner and ("👥 " .. l.partner) or (l.invite and "👥 Invite!" or "👥 Partner")
		refs.lobbyRule.Text = l.weekly and ("This week: " .. l.weekly.name .. " · " .. l.weekly.text) or ""
	end
	local m = Hud.match
	if m and (inArena or Hud.mode == "gallery") then
		refs.alive.Text = string.format("%d left", m.alive)
		if m.calm then
			refs.veil.Text = string.format("Dome broken! %s calm for %ds", Names.VEIL, m.calm)
		elseif m.core then
			refs.veil.Text = "The Veil Core is lit: bounce a spear into it"
		elseif m.shrinking then
			refs.veil.Text = string.format("%s is closing!", Names.VEIL)
		elseif m.nextIn then
			refs.veil.Text = string.format("%s moves in %s", Names.VEIL, secs(m.nextIn))
		else
			refs.veil.Text = string.format("%s is at its smallest", Names.VEIL)
		end
		refs.twist.Text = m.twist and ("Twist: " .. m.twist) or ""
		local char = game:GetService("Players").LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp and inArena then
			local flat = Vector3.new(hrp.Position.X, 0, hrp.Position.Z)
			local d = flat.Magnitude
			if d > m.radius then
				refs.edge.Text = "⚠ Outside " .. Names.VEIL .. "! Head toward " .. Names.HUB .. "."
			elseif m.radius - d < 60 then
				refs.edge.Text = "Near " .. Names.VEIL .. " edge"
			else
				refs.edge.Text = ""
			end
		end
	end
	if inArena then
		local pep = Hud.pep
		refs.pepLabel.Text = string.format("Pep %d", math.floor(pep))
		refs.pepFill.Size = UDim2.new(math.clamp(pep / Config.PEP_MAX, 0, 1), 0, 1, 0)
		refs.pepFill.BackgroundColor3 = pep < 30 and T.red or Color3.fromHex("#E0B44A")
		local inv = Hud.inv
		for i = 1, 6 do
			local slot = refs.slots[i]
			local item = inv and inv.inv[i]
			local locked = inv == nil or i > inv.slots
			slot.Text = item and ((ITEM_ICON[item] or "•") .. "\n" .. ((Config.Items[item] and Config.Items[item].name) or item)) or (locked and "🔒" or "")
			slot.BackgroundColor3 = (inv and inv.equipped == i) and T.cardHi or T.card
			local stroke = slot:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = (inv and inv.equipped == i) and T.gold or Color3.fromHex("#0E1018")
			end
		end
		refs.ammo.Text = inv and string.format("Arrows %d · Bag %d/%d · Click use · Shift sprint · Q throw spear", inv.ammo, #inv.inv, inv.slots) or ""
		local v = Hud.vitals
		local M = Config.Meters
		refs.stamFill.Size = UDim2.new(math.clamp((v and v.stamina or Config.STAMINA_MAX) / Config.STAMINA_MAX, 0, 1), 0, 1, 0)
		refs.stamFill.BackgroundColor3 = (v and v.tired) and T.red or Color3.fromHex("#8FD27A")
		refs.foodFill.Size = UDim2.new(math.clamp((v and v.food or M.start) / M.max, 0, 1), 0, 1, 0)
		refs.waterFill.Size = UDim2.new(math.clamp((v and v.water or M.start) / M.max, 0, 1), 0, 1, 0)
	end
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="84">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Client entry: builds the UI in code, wires server pushes, and handles arena input
-- (click to use the held item, 1–6 to pick a slot, Shift to sprint, Q / right-click to throw a
-- spear, P to offer a pact, Y/N to answer one, X to snap yours). Stamina is server-owned: the
-- client only says "I want to sprint" and shows what the server sends back.
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local Net = require(script.Parent.Net)
local Fx = require(script.Parent.Fx)
local Sfx = require(script.Parent.Sfx)
local Hud = require(script.Parent.Hud)
local Panels = require(script.Parent.Panels)
local Cutscene = require(script.Parent.Cutscene)
local GalleryPanel = require(script.Parent.GalleryPanel)
local Results = require(script.Parent.Results)
local AnimPlayer = require(script.Parent.AnimPlayer)
local OfferCard = require(script.Parent.OfferCard)
local V5 = require(script.Parent.V5)
local View = require(script.Parent.View)
local WorldAudio = require(script.Parent.WorldAudio)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Names = require(Shared.Names)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local screen = UI.new("ScreenGui", { Name = "Daybreak", ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = playerGui })
-- Scale everything down on phones; the scaled root is sized 1/scale so edge-anchored pieces stay on the edges.
local root = UI.new("Frame", { Name = "Root", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = screen })
local scale = UI.new("UIScale", { Parent = root })
local function rescale()
	local cam = workspace.CurrentCamera
	local v = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local s = math.clamp(math.min(v.X / 1280, v.Y / 760), 0.55, 1)
	scale.Scale = s
	root.Size = UDim2.fromScale(1 / s, 1 / s)
end
rescale()
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

Sfx.mount()
WorldAudio.start()
UI.onClick = function()
	Sfx.play("click", nil, 0.05)
end
Fx.mount(root)
Panels.mount(root)
Hud.mount(root, Panels)
GalleryPanel.mount(root)
Results.mount(root)
OfferCard.mount(root)
AnimPlayer.start()
Cutscene.mount(root)
V5.mount(root)
View.mount(root)
View.start()
View.menuOpen = function()
	return Panels.isOpen()
end
Net.notify = Fx.toast

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

Hud.note = function(text: string)
	Fx.toast(text, "info")
end
Net.on("toast", function(p)
	Fx.toast(p.text, p.kind)
end)
Net.on("arena", function()
	Hud.mode = "arena"
	Fx.announce("GO!", UI.Theme.gold, 1.6)
	Sfx.play("bell", 1.1)
end)
Net.on("matchStart", function(d)
	Fx.toast(string.format("%s begins: %d players + %d %ss.", Names.EVENT_SHORT, d.humans, d.bots, Names.BOT_TAG), "info")
end)
Net.on("hazard", function(d)
	Sfx.play("hazard")
	Fx.announce(d.name, UI.Theme.red, 2.4)
	Fx.toast(d.text, "bad")
end)
Net.on("tracer", function(d)
	Fx.tracer(d.from, d.to, d.color, d.bright)
end)
Net.on("hitmark", function(d)
	Sfx.play("swat", 1.1, 0.05)
	Fx.pop("-" .. tostring(math.floor(d.amount)), UI.Theme.gold, 22)
end)
Net.on("pep", function(d)
	if d.from ~= "snack" and d.from ~= "gift" then
		Fx.hit()
	end
end)
Net.on("loot", function(d)
	Fx.toast("Found: " .. d.name, "good")
end)
Net.on("token", function(d)
	Sfx.play("coins")
	Fx.pop((d.new and "New token! " or "Token: ") .. d.name, UI.Theme.gold, 28)
end)
Net.on("pactOffer", function(d)
	Sfx.play("ding")
	Fx.announce("🤝 " .. d.name .. " offers a pact", UI.Theme.blue, 2.2)
	Fx.toast(string.format("%s (%s) wants a pact. Y to accept, N to decline (%ds).", d.name, d.reach, d.seconds), "info")
end)
Net.on("pactWarning", function(d)
	Sfx.play("pactWarn")
	Fx.announce("⚠ " .. d.name .. " is snapping your pact!", UI.Theme.red, d.seconds)
end)
Net.on("pactSnapped", function(d)
	Fx.announce("💔 " .. d.name .. " broke your pact", UI.Theme.red, 2.4)
	Fx.toast("“" .. d.line .. "” (Guarded for " .. d.guard .. "s)", "info")
end)
Net.on("pactSnapDone", function(d)
	Fx.announce("Pact snapped", UI.Theme.red, 1.6)
	Fx.toast(string.format("Your first hit on %s in %ds is a Pact Snap strike.", table.concat(d.names, " or "), d.window), "info")
end)
Net.on("pactsEnded", function(d)
	Fx.announce(string.format("Final %d: every pact is over", d.left), UI.Theme.gold, 2.4)
end)
Net.on("veilCore", function()
	Sfx.play("veilCore")
	Fx.announce("The Veil Core is glowing", UI.Theme.veil, 2.6)
	Fx.toast("Bounce a thrown spear off " .. Names.VEIL .. " into the Core to break the dome.", "info")
end)
Net.on("veilBroken", function(d)
	Sfx.play("veilBreak")
	Fx.announce(string.format("💥 %s broke the dome!", d.by), UI.Theme.veil, 3)
	Fx.toast(string.format("%s is calm for %ds.", Names.VEIL, d.seconds), "good")
end)
Net.on("betrayed", function(d)
	Fx.hit()
	Fx.toast("“" .. d.line .. "”", "bad")
end)
local function headOf(userId: number): BasePart?
	local p = Players:GetPlayerByUserId(userId)
	local head = p and p.Character and p.Character:FindFirstChild("Head")
	return head and head:IsA("BasePart") and head or nil
end
Net.on("emote", function(d)
	local head = headOf(d.user)
	if head then
		Fx.bubble(head, d.icon .. " " .. d.name, d.color, 3)
	end
	-- v4: code-made emote clips play on every client (uploaded animations play server-side)
	local p = Players:GetPlayerByUserId(d.user)
	if d.clip and not d.uploaded and p and p.Character then
		AnimPlayer.play(p.Character, d.clip)
	end
end)
-- v4: after every match, everyone in the lobby gets a 6 s look at the Victory Podium.
local podiumToken = 0
Net.on("podiumShow", function(d)
	if Hud.mode == "arena" or Cutscene.playing or Panels.isOpen() or not d.camera then
		return
	end
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	podiumToken += 1
	local my = podiumToken
	View.hold()
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = d.camera
	local names = {}
	for _, e in ipairs(d.entries or {}) do
		table.insert(names, ({ "🥇", "🥈", "🥉" })[e.place] .. " " .. e.name)
	end
	Fx.toast("Victory Podium: " .. table.concat(names, "   "), "info")
	task.delay(d.seconds or 6, function()
		if podiumToken == my and Hud.mode ~= "arena" then
			cam.CameraType = Enum.CameraType.Custom
			View.release()
		elseif podiumToken == my then
			View.release()
		end
	end)
end)
Net.on("mastery", function(d)
	Sfx.play("coins")
	Fx.announce(string.format("%s %s mastery %s", d.name, d.slot, d.stars), UI.Theme.gold, 2.4)
	if d.perk then
		Fx.toast("Unlocked: " .. d.perk, "good")
	end
end)
Net.on("partnerMoment", function(d)
	OfferCard.show(d, {
		try = function()
			Net.act("gift", d.target, d.gift)
		end,
	}, 15)
end)
Net.on("cheer", function(d)
	if d.kind == "flare" and d.at then
		Fx.flare(d.at, d.color)
	end
	Fx.toast(string.format("%s %s cheers for %s!", d.kind == "flare" and "🎆" or "📣", d.from, d.to), "info")
end)
Net.on("gift", function(d)
	Sfx.play("ding")
	Fx.announce("🪂 Gift from " .. d.from .. "!", UI.Theme.blue, 2.4)
	if d.note then
		Fx.toast("“" .. d.note .. "”", "good")
	end
end)

-- ===== arena input =====
local sprinting = false
local function setSprint(on: boolean)
	if on ~= sprinting then
		sprinting = on
		task.spawn(Net.act, "sprint", on)
	end
end

local function arena(): boolean
	return Hud.mode == "arena" and not Cutscene.playing
end

-- Third person keeps mouse.Hit. First person sends the shoulder aim, not the eye ray.
local function aimPoint(): Vector3
	if View.isFirst() then
		return View.shotAim()
	end
	return player:GetMouse().Hit.Position
end
View.onUse = function()
	if arena() and not Panels.isOpen() then
		Net.act("use", aimPoint())
	end
end
View.onThrow = function()
	if arena() and not Panels.isOpen() then
		Net.act("throw", aimPoint())
	end
end

UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if input.KeyCode == Enum.KeyCode.ButtonR2 then
		View.onUse()
		return
	elseif input.KeyCode == Enum.KeyCode.ButtonL2 then
		View.onThrow()
		return
	end
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if arena() and not Panels.isOpen() then
			Net.act("use", aimPoint())
		end
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.KeyCode == Enum.KeyCode.Q then
		if arena() and not Panels.isOpen() then
			Net.act("throw", aimPoint())
		end
	elseif input.KeyCode == Enum.KeyCode.LeftShift then
		setSprint(true)
	elseif input.KeyCode == Enum.KeyCode.B and not arena() and not Panels.isOpen() then
		task.spawn(Net.act, "emote", "")
	elseif input.KeyCode == Enum.KeyCode.P and arena() then
		Net.act("pactOffer")
	elseif input.KeyCode == Enum.KeyCode.Y and arena() then
		Net.act("pactAccept")
	elseif input.KeyCode == Enum.KeyCode.N and arena() then
		Net.act("pactDecline")
	elseif input.KeyCode == Enum.KeyCode.X and arena() then
		Net.act("pactSnap")
	elseif input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
		Panels.close()
		Cutscene.skip()
	else
		local n = input.KeyCode.Value - Enum.KeyCode.One.Value + 1
		if arena() and n >= 1 and n <= 6 then
			Net.act("equipSlot", n)
		end
	end
end)
UserInputService.InputEnded:Connect(function(input: InputObject)
	if input.KeyCode == Enum.KeyCode.LeftShift then
		setSprint(false)
	end
end)
Net.on("arena", function()
	if sprinting then
		task.spawn(Net.act, "sprint", true)
	end
end)
local _ = RunService
local _c = Config

task.spawn(function()
	while true do
		task.wait(0.1)
		local ok, err = pcall(function(): any
			Hud.update()
			if Net.state and Net.state.settings then
				Sfx.apply(Net.state.settings)
				View.apply(Net.state.settings)
			end
			return nil
		end)
		if not ok then
			warn("[Hud] " .. tostring(err))
		end
	end
end)

task.delay(2, function()
	if not Net.state then
		Net.act("refresh")
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--!strict
-- Client networking: one RemoteFunction for requests, one RemoteEvent for server pushes.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Action = Remotes:WaitForChild("Action") :: RemoteFunction
local Push = Remotes:WaitForChild("Push") :: RemoteEvent

local Net = {}
Net.state = nil :: any
Net.changed = Instance.new("BindableEvent")
Net.notify = function(_text: string, _kind: string?) end
local handlers: { [string]: { (any) -> () } } = {}

function Net.on(kind: string, fn: (any) -> ())
	handlers[kind] = handlers[kind] or {}
	table.insert(handlers[kind], fn)
end

-- Ask the server to do something. Shows the server's message as a toast.
function Net.act(action: string, a: any?, b: any?, c: any?): (boolean, string?)
	local ok, res = pcall(function()
		return Action:InvokeServer(action, a, b, c)
	end)
	if not ok or type(res) ~= "table" then
		Net.notify("Connection hiccup. Try again!", "bad")
		return false, nil
	end
	if res.msg then
		Net.notify(res.msg, res.ok and "good" or "info")
	end
	return res.ok == true, res.msg
end

Push.OnClientEvent:Connect(function(kind: string, payload: any)
	if kind == "state" then
		Net.state = payload
		Net.changed:Fire(payload)
	end
	local list = handlers[kind]
	if list then
		for _, fn in ipairs(list) do
			task.spawn(fn, payload)
		end
	end
end)

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">OfferCard</string>
            <string name="Source"><![CDATA[--!strict
--[[
	OfferCard: one small, calm card in the lower right (never a full-screen popup, never a timer).
	Used for the post-match fade preview, the first-win gift and the Gallery partner moment.
	"No thanks" on a shop-linked card hides that kind for the rest of the session.
]]
local UI = require(script.Parent.UI)
local T = UI.Theme

local OfferCard = {}
local holder: Frame = nil :: any
local dismissed: { [string]: boolean } = {}

function OfferCard.mount(parent: Frame)
	holder = UI.frame({ Name = "OfferCard", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -150), Size = UDim2.new(0, 340, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 30, Parent = parent })
	UI.list(holder, nil, 8)
end

-- card: Offers.Card. handlers.try / handlers.buy run when those buttons are pressed.
function OfferCard.show(card: any, handlers: { try: (() -> ())?, buy: (() -> ())? }, seconds: number?)
	if not holder or dismissed[card.kind] then
		return
	end
	for _, c in ipairs(holder:GetChildren()) do
		if c:IsA("Frame") and c:GetAttribute("Kind") == card.kind then
			c:Destroy()
		end
	end
	local f = UI.frame({ BackgroundColor3 = T.panel, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 31, Parent = holder })
	f:SetAttribute("Kind", card.kind)
	UI.corner(f, 12)
	UI.stroke(f, card.color and Color3.fromHex(card.color) or T.gold, 2)
	UI.pad(f, 12)
	UI.list(f, nil, 6)
	UI.label(card.title, { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 18, TextColor3 = T.gold, TextWrapped = true, ZIndex = 32, Parent = f })
	UI.label(card.body, { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 14, Font = T.body, TextColor3 = T.text, TextWrapped = true, ZIndex = 32, Parent = f })
	local row = UI.frame({ LayoutOrder = 3, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 36), ZIndex = 32, Parent = f })
	UI.list(row, Enum.FillDirection.Horizontal, 6)
	local function close()
		f:Destroy()
	end
	if card.tryLabel and handlers.try then
		UI.button(card.tryLabel, T.blue, { Size = UDim2.new(0, 120, 0, 34), TextSize = 13, TextColor3 = T.text, ZIndex = 33, Parent = row }, function()
			(handlers.try :: () -> ())()
			if card.kind ~= "fadePreview" then
				close()
			end
		end)
	end
	if card.buyLabel and handlers.buy then
		UI.button(card.buyLabel, T.card, { Size = UDim2.new(0, 110, 0, 34), TextSize = 13, TextColor3 = T.text, ZIndex = 33, Parent = row }, function()
			close();
			(handlers.buy :: () -> ())()
		end)
	end
	UI.button(card.noLabel, T.card, { Size = UDim2.new(0, 84, 0, 34), TextSize = 13, TextColor3 = T.dim, ZIndex = 33, Parent = row }, function()
		if card.itemId and card.kind == "fadePreview" then
			dismissed[card.kind] = true
		end
		close()
	end)
	task.delay(seconds or 20, function()
		if f.Parent then
			close()
		end
	end)
end

return OfferCard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">Panels</string>
            <string name="Source"><![CDATA[--!strict
-- Lobby menus: Season Track, Challenges, My Reach, Tokens, Shop, Profile, Settings, Partner.
-- One modal window; each tab rebuilds its content from the latest state snapshot.
-- Shop copy stays calm: "Buy for R$ X", no timers, no "last chance".
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local Net = require(script.Parent.Net)
local Hud = require(script.Parent.Hud)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Names = require(Shared.Names)
local Content = require(Shared.Content)
local Shop = require(Shared.Store)
local Prefs = require(Shared.Prefs)
local Mastery = require(Shared.Mastery)
local TryOn = require(script.Parent.TryOn)
local SocialService = game:GetService("SocialService")
Shop.addReachPride(Names.REACH_LIST)
local T = UI.Theme

local Panels = {}
local win: Frame = nil :: any
local title: TextLabel = nil :: any
local body: ScrollingFrame = nil :: any
local current: string? = nil

local function row(h: number?, order: number?): Frame
	local f = UI.frame({ BackgroundColor3 = T.card, Size = UDim2.new(1, -8, 0, h or 54), LayoutOrder = order or 0, Parent = body })
	UI.corner(f, 10)
	UI.pad(f, 8)
	return f
end

local function heading(text: string, order: number)
	UI.label(text, { Size = UDim2.new(1, -8, 0, 26), TextSize = 20, TextColor3 = T.gold, LayoutOrder = order, Parent = body })
end

local function note(text: string, order: number)
	UI.label(text, { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 15, Font = T.body, TextColor3 = T.dim, LayoutOrder = order, Parent = body })
end

local builders: { [string]: (any) -> () } = {}

builders.season = function(s: any)
	local se = s.season
	title.Text = "🌅 " .. Names.TRACK .. " · " .. se.name
	note(string.format("Tier %d of %d. %d %s, %d per tier. Earn %s from every match and every challenge. Tier Skips in the shop only move you along; every reward is cosmetic.", se.tier, #se.tiers, se.stars, Names.STARS, se.perTier, Names.STARS), 0)
	for i, tier in ipairs(se.tiers) do
		local f = row(58, i)
		local reached = i <= se.tier
		UI.label(string.format("Tier %d", i), { Size = UDim2.new(0, 70, 1, 0), TextSize = 18, TextColor3 = reached and T.gold or T.dim, Parent = f })
		UI.label("Free: " .. tier.free, { Position = UDim2.new(0, 76, 0, 0), Size = UDim2.new(0.5, -110, 1, 0), TextSize = 15, Font = T.body, Parent = f })
		UI.label("Premium: " .. tier.premium, { Position = UDim2.new(0.5, -30, 0, 0), Size = UDim2.new(0.5, -150, 1, 0), TextSize = 15, Font = T.body, TextColor3 = se.premium and T.text or T.dim, Parent = f })
		local freeDone = se.claimedFree[tostring(i)] or se.claimedFree[i]
		local premDone = se.claimedPremium[tostring(i)] or se.claimedPremium[i]
		if reached and not freeDone then
			UI.button("Claim", T.gold, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -86, 0.5, 0), Size = UDim2.new(0, 76, 0, 34), TextSize = 15, Parent = f }, function()
				Net.act("claimTier", i, "free")
			end)
		end
		if reached and se.premium and not premDone then
			UI.button("Claim ✦", T.blue, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 80, 0, 34), TextSize = 15, Parent = f }, function()
				Net.act("claimTier", i, "premium")
			end)
		end
	end
	if not se.premium then
		note("The Premium lane is an optional cosmetic pass. Find it in the Shop if you want it.", 999)
	end
end

local function challengeList(list: { any }, order: number)
	for i, c in ipairs(list) do
		local f = row(50, order + i)
		UI.label((c.done and "✅ " or "◻️ ") .. c.text, { Size = UDim2.new(1, -170, 1, 0), TextSize = 16, Font = T.body, Parent = f })
		UI.label(string.format("%d/%d · +%d %s · +%d ★", math.min(c.progress, c.goal), c.goal, c.xp, Names.XP, c.stars), { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 170, 1, 0), TextSize = 14, Font = T.body, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Right, Parent = f })
	end
end

builders.challenges = function(s: any)
	title.Text = "📜 Challenges"
	heading("Today", 0)
	challengeList(s.daily, 0)
	note(string.format("New daily challenges in %dh %dm. Rewards are added automatically when you finish.", s.dailyResetIn // 3600, (s.dailyResetIn % 3600) // 60), 50)
	heading("This week", 100)
	challengeList(s.weekly, 100)
	heading("Weekly " .. Names.EVENT_SHORT .. " rule", 200)
	note(s.weeklyRule.name .. ": " .. s.weeklyRule.text, 201)
end

builders.reach = function(s: any)
	title.Text = "🏳️ My " .. Names.REGION
	note(string.format("Pick a home %s. Every match you play earns it points on the weekly board. The top 3 %s each week give all their players a banner. You can switch once a week.", Names.REGION, Names.REGIONS), 0)
	heading("This week's board", 1)
	for i, r in ipairs(s.reachTop) do
		if i > 8 then
			break
		end
		local f = row(36, 1 + i)
		UI.label(string.format("#%d  %s", i, r.reach), { Size = UDim2.new(0.7, 0, 1, 0), TextSize = 16, TextColor3 = r.reach == s.reach and T.gold or T.text, Parent = f })
		UI.label(tostring(r.points), { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0.3, 0, 1, 0), TextSize = 16, TextXAlignment = Enum.TextXAlignment.Right, Parent = f })
	end
	heading(s.canChangeReach and "Choose your " .. Names.REGION or ("Home: " .. (s.reach ~= "" and s.reach or "none")), 50)
	if s.canChangeReach or s.reach == "" then
		local grid = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 51, Parent = body })
		UI.new("UIGridLayout", { CellSize = UDim2.new(0, 150, 0, 36), CellPadding = UDim2.new(0, 6, 0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
		for i, name in ipairs(Names.REACH_LIST) do
			UI.button(name, name == s.reach and T.gold or T.card, { LayoutOrder = i, TextSize = 14, TextColor3 = name == s.reach and T.dark or T.text, Parent = grid }, function()
				Net.act("setReach", name)
			end)
		end
	end
end

builders.tokens = function(s: any)
	title.Text = "🪙 " .. Names.TOKENS
	note(string.format("%d of %d found. Tokens appear in the arena each match. Each one you find stays in your book forever.", s.tokens, s.tokenTotal), 0)
	local grid = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = body })
	UI.new("UIGridLayout", { CellSize = UDim2.new(0, 150, 0, 60), CellPadding = UDim2.new(0, 6, 0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	for i, t in ipairs(Content.TOKENS) do
		local have = s.tokenBook[t.id] ~= nil
		local f = UI.frame({ BackgroundColor3 = have and T.cardHi or T.card, LayoutOrder = i, Parent = grid })
		UI.corner(f, 10)
		UI.pad(f, 6)
		UI.label(have and t.name or "???", { Size = UDim2.new(1, 0, 0, 22), TextSize = 15, TextColor3 = have and T.gold or T.dim, Parent = f })
		UI.label("Found in: " .. t.zone, { Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, 0, 0, 18), TextSize = 12, Font = T.body, TextColor3 = T.dim, Parent = f })
	end
end

-- ===================== Item Shop (v3) =====================
-- Tabs: This Week, Arms, Style, Reach, Bundles, Passes & Club. Every buy goes through a
-- confirm card that names the exact item and price. Nothing is random; rotation is a fixed
-- weekly schedule, so "Back in N weeks" is always true.
local shopTab = "week"
local confirm: Frame? = nil
local friendCache: { [number]: boolean } = {}

local function closeConfirm()
	if confirm then
		confirm:Destroy()
		confirm = nil
	end
end

local function isFriend(p: Player): boolean
	local v = friendCache[p.UserId]
	if v == nil then
		local ok, res = pcall(function()
			return Players.LocalPlayer:IsFriendsWithAsync(p.UserId)
		end)
		v = ok and res == true
		friendCache[p.UserId] = v
	end
	return v :: boolean
end

local function openConfirm(o: any, store: any)
	closeConfirm()
	task.spawn(Net.act, "shopStep", "item_view")
	local c = UI.frame({ BackgroundColor3 = T.bg, BackgroundTransparency = 0.15, Size = UDim2.fromScale(1, 1), ZIndex = 20, Parent = win })
	confirm = c
	UI.corner(c, 14)
	local card = UI.frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 420, 0, 300), BackgroundColor3 = T.panel, ZIndex = 21, Parent = c })
	UI.corner(card, 14)
	UI.stroke(card, T.gold, 2)
	UI.pad(card, 16)
	UI.label(o.icon .. " " .. o.name, { Size = UDim2.new(1, 0, 0, 34), TextSize = 24, TextColor3 = T.gold, ZIndex = 22, Parent = card })
	UI.label(o.desc or "", { Position = UDim2.new(0, 0, 0, 38), Size = UDim2.new(1, 0, 0, 52), TextSize = 15, Font = T.body, TextColor3 = T.dim, TextWrapped = true, ZIndex = 22, Parent = card })
	local voucher = store.vouchers and Shop.voucherFor(store.vouchers, o.price)
	local gifting: Player? = nil
	local status = UI.label("", { Position = UDim2.new(0, 0, 0, 92), Size = UDim2.new(1, 0, 0, 22), TextSize = 14, Font = T.body, TextColor3 = T.text, ZIndex = 22, Parent = card })
	local function refreshStatus()
		status.Text = (gifting and ("🎁 Gift to " .. gifting.DisplayName) or "For you") .. (voucher and "  ·  you have a voucher for this" or "")
	end
	refreshStatus()
	local function buy(useVoucher: boolean)
		Net.act("shopBuy", o.kind, o.id, { to = gifting and gifting.UserId or nil, voucher = useVoucher })
		closeConfirm()
	end
	UI.button("Buy for R$ " .. o.price, T.gold, { Position = UDim2.new(0, 0, 1, -96), Size = UDim2.new(0.5, -4, 0, 42), TextSize = 17, ZIndex = 22, Parent = card }, function()
		buy(false)
	end)
	UI.button("Not now", T.card, { Position = UDim2.new(0.5, 4, 1, -96), Size = UDim2.new(0.5, -4, 0, 42), TextSize = 17, TextColor3 = T.text, ZIndex = 22, Parent = card }, closeConfirm)
	if voucher then
		UI.button("Use voucher (R$ " .. voucher .. ")", T.green, { Position = UDim2.new(0, 0, 1, -48), Size = UDim2.new(0.5, -4, 0, 40), TextSize = 15, TextColor3 = T.text, ZIndex = 22, Parent = card }, function()
			buy(true)
		end)
	end
	if not o.once then
		UI.button("🎁 Gift to a friend", T.blue, { Position = UDim2.new(0.5, 4, 1, -48), Size = UDim2.new(0.5, -4, 0, 40), TextSize = 15, TextColor3 = T.text, ZIndex = 22, Parent = card }, function()
			local picker = UI.frame({ Position = UDim2.new(0, 0, 0, 118), Size = UDim2.new(1, 0, 0, 80), BackgroundTransparency = 1, ZIndex = 23, Parent = card })
			UI.list(picker, Enum.FillDirection.Horizontal, 6)
			local any = false
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= Players.LocalPlayer and isFriend(p) then
					any = true
					UI.button(p.DisplayName, gifting == p and T.gold or T.card, { Size = UDim2.new(0, 120, 0, 34), TextSize = 14, TextColor3 = gifting == p and T.dark or T.text, ZIndex = 24, Parent = picker }, function()
						gifting = p
						refreshStatus()
						picker:Destroy()
					end)
				end
			end
			if not any then
				UI.label("Gifts go to a friend in this server. None here right now.", { Size = UDim2.new(1, 0, 0, 30), TextSize = 14, Font = T.body, TextColor3 = T.dim, ZIndex = 24, Parent = picker })
			end
		end)
	end
end

local function itemCard(parent: Instance, it: any, order: number, store: any)
	local f = UI.frame({ BackgroundColor3 = it.owned and T.cardHi or T.card, LayoutOrder = order, Parent = parent })
	UI.corner(f, 10)
	UI.pad(f, 6)
	local sw = UI.frame({ BackgroundColor3 = Color3.fromHex(it.color or "#F4EFE6"), Size = UDim2.new(1, 0, 0, 6), Parent = f })
	UI.corner(sw, 3)
	UI.label(it.icon, { Position = UDim2.new(0, 0, 0, 10), Size = UDim2.new(1, 0, 0, 40), TextSize = 32, TextXAlignment = Enum.TextXAlignment.Center, Parent = f })
	UI.label(it.name, { Position = UDim2.new(0, 0, 0, 52), Size = UDim2.new(1, 0, 0, 20), TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, Parent = f })
	if not it.owned and TryOn.canTry(it.id) then
		UI.button("👁 Try", T.blue, { Position = UDim2.new(0, 0, 1, -64), Size = UDim2.new(1, 0, 0, 26), TextSize = 12, TextColor3 = T.text, Parent = f }, function()
			task.spawn(Net.act, "shopStep", "try_on")
			Panels.close()
			TryOn.show(it.id)
		end)
	end
	local label = it.owned and "Owned" or ("R$ " .. it.price)
	local color = it.owned and T.green or T.gold
	if not it.owned and not it.canBuy then
		label = it.why or "Not now"
		color = T.card
	end
	UI.button(label, color, { Position = UDim2.new(0, 0, 1, -32), Size = UDim2.new(1, 0, 0, 32), TextSize = 13, TextColor3 = color == T.gold and T.dark or T.text, Parent = f }, function()
		if it.owned then
			Panels.open("profile")
		elseif it.canBuy then
			openConfirm({ kind = "item", id = it.id, name = it.name, icon = it.icon, price = it.price, desc = it.desc }, store)
		end
	end)
end

local function grid(order: number, h: number?): Frame
	local g = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = body })
	UI.new("UIGridLayout", { CellSize = UDim2.new(0, 132, 0, h or 166), CellPadding = UDim2.new(0, 8, 0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = g })
	return g
end

local SHOP_TABS = {
	{ id = "week", text = "This Week" },
	{ id = "arms", text = "Arms" },
	{ id = "style", text = "Style" },
	{ id = "reach", text = "Reach Pride" },
	{ id = "bundles", text = "Bundles" },
	{ id = "passes", text = "Passes & Club" },
}
local TAB_CATS: { [string]: { string } } = {
	arms = { "Arms" },
	style = { "Fades", "Poses", "Emotes", "Wraps", "Nametags", "Parade", "Rusty" },
	reach = { "Reach" },
}

builders.shop = function(s: any)
	title.Text = "🛍️ Daybreak Shop"
	closeConfirm()
	local shop = s.shop
	local store = s.store
	if not shop.visible or not store then
		note("The shop is loading your store rules. Check back in a moment.", 0)
		return
	end
	if store.isNew then
		Net.act("seenShop")
	end
	local tabs = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 40), LayoutOrder = 0, Parent = body })
	UI.list(tabs, Enum.FillDirection.Horizontal, 6)
	for _, t in ipairs(SHOP_TABS) do
		UI.button(t.text, shopTab == t.id and T.gold or T.card, { Size = UDim2.new(0, 112, 0, 36), TextSize = 14, TextColor3 = shopTab == t.id and T.dark or T.text, Parent = tabs }, function()
			shopTab = t.id
			Panels.refresh()
		end)
	end
	local order = 1
	if shopTab == "week" then
		if store.dropName then
			heading("🌾 This week's drop: " .. store.dropName, order)
			order += 1
		end
		note(string.format("New picks every Monday. Today's six change on %s. Every item comes back on a fixed %d-week cycle. Cosmetic only, never random.", store.changesOn, store.cycle), order)
		order += 1
		local g = grid(order)
		for i, it in ipairs(store.featured) do
			itemCard(g, it, i, store)
		end
		order += 1
		local st = nil
		for _, b in ipairs(store.bundles) do
			if b.once then
				st = b
			end
		end
		if st and st.canBuy then
			local f = row(70, order)
			UI.label(st.icon .. " " .. st.name, { Size = UDim2.new(1, -150, 0, 24), TextSize = 18, TextColor3 = T.gold, Parent = f })
			UI.label(string.format("%s Worth R$ %d on its own. One per account.", st.desc, st.value), { Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, -150, 0, 32), TextSize = 13, Font = T.body, TextColor3 = T.dim, TextWrapped = true, Parent = f })
			UI.button("R$ " .. st.price, T.gold, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 120, 0, 38), TextSize = 16, Parent = f }, function()
				openConfirm({ kind = "bundle", id = st.id, name = st.name, icon = st.icon, price = st.price, desc = st.desc, once = true }, store)
			end)
		end
		-- v5: the yearly festival shelf and its set (value shown plainly; it returns every year)
		if store.festival then
			order += 1
			heading("🏮 " .. store.festival.name, order)
			order += 1
			note(store.festival.blurb .. " Festival items come back every year at the same time.", order)
			order += 1
			local fg = grid(order)
			for i, it in ipairs(store.festival.items) do
				itemCard(fg, it, i, store)
			end
			for _, b in ipairs(store.bundles) do
				if b.event and b.canBuy then
					order += 1
					local f = row(70, order)
					UI.label(b.icon .. " " .. b.name, { Size = UDim2.new(1, -150, 0, 24), TextSize = 17, TextColor3 = T.gold, Parent = f })
					UI.label(string.format("%d items · R$ %d on their own · R$ %d less as a set", b.count, b.missing, b.saving or 0), { Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, -150, 0, 32), TextSize = 13, Font = T.body, TextColor3 = T.dim, Parent = f })
					UI.button("R$ " .. b.price, T.gold, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 120, 0, 38), TextSize = 16, Parent = f }, function()
						openConfirm({ kind = "bundle", id = b.id, name = b.name, icon = b.icon, price = b.price, desc = b.desc, once = b.once }, store)
					end)
				end
			end
		end
		-- v4: next week's names, so players can plan (no countdowns, no "last chance")
		if store.upcoming and #store.upcoming > 0 then
			order += 1
			heading("Next week" .. (store.nextDropName and (": " .. store.nextDropName) or ""), order)
			order += 1
			local up = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 34), LayoutOrder = order, Parent = body })
			UI.list(up, Enum.FillDirection.Horizontal, 6)
			for _, u in ipairs(store.upcoming) do
				local chip = UI.label((u.new and "✨ " or "") .. u.icon .. " " .. u.name, { Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, TextSize = 13, Font = T.body, BackgroundTransparency = 0, BackgroundColor3 = T.card, Parent = up })
				UI.corner(chip, 8)
				UI.pad(chip, 6)
			end
		end
	elseif TAB_CATS[shopTab] then
		if shopTab == "arms" then
			note("Weapon skins change your bow and spear streaks, your hotbar and the kill feed. Same damage as every other skin.", order)
		elseif shopTab == "reach" then
			note("Fly your home " .. Names.REGION .. "'s colors: a banner under your name and on the podium, a parade sash and a nametag.", order)
		else
			note("Fades color your knockout light, poses play on the podium, emotes (B) work in the lobby and Gallery, wraps color your gift parachutes.", order)
		end
		for _, cat in ipairs(TAB_CATS[shopTab]) do
			order += 1
			local items = {}
			for _, it in ipairs(store.shelves[cat] or {}) do
				if shopTab ~= "reach" or it.name:find(s.reach ~= "" and s.reach or "", 1, true) or s.reach == "" then
					table.insert(items, it)
				end
			end
			for _, it in ipairs(store.featured) do
				if it.cat == cat then
					table.insert(items, it)
				end
			end
			if #items > 0 then
				heading(cat, order)
				order += 1
				local g = grid(order)
				for i, it in ipairs(items) do
					itemCard(g, it, i, store)
				end
			end
		end
	elseif shopTab == "bundles" then
		note("A bundle is only offered while the items you don't own yet are worth more than its price.", order)
		for _, b in ipairs(store.bundles) do
			local otherReach = b.id:sub(1, 6) == "pride_" and s.reach ~= "" and not b.name:find(s.reach, 1, true)
			if otherReach or (b.once and not b.canBuy) then
				continue
			end
			order += 1
			local f = row(70, order)
			UI.label(b.icon .. " " .. b.name, { Size = UDim2.new(1, -150, 0, 24), TextSize = 17, Parent = f })
			UI.label(string.format("%d items · R$ %d of them you don't own · R$ %d less as a set", b.count, b.missing, b.saving or 0), { Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, -150, 0, 32), TextSize = 13, Font = T.body, TextColor3 = T.dim, Parent = f })
			UI.button(b.canBuy and ("R$ " .. b.price) or (b.why or "Not now"), b.canBuy and T.gold or T.card, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 140, 0, 38), TextSize = 13, TextColor3 = b.canBuy and T.dark or T.text, Parent = f }, function()
				if b.canBuy then
					openConfirm({ kind = "bundle", id = b.id, name = b.name, icon = b.icon, price = b.price, desc = b.desc, once = b.once }, store)
				end
			end)
		end
	else
		heading("Passes", order)
		local keys = {}
		for key in pairs(shop.catalog.passes) do
			table.insert(keys, key)
		end
		table.sort(keys, function(a, b)
			return shop.catalog.passes[a].price < shop.catalog.passes[b].price
		end)
		for _, key in ipairs(keys) do
			local p = shop.catalog.passes[key]
			order += 1
			local f = row(70, order)
			UI.label(p.icon .. " " .. p.name, { Size = UDim2.new(1, -150, 0, 22), TextSize = 17, Parent = f })
			UI.label(p.desc, { Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, -150, 0, 32), TextSize = 13, Font = T.body, TextColor3 = T.dim, TextWrapped = true, Parent = f })
			local owned = s.passes[key]
			local avail = shop.passes[key]
			UI.button(owned and "Owned" or (avail and ("R$ " .. p.price) or "Not on sale yet"), owned and T.green or (avail and T.gold or T.card), { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 140, 0, 38), TextSize = 15, Parent = f }, function()
				if not owned and avail then
					Net.act("buy", "pass", key)
				end
			end)
		end
		order += 1
		heading("Season and boosts", order)
		for key, p in pairs(shop.catalog.products) do
			if p.category ~= "Shop" then
				order += 1
				local f = row(62, order)
				UI.label(p.icon .. " " .. p.name, { Size = UDim2.new(1, -150, 0, 22), TextSize = 17, Parent = f })
				UI.label(p.desc, { Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, -150, 0, 30), TextSize = 13, Font = T.body, TextColor3 = T.dim, TextWrapped = true, Parent = f })
				local avail = shop.products[key]
				UI.button(avail and ("R$ " .. p.price) or "Not on sale yet", avail and T.gold or T.card, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 140, 0, 38), TextSize = 15, Parent = f }, function()
					if avail then
						Net.act("buy", "product", key)
					end
				end)
			end
		end
		local sub = shop.subscription
		if sub then
			order += 1
			heading("Patron Club", order)
			order += 1
			local f = row(96, order)
			UI.label(sub.icon .. " " .. sub.name .. " · R$ " .. sub.price .. " a month", { Size = UDim2.new(1, -150, 0, 24), TextSize = 17, Parent = f })
			UI.label(table.concat(sub.perks, " · ") .. ". Cancel any time in Roblox settings.", { Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, -150, 0, 56), TextSize = 13, Font = T.body, TextColor3 = T.dim, TextWrapped = true, Parent = f })
			UI.button(sub.active and "Member" or (sub.available and "See Price" or "Not available"), sub.active and T.green or (sub.available and T.gold or T.card), { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 140, 0, 38), TextSize = 15, Parent = f }, function()
				if sub.available and not sub.active then
					Net.act("subscribe")
				end
			end)
		end
		order += 1
		local f = row(62, order)
		UI.label("🏰 Private servers · R$ " .. (shop.privateServerPrice or 99) .. " a month", { Size = UDim2.new(1, 0, 0, 22), TextSize = 16, Parent = f })
		UI.label("Play with friends. Spire VIP owners can pick the twist and turn on No Betrayals. Private matches don't count for Reach standings.", { Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, 0, 0, 32), TextSize = 13, Font = T.body, TextColor3 = T.dim, TextWrapped = true, Parent = f })
		if store.psOwner then
			order += 1
			local g = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 40), LayoutOrder = order, Parent = body })
			UI.list(g, Enum.FillDirection.Horizontal, 6)
			UI.button("No Betrayals", T.blue, { Size = UDim2.new(0, 150, 0, 36), TextSize = 14, TextColor3 = T.text, Parent = g }, function()
				Net.act("psRule", "noBetrayals", true)
			end)
			UI.button("Random twist", T.card, { Size = UDim2.new(0, 150, 0, 36), TextSize = 14, TextColor3 = T.text, Parent = g }, function()
				Net.act("psRule", "twist", "")
			end)
		end
		order += 1
		heading("Roblox Premium / Plus members", order)
		order += 1
		local mi = Shop.byId[shop.memberItem or ""]
		local mf = row(78, order)
		UI.label(string.format("Members get a free cosmetic every month%s, plus the member nametag. Free for members, never sold.", mi and (": this month " .. mi.icon .. " " .. mi.name) or ""), { Size = UDim2.new(1, -170, 1, 0), TextSize = 14, Font = T.body, TextWrapped = true, Parent = mf })
		if shop.member then
			UI.label("✔ Claimed", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 150, 0, 38), TextSize = 15, TextColor3 = T.green, TextXAlignment = Enum.TextXAlignment.Right, Parent = mf })
		elseif shop.plusAvailable then
			UI.button("➕ About Roblox Plus", T.card, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 160, 0, 38), TextSize = 13, TextColor3 = T.text, Parent = mf }, function()
				Net.act("plus")
			end)
		end
	end
	order += 100
	note(string.format("Robux spent here so far: R$ %d. Your purchase history is in Profile.", store.spent or 0), order)
	if shop.studio then
		note("Studio test mode: anything with ID 0 is free here so you can try it. Hidden in the live game until real IDs are set.", order + 1)
	end
end

builders.profile = function(s: any)
	title.Text = "👤 " .. Players.LocalPlayer.DisplayName
	local st = s.stats
	note(string.format("Level %d · %s%s · Home %s: %s", s.level, s.rank, s.prestige > 0 and (" ★" .. s.prestige) or "", Names.REGION, s.reach ~= "" and s.reach or "none"), 0)
	local lines = {
		{ "Matches", st.matches },
		{ "Wins", st.wins },
		{ "Top 5 finishes", st.top5 },
		{ "Best place", st.bestPlace > 0 and ("#" .. st.bestPlace) or "-" },
		{ "Knockouts", st.knocks },
		{ "Top 10 finishes", st.top10 },
		{ "Gifts sent", st.gifts },
		{ "Encores", st.encores },
		{ "Best day streak", s.bestStreak },
	}
	for i, l in ipairs(lines) do
		local f = row(34, i)
		UI.label(l[1], { Size = UDim2.new(0.6, 0, 1, 0), TextSize = 16, Font = T.body, Parent = f })
		UI.label(tostring(l[2]), { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0.4, 0, 1, 0), TextSize = 16, TextXAlignment = Enum.TextXAlignment.Right, Parent = f })
	end
	if s.dailyTen then
		local d = s.dailyTen
		local f = row(40, 9)
		local mins = math.floor(math.min(d.seconds, d.goal) / 60)
		UI.label(d.claimed and "☀ Daily Ten done for today: +XP and ★ added." or string.format("☀ Daily Ten: %d of %d minutes played today (bonus XP and ★ at %d).", mins, math.floor(d.goal / 60), math.floor(d.goal / 60)), { Size = UDim2.new(1, -150, 1, 0), TextSize = 14, Font = T.body, Parent = f })
		UI.button("🔗 Invite a friend", T.blue, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 140, 0, 32), TextSize = 13, TextColor3 = T.text, Parent = f }, function()
			Panels.invite()
		end)
	end
	heading("Locker", 10)
	local LOCKER = {
		{ slot = "fade", label = "Knockout fade" },
		{ slot = "bow", label = "Bow skin" },
		{ slot = "spear", label = "Spear skin" },
		{ slot = "knife", label = "Knife skin" },
		{ slot = "pose", label = "Podium pose" },
		{ slot = "emote", label = "Emote (B)" },
		{ slot = "wrap", label = "Gift wrap" },
		{ slot = "nametag", label = "Nametag" },
		{ slot = "banner", label = "Banner" },
		{ slot = "parade", label = "Parade" },
		{ slot = "rusty", label = "Rusty pack" },
	}
	for i, L in ipairs(LOCKER) do
		local f = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 10 + i, Parent = body })
		UI.new("UIGridLayout", { CellSize = UDim2.new(0, 150, 0, 34), CellPadding = UDim2.new(0, 6, 0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = f })
		local eq = s.equipped[L.slot] or ""
		local lbl = L.label
		if (L.slot == "bow" or L.slot == "spear" or L.slot == "knife") and s.store then
			local pts = (s.store.mastery or {})[Mastery.key(L.slot, eq ~= "" and eq or nil)] or 0
			local stars = Mastery.stars(pts)
			if stars ~= "" then
				lbl = lbl .. " " .. stars
			end
		end
		UI.label(lbl, { LayoutOrder = 0, TextSize = 14, TextColor3 = T.dim, Parent = f })
		local opts: { { id: string, name: string } } = {}
		if L.slot == "fade" then
			for id, fd in pairs(Content.FADES) do
				if id == "fade_gold" or s.owned[id] then
					table.insert(opts, { id = tostring(id), name = fd.name })
				end
			end
		else
			table.insert(opts, { id = "", name = "Default" })
			for _, it in ipairs(Shop.ITEMS) do
				if it.slot == L.slot and s.owned[it.id] then
					table.insert(opts, { id = it.id, name = it.icon .. " " .. it.name })
				end
			end
			if L.slot == "nametag" and s.passes.VIP then
				table.insert(opts, { id = "tag_vip", name = "👑 VIP Gold" })
			end
			if L.slot == "parade" then
				for id in pairs(s.owned) do
					if string.sub(id, 1, 13) == "patron_cloak_" then
						table.insert(opts, { id = id, name = "📜 Patron Cloak " .. string.sub(id, 14) })
					end
				end
			end
		end
		for j, o in ipairs(opts) do
			UI.button(o.name, eq == o.id and T.gold or T.card, { LayoutOrder = j, TextSize = 13, TextColor3 = eq == o.id and T.dark or T.text, Parent = f }, function()
				Net.act("equip", L.slot, o.id)
			end)
		end
		-- v4: try on what's in the shop this week for this slot (free, only you see it)
		if s.store and s.store.featured then
			for k, it in ipairs(s.store.featured) do
				local fits = (it.slot == L.slot) or (L.slot == "fade" and it.slot == "fade")
				if fits and not it.owned and TryOn.canTry(it.id) then
					UI.button("👁 Try " .. it.name, T.panel, { LayoutOrder = 100 + k, TextSize = 12, TextColor3 = T.dim, Parent = f }, function()
						Panels.close()
						TryOn.show(it.id)
					end)
				end
			end
		end
	end
	local store = s.store
	if store and store.log and #store.log > 0 then
		heading(string.format("Purchase history · R$ %d spent", store.spent or 0), 70)
		for i, l in ipairs(store.log) do
			note(string.format("%s · %s · R$ %d%s", os.date("%b %d", l.t), l.name, l.price, l.gift and (" · gift to " .. l.gift) or ""), 70 + i)
		end
	end
	heading("Title", 25)
	local tgrid = UI.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 44), LayoutOrder = 26, Parent = body })
	UI.list(tgrid, Enum.FillDirection.Horizontal, 6)
	UI.button("None", s.equipped.title == "" and T.gold or T.card, { Size = UDim2.new(0, 90, 0, 38), TextSize = 14, TextColor3 = s.equipped.title == "" and T.dark or T.text, Parent = tgrid }, function()
		Net.act("equip", "title", "")
	end)
	for id, name in pairs(Content.TITLES) do
		if s.owned[id] then
			UI.button(name, s.equipped.title == id and T.gold or T.card, { Size = UDim2.new(0, 170, 0, 38), TextSize = 14, TextColor3 = s.equipped.title == id and T.dark or T.text, Parent = tgrid }, function()
				Net.act("equip", "title", id)
			end)
		end
	end
	heading("Interview line (your default answer)", 30)
	for i, q in ipairs(Content.QUIPS) do
		UI.button((s.quip == i and "● " or "○ ") .. q, s.quip == i and T.cardHi or T.card, { LayoutOrder = 30 + i, Size = UDim2.new(1, -8, 0, 34), TextSize = 14, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = body }, function()
			Net.act("quip", i)
		end)
	end
	if s.canPrestige then
		UI.button("Prestige to " .. Names.rank(s.prestige + 1), T.gold, { LayoutOrder = 60, Size = UDim2.new(0, 260, 0, 42), Parent = body }, function()
			Net.act("prestige")
		end)
	end
end

builders.letters = function(s: any)
	title.Text = "✉️ Sponsor letters"
	local L = s.letters or { waiting = 0, from = {}, perLetter = {} }
	note("Patrons you've won over send one letter a day, even on days you don't play. Up to 3 wait for you. Nothing in a letter is random or sold.", 0)
	heading(L.waiting > 0 and string.format("%d letter%s waiting", L.waiting, L.waiting == 1 and "" or "s") or "No letters waiting. The next one arrives tomorrow.", 1)
	if L.waiting > 0 then
		UI.button(string.format("Open (+%d %s, +%d %s head start)", L.perLetter.renown * L.waiting, Names.XP, L.perLetter.favor * L.waiting, Names.FAVOR), T.gold, { LayoutOrder = 2, Size = UDim2.new(1, -8, 0, 44), TextSize = 17, Parent = body }, function()
			Net.act("claimLetters")
		end)
	end
	heading("Your patrons", 10)
	for i, name in ipairs(L.from) do
		note("• " .. name, 10 + i)
	end
	if L.next then
		note(string.format("Next patron: %s (%s %d/%d)", L.next.name, L.next.stat, L.next.have, L.next.need), 40)
	end
	if L.cosmeticIn then
		note(string.format("A cosmetic rides along in %d more letter%s.", L.cosmeticIn, L.cosmeticIn == 1 and "" or "s"), 41)
	end
	if s.favorBank and s.favorBank > 0 then
		note(string.format("Banked %s for your next %s visit: %d", Names.FAVOR, Names.GALLERY, s.favorBank), 42)
	end
end

builders.settings = function(s: any)
	title.Text = "⚙️ Settings"
	local opts = {
		{ key = "autoQueue", text = "Auto-queue the next match" },
		{ key = "shortReaping", text = "Short " .. Names.DRAW .. " cutscene" },
		{ key = "sfx", text = "Sound effects" },
		{ key = "viewFirst", text = "First person view" },
		{ key = "reduceMotion", text = "Reduced motion" },
	}
	for i, o in ipairs(opts) do
		local on = s.settings[o.key] ~= false
		if o.key == "shortReaping" or o.key == "viewFirst" or o.key == "reduceMotion" then
			on = s.settings[o.key] == true
		end
		local f = row(48, i)
		UI.label(o.text, { Size = UDim2.new(1, -110, 1, 0), TextSize = 17, Font = T.body, Parent = f })
		UI.button(on and "ON" or "OFF", on and T.green or T.card, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 90, 0, 34), TextColor3 = T.text, Parent = f }, function()
			Net.act("setting", o.key, not on)
		end)
	end
	note("First person is a camera. Shots use the same shoulder aim as third person, so it is not more accurate. Your head, hair and hats hide on your screen only.", #opts + 1)
	-- v5: match type. Auto = Quick Trials for your first 2 matches, then the full Jubilee.
	local modes = { { id = "", text = "Auto" }, { id = "quick", text = "Quick" }, { id = "jubilee", text = "Full" } }
	local f = row(48, #opts + 2)
	UI.label("Match type (Quick Trials ≈ 5 min)", { Size = UDim2.new(1, -300, 1, 0), TextSize = 17, Font = T.body, Parent = f })
	local box = UI.frame({ BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 290, 0, 34), Parent = f })
	UI.list(box, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Right)
	local cur = s.settings.mode or ""
	for i, m in ipairs(modes) do
		UI.button(m.text, cur == m.id and T.gold or T.card, { LayoutOrder = i, Size = UDim2.new(0, 90, 0, 34), TextColor3 = cur == m.id and T.dark or T.text, Parent = box }, function()
			Net.act("setMode", m.id)
		end)
	end
	local volumes = {
		{ key = "volWeapons", text = "Weapons" },
		{ key = "volHits", text = "Hits" },
		{ key = "volFootsteps", text = "Footsteps" },
		{ key = "volPickups", text = "Pickups" },
		{ key = "volUi", text = "Interface" },
		{ key = "volAmbient", text = "Ambient" },
		{ key = "volVeil", text = "Veil" },
		{ key = "volVoice", text = "Voices" },
	}
	local defaults = Prefs.defaultSettings()
	local base = #opts + 3
	for i, v in ipairs(volumes) do
		local n = s.settings[v.key]
		if type(n) ~= "number" then
			n = defaults[v.key]
		end
		local rf = row(44, base + i - 1)
		UI.label(string.format("%s  %d%%", v.text, math.floor((n :: number) * 100 + 0.5)), { Size = UDim2.new(1, -150, 1, 0), TextSize = 16, Font = T.body, Parent = rf })
		local function bump(delta: number)
			local cur = s.settings[v.key]
			if type(cur) ~= "number" then
				cur = defaults[v.key]
			end
			local nxt = math.clamp(math.floor(((cur :: number) + delta) * 10 + 0.5) / 10, 0, 1)
			Net.act("setting", v.key, nxt)
		end
		UI.button("−", T.card, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -52, 0.5, 0), Size = UDim2.new(0, 40, 0, 32), TextColor3 = T.text, Parent = rf }, function()
			bump(-0.1)
		end)
		UI.button("+", T.card, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 40, 0, 32), TextColor3 = T.text, Parent = rf }, function()
			bump(0.1)
		end)
	end
	note("Each slider is saved on its own. Sound effects OFF mutes all of them.", base + #volumes)
	-- v6: Rusty's checklist. Skipped (or timed out) players can bring it back and still earn the reward.
	local cl = s.checklist
	if cl then
		local r = row(48, base + #volumes + 1)
		local status = if cl.finished then ("Rusty's checklist: done. " .. cl.rewardName .. " unlocked")
			elseif cl.canReopen then ("Rusty's checklist (finish it for the " .. cl.rewardName .. " title)")
			else "Rusty's checklist: showing in the top-left"
		UI.label(status, { Name = "ChecklistStatus", Size = UDim2.new(1, -200, 1, 0), TextSize = 17, Font = T.body, TextWrapped = true, Parent = r })
		if cl.canReopen then
			UI.button("Reopen", T.green, { Name = "ReopenChecklist", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 150, 0, 34), Parent = r }, function()
				Net.act("onboardReopen")
			end)
		end
	end
end

local partyState: any = nil

local function partySection(start: number): number
	local ps = partyState or { members = {}, max = 10 }
	local n = start
	heading(string.format("👨‍👩‍👧 Party (%d/%d)", #ps.members, ps.max or 10), n)
	n += 1
	note("Parties of up to 10 always land in the same match. In a private server, Family Rules keeps your party allied until the final 4.", n)
	if ps.invite then
		n += 1
		local f = row(48, n)
		UI.label(ps.invite .. " invited you to their party", { Size = UDim2.new(1, -130, 1, 0), TextSize = 16, Parent = f })
		UI.button("Join", T.green, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 120, 0, 34), Parent = f }, function()
			Net.act("partyAccept")
		end)
	end
	local me = Players.LocalPlayer.UserId
	local inParty: { [number]: boolean } = {}
	local iLead = false
	for _, m in ipairs(ps.members) do
		inParty[m.userId] = true
		if m.userId == me and m.leader then
			iLead = true
		end
		n += 1
		local f = row(40, n)
		UI.label((m.leader and "👑 " or "• ") .. m.name .. (m.queued and "  · queued" or ""), { Size = UDim2.new(1, 0, 1, 0), TextSize = 16, Font = T.body, Parent = f })
	end
	if #ps.members > 0 then
		n += 1
		local f = row(48, n)
		UI.list(f, Enum.FillDirection.Horizontal, 8)
		if iLead then
			UI.button("Queue the party", T.gold, { Size = UDim2.new(0, 170, 0, 36), TextColor3 = T.dark, Parent = f }, function()
				Net.act("partyQueue", true)
			end)
		end
		UI.button("Leave party", T.red, { Size = UDim2.new(0, 140, 0, 36), Parent = f }, function()
			Net.act("partyLeave")
		end)
		if ps.family ~= nil and Net.state and Net.state.store and Net.state.store.psOwner then
			UI.button("Family Rules: " .. (ps.family and "ON" or "OFF"), ps.family and T.green or T.card, { Size = UDim2.new(0, 180, 0, 36), TextColor3 = T.text, Parent = f }, function()
				Net.act("psRule", "family", not ps.family)
			end)
		end
	end
	if #ps.members < (ps.max or 10) then
		for _, p in ipairs(Players:GetPlayers()) do
			if p.UserId ~= me and not inParty[p.UserId] then
				n += 1
				local f = row(44, n)
				UI.label(p.DisplayName, { Size = UDim2.new(1, -130, 1, 0), TextSize = 16, Font = T.body, Parent = f })
				UI.button("Add to party", T.blue, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 120, 0, 32), TextSize = 13, Parent = f }, function()
					Net.act("partyInvite", p.UserId)
				end)
			end
		end
	end
	return n + 1
end

builders.partner = function(_s: any)
	title.Text = "👥 Party & Partner"
	local base = partySection(100)
	heading("🤝 Partner (one person)", base)
	note("Queue with a partner: you'll share a " .. Names.REGION .. ", start side by side, and gifts to each other cost less. Invite someone; if they invite you back, you're partners.", base + 1)
	local l = Hud.lobby
	if l and l.partner then
		local f = row(48, base + 2)
		UI.label("Partnered with " .. l.partner, { Size = UDim2.new(1, -130, 1, 0), TextSize = 17, Parent = f })
		UI.button("Split up", T.red, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 120, 0, 34), Parent = f }, function()
			Net.act("unpartner")
		end)
	end
	local n = base + 2
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= Players.LocalPlayer then
			n += 1
			local f = row(48, n)
			local invitedMe = l and l.inviteFrom == p.UserId
			UI.label(p.DisplayName .. (invitedMe and "  · invited you!" or ""), { Size = UDim2.new(1, -130, 1, 0), TextSize = 17, Parent = f })
			UI.button(invitedMe and "Accept" or "Invite", invitedMe and T.green or T.blue, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 120, 0, 34), Parent = f }, function()
				Net.act("invite", p.UserId)
			end)
		end
	end
	if n == base + 2 then
		note("Nobody else is here yet. Invite a friend to the experience!", base + 3)
	end
end

local ALIAS: { [string]: string } = { seasonboard = "season", challengeboard = "challenges", reachboard = "reach" }

function Panels.refresh()
	if not current or not Net.state then
		return
	end
	UI.clear(body)
	local ok, err = pcall(function(): any
		builders[current :: string](Net.state)
		return nil
	end)
	if not ok then
		warn("[Panels] " .. tostring(err))
	end
end

function Panels.open(id: string)
	id = ALIAS[id] or id
	if not builders[id] then
		return
	end
	if id == "shop" and current ~= "shop" then
		task.spawn(Net.act, "shopStep", "shop_open")
	end
	current = id
	win.Visible = true
	body.CanvasPosition = Vector2.zero
	Panels.refresh()
end

-- Open the shop with one item's buy card (used by the post-match fade preview).
function Panels.openItem(id: string)
	Panels.open("shop")
	local store = Net.state and Net.state.store
	if not store then
		return
	end
	local found = nil
	for _, it in ipairs(store.featured or {}) do
		if it.id == id then
			found = it
		end
	end
	for _, list in pairs(store.shelves or {}) do
		for _, it in ipairs(list) do
			if it.id == id then
				found = it
			end
		end
	end
	if found and found.canBuy then
		openConfirm({ kind = "item", id = found.id, name = found.name, icon = found.icon, price = found.price, desc = found.desc }, store)
	elseif found then
		Hud.note(found.why or "Not in the shop right now.")
	end
end

-- Roblox invite prompt; the friend's join carries "ref:<you>" so you both get the Torchbearer Sash.
function Panels.invite()
	local ok = pcall(function()
		local opts = Instance.new("ExperienceInviteOptions")
		opts.PromptMessage = "Play a round of " .. Names.EVENT_SHORT .. " with me"
		opts.LaunchData = "ref:" .. tostring(Players.LocalPlayer.UserId)
		if SocialService:CanSendGameInviteAsync(Players.LocalPlayer) then
			SocialService:PromptGameInvite(Players.LocalPlayer, opts)
		end
	end)
	if not ok then
		Hud.note("Invites aren't available on this device.")
	end
end

function Panels.close()
	current = nil
	win.Visible = false
end

function Panels.isOpen(): boolean
	return current ~= nil
end

function Panels.mount(parent: Frame)
	win = UI.frame({ Name = "Panel", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.new(0, 720, 0, 520), Visible = false, ZIndex = 5, Parent = parent })
	UI.corner(win, 16)
	UI.stroke(win, T.gold, 2)
	UI.pad(win, 14)
	title = UI.label("", { Size = UDim2.new(1, -50, 0, 34), TextSize = 26, TextColor3 = T.gold, Parent = win })
	UI.button("✕", T.red, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 38, 0, 38), Parent = win }, Panels.close)
	body = UI.new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 44), Size = UDim2.new(1, 0, 1, -44), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6, ScrollBarImageColor3 = T.gold, Parent = win })
	UI.list(body, nil, 6)
	Net.changed.Event:Connect(Panels.refresh)
	Net.on("party", function(d)
		partyState = d
		if current == "partner" then
			Panels.refresh()
		end
	end)
	Net.on("lobby", function()
		if current == "partner" then
			Panels.refresh()
		end
	end)
	Net.on("openPanel", function(d)
		if d.kind == "training" then
			return
		end
		Panels.open(d.kind)
	end)
end

return Panels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">Results</string>
            <string name="Source"><![CDATA[--!strict
--[[
	After a knockout or a finish:
	  * Kill-cam "How you got tapped": the camera swings from your spot to whoever got you, with
	    their weapon, distance and Pep left.
	  * Near-miss card: what you almost did ("2 more knockouts for a new best") plus your rewards.
	  * Requeue: "Next match in 10s" with your match streak, plus Watch / Lobby buttons.
	Copy is encouraging and factual. No "you'll lose your streak!" style pressure.
]]
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local Net = require(script.Parent.Net)
local Fx = require(script.Parent.Fx)
local Sfx = require(script.Parent.Sfx)
local Hud = require(script.Parent.Hud)
local View = require(script.Parent.View)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Names = require(Shared.Names)
local Rusty = require(script.Parent.Rusty)
local OfferCard = require(script.Parent.OfferCard)
local TryOn = require(script.Parent.TryOn)
local Panels = require(script.Parent.Panels)
local T = UI.Theme

local Results = {}
local card: Frame = nil :: any
local head: TextLabel = nil :: any
local sub: TextLabel = nil :: any
local lines: Frame = nil :: any
local reward: TextLabel = nil :: any
local countdown: TextLabel = nil :: any
local requeueAt = 0

-- The calm post-match cards: a free first-win pose, then (if any) one fade preview.
function Results.offers(d: any)
	if d.firstWin then
		OfferCard.show(d.firstWin, {
			try = function()
				Net.act("equip", "pose", "pose_firstlight")
			end,
		}, 30)
	end
	if d.preview then
		local id = d.preview.itemId
		OfferCard.show(d.preview, {
			try = function()
				TryOn.show(id)
			end,
			buy = function()
				Panels.openItem(id)
			end,
		})
	end
end

local function showCard(place: number?, headline: string, nm: { string }, result: any, extra: string?)
	card.Visible = true
	head.Text = place == 1 and ("🌅 " .. Names.CHAMPION .. "!") or string.format("#%d of 48", place or 0)
	sub.Text = headline
	UI.clear(lines)
	for i, l in ipairs(nm) do
		UI.label("• " .. l, { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 22), TextSize = 16, Font = T.body, Parent = lines })
	end
	if extra then
		UI.label(extra, { LayoutOrder = 10, Size = UDim2.new(1, 0, 0, 22), TextSize = 15, Font = T.body, TextColor3 = T.dim, Parent = lines })
	end
	if result then
		local parts = { string.format("+%d %s", result.xp or 0, Names.XP) }
		if (result.stars or 0) > 0 then
			table.insert(parts, string.format("+%d ★", result.stars))
		end
		if (result.playStreak or 0) > 1 then
			table.insert(parts, string.format("match streak %d (×%.1f)", result.playStreak, result.playMult or 1))
		end
		if (result.tiersUp or 0) > 0 then
			table.insert(parts, string.format("%d new %s tier%s!", result.tiersUp, Names.TRACK, result.tiersUp == 1 and "" or "s"))
		end
		reward.Text = table.concat(parts, "  ·  ")
		if result.streakMsg then
			Fx.toast(result.streakMsg, "good")
		end
	end
end

local function killcam(d: any)
	local cam = workspace.CurrentCamera
	if not cam or not d.at then
		return
	end
	local from: Vector3 = d.from or (d.at + Vector3.new(0, 8, 14))
	View.hold()
	cam.CameraType = Enum.CameraType.Scriptable
	local mid = d.at:Lerp(from, 0.5) + Vector3.new(0, 10, 0)
	cam.CFrame = CFrame.lookAt(d.at + Vector3.new(6, 6, 6), d.at)
	TweenService:Create(cam, TweenInfo.new(1.4, Enum.EasingStyle.Sine), { CFrame = CFrame.lookAt(mid + (mid - d.at).Unit:Cross(Vector3.yAxis) * 12, from) }):Play()
	if d.byModel and d.byModel:FindFirstChild("HumanoidRootPart") then
		local hl = Instance.new("Highlight")
		hl.FillColor = T.red
		hl.OutlineColor = T.gold
		hl.Parent = d.byModel
		game:GetService("Debris"):AddItem(hl, 3)
	end
	task.delay(3, function()
		cam.CameraType = Enum.CameraType.Custom
		View.release()
	end)
end

function Results.mount(parent: Frame)
	card = UI.frame({ Name = "Results", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55), Size = UDim2.new(0, 520, 0, 300), Visible = false, ZIndex = 8, Parent = parent })
	UI.corner(card, 16)
	UI.stroke(card, T.gold, 2)
	UI.pad(card, 14)
	head = UI.label("", { Size = UDim2.new(1, 0, 0, 40), TextSize = 36, TextColor3 = T.gold, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	sub = UI.label("", { Position = UDim2.new(0, 0, 0, 42), Size = UDim2.new(1, 0, 0, 24), TextSize = 19, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	lines = UI.frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 72), Size = UDim2.new(1, 0, 0, 100), Parent = card })
	UI.list(lines, nil, 2)
	reward = UI.label("", { Position = UDim2.new(0, 0, 0, 176), Size = UDim2.new(1, 0, 0, 24), TextSize = 17, TextColor3 = T.gold, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	countdown = UI.label("", { Position = UDim2.new(0, 0, 0, 204), Size = UDim2.new(1, 0, 0, 22), TextSize = 16, Font = T.body, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	local row = UI.frame({ BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 42), Parent = card })
	UI.list(row, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
	UI.button("Play again", T.gold, { LayoutOrder = 1, Size = UDim2.new(0, 150, 0, 40), Parent = row }, function()
		Net.act("queue")
	end)
	UI.button("Watch", T.blue, { LayoutOrder = 2, Size = UDim2.new(0, 120, 0, 40), Parent = row }, function()
		card.Visible = false
		Net.act("watch")
	end)
	UI.button("Locker", T.card, { LayoutOrder = 3, Size = UDim2.new(0, 100, 0, 40), TextColor3 = T.text, Parent = row }, function()
		card.Visible = false
		Hud.openPanel("profile")
	end)
	UI.button("Close", T.card, { LayoutOrder = 4, Size = UDim2.new(0, 90, 0, 40), TextColor3 = T.text, Parent = row }, function()
		card.Visible = false
	end)

	Net.on("eliminated", function(d)
		Sfx.play("bell", 0.85)
		Hud.mode = "gallery"
		local how = d.betrayed and d.by and string.format("Betrayed by %s (%s). Your old pact-mate struck first.", d.by, d.byReach or "?") or d.by and string.format("Tapped by %s (%s) with %s%s. They had %d Pep left.", d.by, d.byReach or "?", d.weapon or "a shove", d.dist and string.format(" from %d studs", math.floor(d.dist)) or "", math.floor(d.byPep or 0)) or ("Knocked out by " .. tostring(d.cause))
		Fx.announce(d.betrayed and "Pact Snap!" or "How you got tapped", T.red, 2.6)
		Rusty.say("lose", "info")
		Fx.toast(how, "info")
		killcam(d)
		task.delay(1.6, function()
			showCard(d.place, d.headline, d.lines, d.result, how)
			countdown.Text = d.autoQueue and "You're watching from " .. Names.GALLERY .. ". You'll be in the next match automatically." or "Watch from " .. Names.GALLERY .. " or play again."
			Results.offers(d)
		end)
	end)
	Net.on("finished", function(d)
		if d.place == 1 then
			Sfx.play("fanfare")
			Fx.announce("🌅 " .. Names.CHAMPION .. "!", T.gold, 3.5)
			Rusty.say("win", "good")
		end
		showCard(d.place, d.headline, d.lines, d.result, d.result and d.result.topUp and "Encore top-up: paid for your best finish." or nil)
		task.delay(2.5, function()
			Results.offers(d)
		end)
	end)
	Net.on("podium", function(d)
		Hud.mode = "lobby"
		Fx.announce(string.format("%s of %s wins!", d.winner, d.reach), T.gold, 3)
		local top = d.podium and d.podium[1]
		if top and (top.pose or top.banner) then
			-- the winner's podium pose and banner, seen by everyone in the server
			local bits = {}
			if top.pose then
				table.insert(bits, top.pose.icon .. " " .. top.pose.name)
			end
			if top.banner then
				table.insert(bits, "🚩 " .. top.banner)
			end
			Fx.toast(top.name .. " strikes a pose: " .. table.concat(bits, " · "), "good")
		end
		requeueAt = workspace:GetServerTimeNow() + d.next
	end)
	Net.on("requeue", function(d)
		requeueAt = workspace:GetServerTimeNow() + d.seconds
		Fx.toast(string.format("Next match in %ds. %d queued.", d.seconds, d.queued), "info")
	end)
	Net.on("knocked", function(d)
		Sfx.play("knockConfirm")
		Fx.pop(string.format("Knocked out %s! %d left", d.name, d.left), T.gold, 30)
	end)
	Net.on("feed", function(d)
		if d.kind == "pact" then
			Fx.toast(string.format("🤝 Pact formed: %s%s", d.victim, d.by and (" + " .. d.by) or ""), "info")
			return
		elseif d.kind == "pactSnap" then
			Sfx.play("pactWarn")
			Fx.toast(string.format("💔 %s snapped their pact with %s!", d.by, d.victim), "bad")
			return
		elseif d.kind == "betrayal" then
			Fx.announce(string.format("💔 %s strikes %s!", d.by, d.victim), T.red, 2)
			return
		end
		Fx.bell()
		if d.by and not d.encore then
			Fx.feed(string.format("%s%s ➜ %s", d.by, d.byStars and (" " .. d.byStars) or "", d.victim), d.fadeColor)
		elseif not d.encore then
			Fx.feed(string.format("✖ %s", d.victim))
		end
		if d.encore then
			Fx.toast(string.format("✨ %s is back! %s", d.victim, d.cause), "good")
		end
	end)
	Net.on("levelup", function(d)
		Sfx.play("fanfare")
		Fx.announce(string.format("Level %d!", d.level), T.gold, 2.5)
	end)
	Net.on("challenge", function(d)
		Sfx.play("coins")
		Fx.toast(string.format("📜 Challenge done: %s  +%d %s  +%d ★", d.text, d.xp, Names.XP, d.stars), "good")
	end)
	Net.on("encore", function()
		card.Visible = false
		Hud.mode = "arena"
		Fx.announce("Encore! You're back in!", T.veil, 3)
	end)
	Net.on("matchStart", function()
		card.Visible = false
	end)
	task.spawn(function()
		while true do
			task.wait(0.25)
			if card.Visible and requeueAt > 0 then
				local left = math.ceil(requeueAt - workspace:GetServerTimeNow())
				if left > 0 then
					countdown.Text = string.format("Next match in %ds", left)
				end
			end
		end
	end)
	local _ = Players
end

return Results
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">Rusty</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Rusty's voice. Every line shows as a toast and a speech bubble over Rusty in the lobby, and
	plays a voice: a recorded line if the equipped pack has a `sound` id (Content.RUSTY_VOICE,
	PUBLISHING.md 6g), otherwise a short "babble" made from a stock Roblox client sound, pitched
	per pack. Respects the sound setting.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local Net = require(script.Parent.Net)
local Fx = require(script.Parent.Fx)
local Sfx = require(script.Parent.Sfx)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Content = require(Shared.Content)

local Rusty = {}

local function pack(): string?
	local s = Net.state
	return s and s.equipped and s.equipped.rusty or nil
end

local function soundOn(): boolean
	local s = Net.state
	return not (s and s.settings and s.settings.sfx == false)
end

local function rustyHead(): BasePart?
	local map = workspace:FindFirstChild("Map")
	if not map then
		return nil
	end
	for _, d in ipairs(map:GetDescendants()) do
		if d:IsA("Model") and d:GetAttribute("LookId") == "Rusty" then
			return (d:FindFirstChild("Head") or d.PrimaryPart) :: BasePart?
		end
	end
	return nil
end

function Rusty.voice(line: string, p: string?)
	if not soundOn() then
		return
	end
	local v = Content.rustyVoice(p)
	local bus = Sfx.bus("voice")
	if v.sound ~= 0 then
		local s = Instance.new("Sound")
		s.SoundId = "rbxassetid://" .. v.sound
		s.Volume = 0.55
		s.SoundGroup = bus
		s.Parent = SoundService
		s:Play()
		Debris:AddItem(s, 12)
		return
	end
	for _, b in ipairs(Content.babble(line, p)) do
		task.delay(b.t, function()
			if not Sfx.isEnabled() then
				return
			end
			local s = Instance.new("Sound")
			s.SoundId = Content.RUSTY_BABBLE
			s.PlaybackSpeed = b.pitch
			s.Volume = 0.22
			s.SoundGroup = Sfx.bus("voice")
			s.Parent = SoundService
			s:Play()
			Debris:AddItem(s, 1)
		end)
	end
end

-- Say one of Rusty's lines (key from Content.RUSTY) with the equipped pack.
function Rusty.say(key: string, kind: string?)
	local p = pack()
	local line = Content.rustyLine(p, key)
	Fx.toast("“" .. line .. "”", kind)
	local head = rustyHead()
	if head then
		Fx.bubble(head, line, "#E8D9B5", 4)
	end
	Rusty.voice(line, p)
	return line
end

return Rusty
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">Sfx</string>
            <string name="Source"><![CDATA[--!strict
-- Mixer: one SoundGroup per bus, spatial one-shots, and a hard gap so nothing stacks into a shout.
-- Placeholders (no engine path and no library id, uploadId still 0) are silent.
local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Audio = require(Shared.Audio)

local Sfx = {}
local master: SoundGroup? = nil
local buses: { [string]: SoundGroup } = {}
local enabled = true
local lastPlayed: { [string]: number } = {}
local recent: { number } = {}
local busVolume: { [string]: number } = {}

local function recentCount(now: number): number
	local keep = {}
	local n = 0
	for _, t in ipairs(recent) do
		if now - t < 0.2 then
			table.insert(keep, t)
			n += 1
		end
	end
	recent = keep
	return n
end

function Sfx.mount()
	local mix = Instance.new("SoundGroup")
	mix.Name = "DaybreakMix"
	mix.Volume = 0.85
	mix.Parent = SoundService
	master = mix
	for _, name in ipairs(Audio.BUSES) do
		local g = Instance.new("SoundGroup")
		g.Name = "Daybreak" .. name
		g.Volume = Audio.DEFAULT_VOLUME[name] or 0.5
		g.Parent = mix
		buses[name] = g
		busVolume[name] = g.Volume
	end
	local list = {}
	for _, cue in pairs(Audio.CUES) do
		local uri = Audio.playback(cue)
		if uri ~= "" then
			local s = Instance.new("Sound")
			s.SoundId = uri
			table.insert(list, s)
		end
	end
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync(list)
		end)
		for _, s in ipairs(list) do
			s:Destroy()
		end
	end)
end

function Sfx.bus(name: string): SoundGroup?
	return buses[name]
end

function Sfx.setEnabled(on: boolean)
	enabled = on
	if master then
		master.Volume = on and 0.85 or 0
	end
end

function Sfx.isEnabled(): boolean
	return enabled
end

function Sfx.apply(settings: any)
	if type(settings) ~= "table" then
		return
	end
	Sfx.setEnabled(settings.sfx ~= false)
	for bus, key in pairs(Audio.VOLUME_KEY) do
		local g = buses[bus]
		local raw = settings[key]
		local v = Audio.clampVolume(if type(raw) == "number" then raw else (Audio.DEFAULT_VOLUME[bus] or 0.5))
		busVolume[bus] = v
		if g then
			g.Volume = v
		end
	end
end

function Sfx.busVolume(name: string): number
	return busVolume[name] or 0
end

-- `at` parents the sound to a silent part so it falls off with distance.
function Sfx.play(name: string, pitch: number?, minGap: number?, at: Vector3?)
	local cue = Audio.cue(name)
	if not cue or not enabled or not master then
		return
	end
	local uri, kind = Audio.playback(cue)
	if uri == "" or kind == "placeholder" then
		return
	end
	local now = os.clock()
	local gap = cue.minGap or 0
	if minGap then
		gap = math.max(gap, minGap)
	end
	local key = Audio.gapKey(Audio.alias(name), if at then { x = at.X, y = at.Y, z = at.Z } else nil)
	if not Audio.allow(lastPlayed[key], now, gap) then
		return
	end
	local busName = cue.bus or "ui"
	if not Audio.admit(recentCount(now), busName) then
		return
	end
	lastPlayed[key] = now
	table.insert(recent, now)
	local group = buses[busName] or master
	local sound = Instance.new("Sound")
	sound.Name = Audio.alias(name)
	sound.SoundId = uri
	sound.Volume = cue.volume or 0.3
	sound.PlaybackSpeed = pitch or cue.pitch or 1
	sound.SoundGroup = group
	local life = (cue.stop ~= nil and cue.stop > 0) and cue.stop or 4
	if at and cue.spatial then
		local p = Instance.new("Part")
		p.Name = "SfxAt"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Transparency = 1
		p.Size = Vector3.new(0.2, 0.2, 0.2)
		p.CFrame = CFrame.new(at)
		p.Parent = workspace
		sound.RollOffMode = Enum.RollOffMode.InverseTapered
		sound.RollOffMinDistance = cue.rollMin or 8
		sound.RollOffMaxDistance = cue.rollMax or 70
		sound.Parent = p
		Debris:AddItem(p, life + 0.15)
	else
		sound.Parent = group
		Debris:AddItem(sound, life + 0.15)
	end
	sound:Play()
	if cue.stop and cue.stop > 0 then
		task.delay(cue.stop, function()
			if sound.Parent and sound.IsPlaying then
				sound:Stop()
			end
		end)
	end
end

return Sfx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">TryOn</string>
            <string name="Source"><![CDATA[--!strict
--[[
	TryOn: see a cosmetic on your own "practice double" before buying. Only you can see it
	(everything here is client-side). Weapons appear in the double's hand, poses and emotes play,
	fades play a full knockout dissolve on the double with the real finishing effect.
]]
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Fx = require(script.Parent.Fx)
local AnimPlayer = require(script.Parent.AnimPlayer)
local View = require(script.Parent.View)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Arms = require(Shared.Arms) :: any
local Anim = require(Shared.Anim)
local Store = require(Shared.Store)
local Content = require(Shared.Content)
local Finishers = require(Shared.Finishers)

local TryOn = {}

local E = {
	Instance = Instance,
	Vector3 = Vector3,
	CFrame = CFrame,
	Color3 = Color3,
	Enum = Enum,
	UDim2 = UDim2,
	NumberSequence = NumberSequence,
	NumberRange = NumberRange,
	ColorSequence = ColorSequence,
	Vector2 = Vector2,
}

local double: Model? = nil
local token = 0
local heldCam = false

function TryOn.stop()
	token += 1
	if double then
		AnimPlayer.stop(double)
		double:Destroy()
		double = nil
	end
	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
	end
	if heldCam then
		heldCam = false
		View.release()
	end
end

local function makeDouble(): Model?
	local char = Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not char or not hrp then
		return nil
	end
	char.Archivable = true
	local m = char:Clone()
	char.Archivable = false
	if not m then
		return nil
	end
	m.Name = "PracticeDouble"
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("BillboardGui") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.Anchored = d.Name == "HumanoidRootPart"
		end
	end
	local hum = m:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.PlatformStand = true
	end
	m:PivotTo(hrp.CFrame * CFrame.new(0, 0, -9) * CFrame.Angles(0, math.pi, 0))
	m.Parent = workspace
	return m
end

local function focus(m: Model, seconds: number)
	local cam = workspace.CurrentCamera
	local root = m:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not cam or not root then
		return
	end
	if not heldCam then
		heldCam = true
		View.hold()
	end
	cam.CameraType = Enum.CameraType.Scriptable
	local at = root.Position
	local from = at + root.CFrame.LookVector * 9 + Vector3.new(2.5, 2.5, 0)
	TweenService:Create(cam, TweenInfo.new(0.6, Enum.EasingStyle.Sine), { CFrame = CFrame.lookAt(from, at + Vector3.new(0, 0.5, 0)) }):Play()
	local my = token
	task.delay(seconds, function()
		if token == my then
			TryOn.stop()
		end
	end)
end

local function dissolve(m: Model, fadeId: string)
	local f = Content.FADES[fadeId] or Content.FADES.fade_gold
	local color = Color3.fromHex(f.color)
	local h = Instance.new("Highlight")
	h.FillColor = color
	h.OutlineColor = Color3.new(1, 1, 1)
	h.FillTransparency = 0.15
	h.Parent = m
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			TweenService:Create(d, TweenInfo.new(1.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }):Play()
		end
	end
	local root = m:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		Finishers.play(f.style, root.Position, color)
	end
end

-- Try an item by id (weapon skin, pose, emote or fade). Returns false for other slots.
function TryOn.show(id: string): boolean
	local it = Store.byId[id]
	local fade = Content.FADES[id]
	if not it and not fade then
		return false
	end
	local slot = it and it.slot or "fade"
	if slot ~= "bow" and slot ~= "spear" and slot ~= "knife" and slot ~= "pose" and slot ~= "emote" and slot ~= "fade" then
		return false
	end
	TryOn.stop()
	local m = makeDouble()
	if not m then
		return false
	end
	double = m
	local name = it and it.name or (fade and fade.name) or id
	if slot == "bow" or slot == "spear" or slot == "knife" then
		Arms.attach(E, m, slot, id, 0)
		AnimPlayer.play(m, "pose_heart", { seconds = 5 })
		focus(m, 5)
	elseif slot == "pose" or slot == "emote" then
		local clip = (it and it.clip) or id
		AnimPlayer.play(m, (Anim.CLIPS :: any)[clip] and clip or Anim.DEFAULT_POSE, { seconds = 5 })
		focus(m, 5)
	else
		focus(m, 4.5)
		task.delay(1.2, function()
			if double == m then
				dissolve(m, id)
			end
		end)
	end
	Fx.toast("👁 Trying " .. name .. " on your practice double. Only you can see this.", "info")
	return true
end

function TryOn.canTry(id: string): boolean
	local it = Store.byId[id]
	if Content.FADES[id] then
		return true
	end
	return it ~= nil and (it.slot == "bow" or it.slot == "spear" or it.slot == "knife" or it.slot == "pose" or it.slot == "emote")
end

return TryOn
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--!strict
-- Tiny UI kit: everything is built in code, so no uploaded images are needed.
local UI = {}

UI.Theme = {
	-- "Gilded Dusk" palette (see the plan page's Color & Look section): deep slate panels,
	-- warm parchment text, one gold accent and a muted alarm red. Body text stays above 7:1 on
	-- panels and every button label keeps >= 4.5:1 with its button.
	bg = Color3.fromHex("#161924"),
	panel = Color3.fromHex("#23283A"),
	card = Color3.fromHex("#2E3449"),
	cardHi = Color3.fromHex("#3A4160"),
	accent = Color3.fromHex("#D4A72C"), -- sundial gold (dark label #1C1F2B, 8.1:1)
	gold = Color3.fromHex("#D4A72C"),
	green = Color3.fromHex("#2E7D4F"), -- go / ready (white label 5.2:1)
	red = Color3.fromHex("#B3262E"), -- alert (white label 6.6:1)
	blue = Color3.fromHex("#2F6FB3"), -- info / Gallery (white label 5.2:1)
	veil = Color3.fromHex("#5FD3E0"), -- force-field cyan for HUD hints
	text = Color3.fromHex("#F4EFE6"), -- 12.9:1 on panel
	dim = Color3.fromHex("#B9B3A8"), -- 7.2:1 on panel
	dark = Color3.fromHex("#1C1F2B"), -- label color on gold buttons
	font = Enum.Font.FredokaOne,
	body = Enum.Font.GothamMedium,
	bold = Enum.Font.GothamBold,
}
local T = UI.Theme
-- Set by Main.client to give every button a soft click (Sfx). Kept as a hook so UI has no dependencies.
UI.onClick = nil :: (() -> ())?

type Props = { [string]: any }

function UI.new(className: string, props: Props?, children: { Instance }?): any
	local inst = Instance.new(className)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in ipairs(children) do
			c.Parent = inst
		end
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UI.corner(parent: Instance, r: number?): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, r or 12), Parent = parent })
end

function UI.stroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	return UI.new("UIStroke", { Color = color or Color3.fromHex("#0E1018"), Thickness = thickness or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent })
end

function UI.pad(parent: Instance, px: number)
	return UI.new("UIPadding", { PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px), PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), Parent = parent })
end

function UI.list(parent: Instance, dir: Enum.FillDirection?, gap: number?, align: Enum.HorizontalAlignment?): UIListLayout
	return UI.new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		Parent = parent,
	})
end

function UI.frame(props: Props): Frame
	local f = UI.new("Frame", {
		BackgroundColor3 = T.panel,
		BorderSizePixel = 0,
	})
	for k, v in pairs(props) do
		(f :: any)[k] = v
	end
	return f
end

function UI.label(text: string, props: Props?): TextLabel
	local l = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = T.text,
		Font = T.font,
		TextScaled = false,
		TextSize = 18,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 24),
	})
	if props then
		for k, v in pairs(props) do
			(l :: any)[k] = v
		end
	end
	return l
end

function UI.button(text: string, color: Color3?, props: Props?, onClick: (() -> ())?): TextButton
	local b = UI.new("TextButton", {
		Text = text,
		BackgroundColor3 = color or T.accent,
		TextColor3 = (color == T.gold or color == nil) and T.dark or Color3.new(1, 1, 1),
		Font = T.font,
		TextSize = 18,
		AutoButtonColor = true,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 140, 0, 40),
	})
	if props then
		for k, v in pairs(props) do
			(b :: any)[k] = v
		end
	end
	UI.corner(b, 10)
	UI.stroke(b, Color3.fromHex("#0E1018"), 2)
	UI.new("UITextSizeConstraint", { MaxTextSize = b.TextSize, Parent = b })
	if onClick then
		local busy = false
		b.Activated:Connect(function()
			if UI.onClick then
				(UI.onClick :: any)()
			end
			if busy then
				return
			end
			busy = true
			task.spawn(function()
				local ok, err = pcall(function(): any
					(onClick :: any)()
					return nil
				end)
				if not ok then
					warn(err)
				end
				busy = false
			end)
		end)
	end
	return b
end

function UI.bar(parent: Instance, color: Color3, props: Props?): (Frame, Frame)
	local back = UI.frame({ BackgroundColor3 = Color3.fromHex("#0E1018"), Size = UDim2.new(1, 0, 0, 10), Parent = parent })
	if props then
		for k, v in pairs(props) do
			(back :: any)[k] = v
		end
	end
	UI.corner(back, 5)
	local fill = UI.frame({ BackgroundColor3 = color, Size = UDim2.new(0, 0, 1, 0), Parent = back })
	UI.corner(fill, 5)
	return back, fill
end

function UI.fmt(n: number): string
	n = math.floor(n)
	if n >= 1e9 then
		return string.format("%.2fB", n / 1e9)
	elseif n >= 1e6 then
		return string.format("%.2fM", n / 1e6)
	elseif n >= 1e4 then
		return string.format("%.1fK", n / 1e3)
	end
	local s = tostring(n)
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

function UI.clear(parent: Instance)
	for _, c in ipairs(parent:GetChildren()) do
		if not c:IsA("UIListLayout") and not c:IsA("UIGridLayout") and not c:IsA("UIPadding") and not c:IsA("UICorner") and not c:IsA("UIStroke") then
			c:Destroy()
		end
	end
end

return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">V5</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v5 client pieces:
	  * First-match checklist: one step at a time from Rusty, top-left, hidden once done.
	  * "Share this moment": after a win, top 3, Veil Breaker, Encore or five knockouts, one card
	    offers Roblox's own share sheet with a screenshot (only when PolicyService allows content
	    sharing). Friends who open it join with "ref:<you>;m:<moment>", which counts as an invite.
	  * Party results card after every match a party played together.
	  * Welcome-back card, Quick Trials / Archive Reel / festival notes and the festival banner.
]]
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local CaptureService = game:GetService("CaptureService")
local Lighting = game:GetService("Lighting")

local UI = require(script.Parent.UI)
local Net = require(script.Parent.Net)
local Fx = require(script.Parent.Fx)
local Sfx = require(script.Parent.Sfx)
local Hud = require(script.Parent.Hud)
local Rusty = require(script.Parent.Rusty)
local OfferCard = require(script.Parent.OfferCard)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Onboarding = require(Shared.Logic.Onboarding)
local T = UI.Theme

local V5 = {}
local checklist: Frame = nil :: any
local stepTitle: TextLabel = nil :: any
local stepTip: TextLabel = nil :: any
local stepCount: TextLabel = nil :: any
local stepReward: TextLabel = nil :: any
local skipAsk: Frame = nil :: any
local skipAskText: TextLabel = nil :: any
local banner: TextLabel = nil :: any
local partyCard: Frame = nil :: any
local shareAllowed: boolean? = nil

local function canShare(): boolean
	if shareAllowed == nil then
		local ok, info = pcall(function()
			return PolicyService:GetPolicyInfoForPlayerAsync(Players.LocalPlayer)
		end)
		shareAllowed = ok and type(info) == "table" and (info :: any).IsContentSharingAllowed == true
	end
	return shareAllowed == true
end

-- Take a screenshot and offer the Roblox share sheet. Returns quietly if anything is unavailable.
function V5.share(m: any)
	if not canShare() then
		Fx.toast("Sharing isn't available on this account.", "info")
		return
	end
	local cs = CaptureService :: any
	local ok = pcall(function()
		cs:TakeScreenshotCaptureAsync(function(capture: any)
			pcall(function()
				cs:PromptShareCapture(Content.fromObject(capture), m.launch, function()
					Net.act("shared", m.id)
				end, function() end)
			end)
		end)
	end)
	if not ok then
		Fx.toast("Couldn't take the picture this time.", "info")
	end
end

local function showMoment(m: any)
	if not m then
		return
	end
	task.delay(1.2, function()
		if not canShare() then
			return
		end
		OfferCard.show({
			kind = "moment",
			title = "📸 " .. m.title,
			body = m.caption .. " Share a picture? Friends who join from it get the Torchbearer Sash with you.",
			tryLabel = "Share",
			noLabel = "Not now",
			color = "#FFD36B",
		}, {
			try = function()
				V5.share(m)
			end,
		}, 20)
	end)
end

local function refreshChecklist()
	local s = Net.state
	local ob = s and s.onboarding
	checklist.Visible = ob ~= nil and (Hud.mode == "lobby" or Hud.mode == "arena")
	if ob then
		stepTitle.Text = "Rusty's tip: " .. ob.title
		stepTip.Text = ob.tip
		stepCount.Text = string.format("%d / %d", ob.done, ob.total)
		stepReward.Text = "🎁 " .. (ob.reward or "")
		skipAskText.Text = ob.skipAsk or ""
	else
		skipAsk.Visible = false
	end
	local f = s and s.festival
	banner.Visible = f ~= nil and Hud.mode == "lobby"
	if f then
		local got = 0
		for _, r in ipairs(f.rewards) do
			if r.got then
				got += 1
			end
		end
		banner.Text = string.format("🏮 %s · free festival rewards %d/%d · matches %d", f.name, got, #f.rewards, f.matches)
	end
end

local function showPartyCard(d: any)
	UI.clear(partyCard)
	UI.list(partyCard, nil, 4)
	UI.label("👨‍👩‍👧 Party results", { LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 26), TextSize = 20, TextColor3 = T.gold, Parent = partyCard })
	for i, l in ipairs(d.lines) do
		local place = l.place < 99 and ("#" .. l.place) or "-"
		UI.label(string.format("%s  %s  ·  %d knockout%s", place, l.name, l.knocks, l.knocks == 1 and "" or "s"), { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 20), TextSize = 15, Font = T.body, Parent = partyCard })
	end
	UI.label(string.format("Best finish: %s · party knockouts: %d", d.best, d.knocks), { LayoutOrder = 50, Size = UDim2.new(1, 0, 0, 20), TextSize = 14, Font = T.body, TextColor3 = T.dim, Parent = partyCard })
	partyCard.Visible = true
	task.delay(12, function()
		partyCard.Visible = false
	end)
end

function V5.mount(parent: Frame)
	checklist = UI.frame({ Name = "FirstSteps", Position = UDim2.new(0, 16, 0, 120), Size = UDim2.new(0, 320, 0, 128), BackgroundColor3 = T.panel, BackgroundTransparency = 0.1, Visible = false, ZIndex = 4, Parent = parent })
	UI.corner(checklist, 12)
	UI.stroke(checklist, T.gold, 1)
	UI.pad(checklist, 8)
	stepTitle = UI.label("", { Size = UDim2.new(1, -50, 0, 22), TextSize = 16, TextColor3 = T.gold, ZIndex = 5, Parent = checklist })
	stepCount = UI.label("", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 48, 0, 22), TextSize = 14, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 5, Parent = checklist })
	stepTip = UI.label("", { Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, 0, 0, 34), TextSize = 13, Font = T.body, TextWrapped = true, TextColor3 = T.text, ZIndex = 5, Parent = checklist })
	-- v6: the finish reward, stated plainly, and a clear Skip button with a calm confirm.
	stepReward = UI.label("", { Name = "Reward", Position = UDim2.new(0, 0, 0, 60), Size = UDim2.new(1, -70, 0, 50), TextSize = 13, Font = T.body, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = T.gold, ZIndex = 5, Parent = checklist })
	UI.button("Skip", T.card, { Name = "Skip", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 1, 0), Size = UDim2.new(0, 62, 0, 28), TextSize = 14, ZIndex = 5, Parent = checklist }, function()
		skipAsk.Visible = true
	end)
	skipAsk = UI.frame({ Name = "SkipConfirm", Position = UDim2.new(0, 0, 1, 8), Size = UDim2.new(1, 0, 0, 118), BackgroundColor3 = T.panel, Visible = false, ZIndex = 8, Parent = checklist })
	UI.corner(skipAsk, 10)
	UI.stroke(skipAsk, T.gold, 1)
	UI.pad(skipAsk, 8)
	skipAskText = UI.label("", { Size = UDim2.new(1, 0, 0, 66), TextSize = 13, Font = T.body, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 9, Parent = skipAsk })
	UI.button(Onboarding.COPY.skipNo, T.green, { Name = "KeepGoing", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(0.5, -4, 0, 30), TextSize = 14, ZIndex = 9, Parent = skipAsk }, function()
		skipAsk.Visible = false
	end)
	UI.button(Onboarding.COPY.skipYes, T.card, { Name = "ConfirmSkip", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 1, 0), Size = UDim2.new(0.5, -4, 0, 30), TextSize = 14, ZIndex = 9, Parent = skipAsk }, function()
		skipAsk.Visible = false
		Net.act("onboardSkip")
	end)
	banner = UI.label("", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.new(0, 520, 0, 30), TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, BackgroundTransparency = 0.2, BackgroundColor3 = Color3.fromHex("#5A2E12"), TextColor3 = Color3.fromHex("#FFD9A0"), Visible = false, ZIndex = 4, Parent = parent })
	UI.corner(banner, 10)
	partyCard = UI.frame({ Name = "PartyCard", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -150), Size = UDim2.new(0, 320, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.panel, Visible = false, ZIndex = 9, Parent = parent })
	UI.corner(partyCard, 12)
	UI.stroke(partyCard, T.gold, 2)
	UI.pad(partyCard, 10)

	Net.changed.Event:Connect(refreshChecklist)
	Net.on("onboard", function(d)
		Sfx.play("coins")
		Fx.toast(string.format("✅ %s  +%d", d.done, d.xp), "good")
		if d.finished and d.line then
			Fx.toast("“" .. d.line .. "”", "good")
			if d.reward then
				Fx.toast("🏅 Title unlocked: " .. d.reward .. " (equip it in the Locker)", "good")
			end
		elseif d.nextTitle then
			Fx.toast("Next: " .. d.nextTitle, "info")
		end
	end)
	Net.on("welcomeBack", function(d)
		Sfx.play("ding")
		Fx.announce("Welcome back!", T.gold, 2.6)
		local bits = { string.format("+%d Favor banked", d.favor), string.format("+50%% Renown for %d matches", d.matches) }
		if d.catchUpTier and d.catchUpTier > 0 then
			table.insert(bits, string.format("double stars up to tier %d", d.catchUpTier))
		end
		OfferCard.show({ kind = "welcome", title = "🏡 " .. d.days .. " days away. Rusty kept your seat.", body = "“" .. d.line .. "” " .. table.concat(bits, " · ") .. (d.festival and (" · " .. d.festival .. " is on!") or ""), noLabel = "Thanks" }, {}, 20)
	end)
	Net.on("pregame", function(d)
		if d.quick then
			Fx.toast("⚡ Quick Trials: straight to the plates, about 5 minutes.", "info")
		end
		if d.archive then
			Fx.announce("🎞️ Archive Reel", Color3.fromHex("#C9A97A"), 3)
			Rusty.say("archive", "info")
		elseif (d.party or 0) >= 2 then
			Rusty.say("party", "info")
		end
	end)
	Net.on("eliminated", function(d)
		showMoment(d.moment)
	end)
	Net.on("finished", function(d)
		showMoment(d.moment)
	end)
	Net.on("partyCard", showPartyCard)
	-- letters opened (this push had no listener before v5; the toast came only from the reply)
	Net.on("letters", function(d)
		Sfx.play("coins")
		local n = type(d.letters) == "number" and d.letters or (type(d.letters) == "table" and #d.letters or 0)
		Fx.announce(string.format("✉️ %d letter%s opened", n, n == 1 and "" or "s"), T.gold, 2.2)
	end)
	Net.on("matchStart", function()
		partyCard.Visible = false
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			pcall(refreshChecklist)
		end
	end)
	local _ = Lighting
end

return V5
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">View</string>
            <string name="Source"><![CDATA[--!strict
-- Optional first person. The picture moves to the eyes; the shot does not.
-- Head, hair, hats and the local body are hidden so nothing clips the lens.
-- Hands and the held weapon are a local viewmodel (CanQuery false, not replicated).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local Net = require(script.Parent.Net)
local Hud = require(script.Parent.Hud)
local Cutscene = require(script.Parent.Cutscene)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Presentation = require(Shared.Presentation)
local Config = require(Shared.Config)
local Arms = require(Shared.Arms) :: any
local Mastery = require(Shared.Mastery)

local View = {}
local player = Players.LocalPlayer
local T = UI.Theme

local E = {
	Instance = Instance,
	Vector3 = Vector3,
	CFrame = CFrame,
	Color3 = Color3,
	Enum = Enum,
	UDim2 = UDim2,
	NumberSequence = NumberSequence,
	NumberRange = NumberRange,
	ColorSequence = ColorSequence,
	Vector2 = Vector2,
}

local wantsFirst = false
local reduceMotion = false
local holds = 0
local applied = false
local savedMin = 0.5
local savedMax = 128
local remembered = false
local hidden: { BasePart } = {}
local viewModel: Model? = nil
local weaponModel: Model? = nil
local weaponKey = ""
local rel: { [BasePart]: CFrame } = {}
local aimMark: Frame? = nil
local useBtn: TextButton? = nil
local throwBtn: TextButton? = nil
local started = false

-- Set by Main so this module does not require Panels (Panels already requires TryOn).
View.menuOpen = function(): boolean
	return false
end
View.onUse = function() end
View.onThrow = function() end

function View.hold()
	holds += 1
end

function View.release()
	holds = math.max(0, holds - 1)
end

function View.isFirst(): boolean
	return wantsFirst and holds == 0 and not Cutscene.playing and not View.menuOpen()
end

function View.apply(settings: any)
	if type(settings) ~= "table" then
		return
	end
	wantsFirst = settings.viewFirst == true
	reduceMotion = settings.reduceMotion == true
end

local function engineReduce(): boolean
	local ok, v = pcall(function()
		return (game:GetService("GuiService") :: any).ReducedMotionEnabled == true
	end)
	return ok and v == true
end

local function motionOff(): boolean
	return reduceMotion or engineReduce()
end

local function showBody()
	for _, p in ipairs(hidden) do
		if p.Parent then
			p.LocalTransparencyModifier = 0
		end
	end
	table.clear(hidden)
end

local function hideBody(char: Model)
	table.clear(hidden)
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = 1
			table.insert(hidden, d)
		end
	end
end

local function clearWeapon()
	if weaponModel then
		weaponModel:Destroy()
		weaponModel = nil
	end
	table.clear(rel)
	weaponKey = ""
end

local function clearView()
	clearWeapon()
	if viewModel then
		viewModel:Destroy()
		viewModel = nil
	end
end

local function armColor(char: Model): Color3
	local bc = char:FindFirstChildOfClass("BodyColors")
	if bc then
		return bc.RightArmColor3
	end
	local arm = char:FindFirstChild("RightLowerArm") or char:FindFirstChild("Right Arm")
	if arm and arm:IsA("BasePart") then
		return arm.Color
	end
	return Color3.fromRGB(196, 146, 114)
end

local function ensureModel(): Model
	if viewModel and viewModel.Parent then
		return viewModel
	end
	local m = Instance.new("Model")
	m.Name = "ViewHands"
	local cam = workspace.CurrentCamera
	m.Parent = cam
	viewModel = m
	return m
end

local function limb(parent: Model, name: string, color: Color3, size: Vector3): Part
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Part") then
		return existing
	end
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = parent
	return p
end

local function placeBar(part: Part, from: Vector3, to: Vector3, thickness: number)
	local delta = to - from
	local len = math.max(delta.Magnitude, 0.05)
	part.Size = Vector3.new(thickness, thickness, len)
	part.CFrame = CFrame.lookAt(from:Lerp(to, 0.5), to)
end

local function skinOf(slot: string): (string, number)
	local s = Net.state
	local skin = (s and s.equipped and s.equipped[slot]) or ""
	local pts = (s and s.mastery and s.mastery[Mastery.key(slot, skin)]) or 0
	return skin, Mastery.level(pts)
end

local function heldSlot(): string?
	local inv = Hud.inv
	if not inv then
		return nil
	end
	local item = inv.inv[inv.equipped]
	local def = item and Config.Items[item]
	if def and def.kind == "weapon" and def.weapon then
		return def.weapon
	end
	return nil
end

-- Wrist pose: fingers point along the camera look, slightly down, so Arms.gripOffset reads naturally.
local function handCf(cam: Camera, side: string): CFrame
	local h = Presentation.HANDS[side]
	return cam.CFrame * CFrame.new(h.x, h.y, h.z) * CFrame.Angles(math.rad(78), math.rad(side == "right" and 168 or -168), 0)
end

local function syncWeapon(cam: Camera)
	local slot = heldSlot()
	local key = slot or ""
	local skin, lvl = "", 0
	if slot then
		skin, lvl = skinOf(slot)
		key = slot .. ":" .. skin .. ":" .. tostring(lvl)
	end
	if key ~= weaponKey then
		clearWeapon()
		weaponKey = key
		if slot then
			local spec = Arms.spec(slot, skin, lvl)
			local grip = handCf(cam, "right") * Arms.gripOffset(E, slot)
			local m = Arms.build(E, spec, grip)
			m.Name = "ViewWeapon"
			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = true
					d.CanQuery = false
					d.CanTouch = false
					d.CanCollide = false
					d.CastShadow = false
					rel[d] = grip:ToObjectSpace(d.CFrame)
				end
			end
			m.Parent = ensureModel()
			weaponModel = m
		end
	end
	if weaponModel and slot then
		local grip = handCf(cam, "right") * Arms.gripOffset(E, slot)
		for part, offset in pairs(rel) do
			if part.Parent then
				part.CFrame = grip * offset
			end
		end
	end
end

local function syncHands(cam: Camera, char: Model)
	local m = ensureModel()
	if m.Parent ~= cam then
		m.Parent = cam
	end
	local color = armColor(char)
	local right = Presentation.HANDS.right
	local left = Presentation.HANDS.left
	local function world(h: { x: number, y: number, z: number }, back: number): Vector3
		return (cam.CFrame * CFrame.new(h.x * 0.55, h.y + 0.28, h.z + back)).Position
	end
	local rHand = (cam.CFrame * CFrame.new(right.x, right.y, right.z)).Position
	local lHand = (cam.CFrame * CFrame.new(left.x, left.y, left.z)).Position
	placeBar(limb(m, "RightArm", color, Vector3.new(0.28, 0.28, 0.8)), world(right, 0.55), rHand, 0.26)
	placeBar(limb(m, "LeftArm", color, Vector3.new(0.26, 0.26, 0.7)), world(left, 0.5), lHand, 0.24)
	local rh = limb(m, "RightHand", color, Vector3.new(0.22, 0.2, 0.24))
	rh.CFrame = handCf(cam, "right")
	local lh = limb(m, "LeftHand", color, Vector3.new(0.2, 0.18, 0.22))
	lh.CFrame = handCf(cam, "left")
	syncWeapon(cam)
end

local function relaxLock(keepType: boolean)
	player.CameraMode = Enum.CameraMode.Classic
	player.CameraMinZoomDistance = savedMin
	player.CameraMaxZoomDistance = savedMax
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	showBody()
	clearView()
	local cam = workspace.CurrentCamera
	if cam then
		cam.FieldOfView = Presentation.FOV
		if not keepType and cam.CameraType == Enum.CameraType.Scriptable then
			cam.CameraType = Enum.CameraType.Custom
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				cam.CameraSubject = hum
			end
		end
	end
	applied = false
end

local function rememberZoom()
	if remembered then
		return
	end
	savedMin = player.CameraMinZoomDistance
	savedMax = player.CameraMaxZoomDistance
	if savedMax < 20 then
		savedMax = 128
	end
	remembered = true
end

function View.shotAim(): Vector3
	local cam = workspace.CurrentCamera
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local focusPos = if head and head:IsA("BasePart") then head.Position elseif hrp then hrp.Position + Vector3.new(0, 1.5, 0) else nil
	local look = cam and cam.CFrame.LookVector
	if not focusPos or not look then
		return player:GetMouse().Hit.Position
	end
	local aim = Presentation.shotAim({ x = focusPos.X, y = focusPos.Y, z = focusPos.Z }, { x = look.X, y = look.Y, z = look.Z })
	return Vector3.new(aim.x, aim.y, aim.z)
end

local function refreshChrome()
	local arena = Hud.mode == "arena"
	local show = Presentation.crosshairVisible(wantsFirst, arena, View.menuOpen() or Cutscene.playing or holds > 0, false)
	if aimMark then
		aimMark.Visible = show
	end
	local touch = UserInputService.TouchEnabled and show
	if useBtn then
		useBtn.Visible = touch
	end
	if throwBtn then
		throwBtn.Visible = touch
	end
end

local function step()
	refreshChrome()
	local blocked = holds > 0 or Cutscene.playing or View.menuOpen()
	if not wantsFirst or blocked then
		if applied then
			relaxLock(blocked)
		end
		return
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not char or not hum or not hrp or hum.Health <= 0 then
		if applied then
			relaxLock(false)
		end
		return
	end
	rememberZoom()
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	player.CameraMinZoomDistance = 0.5
	player.CameraMaxZoomDistance = 0.5
	applied = true
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local look = cam.CFrame.LookVector
	local reduce = motionOff()
	local speed = hrp.AssemblyLinearVelocity.Magnitude
	local bob = Presentation.bob(os.clock(), speed, reduce)
	local pos = cam.CFrame.Position + look * Presentation.EYE_FORWARD + cam.CFrame.RightVector * bob.x + cam.CFrame.UpVector * bob.y
	cam.CFrame = CFrame.lookAt(pos, pos + look)
	local sprinting = hum.WalkSpeed > Config.WALK_SPEED + 1
	cam.FieldOfView = Presentation.fov(sprinting, reduce)
	if Presentation.HIDE_LOCAL_BODY then
		hideBody(char)
	elseif Presentation.hidesPart("Head") then
		local head = char:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			head.LocalTransparencyModifier = 1
		end
	end
	syncHands(cam, char)
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
end

local function tick(parent: Instance, name: string, pos: UDim2, rot: number): Frame
	local f = UI.frame({
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = pos,
		Size = UDim2.fromOffset(2, 6),
		Rotation = rot,
		BackgroundColor3 = T.text,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = parent,
	})
	return f
end

function View.mount(parent: Frame)
	local mark = UI.frame({
		Name = "AimMark",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(22, 22),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 6,
		Parent = parent,
	})
	aimMark = mark
	-- Short ticks with a gap, so the mark shows the center without covering it.
	tick(mark, "N", UDim2.new(0.5, 0, 0, 2), 0)
	tick(mark, "S", UDim2.new(0.5, 0, 1, -2), 0)
	tick(mark, "W", UDim2.new(0, 2, 0.5, 0), 90)
	tick(mark, "E", UDim2.new(1, -2, 0.5, 0), 90)
	local dot = UI.frame({
		Name = "Dot",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(3, 3),
		BackgroundColor3 = T.gold,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		ZIndex = 7,
		Parent = mark,
	})
	UI.corner(dot, 2)

	useBtn = UI.button("Use", T.gold, {
		Name = "FirstPersonUse",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -96),
		Size = UDim2.fromOffset(88, 44),
		Visible = false,
		ZIndex = 7,
		Parent = parent,
	}, function()
		View.onUse()
	end)
	throwBtn = UI.button("Throw", T.card, {
		Name = "FirstPersonThrow",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -112, 1, -96),
		Size = UDim2.fromOffset(88, 44),
		TextColor3 = T.text,
		Visible = false,
		ZIndex = 7,
		Parent = parent,
	}, function()
		View.onThrow()
	end)
end

function View.start()
	if started then
		return
	end
	started = true
	RunService:BindToRenderStep("DaybreakView", Enum.RenderPriority.Camera.Value + 1, step)
end

return View
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">WorldAudio</string>
            <string name="Source"><![CDATA[--!strict
-- World-driven sounds: footsteps, landings, weapon releases, the Veil, and a little air.
-- Rates and surface choice live in Audio.luau so they can be tested without Studio.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(script.Parent.Net)
local Sfx = require(script.Parent.Sfx)
local Hud = require(script.Parent.Hud)
local Cutscene = require(script.Parent.Cutscene)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Audio = require(Shared.Audio)
local Config = require(Shared.Config)

local WorldAudio = {}
local player = Players.LocalPlayer
local started = false
local stepDebt = 0
local lastWeapon = ""
local weaponReady = false

local function root(): BasePart?
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	return nil
end

local function playAt(name: string, at: any)
	if typeof(at) == "Vector3" then
		Sfx.play(name, nil, nil, at)
	else
		Sfx.play(name)
	end
end

function WorldAudio.start()
	if started then
		return
	end
	started = true

	Net.on("tracer", function(d)
		playAt(if d.spear then "spearThrow" else "bowRelease", d.from)
	end)
	Net.on("swing", function(d)
		local cue = Audio.weaponCue(tostring(d.weapon or ""), false) or "shove"
		playAt(cue, d.at)
	end)
	Net.on("loot", function(d)
		local def = d.item and Config.Items[d.item]
		if def and def.kind == "weapon" then
			Sfx.play("equip")
		elseif def and (def.kind == "snack" or def.kind == "ammo") then
			Sfx.play("pickup")
		else
			Sfx.play("crate")
		end
	end)
	Net.on("pep", function(d)
		if d.from == "snack" then
			Sfx.play("snack")
		elseif d.from == "veil" then
			Sfx.play("veilTouch")
		elseif d.from ~= "gift" then
			Sfx.play("hurt")
		end
	end)
	Net.on("inv", function(d)
		local item = d.inv and d.inv[d.equipped]
		local def = item and Config.Items[item]
		local slot = (def and def.weapon) or ""
		if weaponReady and slot ~= "" and slot ~= lastWeapon then
			Sfx.play("equip")
		end
		lastWeapon = slot
		weaponReady = true
	end)

	local function bind(char: Model)
		local hum = char:WaitForChild("Humanoid", 8)
		if hum and hum:IsA("Humanoid") then
			hum.StateChanged:Connect(function(_, new)
				if new == Enum.HumanoidStateType.Landed and Hud.mode == "arena" then
					local hrp = char:FindFirstChild("HumanoidRootPart")
					if hrp and hrp:IsA("BasePart") then
						Sfx.play("footLand", nil, nil, hrp.Position)
					end
				end
			end)
		end
	end
	if player.Character then
		task.spawn(bind, player.Character)
	end
	player.CharacterAdded:Connect(bind)

	RunService.Heartbeat:Connect(function(dt)
		if Cutscene.playing then
			return
		end
		if Hud.mode == "arena" then
			Sfx.play("arenaAir")
			local hrp = root()
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.FloorMaterial ~= Enum.Material.Air then
				local vel = hrp.AssemblyLinearVelocity
				local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
				local interval = Audio.footInterval(speed)
				if interval then
					stepDebt += dt
					if stepDebt >= interval then
						stepDebt = 0
						local params = RaycastParams.new()
						params.FilterType = Enum.RaycastFilterType.Exclude
						params.FilterDescendantsInstances = { player.Character :: any }
						local hit = workspace:Raycast(hrp.Position, Vector3.new(0, -6, 0), params)
						local mat = if hit then hit.Material.Name else hum.FloorMaterial.Name
						Sfx.play(Audio.footCue(mat), nil, nil, hrp.Position)
					end
				else
					stepDebt = 0
				end
			end
			local m = Hud.match
			if hrp and m and type(m.radius) == "number" then
				local flat = Vector3.new(hrp.Position.X, 0, hrp.Position.Z).Magnitude
				local cue = Audio.veilEvent(flat > m.radius, m.radius - flat, m.shrinking == true, m.nextIn)
				if cue then
					Sfx.play(cue)
				end
			end
		elseif Hud.mode == "lobby" then
			stepDebt = 0
			Sfx.play("lobbyAir")
		else
			stepDebt = 0
		end
	end)
end

return WorldAudio
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
